#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Статус = "Нажмите «Принять решение досрочно».";
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Принять(Команда)
	Статус = ПринятьНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПринятьНаСервере()
	Сотрудник = ТекущийСотрудник();
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		Возврат "Не удалось определить пользователя.";
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("Статусы", СтрРазделить("Кворум,Просрочена", ","));
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Рассылки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.АИС_Рассылки КАК Рассылки
	|ГДЕ
	|	НЕ Рассылки.ПометкаУдаления
	|	И Рассылки.Контролер = &Сотрудник
	|	И Рассылки.Статус В (&Статусы)
	|УПОРЯДОЧИТЬ ПО
	|	Рассылки.ДатаОтправки УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат "Нет рассылки в кворуме, где вы контролёр.";
	КонецЕсли;
	Результат = АИС_Рассылки.ПринятьРешениеДосрочно(
		Выборка.Ссылка, Сотрудник, "Принято из раздела ИИ-Помощник");
	Если Результат.ОК Тогда
		Возврат "Досрочное решение по рассылке принято.";
	КонецЕсли;
	Возврат "Ошибка: " + Результат.Ошибка;
КонецФункции

&НаСервере
Функция ТекущийСотрудник()
	Пользователь = ПараметрыСеанса.ТекущийПользователь;
	Если ЗначениеЗаполнено(Пользователь) Тогда
		Возврат Пользователь;
	КонецЕсли;
	ПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если ПользовательИБ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Справочники.Пользователи.НайтиПоНаименованию(ПользовательИБ.Имя, Истина);
КонецФункции

#КонецОбласти
