#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьТаблицуНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТаблицаЗапросовПриАктивизацииСтроки(Элемент, СтандартнаяОбработка)
	Если Элементы.ТаблицаЗапросов.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекущийЗапрос = Элементы.ТаблицаЗапросов.ТекущиеДанные.Запрос;
	ЗаполнитьДеталиНаСервере(ТекущийЗапрос);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)
	ЗаполнитьТаблицуНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура Ответить(Команда)
	Статус = ОтветитьНаСервере("answered");
КонецПроцедуры

&НаКлиенте
Процедура Одобрить(Команда)
	Статус = ОтветитьНаСервере("approved");
КонецПроцедуры

&НаКлиенте
Процедура Отклонить(Команда)
	Статус = ОтветитьНаСервере("rejected");
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьТаблицуНаСервере()
	ТаблицаЗапросов.Очистить();
	ТекущийЗапрос = Неопределено;
	ТекстЗапроса = "";
	ТекстОтвета = "";
	Статус = "";
	Сотрудник = ТекущийСотрудник();
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		Статус = "Не удалось определить текущего пользователя.";
		Возврат;
	КонецЕсли;

	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Запросы.Ссылка КАК Ссылка,
			|	Запросы.Заголовок КАК Заголовок,
			|	Запросы.Вид КАК Вид,
			|	Запросы.СрокОтвета КАК Срок
			|ИЗ
			|	Справочник.АИС_ВзаимодействияИИ КАК Запросы
			|ГДЕ
			|	Запросы.Сотрудник = &Сотрудник
			|	И Запросы.Статус = &Ожидает
			|УПОРЯДОЧИТЬ ПО
			|	Запросы.СрокОтвета";
		Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
		Запрос.УстановитьПараметр("Ожидает", Перечисления.АИС_СостоянияВзаимодействийИИ.Ожидает);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			СтрокаТаблицы = ТаблицаЗапросов.Добавить();
			СтрокаТаблицы.Запрос = Выборка.Ссылка;
			СтрокаТаблицы.Заголовок = Выборка.Заголовок;
			СтрокаТаблицы.Вид = Строка(Выборка.Вид);
			СтрокаТаблицы.Срок = Выборка.Срок;
		КонецЦикла;
		Статус = "Запросов: " + ТаблицаЗапросов.Количество();
		Если ТаблицаЗапросов.Количество() > 0 Тогда
			ТекущийЗапрос = ТаблицаЗапросов[0].Запрос;
			ЗаполнитьДеталиНаСервере(ТекущийЗапрос);
		КонецЕсли;
	Исключение
		Статус = "Ошибка чтения запросов: " + ОписаниеОшибки();
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеталиНаСервере(Запрос)
	Если Не ЗначениеЗаполнено(Запрос) Тогда
		Возврат;
	КонецЕсли;
	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ЗапросОбъект = Запрос.ПолучитьОбъект();
		ТекстЗапроса = ЗапросОбъект.Текст;
		ТекстОтвета = "";
		Статус = "Ответьте на запрос: " + ЗапросОбъект.Заголовок;
	Исключение
		Статус = "Ошибка чтения запроса: " + ОписаниеОшибки();
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);
КонецПроцедуры

&НаСервере
Функция ОтветитьНаСервере(Решение)
	Сотрудник = ТекущийСотрудник();
	Если Не ЗначениеЗаполнено(Сотрудник) ИЛИ Не ЗначениеЗаполнено(ТекущийЗапрос) Тогда
		Возврат "Не выбран запрос.";
	КонецЕсли;
	Если Решение <> "approved" И ПустаяСтрока(СокрЛП(ТекстОтвета)) Тогда
		Возврат "Укажите, что нужно изменить или добавить.";
	КонецЕсли;

	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ЗапросОбъект = ТекущийЗапрос.ПолучитьОбъект();
		Если ЗапросОбъект = Неопределено ИЛИ ЗапросОбъект.Сотрудник <> Сотрудник ИЛИ ЗапросОбъект.Статус <> Перечисления.АИС_СостоянияВзаимодействийИИ.Ожидает Тогда
			УстановитьПривилегированныйРежим(ПрежнийРежим);
			Возврат "Запрос уже обработан или недоступен.";
		КонецЕсли;
		Ответ = Новый Структура("decision,text", Решение, ?(Решение = "approved", "", ТекстОтвета));
		ЗапросОбъект.ОтветJSON = АИС_КлиентВнешнегоСервиса.ЗаписатьJSONСтрокой(Ответ);
		ЗапросОбъект.Статус = Перечисления.АИС_СостоянияВзаимодействийИИ.Отвечен;
		ЗапросОбъект.АвторОтвета = Сотрудник;
		ЗапросОбъект.ДатаОтвета = ТекущаяДатаСеанса();
		ЗапросОбъект.Версия = ЗапросОбъект.Версия + 1;
		ЗапросОбъект.Записать();
		ЗакрытьЗадачуУведомление(ЗапросОбъект);
		АИС_АгентИИ.ПродолжитьПослеОтвета(ЗапросОбъект.Ссылка);
	Исключение
		УстановитьПривилегированныйРежим(ПрежнийРежим);
		Возврат "Ошибка сохранения ответа: " + ОписаниеОшибки();
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);
	ЗаполнитьТаблицуНаСервере();
	Возврат "Ответ сохранен.";
КонецФункции

&НаСервере
Процедура ЗакрытьЗадачуУведомление(Объект)
	Если Не ЗначениеЗаполнено(Объект.ЗадачаУведомление) Тогда
		Возврат;
	КонецЕсли;
	Задача = Объект.ЗадачаУведомление.ПолучитьОбъект();
	Если Задача = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Задача.Выполнена = Истина;
	Задача.ДатаИсполнения = ТекущаяДатаСеанса();
	Задача.РезультатВыполнения = "Ответ дан";
	Задача.Записать();
КонецПроцедуры

&НаСервере
Функция ТекущийСотрудник()
	ТекущийИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если ТекущийИБ = Неопределено Тогда
		Возврат Справочники.Пользователи.ПустаяСсылка();
	КонецЕсли;
	Возврат Справочники.Пользователи.НайтиПоНаименованию(ТекущийИБ.Имя, Истина);
КонецФункции

#КонецОбласти
