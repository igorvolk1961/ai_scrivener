#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Не ЭтоАдминистратор() Тогда
		Отказ = Истина;
		Сообщить("Недостаточно прав для администрирования ИИ-возможностей.");
		Возврат;
	КонецЕсли;
	Элементы.Статус.ТолькоПросмотр = Истина;
	ЗаполнитьНастройки();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сохранить(Команда)
	Статус = СохранитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьRAG(Команда)
	Статус = ПроверитьRAGНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьИндексацию(Команда)
	ОткрытьФорму("DataProcessor.АИС_ИндексацияДокументов.Форма.Форма");
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЭтоАдминистратор()
	Возврат РольДоступна("ПолныеПрава")
		ИЛИ РольДоступна("АдминистраторСистемы")
		ИЛИ РольДоступна("АИС_АдминистраторСистемы");
КонецФункции

&НаСервере
Процедура ЗаполнитьНастройки()
	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		МодельИИ = Константы.АИС_МодельИИ.Получить();
		КлючИИ = Константы.АИС_КлючИИ.Получить();
		АдресRAGСервиса = Константы.АИС_АдресRAGСервиса.Получить();
		ТокенRAGСервиса = Константы.АИС_ТокенRAGСервиса.Получить();
		ТаймаутRAGСервиса = Константы.АИС_ТаймаутRAGСервиса.Получить();
		ПовторыRAGСервиса = Константы.АИС_ПовторыRAGСервиса.Получить();
		ИндексацияRAGВключена = Константы.АИС_ИндексацияRAGВключена.Получить();
		КаталогКорпусаЗнаний = Константы.АИС_КаталогКорпусаЗнаний.Получить();
		Статус = "Изменения вступают в силу после сохранения.";
	Исключение
		Статус = "Не удалось прочитать настройки: " + ОписаниеОшибки();
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);
КонецПроцедуры

&НаСервере
Функция СохранитьНаСервере()
	Если Не ЭтоАдминистратор() Тогда
		Возврат "Недостаточно прав для изменения настроек.";
	КонецЕсли;

	Ошибка = ПроверитьНастройки();
	Если Не ПустаяСтрока(Ошибка) Тогда
		Возврат Ошибка;
	КонецЕсли;

	Если ТаймаутRAGСервиса <= 0 Тогда
		ТаймаутRAGСервиса = 120;
	КонецЕсли;
	Если ПовторыRAGСервиса <= 0 Тогда
		ПовторыRAGСервиса = 3;
	КонецЕсли;

	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Константы.АИС_МодельИИ.Установить(СокрЛП(МодельИИ));
		Константы.АИС_КлючИИ.Установить(СокрЛП(КлючИИ));
		Константы.АИС_АдресRAGСервиса.Установить(СокрЛП(АдресRAGСервиса));
		Константы.АИС_ТокенRAGСервиса.Установить(СокрЛП(ТокенRAGСервиса));
		Константы.АИС_ТаймаутRAGСервиса.Установить(ТаймаутRAGСервиса);
		Константы.АИС_ПовторыRAGСервиса.Установить(ПовторыRAGСервиса);
		Константы.АИС_ИндексацияRAGВключена.Установить(ИндексацияRAGВключена);
		Константы.АИС_КаталогКорпусаЗнаний.Установить(СокрЛП(КаталогКорпусаЗнаний));
	Исключение
		УстановитьПривилегированныйРежим(ПрежнийРежим);
		Возврат "Не удалось сохранить настройки: " + ОписаниеОшибки();
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);

	Статус = "Настройки сохранены.";
	Возврат Статус;
КонецФункции

&НаСервере
Функция ПроверитьНастройки()
	Если ТаймаутRAGСервиса < 0 Тогда
		Возврат "Таймаут RAG-сервиса не может быть отрицательным.";
	КонецЕсли;
	Если ПовторыRAGСервиса < 0 Тогда
		Возврат "Количество повторов RAG-сервиса не может быть отрицательным.";
	КонецЕсли;

	Адрес = СокрЛП(АдресRAGСервиса);
	Если ПустаяСтрока(Адрес) Тогда
		Возврат "";
	КонецЕсли;

	АдресНРег = НРег(Адрес);
	Если СтрНайти(АдресНРег, "http://") <> 1 И СтрНайти(АдресНРег, "https://") <> 1 Тогда
		Возврат "Адрес RAG-сервиса должен начинаться с http:// или https://.";
	КонецЕсли;

	ДлинаСхемыHTTPS = СтрДлина("https://");
	ДлинаСхемыHTTP = СтрДлина("http://");
	Остаток = ?(СтрНайти(АдресНРег, "https://") = 1,
		Сред(Адрес, ДлинаСхемыHTTPS + 1),
		Сред(Адрес, ДлинаСхемыHTTP + 1));
	ПозицияСлэша = СтрНайти(Остаток, "/");
	ХостПорт = ?(ПозицияСлэша > 0, Лев(Остаток, ПозицияСлэша - 1), Остаток);
	ПозицияДвоеточия = СтрНайти(ХостПорт, ":");
	Если ПозицияДвоеточия = 0 Тогда
		Возврат "В адресе RAG-сервиса явно укажите порт.";
	КонецЕсли;
	Порт = Число(Сред(ХостПорт, ПозицияДвоеточия + 1));
	Если Порт <= 0 Тогда
		Возврат "В адресе RAG-сервиса укажите корректный порт.";
	КонецЕсли;

	Возврат "";
КонецФункции

&НаСервере
Функция ПроверитьRAGНаСервере()
	Если Не ЭтоАдминистратор() Тогда
		Возврат "Недостаточно прав для проверки RAG.";
	КонецЕсли;

	РезультатСохранения = СохранитьНаСервере();
	Если РезультатСохранения <> "Настройки сохранены." Тогда
		Возврат РезультатСохранения;
	КонецЕсли;

	Попытка
		Результат = АИС_ИнтеграцияСRAG.ПроверитьДоступность();
		Если Результат.Доступен Тогда
			Возврат "RAG-сервис доступен.";
		Иначе
			Возврат "RAG-сервис недоступен: " + Результат.Ошибка;
		КонецЕсли;
	Исключение
		Возврат "Ошибка проверки RAG-сервиса: " + ОписаниеОшибки();
	КонецПопытки;
КонецФункции

#КонецОбласти
