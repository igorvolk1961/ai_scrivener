#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Попытка
		ТекстРезультата = АИС_Промпты.Заполнить();
	Исключение
		Текст = "Ошибка заполнения промптов: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("АИС.Промпты", УровеньЖурналаРегистрации.Ошибка,,, Текст);
		ТекстРезультата = Текст;
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПоказатьПредупреждение(, ТекстРезультата);
КонецПроцедуры

#КонецОбласти
