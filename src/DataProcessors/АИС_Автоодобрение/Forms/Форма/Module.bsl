&НаСервере
Функция СписокАвторов(Правило)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Правило", Правило);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Авторы.Пользователь.Наименование КАК Логин
	|ИЗ
	|	Справочник.АИС_РазрешенныеАвторыАвтоодобрения КАК Авторы
	|ГДЕ
	|	Авторы.Владелец = &Правило
	|	И Авторы.Активность
	|	И НЕ Авторы.ПометкаУдаления";
	Части = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Части.Добавить(Выборка.Логин);
	КонецЦикла;
	Возврат СтрСоединить(Части, ",");
КонецФункции

&НаСервере
Функция СписокКонтрагентов(Правило)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Правило", Правило);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Контрагенты.Контрагент КАК Контрагент
	|ИЗ
	|	Справочник.АИС_РазрешенныеКонтрагентыАвтоодобрения КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Владелец = &Правило
	|	И Контрагенты.Активность
	|	И НЕ Контрагенты.ПометкаУдаления";
	Части = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Части.Добавить(Строка(Выборка.Контрагент.УникальныйИдентификатор()));
	КонецЦикла;
	Возврат СтрСоединить(Части, ",");
КонецФункции

&НаСервере
Процедура СохранитьНаСервере()
	Пользователь = ТекущийПользователь();
	Если Не ЗначениеЗаполнено(Пользователь) Тогда
		ВызватьИсключение "Текущий пользователь не найден в справочнике.";
	КонецЕсли;
	Настройки = ОбеспечитьНастройки(Пользователь);
	Настройки.Включено = Включено;
	Настройки.РежимПоУмолчанию = РежимПоУмолчанию;
	Настройки.Записать();

	Для Каждого Строка Из ТаблицаТипов Цикл
		Вид = Справочники.ВидыВнутреннихДокументов.НайтиПоНаименованию(Строка.ВидДокумента, Истина);
		Если Не ЗначениеЗаполнено(Вид) Тогда
			Продолжить;
		КонецЕсли;
		Правило = ОбеспечитьПравило(Настройки, Вид);
		Правило.Режим = ?(ПустаяСтрока(Строка.Режим), "off", Строка.Режим);
		Правило.Записать();
		ЗаменитьАвторов(Правило.Ссылка, Строка.Авторы);
		ЗаменитьКонтрагентов(Правило.Ссылка, Строка.Контрагенты);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаменитьАвторов(Правило, Список)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Правило", Правило);
	Запрос.Текст = "ВЫБРАТЬ Авторы.Ссылка КАК Ссылка ИЗ Справочник.АИС_РазрешенныеАвторыАвтоодобрения КАК Авторы ГДЕ Авторы.Владелец = &Правило";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Если Объект <> Неопределено Тогда Объект.Удалить(); КонецЕсли;
	КонецЦикла;
	Для Каждого Логин Из СтрРазделить(Список, ",", Ложь) Цикл
		Пользователь = Справочники.Пользователи.НайтиПоНаименованию(СокрЛП(Логин), Истина);
		Если Не ЗначениеЗаполнено(Пользователь) Тогда Продолжить; КонецЕсли;
		Новый = Справочники.АИС_РазрешенныеАвторыАвтоодобрения.СоздатьЭлемент();
		Новый.Владелец = Правило;
		Новый.Наименование = "Автор: " + Логин;
		Новый.Пользователь = Пользователь;
		Новый.Активность = Истина;
		Новый.Записать();
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаменитьКонтрагентов(Правило, Список)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Правило", Правило);
	Запрос.Текст = "ВЫБРАТЬ Контрагенты.Ссылка КАК Ссылка ИЗ Справочник.АИС_РазрешенныеКонтрагентыАвтоодобрения КАК Контрагенты ГДЕ Контрагенты.Владелец = &Правило";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Если Объект <> Неопределено Тогда Объект.Удалить(); КонецЕсли;
	КонецЦикла;
	Для Каждого Ид Из СтрРазделить(Список, ",", Ложь) Цикл
		Попытка
			Контрагент = Справочники.Контрагенты.ПолучитьСсылку(
				Новый УникальныйИдентификатор(СокрЛП(Ид)));
		Исключение
			Продолжить;
		КонецПопытки;
		Если Не ЗначениеЗаполнено(Контрагент) Тогда Продолжить; КонецЕсли;
		Новый = Справочники.АИС_РазрешенныеКонтрагентыАвтоодобрения.СоздатьЭлемент();
		Новый.Владелец = Правило;
		Новый.Наименование = "Контрагент: " + Строка(Контрагент);
		Новый.Контрагент = Контрагент;
		Новый.Активность = Истина;
		Новый.Записать();
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
