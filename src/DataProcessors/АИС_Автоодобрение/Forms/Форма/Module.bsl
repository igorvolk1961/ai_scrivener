#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сохранить(Команда)
	СохранитьНаСервере();
	Оповестить("АИС_АвтоодобрениеИзменено");
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДляВсех(Команда)
	Для Каждого Строка Из ТаблицаТипов Цикл
		Строка.Режим = РежимПоУмолчанию;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура Закрыть(Команда)
	Закрыть();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ТекущийПользователь()
	Текущий = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если Текущий = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Справочники.Пользователи.НайтиПоНаименованию(Строка(Текущий.Имя), Истина);
КонецФункции

&НаСервере
Функция НайтиНастройки(Пользователь)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Настройки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.АИС_НастройкиАвтоодобрения КАК Настройки
	|ГДЕ
	|	Настройки.Пользователь = &Пользователь
	|	И НЕ Настройки.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка.ПолучитьОбъект();
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

&НаСервере
Функция ОбеспечитьНастройки(Пользователь)
	Настройки = НайтиНастройки(Пользователь);
	Если Настройки <> Неопределено Тогда
		Возврат Настройки;
	КонецЕсли;
	Настройки = Справочники.АИС_НастройкиАвтоодобрения.СоздатьЭлемент();
	Настройки.Наименование = "Автоодобрение: " + Строка(Пользователь);
	Настройки.Пользователь = Пользователь;
	Настройки.Включено = Ложь;
	Настройки.РежимПоУмолчанию = "off";
	Настройки.Активность = Истина;
	Настройки.Записать();
	Возврат Настройки;
КонецФункции

&НаСервере
Функция ОбеспечитьПравило(Настройки, ВидДокумента)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Настройки", Настройки.Ссылка);
	Запрос.УстановитьПараметр("Вид", ВидДокумента);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Правила.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.АИС_ПравилаАвтоодобренияПоТипам КАК Правила
	|ГДЕ
	|	Правила.Владелец = &Настройки
	|	И Правила.ВидДокумента = &Вид
	|	И НЕ Правила.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка.ПолучитьОбъект();
	КонецЕсли;
	Правило = Справочники.АИС_ПравилаАвтоодобренияПоТипам.СоздатьЭлемент();
	Правило.Владелец = Настройки.Ссылка;
	Правило.Наименование = "Правило: " + Строка(ВидДокумента);
	Правило.ВидДокумента = ВидДокумента;
	Правило.Режим = "off";
	Правило.Активность = Истина;
	Правило.Записать();
	Возврат Правило;
КонецФункции

&НаСервере
Процедура ЗаполнитьНаСервере()
	Пользователь = ТекущийПользователь();
	Настройки = ?(ЗначениеЗаполнено(Пользователь), НайтиНастройки(Пользователь), Неопределено);
	Включено = Ложь;
	РежимПоУмолчанию = "off";
	Если Настройки <> Неопределено Тогда
		Включено = Настройки.Включено;
		РежимПоУмолчанию = Настройки.РежимПоУмолчанию;
	КонецЕсли;
	ТаблицаТипов.Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Виды.Ссылка КАК Ссылка,
	|	Виды.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ВидыВнутреннихДокументов КАК Виды
	|ГДЕ
	|	НЕ Виды.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Виды.Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = ТаблицаТипов.Добавить();
		Строка.ВидДокумента = Выборка.Наименование;
		Строка.Режим = РежимПоУмолчанию;
		Если Настройки <> Неопределено Тогда
			Правило = НайтиПравило(Настройки, Выборка.Ссылка);
			Если Правило <> Неопределено Тогда
				Строка.Режим = Правило.Режим;
				Строка.Авторы = СписокАвторов(Правило.Ссылка);
				Строка.Контрагенты = СписокКонтрагентов(Правило.Ссылка);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

