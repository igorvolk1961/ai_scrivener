	ЗаписьЖурналаРегистрации(
		"АИС.ФормаВопросПоБазеЗнаний",
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		ТекстОшибки);
	Статус = "Ошибка формы: " + ТекстОшибки;
КонецПроцедуры

