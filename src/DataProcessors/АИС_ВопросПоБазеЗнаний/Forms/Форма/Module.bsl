Процедура Очистить(Команда)
	Вопрос = "";
	Ответ = "";
	ИсточникиТекст = "";
	Цитаты.Очистить();
	ФрагментТекст = "";
	ТекущийИсточникID = "";
	Статус = "";
КонецПроцедуры

&НаКлиенте
Процедура СкрытьПоказатьЦитаты(Команда)
	Элементы.ГруппаПравая.Видимость = Не Элементы.ГруппаПравая.Видимость;
	Если Элементы.ГруппаПравая.Видимость Тогда
		Элементы.КнопкаСкрытьПоказатьЦитаты.Заголовок = "Скрыть цитаты";
	Иначе
		Элементы.КнопкаСкрытьПоказатьЦитаты.Заголовок = "Показать цитаты";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Элементы.Вопрос.Доступность = Истина;
	Элементы.Вопрос.ТолькоПросмотр = Ложь;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЭтаФорма.ТолькоПросмотр = Ложь;
	Элементы.Вопрос.ТолькоПросмотр = Ложь;
	Элементы.Вопрос.Доступность = Истина;
	Элементы.ГруппаПравая.Видимость = Истина;
	Элементы.КнопкаСкрытьПоказатьЦитаты.Заголовок = "Скрыть цитаты";
	Цитаты.Очистить();
	ФрагментТекст = "";
	ТекущийИсточникID = "";
	Статус = "Задайте вопрос по базе знаний.";
	Диалоги = "";

	// Однократно заполняем настройки RAG, если они ещё не заданы.
	Попытка
		Если ПустаяСтрока(Константы.АИС_АдресRAGСервиса.Получить())
			ИЛИ ПустаяСтрока(Константы.АИС_ТокенRAGСервиса.Получить()) Тогда
			ПрежнийРежим = ПривилегированныйРежим();
			УстановитьПривилегированныйРежим(Истина);
			Если ПустаяСтрока(Константы.АИС_АдресRAGСервиса.Получить()) Тогда
				Константы.АИС_АдресRAGСервиса.Установить("http://localhost:8080");
			КонецЕсли;
			Если ПустаяСтрока(Константы.АИС_ТокенRAGСервиса.Получить()) Тогда
				ТокенRAG = ПрочитатьТокенRAGИзEnv();
				Если Не ПустаяСтрока(ТокенRAG) Тогда
					Константы.АИС_ТокенRAGСервиса.Установить(ТокенRAG);
				КонецЕсли;
			КонецЕсли;
			Константы.АИС_ТаймаутRAGСервиса.Установить(120);
			Константы.АИС_ПовторыRAGСервиса.Установить(3);
			УстановитьПривилегированныйРежим(ПрежнийРежим);
		КонецЕсли;

		// Заполняем системные промпты, если активный промпт отсутствует.
		Промпт = Справочники.АИС_Промпты.НайтиПоНаименованию("ОтветПоБазеЗнаний", Истина);
		Если Не ЗначениеЗаполнено(Промпт) Тогда
			ПрежнийРежимП = ПривилегированныйРежим();
			УстановитьПривилегированныйРежим(Истина);
			АИС_Промпты.Заполнить();
			УстановитьПривилегированныйРежим(ПрежнийРежимП);
		ИначеЕсли Не Промпт.Активность Тогда
			ПрежнийРежимП = ПривилегированныйРежим();
			УстановитьПривилегированныйРежим(Истина);
			АИС_Промпты.Заполнить();
			УстановитьПривилегированныйРежим(ПрежнийРежимП);
		КонецЕсли;
	Исключение
		// Не блокируем открытие формы из-за настроек.
	КонецПопытки;
КонецПроцедуры

&НаСервере
Функция ПрочитатьТокенRAGИзEnv()
	ПутьКEnv = "/home/igorvolk/PycharmProjects/ai_scrivener/rag-service/.env";
	Префикс = "RAG_SERVICE_TOKEN=";
	Попытка
		Чтение = Новый ЧтениеТекста(ПутьКEnv, КодировкаТекста.UTF8);
		Пока Истина Цикл
			СтрокаEnv = Чтение.ПрочитатьСтроку();
			Если СтрокаEnv = Неопределено Тогда
				Прервать;
			КонецЕсли;
			СтрокаEnv = СокрЛП(СтрокаEnv);
			Если Лев(СтрокаEnv, СтрДлина(Префикс)) = Префикс Тогда
				Чтение.Закрыть();
				Возврат СокрЛП(Сред(СтрокаEnv, СтрДлина(Префикс) + 1));
			КонецЕсли;
		КонецЦикла;
		Чтение.Закрыть();
	Исключение
		// Файл недоступен — токен остаётся в константе/настройках.
	КонецПопытки;
	Возврат "";
КонецФункции
