&НаКлиенте
Процедура Автоодобрение(Команда)
	Ссылка = НастройкиАвтоодобренияТекущегоПользователя();
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Статус = "Не удалось получить настройки автоодобрения.";
		Возврат;
	КонецЕсли;
	Параметры = Новый Структура("Ключ", Ссылка);
	ОткрытьФорму("Справочник.АИС_НастройкиАвтоодобрения.ФормаЭлемента", Параметры);
КонецПроцедуры

&НаСервере
Функция НастройкиАвтоодобренияТекущегоПользователя()
	Текущий = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если Текущий = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Пользователь = Справочники.Пользователи.НайтиПоНаименованию(Строка(Текущий.Имя), Истина);
	Если Не ЗначениеЗаполнено(Пользователь) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Настройки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.АИС_НастройкиАвтоодобрения КАК Настройки
	|ГДЕ
	|	Настройки.Пользователь = &Пользователь
	|	И НЕ Настройки.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Новая = Справочники.АИС_НастройкиАвтоодобрения.СоздатьЭлемент();
	Новая.Наименование = "Автоодобрение: " + Строка(Пользователь);
	Новая.Пользователь = Пользователь;
	Новая.Включено = Ложь;
	Новая.РежимПоУмолчанию = "off";
	Новая.Активность = Истина;
	Новая.Записать();
	Возврат Новая.Ссылка;
КонецФункции

&НаКлиенте
Процедура Спросить(Команда)
	Если ПустаяСтрока(СокрЛП(Вопрос)) Тогда
		Статус = "Введите вопрос.";
		Возврат;
	КонецЕсли;
	Статус = "Выполняется поиск и подготовка ответа...";
	Попытка
		ОтветитьНаСервере();
	Исключение
		ЗаписатьОшибкуФормы();
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ОтветитьНаСервере()
	Попытка
		Если ИскатьВДокументах Тогда
			Пользователь = ПараметрыСеанса.ТекущийПользователь;
			Если Не ЗначениеЗаполнено(Пользователь) Тогда
				ПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
				Если ПользовательИБ <> Неопределено Тогда
					Пользователь = Справочники.Пользователи.НайтиПоНаименованию(
						ПользовательИБ.Имя,
						Истина);
				КонецЕсли;
			КонецЕсли;
			Результат = АИС_ОтветПоБазеЗнаний.ОтветитьПоДокументам(
				СокрЛП(Вопрос),
				Пользователь);
		Иначе
			Результат = АИС_ОтветПоБазеЗнаний.Ответить(СокрЛП(Вопрос));
		КонецЕсли;
		Ответ = Результат.Ответ;
		Цитаты.Очистить();
		ФрагментТекст = "";
		ПерваяЦитата = Истина;
		Для Каждого Источник Из Результат.Источники Цикл
			Строка = Цитаты.Добавить();
			Строка.Представление = ПредставлениеЦитаты(Источник);
			Строка.Номер = Строка(Источник.Номер);
			Строка.Заголовок = Источник.Заголовок;
			Строка.Пункт = Источник.Пункт;
			Строка.Страница = ?(ЗначениеЗаполнено(Источник.Страница), Строка(Источник.Страница), "");
			Строка.Раздел = Источник.РазделТекст;
			Строка.Текст = Источник.Текст;
			Строка.Ссылка = Источник.Ссылка;
			Строка.ИсточникID = Источник.SourceID;
			Строка.ИсточникТип = Источник.ИсточникТип;
			Если ПерваяЦитата Тогда
				ФрагментТекст = Источник.Текст;
				ТекущийИсточникID = Источник.SourceID;
				ПерваяЦитата = Ложь;
			КонецЕсли;
		КонецЦикла;

		Если Не ПустаяСтрока(Результат.Ошибка) Тогда
			Статус = "Ошибка: " + Результат.Ошибка;
		ИначеЕсли Не Результат.Найден Тогда
			Статус = ?(ИскатьВДокументах,
				"В документах не найдено.",
				"В базе знаний не найдено.");
		Иначе
			Статус = "Готово.";
		КонецЕсли;
	Исключение
		ЗаписатьОшибкуФормы();
	КонецПопытки;
КонецПроцедуры

&НаСервере
Функция ПредставлениеЦитаты(Источник)
	Результат = "[" + Строка(Источник.Номер) + "] " + Источник.Заголовок;
	Части = Новый Массив;
	Если Не ПустаяСтрока(Источник.ДокВид) Тогда
		Части.Добавить(Источник.ДокВид);
	КонецЕсли;
	Если Не ПустаяСтрока(Источник.Статус) Тогда
		Части.Добавить("состояние: " + Источник.Статус);
	КонецЕсли;
	Если Не ПустаяСтрока(Источник.ДатаУтверждения) Тогда
		Части.Добавить("утв. " + Источник.ДатаУтверждения);
	КонецЕсли;
	Если Не ПустаяСтрока(Источник.Версия) Тогда
		Части.Добавить("версия " + Лев(Источник.Версия, 8));
	КонецЕсли;
	Если Не ПустаяСтрока(Источник.Пункт) Тогда
		Части.Добавить("п. " + Источник.Пункт);
	КонецЕсли;
	Если ЗначениеЗаполнено(Источник.Страница) Тогда
		Части.Добавить("стр. " + Строка(Источник.Страница));
	КонецЕсли;
	Если Части.Количество() > 0 Тогда
		Результат = Результат + " — " + СтрСоединить(Части, ", ");
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаСервере
Процедура ПоказатьЦитату(Строка)
	ФрагментТекст = Строка.Текст;
	ТекущийИсточникID = Строка.ИсточникID;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаЦитатПриАктивизацииСтроки(Элемент)
	Строка = Элемент.ТекущиеДанные;
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ФрагментТекст = Строка.Текст;
	ТекущийИсточникID = Строка.ИсточникID;
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьДокумент(Команда)
	ВыполнитьПоказДокумента();
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПоказДокумента()
	Строка = Элементы.ТаблицаЦитат.ТекущиеДанные;
	ИсточникID = ТекущийИсточникID;
	ИсточникТип = "";
	Если Строка <> Неопределено Тогда
		ИсточникID = Строка.ИсточникID;
		ИсточникТип = Строка.ИсточникТип;
	КонецЕсли;
	Если ПустаяСтрока(ИсточникID) Тогда
		Статус = "Выберите цитату в таблице.";
		Возврат;
	КонецЕсли;
	Попытка
		Если Не ПустаяСтрока(ИсточникТип) И Найти(ИсточникТип, "document_") = 1 Тогда
			ДанныеДокумента = ДокументДляОткрытия(ИсточникТип, ИсточникID);
			Если ДанныеДокумента.Ссылка <> Неопределено Тогда
				ОткрытьФорму(
					ДанныеДокумента.Форма,
					Новый Структура("Ключ", ДанныеДокумента.Ссылка));
				Статус = "Документ открыт.";
				Возврат;
			КонецЕсли;
		КонецЕсли;
		АдресPDF = ПолучитьСсылкуНаPDF(ИсточникID);
		Если ПустаяСтрока(АдресPDF) Тогда
			Статус = "Не удалось получить ссылку на PDF.";
			Возврат;
		КонецЕсли;
		ПерейтиПоНавигационнойСсылке(АдресPDF);
		Статус = "PDF открыт в браузере.";
	Исключение
		Статус = "Ошибка клиента: " + ОписаниеОшибки();
	КонецПопытки;
КонецПроцедуры

&НаСервере
Функция ДокументДляОткрытия(ИсточникТип, ИсточникID)
	Идентификатор = Новый УникальныйИдентификатор(ИсточникID);
	Если ИсточникТип = "document_internal" Тогда
		Возврат Новый Структура(
			"Ссылка,Форма",
			Справочники.ВнутренниеДокументы.ПолучитьСсылку(Идентификатор),
			"Справочник.ВнутренниеДокументы.Форма.ФормаЭлемента");
	ИначеЕсли ИсточникТип = "document_incoming" Тогда
		Возврат Новый Структура(
			"Ссылка,Форма",
			Справочники.ВходящиеДокументы.ПолучитьСсылку(Идентификатор),
			"Справочник.ВходящиеДокументы.Форма.ФормаЭлемента");
	ИначеЕсли ИсточникТип = "document_outgoing" Тогда
		Возврат Новый Структура(
			"Ссылка,Форма",
			Справочники.ИсходящиеДокументы.ПолучитьСсылку(Идентификатор),
			"Справочник.ИсходящиеДокументы.Форма.ФормаЭлемента");
	КонецЕсли;
	Возврат Новый Структура("Ссылка,Форма", Неопределено, "");
КонецФункции

&НаСервере
Функция ПолучитьСсылкуНаPDF(ИсточникID)
	Возврат АИС_ИнтеграцияСRAG.СсылкаНаPDF(ИсточникID);
КонецФункции

&НаСервере
Процедура ЗаписатьОшибкуФормы()
