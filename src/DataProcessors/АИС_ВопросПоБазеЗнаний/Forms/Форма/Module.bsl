&НаКлиенте
Процедура Спросить(Команда)
	Если ПустаяСтрока(СокрЛП(Вопрос)) Тогда
		Статус = "Введите вопрос.";
		Возврат;
	КонецЕсли;
	Статус = "Выполняется поиск и подготовка ответа...";
	ОтветитьНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОтветитьНаСервере()
	Результат = АИС_ОтветПоБазеЗнаний.Ответить(СокрЛП(Вопрос));
	Ответ = Результат.Ответ;
	ИсточникиТекст = "";
	Для Каждого Источник Из Результат.Источники Цикл
		СтрокаИсточника = "" + Источник.Номер + ". " + Источник.Заголовок;
		Если Не ПустаяСтрока(Источник.ДокТип) Тогда
			СтрокаИсточника = СтрокаИсточника + " (" + Источник.ДокТип + ")";
		КонецЕсли;
		Если Не ПустаяСтрока(Источник.Пункт) Тогда
			СтрокаИсточника = СтрокаИсточника + ", п. " + Источник.Пункт;
		КонецЕсли;
		Если ЗначениеЗаполнено(Источник.Страница) Тогда
			СтрокаИсточника = СтрокаИсточника + ", стр. " + Источник.Страница;
		КонецЕсли;
		ИсточникиТекст = ИсточникиТекст + СтрокаИсточника + Символы.ПС;
	КонецЦикла;

	Если Не ПустаяСтрока(Результат.Ошибка) Тогда
		Статус = "Ошибка: " + Результат.Ошибка;
	ИначеЕсли Не Результат.Найден Тогда
		Статус = "В базе знаний не найдено.";
	Иначе
		Статус = "Готово.";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Очистить(Команда)
	Вопрос = "";
	Ответ = "";
	ИсточникиТекст = "";
	Статус = "";
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Статус = "Задайте вопрос по базе знаний.";
КонецПроцедуры
