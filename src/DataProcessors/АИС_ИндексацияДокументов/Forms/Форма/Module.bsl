#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	МаксимумЗаписей = 20;
	ТолькоОшибки = Ложь;
	ЗаполнитьОчередь();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)
	ОбновитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура РазобратьОчередь(Команда)
	Результат = РазобратьОчередьНаСервере();
	Если Не ПустаяСтрока(Результат) Тогда
		Сообщить(Результат);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Переиндексировать(Команда)
	Результат = ПереиндексироватьНаСервере();
	Если Не ПустаяСтрока(Результат) Тогда
		Сообщить(Результат);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВозможныеВерсии(Команда)
	ПоказатьВозможныеВерсииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура Инвентаризация(Команда)
	ИнвентаризацияНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаОчередиПриАктивизацииСтроки(Элемент)
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОткрытьДокумент(Элемент.ТекущиеДанные.Документ);
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаВерсийПриАктивизацииСтроки(Элемент)
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ОткрытьДокумент(Элемент.ТекущиеДанные.Документ);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОткрытьДокумент(Документ)
	Если Не ЗначениеЗаполнено(Документ) Тогда
		Возврат;
	КонецЕсли;
	ОткрытьЗначение(Документ);
КонецПроцедуры

&НаСервере
Процедура ОбновитьНаСервере()
	ЗаполнитьОчередь();
КонецПроцедуры

&НаСервере
Функция РазобратьОчередьНаСервере()
	Если Не Константы.АИС_ИндексацияRAGВключена.Получить() Тогда
		Возврат "Индексация RAG выключена (константа АИС_ИндексацияRAGВключена).";
	КонецЕсли;
	Если МаксимумЗаписей <= 0 Тогда
		МаксимумЗаписей = 20;
	КонецЕсли;
	Итоги = АИС_ИндексацияДокументов.РазобратьОчередь(МаксимумЗаписей);
	ЗаполнитьОчередь();
	Возврат "Обработано: " + Итоги.Обработано
		+ ", актуализировано: " + Итоги.Актуализировано
		+ ", исключено: " + Итоги.Исключено
		+ ", ошибок: " + Итоги.Ошибок;
КонецФункции

&НаСервере
Функция ПереиндексироватьНаСервере()
	Если Не Константы.АИС_ИндексацияRAGВключена.Получить() Тогда
		Возврат "Индексация RAG выключена (константа АИС_ИндексацияRAGВключена).";
	КонецЕсли;
	Количество = АИС_ИндексацияДокументов.ПолнаяСверка();
	ЗаполнитьОчередь();
	Возврат "В очередь поставлено документов: " + Количество
		+ ". Тяжёлая индексация выполняется регламентным заданием АИС_ИндексацияRAG.";
КонецФункции

&НаСервере
Процедура ИнвентаризацияНаСервере()
	Статистика = АИС_ИндексацияДокументов.ИнвентаризацияИндексации();
КонецПроцедуры

&НаСервере
Процедура ПоказатьВозможныеВерсииНаСервере()
	ТаблицаВерсий.Очистить();
	Отчет = АИС_ИндексацияДокументов.ОтчетВозможныхВерсий(50);
	Группы = Новый Соответствие;
	Для Каждого СтрокаОтчета Из Отчет Цикл
		Строка = ТаблицаВерсий.Добавить();
		Строка.Заголовок = СтрокаОтчета.Заголовок;
		Строка.Вид = СтрокаОтчета.Вид;
		Строка.Номер = СтрокаОтчета.Номер;
		Строка.Дата = СтрокаОтчета.Дата;
		Строка.Состояние = СтрокаОтчета.Состояние;
		Строка.Финальный = СтрокаОтчета.Финальный;
		Строка.Документ = СтрокаОтчета.Документ;
		Группы.Вставить(СтрокаОтчета.Ключ, Истина);
	КонецЦикла;
	Статистика = "Групп кандидатов в версии: " + Группы.Количество()
		+ ", строк: " + ТаблицаВерсий.Количество()
		+ ". Документы не скрываются автоматически.";
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОчередь()
	ТаблицаОчереди.Очистить();
	Запрос = Новый Запрос;
	Условие = "";
	Если ТолькоОшибки Тогда
		Условие = "
		|	И Состояния.Состояние = &Ошибка";
		Запрос.УстановитьПараметр("Ошибка", "Ошибка");
	КонецЕсли;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Состояния.ТипИсточника КАК ТипИсточника,
	|	Состояния.Идентификатор КАК Идентификатор,
	|	Состояния.Состояние КАК Состояние,
	|	Состояния.Семейство КАК Семейство,
	|	Состояния.Попытки КАК Попытки,
	|	Состояния.Ошибка КАК Ошибка,
	|	Состояния.ДатаПостановки КАК ДатаПостановки
	|ИЗ
	|	РегистрСведений.АИС_СостоянияИндексации КАК Состояния
	|ГДЕ
	|	Состояния.ТипИсточника <> &Системный" + Условие + "
	|УПОРЯДОЧИТЬ ПО
	|	Состояния.ДатаПостановки УБЫВ";
	Запрос.УстановитьПараметр("Системный", "system");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = ТаблицаОчереди.Добавить();
		Строка.ТипИсточника = Выборка.ТипИсточника;
		Строка.Идентификатор = Выборка.Идентификатор;
		Строка.Документ = АИС_ИндексацияДокументов.ДокументПоИдентификатору(
			Выборка.ТипИсточника,
			Выборка.Идентификатор);
		Строка.Состояние = Выборка.Состояние;
		Строка.Семейство = Выборка.Семейство;
		Строка.Попытки = Выборка.Попытки;
		Строка.Ошибка = Выборка.Ошибка;
		Строка.ДатаПостановки = Выборка.ДатаПостановки;
	КонецЦикла;
	Статистика = "Записей в очереди: " + ТаблицаОчереди.Количество()
		+ ?(ТолькоОшибки, " (только ошибки).", ".");
КонецПроцедуры

#КонецОбласти
