&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьТриггеры();
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	ЗаполнитьТриггеры();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТриггеры()
	Попытка
	УстановитьПривилегированныйРежим(Истина);
	Сотрудник = ТекущийСотрудник();
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		Триггеры = "Не удалось определить текущего сотрудника.";
		Возврат;
	КонецЕсли;
	Настройка = АИС_АгентИИ.НайтиПоСотруднику(Сотрудник);
	Включен = Ложь;
	АвтоТриггеры = Ложь;
	Интервал = Неопределено;
	Если ЗначениеЗаполнено(Настройка) Тогда
		НастройкаОбъект = Настройка.ПолучитьОбъект();
		Если НастройкаОбъект <> Неопределено Тогда
			Включен = НастройкаОбъект.Включен;
			АвтоТриггеры = НастройкаОбъект.АвтоТриггерыВключены;
			Если НастройкаОбъект.ИнтервалПроверкиТриггеров > 0 Тогда
				Интервал = НастройкаОбъект.ИнтервалПроверкиТриггеров;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Строки = Новый Массив;
	Строки.Добавить("Подписки агента:");
	Строки.Добавить("");
	Строки.Добавить("1. Внутренний документ адресован должностному лицу");
	Строки.Добавить("   Событие: запись внутреннего документа с заполненным «Адресатом».");
	Строки.Добавить("   Действие: создание задачи «Рассмотреть и исполнить» и постановка в очередь ИИ.");
	Строки.Добавить("   Статус: активна (глобальная подписка); запуск зависит от настроек агента.");
	Строки.Добавить("");
	Строки.Добавить("2. Задача процесса «Исполнение»");
	Строки.Добавить("   Событие: появление активной задачи процесса «Исполнение» у сотрудника.");
	Строки.Добавить("   Действие: постановка задачи в очередь ИИ без ручной передачи.");
	Строки.Добавить("   Статус: " + ?(АвтоТриггеры, "включена", "выключена")
		+ "; интервал проверки: " + ?(Интервал = Неопределено, "не задан", Строка(Интервал) + " мин."));
	Строки.Добавить("");
	Строки.Добавить("3. Входящий документ получен");
	Строки.Добавить("   Событие: запись входящего документа с заполненным ответственным.");
	Строки.Добавить("   Действие: создание задачи и постановка в очередь ИИ.");
	Строки.Добавить("   Статус: активна (глобальная подписка).");
	Строки.Добавить("");

	Условия = Новый Массив;
	Условия.Добавить("Триггеры.ДЛ = &Сотрудник");
	Должность = ДолжностьСотрудника(Сотрудник);
	Если ЗначениеЗаполнено(Должность) Тогда
		Условия.Добавить("Триггеры.Должность = &Должность");
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Триггеры.ТипТриггера КАК ТипТриггера,
		|	Триггеры.Расписание КАК Расписание,
		|	Триггеры.СледующийЗапуск КАК СледующийЗапуск,
		|	Триггеры.Активность КАК Активность
		|ИЗ
		|	Справочник.АИС_РасписаниеТриггеров КАК Триггеры
		|ГДЕ
		|	" + СтрСоединить(Условия, " ИЛИ ");
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Если ЗначениеЗаполнено(Должность) Тогда
		Запрос.УстановитьПараметр("Должность", Должность);
	КонецЕсли;
	Выборка = Запрос.Выполнить().Выбрать();
	ЕстьПлановые = Ложь;
	Пока Выборка.Следующий() Цикл
		Если Не ЕстьПлановые Тогда
			Строки.Добавить("Плановые (cron) триггеры:");
			ЕстьПлановые = Истина;
		КонецЕсли;
		Строки.Добавить("• " + Строка(Выборка.ТипТриггера)
			+ "; расписание: " + Строка(Выборка.Расписание)
			+ "; следующий запуск: " + Формат(Выборка.СледующийЗапуск, "ДФ=dd.MM.yyyy HH:mm")
			+ "; " + ?(Выборка.Активность, "активен", "выключен"));
	КонецЦикла;
	Если Не ЕстьПлановые Тогда
		Строки.Добавить("Плановые (cron) триггеры: не назначены.");
	КонецЕсли;
	Триггеры = СтрСоединить(Строки, Символы.ПС);
	Исключение
		Триггеры = "Не удалось построить список триггеров: " + ОписаниеОшибки();
	КонецПопытки;
КонецПроцедуры

&НаСервере
Функция ТекущийСотрудник()
	Пользователь = ПараметрыСеанса.ТекущийПользователь;
	Если ЗначениеЗаполнено(Пользователь) Тогда
		Возврат Пользователь;
	КонецЕсли;
	ПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если ПользовательИБ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Справочники.Пользователи.НайтиПоНаименованию(ПользовательИБ.Имя, Истина);
КонецФункции

&НаСервере
Функция ДолжностьСотрудника(Сотрудник)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Сведения.Должность КАК Должность
		|ИЗ
		|	РегистрСведений.СведенияОПользователяхДокументооборот КАК Сведения
		|ГДЕ
		|	Сведения.Пользователь = &Сотрудник";
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Должность;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции
