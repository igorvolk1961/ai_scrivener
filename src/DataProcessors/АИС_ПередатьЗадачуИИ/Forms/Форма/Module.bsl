#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьТаблицуНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТаблицаЗадачПриАктивизацииСтроки(Элемент, СтандартнаяОбработка)
	Если Элементы.ТаблицаЗадач.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьДеталиНаСервере(Элементы.ТаблицаЗадач.ТекущиеДанные.Задача);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)
	ЗаполнитьТаблицуНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура Передать(Команда)
	Статус = ПередатьНаСервере(ТекущаяЗадача);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьТаблицуНаСервере()
	ТаблицаЗадач.Очистить();
	ТекущаяЗадача = Неопределено;
	Элементы.КнопкаПередать.Доступность = Ложь;
	ОписаниеЗадачи = "";
	Статус = "";

	Сотрудник = ТекущийСотрудник();
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		Статус = "Не удалось определить текущего сотрудника.";
		Возврат;
	КонецЕсли;

	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Задачи.Ссылка КАК Задача,
			|	Задачи.Description КАК Заголовок,
			|	Задачи.ПредметСтрокой КАК Предмет,
			|	Задачи.СрокИсполнения КАК Срок
			|ИЗ
			|	Задача.ЗадачаИсполнителя КАК Задачи
			|ГДЕ
			|	Задачи.Исполнитель = &Сотрудник
			|	И НЕ Задачи.Выполнена
			|	И НЕ Задачи.ПометкаУдаления
			|УПОРЯДОЧИТЬ ПО
			|	Задачи.СрокИсполнения";
		Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			СтрокаТаблицы = ТаблицаЗадач.Добавить();
			СтрокаТаблицы.Задача = Выборка.Задача;
			СтрокаТаблицы.Заголовок = Выборка.Заголовок;
			СтрокаТаблицы.Предмет = Выборка.Предмет;
			СтрокаТаблицы.Срок = Выборка.Срок;
			СтрокаТаблицы.Состояние = СостояниеАгентаПоЗадаче(Выборка.Задача);
		КонецЦикла;
		Статус = "Задач: " + ТаблицаЗадач.Количество();
		Если ТаблицаЗадач.Количество() > 0 Тогда
			ТекущаяЗадача = ТаблицаЗадач[0].Задача;
			ЗаполнитьДеталиНаСервере(ТекущаяЗадача);
		КонецЕсли;
	Исключение
		Статус = "Ошибка чтения задач: " + ОписаниеОшибки();
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеталиНаСервере(Знач Задача)
	ОписаниеЗадачи = "";
	Элементы.КнопкаПередать.Доступность = Ложь;
	Если Не ЗначениеЗаполнено(Задача) Тогда
		Статус = "Задача не выбрана.";
		Возврат;
	КонецЕсли;

	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Задачи.Description КАК Заголовок,
			|	Задачи.ПредметСтрокой КАК Предмет,
			|	Задачи.СрокИсполнения КАК Срок
			|ИЗ
			|	Задача.ЗадачаИсполнителя КАК Задачи
			|ГДЕ
			|	Задачи.Ссылка = &Задача";
		Запрос.УстановитьПараметр("Задача", Задача);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ОписаниеЗадачи = Выборка.Заголовок;
			Если Не ПустаяСтрока(Выборка.Предмет) Тогда
				ОписаниеЗадачи = ОписаниеЗадачи + Символы.ПС + "Предмет: " + Выборка.Предмет;
			КонецЕсли;
			Если ЗначениеЗаполнено(Выборка.Срок) Тогда
				ОписаниеЗадачи = ОписаниеЗадачи + Символы.ПС + "Срок: " + Формат(Выборка.Срок, "ДЛФ=DT");
			КонецЕсли;
		КонецЕсли;
		Статус = СтатусПередачи(Задача);
		Элементы.КнопкаПередать.Доступность = Не ПоследнийЗапускПоЗадаче(Задача).ЕстьЗапуск;
	Исключение
		Статус = "Ошибка чтения задачи: " + ОписаниеОшибки();
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);
КонецПроцедуры

&НаСервере
Функция ПередатьНаСервере(Знач Задача)
	Если Не ЗначениеЗаполнено(Задача) Тогда
		Возврат "Задача не выбрана.";
	КонецЕсли;
	Сотрудник = ТекущийСотрудник();
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		Возврат "Не удалось определить текущего сотрудника.";
	КонецЕсли;
	Результат = АИС_АгентИИ.ПередатьЗадачуПоЗапросу(Задача, Сотрудник, "РучнаяПередача");
	Если Результат.ОК Тогда
		Сообщение = "Задача передана агенту.";
	Иначе
		Сообщение = "Ошибка: " + Результат.Ошибка;
	КонецЕсли;
	ЗаполнитьТаблицуНаСервере();
	Статус = Сообщение;
	Возврат Статус;
КонецФункции

&НаСервере
Функция ЗадачаПринадлежитСотруднику(Задача, Сотрудник)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Задачи.Ссылка КАК Задача
		|ИЗ
		|	Задача.ЗадачаИсполнителя КАК Задачи
		|ГДЕ
		|	Задачи.Ссылка = &Задача
		|	И Задачи.Исполнитель = &Сотрудник
		|	И НЕ Задачи.Выполнена
		|	И НЕ Задачи.ПометкаУдаления";
	Запрос.УстановитьПараметр("Задача", Задача);
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат Выборка.Следующий();
КонецФункции

&НаСервере
Функция ПоследнийЗапускПоЗадаче(Задача)
	Результат = Новый Структура("ЕстьЗапуск, Состояние, Ошибка", Ложь, Неопределено, "");
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Запуски.Состояние КАК Состояние,
		|	Запуски.Ошибка КАК Ошибка
		|ИЗ
		|	Справочник.АИС_ЗапускиАгентов КАК Запуски
		|ГДЕ
		|	Запуски.Задача = &Задача
		|УПОРЯДОЧИТЬ ПО
		|	Запуски.ДатаНачала УБЫВ";
	Запрос.УстановитьПараметр("Задача", Задача);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.ЕстьЗапуск = Истина;
		Результат.Состояние = Выборка.Состояние;
		Результат.Ошибка = Выборка.Ошибка;
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаСервере
Функция СостояниеАгентаПоЗадаче(Задача)
	Данные = ПоследнийЗапускПоЗадаче(Задача);
	Если Не Данные.ЕстьЗапуск Тогда
		Возврат "не передана";
	КонецЕсли;
	Возврат Строка(Данные.Состояние);
КонецФункции

&НаСервере
Функция СтатусПередачи(Задача)
	Данные = ПоследнийЗапускПоЗадаче(Задача);

	Если Данные.ЕстьЗапуск Тогда
		Если Данные.Состояние = Перечисления.АИС_СостоянияЗапусковАгента.Ошибка Тогда
			Возврат "Ошибка. " + ?(ПустаяСтрока(Данные.Ошибка), "Агент завершил работу с ошибкой.", Данные.Ошибка);
		ИначеЕсли Данные.Состояние = Перечисления.АИС_СостоянияЗапусковАгента.Истек Тогда
			Возврат "Истек срок. " + ?(ПустаяСтрока(Данные.Ошибка), "Запуск прерван по таймауту.", Данные.Ошибка);
		ИначеЕсли Данные.Состояние = Перечисления.АИС_СостоянияЗапусковАгента.Завершен Тогда
			Возврат "Завершена. Агент закончил обработку.";
		ИначеЕсли Данные.Состояние = Перечисления.АИС_СостоянияЗапусковАгента.ОжидаетОтвета Тогда
			Возврат "Ожидает ответа. Агент ждёт подтверждения или уточнения.";
		ИначеЕсли Данные.Состояние = Перечисления.АИС_СостоянияЗапусковАгента.Выполняется Тогда
			Возврат "Выполняется. Агент обрабатывает задачу.";
		ИначеЕсли Данные.Состояние = Перечисления.АИС_СостоянияЗапусковАгента.Ожидает Тогда
			Возврат "Ожидает обработки. Задача уже передана агенту.";
		Иначе
			Возврат "Состояние: " + Строка(Данные.Состояние) + ".";
		КонецЕсли;
	КонецЕсли;

	Сотрудник = ТекущийСотрудник();
	Настройка = АИС_АгентИИ.НайтиПоСотруднику(Сотрудник);
	Если Не ЗначениеЗаполнено(Настройка)
		ИЛИ Не Настройка.Включен
		ИЛИ ПустаяСтрока(Настройка.РольПромпт) Тогда
		Возврат "Не передана. Агент сотрудника не включен или роль-промпт не сформирован.";
	КонецЕсли;
	Если Не Константы.АИС_АгентВключен.Получить() Тогда
		Возврат "Не передана. ИИ-агент выключен администратором.";
	КонецЕсли;
	Возврат "Не передана. Задачу можно передать агенту.";
КонецФункции

&НаСервере
Функция ТекущийСотрудник()
	ТекущийИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если ТекущийИБ = Неопределено Тогда
		Возврат Справочники.Пользователи.ПустаяСсылка();
	КонецЕсли;
	Возврат Справочники.Пользователи.НайтиПоНаименованию(ТекущийИБ.Имя, Истина);
КонецФункции

#КонецОбласти
