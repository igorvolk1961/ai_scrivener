#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьТаблицуНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТаблицаЗадачПриАктивизацииСтроки(Элемент, СтандартнаяОбработка)
	Если Элементы.ТаблицаЗадач.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьДеталиНаСервере(Элементы.ТаблицаЗадач.ТекущиеДанные.Задача);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)
	ЗаполнитьТаблицуНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура Передать(Команда)
	Статус = ПередатьНаСервере(ТекущаяЗадача);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьТаблицуНаСервере()
	ТаблицаЗадач.Очистить();
	ТекущаяЗадача = Неопределено;
	ОписаниеЗадачи = "";
	Статус = "";

	Сотрудник = ТекущийСотрудник();
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		Статус = "Не удалось определить текущего сотрудника.";
		Возврат;
	КонецЕсли;

	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Задачи.Ссылка КАК Задача,
			|	Задачи.Description КАК Заголовок,
			|	Задачи.ПредметСтрокой КАК Предмет,
			|	Задачи.СрокИсполнения КАК Срок
			|ИЗ
			|	Задача.ЗадачаИсполнителя КАК Задачи
			|ГДЕ
			|	Задачи.Исполнитель = &Сотрудник
			|	И НЕ Задачи.Выполнена
			|	И НЕ Задачи.ПометкаУдаления
			|УПОРЯДОЧИТЬ ПО
			|	Задачи.СрокИсполнения";
		Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			СтрокаТаблицы = ТаблицаЗадач.Добавить();
			СтрокаТаблицы.Задача = Выборка.Задача;
			СтрокаТаблицы.Заголовок = Выборка.Заголовок;
			СтрокаТаблицы.Предмет = Выборка.Предмет;
			СтрокаТаблицы.Срок = Выборка.Срок;
			СтрокаТаблицы.Состояние = СостояниеАгентаПоЗадаче(Выборка.Задача);
		КонецЦикла;
		Статус = "Задач: " + ТаблицаЗадач.Количество();
		Если ТаблицаЗадач.Количество() > 0 Тогда
			ТекущаяЗадача = ТаблицаЗадач[0].Задача;
			ЗаполнитьДеталиНаСервере(ТекущаяЗадача);
		КонецЕсли;
	Исключение
		Статус = "Ошибка чтения задач: " + ОписаниеОшибки();
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеталиНаСервере(Знач Задача)
	ОписаниеЗадачи = "";
	Если Не ЗначениеЗаполнено(Задача) Тогда
		Статус = "Задача не выбрана.";
		Возврат;
	КонецЕсли;

	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Задачи.Description КАК Заголовок,
			|	Задачи.ПредметСтрокой КАК Предмет,
			|	Задачи.СрокИсполнения КАК Срок
			|ИЗ
			|	Задача.ЗадачаИсполнителя КАК Задачи
			|ГДЕ
			|	Задачи.Ссылка = &Задача";
		Запрос.УстановитьПараметр("Задача", Задача);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ОписаниеЗадачи = Выборка.Заголовок;
			Если Не ПустаяСтрока(Выборка.Предмет) Тогда
				ОписаниеЗадачи = ОписаниеЗадачи + Символы.ПС + "Предмет: " + Выборка.Предмет;
			КонецЕсли;
			Если ЗначениеЗаполнено(Выборка.Срок) Тогда
				ОписаниеЗадачи = ОписаниеЗадачи + Символы.ПС + "Срок: " + Формат(Выборка.Срок, "ДЛФ=DT");
			КонецЕсли;
		КонецЕсли;
		Статус = СтатусПередачи(Задача);
	Исключение
		Статус = "Ошибка чтения задачи: " + ОписаниеОшибки();
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);
КонецПроцедуры

&НаСервере
Функция ПередатьНаСервере(Знач Задача)
	Если Не ЗначениеЗаполнено(Задача) Тогда
		Возврат "Задача не выбрана.";
	КонецЕсли;
	Сотрудник = ТекущийСотрудник();
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		Возврат "Не удалось определить текущего сотрудника.";
	КонецЕсли;
	Если Не Константы.АИС_АгентВключен.Получить() Тогда
		Возврат "ИИ-агент выключен администратором.";
	КонецЕсли;

	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Результат = "";
	Попытка
		Настройка = АИС_АгентИИ.НайтиПоСотруднику(Сотрудник);
		Если Не ЗначениеЗаполнено(Настройка)
			ИЛИ Не Настройка.Включен
			ИЛИ ПустаяСтрока(Настройка.РольПромпт) Тогда
			Результат = "Агент сотрудника не включен, не настроен или роль-промпт не сформирован.";
		ИначеЕсли Не ЗадачаПринадлежитСотруднику(Задача, Сотрудник) Тогда
			Результат = "Задача недоступна или уже выполнена.";
		Иначе
			Запуск = АИС_АгентИИ.ПередатьЗадачуВОчередь(Задача, "РучнаяПередача");
			Если Не ЗначениеЗаполнено(Запуск) Тогда
				Результат = "Не удалось передать задачу: она уже выполняется агентом.";
			Иначе
				Результат = "Задача передана агенту.";
			КонецЕсли;
		КонецЕсли;
	Исключение
		Результат = "Ошибка передачи задачи: " + ОписаниеОшибки();
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);

	ЗаполнитьТаблицуНаСервере();
	Если Задача = ТекущаяЗадача Тогда
		Статус = Результат;
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаСервере
Функция ЗадачаПринадлежитСотруднику(Задача, Сотрудник)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Задачи.Ссылка КАК Задача
		|ИЗ
		|	Задача.ЗадачаИсполнителя КАК Задачи
		|ГДЕ
		|	Задачи.Ссылка = &Задача
		|	И Задачи.Исполнитель = &Сотрудник
		|	И НЕ Задачи.Выполнена
		|	И НЕ Задачи.ПометкаУдаления";
	Запрос.УстановитьПараметр("Задача", Задача);
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат Выборка.Следующий();
КонецФункции

&НаСервере
Функция СостояниеАгентаПоЗадаче(Задача)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Запуски.Состояние КАК Состояние
		|ИЗ
		|	Справочник.АИС_ЗапускиАгентов КАК Запуски
		|ГДЕ
		|	Запуски.Задача = &Задача
		|УПОРЯДОЧИТЬ ПО
		|	Запуски.ДатаНачала УБЫВ";
	Запрос.УстановитьПараметр("Задача", Задача);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат "не передана";
	КонецЕсли;
	Возврат Строка(Выборка.Состояние);
КонецФункции

&НаСервере
Функция СтатусПередачи(Задача)
	Состояние = СостояниеАгентаПоЗадаче(Задача);
	Сотрудник = ТекущийСотрудник();
	Настройка = АИС_АгентИИ.НайтиПоСотруднику(Сотрудник);
	Если Не ЗначениеЗаполнено(Настройка)
		ИЛИ Не Настройка.Включен
		ИЛИ ПустаяСтрока(Настройка.РольПромпт) Тогда
		Возврат "Состояние ИИ: " + Состояние + ". Агент сотрудника не включен или роль-промпт не сформирован.";
	КонецЕсли;
	Если Не Константы.АИС_АгентВключен.Получить() Тогда
		Возврат "Состояние ИИ: " + Состояние + ". ИИ-агент выключен администратором.";
	КонецЕсли;
	Возврат "Состояние ИИ: " + Состояние + ". Можно передать задачу агенту.";
КонецФункции

&НаСервере
Функция ТекущийСотрудник()
	ТекущийИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если ТекущийИБ = Неопределено Тогда
		Возврат Справочники.Пользователи.ПустаяСсылка();
	КонецЕсли;
	Возврат Справочники.Пользователи.НайтиПоНаименованию(ТекущийИБ.Имя, Истина);
КонецФункции

#КонецОбласти
