&НаКлиенте
Процедура РасписаниеТриггеров(Команда)
	ОткрытьФорму("Справочник.АИС_РасписаниеТриггеров.ФормаСписка");
КонецПроцедуры

&НаКлиенте
Процедура Автоодобрение(Команда)
	Ссылка = НастройкиАвтоодобренияТекущегоПользователя();
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Сообщение = "Не удалось получить настройки автоодобрения.";
		Возврат;
	КонецЕсли;
	ПараметрыФормы = Новый Структура("Ключ", Ссылка);
	ОткрытьФорму("Справочник.АИС_НастройкиАвтоодобрения.Форма.ФормаЭлемента", ПараметрыФормы);
КонецПроцедуры

&НаСервере
Функция НастройкиАвтоодобренияТекущегоПользователя()
	Текущий = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если Текущий = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Пользователь = Справочники.Пользователи.НайтиПоНаименованию(Строка(Текущий.Имя), Истина);
	Если Не ЗначениеЗаполнено(Пользователь) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Настройки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.АИС_НастройкиАвтоодобрения КАК Настройки
	|ГДЕ
	|	Настройки.Пользователь = &Пользователь
	|	И НЕ Настройки.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Новая = Справочники.АИС_НастройкиАвтоодобрения.СоздатьЭлемент();
	Новая.Наименование = "Автоодобрение: " + Строка(Пользователь);
	Новая.Пользователь = Пользователь;
	Новая.Включено = Ложь;
	Новая.РежимПоУмолчанию = "off";
	Новая.Активность = Истина;
	Новая.Записать();
	Возврат Новая.Ссылка;
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗагрузитьНастройки();
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНастройки()
	Попытка
	Сотрудник = ТекущийСотрудник();
	Настройка = Неопределено;
	Если ЗначениеЗаполнено(Сотрудник) Тогда
		Настройка = АИС_АгентИИ.НайтиПоСотруднику(Сотрудник);
	КонецЕсли;
	ЕстьАгент = ЗначениеЗаполнено(Настройка);
	Если ЕстьАгент Тогда
		ОбъектНастройки = Настройка.ПолучитьОбъект();
		Если ОбъектНастройки = Неопределено Тогда
			ЕстьАгент = Ложь;
		Иначе
			Включен = ОбъектНастройки.Включен;
			РольПромпт = ОбъектНастройки.РольПромпт;
			СтатусПромпта = Строка(ОбъектНастройки.СтатусПромпта);
			ОшибкаГенерации = ОбъектНастройки.ОшибкаГенерации;
			АвтоТриггерыВключены = ОбъектНастройки.АвтоТриггерыВключены;
			ИнтервалПроверкиТриггеров = ?(ОбъектНастройки.ИнтервалПроверкиТриггеров > 0,
				ОбъектНастройки.ИнтервалПроверкиТриггеров, 5);
			МаксШагов = ?(ОбъектНастройки.МаксШагов > 0, ОбъектНастройки.МаксШагов, 20);
			Сообщение = "Агент найден. Можно изменить промпт и настройки.";
		КонецЕсли;
	КонецЕсли;
	Если Не ЕстьАгент Тогда
		Включен = Ложь;
		РольПромпт = "";
		СтатусПромпта = "Не создан";
		ОшибкаГенерации = "";
		АвтоТриггерыВключены = Истина;
		ИнтервалПроверкиТриггеров = 5;
		МаксШагов = 20;
		Сообщение = "Агент ещё не создан. Нажмите «Создать агента».";
	КонецЕсли;
	ТекущийХеш = "";
	СохраненныйХеш = "";
	Если ЕстьАгент Тогда
		СохраненныйХеш = Настройка.ХешДолжностнойИнструкции;
		ТекущийХеш = АИС_АгентИИ.ТекущийХешДолжностнойИнструкции(Сотрудник);
		Если ПустаяСтрока(СохраненныйХеш)
			И СтатусПромпта = "Сформирован"
			И Не ПустаяСтрока(РольПромпт) Тогда
			ОбъектМиграции = Настройка.ПолучитьОбъект();
			Если ОбъектМиграции <> Неопределено Тогда
				ОбъектМиграции.ХешДолжностнойИнструкции = ТекущийХеш;
				ОбъектМиграции.Записать();
				СохраненныйХеш = ТекущийХеш;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	МожноСформировать = ЕстьАгент И (СтатусПромпта = "Ошибка"
		ИЛИ ПустаяСтрока(РольПромпт)
		ИЛИ (Не ПустаяСтрока(СохраненныйХеш) И СохраненныйХеш <> ТекущийХеш));
	ОбновитьДоступность();
	ОбновитьПодвал();
	Исключение
		Подвал = "Ошибка загрузки настроек: " + ОписаниеОшибки();
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ОбновитьДоступность()
	Элементы.ПолеПромпт.Доступность = ЕстьАгент;
	Элементы.ПолеВключен.Доступность = ЕстьАгент;
	Элементы.ПолеАвтоТриггеры.Доступность = ЕстьАгент;
	Элементы.ПолеИнтервал.Доступность = ЕстьАгент;
	Элементы.ПолеМаксШагов.Доступность = ЕстьАгент;
	Элементы.КнопкаСоздать.Видимость = Не ЕстьАгент;
	Элементы.КнопкаСоздать.Доступность = Не ЕстьАгент;
	Элементы.КнопкаСформировать.Доступность = МожноСформировать;
	Элементы.КнопкаСохранить.Доступность = ЕстьАгент;
	Элементы.КнопкаВыполнить.Доступность = ЕстьАгент И Включен;
	Элементы.КнопкаТриггеры.Доступность = ЕстьАгент;
КонецПроцедуры

&НаСервере
Процедура ОбновитьПодвал(ТекстСообщения = Неопределено)
	Если ТекстСообщения = Неопределено Тогда
		ТекстСообщения = Сообщение;
	КонецЕсли;
	Текст = "Статус промпта: " + ?(ПустаяСтрока(СтатусПромпта), "не создан", СтатусПромпта) + ".";
	Если Не ПустаяСтрока(ТекстСообщения) Тогда
		Текст = Текст + " " + ТекстСообщения;
	КонецЕсли;
	Если Не ПустаяСтрока(ОшибкаГенерации) Тогда
		Текст = Текст + " Ошибка: " + ОшибкаГенерации;
	КонецЕсли;
	Если ЕстьАгент И Не МожноСформировать Тогда
		Текст = Текст + " Должностная инструкция не изменялась после последнего формирования промпта.";
	КонецЕсли;
	Подвал = Текст;
КонецПроцедуры

&НаКлиенте
Процедура СоздатьАгента(Команда)
	Результат = СоздатьАгентаНаСервере();
	ЗагрузитьНастройки();
	ОбновитьПодвал(Результат);
КонецПроцедуры

&НаСервере
Функция СоздатьАгентаНаСервере()
	Сотрудник = ТекущийСотрудник();
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		Возврат "Не удалось определить текущего сотрудника.";
	КонецЕсли;
	Настройка = АИС_АгентИИ.ОбеспечитьНастройкиАгента(Сотрудник);
	Если Не ЗначениеЗаполнено(Настройка) Тогда
		Возврат "Не удалось создать настройки агента.";
	КонецЕсли;
	АИС_АгентИИ.СформироватьРольПромпт(Настройка);
	ОбъектНастройки = Настройка.ПолучитьОбъект();
	Если ОбъектНастройки = Неопределено Тогда
		Возврат "Настройки агента не найдены после создания.";
	КонецЕсли;
	Если ОбъектНастройки.СтатусПромпта = Перечисления.АИС_СтатусыПромптаАгента.Сформирован Тогда
		ОбъектНастройки.Включен = Истина;
		ОбъектНастройки.АвтоТриггерыВключены = Истина;
		Если ОбъектНастройки.ИнтервалПроверкиТриггеров <= 0 Тогда
			ОбъектНастройки.ИнтервалПроверкиТриггеров = 5;
		КонецЕсли;
		Если ОбъектНастройки.МаксШагов <= 0 Тогда
			ОбъектНастройки.МаксШагов = 20;
		КонецЕсли;
		ОбъектНастройки.ДатаОбновления = ТекущаяДатаСеанса();
		ОбъектНастройки.Записать();
		Возврат "Агент создан, роль-промпт сформирован и агент включён.";
	КонецЕсли;
	Возврат "Агент создан, но роль-промпт не сформирован: " + ОбъектНастройки.ОшибкаГенерации;
КонецФункции

&НаКлиенте
Процедура СформироватьПромпт(Команда)
	Результат = СформироватьПромптНаСервере();
	ЗагрузитьНастройки();
	ОбновитьПодвал(Результат);
КонецПроцедуры

&НаСервере
Функция СформироватьПромптНаСервере()
	Сотрудник = ТекущийСотрудник();
	Настройка = АИС_АгентИИ.НайтиПоСотруднику(Сотрудник);
	Если Не ЗначениеЗаполнено(Настройка) Тогда
		Возврат "Сначала создайте агента.";
	КонецЕсли;
	Если Не МожноСформировать Тогда
		Возврат "Должностная инструкция не изменялась после последнего формирования промпта.";
	КонецЕсли;
	АИС_АгентИИ.СформироватьРольПромпт(Настройка);
	ОбъектНастройки = Настройка.ПолучитьОбъект();
	Если ОбъектНастройки = Неопределено Тогда
		Возврат "Настройки агента не найдены.";
	КонецЕсли;
	Если ОбъектНастройки.СтатусПромпта = Перечисления.АИС_СтатусыПромптаАгента.Сформирован Тогда
		Возврат "Роль-промпт сформирован.";
	КонецЕсли;
	Возврат "Не удалось сформировать роль-промпт: " + ОбъектНастройки.ОшибкаГенерации;
КонецФункции

&НаКлиенте
Процедура Сохранить(Команда)
	Результат = СохранитьНаСервере();
	ЗагрузитьНастройки();
	ОбновитьПодвал(Результат);
КонецПроцедуры

&НаСервере
Функция СохранитьНаСервере()
	Сотрудник = ТекущийСотрудник();
	Настройка = АИС_АгентИИ.НайтиПоСотруднику(Сотрудник);
	Если Не ЗначениеЗаполнено(Настройка) Тогда
		Возврат "Сначала создайте агента.";
	КонецЕсли;
	Если Включен И ПустаяСтрока(СокрЛП(РольПромпт)) Тогда
		Возврат "Нельзя включить агента без роль-промпта.";
	КонецЕсли;
	Если ИнтервалПроверкиТриггеров < 1 ИЛИ ИнтервалПроверкиТриггеров > 60 Тогда
		Возврат "Интервал проверки триггеров должен быть от 1 до 60 минут.";
	КонецЕсли;
	Если МаксШагов < 1 ИЛИ МаксШагов > 100 Тогда
		Возврат "Максимум шагов должен быть от 1 до 100.";
	КонецЕсли;
	Попытка
		ОбъектНастройки = Настройка.ПолучитьОбъект();
		Если ОбъектНастройки = Неопределено Тогда
			Возврат "Настройки агента не найдены.";
		КонецЕсли;
		ОбъектНастройки.Включен = Включен;
		ОбъектНастройки.РольПромпт = РольПромпт;
		ОбъектНастройки.АвтоТриггерыВключены = АвтоТриггерыВключены;
		ОбъектНастройки.ИнтервалПроверкиТриггеров = ИнтервалПроверкиТриггеров;
		ОбъектНастройки.МаксШагов = МаксШагов;
		ОбъектНастройки.ХешДолжностнойИнструкции = АИС_АгентИИ.ТекущийХешДолжностнойИнструкции(Сотрудник);
		ОбъектНастройки.ДатаОбновления = ТекущаяДатаСеанса();
		ОбъектНастройки.Записать();
	Исключение
		Возврат "Ошибка сохранения: " + ОписаниеОшибки();
	КонецПопытки;
	Возврат "Настройки сохранены.";
КонецФункции

&НаКлиенте
Процедура ВыполнитьТриггеры(Команда)
	Результат = ВыполнитьТриггерыНаСервере();
	ЗагрузитьНастройки();
	ОбновитьПодвал(Результат);
КонецПроцедуры

&НаСервере
Функция ВыполнитьТриггерыНаСервере()
	Сотрудник = ТекущийСотрудник();
	Настройка = АИС_АгентИИ.НайтиПоСотруднику(Сотрудник);
	Если Не ЗначениеЗаполнено(Настройка) Тогда
		Возврат "Сначала создайте агента.";
	КонецЕсли;
	Если Не Настройка.Включен Тогда
		Возврат "Агент выключен. Включите его перед выполнением триггеров.";
	КонецЕсли;
	Результат = АИС_АгентИИ.ВыполнитьТриггерыПоСотруднику(Сотрудник);
	Текст = "Задач поставлено в очередь: " + Строка(Результат.Задач)
		+ "; рассылок обработано досрочно: " + Строка(Результат.Рассылок) + ".";
	Если Результат.Ошибки.Количество() > 0 Тогда
		Текст = Текст + Символы.ПС + "Ошибки: " + СтрСоединить(Результат.Ошибки, "; ");
	КонецЕсли;
	Возврат Текст;
КонецФункции

&НаКлиенте
Процедура Обновить(Команда)
	ЗагрузитьНастройки();
КонецПроцедуры

&НаКлиенте
Процедура ТриггерыАгента(Команда)
	ОткрытьФорму("Обработка.АИС_ТриггерыАгента.Форма");
КонецПроцедуры
&НаКлиенте
Процедура ИсторияДействий(Команда)
	ОткрытьФорму(
		"РегистрСведений.АИС_ИсторияДействийИИ.Форма.ФормаИсторииАгента",
		Новый Структура("СотрудникФильтра", ТекущийСотрудникДляИстории()));
КонецПроцедуры

&НаСервере
Функция ТекущийСотрудникДляИстории()
	Возврат ТекущийСотрудник();
КонецФункции


&НаСервере
Функция ТекущийСотрудник()
	Пользователь = ПараметрыСеанса.ТекущийПользователь;
	Если ЗначениеЗаполнено(Пользователь) Тогда
		Возврат Пользователь;
	КонецЕсли;
	ПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если ПользовательИБ = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Справочники.Пользователи.НайтиПоНаименованию(ПользовательИБ.Имя, Истина);
КонецФункции
