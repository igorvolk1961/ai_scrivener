#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Не ЭтоАдминистратор() Тогда
		Отказ = Истина;
		Сообщить("Недостаточно прав для управления группами ИИ-агента.");
		Возврат;
	КонецЕсли;
	Элементы.Статус.ТолькоПросмотр = Истина;
	ЗаполнитьНастройки();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сохранить(Команда)
	Статус = СохранитьНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЭтоАдминистратор()
	Возврат РольДоступна("ПолныеПрава")
		ИЛИ РольДоступна("АдминистраторСистемы")
		ИЛИ РольДоступна("АИС_АдминистраторСистемы");
КонецФункции

&НаСервере
Процедура ЗаполнитьНастройки()
	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		АгентВключен = Константы.АИС_АгентВключен.Получить();
		АвтоВключениеАгентов = Константы.АИС_АвтоВключениеАгентов.Получить();
		ГруппаДокументы = Константы.АИС_ГруппаДокументыВключена.Получить();
		ГруппаПоискЗнания = Константы.АИС_ГруппаПоискЗнанияВключена.Получить();
		ГруппаИнтернет = Константы.АИС_ГруппаИнтернетВключена.Получить();
		ГруппаПерсоналОргструктура = Константы.АИС_ГруппаПерсоналОргструктураВключена.Получить();
		ГруппаРазделыДокументов = Константы.АИС_ГруппаРазделыДокументовВключена.Получить();
		ГруппаЗамечания = Константы.АИС_ГруппаЗамечанияВключена.Получить();
		ГруппаКорпусЗнаний = Константы.АИС_ГруппаКорпусЗнанийВключена.Получить();
		Статус = "Изменения вступают в силу после сохранения.";
	Исключение
		Статус = "Не удалось прочитать настройки: " + ОписаниеОшибки();
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);
КонецПроцедуры

&НаСервере
Функция СохранитьНаСервере()
	Если Не ЭтоАдминистратор() Тогда
		Возврат "Недостаточно прав для изменения групп.";
	КонецЕсли;

	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Константы.АИС_АгентВключен.Установить(АгентВключен);
		Константы.АИС_АвтоВключениеАгентов.Установить(АвтоВключениеАгентов);
		Константы.АИС_ГруппаДокументыВключена.Установить(ГруппаДокументы);
		Константы.АИС_ГруппаПоискЗнанияВключена.Установить(ГруппаПоискЗнания);
		Константы.АИС_ГруппаИнтернетВключена.Установить(ГруппаИнтернет);
		Константы.АИС_ГруппаПерсоналОргструктураВключена.Установить(ГруппаПерсоналОргструктура);
		Константы.АИС_ГруппаРазделыДокументовВключена.Установить(ГруппаРазделыДокументов);
		Константы.АИС_ГруппаЗамечанияВключена.Установить(ГруппаЗамечания);
		Константы.АИС_ГруппаКорпусЗнанийВключена.Установить(ГруппаКорпусЗнаний);
	Исключение
		УстановитьПривилегированныйРежим(ПрежнийРежим);
		Возврат "Не удалось сохранить настройки: " + ОписаниеОшибки();
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);
	Статус = "Настройки сохранены.";
	Возврат Статус;
КонецФункции

#КонецОбласти
