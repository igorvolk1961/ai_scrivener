#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьТаблицу();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)
	ЗаполнитьТаблицуНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаШаблоновПриАктивизацииСтроки(Элемент)
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	СтатусШаблона = Элемент.ТекущиеДанные.Статус;
	ТекстШаблона = Элемент.ТекущиеДанные.Текст;
КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)
	Индекс = Элементы.ТаблицаШаблонов.ТекущаяСтрока;
	Если ТипЗнч(Индекс) <> Тип("Число") Тогда
		Предупреждение("Выберите шаблон в списке.");
		Возврат;
	КонецЕсли;
	Если Индекс < 0 Тогда
		Предупреждение("Выберите шаблон в списке.");
		Возврат;
	КонецЕсли;

	СохранитьНаСервере(Индекс, СтатусШаблона, ТекстШаблона);
	ЗаполнитьТаблицуНаСервере();
	Элементы.ТаблицаШаблонов.ТекущаяСтрока = Индекс;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьТаблицуНаСервере()
	ЗаполнитьТаблицу();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицу()
	ТаблицаШаблонов.Очистить();

	ДобавитьШаблоны("ШаблоныВнутреннихДокументов", "Внутренний");
	ДобавитьШаблоны("ШаблоныВходящихДокументов", "Входящий");
	ДобавитьШаблоны("ШаблоныИсходящихДокументов", "Исходящий");
КонецПроцедуры

&НаСервере
Процедура ДобавитьШаблоны(ИмяСправочника, Вид)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Шаблоны.Ссылка КАК Ссылка,
	|	Шаблоны.Наименование КАК Наименование,
	|	Шаблоны.Заголовок КАК Заголовок,
	|	Шаблоны.Статус КАК Статус,
	|	Шаблоны.Автор КАК Автор,
	|	Шаблоны.КомментарийКШаблону КАК Текст
	|ИЗ
	|	Справочник." + ИмяСправочника + " КАК Шаблоны
	|ГДЕ
	|	НЕ Шаблоны.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Шаблоны.Наименование";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = ТаблицаШаблонов.Добавить();
		Строка.Вид = Вид;
		Строка.ИмяСправочника = ИмяСправочника;
		Строка.Ссылка = Выборка.Ссылка;
		Строка.Наименование = Выборка.Наименование;
		Строка.Заголовок = Выборка.Заголовок;
		Строка.Статус = Выборка.Статус;
		Строка.Автор = Строка(Выборка.Автор);
		Строка.Текст = Выборка.Текст;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура СохранитьНаСервере(Индекс, Статус, Текст)
	Если Индекс < 0 Или Индекс >= ТаблицаШаблонов.Количество() Тогда
		Возврат;
	КонецЕсли;

	Строка = ТаблицаШаблонов[Индекс];
	Объект = Строка.Ссылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Объект.Статус = Статус;
	Объект.КомментарийКШаблону = Текст;
	Объект.Записать();
КонецПроцедуры

#КонецОбласти
