#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Сотрудник = ПараметрыСеанса.ТекущийПользователь;
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		ТекущийИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
		Если ТекущийИБ <> Неопределено Тогда
			Сотрудник = Справочники.Пользователи.НайтиПоНаименованию(ТекущийИБ.Имя, Истина);
		КонецЕсли;
	КонецЕсли;
	Если ЭтоАдминистратор() Тогда
		// У администратора обычно нет личных документов; показываем
		// первого сотрудника, у которого уже есть документы в папках.
		Если Не ЕстьДокументыВПапках(Сотрудник) Тогда
			Найденный = НайтиСотрудникаСДокументами();
			Если ЗначениеЗаполнено(Найденный) Тогда
				Сотрудник = Найденный;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Элементы.Сотрудник.ТолькоПросмотр = Истина;
	КонецЕсли;
	ОбновитьНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)
	ОбновитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СотрудникПриИзменении(Элемент)
	ОбновитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура СортДокумент(Команда)
	СортироватьПоКолонке("Заголовок");
КонецПроцедуры

&НаКлиенте
Процедура СортДата(Команда)
	СортироватьПоКолонке("Дата");
КонецПроцедуры

&НаКлиенте
Процедура СортНазначение(Команда)
	СортироватьПоКолонке("Назначение");
КонецПроцедуры

&НаКлиенте
Процедура СортТип(Команда)
	СортироватьПоКолонке("Тип");
КонецПроцедуры

&НаКлиенте
Процедура СортПапки(Команда)
	СортироватьПоКолонке("Путь");
КонецПроцедуры

&НаКлиенте
Процедура ДеревоПапокПриАктивацииСтроки(Элемент)
	Текущая = Элементы.ДеревоПапок.ТекущиеДанные;
	Если Текущая = Неопределено Или ПустаяСтрока(Текущая.ИдРодителя) Тогда
		// Корень — показать все документы сотрудника.
		ОбновитьДокументыНаСервере("");
	Иначе
		ОбновитьДокументыНаСервере(Текущая.ИдПапки);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СоздатьПапки(Команда)
	СоздатьПапкиНаСервере();
	ОбновитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура РазложитьВсе(Команда)
	Если Не ЭтоАдминистратор() Тогда
		Предупреждение("Разложить все документы может только администратор.");
		Возврат;
	КонецЕсли;
	Результат = РазложитьВсеНаСервере();
	Сообщить("Разложено: документов " + Результат.Документов + ", задач " + Результат.Задач + ".");
	ОбновитьНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьНаСервере()
	ДеревоПапокДанные.ПолучитьЭлементы().Очистить();
	ТаблицаДокументовДанные.Очистить();
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		Возврат;
	КонецЕсли;

	ПапкиСотрудника = АИС_ПапкиДокументов.ПолучитьПапкиСотрудника(Сотрудник);
	КартаПапок = Новый Соответствие;
	Для Каждого Папка Из ПапкиСотрудника Цикл
		Если ПустаяСтрока(Папка.Родитель) Тогда
			СтрокаДерева = ДеревоПапокДанные.ПолучитьЭлементы().Добавить();
			ЗаполнитьСтрокуДерева(СтрокаДерева, Папка);
			КартаПапок.Вставить(Папка.УникальныйИдентификатор, СтрокаДерева);
		КонецЕсли;
	КонецЦикла;

	Для НомерПопытки = 1 По 10 Цикл
		ВсеРазмещены = Истина;
		Для Каждого Папка Из ПапкиСотрудника Цикл
			Если ПустаяСтрока(Папка.Родитель)
				Или КартаПапок.Получить(Папка.УникальныйИдентификатор) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Родитель = КартаПапок.Получить(Папка.Родитель);
			Если Родитель = Неопределено Тогда
				ВсеРазмещены = Ложь;
				Продолжить;
			КонецЕсли;
			СтрокаДерева = Родитель.ПолучитьЭлементы().Добавить();
			ЗаполнитьСтрокуДерева(СтрокаДерева, Папка);
			КартаПапок.Вставить(Папка.УникальныйИдентификатор, СтрокаДерева);
		КонецЦикла;
		Если ВсеРазмещены Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

	ЗаполнитьТаблицуДокументов();
КонецПроцедуры

&НаСервере
Процедура ОбновитьДокументыНаСервере(ИдПапки)
	Папка = Неопределено;
	Если Не ПустаяСтрока(ИдПапки) Тогда
		Папка = Справочники.ПапкиВнутреннихДокументов.ПолучитьСсылку(
			Новый УникальныйИдентификатор(ИдПапки));
	КонецЕсли;
	ЗаполнитьТаблицуДокументов(Папка);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуДокументов(Папка = Неопределено)
	ТаблицаДокументовДанные.Очистить();
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		Возврат;
	КонецЕсли;
	ДокументыВПапках = АИС_ПапкиДокументов.ПолучитьДокументыПоСотруднику(
		Сотрудник, Неопределено, Папка);
	КартаДокументов = Новый Соответствие;
	Для Каждого Строка Из ДокументыВПапках Цикл
		Существующая = КартаДокументов.Получить(Строка.УникальныйИдентификатор);
		Если Существующая = Неопределено Тогда
			Новая = ТаблицаДокументовДанные.Добавить();
			Новая.ИдДокумента = Строка.УникальныйИдентификатор;
			Новая.Заголовок = Строка.Заголовок;
			Новая.Дата = Строка(Строка.Дата);
			Новая.ДатаКлюч = ?(ТипЗнч(Строка.Дата) = Тип("Дата"),
				Строка.Дата, Дата(1, 1, 1));
			Новая.Назначение = Строка.Назначение;
			Новая.Тип = Строка.Тип;
			Новая.Путь = Строка.Путь;
			КартаДокументов.Вставить(Строка.УникальныйИдентификатор, Новая);
		Иначе
			Если Не ПустаяСтрока(Строка.Путь)
				И СтрНайти(Существующая.Путь, Строка.Путь) = 0 Тогда
				Существующая.Путь = ?(ПустаяСтрока(Существующая.Путь),
					Строка.Путь, Существующая.Путь + "; " + Строка.Путь);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	ОтсортироватьТаблицуДокументов();
КонецПроцедуры

&НаСервере
Процедура СортироватьПоКолонке(Поле)
	Если ПолеСортировки = Поле Тогда
		НаправлениеСортировки = Не НаправлениеСортировки;
	Иначе
		ПолеСортировки = Поле;
		НаправлениеСортировки = Истина;
	КонецЕсли;
	ОтсортироватьТаблицуДокументов();
КонецПроцедуры

&НаСервере
Процедура ОтсортироватьТаблицуДокументов()
	Если ПустаяСтрока(ПолеСортировки) Или ТаблицаДокументовДанные.Количество() < 2 Тогда
		Возврат;
	КонецЕсли;
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("ИдДокумента", Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("Заголовок", Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("Дата", Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("ДатаКлюч", Новый ОписаниеТипов("Дата"));
	ТЗ.Колонки.Добавить("Назначение", Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("Тип", Новый ОписаниеТипов("Строка"));
	ТЗ.Колонки.Добавить("Путь", Новый ОписаниеТипов("Строка"));
	Для Каждого Строка Из ТаблицаДокументовДанные Цикл
		Новая = ТЗ.Добавить();
		ЗаполнитьЗначенияСвойств(Новая, Строка);
	КонецЦикла;
	Поле = ?(ПолеСортировки = "Дата", "ДатаКлюч", ПолеСортировки);
	ТЗ.Сортировать(Поле + ?(НаправлениеСортировки, " Возр", " Убыв"));
	ТаблицаДокументовДанные.Очистить();
	Для Каждого Строка Из ТЗ Цикл
		Новая = ТаблицаДокументовДанные.Добавить();
		ЗаполнитьЗначенияСвойств(Новая, Строка);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтрокуДерева(СтрокаДерева, Папка)
	СтрокаДерева.Наименование = Папка.Наименование;
	СтрокаДерева.КоличествоДокументов = Папка.КоличествоДокументов;
	СтрокаДерева.Путь = Папка.Путь;
	СтрокаДерева.ИдПапки = Папка.УникальныйИдентификатор;
	СтрокаДерева.ИдРодителя = Папка.Родитель;
КонецПроцедуры

&НаСервере
Процедура СоздатьПапкиНаСервере()
	Если ЭтоАдминистратор() И ЗначениеЗаполнено(Сотрудник) Тогда
		АИС_ПапкиДокументов.ОбеспечитьПапкиСотрудника(Сотрудник);
	Иначе
		АИС_ПапкиДокументов.ОбеспечитьПапкиСотрудника(ПараметрыСеанса.ТекущийПользователь);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция РазложитьВсеНаСервере()
	Возврат АИС_ПапкиДокументов.ЗаполнитьПапкиПоСуществующимДокументам();
КонецФункции

&НаСервере
Функция ЕстьДокументыВПапках(Сотрудник)
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		Возврат Ложь;
	КонецЕсли;
	ПапкиСотрудника = АИС_ПапкиДокументов.ПолучитьПапкиСотрудника(Сотрудник);
	Для Каждого Папка Из ПапкиСотрудника Цикл
		Если Папка.КоличествоДокументов > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

&НаСервере
Функция НайтиСотрудникаСДокументами()
	Выборка = Справочники.Пользователи.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		Если ЕстьДокументыВПапках(Выборка.Ссылка) Тогда
			Возврат Выборка.Ссылка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаСервере
Функция ЭтоАдминистратор()
	ПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если ПользовательИБ = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Пользователи.ЭтоПолноправныйПользователь()
		Или ПользовательИБ.Роли.Содержит(Метаданные.Роли.АИС_АдминистраторСистемы);
КонецФункции

#КонецОбласти
