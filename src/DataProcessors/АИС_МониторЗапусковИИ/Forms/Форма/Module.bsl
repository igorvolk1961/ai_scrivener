#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьТаблицуНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТаблицаЗапусковПриАктивизацииСтроки(Элемент, СтандартнаяОбработка)
	Если Элементы.ТаблицаЗапусков.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ЗаполнитьДеталиНаСервере(Элементы.ТаблицаЗапусков.ТекущиеДанные.Запуск);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)
	ЗаполнитьТаблицуНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура Повторить(Команда)
	Статус = ПовторитьНаСервере(ТекущийЗапуск);
КонецПроцедуры

&НаКлиенте
Процедура Отменить(Команда)
	Статус = ОтменитьНаСервере(ТекущийЗапуск);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьТаблицуНаСервере()
	ТаблицаЗапусков.Очистить();
	ТекущийЗапуск = Неопределено;
	Ошибка = "";
	Статус = "";

	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 200
			|	Запуски.Ссылка КАК Запуск,
			|	Запуски.Сотрудник КАК Сотрудник,
			|	Запуски.Задача КАК Задача,
			|	Запуски.Состояние КАК Состояние,
			|	Запуски.Шаг КАК Шаг,
			|	Запуски.Попытки КАК Попытки,
			|	Запуски.ДатаОбновления КАК Обновлен,
			|	Запуски.Ошибка КАК Ошибка
			|ИЗ
			|	Справочник.АИС_ЗапускиАгентов КАК Запуски
			|ГДЕ
			|	Запуски.ДатаНачала >= &Начало
			|УПОРЯДОЧИТЬ ПО
			|	Запуски.ДатаОбновления УБЫВ";
		Запрос.УстановитьПараметр("Начало", ТекущаяДатаСеанса() - 90 * 86400);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			СтрокаТаблицы = ТаблицаЗапусков.Добавить();
			СтрокаТаблицы.Запуск = Выборка.Запуск;
			СтрокаТаблицы.Сотрудник = Строка(Выборка.Сотрудник);
			СтрокаТаблицы.Задача = ?(ЗначениеЗаполнено(Выборка.Задача), Строка(Выборка.Задача), "");
			СтрокаТаблицы.Состояние = Строка(Выборка.Состояние);
			СтрокаТаблицы.Шаг = Выборка.Шаг;
			СтрокаТаблицы.Попытки = Выборка.Попытки;
			СтрокаТаблицы.Обновлен = Выборка.Обновлен;
			СтрокаТаблицы.Ошибка = Выборка.Ошибка;
		КонецЦикла;
		Статус = "Запусков: " + ТаблицаЗапусков.Количество();
		Если ТаблицаЗапусков.Количество() > 0 Тогда
			ТекущийЗапуск = ТаблицаЗапусков[0].Запуск;
			ЗаполнитьДеталиНаСервере(ТекущийЗапуск);
		КонецЕсли;
	Исключение
		Статус = "Ошибка чтения запусков: " + ОписаниеОшибки();
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеталиНаСервере(Знач Запуск)
	Ошибка = "";
	Если Не ЗначениеЗаполнено(Запуск) Тогда
		Статус = "Запуск не выбран.";
		Возврат;
	КонецЕсли;

	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Запуски.Ошибка КАК Ошибка,
			|	Запуски.Состояние КАК Состояние,
			|	Запуски.Шаг КАК Шаг,
			|	Запуски.МаксШагов КАК МаксШагов,
			|	Запуски.Попытки КАК Попытки
			|ИЗ
			|	Справочник.АИС_ЗапускиАгентов КАК Запуски
			|ГДЕ
			|	Запуски.Ссылка = &Запуск";
		Запрос.УстановитьПараметр("Запуск", Запуск);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Ошибка = Выборка.Ошибка;
			Статус = "Состояние: " + Строка(Выборка.Состояние)
				+ ". Шаг " + Выборка.Шаг + " из " + Выборка.МаксШагов
				+ ", попыток: " + Выборка.Попытки;
		КонецЕсли;
	Исключение
		Статус = "Ошибка чтения запуска: " + ОписаниеОшибки();
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);
КонецПроцедуры

&НаСервере
Функция ПовторитьНаСервере(Знач Запуск)
	Если Не ЗначениеЗаполнено(Запуск) Тогда
		Возврат "Запуск не выбран.";
	КонецЕсли;
	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = АИС_АгентИИ.ПовторитьЗапуск(Запуск);
	Исключение
		Результат = "Ошибка повторного запуска: " + ОписаниеОшибки();
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);
	ЗаполнитьТаблицуНаСервере();
	Статус = Результат;
	Возврат Результат;
КонецФункции

&НаСервере
Функция ОтменитьНаСервере(Знач Запуск)
	Если Не ЗначениеЗаполнено(Запуск) Тогда
		Возврат "Запуск не выбран.";
	КонецЕсли;
	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ЗапускОбъект = Запуск.ПолучитьОбъект();
		Если ЗапускОбъект = Неопределено Тогда
			Результат = "Запуск не найден.";
		ИначеЕсли ЗапускОбъект.Состояние = Перечисления.АИС_СостоянияЗапусковАгента.Завершен Тогда
			Результат = "Запуск уже завершен.";
		Иначе
			АИС_АгентИИ.ОтменитьЗапуск(ЗапускОбъект, "Отменено администратором");
			Результат = "Запуск отменен.";
		КонецЕсли;
	Исключение
		Результат = "Ошибка отмены: " + ОписаниеОшибки();
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);
	ЗаполнитьТаблицуНаСервере();
	Статус = Результат;
	Возврат Результат;
КонецФункции

#КонецОбласти
