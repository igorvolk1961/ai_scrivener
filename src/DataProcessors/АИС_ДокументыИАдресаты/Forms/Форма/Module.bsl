Перем НомерСтроки;

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Сформировать();
КонецПроцедуры

&НаСервере
Процедура Сформировать()
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Очистить();
	НомерСтроки = 0;

	ТабличныйДокумент.Область("C1").ШиринаКолонки = 50;
	ТабличныйДокумент.Область("C2").ШиринаКолонки = 20;
	ТабличныйДокумент.Область("C3").ШиринаКолонки = 30;
	ТабличныйДокумент.Область("C4").ШиринаКолонки = 30;

	НомерСтроки = НомерСтроки + 1;
	Область = ТабличныйДокумент.Область("R" + НомерСтроки + "C1:R" + НомерСтроки + "C4");
	Область.Объединить();
	Область.Текст = "Документы и адресаты";
	Область.Шрифт = Новый Шрифт(, 14, Истина);
	Область.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;

	НомерСтроки = НомерСтроки + 1;
	ТабличныйДокумент.Область("R" + НомерСтроки + "C1").Текст =
		"Сформировано: " + Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy HH:mm");

	НомерСтроки = НомерСтроки + 1;
	ТабличныйДокумент.Область("R" + НомерСтроки + "C1").Текст = "Документ";
	ТабличныйДокумент.Область("R" + НомерСтроки + "C2").Текст = "Вид";
	ТабличныйДокумент.Область("R" + НомерСтроки + "C3").Текст = "Адресат";
	ТабличныйДокумент.Область("R" + НомерСтроки + "C4").Текст = "Подготовил";
	Для Колонка = 1 По 4 Цикл
		Область = ТабличныйДокумент.Область("R" + НомерСтроки + "C" + Колонка);
		Область.Шрифт = Новый Шрифт(, , Истина);
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Документы.Заголовок КАК Заголовок,
	|	Документы.ВидДокумента КАК Вид,
	|	Документы.Адресат КАК Адресат,
	|	Документы.Подготовил КАК Подготовил
	|ИЗ
	|	Справочник.ВнутренниеДокументы КАК Документы
	|УПОРЯДОЧИТЬ ПО
	|	Документы.Заголовок";
	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл
		НомерСтроки = НомерСтроки + 1;
		ТабличныйДокумент.Область("R" + НомерСтроки + "C1").Текст = Выборка.Заголовок;
		ТабличныйДокумент.Область("R" + НомерСтроки + "C2").Текст = Представление(Выборка.Вид);
		ТабличныйДокумент.Область("R" + НомерСтроки + "C3").Текст =
			?(ЗначениеЗаполнено(Выборка.Адресат), Представление(Выборка.Адресат), "—");
		ТабличныйДокумент.Область("R" + НомерСтроки + "C4").Текст =
			?(ЗначениеЗаполнено(Выборка.Подготовил), Представление(Выборка.Подготовил), "—");
	КонецЦикла;
КонецПроцедуры

Функция Представление(Значение, ЗначениеПоУмолчанию = "—")
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Если Значение = "" И ЗначениеПоУмолчанию <> "—" Тогда
			Возврат ЗначениеПоУмолчанию;
		КонецЕсли;
		Возврат Значение;
	КонецЕсли;
	Если ЗначениеЗаполнено(Значение) Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;
КонецФункции
