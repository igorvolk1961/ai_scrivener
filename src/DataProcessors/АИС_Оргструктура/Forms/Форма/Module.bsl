Перем НомерСтроки;
Перем ДетиПодразделений;
Перем СотрудникиПоРуководителю;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Сформировать();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура Сформировать()
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Очистить();
	НомерСтроки = 0;

	ТабличныйДокумент.Область("C1").ШиринаКолонки = 10;
	ТабличныйДокумент.Область("C2").ШиринаКолонки = 50;
	ТабличныйДокумент.Область("C3").ШиринаКолонки = 40;
	ТабличныйДокумент.Область("C4").ШиринаКолонки = 40;

	НомерСтроки = НомерСтроки + 1;
	Область = ТабличныйДокумент.Область("R" + НомерСтроки + "C1:R" + НомерСтроки + "C4");
	Область.Объединить();
	Область.Текст = "Оргструктура и персональная подчиненность";
	Область.Шрифт = Новый Шрифт(, 14, Истина);
	Область.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;

	НомерСтроки = НомерСтроки + 1;
	ТабличныйДокумент.Область("R" + НомерСтроки + "C1").Текст =
		"Сформировано: " + Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy HH:mm");

	ВывестиРаздел("1. Подразделения и руководители");
	Заголовки = Новый Массив;
	Заголовки.Добавить("Уровень");
	Заголовки.Добавить("Подразделение");
	Заголовки.Добавить("Руководитель");
	Заголовки.Добавить("");
	ВывестиСтроку(Заголовки);

	ПодготовитьПодразделения();
	ВывестиПодразделения(Неопределено, 0);

	ВывестиРаздел("2. Персональная подчиненность");
	Заголовки = Новый Массив;
	Заголовки.Добавить("");
	Заголовки.Добавить("Сотрудник");
	Заголовки.Добавить("Должность");
	Заголовки.Добавить("Руководитель");
	ВывестиСтроку(Заголовки);

	ПодготовитьСотрудников();
	ВывестиПодчиненных(Неопределено, 0);
КонецПроцедуры

&НаСервере
Процедура ПодготовитьПодразделения()
	ДетиПодразделений = Новый Соответствие;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Подразделения.Ссылка КАК Подразделение,
	|	Подразделения.Наименование КАК Наименование,
	|	Подразделения.Родитель КАК Родитель,
	|	Подразделения.Руководитель КАК Руководитель
	|ИЗ
	|	Справочник.СтруктураПредприятия КАК Подразделения
	|ГДЕ
	|	НЕ Подразделения.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Подразделения.Наименование";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Родитель) Тогда
			Ключ = Выборка.Родитель;
		Иначе
			Ключ = Неопределено;
		КонецЕсли;
		Если ДетиПодразделений.Получить(Ключ) = Неопределено Тогда
			ДетиПодразделений.Вставить(Ключ, Новый Массив);
		КонецЕсли;
		ДетиПодразделений.Получить(Ключ).Добавить(
			Новый Структура("Подразделение,Наименование,Руководитель",
				Выборка.Подразделение, Выборка.Наименование, Выборка.Руководитель));
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ВывестиПодразделения(Родитель, Уровень)
	Список = ДетиПодразделений.Получить(Родитель);
	Если Список = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Элемент Из Список Цикл
		Строка = Новый Массив;
		Строка.Добавить(Уровень);
		Строка.Добавить(Отступ(Уровень) + Элемент.Наименование);
		Строка.Добавить(Представление(Элемент.Руководитель));
		Строка.Добавить("");
		ВывестиСтроку(Строка);
		ВывестиПодразделения(Элемент.Подразделение, Уровень + 1);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПодготовитьСотрудников()
	Сотрудники = Новый ТаблицаЗначений;
	Сотрудники.Колонки.Добавить("Сотрудник");
	Сотрудники.Колонки.Добавить("ФИО");
	Сотрудники.Колонки.Добавить("Логин");
	Сотрудники.Колонки.Добавить("Подразделение");
	Сотрудники.Колонки.Добавить("Должность");
	Сотрудники.Колонки.Добавить("Руководитель");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Пользователи.Ссылка КАК Сотрудник,
	|	Пользователи.Наименование КАК Логин,
	|	Пользователи.ФизЛицо.Наименование КАК ФИО,
	|	Пользователи.Подразделение КАК Подразделение
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.Недействителен = ЛОЖЬ
	|УПОРЯДОЧИТЬ ПО
	|	Пользователи.ФизЛицо.Наименование";

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Сотрудники.Добавить();
		Строка.Сотрудник = Выборка.Сотрудник;
		Строка.ФИО = Выборка.ФИО;
		Строка.Логин = Выборка.Логин;
		Строка.Подразделение = Выборка.Подразделение;
	КонецЦикла;

	Должности = Новый Соответствие;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сведения.Пользователь КАК Сотрудник,
	|	Сведения.Должность КАК Должность
	|ИЗ
	|	РегистрСведений.СведенияОПользователяхДокументооборот КАК Сведения";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Должности.Получить(Выборка.Сотрудник) = Неопределено Тогда
			Должности.Вставить(Выборка.Сотрудник, Выборка.Должность);
		КонецЕсли;
	КонецЦикла;

	Руководители = Новый Соответствие;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Подчиненность.Подчиненный КАК Сотрудник,
	|	Подчиненность.Руководитель КАК Руководитель,
	|	Подчиненность.Подразделение КАК Подразделение
	|ИЗ
	|	РегистрСведений.ПодчиненностьСотрудников КАК Подчиненность";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Руководители.Получить(Выборка.Сотрудник) = Неопределено Тогда
			Руководители.Вставить(Выборка.Сотрудник,
				Новый Структура("Руководитель,Подразделение",
					Выборка.Руководитель, Выборка.Подразделение));
		КонецЕсли;
	КонецЦикла;

	СотрудникиПоРуководителю = Новый Соответствие;
	Для Каждого Строка Из Сотрудники Цикл
		Строка.Должность = Должности.Получить(Строка.Сотрудник);
		ДанныеРуководителя = Руководители.Получить(Строка.Сотрудник);
		Если ДанныеРуководителя = Неопределено
			ИЛИ Не ЗначениеЗаполнено(ДанныеРуководителя.Руководитель) Тогда
			Строка.Руководитель = Неопределено;
		Иначе
			Строка.Руководитель = ДанныеРуководителя.Руководитель;
			Если Не ЗначениеЗаполнено(Строка.Подразделение) Тогда
				Строка.Подразделение = ДанныеРуководителя.Подразделение;
			КонецЕсли;
		КонецЕсли;

		Если ЗначениеЗаполнено(Строка.Руководитель) Тогда
			Ключ = Строка.Руководитель;
		Иначе
			Ключ = Неопределено;
		КонецЕсли;
		Если СотрудникиПоРуководителю.Получить(Ключ) = Неопределено Тогда
			СотрудникиПоРуководителю.Вставить(Ключ, Новый Массив);
		КонецЕсли;
		СотрудникиПоРуководителю.Получить(Ключ).Добавить(Строка);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ВывестиПодчиненных(Руководитель, Уровень)
	Список = СотрудникиПоРуководителю.Получить(Руководитель);
	Если Список = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Для Каждого Строка Из Список Цикл
		СтрокаТаблицы = Новый Массив;
		СтрокаТаблицы.Добавить("");
		СтрокаТаблицы.Добавить(Отступ(Уровень) + Представление(Строка.ФИО, Строка.Логин));
		СтрокаТаблицы.Добавить(Представление(Строка.Должность));
		СтрокаТаблицы.Добавить(Представление(Строка.Руководитель));
		ВывестиСтроку(СтрокаТаблицы);
		ВывестиПодчиненных(Строка.Сотрудник, Уровень + 1);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ВывестиРаздел(Заголовок)
	НомерСтроки = НомерСтроки + 2;
	Область = ТабличныйДокумент.Область("R" + НомерСтроки + "C1:R" + НомерСтроки + "C4");
	Область.Объединить();
	Область.Текст = Заголовок;
	Область.Шрифт = Новый Шрифт(, 11, Истина);
КонецПроцедуры

&НаСервере
Процедура ВывестиСтроку(Значения)
	НомерСтроки = НомерСтроки + 1;
	Для Индекс = 1 По 4 Цикл
		Значение = "";
		Если Индекс <= Значения.Количество() Тогда
			Значение = Представление(Значения[Индекс - 1]);
		КонецЕсли;
		ТабличныйДокумент.Область("R" + НомерСтроки + "C" + Индекс).Текст = Значение;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция Отступ(Уровень)
	Результат = "";
	Для Индекс = 1 По Уровень Цикл
		Результат = Результат + "    ";
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаСервере
Функция Представление(Значение, ЗначениеПоУмолчанию = "—")
	Если ТипЗнч(Значение) = Тип("Строка") Тогда
		Если Значение = "" И ЗначениеПоУмолчанию <> "—" Тогда
			Возврат ЗначениеПоУмолчанию;
		КонецЕсли;
		Возврат Значение;
	КонецЕсли;
	Если ЗначениеЗаполнено(Значение) Тогда
		Возврат Строка(Значение);
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;
КонецФункции

#КонецОбласти
