&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Настройки = ТекущиеНастройки();
	Если Не ЗначениеЗаполнено(Объект.Владелец) Тогда
		Объект.Владелец = Настройки.Ссылка;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.Режим = "off";
		Объект.Активность = Истина;
	КонецЕсли;
	Авторы = СписокАвторов(Объект.Ссылка);
	Контрагенты = СписокКонтрагентов(Объект.Ссылка);
КонецПроцедуры

&НаКлиенте
Процедура СохранитьПравило(Команда)
	Попытка
		СохранитьНаСервере();
		Закрыть();
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФорму(Команда)
	Закрыть();
КонецПроцедуры

&НаСервере
Функция ТекущийПользователь()
	Текущий = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если Текущий = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Справочники.Пользователи.НайтиПоНаименованию(Строка(Текущий.Имя), Истина);
КонецФункции

&НаСервере
Функция ТекущиеНастройки()
	Пользователь = ТекущийПользователь();
	Если Не ЗначениеЗаполнено(Пользователь) Тогда
		ВызватьИсключение "Текущий пользователь не найден в справочнике.";
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Настройки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.АИС_НастройкиАвтоодобрения КАК Настройки
	|ГДЕ
	|	Настройки.Пользователь = &Пользователь
	|	И НЕ Настройки.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка.ПолучитьОбъект();
	КонецЕсли;
	Настройки = Справочники.АИС_НастройкиАвтоодобрения.СоздатьЭлемент();
	Настройки.Наименование = "Автоодобрение: " + Строка(Пользователь);
	Настройки.Пользователь = Пользователь;
	Настройки.Включено = Ложь;
	Настройки.РежимПоУмолчанию = "off";
	Настройки.Активность = Истина;
	Настройки.Записать();
	Возврат Настройки;
КонецФункции

&НаСервере
Функция СписокАвторов(Правило)
	Если Не ЗначениеЗаполнено(Правило) Тогда
		Возврат "";
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Правило", Правило);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Авторы.Пользователь.Наименование КАК Логин
	|ИЗ
	|	Справочник.АИС_РазрешенныеАвторыАвтоодобрения КАК Авторы
	|ГДЕ
	|	Авторы.Владелец = &Правило
	|	И Авторы.Активность
	|	И НЕ Авторы.ПометкаУдаления";
	Части = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Части.Добавить(Выборка.Логин);
	КонецЦикла;
	Возврат СтрСоединить(Части, ",");
КонецФункции

&НаСервере
Функция СписокКонтрагентов(Правило)
	Если Не ЗначениеЗаполнено(Правило) Тогда
		Возврат "";
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Правило", Правило);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Контрагенты.Контрагент КАК Контрагент
	|ИЗ
	|	Справочник.АИС_РазрешенныеКонтрагентыАвтоодобрения КАК Контрагенты
	|ГДЕ
	|	Контрагенты.Владелец = &Правило
	|	И Контрагенты.Активность
	|	И НЕ Контрагенты.ПометкаУдаления";
	Части = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Части.Добавить(Строка(Выборка.Контрагент.УникальныйИдентификатор()));
	КонецЦикла;
	Возврат СтрСоединить(Части, ",");
КонецФункции

&НаСервере
Процедура СохранитьНаСервере()
	Если Не ЗначениеЗаполнено(Объект.ВидДокумента) Тогда
		ВызватьИсключение "Выберите тип документа.";
	КонецЕсли;
	Если Объект.Режим <> "off" И Объект.Режим <> "on"
		И Объект.Режим <> "depends_on_author" Тогда
		ВызватьИсключение "Выберите режим автоодобрения.";
	КонецЕсли;
	Настройки = ТекущиеНастройки();
	Если Не ЗначениеЗаполнено(Объект.Владелец) Тогда
		Объект.Владелец = Настройки.Ссылка;
	КонецЕсли;
	Объект.Наименование = "Правило: " + Строка(Объект.ВидДокумента);
	НачатьТранзакцию();
	Попытка
		Объект.Записать();
		ЗаменитьАвторов(Объект.Ссылка, Авторы);
		ЗаменитьКонтрагентов(Объект.Ссылка, Контрагенты);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ЗаменитьАвторов(Правило, Список)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Правило", Правило);
	Запрос.Текст = "ВЫБРАТЬ Авторы.Ссылка КАК Ссылка ИЗ Справочник.АИС_РазрешенныеАвторыАвтоодобрения КАК Авторы ГДЕ Авторы.Владелец = &Правило";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элемент = Выборка.Ссылка.ПолучитьОбъект();
		Если Элемент <> Неопределено Тогда
			Элемент.Удалить();
		КонецЕсли;
	КонецЦикла;
	Для Каждого Логин Из СтрРазделить(Список, ",", Ложь) Цикл
		Пользователь = Справочники.Пользователи.НайтиПоНаименованию(СокрЛП(Логин), Истина);
		Если Не ЗначениеЗаполнено(Пользователь) Тогда
			Продолжить;
		КонецЕсли;
		НовыйЭлемент = Справочники.АИС_РазрешенныеАвторыАвтоодобрения.СоздатьЭлемент();
		НовыйЭлемент.Владелец = Правило;
		НовыйЭлемент.Наименование = "Автор: " + Логин;
		НовыйЭлемент.Пользователь = Пользователь;
		НовыйЭлемент.Активность = Истина;
		НовыйЭлемент.Записать();
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаменитьКонтрагентов(Правило, Список)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Правило", Правило);
	Запрос.Текст = "ВЫБРАТЬ Контрагенты.Ссылка КАК Ссылка ИЗ Справочник.АИС_РазрешенныеКонтрагентыАвтоодобрения КАК Контрагенты ГДЕ Контрагенты.Владелец = &Правило";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элемент = Выборка.Ссылка.ПолучитьОбъект();
		Если Элемент <> Неопределено Тогда
			Элемент.Удалить();
		КонецЕсли;
	КонецЦикла;
	Для Каждого Ид Из СтрРазделить(Список, ",", Ложь) Цикл
		Попытка
			Контрагент = Справочники.Контрагенты.ПолучитьСсылку(
				Новый УникальныйИдентификатор(СокрЛП(Ид)));
		Исключение
			Продолжить;
		КонецПопытки;
		Если Не ЗначениеЗаполнено(Контрагент) Тогда
			Продолжить;
		КонецЕсли;
		НовыйЭлемент = Справочники.АИС_РазрешенныеКонтрагентыАвтоодобрения.СоздатьЭлемент();
		НовыйЭлемент.Владелец = Правило;
		НовыйЭлемент.Наименование = "Контрагент: " + Строка(Контрагент);
		НовыйЭлемент.Контрагент = Контрагент;
		НовыйЭлемент.Активность = Истина;
		НовыйЭлемент.Записать();
	КонецЦикла;
КонецПроцедуры
