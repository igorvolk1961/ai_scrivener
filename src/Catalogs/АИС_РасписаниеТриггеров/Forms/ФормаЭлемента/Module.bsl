&НаКлиенте
Процедура СгенерироватьПромпт(Команда)
	Сообщить(СгенерироватьПромптНаСервере());
КонецПроцедуры

&НаСервере
Функция СгенерироватьПромптНаСервере()
	Попытка
		Если Объект.Ссылка = Справочники.АИС_РасписаниеТриггеров.ПустаяСсылка() Тогда
			Объект.Записать();
		КонецЕсли;
		Текст = АИС_РасписанияТриггеров.СгенерироватьПромптРеакции(Объект);
		Объект.ПромптРеакции = Текст;
		Объект.Записать();
		Возврат "Промпт реакции сгенерирован. Проверьте и при необходимости отредактируйте его.";
	Исключение
		Возврат "Не удалось сгенерировать промпт реакции: " + ОписаниеОшибки();
	КонецПопытки;
КонецФункции

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Объект.Ссылка = Справочники.АИС_РасписаниеТриггеров.ПустаяСсылка() Тогда
		Объект.Периодичность = Перечисления.АИС_ВидыПериодичностиТриггеров.Ежедневно;
		Объект.ВремяЗапуска = "09:30";
		Объект.ДеньНедели = 5;
		Объект.ДеньМесяца = 1;
		Объект.МесяцКвартала = 1;
		Объект.СрокИсполненияМинут = 30;
		Объект.Активность = Истина;
		Если Не ЗначениеЗаполнено(Объект.Автор) Тогда
			Объект.Автор = ПараметрыСеанса.ТекущийПользователь;
		КонецЕсли;
		Объект.ТипТриггера = АИС_ОбщегоНазначения.НайтиИлиСоздатьТипТриггера("Таймер");
	КонецЕсли;

	Если Не ПустаяСтрока(Объект.Расписание) Тогда
		Разбор = АИС_РасписанияТриггеров.РазобратьВыражение(Объект.Расписание);
		Если ПустаяСтрока(Разбор.Ошибка) Тогда
			Если Разбор.Вид = "daily" Тогда
				Объект.Периодичность = Перечисления.АИС_ВидыПериодичностиТриггеров.Ежедневно;
			ИначеЕсли Разбор.Вид = "weekly" Тогда
				Объект.Периодичность = Перечисления.АИС_ВидыПериодичностиТриггеров.Еженедельно;
				Объект.ДеньНедели = Разбор.ДеньНедели;
			ИначеЕсли Разбор.Вид = "monthly" Тогда
				Объект.Периодичность = Перечисления.АИС_ВидыПериодичностиТриггеров.Ежемесячно;
				Объект.ДеньМесяца = Разбор.ДеньМесяца;
			ИначеЕсли Разбор.Вид = "quarterly" Тогда
				Объект.Периодичность = Перечисления.АИС_ВидыПериодичностиТриггеров.Ежеквартально;
				Объект.МесяцКвартала = Разбор.МесяцКвартала;
				Объект.ДеньМесяца = Разбор.ДеньМесяца;
			ИначеЕсли Разбор.Вид = "cron" Тогда
				Объект.Периодичность = Перечисления.АИС_ВидыПериодичностиТриггеров.Cron;
				Объект.CronВыражение = СокрЛП(Сред(Объект.Расписание, СтрДлина("cron ") + 1));
			КонецЕсли;
			Если Разбор.Вид <> "cron" Тогда
				Объект.ВремяЗапуска = АИС_РасписанияТриггеров.ВременаВСтроку(Разбор.Времена);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры
