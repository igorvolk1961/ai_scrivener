&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Порядок = Список.КомпоновщикНастроек.Настройки.Порядок;
	Порядок.Элементы.Очистить();
	ЭлементПорядка = Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
	ЭлементПорядка.Поле = Новый ПолеКомпоновкиДанных("Наименование");
	ЭлементПорядка.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Возр;
	ЭлементПорядка.Использование = Истина;
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЭлемент(Команда)
	ПараметрыФормы = Новый Структура("Ключ", Справочники.АИС_РасписаниеТриггеров.ПустаяСсылка());
	ОткрытьФорму("Справочник.АИС_РасписаниеТриггеров.Форма.ФормаЭлемента", ПараметрыФормы);
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьЭлемент(Команда)
	Если Элементы.Список.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПараметрыФормы = Новый Структура("Ключ", Элементы.Список.ТекущиеДанные.Ссылка);
	ОткрытьФорму("Справочник.АИС_РасписаниеТриггеров.Форма.ФормаЭлемента", ПараметрыФормы);
КонецПроцедуры

&НаКлиенте
Процедура УдалитьЭлемент(Команда)
	Текущие = Элементы.Список.ТекущиеДанные;
	Если Текущие = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Ответ = Вопрос("Удалить расписание " + Текущие.Наименование + "?", РежимДиалогаВопрос.ДаНет);
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Объект = Текущие.Ссылка.ПолучитьОбъект();
		Если Объект <> Неопределено Тогда
			Объект.Удалить();
		КонецЕсли;
	Исключение
		Сообщить("Не удалось удалить расписание: " + ОписаниеОшибки());
	КонецПопытки;
	Список.Обновить();
КонецПроцедуры
