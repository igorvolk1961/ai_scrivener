Процедура ПередЗаписью(Отказ)
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;

	Если ЭтоНовый() Тогда
		Если Не ЗначениеЗаполнено(ЭтотОбъект.Периодичность) Тогда
			ЭтотОбъект.Периодичность = Перечисления.АИС_ВидыПериодичностиТриггеров.Ежедневно;
		КонецЕсли;
		Если ПустаяСтрока(ЭтотОбъект.ВремяЗапуска) Тогда
			ЭтотОбъект.ВремяЗапуска = "09:30";
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ЭтотОбъект.ДеньНедели) Тогда
			ЭтотОбъект.ДеньНедели = 5;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ЭтотОбъект.ДеньМесяца) Тогда
			ЭтотОбъект.ДеньМесяца = 1;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ЭтотОбъект.МесяцКвартала) Тогда
			ЭтотОбъект.МесяцКвартала = 1;
		КонецЕсли;
		Если ЭтотОбъект.СрокИсполненияМинут <= 0 Тогда
			ЭтотОбъект.СрокИсполненияМинут = 30;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ЭтотОбъект.Автор) Тогда
			ЭтотОбъект.Автор = ПараметрыСеанса.ТекущийПользователь;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ЭтотОбъект.ТипТриггера) Тогда
			ЭтотОбъект.ТипТриггера = АИС_ОбщегоНазначения.НайтиИлиСоздатьТипТриггера("Таймер");
		КонецЕсли;
		ЭтотОбъект.Активность = Истина;
	КонецЕсли;

	Если ЭтотОбъект.СрокИсполненияМинут <= 0 Тогда
		ЭтотОбъект.СрокИсполненияМинут = 30;
	КонецЕсли;

	Результат = АИС_РасписанияТриггеров.СобратьРасписание(ЭтотОбъект);
	Если Не ПустаяСтрока(Результат.Ошибка) Тогда
		Отказ = Истина;
		ВызватьИсключение Результат.Ошибка;
	КонецЕсли;
	ЭтотОбъект.Расписание = Результат.Расписание;

	Следующий = АИС_РасписанияТриггеров.СледующийЗапуск(Результат.Расписание, ТекущаяДатаСеанса());
	Если Следующий = Неопределено Тогда
		Отказ = Истина;
		ВызватьИсключение "Не удалось рассчитать следующий запуск по расписанию: " + Результат.Расписание;
	КонецЕсли;
	ЭтотОбъект.СледующийЗапуск = Следующий;

	Если Не ЗначениеЗаполнено(ЭтотОбъект.Автор) Тогда
		ЭтотОбъект.Автор = ?(ЗначениеЗаполнено(ПараметрыСеанса.ТекущийПользователь),
			ПараметрыСеанса.ТекущийПользователь, ЭтотОбъект.ДЛ);
	КонецЕсли;
КонецПроцедуры
