#Область ПрограммныйИнтерфейс

Функция СписокМатериалов(Аргументы, Контекст) Экспорт
	Попытка
		Фильтр = НРег(СтрокаАргумента(Аргументы, "query"));
		Предел = Предел(Аргументы, 50, 200);
		Свои = Новый Соответствие;
		Для Каждого Загрузка Из АИС_КорпусЗнаний.ЗагрузкиПоСотруднику(
			СотрудникКонтекста(Контекст)) Цикл
			Свои.Вставить(Строка(Загрузка.Хеш), Истина);
		КонецЦикла;
		Результат = Новый Массив;
		Для Каждого Материал Из АИС_КорпусЗнаний.МатериалыПоФильтру("", "") Цикл
			Поиск = НРег(Строка(Материал.Наименование) + " "
				+ Строка(Материал.ВидДокумента) + " "
				+ Строка(Материал.Комментарий));
			Если Не ПустаяСтрока(Фильтр) И СтрНайти(Поиск, Фильтр) = 0 Тогда
				Продолжить;
			КонецЕсли;
			Хеш = Строка(Материал.Хеш);
			Результат.Добавить(Новый Структура(
				"hash,title,doc_type,mime,size,status,path,own",
				Хеш,
				Строка(Материал.Наименование),
				Строка(Материал.ВидДокумента),
				Строка(Материал.MIME),
				Материал.Размер,
				Строка(Материал.Статус),
				Строка(Материал.ПутьВХранилище),
				Свои.Получить(Хеш) = Истина));
			Если Результат.Количество() >= Предел Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Возврат Новый Структура("Материалы", Результат);
	Исключение
		Возврат ОшибкаАргументов(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

Функция ЗарегистрироватьМатериал(Аргументы, Контекст) Экспорт
	Попытка
		Путь = СтрокаАргумента(Аргументы, "path");
		Заголовок = СтрокаАргумента(Аргументы, "title");
		Если ПустаяСтрока(Путь) ИЛИ ПустаяСтрока(Заголовок) Тогда
			Возврат ОшибкаАргументов("Нужны path и title.");
		КонецЕсли;
		ОтносительныйПуть = АИС_КорпусЗнаний.ПроверитьПуть(Путь);
		ПолныйПуть = АИС_КорпусЗнаний.КаталогКорпуса() + "/" + ОтносительныйПуть;
		Файл = Новый Файл(ПолныйПуть);
		Двоичные = Новый ДвоичныеДанные(Файл.ПолноеИмя);
		Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
		Хеширование.Добавить(Двоичные);
		Хеш = НРег(СтрЗаменить(Хеширование.ХешСумма, " ", ""));
		Сотрудник = СотрудникКонтекста(Контекст);
		Логин = ?(ЗначениеЗаполнено(Сотрудник), Строка(Сотрудник.Наименование), "");
		ЗадачаИд = "";
		Если ТипЗнч(Контекст) = Тип("Структура") Тогда
			Задача = Неопределено;
			Контекст.Свойство("Задача", Задача);
			Если ЗначениеЗаполнено(Задача) Тогда
				ЗадачаИд = Строка(Задача.УникальныйИдентификатор());
			КонецЕсли;
		КонецЕсли;
		ИсточникURL = СтрокаАргумента(Аргументы, "source_url");
		ВидИсточника = СтрокаАргумента(Аргументы, "source_kind");
		Если ПустаяСтрока(ВидИсточника) Тогда
			ВидИсточника = "other";
		КонецЕсли;
		Материал = АИС_КорпусЗнаний.ЗарегистрироватьМатериал(Новый Структура(
			"Хеш,Наименование,Размер,MIME,Путь,ВидДокумента,Статус,Комментарий",
			Хеш,
			Заголовок,
			Файл.Размер(),
			MIMEПоРасширению(Файл.Расширение),
			ОтносительныйПуть,
			СтрокаАргумента(Аргументы, "doc_type"),
			"загружен",
			СтрокаАргумента(Аргументы, "notes")));
		Загрузка = АИС_КорпусЗнаний.ЗарегистрироватьЗагрузку(Новый Структура(
			"Хеш,ИсточникURL,Сотрудник,Должность,Задача,ВидИсточника,АвторОрган,"
			+ "ДатаПубликации,ДатаЗагрузки,Лицензия,Статус,Комментарий",
			Хеш,
			ИсточникURL,
			Логин,
			"",
			ЗадачаИд,
			ВидИсточника,
			СтрокаАргумента(Аргументы, "authority"),
			СтрокаАргумента(Аргументы, "published_at"),
			ТекущаяДатаСеанса(),
			СтрокаАргумента(Аргументы, "license"),
			"загружен",
			СтрокаАргумента(Аргументы, "notes")));
		Возврат Новый Структура(
			"hash,title,path,size,status,download",
			Хеш,
			Заголовок,
			ОтносительныйПуть,
			Файл.Размер(),
			"загружен",
			Строка(Загрузка.УникальныйИдентификатор()));
	Исключение
		Возврат ОшибкаАргументов(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция MIMEПоРасширению(Расширение)
	Расширение = НРег(СокрЛП(Расширение));
	Если Расширение = "pdf" Тогда
		Возврат "application/pdf";
	ИначеЕсли Расширение = "doc" Тогда
		Возврат "application/msword";
	ИначеЕсли Расширение = "docx" Тогда
		Возврат "application/vnd.openxmlformats-officedocument.wordprocessingml.document";
	ИначеЕсли Расширение = "xls" Тогда
		Возврат "application/vnd.ms-excel";
	ИначеЕсли Расширение = "xlsx" Тогда
		Возврат "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
	ИначеЕсли Расширение = "txt" Тогда
		Возврат "text/plain";
	КонецЕсли;
	Возврат "application/octet-stream";
КонецФункции

Функция СотрудникКонтекста(Контекст)
	Сотрудник = Неопределено;
	Если ТипЗнч(Контекст) = Тип("Структура") Тогда
		Контекст.Свойство("Сотрудник", Сотрудник);
	КонецЕсли;
	Если ЗначениеЗаполнено(Сотрудник) Тогда
		Возврат Сотрудник;
	КонецЕсли;
	Возврат ПараметрыСеанса.ТекущийПользователь;
КонецФункции

Функция Предел(Аргументы, ПоУмолчанию, Максимум)
	Значение = ЗначениеАргумента(Аргументы, "limit");
	Если ТипЗнч(Значение) = Тип("Число") И Значение > 0 Тогда
		Возврат Мин(Значение, Максимум);
	КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции

Функция ЗначениеАргумента(Аргументы, Имя)
	Значение = Неопределено;
	Если ТипЗнч(Аргументы) = Тип("Структура") Тогда
		Аргументы.Свойство(Имя, Значение);
	ИначеЕсли ТипЗнч(Аргументы) = Тип("Соответствие") Тогда
		Значение = Аргументы.Получить(Имя);
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция СтрокаАргумента(Аргументы, Имя)
	Значение = ЗначениеАргумента(Аргументы, Имя);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));
КонецФункции

Функция ОшибкаАргументов(Текст)
	Возврат Новый Структура("КодОшибки,ТекстОшибки", "invalid_arguments", Текст);
КонецФункции

#КонецОбласти
