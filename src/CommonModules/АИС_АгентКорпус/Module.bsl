#Область ПрограммныйИнтерфейс

Функция СписокМатериалов(Аргументы, Контекст) Экспорт
	Попытка
		Фильтр = НРег(СтрокаАргумента(Аргументы, "query"));
		Предел = Предел(Аргументы, 50, 200);
		Свои = Новый Соответствие;
		Для Каждого Загрузка Из АИС_КорпусЗнаний.ЗагрузкиПоСотруднику(
			СотрудникКонтекста(Контекст)) Цикл
			Свои.Вставить(Строка(Загрузка.Хеш), Истина);
		КонецЦикла;
		Результат = Новый Массив;
		Для Каждого Материал Из АИС_КорпусЗнаний.МатериалыПоФильтру("", "") Цикл
			Поиск = НРег(Строка(Материал.Наименование) + " "
				+ Строка(Материал.ВидДокумента) + " "
				+ Строка(Материал.Комментарий));
			Если Не ПустаяСтрока(Фильтр) И СтрНайти(Поиск, Фильтр) = 0 Тогда
				Продолжить;
			КонецЕсли;
			Хеш = Строка(Материал.Хеш);
			Результат.Добавить(Новый Структура(
				"hash,title,doc_type,mime,size,status,path,own",
				Хеш,
				Строка(Материал.Наименование),
				Строка(Материал.ВидДокумента),
				Строка(Материал.MIME),
				Материал.Размер,
				Строка(Материал.Статус),
				Строка(Материал.ПутьВХранилище),
				Свои.Получить(Хеш) = Истина));
			Если Результат.Количество() >= Предел Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Возврат Новый Структура("Материалы", Результат);
	Исключение
		Возврат ОшибкаАргументов(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

Функция СкачатьМатериал(Аргументы, Контекст) Экспорт
	Попытка
		URL = СтрокаАргумента(Аргументы, "url");
		Заголовок = СтрокаАргумента(Аргументы, "title");
		Если ПустаяСтрока(URL) ИЛИ ПустаяСтрока(Заголовок) Тогда
			Возврат ОшибкаАргументов("Нужны url и title.");
		КонецЕсли;
		ПараметрыКорпуса = Настройки();
		Хост = ХостИзURL(URL);
		Если ПустаяСтрока(Хост) Тогда
			Возврат ОшибкаАргументов("Разрешены только https-ссылки.");
		КонецЕсли;
		Если Не РазрешённыйХост(Хост, ПараметрыКорпуса.allowed_hosts) Тогда
			Возврат ОшибкаАргументов("Хост не разрешён для скачивания: " + Хост);
		КонецЕсли;
		Расширение = РасширениеИзURL(URL);
		Если Не РазрешённоеРасширение(Расширение, ПараметрыКорпуса.allowed_extensions) Тогда
			Возврат ОшибкаАргументов("Расширение не разрешено: " + Расширение);
		КонецЕсли;
		Соединение = Новый HTTPСоединение(
			Хост, 443, , , , 60, Новый ЗащищенноеСоединениеOpenSSL);
		Ответ = Соединение.Получить(Новый HTTPЗапрос(ПутьИзURL(URL)));
		Если Ответ.КодСостояния >= 300 И Ответ.КодСостояния < 400 Тогда
			Возврат ОшибкаАргументов("Редиректы при скачивании запрещены.");
		КонецЕсли;
		Если Ответ.КодСостояния <> 200 Тогда
			Возврат ОшибкаАргументов("HTTP " + Ответ.КодСостояния);
		КонецЕсли;
		Двоичные = Ответ.ПолучитьТелоКакДвоичныеДанные();
		Если Двоичные.Размер() > ПараметрыКорпуса.max_file_mb * 1024 * 1024 Тогда
			Возврат ОшибкаАргументов(
				"Файл больше лимита " + ПараметрыКорпуса.max_file_mb + " МБ.");
		КонецЕсли;
		Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
		Хеширование.Добавить(Двоичные);
		Хеш = НРег(СтрЗаменить(Хеширование.ХешСумма, " ", ""));
		ОтносительныйПуть = "incoming/" + Хеш + "." + Расширение;
		Каталог = АИС_КорпусЗнаний.КаталогКорпуса() + "/incoming";
		Если Не Новый Файл(Каталог).Существует() Тогда
			СоздатьКаталог(Каталог);
		КонецЕсли;
		Двоичные.Записать(АИС_КорпусЗнаний.КаталогКорпуса() + "/" + ОтносительныйПуть);
		Возврат ЗарегистрироватьМатериал(Новый Структура(
			"path,title,source_url,source_kind,authority,published_at,license,doc_type,notes",
			ОтносительныйПуть,
			Заголовок,
			URL,
			СтрокаАргумента(Аргументы, "source_kind"),
			СтрокаАргумента(Аргументы, "authority"),
			СтрокаАргумента(Аргументы, "published_at"),
			СтрокаАргумента(Аргументы, "license"),
			СтрокаАргумента(Аргументы, "doc_type"),
			СтрокаАргумента(Аргументы, "notes")), Контекст);
	Исключение
		Возврат ОшибкаАргументов(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

Функция ЗарегистрироватьМатериал(Аргументы, Контекст) Экспорт
	Попытка
		Путь = СтрокаАргумента(Аргументы, "path");
		Заголовок = СтрокаАргумента(Аргументы, "title");
		Если ПустаяСтрока(Путь) ИЛИ ПустаяСтрока(Заголовок) Тогда
			Возврат ОшибкаАргументов("Нужны path и title.");
		КонецЕсли;
		ОтносительныйПуть = АИС_КорпусЗнаний.ПроверитьПуть(Путь);
		ПолныйПуть = АИС_КорпусЗнаний.КаталогКорпуса() + "/" + ОтносительныйПуть;
		Файл = Новый Файл(ПолныйПуть);
		ПараметрыКорпуса = Настройки();
		Если Файл.Размер() > ПараметрыКорпуса.max_file_mb * 1024 * 1024 Тогда
			Возврат ОшибкаАргументов(
				"Файл больше лимита " + ПараметрыКорпуса.max_file_mb + " МБ.");
		КонецЕсли;
		Если Не РазрешённоеРасширение(Файл.Расширение, ПараметрыКорпуса.allowed_extensions) Тогда
			Возврат ОшибкаАргументов("Расширение файла не разрешено: " + Файл.Расширение);
		КонецЕсли;
		Двоичные = Новый ДвоичныеДанные(Файл.ПолноеИмя);
		Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
		Хеширование.Добавить(Двоичные);
		Хеш = НРег(СтрЗаменить(Хеширование.ХешСумма, " ", ""));
		Сотрудник = СотрудникКонтекста(Контекст);
		Логин = ?(ЗначениеЗаполнено(Сотрудник), Строка(Сотрудник.Наименование), "");
		ЗадачаИд = "";
		Если ТипЗнч(Контекст) = Тип("Структура") Тогда
			Задача = Неопределено;
			Контекст.Свойство("Задача", Задача);
			Если ЗначениеЗаполнено(Задача) Тогда
				ЗадачаИд = Строка(Задача.УникальныйИдентификатор());
			КонецЕсли;
		КонецЕсли;
		ИсточникURL = СтрокаАргумента(Аргументы, "source_url");
		ВидИсточника = СтрокаАргумента(Аргументы, "source_kind");
		Если ПустаяСтрока(ВидИсточника) Тогда
			ВидИсточника = "other";
		КонецЕсли;
		Материал = АИС_КорпусЗнаний.ЗарегистрироватьМатериал(Новый Структура(
			"Хеш,Наименование,Размер,MIME,Путь,ВидДокумента,Статус,Комментарий",
			Хеш,
			Заголовок,
			Файл.Размер(),
			MIMEПоРасширению(Файл.Расширение),
			ОтносительныйПуть,
			СтрокаАргумента(Аргументы, "doc_type"),
			"загружен",
			СтрокаАргумента(Аргументы, "notes")));
		Загрузка = АИС_КорпусЗнаний.ЗарегистрироватьЗагрузку(Новый Структура(
			"Хеш,ИсточникURL,Сотрудник,Должность,Задача,ВидИсточника,АвторОрган,"
			+ "ДатаПубликации,ДатаЗагрузки,Лицензия,Статус,Комментарий",
			Хеш,
			ИсточникURL,
			Логин,
			"",
			ЗадачаИд,
			ВидИсточника,
			СтрокаАргумента(Аргументы, "authority"),
			СтрокаАргумента(Аргументы, "published_at"),
			ТекущаяДатаСеанса(),
			СтрокаАргумента(Аргументы, "license"),
			"загружен",
			СтрокаАргумента(Аргументы, "notes")));
		Возврат Новый Структура(
			"hash,title,path,size,status,download",
			Хеш,
			Заголовок,
			ОтносительныйПуть,
			Файл.Размер(),
			"загружен",
			Строка(Загрузка.УникальныйИдентификатор()));
	Исключение
		Возврат ОшибкаАргументов(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция MIMEПоРасширению(Расширение)
	Расширение = НРег(СокрЛП(Расширение));
	Если Расширение = "pdf" Тогда
		Возврат "application/pdf";
	ИначеЕсли Расширение = "doc" Тогда
		Возврат "application/msword";
	ИначеЕсли Расширение = "docx" Тогда
		Возврат "application/vnd.openxmlformats-officedocument.wordprocessingml.document";
	ИначеЕсли Расширение = "xls" Тогда
		Возврат "application/vnd.ms-excel";
	ИначеЕсли Расширение = "xlsx" Тогда
		Возврат "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
	ИначеЕсли Расширение = "txt" Тогда
		Возврат "text/plain";
	КонецЕсли;
	Возврат "application/octet-stream";
КонецФункции

Функция СотрудникКонтекста(Контекст)
	Сотрудник = Неопределено;
	Если ТипЗнч(Контекст) = Тип("Структура") Тогда
		Контекст.Свойство("Сотрудник", Сотрудник);
	КонецЕсли;
	Если ЗначениеЗаполнено(Сотрудник) Тогда
		Возврат Сотрудник;
	КонецЕсли;
	Возврат ПараметрыСеанса.ТекущийПользователь;
КонецФункции

Функция Предел(Аргументы, ПоУмолчанию, Максимум)
	Значение = ЗначениеАргумента(Аргументы, "limit");
	Если ТипЗнч(Значение) = Тип("Число") И Значение > 0 Тогда
		Возврат Мин(Значение, Максимум);
	КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции

Функция ЗначениеАргумента(Аргументы, Имя)
	Значение = Неопределено;
	Если ТипЗнч(Аргументы) = Тип("Структура") Тогда
		Аргументы.Свойство(Имя, Значение);
	ИначеЕсли ТипЗнч(Аргументы) = Тип("Соответствие") Тогда
		Значение = Аргументы.Получить(Имя);
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция СтрокаАргумента(Аргументы, Имя)
	Значение = ЗначениеАргумента(Аргументы, Имя);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));
КонецФункции

Функция ОшибкаАргументов(Текст)
	Возврат Новый Структура("КодОшибки,ТекстОшибки", "invalid_arguments", Текст);
КонецФункции

Функция Настройки() Экспорт
	МаксМБ = 50;
	Хосты = Новый Массив;
	Расширения = СтрРазделить("pdf,doc,docx,xls,xlsx,txt", ",");
	Текст = Константы.АИС_НастройкиКорпусаJSON.Получить();
	Если Не ПустаяСтрока(СокрЛП(Текст)) Тогда
		Попытка
			Данные = АИС_КлиентВнешнегоСервиса.ПрочитатьJSONИзСтроки(Текст);
		Исключение
			Данные = Неопределено;
		КонецПопытки;
		Если Данные <> Неопределено Тогда
			Значение = АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Данные, "max_file_mb");
			Если ТипЗнч(Значение) = Тип("Число") И Значение > 0 Тогда
				МаксМБ = Значение;
			КонецЕсли;
			Значение = АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Данные, "allowed_hosts");
			Если ТипЗнч(Значение) = Тип("Массив") Тогда
				Хосты = Значение;
			КонецЕсли;
			Значение = АИС_КлиентВнешнегоСервиса.ЗначениеJSON(
				Данные, "allowed_extensions");
			Если ТипЗнч(Значение) = Тип("Массив") Тогда
				Расширения = Значение;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Новый Структура(
		"max_file_mb,allowed_hosts,allowed_extensions", МаксМБ, Хосты, Расширения);
КонецФункции

Функция ХостИзURL(URL) Экспорт
	Если Лев(НРег(URL), 8) <> "https://" Тогда
		Возврат "";
	КонецЕсли;
	Остаток = Сред(URL, 9);
	Позиция = СтрНайти(Остаток, "/");
	Если Позиция = 0 Тогда
		Хост = Остаток;
	Иначе
		Хост = Лев(Остаток, Позиция - 1);
	КонецЕсли;
	Двоеточие = СтрНайти(Хост, ":");
	Если Двоеточие > 0 Тогда
		Хост = Лев(Хост, Двоеточие - 1);
	КонецЕсли;
	Возврат НРег(СокрЛП(Хост));
КонецФункции

Функция ПутьИзURL(URL) Экспорт
	Остаток = Сред(URL, 9);
	Позиция = СтрНайти(Остаток, "/");
	Если Позиция = 0 Тогда
		Возврат "/";
	КонецЕсли;
	Возврат Сред(Остаток, Позиция);
КонецФункции

Функция РасширениеИзURL(URL) Экспорт
	Путь = ПутьИзURL(URL);
	Позиция = СтрНайти(Путь, "?");
	Если Позиция > 0 Тогда
		Путь = Лев(Путь, Позиция - 1);
	КонецЕсли;
	Для Индекс = СтрДлина(Путь) По 1 Шаг -1 Цикл
		Символ = Сред(Путь, Индекс, 1);
		Если Символ = "." Тогда
			Возврат НРег(Сред(Путь, Индекс + 1));
		ИначеЕсли Символ = "/" Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция РазрешённоеРасширение(Расширение, Список) Экспорт
	Расширение = НРег(СокрЛП(Расширение));
	Для Каждого Элемент Из Список Цикл
		Если НРег(СокрЛП(Строка(Элемент))) = Расширение Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция РазрешённыйХост(Хост, Список) Экспорт
	Хост = НРег(СокрЛП(Хост));
	Для Каждого Элемент Из Список Цикл
		Домен = НРег(СокрЛП(Строка(Элемент)));
		Если ПустаяСтрока(Домен) Тогда
			Продолжить;
		КонецЕсли;
		Если Хост = Домен
			ИЛИ Прав(Хост, СтрДлина(Домен) + 1) = "." + Домен Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

#КонецОбласти
