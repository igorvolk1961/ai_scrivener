#Область ПрограммныйИнтерфейс

// Ищет утверждённые распоряжения вышестоящих должностных лиц и создаёт
// по ним расписания периодических триггеров для адресатов.
Процедура ВыполнитьОбработку() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Сейчас = ТекущаяДатаСеанса();
	Начало = ДобавитьМесяц(Сейчас, -1);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("ПустойПользователь", Справочники.Пользователи.ПустаяСсылка());
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 20
		|	Документы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ВнутренниеДокументы КАК Документы
		|ГДЕ
		|	Документы.ВидДокумента.Наименование ПОДОБНО ""%Распоряжение%""
		|	И НЕ Документы.ПометкаУдаления
		|	И НЕ Документы.НеДействует
		|	И (Документы.Утвердил <> &ПустойПользователь
		|		ИЛИ Документы.Подготовил <> &ПустойПользователь)
		|	И Документы.ДатаСоздания >= &Начало
		|УПОРЯДОЧИТЬ ПО
		|	Документы.ДатаСоздания";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			ОбработатьРаспоряжение(Выборка.Ссылка);
		Исключение
			ЗаписьЖурналаРегистрации(
				"АИС.ТриггерыПоРаспоряжениям",
				УровеньЖурналаРегистрации.Ошибка,
				,
				Выборка.Ссылка,
				"Не удалось обработать распоряжение: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбработатьРаспоряжение(Ссылка)
	Документ = Ссылка.ПолучитьОбъект();
	Если Документ = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Руководитель = Документ.Утвердил;
	Если Не ЗначениеЗаполнено(Руководитель) Тогда
		Руководитель = Документ.Подготовил;
	КонецЕсли;
	Участники = УчастникиРаспоряжения(Документ);
	Если Участники.Количество() = 0 Тогда
		Зарегистрировать(Ссылка, Справочники.Пользователи.ПустаяСсылка(), Неопределено,
			"Пропущено", "Не найдены адресаты распоряжения.");
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Руководитель) Тогда
		Зарегистрировать(Ссылка, Справочники.Пользователи.ПустаяСсылка(), Неопределено,
			"Пропущено", "Не заполнен утвердивший или автор распоряжения.");
		Возврат;
	КонецЕсли;

	ЕстьНовые = Ложь;
	Для Каждого Участник Из Участники Цикл
		Если Не УжеОбработано(Ссылка, Участник) Тогда
			ЕстьНовые = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Не ЕстьНовые Тогда
		Возврат;
	КонецЕсли;

	Конфиг = ИзвлечьРасписание(Документ);
	Для Каждого Участник Из Участники Цикл
		Если УжеОбработано(Ссылка, Участник) Тогда
			Продолжить;
		КонецЕсли;
		Если Не ЯвляетсяВышестоящим(Участник, Руководитель) Тогда
			Зарегистрировать(Ссылка, Участник, Неопределено, "Пропущено",
				"Автор или утвердивший не является вышестоящим для адресата.");
			Продолжить;
		КонецЕсли;
		Если Не ПустаяСтрока(Конфиг.Ошибка) Тогда
			Зарегистрировать(Ссылка, Участник, Неопределено, "Ошибка разбора", Конфиг.Ошибка);
			Продолжить;
		КонецЕсли;
		Если Не Конфиг.Периодический Тогда
			Зарегистрировать(Ссылка, Участник, Неопределено, "Пропущено",
				"В распоряжении нет периодического поручения.");
			Продолжить;
		КонецЕсли;
		Триггер = СоздатьТриггер(Документ, Участник, Конфиг, Руководитель);
		Зарегистрировать(Ссылка, Участник, Триггер, "Создан триггер", "");
	КонецЦикла;
КонецПроцедуры

Функция ИзвлечьРасписание(Документ)
	Результат = Новый Структура(
		"Периодический,Периодичность,ВремяЗапуска,ДеньНедели,ДеньМесяца,МесяцКвартала,Cron,СрокИсполненияМинут,Описание,Ошибка",
		Ложь, Перечисления.АИС_ВидыПериодичностиТриггеров.Ежедневно, "", 5, 1, 1, "", 30, "", "");

	Текст = "Заголовок: " + Документ.Заголовок + Символы.ПС
		+ "Содержание: " + Документ.Содержание + Символы.ПС
		+ "Комментарий: " + Документ.Комментарий + Символы.ПС
		+ "Адресат: " + Строка(Документ.Адресат) + Символы.ПС
		+ "Утвердил: " + Строка(Документ.Утвердил);
	Текст = Лев(Текст, 10000);

	СистемныйПромпт =
		"Ты анализируешь распоряжение. Определи, устанавливает ли оно "
		+ "периодическое поручение для адресата. Верни строго JSON без пояснений:"
		+ Символы.ПС
		+ "{""periodic"":true,""periodicity"":""daily"",""time"":""09:30"","
		+ """weekday"":0,""day"":0,""quarter_month"":0,""cron"":"""","
		+ """duration_minutes"":30,""description"":""...""}" + Символы.ПС
		+ "periodicity: daily|weekly|monthly|quarterly|cron. "
		+ "weekday 1..7 (1 - понедельник) для weekly. "
		+ "day 1..31 для monthly/quarterly, 0 - последний день. "
		+ "quarter_month 1..3 - месяц внутри квартала. "
		+ "cron - 5 полей. Если указано «ежедневно по рабочим дням» или «по будням», "
		+ "используй periodicity=cron и cron вида «<минуты> <часы> * * 1-5». "
		+ "Если в распоряжении указано время мероприятия, "
		+ "а время подготовки не указано, поставь time за 30 минут до мероприятия. "
		+ "Если периодического поручения нет: {""periodic"":false}.";

	Попытка
		Ответ = АИС_ОбщегоНазначения.ВызватьИИ(СистемныйПромпт, Текст,
			Неопределено, 0.1, 1500);
	Исключение
		Результат.Ошибка = "LLM недоступна: " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	Ответ = СокрЛП(Ответ);
	ПозицияОбъекта = СтрНайти(Ответ, "{");
	Если ПозицияОбъекта > 1 Тогда
		Ответ = Сред(Ответ, ПозицияОбъекта);
	КонецЕсли;
	Если ПустаяСтрока(Ответ) Тогда
		Результат.Ошибка = "LLM вернула пустой ответ.";
		Возврат Результат;
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Ответ);
		Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();
	Исключение
		Результат.Ошибка = "Не удалось разобрать JSON расписания: " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	Периодический = АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Данные, "periodic");
	Если Периодический <> Истина Тогда
		Результат.Периодический = Ложь;
		Возврат Результат;
	КонецЕсли;

	Вид = НРег(СокрЛП(Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Данные, "periodicity"))));
	Периодичность = ПериодичностьПоИмени(Вид);
	Если Периодичность = Неопределено Тогда
		Результат.Ошибка = "Неизвестная периодичность: " + Вид;
		Возврат Результат;
	КонецЕсли;

	Результат.Периодический = Истина;
	Результат.Периодичность = Периодичность;
	Результат.ВремяЗапуска = СокрЛП(Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Данные, "time")));
	Результат.ДеньНедели = ЧислоИлиПоУмолчанию(Данные, "weekday", 5);
	Результат.ДеньМесяца = ЧислоИлиПоУмолчанию(Данные, "day", 1);
	Результат.МесяцКвартала = ЧислоИлиПоУмолчанию(Данные, "quarter_month", 1);
	Результат.Cron = СокрЛП(Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Данные, "cron")));
	Результат.СрокИсполненияМинут = ЧислоИлиПоУмолчанию(Данные, "duration_minutes", 30);
	Если Результат.СрокИсполненияМинут <= 0 Тогда
		Результат.СрокИсполненияМинут = 30;
	КонецЕсли;
	Результат.Описание = СокрЛП(Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Данные, "description")));
	Если ПустаяСтрока(Результат.Описание) Тогда
		Результат.Описание = ?(Не ПустаяСтрока(Документ.Содержание),
			Документ.Содержание, Документ.Заголовок);
	КонецЕсли;
	Результат.Описание = Лев(Результат.Описание, 8000);

	Если Периодичность <> Перечисления.АИС_ВидыПериодичностиТриггеров.Cron
		И ПустаяСтрока(Результат.ВремяЗапуска) Тогда
		Результат.Ошибка = "В распоряжении не указано время запуска.";
	КонецЕсли;
	Если Периодичность = Перечисления.АИС_ВидыПериодичностиТриггеров.Cron
		И ПустаяСтрока(Результат.Cron) Тогда
		Результат.Ошибка = "В распоряжении не указано cron-выражение.";
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция СоздатьТриггер(Документ, Участник, Конфиг, Руководитель)
	Объект = Справочники.АИС_РасписаниеТриггеров.СоздатьЭлемент();
	Объект.Распоряжение = Документ.Ссылка;
	Объект.ДЛ = Участник;
	Объект.Должность = АИС_РасписанияТриггеров.ДолжностьПоПользователю(Участник);
	Объект.ТипТриггера = АИС_ОбщегоНазначения.НайтиИлиСоздатьТипТриггера("Таймер");
	Объект.Периодичность = Конфиг.Периодичность;
	Объект.ВремяЗапуска = Конфиг.ВремяЗапуска;
	Объект.ДеньНедели = Конфиг.ДеньНедели;
	Объект.ДеньМесяца = Конфиг.ДеньМесяца;
	Объект.МесяцКвартала = Конфиг.МесяцКвартала;
	Объект.CronВыражение = Конфиг.Cron;
	Объект.СрокИсполненияМинут = Конфиг.СрокИсполненияМинут;
	Объект.ОписаниеТриггера = Конфиг.Описание;
	Объект.Активность = Истина;
	Объект.Автор = Руководитель;

	Попытка
		Расписание = АИС_РасписанияТриггеров.СобратьРасписание(Объект);
		Если ПустаяСтрока(Расписание.Ошибка) Тогда
			Объект.Расписание = Расписание.Расписание;
			Генерация = АИС_РасписанияТриггеров.СгенерироватьНаименованиеИПромпт(Объект);
			Объект.Наименование = Генерация.Наименование;
			Объект.ПромптРеакции = Генерация.Промпт;
		КонецЕсли;
		Объект.Записать();
	Исключение
		ЗаписьЖурналаРегистрации(
			"АИС.ТриггерыПоРаспоряжениям",
			УровеньЖурналаРегистрации.Ошибка,
			,
			Документ.Ссылка,
			"Не удалось создать триггер: " + ОписаниеОшибки());
		ВызватьИсключение;
	КонецПопытки;
	Возврат Объект.Ссылка;
КонецФункции

Процедура Зарегистрировать(Документ, Адресат, Триггер, Результат, Ошибка)
	Запись = РегистрыСведений.АИС_ОбработанныеРаспоряжения.СоздатьМенеджерЗаписи();
	Запись.Распоряжение = Документ;
	Запись.Адресат = Адресат;
	Запись.ДатаОбработки = ТекущаяДатаСеанса();
	Запись.Триггер = ?(Триггер = Неопределено,
		Справочники.АИС_РасписаниеТриггеров.ПустаяСсылка(), Триггер);
	Запись.Результат = Лев(Результат, 200);
	Запись.Ошибка = Ошибка;
	Запись.Записать();
КонецПроцедуры

Функция УжеОбработано(Документ, Адресат)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Распоряжение", Документ);
	Запрос.УстановитьПараметр("Адресат", Адресат);
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Обработанные.Распоряжение КАК Распоряжение
		|ИЗ
		|	РегистрСведений.АИС_ОбработанныеРаспоряжения КАК Обработанные
		|ГДЕ
		|	Обработанные.Распоряжение = &Распоряжение
		|	И Обработанные.Адресат = &Адресат";
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат Выборка.Следующий();
КонецФункции

Функция УчастникиРаспоряжения(Документ)
	Результат = Новый Массив;
	Если ЗначениеЗаполнено(Документ.Адресат) Тогда
		Результат.Добавить(Документ.Адресат);
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Документ", Документ.Ссылка);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Группы.Участник КАК Участник
		|ИЗ
		|	РегистрСведений.РабочиеГруппы КАК Группы
		|ГДЕ
		|	Группы.Объект = &Документ
		|	И Группы.Участник ССЫЛКА Справочник.Пользователи";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Результат.Найти(Выборка.Участник) = Неопределено Тогда
			Результат.Добавить(Выборка.Участник);
		КонецЕсли;
	КонецЦикла;

	// Получатели распоряжения также становятся исполнителями задач
	// процесса исполнения; берём их из предметов задач.
	ЗапросЗадач = Новый Запрос;
	ЗапросЗадач.УстановитьПараметр("Документ", Документ.Ссылка);
	ЗапросЗадач.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Задачи.Исполнитель КАК Участник
		|ИЗ
		|	Задача.ЗадачаИсполнителя КАК Задачи
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Задача.ЗадачаИсполнителя.Предметы КАК ПредметыЗадач
		|		ПО ПредметыЗадач.Ссылка = Задачи.Ссылка
		|ГДЕ
		|	ПредметыЗадач.Предмет = &Документ
		|	И Задачи.Исполнитель ССЫЛКА Справочник.Пользователи";
	ВыборкаЗадач = ЗапросЗадач.Выполнить().Выбрать();
	Пока ВыборкаЗадач.Следующий() Цикл
		Если Результат.Найти(ВыборкаЗадач.Участник) = Неопределено Тогда
			Результат.Добавить(ВыборкаЗадач.Участник);
		КонецЕсли;
	КонецЦикла;

	// Задачи, в тексте которых упоминается заголовок распоряжения.
	ЗапросЗадачПоТексту = Новый Запрос;
	ЗапросЗадачПоТексту.УстановитьПараметр("Маска",
		"%" + СокрЛП(Лев(Документ.Заголовок, 80)) + "%");
	ЗапросЗадачПоТексту.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Задачи.Исполнитель КАК Участник
		|ИЗ
		|	Задача.ЗадачаИсполнителя КАК Задачи
		|ГДЕ
		|	(Задачи.ПредметСтрокой ПОДОБНО &Маска
		|		ИЛИ Задачи.Наименование ПОДОБНО &Маска)
		|	И Задачи.Исполнитель ССЫЛКА Справочник.Пользователи";
	ВыборкаЗадачПоТексту = ЗапросЗадачПоТексту.Выполнить().Выбрать();
	Пока ВыборкаЗадачПоТексту.Следующий() Цикл
		Если Результат.Найти(ВыборкаЗадачПоТексту.Участник) = Неопределено Тогда
			Результат.Добавить(ВыборкаЗадачПоТексту.Участник);
		КонецЕсли;
	КонецЦикла;

	// Участники бизнес-процессов, в предметах которых есть распоряжение.
	ТипыПроцессов = Новый Массив;
	ТипыПроцессов.Добавить("Исполнение");
	ТипыПроцессов.Добавить("Поручение");
	ТипыПроцессов.Добавить("Рассмотрение");
	ТипыПроцессов.Добавить("ОбработкаВнутреннегоДокумента");
	ТипыПроцессов.Добавить("Утверждение");
	ТипыПроцессов.Добавить("Согласование");
	ТипыПроцессов.Добавить("Ознакомление");
	ТипыПроцессов.Добавить("Регистрация");
	Для Каждого ТипПроцесса Из ТипыПроцессов Цикл
		ЗапросПроцессов = Новый Запрос;
		ЗапросПроцессов.УстановитьПараметр("Документ", Документ.Ссылка);
		ЗапросПроцессов.Текст =
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ПредметыПроцесса.Ссылка КАК Процесс
			|ИЗ
			|	БизнесПроцесс." + ТипПроцесса + ".Предметы КАК ПредметыПроцесса
			|ГДЕ
			|	ПредметыПроцесса.Предмет = &Документ";
		ВыборкаПроцессов = ЗапросПроцессов.Выполнить().Выбрать();
		Пока ВыборкаПроцессов.Следующий() Цикл
			Процесс = ВыборкаПроцессов.Процесс;

			ЗапросУчастников = Новый Запрос;
			ЗапросУчастников.УстановитьПараметр("Процесс", Процесс);
			ЗапросУчастников.Текст =
				"ВЫБРАТЬ РАЗЛИЧНЫЕ
				|	Участники.Участник КАК Участник
				|ИЗ
				|	РегистрСведений.УчастникиПроцессов КАК Участники
				|ГДЕ
				|	Участники.Процесс = &Процесс
				|	И Участники.Участник ССЫЛКА Справочник.Пользователи";
			ВыборкаУчастников = ЗапросУчастников.Выполнить().Выбрать();
			Пока ВыборкаУчастников.Следующий() Цикл
				Если Результат.Найти(ВыборкаУчастников.Участник) = Неопределено Тогда
					Результат.Добавить(ВыборкаУчастников.Участник);
				КонецЕсли;
			КонецЦикла;

			ЗапросГруппПроцесса = Новый Запрос;
			ЗапросГруппПроцесса.УстановитьПараметр("Процесс", Процесс);
			ЗапросГруппПроцесса.Текст =
				"ВЫБРАТЬ РАЗЛИЧНЫЕ
				|	Группы.Участник КАК Участник
				|ИЗ
				|	РегистрСведений.РабочиеГруппы КАК Группы
				|ГДЕ
				|	Группы.Объект = &Процесс
				|	И Группы.Участник ССЫЛКА Справочник.Пользователи";
			ВыборкаГруппПроцесса = ЗапросГруппПроцесса.Выполнить().Выбрать();
			Пока ВыборкаГруппПроцесса.Следующий() Цикл
				Если Результат.Найти(ВыборкаГруппПроцесса.Участник) = Неопределено Тогда
					Результат.Добавить(ВыборкаГруппПроцесса.Участник);
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;

	Если Результат.Количество() > 0 Тогда
		ЗапросПустой = Новый Запрос;
		ЗапросПустой.УстановитьПараметр("Документ", Документ.Ссылка);
		ЗапросПустой.УстановитьПараметр("ПустойПользователь", Справочники.Пользователи.ПустаяСсылка());
		ЗапросПустой.Текст =
			"ВЫБРАТЬ
			|	Обработанные.Адресат КАК Адресат
			|ИЗ
			|	РегистрСведений.АИС_ОбработанныеРаспоряжения КАК Обработанные
			|ГДЕ
			|	Обработанные.Распоряжение = &Документ
			|	И Обработанные.Адресат = &ПустойПользователь";
		ВыборкаПустой = ЗапросПустой.Выполнить().Выбрать();
		Пока ВыборкаПустой.Следующий() Цикл
			Запись = РегистрыСведений.АИС_ОбработанныеРаспоряжения.СоздатьМенеджерЗаписи();
			Запись.Распоряжение = Документ.Ссылка;
			Запись.Адресат = Справочники.Пользователи.ПустаяСсылка();
			Запись.Удалить();
		КонецЦикла;
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ЯвляетсяВышестоящим(Подчиненный, Руководитель)
	Если Не ЗначениеЗаполнено(Подчиненный)
		ИЛИ Не ЗначениеЗаполнено(Руководитель)
		ИЛИ Подчиненный = Руководитель Тогда
		Возврат Ложь;
	КонецЕсли;

	Текущий = Подчиненный;
	Для Шаг = 1 По 10 Цикл
		Текущий = АИС_ОбщегоНазначения.НайтиРуководителя(Текущий);
		Если Не ЗначениеЗаполнено(Текущий) Тогда
			Прервать;
		КонецЕсли;
		Если Текущий = Руководитель Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	ДолжностьПодчиненного = АИС_РасписанияТриггеров.ДолжностьПоПользователю(Подчиненный);
	ДолжностьРуководителя = АИС_РасписанияТриггеров.ДолжностьПоПользователю(Руководитель);
	Если Не ЗначениеЗаполнено(ДолжностьПодчиненного)
		ИЛИ Не ЗначениеЗаполнено(ДолжностьРуководителя) Тогда
		Возврат Ложь;
	КонецЕсли;
	ТекущаяДолжность = ДолжностьПодчиненного;
	Для Шаг = 1 По 10 Цикл
		ТекущаяДолжность = АИС_ОбщегоНазначения.НайтиРуководителяДолжности(ТекущаяДолжность);
		Если Не ЗначениеЗаполнено(ТекущаяДолжность) Тогда
			Прервать;
		КонецЕсли;
		Если ТекущаяДолжность = ДолжностьРуководителя Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ПериодичностьПоИмени(Имя)
	Если Имя = "daily" ИЛИ Имя = "ежедневно" Тогда
		Возврат Перечисления.АИС_ВидыПериодичностиТриггеров.Ежедневно;
	ИначеЕсли Имя = "weekly" ИЛИ Имя = "еженедельно" Тогда
		Возврат Перечисления.АИС_ВидыПериодичностиТриггеров.Еженедельно;
	ИначеЕсли Имя = "monthly" ИЛИ Имя = "ежемесячно" Тогда
		Возврат Перечисления.АИС_ВидыПериодичностиТриггеров.Ежемесячно;
	ИначеЕсли Имя = "quarterly" ИЛИ Имя = "ежеквартально" Тогда
		Возврат Перечисления.АИС_ВидыПериодичностиТриггеров.Ежеквартально;
	ИначеЕсли Имя = "cron" Тогда
		Возврат Перечисления.АИС_ВидыПериодичностиТриггеров.Cron;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ЧислоИлиПоУмолчанию(Данные, Имя, ЗначениеПоУмолчанию)
	Значение = АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Данные, Имя);
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;
КонецФункции

#КонецОбласти
