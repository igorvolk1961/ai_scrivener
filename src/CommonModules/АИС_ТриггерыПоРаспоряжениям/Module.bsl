#Область ПрограммныйИнтерфейс

// Ищет утверждённые распоряжения вышестоящих должностных лиц и создаёт
// по ним расписания периодических триггеров для адресатов.
Процедура ВыполнитьОбработку() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Сейчас = ТекущаяДатаСеанса();
	Начало = ДобавитьМесяц(Сейчас, -1);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Начало", Начало);
	Запрос.УстановитьПараметр("ПустойПользователь", Справочники.Пользователи.ПустаяСсылка());
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 20
		|	Документы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ВнутренниеДокументы КАК Документы
		|ГДЕ
		|	Документы.ВидДокумента.Наименование ПОДОБНО ""%Распоряжение%""
		|	И НЕ Документы.ПометкаУдаления
		|	И НЕ Документы.НеДействует
		|	И Документы.Адресат <> &ПустойПользователь
		|	И Документы.Утвердил <> &ПустойПользователь
		|	И Документы.ДатаСоздания >= &Начало
		|УПОРЯДОЧИТЬ ПО
		|	Документы.ДатаСоздания";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			ОбработатьРаспоряжение(Выборка.Ссылка);
		Исключение
			ЗаписьЖурналаРегистрации(
				"АИС.ТриггерыПоРаспоряжениям",
				УровеньЖурналаРегистрации.Ошибка,
				,
				Выборка.Ссылка,
				"Не удалось обработать распоряжение: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбработатьРаспоряжение(Ссылка)
	Если УжеОбработано(Ссылка) Тогда
		Возврат;
	КонецЕсли;
	Документ = Ссылка.ПолучитьОбъект();
	Если Документ = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Документ.Адресат)
		ИЛИ Не ЗначениеЗаполнено(Документ.Утвердил) Тогда
		Зарегистрировать(Ссылка, Неопределено, "Пропущено",
			"Не заполнен адресат или утвердивший.");
		Возврат;
	КонецЕсли;
	Если Не ЯвляетсяВышестоящим(Документ.Адресат, Документ.Утвердил) Тогда
		Зарегистрировать(Ссылка, Неопределено, "Пропущено",
			"Утвердивший не является вышестоящим для адресата.");
		Возврат;
	КонецЕсли;

	Конфиг = ИзвлечьРасписание(Документ);
	Если Не ПустаяСтрока(Конфиг.Ошибка) Тогда
		Зарегистрировать(Ссылка, Неопределено, "Ошибка разбора", Конфиг.Ошибка);
		Возврат;
	КонецЕсли;
	Если Не Конфиг.Периодический Тогда
		Зарегистрировать(Ссылка, Неопределено, "Пропущено",
			"В распоряжении нет периодического поручения.");
		Возврат;
	КонецЕсли;

	Триггер = СоздатьТриггер(Документ, Конфиг);
	Зарегистрировать(Ссылка, Триггер, "Создан триггер", "");
КонецПроцедуры

Функция ИзвлечьРасписание(Документ)
	Результат = Новый Структура(
		"Периодический,Периодичность,ВремяЗапуска,ДеньНедели,ДеньМесяца,МесяцКвартала,Cron,СрокИсполненияМинут,Описание,Ошибка",
		Ложь, Перечисления.АИС_ВидыПериодичностиТриггеров.Ежедневно, "", 5, 1, 1, "", 30, "", "");

	Текст = "Заголовок: " + Документ.Заголовок + Символы.ПС
		+ "Содержание: " + Документ.Содержание + Символы.ПС
		+ "Комментарий: " + Документ.Комментарий + Символы.ПС
		+ "Адресат: " + Строка(Документ.Адресат) + Символы.ПС
		+ "Утвердил: " + Строка(Документ.Утвердил);
	Текст = Лев(Текст, 10000);

	СистемныйПромпт =
		"Ты анализируешь распоряжение. Определи, устанавливает ли оно "
		+ "периодическое поручение для адресата. Верни строго JSON без пояснений:"
		+ Символы.ПС
		+ "{""periodic"":true,""periodicity"":""daily"",""time"":""09:30"","
		+ """weekday"":0,""day"":0,""quarter_month"":0,""cron"":"""","
		+ """duration_minutes"":30,""description"":""...""}" + Символы.ПС
		+ "periodicity: daily|weekly|monthly|quarterly|cron. "
		+ "weekday 1..7 (1 - понедельник) для weekly. "
		+ "day 1..31 для monthly/quarterly, 0 - последний день. "
		+ "quarter_month 1..3 - месяц внутри квартала. "
		+ "cron - 5 полей. Если периодического поручения нет: {""periodic"":false}.";

	Попытка
		Ответ = АИС_ОбщегоНазначения.ВызватьИИ(СистемныйПромпт, Текст,
			Неопределено, 0.1, 1500);
	Исключение
		Результат.Ошибка = "LLM недоступна: " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	Ответ = СокрЛП(Ответ);
	ПозицияОбъекта = СтрНайти(Ответ, "{");
	Если ПозицияОбъекта > 1 Тогда
		Ответ = Сред(Ответ, ПозицияОбъекта);
	КонецЕсли;
	Если ПустаяСтрока(Ответ) Тогда
		Результат.Ошибка = "LLM вернула пустой ответ.";
		Возврат Результат;
	КонецЕсли;

	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Ответ);
		Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();
	Исключение
		Результат.Ошибка = "Не удалось разобрать JSON расписания: " + ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки;

	Периодический = АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Данные, "periodic");
	Если Периодический <> Истина Тогда
		Результат.Периодический = Ложь;
		Возврат Результат;
	КонецЕсли;

	Вид = НРег(СокрЛП(Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Данные, "periodicity"))));
	Периодичность = ПериодичностьПоИмени(Вид);
	Если Периодичность = Неопределено Тогда
		Результат.Ошибка = "Неизвестная периодичность: " + Вид;
		Возврат Результат;
	КонецЕсли;

	Результат.Периодический = Истина;
	Результат.Периодичность = Периодичность;
	Результат.ВремяЗапуска = СокрЛП(Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Данные, "time")));
	Результат.ДеньНедели = ЧислоИлиПоУмолчанию(Данные, "weekday", 5);
	Результат.ДеньМесяца = ЧислоИлиПоУмолчанию(Данные, "day", 1);
	Результат.МесяцКвартала = ЧислоИлиПоУмолчанию(Данные, "quarter_month", 1);
	Результат.Cron = СокрЛП(Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Данные, "cron")));
	Результат.СрокИсполненияМинут = ЧислоИлиПоУмолчанию(Данные, "duration_minutes", 30);
	Если Результат.СрокИсполненияМинут <= 0 Тогда
		Результат.СрокИсполненияМинут = 30;
	КонецЕсли;
	Результат.Описание = СокрЛП(Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Данные, "description")));
	Если ПустаяСтрока(Результат.Описание) Тогда
		Результат.Описание = ?(Не ПустаяСтрока(Документ.Содержание),
			Документ.Содержание, Документ.Заголовок);
	КонецЕсли;
	Результат.Описание = Лев(Результат.Описание, 8000);

	Если Периодичность <> Перечисления.АИС_ВидыПериодичностиТриггеров.Cron
		И ПустаяСтрока(Результат.ВремяЗапуска) Тогда
		Результат.Ошибка = "В распоряжении не указано время запуска.";
	КонецЕсли;
	Если Периодичность = Перечисления.АИС_ВидыПериодичностиТриггеров.Cron
		И ПустаяСтрока(Результат.Cron) Тогда
		Результат.Ошибка = "В распоряжении не указано cron-выражение.";
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция СоздатьТриггер(Документ, Конфиг)
	Объект = Справочники.АИС_РасписаниеТриггеров.СоздатьЭлемент();
	Объект.Распоряжение = Документ.Ссылка;
	Объект.ДЛ = Документ.Адресат;
	Объект.Должность = АИС_РасписанияТриггеров.ДолжностьПоПользователю(Документ.Адресат);
	Объект.ТипТриггера = АИС_ОбщегоНазначения.НайтиИлиСоздатьТипТриггера("Таймер");
	Объект.Периодичность = Конфиг.Периодичность;
	Объект.ВремяЗапуска = Конфиг.ВремяЗапуска;
	Объект.ДеньНедели = Конфиг.ДеньНедели;
	Объект.ДеньМесяца = Конфиг.ДеньМесяца;
	Объект.МесяцКвартала = Конфиг.МесяцКвартала;
	Объект.CronВыражение = Конфиг.Cron;
	Объект.СрокИсполненияМинут = Конфиг.СрокИсполненияМинут;
	Объект.ОписаниеТриггера = Конфиг.Описание;
	Объект.Активность = Истина;
	Объект.Автор = Документ.Утвердил;

	Попытка
		Расписание = АИС_РасписанияТриггеров.СобратьРасписание(Объект);
		Если ПустаяСтрока(Расписание.Ошибка) Тогда
			Объект.Расписание = Расписание.Расписание;
			Генерация = АИС_РасписанияТриггеров.СгенерироватьНаименованиеИПромпт(Объект);
			Объект.Наименование = Генерация.Наименование;
			Объект.ПромптРеакции = Генерация.Промпт;
		КонецЕсли;
		Объект.Записать();
	Исключение
		ЗаписьЖурналаРегистрации(
			"АИС.ТриггерыПоРаспоряжениям",
			УровеньЖурналаРегистрации.Ошибка,
			,
			Документ.Ссылка,
			"Не удалось создать триггер: " + ОписаниеОшибки());
		ВызватьИсключение;
	КонецПопытки;
	Возврат Объект.Ссылка;
КонецФункции

Процедура Зарегистрировать(Документ, Триггер, Результат, Ошибка)
	Запись = РегистрыСведений.АИС_ОбработанныеРаспоряжения.СоздатьМенеджерЗаписи();
	Запись.Распоряжение = Документ;
	Запись.ДатаОбработки = ТекущаяДатаСеанса();
	Запись.Триггер = ?(Триггер = Неопределено,
		Справочники.АИС_РасписаниеТриггеров.ПустаяСсылка(), Триггер);
	Запись.Результат = Лев(Результат, 200);
	Запись.Ошибка = Ошибка;
	Запись.Записать();
КонецПроцедуры

Функция УжеОбработано(Документ)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Распоряжение", Документ);
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Обработанные.Распоряжение КАК Распоряжение
		|ИЗ
		|	РегистрСведений.АИС_ОбработанныеРаспоряжения КАК Обработанные
		|ГДЕ
		|	Обработанные.Распоряжение = &Распоряжение";
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат Выборка.Следующий();
КонецФункции

Функция ЯвляетсяВышестоящим(Подчиненный, Руководитель)
	Если Не ЗначениеЗаполнено(Подчиненный)
		ИЛИ Не ЗначениеЗаполнено(Руководитель)
		ИЛИ Подчиненный = Руководитель Тогда
		Возврат Ложь;
	КонецЕсли;

	Текущий = Подчиненный;
	Для Шаг = 1 По 10 Цикл
		Текущий = АИС_ОбщегоНазначения.НайтиРуководителя(Текущий);
		Если Не ЗначениеЗаполнено(Текущий) Тогда
			Прервать;
		КонецЕсли;
		Если Текущий = Руководитель Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	ДолжностьПодчиненного = АИС_РасписанияТриггеров.ДолжностьПоПользователю(Подчиненный);
	ДолжностьРуководителя = АИС_РасписанияТриггеров.ДолжностьПоПользователю(Руководитель);
	Если Не ЗначениеЗаполнено(ДолжностьПодчиненного)
		ИЛИ Не ЗначениеЗаполнено(ДолжностьРуководителя) Тогда
		Возврат Ложь;
	КонецЕсли;
	ТекущаяДолжность = ДолжностьПодчиненного;
	Для Шаг = 1 По 10 Цикл
		ТекущаяДолжность = АИС_ОбщегоНазначения.НайтиРуководителяДолжности(ТекущаяДолжность);
		Если Не ЗначениеЗаполнено(ТекущаяДолжность) Тогда
			Прервать;
		КонецЕсли;
		Если ТекущаяДолжность = ДолжностьРуководителя Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ПериодичностьПоИмени(Имя)
	Если Имя = "daily" ИЛИ Имя = "ежедневно" Тогда
		Возврат Перечисления.АИС_ВидыПериодичностиТриггеров.Ежедневно;
	ИначеЕсли Имя = "weekly" ИЛИ Имя = "еженедельно" Тогда
		Возврат Перечисления.АИС_ВидыПериодичностиТриггеров.Еженедельно;
	ИначеЕсли Имя = "monthly" ИЛИ Имя = "ежемесячно" Тогда
		Возврат Перечисления.АИС_ВидыПериодичностиТриггеров.Ежемесячно;
	ИначеЕсли Имя = "quarterly" ИЛИ Имя = "ежеквартально" Тогда
		Возврат Перечисления.АИС_ВидыПериодичностиТриггеров.Ежеквартально;
	ИначеЕсли Имя = "cron" Тогда
		Возврат Перечисления.АИС_ВидыПериодичностиТриггеров.Cron;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ЧислоИлиПоУмолчанию(Данные, Имя, ЗначениеПоУмолчанию)
	Значение = АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Данные, Имя);
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ЗначениеПоУмолчанию;
КонецФункции

#КонецОбласти
