// Запрещает создание и изменение чужих правил автоодобрения.
// Администраторы и сервисный пользователь могут управлять всеми настройками.
Процедура ОграничитьЧужиеПравилаПередЗаписью(Источник, Отказ) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Если ЭтоАдминистраторАвтоодобрения() Тогда
		Возврат;
	КонецЕсли;
	Текущий = ТекущийПользовательАвтоодобрения();
	Если Не ЗначениеЗаполнено(Текущий) Тогда
		Отказ = Истина;
		СообщитьОбОшибке("Не удалось определить текущего пользователя.");
		Возврат;
	КонецЕсли;
	Пользователь = ПользовательПравила(Источник);
	Если Не ЗначениеЗаполнено(Пользователь) ИЛИ Пользователь <> Текущий Тогда
		Отказ = Истина;
		СообщитьОбОшибке("Нельзя создавать или изменять чужие правила автоодобрения.");
	КонецЕсли;
КонецПроцедуры

Функция ЭтоАдминистраторАвтоодобрения()
	Попытка
		Если РольДоступна("ПолныеПрава")
			ИЛИ РольДоступна("АдминистраторСистемы")
			ИЛИ РольДоступна("АИС_АдминистраторСистемы")
			ИЛИ РольДоступна("АИС_СервисныйПользователь") Тогда
			Возврат Истина;
		КонецЕсли;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Возврат Ложь;
КонецФункции

Функция ТекущийПользовательАвтоодобрения()
	Текущий = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если Текущий = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Справочники.Пользователи.НайтиПоНаименованию(Строка(Текущий.Имя), Истина);
КонецФункции

Функция ПользовательПравила(Источник)
	Тип = ТипЗнч(Источник);
	Если Тип = Тип("CatalogObject.АИС_НастройкиАвтоодобрения") Тогда
		Возврат Источник.Пользователь;
	ИначеЕсли Тип = Тип("CatalogObject.АИС_ПравилаАвтоодобренияПоТипам") Тогда
		Если ЗначениеЗаполнено(Источник.Владелец) Тогда
			Возврат Источник.Владелец.Пользователь;
		КонецЕсли;
	ИначеЕсли Тип = Тип("CatalogObject.АИС_РазрешенныеАвторыАвтоодобрения")
		ИЛИ Тип = Тип("CatalogObject.АИС_РазрешенныеКонтрагентыАвтоодобрения") Тогда
		Если ЗначениеЗаполнено(Источник.Владелец)
			И ЗначениеЗаполнено(Источник.Владелец.Владелец) Тогда
			Возврат Источник.Владелец.Владелец.Пользователь;
		КонецЕсли;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Процедура СообщитьОбОшибке(Текст)
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();
КонецПроцедуры

#Область АвтоодобрениеАгента

Функция МожноАвтоодобрить(Пользователь, ДокументыJSON) Экспорт
	Попытка
		Документы = АИС_КлиентВнешнегоСервиса.ПрочитатьJSONИзСтроки(ДокументыJSON);
	Исключение
		Возврат Новый Структура("Можно,Причина", Ложь, "invalid_documents");
	КонецПопытки;
	Если ТипЗнч(Документы) <> Тип("Массив") ИЛИ Документы.Количество() = 0 Тогда
		Возврат Новый Структура("Можно,Причина", Ложь, "no_documents");
	КонецЕсли;

	Настройки = НастройкиПользователя(Пользователь);
	Если Не ЗначениеЗаполнено(Настройки) ИЛИ Не Настройки.Включено Тогда
		Возврат Новый Структура("Можно,Причина", Ложь, "disabled");
	КонецЕсли;
	РежимПоУмолчанию = НРег(СокрЛП(Настройки.РежимПоУмолчанию));

	Для Каждого Документ Из Документы Цикл
		ВидДокумента = Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Документ, "document_type"));
		Если ПустаяСтрока(ВидДокумента) Тогда
			Возврат Новый Структура("Можно,Причина", Ложь, "unknown_document_type");
		КонецЕсли;
		ВидДокументаСсылка = СсылкаВидаДокумента(ВидДокумента);
		Если Не ЗначениеЗаполнено(ВидДокументаСсылка) Тогда
			Возврат Новый Структура("Можно,Причина", Ложь, "unknown_document_type");
		КонецЕсли;
		Правило = ПравилоПоТипу(Настройки, ВидДокументаСсылка);
		Режим = РежимПоУмолчанию;
		Если ЗначениеЗаполнено(Правило) Тогда
			Режим = НРег(СокрЛП(Правило.Режим));
		КонецЕсли;
		Если Режим = "on" Тогда
			Продолжить;
		КонецЕсли;
		Если Режим <> "depends_on_author" Тогда
			Возврат Новый Структура("Можно,Причина", Ложь, "mode_" + Режим);
		КонецЕсли;
		Если Не ЗависитОтАвтораИлиКонтрагента(Правило, Документ) Тогда
			Возврат Новый Структура("Можно,Причина", Ложь, "author_not_allowed");
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("Можно,Причина", Истина, "auto");
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыАвтоодобренияАгента

Функция СсылкаВидаДокумента(ВидДокумента)
	Попытка
		Возврат Справочники.ВидыВнутреннихДокументов.ПолучитьСсылку(Новый УникальныйИдентификатор(ВидДокумента));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция НастройкиПользователя(Пользователь)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Настройки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.АИС_НастройкиАвтоодобрения КАК Настройки
		|ГДЕ
		|	Настройки.Пользователь = &Пользователь
		|	И НЕ Настройки.ПометкаУдаления";
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ПравилоПоТипу(Настройки, ВидДокумента)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Правила.Ссылка КАК Ссылка,
		|	Правила.Режим КАК Режим
		|ИЗ
		|	Справочник.АИС_ПравилаАвтоодобренияПоТипам КАК Правила
		|ГДЕ
		|	Правила.Владелец = &Настройки
		|	И Правила.ВидДокумента = &ВидДокумента
		|	И Правила.Активность
		|	И НЕ Правила.ПометкаУдаления";
	Запрос.УстановитьПараметр("Настройки", Настройки);
	Запрос.УстановитьПараметр("ВидДокумента", ВидДокумента);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ЗависитОтАвтораИлиКонтрагента(Правило, Документ)
	Автор = Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Документ, "author"));
	Контрагент = Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Документ, "counterparty"));
	Если ЗначениеЗаполнено(Правило) Тогда
		Если Не ПустаяСтрока(Автор) И АвторРазрешен(Правило.Ссылка, Автор) Тогда
			Возврат Истина;
		КонецЕсли;
		Если Не ПустаяСтрока(Контрагент) И КонтрагентРазрешен(Правило.Ссылка, Контрагент) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

Функция АвторРазрешен(Правило, Автор)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Авторы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.АИС_РазрешенныеАвторыАвтоодобрения КАК Авторы
		|ГДЕ
		|	Авторы.Владелец = &Правило
		|	И Авторы.Активность
		|	И Авторы.Пользователь.Наименование = &Автор";
	Запрос.УстановитьПараметр("Правило", Правило);
	Запрос.УстановитьПараметр("Автор", Автор);
	Возврат Запрос.Выполнить().Выбрать().Следующий();
КонецФункции

Функция КонтрагентРазрешен(Правило, Контрагент)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.АИС_РазрешенныеКонтрагентыАвтоодобрения КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Владелец = &Правило
		|	И Контрагенты.Активность
		|	И Контрагенты.Контрагент = &Контрагент";
	Запрос.УстановитьПараметр("Правило", Правило);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Возврат Запрос.Выполнить().Выбрать().Следующий();
КонецФункции

#КонецОбласти
