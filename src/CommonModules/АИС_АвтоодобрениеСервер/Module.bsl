// Запрещает создание и изменение чужих правил автоодобрения.
// Администраторы и сервисный пользователь могут управлять всеми настройками.
Процедура ОграничитьЧужиеПравилаПередЗаписью(Источник, Отказ) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Если ЭтоАдминистраторАвтоодобрения() Тогда
		Возврат;
	КонецЕсли;
	Текущий = ТекущийПользовательАвтоодобрения();
	Если Не ЗначениеЗаполнено(Текущий) Тогда
		Отказ = Истина;
		СообщитьОбОшибке("Не удалось определить текущего пользователя.");
		Возврат;
	КонецЕсли;
	Пользователь = ПользовательПравила(Источник);
	Если Не ЗначениеЗаполнено(Пользователь) ИЛИ Пользователь <> Текущий Тогда
		Отказ = Истина;
		СообщитьОбОшибке("Нельзя создавать или изменять чужие правила автоодобрения.");
	КонецЕсли;
КонецПроцедуры

Функция ЭтоАдминистраторАвтоодобрения()
	Попытка
		Если РольДоступна("ПолныеПрава")
			ИЛИ РольДоступна("АдминистраторСистемы")
			ИЛИ РольДоступна("АИС_АдминистраторСистемы")
			ИЛИ РольДоступна("АИС_СервисныйПользователь") Тогда
			Возврат Истина;
		КонецЕсли;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Возврат Ложь;
КонецФункции

Функция ТекущийПользовательАвтоодобрения()
	Текущий = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если Текущий = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Справочники.Пользователи.НайтиПоНаименованию(Строка(Текущий.Имя), Истина);
КонецФункции

Функция ПользовательПравила(Источник)
	Тип = ТипЗнч(Источник);
	Если Тип = Тип("CatalogObject.АИС_НастройкиАвтоодобрения") Тогда
		Возврат Источник.Пользователь;
	ИначеЕсли Тип = Тип("CatalogObject.АИС_ПравилаАвтоодобренияПоТипам") Тогда
		Если ЗначениеЗаполнено(Источник.Владелец) Тогда
			Возврат Источник.Владелец.Пользователь;
		КонецЕсли;
	ИначеЕсли Тип = Тип("CatalogObject.АИС_РазрешенныеАвторыАвтоодобрения")
		ИЛИ Тип = Тип("CatalogObject.АИС_РазрешенныеКонтрагентыАвтоодобрения") Тогда
		Если ЗначениеЗаполнено(Источник.Владелец)
			И ЗначениеЗаполнено(Источник.Владелец.Владелец) Тогда
			Возврат Источник.Владелец.Владелец.Пользователь;
		КонецЕсли;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Процедура СообщитьОбОшибке(Текст)
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Сообщить();
КонецПроцедуры
