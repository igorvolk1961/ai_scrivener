#Область ПрограммныйИнтерфейс

Функция СохранитьВнешнийОбразец(Аргументы) Экспорт
	Попытка
		URL = СтрокаАргумента(Аргументы, "url");
		Заголовок = СтрокаАргумента(Аргументы, "title");
		Текст = СтрокаАргумента(Аргументы, "text");
		ИмяВида = СтрокаАргумента(Аргументы, "document_kind");
		Модель = СтрокаАргумента(Аргументы, "model");
		Если ПустаяСтрока(Текст) Тогда
			Возврат ОшибкаАргументов("Нужен текст образца.");
		КонецЕсли;
		Хеш = ХешТекста(Текст);
		ВидДокумента = Справочники.ВидыВнутреннихДокументов.ПустаяСсылка();
		Если Не ПустаяСтрока(ИмяВида) Тогда
			НайденныйВид = Справочники.ВидыВнутреннихДокументов.НайтиПоНаименованию(
				ИмяВида, Истина);
			Если ЗначениеЗаполнено(НайденныйВид) Тогда
				ВидДокумента = НайденныйВид;
			КонецЕсли;
		КонецЕсли;
		Образец = Неопределено;
		Если Не ПустаяСтрока(URL) Тогда
			Запрос = Новый Запрос;
			Запрос.Текст =
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	Образцы.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.АИС_ОбразцыДокументов КАК Образцы
				|ГДЕ
				|	Образцы.ИсточникURL = &URL
				|	И (&Хеш = """" ИЛИ Образцы.ХешСодержимого = &Хеш)";
			Запрос.УстановитьПараметр("URL", URL);
			Запрос.УстановитьПараметр("Хеш", Хеш);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Образец = Выборка.Ссылка.ПолучитьОбъект();
			КонецЕсли;
		КонецЕсли;
		Если Образец = Неопределено Тогда
			Образец = Справочники.АИС_ОбразцыДокументов.СоздатьЭлемент();
		КонецЕсли;
		Образец.Наименование = ?(ПустаяСтрока(Заголовок), "Образец из интернета", Заголовок);
		Образец.ВидДокумента = ВидДокумента;
		Образец.Содержание = Текст;
		Образец.Комментарий = "Загружен из интернета";
		Образец.Версия = 1;
		Образец.Активность = Истина;
		Образец.ИсточникURL = URL;
		Образец.ДатаПолучения = ТекущаяДатаСеанса();
		Образец.ТипИсточника = "Интернет";
		Образец.ХешСодержимого = Хеш;
		Образец.СтатусПодтверждения = "unconfirmed";
		Образец.МодельГенерации = Модель;
		Образец.Записать();

		ЗапросСтарых = Новый Запрос;
		ЗапросСтарых.Текст =
			"ВЫБРАТЬ
			|	Вопросы.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.АИС_ВопросыПриСозданииДокументаПоОбразцу КАК Вопросы
			|ГДЕ
			|	Вопросы.Владелец = &Владелец";
		ЗапросСтарых.УстановитьПараметр("Владелец", Образец.Ссылка);
		ВыборкаСтарых = ЗапросСтарых.Выполнить().Выбрать();
		Пока ВыборкаСтарых.Следующий() Цикл
			Старый = ВыборкаСтарых.Ссылка.ПолучитьОбъект();
			Если Старый <> Неопределено Тогда
				Старый.Удалить();
			КонецЕсли;
		КонецЦикла;

		Вопросы = ЗначениеАргумента(Аргументы, "questions");
		Если ТипЗнч(Вопросы) <> Тип("Массив") Тогда
			Вопросы = Новый Массив;
		КонецЕсли;
		Номер = 0;
		Для Каждого Вопрос Из Вопросы Цикл
			Если ТипЗнч(Вопрос) <> Тип("Структура") Тогда
				Продолжить;
			КонецЕсли;
			Номер = Номер + 1;
			НовыйВопрос = Справочники.АИС_ВопросыПриСозданииДокументаПоОбразцу.СоздатьЭлемент();
			НовыйВопрос.Владелец = Образец.Ссылка;
			НовыйВопрос.Наименование = "Вопрос " + Формат(Номер, "ЧГ=0");
			НовыйВопрос.ТекстВопроса = СтрокаАргумента(Вопрос, "text");
			НовыйВопрос.Порядок = Номер;
			НовыйВопрос.КодВопроса = СтрокаАргумента(Вопрос, "code");
			ТипОтвета = СтрокаАргумента(Вопрос, "type");
			Если ПустаяСтрока(ТипОтвета) Тогда
				ТипОтвета = "single";
			КонецЕсли;
			НовыйВопрос.ТипОтвета = ТипОтвета;
			НовыйВопрос.Обязательный = ?(ЗначениеАргумента(Вопрос, "required") = Ложь, Ложь, Истина);
			НовыйВопрос.Подсказка = СтрокаАргумента(Вопрос, "hint");
			НовыйВопрос.Плейсхолдер = СтрокаАргумента(Вопрос, "placeholder");
			НовыйВопрос.ОтветПоУмолчанию = СтрокаАргумента(Вопрос, "default");
			НовыйВопрос.РазрешитьСвободныйВвод = Истина;
			НовыйВопрос.Активность = Истина;
			НовыйВопрос.Записать();
		КонецЦикла;

		Возврат Новый Структура(
			"example_id,status,confirm_status,questions",
			Строка(Образец.Ссылка.УникальныйИдентификатор()),
			"ok",
			Образец.СтатусПодтверждения,
			Вопросы.Количество());
	Исключение
		Возврат ОшибкаАргументов(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ХешТекста(Текст)
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Текст);
	Возврат НРег(СтрЗаменить(Хеширование.ХешСумма, " ", ""));
КонецФункции

Функция ЗначениеАргумента(Аргументы, Имя)
	Значение = Неопределено;
	Если ТипЗнч(Аргументы) = Тип("Структура") Тогда
		Аргументы.Свойство(Имя, Значение);
	ИначеЕсли ТипЗнч(Аргументы) = Тип("Соответствие") Тогда
		Значение = Аргументы.Получить(Имя);
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция СтрокаАргумента(Аргументы, Имя)
	Значение = ЗначениеАргумента(Аргументы, Имя);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));
КонецФункции

Функция ОшибкаАргументов(Текст)
	Возврат Новый Структура("КодОшибки,ТекстОшибки", "invalid_arguments", Текст);
КонецФункции

#КонецОбласти
