#Область ПрограммныйИнтерфейс

Функция ЧекЛист(Аргументы) Экспорт
	Назначение = СтрокаАргумента(Аргументы, "purpose");
	Если ПустаяСтрока(Назначение) Тогда
		Назначение = "РазработкаДолжностнойИнструкции";
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЧекЛисты.Ссылка КАК Ссылка,
		|	ЧекЛисты.Наименование КАК Наименование,
		|	ЧекЛисты.Назначение КАК Назначение,
		|	ЧекЛисты.Версия КАК Версия,
		|	ЧекЛисты.Содержание КАК Содержание
		|ИЗ
		|	Справочник.АИС_ЧекЛисты КАК ЧекЛисты
		|ГДЕ
		|	ЧекЛисты.Активность
		|	И ЧекЛисты.Назначение = &Назначение
		|УПОРЯДОЧИТЬ ПО
		|	ЧекЛисты.Наименование";
	Запрос.УстановитьПараметр("Назначение", Назначение);
	Выборка = Запрос.Выполнить().Выбрать();
	ЧекЛисты = Новый Массив;
	Пока Выборка.Следующий() Цикл
		ЗапросПунктов = Новый Запрос;
		ЗапросПунктов.Текст =
			"ВЫБРАТЬ
			|	Пункты.Порядок КАК Порядок,
			|	Пункты.Раздел КАК Раздел,
			|	Пункты.Текст КАК Текст,
			|	Пункты.Обязательный КАК Обязательный
			|ИЗ
			|	Справочник.АИС_ПунктыЧекЛиста КАК Пункты
			|ГДЕ
			|	Пункты.Владелец = &Владелец
			|	И Пункты.Активность
			|	И НЕ Пункты.ПометкаУдаления
			|УПОРЯДОЧИТЬ ПО
			|	Пункты.Порядок";
		ЗапросПунктов.УстановитьПараметр("Владелец", Выборка.Ссылка);
		ВыборкаПунктов = ЗапросПунктов.Выполнить().Выбрать();
		Пункты = Новый Массив;
		Пока ВыборкаПунктов.Следующий() Цикл
			Пункты.Добавить(Новый Структура(
				"order,section,text,required",
				ВыборкаПунктов.Порядок,
				Строка(ВыборкаПунктов.Раздел),
				Строка(ВыборкаПунктов.Текст),
				ВыборкаПунктов.Обязательный));
		КонецЦикла;
		ЧекЛисты.Добавить(Новый Структура(
			"id,name,purpose,version,content,items",
			Строка(Выборка.Ссылка.УникальныйИдентификатор()),
			Строка(Выборка.Наименование),
			Строка(Выборка.Назначение),
			Строка(Выборка.Версия),
			Строка(Выборка.Содержание),
			Пункты));
	КонецЦикла;
	Возврат Новый Структура("ЧекЛисты", ЧекЛисты);
КонецФункции

Функция ДолжностнаяИнструкция(Аргументы) Экспорт
	ДолжностьИмя = СтрокаАргумента(Аргументы, "position");
	Если ПустаяСтрока(ДолжностьИмя) Тогда
		Возврат Новый Структура("Найдено,Должность,Заголовок,Текст", Ложь, "", "", "");
	КонецЕсли;
	Должность = Справочники.Должности.НайтиПоНаименованию(ДолжностьИмя, Истина);
	Если Не ЗначениеЗаполнено(Должность) Тогда
		Возврат Новый Структура("Найдено,Должность,Заголовок,Текст", Ложь, ДолжностьИмя, "", "");
	КонецЕсли;
	Инструкция = АИС_ОбщегоНазначения.НайтиДолжностнуюИнструкцию(Должность);
	Если Не ЗначениеЗаполнено(Инструкция) Тогда
		Возврат Новый Структура("Найдено,Должность,Заголовок,Текст", Ложь, ДолжностьИмя, "", "");
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Документы.Заголовок КАК Заголовок,
		|	Документы.Содержание КАК Содержание
		|ИЗ
		|	Справочник.ВнутренниеДокументы КАК Документы
		|ГДЕ
		|	Документы.Ссылка = &Документ";
	Запрос.УстановитьПараметр("Документ", Инструкция);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Новый Структура("Найдено,Должность,Заголовок,Текст", Ложь, ДолжностьИмя, "", "");
	КонецЕсли;
	Возврат Новый Структура(
		"Найдено,Должность,Заголовок,Текст",
		Истина,
		ДолжностьИмя,
		Строка(Выборка.Заголовок),
		Лев(Строка(Выборка.Содержание), 20000));
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗначениеАргумента(Аргументы, Имя)
	Значение = Неопределено;
	Если ТипЗнч(Аргументы) = Тип("Структура") Тогда
		Аргументы.Свойство(Имя, Значение);
	ИначеЕсли ТипЗнч(Аргументы) = Тип("Соответствие") Тогда
		Значение = Аргументы.Получить(Имя);
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция СтрокаАргумента(Аргументы, Имя)
	Значение = ЗначениеАргумента(Аргументы, Имя);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));
КонецФункции

#КонецОбласти
