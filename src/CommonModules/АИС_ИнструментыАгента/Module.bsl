#Область ПрограммныйИнтерфейс

Функция ВыполнитьИнструмент(Имя, Аргументы, Контекст) Экспорт
	Если Не ИнструментРазрешен(Имя, Контекст) Тогда
		Возврат Ошибка("tool_not_allowed", "Инструмент не разрешен: " + Имя);
	КонецЕсли;
	Если ИнструментИзменяетДанные(Имя) И Не АИС_АгентИИ.ПроверитьОдобрение(Контекст.Запуск) Тогда
		Возврат Ошибка("approval_required", "Перед изменяющим действием вызови request_action_approval");
	КонецЕсли;

	Если Имя = "complete_task" Тогда
		АИС_АгентИИ.ЗавершитьЗадачу(Контекст.Задача, Строка(ЗначениеАргумента(Аргументы, "result")));
		Возврат Успех(Новый Структура("completed", Истина));
	ИначеЕсли Имя = "search_example" Тогда
		Возврат ВыполнитьПоискRAG(Аргументы, "examples");
	ИначеЕсли Имя = "search_knowledge_base" Тогда
		Возврат ВыполнитьПоискRAG(Аргументы, "knowledge");
	ИначеЕсли Имя = "search_internet" Тогда
		Возврат ВыполнитьПоискИнтернет(Аргументы);
	ИначеЕсли Имя = "request_action_approval" Тогда
		Если АвтоОдобрениеРазрешено(Аргументы, Контекст) Тогда
			АИС_АгентИИ.УстановитьОдобрение(Контекст.Запуск, Истина);
			Возврат Успех(Новый Структура("decision,answer_text", "approved", ""));
		КонецЕсли;
		Возврат СоздатьЗапросПользователю(Аргументы, Контекст, Перечисления.АИС_ВидыВзаимодействийИИ.ОдобрениеДействий, "Требуется одобрение");
	ИначеЕсли Имя = "ask_clarifying_question" Тогда
		Возврат СоздатьЗапросПользователю(Аргументы, Контекст, Перечисления.АИС_ВидыВзаимодействийИИ.Уточнение, "Уточнение");
	ИначеЕсли Имя = "ask_example_changes" Тогда
		Возврат СоздатьЗапросПользователю(Аргументы, Контекст, Перечисления.АИС_ВидыВзаимодействийИИ.ВопросыОбразца, "Вопросы по образцу");
	ИначеЕсли Имя = "ask_decision" Тогда
		Возврат СоздатьЗапросПользователю(Аргументы, Контекст, Перечисления.АИС_ВидыВзаимодействийИИ.ВопросРешение, "Требуется решение");
	ИначеЕсли Имя = "submit_draft_for_review" Тогда
		Возврат СоздатьЗапросПользователю(Аргументы, Контекст, Перечисления.АИС_ВидыВзаимодействийИИ.СогласованиеЧерновика, "Согласование черновика");
	КонецЕсли;

	Возврат Ошибка("tool_not_implemented", "Инструмент еще не перенесен: " + Имя);
КонецФункции

Функция БазовыеИнструменты() Экспорт
	Инструменты = Новый Массив;
	Инструменты.Добавить("request_action_approval");
	Инструменты.Добавить("ask_clarifying_question");
	Инструменты.Добавить("ask_example_changes");
	Инструменты.Добавить("ask_decision");
	Инструменты.Добавить("complete_task");
	Возврат Инструменты;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИнструментРазрешен(Имя, Контекст)
	Если БазовыеИнструменты().Найти(Имя) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Разрешенные = Контекст.РазрешенныеИнструменты;
	Возврат ТипЗнч(Разрешенные) = Тип("Массив") И Разрешенные.Найти(Имя) <> Неопределено;
КонецФункции

Функция ВыполнитьПоискRAG(Аргументы, Scope)
	Запрос = СокрЛП(Строка(ЗначениеАргумента(Аргументы, "query")));
	Если ПустаяСтрока(Запрос) Тогда
		Возврат Ошибка("invalid_arguments", "Не указан поисковый запрос");
	КонецЕсли;
	Результат = АИС_ИнтеграцияСRAG.Поиск(Запрос, , , , Scope);
	Возврат Успех(Результат);
КонецФункции

Функция ВыполнитьПоискИнтернет(Аргументы)
	Запрос = СокрЛП(Строка(ЗначениеАргумента(Аргументы, "query")));
	Если ПустаяСтрока(Запрос) Тогда
		Возврат Ошибка("invalid_arguments", "Не указан поисковый запрос");
	КонецЕсли;
	Результат = АИС_ИнтеграцияСПоиском.Поиск(Запрос);
	Возврат Успех(Результат);
КонецФункции

Функция СоздатьЗапросПользователю(Аргументы, Контекст, Вид, ЗаголовокПоУмолчанию)
	Заголовок = СокрЛП(Строка(ЗначениеАргумента(Аргументы, "title")));
	Если ПустаяСтрока(Заголовок) Тогда
		Заголовок = ЗаголовокПоУмолчанию;
	КонецЕсли;
	Текст = Строка(ЗначениеАргумента(Аргументы, "question"));
	Если ПустаяСтрока(Текст) Тогда
		Текст = Строка(ЗначениеАргумента(Аргументы, "text"));
	КонецЕсли;
	Payload = Новый Структура("arguments,tool,call_id", Аргументы, Контекст.Инструмент, Контекст.CallID);
	PayloadJSON = АИС_КлиентВнешнегоСервиса.ЗаписатьJSON(Payload);
	Взаимодействие = АИС_АгентИИ.СоздатьВзаимодействие(
		Вид,
		Контекст.Запуск,
		Контекст.Задача,
		Контекст.Сотрудник,
		Заголовок,
		Текст,
		PayloadJSON);
	Результат = Успех(Новый Структура("interaction_id", Строка(Взаимодействие.УникальныйИдентификатор())));
	Результат.Остановить = Истина;
	Возврат Результат;
КонецФункции

Функция ЗначениеАргумента(Аргументы, Имя)
	Если ТипЗнч(Аргументы) = Тип("Структура") Тогда
		Значение = Неопределено;
		Аргументы.Свойство(Имя, Значение);
		Возврат Значение;
	ИначеЕсли ТипЗнч(Аргументы) = Тип("Соответствие") Тогда
		Возврат Аргументы.Получить(Имя);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция Успех(Данные)
	Возврат Новый Структура("ОК,Данные,Ошибка,Взаимодействие,Остановить", Истина, Данные, Неопределено, Неопределено, Ложь);
КонецФункции

Функция Ошибка(Код, Текст)
	Возврат Новый Структура(
		"ОК,Данные,Ошибка,Взаимодействие,Остановить",
		Ложь,
		Неопределено,
		Новый Структура("Код,Текст", Код, Текст),
		Неопределено,
		Ложь);
КонецФункции

Функция ИнструментИзменяетДанные(Имя)
	Изменяющие = СтрРазделить("create_draft,create_information_request,create_document,approve_document,cancel_document,hire_employee,accounting_decision,create_department,manage_document_sections,manage_remarks,return_document,route_remarks,kb_download,kb_register_material", ",");
	Возврат Изменяющие.Найти(Имя) <> Неопределено;
КонецФункции

Функция АвтоОдобрениеРазрешено(Аргументы, Контекст)
	Документы = ЗначениеАргумента(Аргументы, "documents");
	Если ТипЗнч(Документы) <> Тип("Массив") ИЛИ Документы.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Результат = АИС_АвтоодобрениеСервер.МожноАвтоодобрить(Контекст.Сотрудник, АИС_КлиентВнешнегоСервиса.ЗаписатьJSON(Документы));
		Возврат Результат.Можно;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции


#КонецОбласти
