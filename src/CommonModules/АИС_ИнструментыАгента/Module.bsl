#Область ПрограммныйИнтерфейс

Функция ВыполнитьИнструмент(Имя, Аргументы, Контекст) Экспорт
	ПараметрыИстории = Новый Структура(
		"Ключ,Запуск,Задача,Шаг,Инструмент,Группа,Аргументы,Статус,Результат,Ошибка,Длительность",
		"",
		Контекст.Запуск,
		Контекст.Задача,
		Контекст.Шаг,
		Имя,
		ГруппаИнструмента(Имя),
		Аргументы,
		"",
		Неопределено,
		"",
		0);
	ПараметрыИстории.Ключ = АИС_АгентИИ.КлючИнструмента(
		Контекст.Запуск, Контекст.Шаг, Имя, Аргументы);

	Если Не ИнструментРазрешен(Имя, Контекст) Тогда
		ЗафиксироватьОтказ(ПараметрыИстории, "tool_not_allowed", "Инструмент не разрешен: " + Имя);
		Возврат Ошибка("tool_not_allowed", "Инструмент не разрешен: " + Имя);
	КонецЕсли;
	Если ИнструментИзменяетДанные(Имя)
		И Не АИС_АгентИИ.ПроверитьОдобрение(Контекст.Запуск, Имя, Аргументы) Тогда
		ЗафиксироватьОтказ(
			ПараметрыИстории,
			"approval_required",
			"Перед изменяющим действием вызови request_action_approval");
		Возврат Ошибка("approval_required", "Перед изменяющим действием вызови request_action_approval");
	КонецЕсли;

	НачалоЗамера = ТекущаяДатаСеанса();
	Если ИнструментИзменяетДанные(Имя) Тогда
		Начало = АИС_АгентИИ.ЗарегистрироватьНачалоИнструмента(ПараметрыИстории);
		Если Начало.Статус = "выполнен" Тогда
			Восстановленный = АИС_АгентИИ.РезультатИзJSON(Начало.Результат);
			Если Восстановленный <> Неопределено Тогда
				Возврат Восстановленный;
			КонецЕсли;
			Возврат Ошибка("idempotency_state_error", "Не удалось восстановить результат предыдущего вызова");
		ИначеЕсли Начало.Статус = "в_процессе" Тогда
			Возврат Ошибка(
				"idempotency_in_progress",
				"Предыдущая попытка изменения не завершена; проверьте данные вручную");
		КонецЕсли;
	КонецЕсли;

	Результат = Неопределено;
	Если Имя = "complete_task" Тогда
		АИС_АгентИИ.ЗавершитьЗадачу(Контекст.Задача, Строка(ЗначениеАргумента(Аргументы, "result")));
		Результат = Успех(Новый Структура("completed", Истина));
	ИначеЕсли Имя = "search_example" Тогда
		Результат = ВыполнитьПоискRAG(Аргументы, "examples");
	ИначеЕсли Имя = "search_knowledge_base" Тогда
		Результат = ВыполнитьПоискRAG(Аргументы, "knowledge");
	ИначеЕсли Имя = "search_internet" Тогда
		Результат = ВыполнитьПоискИнтернет(Аргументы);
	ИначеЕсли Имя = "get_checklist" Тогда
		Результат = Успех(АИС_АгентЗнания.ЧекЛист(Аргументы));
	ИначеЕсли Имя = "get_job_description" Тогда
		Результат = Успех(АИС_АгентЗнания.ДолжностнаяИнструкция(Аргументы));
	ИначеЕсли Имя = "list_employees" Тогда
		Результат = Успех(АИС_АгентКадры.СписокСотрудников(Аргументы));
	ИначеЕсли Имя = "list_departments" Тогда
		Результат = Успех(АИС_АгентКадры.СписокПодразделений(Аргументы));
	ИначеЕсли Имя = "hire_employee" Тогда
		Результат = РезультатКадров(АИС_АгентКадры.ПринятьСотрудника(Аргументы));
	ИначеЕсли Имя = "create_department" Тогда
		Результат = РезультатКадров(АИС_АгентКадры.СоздатьПодразделение(Аргументы));
	ИначеЕсли Имя = "accounting_decision" Тогда
		Результат = РезультатКадров(АИС_АгентКадры.РешениеБухгалтера(Аргументы));
	ИначеЕсли Имя = "propose_system_prompt" Тогда
		Результат = РезультатКадров(АИС_АгентКадры.ПредложитьПромпт(Аргументы));
	ИначеЕсли Имя = "manage_document_sections" Тогда
		Результат = РезультатКадров(АИС_АгентРазделы.Выполнить(Аргументы, Контекст));
	ИначеЕсли Имя = "manage_remarks" Тогда
		Результат = РезультатКадров(АИС_АгентЗамечания.Выполнить(Аргументы, Контекст));
	ИначеЕсли Имя = "return_document" Тогда
		Результат = РезультатКадров(АИС_АгентЗамечания.ВернутьДокумент(Аргументы, Контекст));
	ИначеЕсли Имя = "route_remarks" Тогда
		Результат = РезультатКадров(АИС_АгентЗамечания.НаправитьЗамечания(Аргументы, Контекст));
	ИначеЕсли Имя = "kb_list_materials" Тогда
		Результат = РезультатКадров(АИС_АгентКорпус.СписокМатериалов(Аргументы, Контекст));
	ИначеЕсли Имя = "kb_register_material" Тогда
		Результат = РезультатКадров(АИС_АгентКорпус.ЗарегистрироватьМатериал(Аргументы, Контекст));
	ИначеЕсли Имя = "list_documents" Тогда
		Результат = СписокДокументов(Аргументы, Контекст);
	ИначеЕсли Имя = "read_document" Тогда
		Результат = ПрочитатьДокумент(Аргументы, Контекст);
	ИначеЕсли Имя = "check_document_access" Тогда
		Результат = ПроверитьДоступКДокументу(Аргументы, Контекст);
	ИначеЕсли Имя = "approve_document" Тогда
		Результат = УтвердитьДокумент(Аргументы, Контекст);
	ИначеЕсли Имя = "cancel_document" Тогда
		Результат = ОтменитьДокумент(Аргументы, Контекст);
	ИначеЕсли Имя = "create_draft" Тогда
		Результат = СоздатьЧерновикАгента(Аргументы, Контекст, "document");
	ИначеЕсли Имя = "create_information_request" Тогда
		Результат = СоздатьЧерновикАгента(Аргументы, Контекст, "information_request");
	ИначеЕсли Имя = "create_document" Тогда
		Результат = СоздатьДокументАгента(Аргументы, Контекст);
	ИначеЕсли Имя = "request_action_approval" Тогда
		Результат = ЗапроситьОдобрение(Аргументы, Контекст);
	ИначеЕсли Имя = "ask_clarifying_question" Тогда
		Результат = СоздатьЗапросПользователю(Аргументы, Контекст, Перечисления.АИС_ВидыВзаимодействийИИ.Уточнение, "Уточнение");
	ИначеЕсли Имя = "ask_example_changes" Тогда
		Результат = СоздатьЗапросПользователю(Аргументы, Контекст, Перечисления.АИС_ВидыВзаимодействийИИ.ВопросыОбразца, "Вопросы по образцу");
	ИначеЕсли Имя = "ask_decision" Тогда
		Результат = СоздатьЗапросПользователю(Аргументы, Контекст, Перечисления.АИС_ВидыВзаимодействийИИ.ВопросРешение, "Требуется решение");
	ИначеЕсли Имя = "submit_draft_for_review" Тогда
		Результат = СоздатьЗапросПользователю(Аргументы, Контекст, Перечисления.АИС_ВидыВзаимодействийИИ.СогласованиеЧерновика, "Согласование черновика");
	Иначе
		Результат = Неопределено;
	КонецЕсли;

	Если Результат = Неопределено Тогда
		Результат = Ошибка("tool_not_implemented", "Инструмент еще не перенесен: " + Имя);
	КонецЕсли;
	Если Результат.ОК И ИнструментИзменяетДанные(Имя) Тогда
		АИС_АгентИИ.ПометитьОдобрениеИспользованным(Контекст.Запуск);
	КонецЕсли;
	ПараметрыИстории.Длительность = (ТекущаяДатаСеанса() - НачалоЗамера) * 86400;
	ПараметрыИстории.Статус = ?(Результат.ОК, "ok", "error");
	ПараметрыИстории.Результат = Результат;
	Если Не Результат.ОК Тогда
		ПараметрыИстории.Ошибка = Результат.Ошибка.Код + ": " + Результат.Ошибка.Текст;
	КонецЕсли;
	АИС_АгентИИ.ЗаписатьИсториюИнструмента(ПараметрыИстории);
	Возврат Результат;
КонецФункции

Функция БазовыеИнструменты() Экспорт
	Инструменты = Новый Массив;
	Инструменты.Добавить("request_action_approval");
	Инструменты.Добавить("ask_clarifying_question");
	Инструменты.Добавить("ask_example_changes");
	Инструменты.Добавить("ask_decision");
	Инструменты.Добавить("complete_task");
	Возврат Инструменты;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИнструментРазрешен(Имя, Контекст)
	Если БазовыеИнструменты().Найти(Имя) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	Разрешенные = Контекст.РазрешенныеИнструменты;
	Возврат ТипЗнч(Разрешенные) = Тип("Массив") И Разрешенные.Найти(Имя) <> Неопределено;
КонецФункции

Функция ВыполнитьПоискRAG(Аргументы, Scope)
	Запрос = СокрЛП(Строка(ЗначениеАргумента(Аргументы, "query")));
	Если ПустаяСтрока(Запрос) Тогда
		Возврат Ошибка("invalid_arguments", "Не указан поисковый запрос");
	КонецЕсли;
	Результат = АИС_ИнтеграцияСRAG.Поиск(Запрос, , , , Scope);
	Возврат Успех(Результат);
КонецФункции

Функция ВыполнитьПоискИнтернет(Аргументы)
	Запрос = СокрЛП(Строка(ЗначениеАргумента(Аргументы, "query")));
	Если ПустаяСтрока(Запрос) Тогда
		Возврат Ошибка("invalid_arguments", "Не указан поисковый запрос");
	КонецЕсли;
	Результат = АИС_ИнтеграцияСПоиском.Поиск(Запрос);
	Возврат Успех(Результат);
КонецФункции

Функция ЗапроситьОдобрение(Аргументы, Контекст)
	ОшибкаПроверки = ПроверитьАргументыОдобрения(Аргументы);
	Если Не ПустаяСтрока(ОшибкаПроверки) Тогда
		Возврат Ошибка("invalid_arguments", ОшибкаПроверки);
	КонецЕсли;
	Вид = Строка(ЗначениеАргумента(Аргументы, "subject_kind"));
	ИнструментДействия = СокрЛП(Строка(ЗначениеАргумента(Аргументы, "tool")));
	АргументыДействия = ЗначениеАргумента(Аргументы, "arguments");
	Если ПустаяСтрока(Вид) Тогда
		Вид = ?(ТипЗнч(ЗначениеАргумента(Аргументы, "documents")) = Тип("Массив"), "documents", "action");
	КонецЕсли;
	Если Вид = "action" И (ПустаяСтрока(ИнструментДействия) ИЛИ АргументыДействия = Неопределено) Тогда
		Возврат Ошибка("invalid_arguments", "Для subject_kind=action укажите tool и arguments");
	КонецЕсли;
	Если Вид = "documents" И АвтоОдобрениеРазрешено(Аргументы, Контекст) Тогда
		АИС_АгентИИ.УстановитьОдобрение(
			Контекст.Запуск, "documents", ИнструментДействия, АргументыДействия, "approved", "", "");
		Возврат Успех(Новый Структура("decision,answer_text", "approved", ""));
	КонецЕсли;
	Возврат СоздатьЗапросПользователю(
		Аргументы,
		Контекст,
		Перечисления.АИС_ВидыВзаимодействийИИ.ОдобрениеДействий,
		"Требуется одобрение",
		Вид,
		ИнструментДействия,
		АргументыДействия);
КонецФункции

Функция СоздатьЗапросПользователю(Аргументы, Контекст, Вид, ЗаголовокПоУмолчанию,
	ВидОдобрения = "", ИнструментДействия = "", АргументыДействия = Неопределено)
	Заголовок = СокрЛП(Строка(ЗначениеАргумента(Аргументы, "title")));
	Если ПустаяСтрока(Заголовок) Тогда
		Заголовок = ЗаголовокПоУмолчанию;
	КонецЕсли;
	Текст = Строка(ЗначениеАргумента(Аргументы, "question"));
	Если ПустаяСтрока(Текст) Тогда
		Текст = Строка(ЗначениеАргумента(Аргументы, "text"));
	КонецЕсли;
	Если ПустаяСтрока(Текст) Тогда
		Текст = Строка(ЗначениеАргумента(Аргументы, "intended"));
	КонецЕсли;
	Payload = Новый Структура(
		"arguments,tool,call_id,subject_kind,action_tool,action_arguments",
		Аргументы,
		Контекст.Инструмент,
		Контекст.CallID,
		ВидОдобрения,
		ИнструментДействия,
		АргументыДействия);
	PayloadJSON = АИС_КлиентВнешнегоСервиса.ЗаписатьJSON(Payload);
	Взаимодействие = АИС_АгентИИ.СоздатьВзаимодействие(
		Вид,
		Контекст.Запуск,
		Контекст.Задача,
		Контекст.Сотрудник,
		Заголовок,
		Текст,
		PayloadJSON);
	Результат = Успех(Новый Структура("interaction_id", Строка(Взаимодействие.УникальныйИдентификатор())));
	Результат.Остановить = Истина;
	Возврат Результат;
КонецФункции

Функция ЗначениеАргумента(Аргументы, Имя)
	Если ТипЗнч(Аргументы) = Тип("Структура") Тогда
		Значение = Неопределено;
		Аргументы.Свойство(Имя, Значение);
		Возврат Значение;
	ИначеЕсли ТипЗнч(Аргументы) = Тип("Соответствие") Тогда
		Возврат Аргументы.Получить(Имя);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция Успех(Данные)
	Возврат Новый Структура("ОК,Данные,Ошибка,Взаимодействие,Остановить", Истина, Данные, Неопределено, Неопределено, Ложь);
КонецФункции

Функция Ошибка(Код, Текст)
	Возврат Новый Структура(
		"ОК,Данные,Ошибка,Взаимодействие,Остановить",
		Ложь,
		Неопределено,
		Новый Структура("Код,Текст", Код, Текст),
		Неопределено,
		Ложь);
КонецФункции

Функция РезультатКадров(Данные)
	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство("КодОшибки") Тогда
		Возврат Ошибка(Данные.КодОшибки, Данные.ТекстОшибки);
	КонецЕсли;
	Возврат Успех(Данные);
КонецФункции

Процедура ЗафиксироватьОтказ(ПараметрыИстории, Код, Текст)
	ПараметрыИстории.Статус = "denied";
	ПараметрыИстории.Ошибка = Код + ": " + Текст;
	ПараметрыИстории.Результат = Ошибка(Код, Текст);
	АИС_АгентИИ.ЗаписатьИсториюИнструмента(ПараметрыИстории);
КонецПроцедуры

Функция ГруппаИнструмента(Имя) Экспорт
	Если СтрРазделить("request_action_approval,ask_clarifying_question,ask_example_changes,ask_decision,complete_task", ",").Найти(Имя) <> Неопределено Тогда
		Возврат "Базовые";
	КонецЕсли;
	Если СтрРазделить("list_documents,read_document,check_document_access,create_draft,create_information_request,submit_draft_for_review,create_document,approve_document,cancel_document", ",").Найти(Имя) <> Неопределено Тогда
		Возврат "Документы";
	КонецЕсли;
	Если СтрРазделить("search_example,search_knowledge_base,get_checklist,get_job_description", ",").Найти(Имя) <> Неопределено Тогда
		Возврат "Поиск и знания";
	КонецЕсли;
	Если СтрРазделить("search_internet,save_external_example", ",").Найти(Имя) <> Неопределено Тогда
		Возврат "Интернет";
	КонецЕсли;
	Если СтрРазделить("hire_employee,propose_system_prompt,accounting_decision,list_employees,list_departments,create_department", ",").Найти(Имя) <> Неопределено Тогда
		Возврат "Персонал и оргструктура";
	КонецЕсли;
	Если Имя = "manage_document_sections" Тогда
		Возврат "Разделы документов";
	КонецЕсли;
	Если СтрРазделить("manage_remarks,return_document,route_remarks", ",").Найти(Имя) <> Неопределено Тогда
		Возврат "Замечания";
	КонецЕсли;
	Если СтрРазделить("kb_download,kb_register_material,kb_list_materials", ",").Найти(Имя) <> Неопределено Тогда
		Возврат "Корпус знаний";
	КонецЕсли;
	Возврат "Неизвестно";
КонецФункции

Функция ИнструментИзменяетДанные(Имя)
	Изменяющие = СтрРазделить("create_draft,create_information_request,create_document,approve_document,cancel_document,hire_employee,propose_system_prompt,accounting_decision,create_department,manage_document_sections,manage_remarks,return_document,route_remarks,kb_download,kb_register_material", ",");
	Возврат Изменяющие.Найти(Имя) <> Неопределено;
КонецФункции

Функция ПроверитьАргументыОдобрения(Аргументы)
	Для Каждого Имя Из СтрРазделить("completed,intended,question", ",") Цикл
		Если ПустаяСтрока(СокрЛП(Строка(ЗначениеАргумента(Аргументы, Имя)))) Тогда
			Возврат "request_action_approval: поле " + Имя + " обязательно";
		КонецЕсли;
	КонецЦикла;
	Опции = ЗначениеАргумента(Аргументы, "options");
	Если ТипЗнч(Опции) <> Тип("Массив") ИЛИ Опции.Количество() <> 2 Тогда
		Возврат "request_action_approval: нужно ровно два варианта ответа";
	КонецЕсли;
	Первый = Опции[0];
	Последний = Опции[1];
	Если ТипЗнч(Первый) <> Тип("Структура") ИЛИ Строка(ЗначениеАргумента(Первый, "kind")) <> "approve" Тогда
		Возврат "request_action_approval: первый вариант должен быть approve";
	КонецЕсли;
	Если СокрЛП(Строка(ЗначениеАргумента(Первый, "text"))) <> "Одобряю. Действуй" Тогда
		Возврат "request_action_approval: текст первого варианта должен быть ""Одобряю. Действуй""";
	КонецЕсли;
	Если ТипЗнч(Последний) <> Тип("Структура") ИЛИ Строка(ЗначениеАргумента(Последний, "kind")) <> "free_text" Тогда
		Возврат "request_action_approval: последний вариант должен быть free_text";
	КонецЕсли;
	Если ПустаяСтрока(СокрЛП(Строка(ЗначениеАргумента(Последний, "text")))) Тогда
		Возврат "request_action_approval: текст варианта free_text обязателен";
	КонецЕсли;
	Документы = ЗначениеАргумента(Аргументы, "documents");
	Если Документы <> Неопределено И ТипЗнч(Документы) <> Тип("Массив") Тогда
		Возврат "request_action_approval: documents должен быть массивом";
	КонецЕсли;
	Возврат "";
КонецФункции

Функция АвтоОдобрениеРазрешено(Аргументы, Контекст)
	Вид = Строка(ЗначениеАргумента(Аргументы, "subject_kind"));
	Если Вид = "action" Тогда
		Возврат Ложь;
	КонецЕсли;
	Инструмент = СокрЛП(Строка(ЗначениеАргумента(Аргументы, "tool")));
	Если Не ПустаяСтрока(Инструмент) Тогда
		АвтоДопустимые = СтрРазделить("create_document,approve_document,cancel_document", ",");
		Если АвтоДопустимые.Найти(Инструмент) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	Документы = ЗначениеАргумента(Аргументы, "documents");
	Если ТипЗнч(Документы) <> Тип("Массив") ИЛИ Документы.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Результат = АИС_АвтоодобрениеСервер.МожноАвтоодобрить(Контекст.Сотрудник, АИС_КлиентВнешнегоСервиса.ЗаписатьJSON(Документы));
		Возврат Результат.Можно;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции


Функция СписокДокументов(Аргументы, Контекст)
	Поиск = СокрЛП(Строка(ЗначениеАргумента(Аргументы, "query")));
	Лимит = ЗначениеАргумента(Аргументы, "limit");
	Если ТипЗнч(Лимит) <> Тип("Число") ИЛИ Лимит <= 0 Тогда
		Лимит = 20;
	КонецЕсли;
	Запрос = Новый Запрос;
	Условие = "";
	Если Не ПустаяСтрока(Поиск) Тогда
		Условие = " И Документы.Заголовок ПОДОБНО &Поиск";
		Запрос.УстановитьПараметр("Поиск", "%" + Поиск + "%");
	КонецЕсли;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Документы.Ссылка КАК Ссылка,
		|	Документы.Заголовок КАК Заголовок,
		|	Документы.ВидДокумента.Наименование КАК Вид,
		|	Документы.Подготовил.Наименование КАК Автор,
		|	Документы.ДатаСоздания КАК Дата
		|ИЗ
		|	Справочник.ВнутренниеДокументы КАК Документы
		|ГДЕ
		|	НЕ Документы.ПометкаУдаления" + Условие + "
		|УПОРЯДОЧИТЬ ПО
		|	Документы.ДатаСоздания УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Результат = Новый Массив;
	Пока Выборка.Следующий() И Результат.Количество() < Лимит Цикл
		Если Не АИС_ПраваДоступа.ПроверитьДоступность(Выборка.Ссылка, Контекст.Сотрудник) Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Новый Структура(
			"id,title,type,author,date,state",
			Строка(Выборка.Ссылка.УникальныйИдентификатор()),
			Выборка.Заголовок,
			Выборка.Вид,
			Выборка.Автор,
			Выборка.Дата,
			Строка(Делопроизводство.ПолучитьСостояниеДокумента(Выборка.Ссылка))));
	КонецЦикла;
	Возврат Успех(Результат);
КонецФункции

Функция ПрочитатьДокумент(Аргументы, Контекст)
	Документ = ДокументПоАргументам(Аргументы);
	Если Не ЗначениеЗаполнено(Документ) Тогда
		Возврат Ошибка("not_found", "Документ не найден");
	КонецЕсли;
	Если Не АИС_ПраваДоступа.ПроверитьДоступность(Документ, Контекст.Сотрудник) Тогда
		Возврат Ошибка("access_denied", "Нет доступа к документу");
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Документы.Заголовок КАК Заголовок,
		|	Документы.Содержание КАК Содержание,
		|	Документы.ВидДокумента.Наименование КАК Вид,
		|	Документы.Подготовил.Наименование КАК Автор,
		|	Документы.ДатаСоздания КАК Дата
		|ИЗ
		|	Справочник.ВнутренниеДокументы КАК Документы
		|ГДЕ
		|	Документы.Ссылка = &Документ";
	Запрос.УстановитьПараметр("Документ", Документ);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Ошибка("not_found", "Документ не найден");
	КонецЕсли;
	Возврат Успех(Новый Структура(
		"id,title,content,type,author,date,state",
		Строка(Документ.УникальныйИдентификатор()),
		Выборка.Заголовок,
		Выборка.Содержание,
		Выборка.Вид,
		Выборка.Автор,
		Выборка.Дата,
		Строка(Делопроизводство.ПолучитьСостояниеДокумента(Документ))));
КонецФункции

Функция ПроверитьДоступКДокументу(Аргументы, Контекст)
	Документ = ДокументПоАргументам(Аргументы);
	Если Не ЗначениеЗаполнено(Документ) Тогда
		Возврат Ошибка("not_found", "Документ не найден");
	КонецЕсли;
	Разрешен = АИС_ПраваДоступа.ПроверитьДоступность(Документ, Контекст.Сотрудник);
	Возврат Успех(Новый Структура("allowed,document", Разрешен, Строка(Документ.УникальныйИдентификатор())));
КонецФункции

Функция УтвердитьДокумент(Аргументы, Контекст)
	Документ = ДокументПоАргументам(Аргументы);
	Если Не ЗначениеЗаполнено(Документ) Тогда
		Возврат Ошибка("not_found", "Документ не найден");
	КонецЕсли;
	Если Не АИС_ПраваДоступа.ПроверитьДоступность(Документ, Контекст.Сотрудник) Тогда
		Возврат Ошибка("access_denied", "Нет доступа к документу");
	КонецЕсли;
	АИС_ОбщегоНазначения.УтвердитьДокумент(Документ, Контекст.Сотрудник);
	Возврат Успех(Новый Структура("document,state", Строка(Документ.УникальныйИдентификатор()), "Утвержден"));
КонецФункции

Функция ОтменитьДокумент(Аргументы, Контекст)
	Документ = ДокументПоАргументам(Аргументы);
	Основание = ДокументПоИдентификатору(Строка(ЗначениеАргумента(Аргументы, "basis_id")));
	Если Не ЗначениеЗаполнено(Документ) ИЛИ Не ЗначениеЗаполнено(Основание) Тогда
		Возврат Ошибка("invalid_arguments", "Укажите документ и основание отмены");
	КонецЕсли;
	Если Не АИС_ПраваДоступа.ПроверитьДоступность(Документ, Контекст.Сотрудник)
		ИЛИ Не АИС_ПраваДоступа.ПроверитьДоступность(Основание, Контекст.Сотрудник) Тогда
		Возврат Ошибка("access_denied", "Нет доступа к документу или основанию");
	КонецЕсли;
	Комментарий = Строка(ЗначениеАргумента(Аргументы, "comment"));
	АИС_ОбщегоНазначения.ОтменитьДокумент(Документ, Основание, Комментарий);
	Возврат Успех(Новый Структура("document,state", Строка(Документ.УникальныйИдентификатор()), "Отменен"));
КонецФункции

Функция ДокументПоАргументам(Аргументы)
	Ид = ЗначениеАргумента(Аргументы, "document_id");
	Если ПустаяСтрока(Строка(Ид)) Тогда
		Ид = ЗначениеАргумента(Аргументы, "id");
	КонецЕсли;
	Возврат ДокументПоИдентификатору(Строка(Ид));
КонецФункции

Функция ДокументПоИдентификатору(Ид)
	Если ПустаяСтрока(СокрЛП(Ид)) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Возврат Справочники.ВнутренниеДокументы.ПолучитьСсылку(Новый УникальныйИдентификатор(Ид));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции


Функция СоздатьЧерновикАгента(Аргументы, Контекст, ВидЧерновикаПоУмолчанию)
	Заголовок = СокрЛП(Строка(ЗначениеАргумента(Аргументы, "title")));
	Если ПустаяСтрока(Заголовок) Тогда
		Возврат Ошибка("invalid_arguments", "Не указан заголовок черновика");
	КонецЕсли;
	Содержание = Строка(ЗначениеАргумента(Аргументы, "content"));
	ВидДокументаИмя = СокрЛП(Строка(ЗначениеАргумента(Аргументы, "document_type")));
	ВидДокумента = Неопределено;
	Если Не ПустаяСтрока(ВидДокументаИмя) Тогда
		ВидДокумента = АИС_ОбщегоНазначения.НайтиИлиСоздатьЭлемент(Справочники.ВидыВнутреннихДокументов, ВидДокументаИмя);
		ВидДокумента.Записать();
	КонецЕсли;
	Адресат = ПользовательПоЛогину(ЗначениеАргумента(Аргументы, "addressee"));
	Основание = ДокументПоИдентификатору(Строка(ЗначениеАргумента(Аргументы, "basis_id")));
	Если Не ПустаяСтрока(Строка(ЗначениеАргумента(Аргументы, "basis_id"))) И Не ЗначениеЗаполнено(Основание) Тогда
		Возврат Ошибка("not_found", "Документ-основание не найден");
	КонецЕсли;
	Если ЗначениеЗаполнено(Основание) И Не АИС_ПраваДоступа.ПроверитьДоступность(Основание, Контекст.Сотрудник) Тогда
		Возврат Ошибка("access_denied", "Нет доступа к документу-основанию");
	КонецЕсли;
	Исходные = ИсходныеДокументы(Аргументы, Контекст);
	Если ТипЗнч(Исходные) = Тип("Структура") Тогда
		Возврат Исходные;
	КонецЕсли;

	Черновик = Справочники.АИС_ЧерновикиДокументов.СоздатьЭлемент();
	Черновик.Наименование = Заголовок;
	Черновик.Автор = Контекст.Сотрудник;
	Черновик.ВидЧерновика = Строка(ЗначениеАргумента(Аргументы, "draft_kind"));
	Если ПустаяСтрока(Черновик.ВидЧерновика) Тогда
		Черновик.ВидЧерновика = ВидЧерновикаПоУмолчанию;
	КонецЕсли;
	Черновик.ВидДокумента = ?(ЗначениеЗаполнено(ВидДокумента), ВидДокумента.Ссылка, Неопределено);
	Черновик.Заголовок = Заголовок;
	Черновик.Содержание = Содержание;
	Черновик.Адресат = Адресат;
	Черновик.Основание = Основание;
	Черновик.ВидЗапроса = Строка(ЗначениеАргумента(Аргументы, "request_kind"));
	Черновик.Статус = "draft";
	Черновик.Замечания = "";
	Черновик.ИсходныеДокументы = АИС_КлиентВнешнегоСервиса.ЗаписатьJSON(Исходные);
	Черновик.Версия = 1;
	Черновик.Записать();
	Возврат Успех(Новый Структура(
		"id,title,version,status",
		Строка(Черновик.Ссылка.УникальныйИдентификатор()),
		Черновик.Заголовок,
		Черновик.Версия,
		"draft"));
КонецФункции

Функция СоздатьДокументАгента(Аргументы, Контекст)
	Заголовок = СокрЛП(Строка(ЗначениеАргумента(Аргументы, "title")));
	Если ПустаяСтрока(Заголовок) Тогда
		Возврат Ошибка("invalid_arguments", "Не указан заголовок документа");
	КонецЕсли;
	ВидДокументаИмя = СокрЛП(Строка(ЗначениеАргумента(Аргументы, "document_type")));
	Если ПустаяСтрока(ВидДокументаИмя) Тогда
		Возврат Ошибка("invalid_arguments", "Не указан вид документа");
	КонецЕсли;
	ВидДокумента = АИС_ОбщегоНазначения.НайтиИлиСоздатьЭлемент(Справочники.ВидыВнутреннихДокументов, ВидДокументаИмя);
	ВидДокумента.Записать();
	Адресат = ПользовательПоЛогину(ЗначениеАргумента(Аргументы, "addressee"));
	Основание = ДокументПоИдентификатору(Строка(ЗначениеАргумента(Аргументы, "basis_id")));
	Если Не ПустаяСтрока(Строка(ЗначениеАргумента(Аргументы, "basis_id"))) И Не ЗначениеЗаполнено(Основание) Тогда
		Возврат Ошибка("not_found", "Документ-основание не найден");
	КонецЕсли;
	Если ЗначениеЗаполнено(Основание) И Не АИС_ПраваДоступа.ПроверитьДоступность(Основание, Контекст.Сотрудник) Тогда
		Возврат Ошибка("access_denied", "Нет доступа к документу-основанию");
	КонецЕсли;

	Документ = Справочники.ВнутренниеДокументы.СоздатьЭлемент();
	Документ.ОбработкаЗаполнения(Неопределено, Ложь);
	Документ.ВидДокумента = ВидДокумента.Ссылка;
	Документ.Заголовок = Заголовок;
	Документ.Содержание = Строка(ЗначениеАргумента(Аргументы, "content"));
	Документ.Адресат = Адресат;
	Документ.Подготовил = Контекст.Сотрудник;
	Документ.АИС_ПубликоватьВRAG = Истина;
	Документ.Записать();
	Если ЗначениеЗаполнено(Основание) Тогда
		АИС_ОбщегоНазначения.СоздатьСвязьДокументаСОснованием(Документ.Ссылка, Основание);
	КонецЕсли;
	Возврат Успех(Новый Структура(
		"id,title,status",
		Строка(Документ.Ссылка.УникальныйИдентификатор()),
		Документ.Заголовок,
		"создан"));
КонецФункции

Функция СоздатьДокументПоАргументам(Аргументы, Контекст) Экспорт
	Возврат СоздатьДокументАгента(Аргументы, Контекст);
КонецФункции

Функция ПользовательПоЛогину(Логин)
	Логин = СокрЛП(Строка(Логин));
	Если ПустаяСтрока(Логин) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Справочники.Пользователи.НайтиПоНаименованию(Логин, Истина);
КонецФункции

Функция ИсходныеДокументы(Аргументы, Контекст)
	ИсходныеJSON = ЗначениеАргумента(Аргументы, "source_documents");
	Если ТипЗнч(ИсходныеJSON) <> Тип("Массив") Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Результат = Новый Массив;
	Для Каждого Ид Из ИсходныеJSON Цикл
		Документ = ДокументПоИдентификатору(Строка(Ид));
		Если Не ЗначениеЗаполнено(Документ) Тогда
			Возврат Ошибка("not_found", "Исходный документ не найден: " + Строка(Ид));
		КонецЕсли;
		Если Не АИС_ПраваДоступа.ПроверитьДоступность(Документ, Контекст.Сотрудник) Тогда
			Возврат Ошибка("access_denied", "Нет доступа к исходному документу: " + Строка(Ид));
		КонецЕсли;
		Результат.Добавить(Строка(Документ.УникальныйИдентификатор()));
	КонецЦикла;
	Возврат Результат;
КонецФункции


#КонецОбласти
