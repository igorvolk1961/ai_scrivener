#Область ПрограммныйИнтерфейс

// Создаёт сотрудника 1С:ДО: физлицо, реальную учётную запись ИБ, элемент
// Справочник.Пользователи и постоянную должность. Идемпотентно — повторный
// вызов с тем же Имя находит существующего пользователя и не создаёт дублей.
// Используется HTTPService для внешних агентов-симуляторов (АИС_Симулятор);
// демонстрационные должности и пользователи создаются симулятором.
//
// Параметры:
//  Имя - Строка - имя пользователя ИБ (логин).
//  ФИО - Строка - полное имя физлица.
//  Должность - СправочникОбъект.Должности - должность (не Ссылка, т.к. вызывающий
//              код обычно уже держит объект при массовом создании через
//              НайтиИлиСоздатьЭлемент).
//  РолиРасширения - Массив(РольМетаданных) - роли АИС_* для нового
//              пользователя; пустой массив - без ролей расширения (например,
//              демо "БезРоли" для негативных тестов доступа). Массив, а не
//              одна роль: в реальной иерархии почти любой руководитель — это
//              одновременно и ДолжностноеЛицо (для своего начальника), и
//              ВышестоящееДолжностноеЛицо (для своих подчинённых); ролей
//              может быть несколько одновременно.
//  Пароль - Строка, Неопределено - пароль учётной записи ИБ. Нужен внешним
//              агентам (HTTPService, Basic Auth); демоданным, запускаемым из
//              Конфигуратора/Предприятия интерактивно, не требуется -
//              по умолчанию Неопределено (пустой пароль).
//  Руководитель - СправочникСсылка.Пользователи, Неопределено - непосредственный
//              начальник (используется для поиска, кому эскалировать, когда
//              для должности сотрудника нет должностной инструкции - см.
//              АИС_Уведомления). Записывается в штатный
//              РегистрСведений.ПодчиненностьСотрудников базовой конфигурации
//              (не адаптирован в расширение - пишется и читается напрямую
//              через BSL, как и СведенияОПользователяхДокументооборот ниже;
//              адаптация нужна только для подписок на события, не для
//              обычного чтения/записи). Неопределено - без начальника в
//              системе (например, генеральный директор, чей начальник -
//              владелец предприятия вне системы).
//
// Возвращаемое значение:
//  СправочникСсылка.Пользователи - созданный или найденный пользователь.
Функция СоздатьСотрудника(Имя, ФИО, Должность, РолиРасширения, Пароль = Неопределено, Руководитель = Неопределено, РазрешитьБезРуководителя = Ложь) Экспорт
	Если ПустаяСтрока(Имя) Тогда
		ВызватьИсключение "Не указано имя пользователя информационной базы.";
	КонецЕсли;

	// Должностная иерархия — источник истины: если для должности задан
	// руководитель должности, он важнее переданного вручную логина.
	РуководительПоДолжности = АИС_ОбщегоНазначения.РуководительСотрудникаПоДолжности(Должность.Ссылка);
	Если ЗначениеЗаполнено(РуководительПоДолжности) Тогда
		Руководитель = РуководительПоДолжности;
	КонецЕсли;

	Если Руководитель <> Неопределено Тогда
		Если Не ЗначениеЗаполнено(Руководитель) Тогда
			Если Не РазрешитьБезРуководителя Тогда
				ВызватьИсключение "Не найден руководитель сотрудника.";
			КонецЕсли;
			Руководитель = Неопределено;
		ИначеЕсли Руководитель.Наименование = Имя Тогда
			ВызватьИсключение "Сотрудник не может быть своим руководителем.";
		КонецЕсли;
	ИначеЕсли Не РазрешитьБезРуководителя Тогда
		ВызватьИсключение
			"Не удалось определить руководителя по должности. "
			+ "Заполните РегистрСведений.АИС_ПодчиненностьДолжностей.";
	КонецЕсли;
	ФизЛицо = АИС_ОбщегоНазначения.НайтиИлиСоздатьЭлемент(Справочники.ФизическиеЛица, ФИО);
	ФизЛицо.Наименование = ФИО;
	ФизЛицо.Записать();

	// Справочник.Пользователи в 1С:ДО жёстко связан с реальной учётной записью
	// ИБ: ПередЗаписью (ПользователиСлужебный.ПользовательОбъектПередЗаписью)
	// всегда запускает синхронизацию с ПользовательИнформационнойБазы, и при
	// создании элемента без неё падает на попытке записать защищённое поле.
	// Поэтому создаём настоящую учётную запись ИБ и регистрируем её
	// официальным способом (ДополнительныеСвойства.ОписаниеПользователяИБ),
	// как это делает сам модуль Пользователи (см.
	// Пользователи.СоздатьАдминистратора). Важно: локальная переменная в этом
	// модуле НЕ должна называться "Пользователи" — совпадение с именем
	// общего модуля базовой конфигурации вызывает платформенную ошибку
	// "Поле объекта недоступно для записи (Пользователи)" ещё до вызова
	// ПользователиИБ.Записать() (подтверждено контрольным экспериментом).
	// Роли синхронизируются безусловно, независимо от того, существует ли уже
	// элемент Справочник.Пользователи — иначе на уже заведённого (пусть даже
	// "голого", без ролей) пользователя донабрать роли повторным вызовом
	// невозможно (баг, найденный на практике: несколько тестовых учёток
	// остались без ролей расширения именно потому, что эта синхронизация была
	// по ошибке вложена внутрь "Если Не ЗначениеЗаполнено(Сотрудник)" ниже).
	// Содержит() предотвращает ошибку повторного добавления уже назначенной роли.
	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(Имя);
	Если ПользовательИБ = Неопределено Тогда
		ПользовательИБ = ПользователиИнформационнойБазы.СоздатьПользователя();
		ПользовательИБ.Имя = Имя;
		ПользовательИБ.ПолноеИмя = ФИО;
		ПользовательИБ.ПоказыватьВСпискеВыбора = Истина;
		Если Пароль <> Неопределено Тогда
			ПользовательИБ.Пароль = Пароль;
		КонецЕсли;
		// Учётную запись ИБ нужно сохранить до записи Справочник.Пользователи:
		// его ПередЗаписью синхронизирует защищённые свойства по UUID и иначе
		// видит ещё не сохранённого пользователя с пустым именем, из-за чего
		// падает с "Property 'Имя' is not defined".
		ПользовательИБ.Записать();
	КонецЕсли;
	// Справочник.Пользователи в 1С:ДО жёстко связан с реальной учётной записью
	// ИБ: ПередЗаписью (ПользователиСлужебный.ПользовательОбъектПередЗаписью)
	// всегда запускает синхронизацию с ПользовательИнформационнойБазы, и при
	// создании элемента без неё падает на попытке записать защищённое поле.
	// Поэтому регистрируем её официальным способом
	// (ДополнительныеСвойства.ОписаниеПользователяИБ), как это делает сам
	// модуль Пользователи (см. Пользователи.СоздатьАдминистратора). Важно:
	// локальная переменная в этом модуле НЕ должна называться "Пользователи" —
	// совпадение с именем общего модуля базовой конфигурации вызывает
	// платформенную ошибку "Поле объекта недоступно для записи (Пользователи)"
	// ещё до вызова ПользователиИБ.Записать() (подтверждено контрольным
	// экспериментом).
	Сотрудник = Справочники.Пользователи.НайтиПоНаименованию(Имя, Истина);
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		Объект = Справочники.Пользователи.СоздатьЭлемент();
		Объект.Наименование = Имя;
		Объект.ФизЛицо = ФизЛицо.Ссылка;

		ОписаниеПользователяИБ = Новый Структура;
		ОписаниеПользователяИБ.Вставить("Действие", "Записать");
		ОписаниеПользователяИБ.Вставить("УникальныйИдентификатор", ПользовательИБ.УникальныйИдентификатор);
		Объект.ДополнительныеСвойства.Вставить("ОписаниеПользователяИБ", ОписаниеПользователяИБ);

		Объект.Записать();
		Сотрудник = Объект.Ссылка;
	КонецЕсли;

	// Роли назначаем после записи элемента Справочник.Пользователи:
	// его ПередЗаписью синхронизирует учётную запись ИБ и может сбросить
	// роли, назначенные до этого. Для уже существующего элемента достаточно
	// этой синхронизации.
	РолиИзменены = Ложь;
	Если ДобавитьРольЕслиНужно(ПользовательИБ, Метаданные.Роли.БазовыеПраваДокументооборот) Тогда
		РолиИзменены = Истина;
	КонецЕсли;
	Если ДобавитьРольЕслиНужно(ПользовательИБ, Метаданные.Роли.БазовыеПраваБСП) Тогда
		РолиИзменены = Истина;
	КонецЕсли;
	Для Каждого РольРасширения Из РолиРасширения Цикл
		Если ДобавитьРольЕслиНужно(ПользовательИБ, РольРасширения) Тогда
			РолиИзменены = Истина;
		КонецЕсли;
	КонецЦикла;
	Если РолиИзменены Тогда
		ПользовательИБ.Записать();
	КонецЕсли;

	Запись = РегистрыСведений.СведенияОПользователяхДокументооборот.СоздатьМенеджерЗаписи();
	// Ключ нужно устанавливать повторно после Прочитать: для новой учётной
	// записи записи в регистре ещё нет, и Прочитать оставляет измерения
	// пустыми — запись падает на "Пользователь ... cannot be empty"
	// (denyIncompleteValues). Для существующей записи повторная установка
	// того же значения безопасна.
	Запись.Пользователь = Сотрудник;
	Запись.Прочитать();
	Запись.Пользователь = Сотрудник;
	Запись.Должность = Должность.Ссылка;
	Запись.Записать();

	АИС_ОбщегоНазначения.УстановитьРуководителя(Сотрудник, Руководитель);

	// Запись СведенияОПользователяхДокументооборот запускает штатную подписку
	// ДокументооборотПриЗаписиПравообразующихРегистров, которая пересобирает
	// ПодчиненностьСотрудников по подразделениям и может очистить связи,
	// построенные по должностям. Поэтому сразу восстанавливаем их из
	// должностной иерархии.
	АИС_ОбщегоНазначения.СинхронизироватьПодчиненностьПоДолжностям();
	АИС_ОбщегоНазначения.НазначитьПодразделенияПоДолжностям();

	Возврат Сотрудник;
КонецФункции

// Отображает массив строковых имён ролей расширения (как их пришлёт внешний
// клиент, например HTTPService) на реальные объекты метаданных ролей. Нужно,
// потому что по HTTP приходит только текст, а не ссылки на метаданные.
// Руководитель почти всегда одновременно ДолжностноеЛицо (для своего
// начальника) и ВышестоящееДолжностноеЛицо (для своих подчинённых) — поэтому
// принимает массив, а не одну роль.
//
// Параметры:
//  ИменаРолей - Массив(Строка) - любое количество из: "ДолжностноеЛицо",
//            "ВышестоящееДолжностноеЛицо", "АдминистраторСистемы", "Аудитор",
//            "СервисныйПользователь". Пустой массив - без ролей расширения.
//
// Возвращаемое значение:
//  Массив(РольМетаданных).
Функция РолиПоИменам(ИменаРолей) Экспорт
	ДоступныеРоли = Новый Соответствие;
	ДоступныеРоли.Вставить("ДолжностноеЛицо", Метаданные.Роли.АИС_ДолжностноеЛицо);
	ДоступныеРоли.Вставить("ВышестоящееДолжностноеЛицо", Метаданные.Роли.АИС_ВышестоящееДолжностноеЛицо);
	ДоступныеРоли.Вставить("АдминистраторСистемы", Метаданные.Роли.АИС_АдминистраторСистемы);
	ДоступныеРоли.Вставить("Аудитор", Метаданные.Роли.АИС_Аудитор);
	ДоступныеРоли.Вставить("СервисныйПользователь", Метаданные.Роли.АИС_СервисныйПользователь);

	Роли = Новый Массив;
	Для Каждого ИмяРоли Из ИменаРолей Цикл
		Роль = ДоступныеРоли.Получить(ИмяРоли);
		Если Роль = Неопределено Тогда
			ВызватьИсключение "Неизвестная роль расширения: " + ИмяРоли;
		КонецЕсли;
		Роли.Добавить(Роль);
	КонецЦикла;
	Возврат Роли;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДобавитьРольЕслиНужно(ПользовательИБ, Роль)
	Если Не ПользовательИБ.Роли.Содержит(Роль) Тогда
		ПользовательИБ.Роли.Добавить(Роль);
		Возврат Истина;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

#КонецОбласти
