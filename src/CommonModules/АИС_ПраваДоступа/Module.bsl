#Область ПрограммныйИнтерфейс

// Возвращает allow-принципалы документа для payload Qdrant.
//
// Принципалы имеют вид "user:<uuid>", "position:<uuid>", "department:<uuid>",
// "group:<uuid>", "role:<имя>". Документ доступен, если хотя бы один
// принципал пользователя пересекается с allow-списком документа.
//
// Параметры:
//  Документ - СправочникСсылка - документ документооборота.
//  Дата     - Дата, Неопределено - дата, на которую строится ACL.
//
// Возвращаемое значение:
//  Массив(Строка) - отсортированный список принципалов.
Функция ПринципалыДокумента(Документ, Дата = Неопределено) Экспорт
	Если Не ЗначениеЗаполнено(Документ) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Если Дата = Неопределено Тогда
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;

	Принципалы = Новый Массив;

	// Штатная рабочая группа документа: Объект, Участник.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РабочиеГруппы.Участник КАК Участник
	|ИЗ
	|	РегистрСведений.РабочиеГруппы КАК РабочиеГруппы
	|ГДЕ
	|	РабочиеГруппы.Объект = &Документ
	|	И РабочиеГруппы.Участник <> НЕОПРЕДЕЛЕНО";
	Запрос.УстановитьПараметр("Документ", Документ);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьПринципалПоЗначению(Принципалы, Выборка.Участник);
	КонецЦикла;

	// Реквизиты карточки, которые дают доступ участникам.
	ИменаРеквизитов = Новый Массив;
	Для Каждого ИмяРеквизита Из СтрРазделить(
		"Подготовил,Автор,Создал,Ответственный,Адресат,Корреспондент,Подписал,Утвердил",
		",") Цикл
		Если РеквизитЕстьУОбъекта(Документ, ИмяРеквизита) Тогда
			ИменаРеквизитов.Добавить(ИмяРеквизита);
		КонецЕсли;
	КонецЦикла;

	Если ИменаРеквизитов.Количество() > 0 Тогда
		ЗапросРеквизитов = Новый Запрос;
		ЗапросРеквизитов.Текст =
		"ВЫБРАТЬ
		|	" + СтрСоединить(ИменаРеквизитов, ", ") + "
		|ИЗ
		|	" + ПолноеИмяОбъекта(Документ) + " КАК Документ
		|ГДЕ
		|	Документ.Ссылка = &Документ";
		ЗапросРеквизитов.УстановитьПараметр("Документ", Документ);
		ВыборкаРеквизитов = ЗапросРеквизитов.Выполнить().Выбрать();
		Если ВыборкаРеквизитов.Следующий() Тогда
			Для Каждого ИмяРеквизита Из ИменаРеквизитов Цикл
				ДобавитьПринципалПоЗначению(Принципалы, ВыборкаРеквизитов[ИмяРеквизита]);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	// Должностная инструкция: должность видит инструкцию сама,
	// руководитель должности — как согласующее лицо.
	Если РеквизитЕстьУОбъекта(Документ, "АИС_Должность") Тогда
		Должность = ЗначениеРеквизита(Документ, "АИС_Должность");
		Если ЗначениеЗаполнено(Должность) Тогда
			ДобавитьПринципалПоЗначению(Принципалы, Должность);
			Руководитель = АИС_ОбщегоНазначения.РуководительСотрудникаПоДолжности(Должность);
			Если ЗначениеЗаполнено(Руководитель) Тогда
				ДобавитьПринципалПоЗначению(Принципалы, Руководитель);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Принципалы.Сортировать();
	Возврат Принципалы;
КонецФункции

// Возвращает принципалы текущего пользователя для фильтра Qdrant.
//
// Параметры:
//  Пользователь - СправочникСсылка.Пользователи.
//  Дата         - Дата, Неопределено - дата, на которую строится ACL.
//
// Возвращаемое значение:
//  Массив(Строка).
Функция ПринципалыПользователя(Пользователь, Дата = Неопределено) Экспорт
	Если Не ЗначениеЗаполнено(Пользователь) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Если Дата = Неопределено Тогда
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;

	Принципалы = Новый Массив;
	ДобавитьПринципалПоЗначению(Принципалы, Пользователь);
	Принципалы.Добавить("all");

	// Роли расширения и базовые роли: role:<имя>.
	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(Пользователь.Наименование);
	Если ПользовательИБ <> Неопределено Тогда
		Для Каждого Роль Из ПользовательИБ.Роли Цикл
			Принципалы.Добавить("role:" + Роль.Имя);
		КонецЦикла;
	КонецЕсли;

	// Должности пользователя и их подразделения.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Сведения.Должность КАК Должность
	|ИЗ
	|	РегистрСведений.СведенияОПользователяхДокументооборот КАК Сведения
	|ГДЕ
	|	Сведения.Пользователь = &Пользователь
	|	И Сведения.Должность <> НЕОПРЕДЕЛЕНО";
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДобавитьПринципалПоЗначению(Принципалы, Выборка.Должность);
		Если РеквизитЕстьУОбъекта(Выборка.Должность, "Подразделение") Тогда
			Подразделение = ЗначениеРеквизита(Выборка.Должность, "Подразделение");
			ДобавитьПринципалПоЗначению(Принципалы, Подразделение);
			ДобавитьРодительскиеПодразделения(Принципалы, Подразделение);
		КонецЕсли;
	КонецЦикла;

	Принципалы.Сортировать();
	Возврат Принципалы;
КонецФункции

// Считает SHA-256 от отсортированного списка принципалов.
Функция ХешПринципалов(Принципалы) Экспорт
	Если ТипЗнч(Принципалы) <> Тип("Массив") Тогда
		Принципалы = Новый Массив;
	КонецЕсли;
	Список = Новый Массив;
	Для Каждого Принципал Из Принципалы Цикл
		Список.Добавить(Строка(Принципал));
	КонецЦикла;
	Список.Сортировать();
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(СтрСоединить(Список, "|"));
	Возврат НРег(СтрЗаменить(Хеширование.ХешСумма, " ", ""));
КонецФункции

// Проверяет, доступен ли документ пользователю по штатным правам и ACL.
//
// Проверка выполняется в момент запроса и не зависит от payload в Qdrant.
// Если ACL документа пуст или не пересекается с принципалами пользователя,
// документ считается недоступным (fail closed).
//
// Параметры:
//  Документ    - СправочникСсылка - документ документооборота.
//  Пользователь - СправочникСсылка.Пользователи - текущий пользователь.
//  Дата        - Дата, Неопределено - дата, на которую строится ACL.
//
// Возвращаемое значение:
//  Булево.
Функция ПроверитьДоступность(Документ, Пользователь, Дата = Неопределено) Экспорт
	Если Не ЗначениеЗаполнено(Документ) ИЛИ Не ЗначениеЗаполнено(Пользователь) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Дата = Неопределено Тогда
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;

	ПринципалыПользователяСписок = ПринципалыПользователя(Пользователь, Дата);
	Если ПринципалыПользователяСписок.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	ПринципалыДокументаСписок = ПринципалыДокумента(Документ, Дата);
	Если ПринципалыДокументаСписок.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	ДоступенПоАCL = Ложь;
	Для Каждого Принципал Из ПринципалыПользователяСписок Цикл
		Если ПринципалыДокументаСписок.Найти(Принципал) <> Неопределено Тогда
			ДоступенПоАCL = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Не ДоступенПоАCL Тогда
		Возврат Ложь;
	КонецЕсли;

	Попытка
		Если Не ПравоДоступа("Чтение", Документ, Пользователь) Тогда
			Возврат Ложь;
		КонецЕсли;
	Исключение
		// В отдельных конфигурациях право может называться иначе;
		// ACL уже проверен, поэтому не блокируем доступ из-за имени права.
	КонецПопытки;

	Возврат Истина;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьПринципалПоЗначению(Принципалы, Значение)
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;
	МетаданныеОбъекта = Метаданные.НайтиПоТипу(ТипЗнч(Значение));
	Если МетаданныеОбъекта = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Имя = МетаданныеОбъекта.Имя;
	Если Имя = "Пользователи" Тогда
		Принципалы.Добавить("user:" + Строка(Значение.УникальныйИдентификатор()));
	ИначеЕсли Имя = "Должности" Тогда
		Принципалы.Добавить("position:" + Строка(Значение.УникальныйИдентификатор()));
	ИначеЕсли Имя = "Подразделения" ИЛИ Имя = "СтруктураПредприятия" Тогда
		Принципалы.Добавить("department:" + Строка(Значение.УникальныйИдентификатор()));
	ИначеЕсли Имя = "РабочиеГруппы" Тогда
		Принципалы.Добавить("group:" + Строка(Значение.УникальныйИдентификатор()));
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьРодительскиеПодразделения(Принципалы, Подразделение)
	Текущее = Подразделение;
	Для НомерУровня = 1 По 20 Цикл
		Если Не ЗначениеЗаполнено(Текущее) Тогда
			Прервать;
		КонецЕсли;
		Если Не РеквизитЕстьУОбъекта(Текущее, "Родитель") Тогда
			Прервать;
		КонецЕсли;
		Родитель = ЗначениеРеквизита(Текущее, "Родитель");
		Если Не ЗначениеЗаполнено(Родитель) Тогда
			Прервать;
		КонецЕсли;
		ДобавитьПринципалПоЗначению(Принципалы, Родитель);
		Текущее = Родитель;
	КонецЦикла;
КонецПроцедуры

Функция РеквизитЕстьУОбъекта(Ссылка, ИмяРеквизита)
	Попытка
		МетаданныеОбъекта = Метаданные.НайтиПоТипу(ТипЗнч(Ссылка));
		Если МетаданныеОбъекта = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат МетаданныеОбъекта.Реквизиты.Найти(ИмяРеквизита) <> Неопределено;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция ЗначениеРеквизита(Ссылка, ИмяРеквизита)
	Попытка
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, ИмяРеквизита);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция ПолноеИмяОбъекта(Ссылка)
	МетаданныеОбъекта = Метаданные.НайтиПоТипу(ТипЗнч(Ссылка));
	Если МетаданныеОбъекта = Неопределено Тогда
		ВызватьИсключение "Не удалось определить метаданные объекта ACL";
	КонецЕсли;
	Возврат МетаданныеОбъекта.ПолноеИмя();
КонецФункции

#КонецОбласти
