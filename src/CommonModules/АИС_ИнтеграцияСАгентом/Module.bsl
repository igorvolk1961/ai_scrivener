#Область ПрограммныйИнтерфейс

Функция ВыполнитьШаг(Снимок) Экспорт
	ТелоЗапроса = АИС_КлиентВнешнегоСервиса.ЗаписатьJSON(Снимок);
	ТелоОтвета = ВыполнитьЗапрос("POST", "/v1/agent/step", ТелоЗапроса, Истина);
	Данные = АИС_КлиентВнешнегоСервиса.ПрочитатьJSONИзСтроки(ТелоОтвета);
	Тип = Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Данные, "type"));
	ВерсияПротокола = АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Данные, "protocol_version");
	ВерсияЗапуска = АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Данные, "run_version");
	Инструмент = Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Данные, "tool"));
	CallID = Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Данные, "call_id"));
	Содержание = Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Данные, "content"));
	Код = Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Данные, "code"));
	Ошибка = Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Данные, "message"));
	Аргументы = АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Данные, "arguments");

	Если Тип <> "tool_call" И Тип <> "final" И Тип <> "error" Тогда
		Тип = "error";
		Код = "invalid_response";
		Ошибка = "agent-service вернул неизвестный тип ответа";
	КонецЕсли;

	Возврат Новый Структура(
		"Тип,Инструмент,Аргументы,CallID,Содержание,Код,Ошибка,ВерсияПротокола,ВерсияЗапуска",
		Тип,
		Инструмент,
		Аргументы,
		CallID,
		Содержание,
		Код,
		Ошибка,
		ВерсияПротокола,
		ВерсияЗапуска);
КонецФункции

Функция Завершить(СистемныйПромпт, ПользовательскийПромпт, Модель = Неопределено,
	Температура = Неопределено, МаксимумТокенов = Неопределено,
	ОтветФорматJSON = Ложь) Экспорт
	Если Не ЗначениеЗаполнено(Модель) Тогда
		Модель = "deepseek-chat";
	КонецЕсли;
	ТемператураПоУмолчанию = 0.2;
	МаксимумТокеновПоУмолчанию = 2000;
	Если Не ЗначениеЗаполнено(Температура) Тогда
		Температура = Константы.АИС_ТемператураАгента.Получить();
		Если Не ЗначениеЗаполнено(Температура) Тогда
			Температура = ТемператураПоУмолчанию;
		КонецЕсли;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(МаксимумТокенов) Тогда
		МаксимумТокенов = Константы.АИС_МаксимумТокеновАгента.Получить();
		Если Не ЗначениеЗаполнено(МаксимумТокенов) Тогда
			МаксимумТокенов = МаксимумТокеновПоУмолчанию;
		КонецЕсли;
	КонецЕсли;
	ТелоЗапроса = Новый Структура(
		"system_prompt,user_prompt,model,temperature,max_tokens,json_mode",
		СистемныйПромпт,
		ПользовательскийПромпт,
		Модель,
		Температура,
		МаксимумТокенов,
		ОтветФорматJSON);
	ТелоОтвета = ВыполнитьЗапрос(
		"POST",
		"/v1/llm/complete",
		АИС_КлиентВнешнегоСервиса.ЗаписатьJSON(ТелоЗапроса),
		Истина);
	Данные = АИС_КлиентВнешнегоСервиса.ПрочитатьJSONИзСтроки(ТелоОтвета);
	Возврат Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Данные, "content"));
КонецФункции

Функция ПроверитьДоступность() Экспорт
	Попытка
		ТелоОтвета = ВыполнитьЗапрос("GET", "/health", Неопределено, Ложь);
		Данные = АИС_КлиентВнешнегоСервиса.ПрочитатьJSONИзСтроки(ТелоОтвета);
		Возврат Новый Структура(
			"Доступен,КодСостояния,Ошибка,Провайдер,Версия",
			Истина,
			0,
			"",
			Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Данные, "provider")),
			Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Данные, "version")));
	Исключение
		Возврат Новый Структура(
			"Доступен,КодСостояния,Ошибка,Провайдер,Версия",
			Ложь,
			0,
			ОписаниеОшибки(),
			"",
			"");
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВыполнитьЗапрос(Метод, Путь, ТелоЗапроса = Неопределено, ТребуетсяТокен = Истина)
	Возврат АИС_КлиентВнешнегоСервиса.ВыполнитьЗапрос(
		Константы.АИС_АдресAgentService.Получить(),
		"",
		Константы.АИС_ТаймаутAgentService.Получить(),
		Константы.АИС_ПовторыAgentService.Получить(),
		Метод,
		Путь,
		ТелоЗапроса,
		Ложь,
		"agent-service");
КонецФункции

#КонецОбласти
