#Область ПрограммныйИнтерфейс

// Отвечает на однократный вопрос по базе знаний.
//
// Параметры:
//  Вопрос  - Строка - вопрос пользователя.
//  Фильтры - Структура, Неопределено - фильтры /v1/retrieve.
//
// Возвращаемое значение:
//  Структура:
//   * Найден - Булево;
//   * Ответ - Строка;
//   * Источники - Массив структур источников;
//   * ОтветLLM - Строка - сырой ответ модели для диагностики;
//   * Ошибка - Строка.
Функция Ответить(Вопрос, Фильтры = Неопределено) Экспорт
	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	Промпт = "";
	ОтветLLM = "";
	Попытка
		РезультатПоиска = АИС_ИнтеграцияСRAG.Поиск(Вопрос, Фильтры);
		Если Не РезультатПоиска.Найден Тогда
			Возврат ПустойОтвет("В базе знаний не найдено.");
		КонецЕсли;

		Кандидаты = КандидатыПоиска(РезультатПоиска);
		Если Кандидаты.Количество() = 0 Тогда
			Возврат ПустойОтвет("В базе знаний не найдено.");
		КонецЕсли;
		Отсортированные = РеранкКандидаты(Вопрос, Кандидаты);

		Контекст = Новый Массив;
		Источники = Новый Массив;
		ИсточникиПоИД = Новый Соответствие;
		Допустимые = Новый Соответствие;
		Номер = 0;
		Для Каждого Кандидат Из Отсортированные Цикл
			Номер = Номер + 1;
			Метка = "S" + Номер;
			Контекст.Добавить(
				"[S" + Номер + "] Документ: " + Кандидат.Заголовок
				+ ?(ПустаяСтрока(Кандидат.ДокТип), "", "; вид: " + Кандидат.ДокТип)
				+ ?(ПустаяСтрока(Кандидат.РазделТекст), "", "; раздел: " + Кандидат.РазделТекст)
				+ ?(ПустаяСтрока(Кандидат.Пункт), "", "; пункт: " + Кандидат.Пункт)
				+ Символы.ПС + Кандидат.Текст);
			Допустимые.Вставить(Кандидат.SourceID, Истина);
			Допустимые.Вставить(Метка, Истина);
			Если Не ПустаяСтрока(Кандидат.Пункт) Тогда
				Допустимые.Вставить(Кандидат.SourceID + "|" + Кандидат.Пункт, Истина);
				Допустимые.Вставить(Метка + "|" + Кандидат.Пункт, Истина);
			КонецЕсли;
			Источник = ИсточникиПоИД.Получить(Кандидат.SourceID);
			Если Источник = Неопределено Тогда
				Источник = Новый Структура(
					"Номер,SourceID,Заголовок,ДокТип,Пункт,Страница,Score",
					Источники.Количество() + 1,
					Кандидат.SourceID,
					Кандидат.Заголовок,
					Кандидат.ДокТип,
					Кандидат.Пункт,
					Кандидат.Страница,
					Кандидат.Score);
				Источники.Добавить(Источник);
				ИсточникиПоИД.Вставить(Кандидат.SourceID, Источник);
			КонецЕсли;
			ИсточникиПоИД.Вставить(Метка, Источник);
		КонецЦикла;

		ПараметрыПромпта = ПараметрыПромптаПоИмени("ОтветПоБазеЗнаний");
		Промпт = ПараметрыПромпта.Текст;
		Пользовательский = "Вопрос: " + Вопрос + Символы.ПС
			+ "Контекст:" + Символы.ПС + СтрСоединить(Контекст, Символы.ПС);
		ОтветLLM = АИС_ОбщегоНазначения.ВызватьИИ(
			Промпт,
			Пользовательский,
			ПараметрыПромпта.Модель,
			ПараметрыПромпта.Температура,
			ПараметрыПромпта.МаксимумТокенов);

		Данные = РазобратьJSON(ОтветLLM);
		Найден = АИС_ИнтеграцияСRAG.ЗначениеJSON(Данные, "found") = Истина;
		Ответ = СокрЛП(Строка(АИС_ИнтеграцияСRAG.ЗначениеJSON(Данные, "answer")));
		Валидные = Новый Массив;
		Использованные = Новый Соответствие;
		Цитаты = АИС_ИнтеграцияСRAG.ЗначениеJSON(Данные, "citations");
		Если ТипЗнч(Цитаты) = Тип("Массив") Тогда
			Для Каждого Цитата Из Цитаты Цикл
				ИД = Строка(АИС_ИнтеграцияСRAG.ЗначениеJSON(Цитата, "source_id"));
				Пункт = Строка(АИС_ИнтеграцияСRAG.ЗначениеJSON(Цитата, "clause"));
				Если ПустаяСтрока(ИД) Тогда
					Продолжить;
				КонецЕсли;
				Подходит = (Допустимые.Получить(ИД) = Истина);
				Если Не ПустаяСтрока(Пункт) Тогда
					Подходит = (Допустимые.Получить(ИД + "|" + Пункт) = Истина);
				КонецЕсли;
				Источник = ИсточникиПоИД.Получить(ИД);
				Если Подходит И Источник <> Неопределено Тогда
					КлючИсточника = Строка(Источник.SourceID);
					Если Использованные.Получить(КлючИсточника) = Неопределено Тогда
						Валидные.Добавить(Источник);
						Использованные.Вставить(КлючИсточника, Истина);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

		Если Найден И Валидные.Количество() = 0 Тогда
			Найден = Ложь;
			Ответ = "В базе знаний не найдено подтверждённых источников.";
		КонецЕсли;
		Если Не Найден Тогда
			Валидные = Новый Массив;
			Если ПустаяСтрока(Ответ) Тогда
				Ответ = "В базе знаний не найдено.";
			КонецЕсли;
		КонецЕсли;

		Длительность = (ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000;
		ЗаписьЖурналаРегистрации(
			"АИС.ОтветПоБазеЗнаний",
			УровеньЖурналаРегистрации.Информация,
			,
			,
			"Q&A: found=" + Найден + ", candidates=" + Кандидаты.Количество()
				+ ", ranked=" + Отсортированные.Количество()
				+ ", sources=" + Валидные.Количество()
				+ ", duration=" + Длительность + " c");
		Возврат Новый Структура(
			"Найден,Ответ,Источники,ОтветLLM,Ошибка",
			Найден,
			Ответ,
			Валидные,
			ОтветLLM,
			"");
	Исключение
		Длительность = (ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000;
		Ошибка = ОписаниеОшибки();
		ЗаписьЖурналаРегистрации(
			"АИС.ОтветПоБазеЗнаний",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Q&A: " + Ошибка + ", duration=" + Длительность + " c");
		Возврат Новый Структура(
			"Найден,Ответ,Источники,ОтветLLM,Ошибка",
			Ложь,
			"Не удалось получить ответ по базе знаний.",
			Новый Массив,
			ОтветLLM,
			Ошибка);
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПустойОтвет(Текст)
	Возврат Новый Структура(
		"Найден,Ответ,Источники,ОтветLLM,Ошибка",
		Ложь,
		Текст,
		Новый Массив,
		"",
		"");
КонецФункции

Функция КандидатыПоиска(РезультатПоиска)
	Кандидаты = Новый Массив;
	Индекс = 0;
	Для Каждого Результат Из РезультатПоиска.Результаты Цикл
		Заголовок = Строка(Результат.Заголовок);
		Если ПустаяСтрока(Заголовок) Тогда
			Заголовок = "Без названия";
		КонецЕсли;
		ДокТип = "";
		Если ТипЗнч(Результат.Метаданные) = Тип("Структура") Тогда
			ДокТип = Строка(АИС_ИнтеграцияСRAG.ЗначениеJSON(Результат.Метаданные, "doc_type"));
		КонецЕсли;
		Для Каждого Фрагмент Из Результат.Фрагменты Цикл
			Индекс = Индекс + 1;
			Кандидаты.Добавить(
				Новый Структура(
					"ИД,SourceID,Заголовок,ДокТип,Пункт,РазделТекст,Текст,Страница,Score",
					"К" + Индекс,
					Строка(Результат.ИсточникID),
					Заголовок,
					ДокТип,
					Строка(Фрагмент.Пункт),
					РазделТекст(Фрагмент.Раздел),
					Строка(Фрагмент.Текст),
					Фрагмент.СтраницаНачало,
					Результат.Score));
		КонецЦикла;
	КонецЦикла;
	Возврат Кандидаты;
КонецФункции

Функция РазделТекст(Раздел)
	Если ТипЗнч(Раздел) = Тип("Массив") Тогда
		Возврат СтрСоединить(Раздел, " → ");
	КонецЕсли;
	Возврат "";
КонецФункции

Функция РеранкКандидаты(Вопрос, Кандидаты)
	Попытка
		Параметры = ПараметрыПромптаПоИмени("РеранкФрагментов");
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписьJSON.ЗаписатьИмяСвойства("query");
		ЗаписьJSON.ЗаписатьЗначение(Вопрос);
		ЗаписьJSON.ЗаписатьИмяСвойства("candidates");
		ЗаписьJSON.ЗаписатьНачалоМассива();
		Для Каждого Кандидат Из Кандидаты Цикл
			ЗаписьJSON.ЗаписатьНачалоОбъекта();
			ЗаписьJSON.ЗаписатьИмяСвойства("id");
			ЗаписьJSON.ЗаписатьЗначение(Кандидат.ИД);
			ЗаписьJSON.ЗаписатьИмяСвойства("source_id");
			ЗаписьJSON.ЗаписатьЗначение(Кандидат.SourceID);
			ЗаписьJSON.ЗаписатьИмяСвойства("clause");
			ЗаписьJSON.ЗаписатьЗначение(Кандидат.Пункт);
			ЗаписьJSON.ЗаписатьИмяСвойства("title");
			ЗаписьJSON.ЗаписатьЗначение(Кандидат.Заголовок);
			ЗаписьJSON.ЗаписатьИмяСвойства("text");
			ЗаписьJSON.ЗаписатьЗначение(Кандидат.Текст);
			ЗаписьJSON.ЗаписатьКонецОбъекта();
		КонецЦикла;
		ЗаписьJSON.ЗаписатьКонецМассива();
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		ОтветLLM = АИС_ОбщегоНазначения.ВызватьИИ(
			Параметры.Текст,
			ЗаписьJSON.Закрыть(),
			Параметры.Модель,
			Параметры.Температура,
			Параметры.МаксимумТокенов);
		Данные = РазобратьJSON(ОтветLLM);
		Ранжирование = АИС_ИнтеграцияСRAG.ЗначениеJSON(Данные, "ranking");
		Если ТипЗнч(Ранжирование) <> Тип("Массив") Тогда
			Возврат Кандидаты;
		КонецЕсли;
		ПоИД = Новый Соответствие;
		Для Каждого Кандидат Из Кандидаты Цикл
			ПоИД.Вставить(Кандидат.ИД, Кандидат);
		КонецЦикла;
		Результат = Новый Массив;
		Использованные = Новый Соответствие;
		Для Каждого Элемент Из Ранжирование Цикл
			ИД = Строка(АИС_ИнтеграцияСRAG.ЗначениеJSON(Элемент, "id"));
			Кандидат = ПоИД.Получить(ИД);
			Если Кандидат <> Неопределено И Использованные.Получить(ИД) = Неопределено Тогда
				Результат.Добавить(Кандидат);
				Использованные.Вставить(ИД, Истина);
			КонецЕсли;
		КонецЦикла;
		Для Каждого Кандидат Из Кандидаты Цикл
			Если Использованные.Получить(Кандидат.ИД) = Неопределено Тогда
				Результат.Добавить(Кандидат);
			КонецЕсли;
		КонецЦикла;
		Если Результат.Количество() = 0 Тогда
			Возврат Кандидаты;
		КонецЕсли;
		Возврат Результат;
	Исключение
		ЗаписьЖурналаРегистрации(
			"АИС.ОтветПоБазеЗнаний",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			"Listwise-реранк недоступен, используется порядок RRF: " + ОписаниеОшибки());
		Возврат Кандидаты;
	КонецПопытки;
КонецФункции

Функция ПараметрыПромптаПоИмени(Имя)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	П.Текст КАК Текст,
		|	П.Версия КАК Версия,
		|	ПП.Модель КАК Модель,
		|	ПП.Температура КАК Температура,
		|	ПП.МаксимумТокенов КАК МаксимумТокенов
		|ИЗ
		|	Справочник.АИС_Промпты КАК П
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.АИС_ПромптПараметры КАК ПП
		|		ПО ПП.Промпт = П.Ссылка
		|ГДЕ
		|	П.Наименование = &Имя
		|	И П.Активность
		|УПОРЯДОЧИТЬ ПО
		|	ПП.Версия УБЫВ";
	Запрос.УстановитьПараметр("Имя", Имя);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение "Не найден активный промпт " + Имя;
	КонецЕсли;
	Модель = Выборка.Модель;
	Если ПустаяСтрока(Модель) Тогда
		Модель = Константы.АИС_МодельИИ.Получить();
	КонецЕсли;
	Возврат Новый Структура(
		"Текст,Модель,Температура,МаксимумТокенов,Версия",
		Выборка.Текст,
		Модель,
		Выборка.Температура,
		Выборка.МаксимумТокенов,
		Выборка.Версия);
КонецФункции

Функция РазобратьJSON(Ответ)
	Текст = СокрЛП(Ответ);
	Позиция = 1;
	Пока Позиция <= СтрДлина(Текст) И Сред(Текст, Позиция, 1) <> "{" Цикл
		Позиция = Позиция + 1;
	КонецЦикла;
	Если Позиция > СтрДлина(Текст) Тогда
		ВызватьИсключение "LLM не вернула JSON";
	КонецЕсли;
	Конец = СтрДлина(Текст);
	Пока Конец >= Позиция И Сред(Текст, Конец, 1) <> "}" Цикл
		Конец = Конец - 1;
	КонецЦикла;
	Если Конец < Позиция Тогда
		ВызватьИсключение "LLM вернула незавершённый JSON";
	КонецЕсли;
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Сред(Текст, Позиция, Конец - Позиция + 1));
	Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
	ЧтениеJSON.Закрыть();
	Возврат Данные;
КонецФункции

#КонецОбласти
