#Область ПрограммныйИнтерфейс

// Собирает cron-подобную строку расписания из полей элемента справочника.
// Поддерживаются: daily, weekly, monthly, quarterly и cron.
Функция СобратьРасписание(Расписание) Экспорт
	Результат = Новый Структура("Расписание,Ошибка", "", "");

	Если Не ЗначениеЗаполнено(Расписание.ДЛ) И Не ЗначениеЗаполнено(Расписание.Должность) Тогда
		Результат.Ошибка = "Укажите должностное лицо или должность.";
		Возврат Результат;
	КонецЕсли;

	Времена = РазобратьВремена(Расписание.ВремяЗапуска);
	Если Не ПустаяСтрока(Времена.Ошибка) Тогда
		Результат.Ошибка = Времена.Ошибка;
		Возврат Результат;
	КонецЕсли;
	ВремяСтрокой = ВременаВСтроку(Времена.Времена);

	Периодичность = Расписание.Периодичность;
	Если Периодичность = Перечисления.АИС_ВидыПериодичностиТриггеров.Ежедневно Тогда
		Результат.Расписание = "daily " + ВремяСтрокой;
	ИначеЕсли Периодичность = Перечисления.АИС_ВидыПериодичностиТриггеров.Еженедельно Тогда
		День = Расписание.ДеньНедели;
		Если День < 1 ИЛИ День > 7 Тогда
			Результат.Ошибка = "День недели должен быть от 1 (понедельник) до 7 (воскресенье).";
			Возврат Результат;
		КонецЕсли;
		Результат.Расписание = "weekly " + Формат(День, "ЧГ=0") + " " + ВремяСтрокой;
	ИначеЕсли Периодичность = Перечисления.АИС_ВидыПериодичностиТриггеров.Ежемесячно Тогда
		День = Расписание.ДеньМесяца;
		Если День < 0 ИЛИ День > 31 Тогда
			Результат.Ошибка = "День месяца должен быть от 1 до 31 (0 - последний день месяца).";
			Возврат Результат;
		КонецЕсли;
		Результат.Расписание = "monthly " + Формат(День, "ЧГ=0") + " " + ВремяСтрокой;
	ИначеЕсли Периодичность = Перечисления.АИС_ВидыПериодичностиТриггеров.Ежеквартально Тогда
		МесяцКвартала = Расписание.МесяцКвартала;
		День = Расписание.ДеньМесяца;
		Если МесяцКвартала < 1 ИЛИ МесяцКвартала > 3 Тогда
			Результат.Ошибка = "Месяц квартала должен быть от 1 до 3.";
			Возврат Результат;
		КонецЕсли;
		Если День < 0 ИЛИ День > 31 Тогда
			Результат.Ошибка = "День месяца должен быть от 1 до 31 (0 - последний день месяца).";
			Возврат Результат;
		КонецЕсли;
		Результат.Расписание = "quarterly " + Формат(МесяцКвартала, "ЧГ=0") + " "
			+ Формат(День, "ЧГ=0") + " " + ВремяСтрокой;
	ИначеЕсли Периодичность = Перечисления.АИС_ВидыПериодичностиТриггеров.Cron Тогда
		Cron = СокрЛП(Расписание.CronВыражение);
		Проверка = РазобратьCron(Cron);
		Если Не ПустаяСтрока(Проверка.Ошибка) Тогда
			Результат.Ошибка = Проверка.Ошибка;
			Возврат Результат;
		КонецЕсли;
		Результат.Расписание = "cron " + Cron;
	Иначе
		Результат.Ошибка = "Не выбрана периодичность.";
	КонецЕсли;

	Возврат Результат;
КонецФункции

// Возвращает ближайшую дату запуска после указанного момента.
// Неопределено - если расписание некорректно или запуск не найден.
Функция СледующийЗапуск(СтрокаРасписания, ПослеДаты = Неопределено) Экспорт
	Разбор = РазобратьВыражение(СтрокаРасписания);
	Если Не ПустаяСтрока(Разбор.Ошибка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	После = ?(ПослеДаты = Неопределено, ТекущаяДатаСеанса(), ПослеДаты);

	Если Разбор.Вид = "daily" Тогда
		Кандидат = СледующееВремяВДень(НачалоДня(После), Разбор.Времена, После);
		Если Кандидат <> Неопределено Тогда
			Возврат Кандидат;
		КонецЕсли;
		Возврат НачалоДня(После) + 86400 + Разбор.Времена[0] * 60;
	ИначеЕсли Разбор.Вид = "weekly" Тогда
		Сдвиг = (Разбор.ДеньНедели - ДеньНедели(После) + 7) % 7;
		База = НачалоДня(После) + Сдвиг * 86400;
		Кандидат = СледующееВремяВДень(База, Разбор.Времена, После);
		Если Кандидат <> Неопределено Тогда
			Возврат Кандидат;
		КонецЕсли;
		Возврат База + 7 * 86400 + Разбор.Времена[0] * 60;
	ИначеЕсли Разбор.Вид = "monthly" Тогда
		Для Смещение = 0 По 24 Цикл
			НачалоМесяцаДата = НачалоМесяца(ДобавитьМесяц(После, Смещение));
			Кандидат = КандидатВМесяце(НачалоМесяцаДата, Разбор.ДеньМесяца, Разбор.Времена, После);
			Если Кандидат <> Неопределено Тогда
				Возврат Кандидат;
			КонецЕсли;
		КонецЦикла;
		Возврат Неопределено;
	ИначеЕсли Разбор.Вид = "quarterly" Тогда
		Для Смещение = 0 По 15 Цикл
			НачалоМесяцаДата = НачалоМесяца(ДобавитьМесяц(После, Смещение));
			МесяцВКвартале = ((Месяц(НачалоМесяцаДата) - 1) % 3) + 1;
			Если МесяцВКвартале <> Разбор.МесяцКвартала Тогда
				Продолжить;
			КонецЕсли;
			Кандидат = КандидатВМесяце(НачалоМесяцаДата, Разбор.ДеньМесяца, Разбор.Времена, После);
			Если Кандидат <> Неопределено Тогда
				Возврат Кандидат;
			КонецЕсли;
		КонецЦикла;
		Возврат Неопределено;
	ИначеЕсли Разбор.Вид = "cron" Тогда
		Возврат СледующийЗапускCron(Разбор, После);
	КонецЕсли;

	Возврат Неопределено;
КонецФункции

// Разбирает cron-подобную строку. Возвращает структуру с полями:
// Вид, Времена (минуты от начала дня), ДеньНедели, ДеньМесяца,
// МесяцКвартала, Минуты, Часы, Дни, Месяцы, ДниНедели, Ошибка.
Функция РазобратьВыражение(СтрокаРасписания) Экспорт
	Результат = Новый Структура(
		"Вид,Времена,ДеньНедели,ДеньМесяца,МесяцКвартала,Минуты,Часы,Дни,Месяцы,ДниНедели,ДеньМесяцаЛюбой,ДеньНеделиЛюбой,Ошибка",
		"", Новый Массив, 0, 0, 0, Новый Массив, Новый Массив, Новый Массив, Новый Массив, Новый Массив, Ложь, Ложь, "");
	Текст = СокрЛП(СтрокаРасписания);
	Если ПустаяСтрока(Текст) Тогда
		Результат.Ошибка = "Расписание не заполнено.";
		Возврат Результат;
	КонецЕсли;

	Части = СтрРазделить(Текст, " ", Ложь);
	Вид = НРег(Части[0]);
	Результат.Вид = Вид;

	Если Вид = "daily" Тогда
		Если Части.Количество() < 2 Тогда
			Результат.Ошибка = "Для daily укажите время, например: daily 09:30,14:00.";
			Возврат Результат;
		КонецЕсли;
		Времена = РазобратьВремена(Части[1]);
		Если Не ПустаяСтрока(Времена.Ошибка) Тогда
			Результат.Ошибка = Времена.Ошибка;
			Возврат Результат;
		КонецЕсли;
		Результат.Времена = Времена.Времена;
	ИначеЕсли Вид = "weekly" Тогда
		Если Части.Количество() < 3 Тогда
			Результат.Ошибка = "Для weekly укажите день недели и время, например: weekly 5 09:30.";
			Возврат Результат;
		КонецЕсли;
		День = ЧислоИзСтроки(Части[1]);
		Если День = Неопределено ИЛИ День < 1 ИЛИ День > 7 Тогда
			Результат.Ошибка = "День недели должен быть от 1 (понедельник) до 7 (воскресенье).";
			Возврат Результат;
		КонецЕсли;
		Времена = РазобратьВремена(Части[2]);
		Если Не ПустаяСтрока(Времена.Ошибка) Тогда
			Результат.Ошибка = Времена.Ошибка;
			Возврат Результат;
		КонецЕсли;
		Результат.ДеньНедели = День;
		Результат.Времена = Времена.Времена;
	ИначеЕсли Вид = "monthly" Тогда
		Если Части.Количество() < 3 Тогда
			Результат.Ошибка = "Для monthly укажите день месяца и время, например: monthly 15 09:30.";
			Возврат Результат;
		КонецЕсли;
		День = ЧислоИзСтроки(Части[1]);
		Если День = Неопределено ИЛИ День < 0 ИЛИ День > 31 Тогда
			Результат.Ошибка = "День месяца должен быть от 1 до 31 (0 - последний день месяца).";
			Возврат Результат;
		КонецЕсли;
		Времена = РазобратьВремена(Части[2]);
		Если Не ПустаяСтрока(Времена.Ошибка) Тогда
			Результат.Ошибка = Времена.Ошибка;
			Возврат Результат;
		КонецЕсли;
		Результат.ДеньМесяца = День;
		Результат.Времена = Времена.Времена;
	ИначеЕсли Вид = "quarterly" Тогда
		Если Части.Количество() < 4 Тогда
			Результат.Ошибка = "Для quarterly укажите месяц квартала, день и время, например: quarterly 2 15 09:30.";
			Возврат Результат;
		КонецЕсли;
		МесяцКвартала = ЧислоИзСтроки(Части[1]);
		День = ЧислоИзСтроки(Части[2]);
		Если МесяцКвартала = Неопределено ИЛИ МесяцКвартала < 1 ИЛИ МесяцКвартала > 3 Тогда
			Результат.Ошибка = "Месяц квартала должен быть от 1 до 3.";
			Возврат Результат;
		КонецЕсли;
		Если День = Неопределено ИЛИ День < 0 ИЛИ День > 31 Тогда
			Результат.Ошибка = "День месяца должен быть от 1 до 31 (0 - последний день месяца).";
			Возврат Результат;
		КонецЕсли;
		Времена = РазобратьВремена(Части[3]);
		Если Не ПустаяСтрока(Времена.Ошибка) Тогда
			Результат.Ошибка = Времена.Ошибка;
			Возврат Результат;
		КонецЕсли;
		Результат.МесяцКвартала = МесяцКвартала;
		Результат.ДеньМесяца = День;
		Результат.Времена = Времена.Времена;
	ИначеЕсли Вид = "cron" Тогда
		Если Части.Количество() < 6 Тогда
			Результат.Ошибка = "Для cron укажите 5 полей, например: cron 30 9 * * *.";
			Возврат Результат;
		КонецЕсли;
		Cron = "";
		Для Индекс = 1 По Части.Количество() - 1 Цикл
			Cron = Cron + ?(ПустаяСтрока(Cron), "", " ") + Части[Индекс];
		КонецЦикла;
		Проверка = РазобратьCron(Cron);
		Если Не ПустаяСтрока(Проверка.Ошибка) Тогда
			Результат.Ошибка = Проверка.Ошибка;
			Возврат Результат;
		КонецЕсли;
		Результат.Минуты = Проверка.Минуты;
		Результат.Часы = Проверка.Часы;
		Результат.Дни = Проверка.Дни;
		Результат.Месяцы = Проверка.Месяцы;
		Результат.ДниНедели = Проверка.ДниНедели;
		Результат.ДеньМесяцаЛюбой = Проверка.ДеньМесяцаЛюбой;
		Результат.ДеньНеделиЛюбой = Проверка.ДеньНеделиЛюбой;
	Иначе
		Результат.Ошибка = "Неизвестный вид расписания: " + Вид
			+ ". Допустимо: daily, weekly, monthly, quarterly, cron.";
	КонецЕсли;

	Возврат Результат;
КонецФункции

// Разбирает cron-выражение из 5 полей: минуты, часы, день месяца,
// месяц, день недели (0 или 7 - воскресенье).
Функция РазобратьCron(Выражение) Экспорт
	Результат = Новый Структура(
		"Минуты,Часы,Дни,Месяцы,ДниНедели,ДеньМесяцаЛюбой,ДеньНеделиЛюбой,Ошибка",
		Новый Массив, Новый Массив, Новый Массив, Новый Массив, Новый Массив, Ложь, Ложь, "");
	Поля = СтрРазделить(СокрЛП(Выражение), " ", Ложь);
	Если Поля.Количество() <> 5 Тогда
		Результат.Ошибка = "Cron-выражение должно содержать 5 полей.";
		Возврат Результат;
	КонецЕсли;

	Минуты = РазобратьCronПоле(Поля[0], 0, 59, "минуты");
	Часы = РазобратьCronПоле(Поля[1], 0, 23, "часы");
	Дни = РазобратьCronПоле(Поля[2], 1, 31, "день месяца");
	Месяцы = РазобратьCronПоле(Поля[3], 1, 12, "месяц");
	ДниНеделиПоле = РазобратьCronПоле(Поля[4], 0, 7, "день недели");

	Если Не ПустаяСтрока(Минуты.Ошибка) Тогда
		Результат.Ошибка = Минуты.Ошибка;
		Возврат Результат;
	ИначеЕсли Не ПустаяСтрока(Часы.Ошибка) Тогда
		Результат.Ошибка = Часы.Ошибка;
		Возврат Результат;
	ИначеЕсли Не ПустаяСтрока(Дни.Ошибка) Тогда
		Результат.Ошибка = Дни.Ошибка;
		Возврат Результат;
	ИначеЕсли Не ПустаяСтрока(Месяцы.Ошибка) Тогда
		Результат.Ошибка = Месяцы.Ошибка;
		Возврат Результат;
	ИначеЕсли Не ПустаяСтрока(ДниНеделиПоле.Ошибка) Тогда
		Результат.Ошибка = ДниНеделиПоле.Ошибка;
		Возврат Результат;
	КонецЕсли;

	ДниНедели = Новый Массив;
	Для Каждого День Из ДниНеделиПоле.Значения Цикл
		Нормализованный = ?(День = 7, 0, День);
		Если ДниНедели.Найти(Нормализованный) = Неопределено Тогда
			ДниНедели.Добавить(Нормализованный);
		КонецЕсли;
	КонецЦикла;

	Результат.Минуты = Минуты.Значения;
	Результат.Часы = Часы.Значения;
	Результат.Дни = Дни.Значения;
	Результат.Месяцы = Месяцы.Значения;
	Результат.ДниНедели = ОтсортироватьЧисла(ДниНедели);
	Результат.ДеньМесяцаЛюбой = (СокрЛП(Поля[2]) = "*");
	Результат.ДеньНеделиЛюбой = (СокрЛП(Поля[4]) = "*");
	Возврат Результат;
КонецФункции

// Выполняет все наступившие таймеры: создаёт задачи и сдвигает
// СледующийЗапуск. Вызывается регламентным заданием.
Процедура ВыполнитьТаймеры() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Сейчас = ТекущаяДатаСеанса();

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Сейчас", Сейчас);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Расписания.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.АИС_РасписаниеТриггеров КАК Расписания
		|ГДЕ
		|	Расписания.Активность = ИСТИНА
		|	И Расписания.СледующийЗапуск <= &Сейчас
		|	И НЕ Расписания.СледующийЗапуск = ДАТАВРЕМЯ(1, 1, 1)
		|УПОРЯДОЧИТЬ ПО
		|	Расписания.СледующийЗапуск";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			ОбработатьРасписание(Выборка.Ссылка, Сейчас);
		Исключение
			ЗаписьЖурналаРегистрации(
				"АИС.РасписанияТриггеров",
				УровеньЖурналаРегистрации.Ошибка,
				,
				Выборка.Ссылка,
				"Не удалось обработать таймер: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

// Формирует текст промпта реакции по описанию триггера и должностным
// обязанностям. Если LLM недоступна, возвращает шаблон.
Функция СгенерироватьПромптРеакции(Расписание) Экспорт
	Описание = ?(Не ПустаяСтрока(Расписание.ОписаниеТриггера),
		Расписание.ОписаниеТриггера, Расписание.Наименование);
	Должность = ДолжностьРасписания(Расписание);
	Обязанности = ТекстОбязанностей(Расписание, Должность);
	РольПромпт = "";
	Если ЗначениеЗаполнено(Расписание.ДЛ) Тогда
		Настройка = АИС_АгентИИ.НайтиПоСотруднику(Расписание.ДЛ);
		Если ЗначениеЗаполнено(Настройка) Тогда
			ОбъектНастройки = Настройка.ПолучитьОбъект();
			Если ОбъектНастройки <> Неопределено Тогда
				РольПромпт = ОбъектНастройки.РольПромпт;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	СистемныйПромпт =
		"Ты - методист ИИ-агента в системе документооборота. "
		+ "По описанию периодического триггера и должностным обязанностям сформируй "
		+ "готовый промпт реакции ИИ-агента. Промпт должен: начинаться с действия; "
		+ "указывать, какие данные собрать и проанализировать; задавать структуру результата; "
		+ "требовать ссылки на документы и задачи; запрещать выдумывание данных; "
		+ "учитывать срок и формат результата. Верни только текст промпта, без пояснений.";
	ПользовательскийПромпт =
		"Наименование триггера: " + Расписание.Наименование + Символы.ПС
		+ "Описание триггера: " + Описание + Символы.ПС
		+ "Расписание: " + Расписание.Расписание + Символы.ПС
		+ "Должность: " + ?(ЗначениеЗаполнено(Должность), Строка(Должность), "не указана") + Символы.ПС
		+ "Должностные обязанности:" + Символы.ПС + Обязанности + Символы.ПС
		+ "Роль-промпт агента:" + Символы.ПС
		+ ?(ПустаяСтрока(РольПромпт), "не задан", Лев(РольПромпт, 6000)) + Символы.ПС
		+ "Сформируй промпт реакции на этот триггер. Срок исполнения: "
		+ Формат(Расписание.СрокИсполненияМинут, "ЧГ=0") + " минут после запуска.";

	Попытка
		Текст = АИС_ОбщегоНазначения.ВызватьИИ(СистемныйПромпт, ПользовательскийПромпт,
			Неопределено, 0.2, 2500);
	Исключение
		ЗаписьЖурналаРегистрации(
			"АИС.РасписанияТриггеров",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			Расписание.Ссылка,
			"Не удалось сгенерировать промпт через LLM, использован шаблон: " + ОписаниеОшибки());
		Текст = "";
	КонецПопытки;

	Если ПустаяСтрока(Текст) Тогда
		Текст = ШаблонПромпта(Расписание, Описание, Должность, Обязанности, РольПромпт);
	КонецЕсли;

	Возврат СокрЛП(Текст);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбработатьРасписание(Ссылка, Сейчас)
	НачатьТранзакцию();
	Попытка
		Объект = Ссылка.ПолучитьОбъект();
		Если Объект <> Неопределено И Объект.Активность Тогда
			Объект.Заблокировать();
			Если Объект.СледующийЗапуск <= Сейчас Тогда
				ВремяЗапуска = Объект.СледующийЗапуск;

				Получатели = ПолучателиРасписания(Объект);
				Если Получатели.Количество() = 0 Тогда
					ЗаписьЖурналаРегистрации(
						"АИС.РасписанияТриггеров",
						УровеньЖурналаРегистрации.Предупреждение,
						,
						Ссылка,
						"Для таймера не найден ни один получатель.");
				КонецЕсли;

				Для Каждого Получатель Из Получатели Цикл
					Попытка
						СоздатьЗадачуПоТаймеру(Объект, Получатель, ВремяЗапуска);
					Исключение
						ЗаписьЖурналаРегистрации(
							"АИС.РасписанияТриггеров",
							УровеньЖурналаРегистрации.Ошибка,
							,
							Ссылка,
							"Не удалось создать задачу по таймеру для "
								+ Строка(Получатель) + ": " + ОписаниеОшибки());
					КонецПопытки;
				КонецЦикла;

				Следующий = СледующийЗапуск(Объект.Расписание, ВремяЗапуска);
				Если Следующий = Неопределено Тогда
					Объект.Активность = Ложь;
					Объект.СледующийЗапуск = '00010101';
					ЗаписьЖурналаРегистрации(
						"АИС.РасписанияТриггеров",
						УровеньЖурналаРегистрации.Ошибка,
						,
						Ссылка,
						"Не удалось рассчитать следующий запуск. Таймер выключен: " + Объект.Расписание);
				Иначе
					Объект.СледующийЗапуск = Следующий;
				КонецЕсли;
				// СледующийЗапуск уже рассчитан от времени наступившего
				// запуска, а не от текущего момента: при задержке задания
				// пересчёт в ПередЗаписью пропустил бы промежуточные
				// запуски (например, второй запуск в тот же день).
				Объект.ОбменДанными.Загрузка = Истина;
				Объект.Записать();
			КонецЕсли;
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
КонецПроцедуры

Процедура СоздатьЗадачуПоТаймеру(Расписание, Получатель, ВремяЗапуска)
	Описание = ?(Не ПустаяСтрока(Расписание.ПромптРеакции),
		Расписание.ПромптРеакции, ТекстЗадачиПоТриггеру(Расписание));
	Тема = Расписание.Наименование + " - " + Формат(ВремяЗапуска, "ДФ=dd.MM.yyyy HH:mm");
	Срок = ВремяЗапуска + Расписание.СрокИсполненияМинут * 60;
	Автор = ?(ЗначениеЗаполнено(Расписание.Автор), Расписание.Автор, Получатель);
	Ключ = "АИС_Таймер:" + Строка(Расписание.Ссылка.УникальныйИдентификатор())
		+ ":" + Формат(ВремяЗапуска, "ДФ=yyyyMMddHHmm");

	Задача = АИС_ОбщегоНазначения.НайтиИлиСоздатьЗадачу(
		Получатель, Тема, Описание, Автор, Расписание.Распоряжение, Ключ);

	АИС_АгентИИ.ОбеспечитьНастройкиАгента(Получатель);
	ТипТриггера = ?(ЗначениеЗаполнено(Расписание.ТипТриггера),
		Расписание.ТипТриггера, АИС_ОбщегоНазначения.НайтиИлиСоздатьТипТриггера("Таймер"));
	ТипДействия = АИС_ОбщегоНазначения.НайтиИлиСоздатьТипДействия(
		"ИсполнитьЗадачу", Перечисления.ТипыОбъектов.ВнутренниеДокументы);
	АИС_ОбщегоНазначения.СохранитьКонтекстЗадачи(
		Задача, ТипТриггера, ТипДействия, Новый Массив);
	Запуск = АИС_АгентИИ.ПоставитьЗадачуВОчередь(Задача, "Таймер");
	Если Не ЗначениеЗаполнено(Запуск) Тогда
		ЗаписьЖурналаРегистрации(
			"АИС.РасписанияТриггеров",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			Задача,
			"Задача по таймеру создана, но ИИ-агент не запущен: агент выключен "
				+ "или не заполнен роль-промпт.");
	КонецЕсли;
КонецПроцедуры

Функция ПолучателиРасписания(Расписание)
	Результат = Новый Массив;
	Если ЗначениеЗаполнено(Расписание.ДЛ) Тогда
		Результат.Добавить(Расписание.ДЛ);
		Возврат Результат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Расписание.Должность) Тогда
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Должность", Расписание.Должность);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Сведения.Пользователь КАК Пользователь
		|ИЗ
		|	РегистрСведений.СведенияОПользователяхДокументооборот КАК Сведения
		|ГДЕ
		|	Сведения.Должность = &Должность
		|	И НЕ Сведения.Пользователь.ПометкаУдаления
		|	И НЕ Сведения.Пользователь.Недействителен
		|УПОРЯДОЧИТЬ ПО
		|	Сведения.Пользователь";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.Пользователь);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ДолжностьРасписания(Расписание)
	Если ЗначениеЗаполнено(Расписание.Должность) Тогда
		Возврат Расписание.Должность;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Расписание.ДЛ) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Пользователь", Расписание.ДЛ);
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Сведения.Должность КАК Должность
		|ИЗ
		|	РегистрСведений.СведенияОПользователяхДокументооборот КАК Сведения
		|ГДЕ
		|	Сведения.Пользователь = &Пользователь
		|УПОРЯДОЧИТЬ ПО
		|	Сведения.Должность";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Должность;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ТекстОбязанностей(Расписание, Должность)
	Части = Новый Массив;
	Если ЗначениеЗаполнено(Расписание.ПравилоМаршрутизации) Тогда
		Правило = Расписание.ПравилоМаршрутизации.ПолучитьОбъект();
		Если Правило <> Неопределено И Не ПустаяСтрока(Правило.Текст) Тогда
			Части.Добавить(Правило.Наименование + ": " + Правило.Текст);
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(Должность) Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Должность", Должность);
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Правила.Наименование КАК Наименование,
			|	Правила.Текст КАК Текст
			|ИЗ
			|	Справочник.АИС_ДолжностныеОбязанности КАК Правила
			|ГДЕ
			|	Правила.Должность = &Должность
			|	И Правила.Активность = ИСТИНА
			|	И НЕ Правила.ПометкаУдаления
			|УПОРЯДОЧИТЬ ПО
			|	Правила.Приоритет УБЫВ";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Не ПустаяСтрока(Выборка.Текст) Тогда
				Части.Добавить(Выборка.Наименование + ": " + Выборка.Текст);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Части.Количество() = 0 Тогда
		Возврат "Должностные обязанности не заданы; используй роль-промпт агента.";
	КонецЕсли;
	Возврат СтрСоединить(Части, Символы.ПС);
КонецФункции

Функция ТекстЗадачиПоТриггеру(Расписание)
	Описание = ?(Не ПустаяСтрока(Расписание.ОписаниеТриггера),
		Расписание.ОписаниеТриггера, Расписание.Наименование);
	Возврат "Периодический триггер: " + Расписание.Наименование + "." + Символы.ПС
		+ Описание + Символы.ПС
		+ "Расписание: " + Расписание.Расписание + "." + Символы.ПС
		+ "Подготовь реакцию на триггер в рамках своих должностных обязанностей. "
		+ "Результат оформи текстом в задаче; если нужен документ - создай его "
		+ "и адресуй автору. Не выдумывай данные: используй доступные документы, "
		+ "задачи, поручения и базу знаний.";
КонецФункции

Функция ШаблонПромпта(Расписание, Описание, Должность, Обязанности, РольПромпт)
	Возврат "Ты - " + ?(ЗначениеЗаполнено(Должность), Строка(Должность), "должностное лицо")
		+ ". Наступил периодический триггер «" + Расписание.Наименование + "»." + Символы.ПС
		+ Описание + Символы.ПС
		+ "Твои должностные обязанности:" + Символы.ПС + Обязанности + Символы.ПС
		+ ?(ПустаяСтрока(РольПромпт), "", "Роль-промпт агента:" + Символы.ПС + Лев(РольПромпт, 6000) + Символы.ПС)
		+ "Подготовь реакцию:" + Символы.ПС
		+ "1. Собери события и данные за период с предыдущего запуска по текущий момент, "
		+ "относящиеся к твоей компетенции." + Символы.ПС
		+ "2. Опиши предпринятые действия, текущие проблемы и риски." + Символы.ПС
		+ "3. Сформулируй планы на следующий период." + Символы.ПС
		+ "4. Укажи ссылки на документы и задачи; не выдумывай отсутствующие данные."
КонецФункции

Функция КандидатВМесяце(НачалоМесяцаДата, ДеньМесяца, Времена, После)
	ДлинаМесяца = День(КонецМесяца(НачалоМесяцаДата));
	День = ?(ДеньМесяца = 0, ДлинаМесяца, Мин(ДеньМесяца, ДлинаМесяца));
	База = НачалоМесяцаДата + (День - 1) * 86400;
	Возврат СледующееВремяВДень(База, Времена, После);
КонецФункции

Функция СледующееВремяВДень(База, Времена, После)
	Для Каждого Минута Из Времена Цикл
		Кандидат = База + Минута * 60;
		Если Кандидат > После Тогда
			Возврат Кандидат;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция СледующийЗапускCron(Разбор, После)
	НачалоДняПосле = НачалоДня(После);
	Для Смещение = 0 По 366 Цикл
		ДеньДата = НачалоДняПосле + Смещение * 86400;
		Если Разбор.Месяцы.Найти(Месяц(ДеньДата)) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СовпадениеПоДнюМесяца = Разбор.Дни.Найти(День(ДеньДата)) <> Неопределено;
		СовпадениеПоДнюНедели = Разбор.ДниНедели.Найти(ДеньНедели(ДеньДата) % 7) <> Неопределено;
		Если Разбор.ДеньМесяцаЛюбой И Разбор.ДеньНеделиЛюбой Тогда
			Совпадение = Истина;
		ИначеЕсли Разбор.ДеньМесяцаЛюбой Тогда
			Совпадение = СовпадениеПоДнюНедели;
		ИначеЕсли Разбор.ДеньНеделиЛюбой Тогда
			Совпадение = СовпадениеПоДнюМесяца;
		Иначе
			Совпадение = СовпадениеПоДнюМесяца ИЛИ СовпадениеПоДнюНедели;
		КонецЕсли;
		Если Не Совпадение Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Час Из Разбор.Часы Цикл
			Для Каждого Минута Из Разбор.Минуты Цикл
				Кандидат = ДеньДата + Час * 3600 + Минута * 60;
				Если Кандидат > После Тогда
					Возврат Кандидат;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция РазобратьВремена(Строка)
	Результат = Новый Структура("Времена,Ошибка", Новый Массив, "");
	Если ПустаяСтрока(СокрЛП(Строка)) Тогда
		Результат.Ошибка = "Укажите время запуска в формате ЧЧ:ММ.";
		Возврат Результат;
	КонецЕсли;
	Части = СтрРазделить(Строка, ",", Ложь);
	Для Каждого Часть Из Части Цикл
		Элементы = СтрРазделить(СокрЛП(Часть), ":", Ложь);
		Если Элементы.Количество() <> 2 Тогда
			Результат.Ошибка = "Время должно быть в формате ЧЧ:ММ: " + Часть;
			Возврат Результат;
		КонецЕсли;
		Если Не ЭтоДесятичноеЧисло(Элементы[0]) ИЛИ Не ЭтоДесятичноеЧисло(Элементы[1]) Тогда
			Результат.Ошибка = "Время должно содержать только цифры: " + Часть;
			Возврат Результат;
		КонецЕсли;
		Час = Число(Элементы[0]);
		Минута = Число(Элементы[1]);
		Если Час < 0 ИЛИ Час > 23 ИЛИ Минута < 0 ИЛИ Минута > 59 Тогда
			Результат.Ошибка = "Недопустимое время: " + Часть;
			Возврат Результат;
		КонецЕсли;
		Значение = Час * 60 + Минута;
		Если Результат.Времена.Найти(Значение) = Неопределено Тогда
			Результат.Времена.Добавить(Значение);
		КонецЕсли;
	КонецЦикла;
	Результат.Времена = ОтсортироватьЧисла(Результат.Времена);
	Возврат Результат;
КонецФункции

Функция ВременаВСтроку(Времена) Экспорт
	Части = Новый Массив;
	Для Каждого Значение Из Времена Цикл
		Час = Цел(Значение / 60);
		Минута = Значение - Час * 60;
		Части.Добавить(Двузначное(Час) + ":" + Двузначное(Минута));
	КонецЦикла;
	Возврат СтрСоединить(Части, ",");
КонецФункции

Функция РазобратьCronПоле(Поле, Минимум, Максимум, ИмяПоля)
	Результат = Новый Структура("Значения,Ошибка", Новый Массив, "");
	Части = СтрРазделить(СокрЛП(Поле), ",", Ложь);
	Если Части.Количество() = 0 Тогда
		Результат.Ошибка = "Пустое поле cron: " + ИмяПоля;
		Возврат Результат;
	КонецЕсли;
	Для Каждого Часть Из Части Цикл
		ЗначениеПоля = СокрЛП(Часть);
		Шаг = 1;
		ПозицияШага = СтрНайти(ЗначениеПоля, "/");
		Если ПозицияШага > 0 Тогда
			ШагСтрокой = Сред(ЗначениеПоля, ПозицияШага + 1);
			ЗначениеПоля = Лев(ЗначениеПоля, ПозицияШага - 1);
			Если Не ЭтоДесятичноеЧисло(ШагСтрокой) Тогда
				Результат.Ошибка = "Некорректный шаг cron в поле " + ИмяПоля + ": " + Часть;
				Возврат Результат;
			КонецЕсли;
			Шаг = Число(ШагСтрокой);
			Если Шаг < 1 Тогда
				Результат.Ошибка = "Шаг cron должен быть больше нуля: " + Часть;
				Возврат Результат;
			КонецЕсли;
		КонецЕсли;

		Если ЗначениеПоля = "*" Тогда
			Начало = Минимум;
			Конец = Максимум;
		ИначеЕсли СтрНайти(ЗначениеПоля, "-") > 0 Тогда
			Границы = СтрРазделить(ЗначениеПоля, "-", Ложь);
			Если Границы.Количество() <> 2
				ИЛИ Не ЭтоДесятичноеЧисло(Границы[0])
				ИЛИ Не ЭтоДесятичноеЧисло(Границы[1]) Тогда
				Результат.Ошибка = "Некорректный диапазон cron в поле " + ИмяПоля + ": " + Часть;
				Возврат Результат;
			КонецЕсли;
			Начало = Число(Границы[0]);
			Конец = Число(Границы[1]);
		Иначе
			Если Не ЭтоДесятичноеЧисло(ЗначениеПоля) Тогда
				Результат.Ошибка = "Некорректное значение cron в поле " + ИмяПоля + ": " + Часть;
				Возврат Результат;
			КонецЕсли;
			Начало = Число(ЗначениеПоля);
			Конец = Начало;
		КонецЕсли;

		Если Начало < Минимум ИЛИ Конец > Максимум ИЛИ Начало > Конец Тогда
			Результат.Ошибка = "Значение cron вне диапазона " + Формат(Минимум, "ЧГ=0")
				+ "-" + Формат(Максимум, "ЧГ=0") + " в поле " + ИмяПоля + ": " + Часть;
			Возврат Результат;
		КонецЕсли;

		Значение = Начало;
		Пока Значение <= Конец Цикл
			Если Результат.Значения.Найти(Значение) = Неопределено Тогда
				Результат.Значения.Добавить(Значение);
			КонецЕсли;
			Значение = Значение + Шаг;
		КонецЦикла;
	КонецЦикла;
	Результат.Значения = ОтсортироватьЧисла(Результат.Значения);
	Возврат Результат;
КонецФункции

Функция ЧислоИзСтроки(Значение)
	Если Не ЭтоДесятичноеЧисло(СокрЛП(Значение)) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Число(СокрЛП(Значение));
КонецФункции

Функция ЭтоДесятичноеЧисло(Значение)
	Если ПустаяСтрока(Значение) Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Индекс = 1 По СтрДлина(Значение) Цикл
		Если СтрНайти("0123456789", Сред(Значение, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция Двузначное(Значение)
	Возврат Прав("0" + Формат(Значение, "ЧГ=0"), 2);
КонецФункции

Функция ОтсортироватьЧисла(Значения)
	Результат = Новый Массив;
	Для Каждого Значение Из Значения Цикл
		Позиция = Результат.Количество();
		Для Индекс = 0 По Результат.Количество() - 1 Цикл
			Если Значение < Результат[Индекс] Тогда
				Позиция = Индекс;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Результат.Вставить(Позиция, Значение);
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти
