#Область ПрограммныйИнтерфейс

// Политика типа рассылки. Тип — шаблон, а не жёстко зашитая ветка.
Функция ПолитикаТипа(ТипИмя) Экспорт
	Имя = НРег(СокрЛП(Строка(ТипИмя)));
	П = Новый Структура;
	Если Имя = "rfq" ИЛИ Имя = "запрос кп" ИЛИ Имя = "запрос коммерческих предложений" Тогда
		П.Вставить("type", "RFQ");
		П.Вставить("expects_response", Истина);
		П.Вставить("compare", Истина);
		П.Вставить("min_responses", 2);
		П.Вставить("target_quorum", 3);
		П.Вставить("wait_all", Ложь);
		П.Вставить("allow_early_analysis", Истина);
		П.Вставить("open_before_deadline", Истина);
		П.Вставить("late_policy", "before_decision");
		П.Вставить("completion_rule", "quorum");
		П.Вставить("response_days", 3);
		П.Вставить("reminder_days", 2);
		П.Вставить("escalation_days", 5);
	ИначеЕсли Имя = "запрос документов" ИЛИ Имя = "document_request" Тогда
		П.Вставить("type", "DocumentRequest");
		П.Вставить("expects_response", Истина);
		П.Вставить("compare", Ложь);
		П.Вставить("min_responses", 1);
		П.Вставить("target_quorum", 1);
		П.Вставить("wait_all", Истина);
		П.Вставить("allow_early_analysis", Ложь);
		П.Вставить("open_before_deadline", Истина);
		П.Вставить("late_policy", "always");
		П.Вставить("completion_rule", "all");
		П.Вставить("response_days", 3);
		П.Вставить("reminder_days", 2);
		П.Вставить("escalation_days", 5);
	ИначеЕсли Имя = "согласование" ИЛИ Имя = "approval" Тогда
		П.Вставить("type", "Approval");
		П.Вставить("expects_response", Истина);
		П.Вставить("compare", Ложь);
		П.Вставить("min_responses", 1);
		П.Вставить("target_quorum", 1);
		П.Вставить("wait_all", Ложь);
		П.Вставить("allow_early_analysis", Ложь);
		П.Вставить("open_before_deadline", Истина);
		П.Вставить("late_policy", "before_decision");
		П.Вставить("completion_rule", "quorum");
		П.Вставить("response_days", 3);
		П.Вставить("reminder_days", 2);
		П.Вставить("escalation_days", 5);
	ИначеЕсли Имя = "тендер" ИЛИ Имя = "tender" Тогда
		П.Вставить("type", "Tender");
		П.Вставить("expects_response", Истина);
		П.Вставить("compare", Истина);
		П.Вставить("min_responses", 3);
		П.Вставить("target_quorum", 3);
		П.Вставить("wait_all", Ложь);
		П.Вставить("allow_early_analysis", Ложь);
		П.Вставить("open_before_deadline", Ложь);
		П.Вставить("late_policy", "reject");
		П.Вставить("completion_rule", "deadline");
		П.Вставить("response_days", 5);
		П.Вставить("reminder_days", 3);
		П.Вставить("escalation_days", 7);
	ИначеЕсли Имя = "уведомление" ИЛИ Имя = "notification" Тогда
		П.Вставить("type", "Notification");
		П.Вставить("expects_response", Ложь);
		П.Вставить("compare", Ложь);
		П.Вставить("min_responses", 0);
		П.Вставить("target_quorum", 0);
		П.Вставить("wait_all", Ложь);
		П.Вставить("allow_early_analysis", Ложь);
		П.Вставить("open_before_deadline", Истина);
		П.Вставить("late_policy", "always");
		П.Вставить("completion_rule", "deadline");
		П.Вставить("response_days", 0);
		П.Вставить("reminder_days", 0);
		П.Вставить("escalation_days", 0);
	Иначе
		Возврат ПолитикаТипа("RFQ");
	КонецЕсли;
	Возврат П;
КонецФункции

Функция ПолитикаСтрокой(Политика)
	Возврат АИС_КлиентВнешнегоСервиса.ЗаписатьJSONСтрокой(Политика);
КонецФункции

Функция ОбеспечитьТип(ТипИмя) Экспорт
	Имя = СокрЛП(Строка(ТипИмя));
	Если ПустаяСтрока(Имя) Тогда
		Имя = "Запрос КП";
	КонецЕсли;
	Ссылка = Справочники.АИС_ТипыРассылок.НайтиПоНаименованию(Имя, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Объект = Ссылка.ПолучитьОбъект();
	Иначе
		Объект = Справочники.АИС_ТипыРассылок.СоздатьЭлемент();
		Объект.Наименование = Имя;
	КонецЕсли;
	Если ПустаяСтрока(Объект.ПолитикаJSON) Тогда
		Объект.ПолитикаJSON = ПолитикаСтрокой(ПолитикаТипа(Имя));
	КонецЕсли;
	Объект.Записать();
	Возврат Объект.Ссылка;
КонецФункции

Функция ПолитикаРассылки(Рассылка) Экспорт
	Объект = Рассылка.ПолучитьОбъект();
	Если Объект = Неопределено ИЛИ ПустаяСтрока(Объект.ПолитикаJSON) Тогда
		Возврат ПолитикаТипа("Запрос КП");
	КонецЕсли;
	Возврат АИС_КлиентВнешнегоСервиса.ПрочитатьJSONИзСтроки(Объект.ПолитикаJSON);
КонецФункции

Функция ПолучателиРассылки(Рассылка) Экспорт
	Объект = Рассылка.ПолучитьОбъект();
	Если Объект = Неопределено ИЛИ ПустаяСтрока(Объект.ПолучателиJSON) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Данные = АИС_КлиентВнешнегоСервиса.ПрочитатьJSONИзСтроки(Объект.ПолучателиJSON);
	Если ТипЗнч(Данные) = Тип("Массив") Тогда
		Возврат Данные;
	КонецЕсли;
	Возврат Новый Массив;
КонецФункции

Функция СоздатьРассылка(Параметры) Экспорт
	Заголовок = СокрЛП(Строка(Параметры.Заголовок));
	Если ПустаяСтрока(Заголовок) Тогда
		ВызватьИсключение "Не указан заголовок рассылки";
	КонецЕсли;
	ТипИмя = "Запрос КП";
	Параметры.Свойство("Тип", ТипИмя);
	Если ТипИмя = Неопределено ИЛИ ПустаяСтрока(Строка(ТипИмя)) Тогда
		ТипИмя = "Запрос КП";
	КонецЕсли;
	ТипСсылка = ОбеспечитьТип(ТипИмя);
	ТипОбъект = ТипСсылка.ПолучитьОбъект();
	Политика = ПолитикаТипа(ТипИмя);
	Если Не ПустаяСтрока(ТипОбъект.ПолитикаJSON) Тогда
		Политика = АИС_КлиентВнешнегоСервиса.ПрочитатьJSONИзСтроки(ТипОбъект.ПолитикаJSON);
	КонецЕсли;
	СрокДней = Политика.response_days;
	Параметры.Свойство("СрокДней", СрокДней);
	Если СрокДней = Неопределено ИЛИ ТипЗнч(СрокДней) <> Тип("Число") ИЛИ СрокДней < 0 Тогда
		СрокДней = Политика.response_days;
	КонецЕсли;

	Ответственный = ПользовательПоЛогину(ЗначениеПараметра(Параметры, "Ответственный"));
	Контролер = ПользовательПоЛогину(ЗначениеПараметра(Параметры, "Контролер"));
	ДатаОтправки = ТекущаяДатаСеанса();
	ПолучателиДанные = ЗначениеПараметра(Параметры, "Получатели", Новый Массив);
	Если ТипЗнч(ПолучателиДанные) <> Тип("Массив") Тогда
		ПолучателиДанные = Новый Массив;
	КонецЕсли;
	Получатели = Новый Массив;
	Для Каждого ИмяПолучателя Из ПолучателиДанные Цикл
		Имя = СокрЛП(Строка(ИмяПолучателя));
		Если ПустаяСтрока(Имя) Тогда
			Продолжить;
		КонецЕсли;
		Контрагент = Справочники.Контрагенты.НайтиПоНаименованию(Имя, Истина);
		ИдКонтрагента = "";
		Если ЗначениеЗаполнено(Контрагент) Тогда
			ИдКонтрагента = Строка(Контрагент.УникальныйИдентификатор());
		КонецЕсли;
		Стр = Новый Структура;
		Стр.Вставить("name", Имя);
		Стр.Вставить("counterparty_id", ИдКонтрагента);
		Стр.Вставить("status", "Отправлено");
		Стр.Вставить("response_id", "");
		Стр.Вставить("response_date", "");
		Получатели.Добавить(Стр);
	КонецЦикла;

	Объект = Справочники.АИС_Рассылки.СоздатьЭлемент();
	Объект.Наименование = Заголовок;
	Объект.ТипРассылки = ТипСсылка;
	Объект.ПолитикаJSON = ПолитикаСтрокой(Политика);
	Объект.ПолучателиJSON = АИС_КлиентВнешнегоСервиса.ЗаписатьJSONСтрокой(Получатели);
	Объект.Ответственный = Ответственный;
	Объект.Контролер = Контролер;
	ОснованиеИд = ЗначениеПараметра(Параметры, "ОснованиеUUID", "");
	ОснованиеЗаголовок = ЗначениеПараметра(Параметры, "ОснованиеЗаголовок", "");
	Объект.ОснованиеUUID = СокрЛП(Строка(ОснованиеИд));
	Объект.ОснованиеЗаголовок = СокрЛП(Строка(ОснованиеЗаголовок));
	Объект.ДатаОтправки = ДатаОтправки;
	Объект.СрокОтвета = ДатаОтправки + СрокДней * 86400;
	Объект.ДатаНапоминания = ДатаОтправки + Политика.reminder_days * 86400;
	Объект.ДатаЭскалации = ДатаОтправки + Политика.escalation_days * 86400;
	Объект.Статус = ?(Политика.expects_response, "Ожидает", "Отправлена");
	Комментарий = ЗначениеПараметра(Параметры, "Комментарий", "");
	Объект.Комментарий = СокрЛП(Строка(Комментарий));
	Объект.Записать();
	Возврат Объект.Ссылка;
КонецФункции

Функция НайтиАктивнуюРассылкаПоДокументу(Документ) Экспорт
	Если Документ = Неопределено ИЛИ Не ЗначениеЗаполнено(Документ.Отправитель) Тогда
		Возврат Неопределено;
	КонецЕсли;
	ИмяОтправителя = НРег(Строка(Документ.Отправитель));
	ИдОтправителя = Строка(Документ.Отправитель.УникальныйИдентификатор());
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Статусы", СтрРазделить("Ожидает,Частично,Кворум,Просрочена,ГотовоКРешению,НедостаточноОтветов", ","));
	Запрос.УстановитьПараметр("Сейчас", ТекущаяДатаСеанса());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Рассылки.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА Рассылки.Статус В (""Ожидает"", ""Частично"", ""Кворум"")
	|			И Рассылки.СрокОтвета >= &Сейчас
	|		ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Приоритет
	|ИЗ
	|	Справочник.АИС_Рассылки КАК Рассылки
	|ГДЕ
	|	Рассылки.Статус В (&Статусы)
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет,
	|	Рассылки.ДатаОтправки УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Для Каждого Стр Из ПолучателиРассылки(Выборка.Ссылка) Цикл
			Имя = НРег(Строка(Стр.name));
			Ид = "";
			Стр.Свойство("counterparty_id", Ид);
			Если Имя = ИмяОтправителя ИЛИ (Не ПустаяСтрока(Строка(Ид)) И Строка(Ид) = ИдОтправителя) Тогда
				Возврат Выборка.Ссылка;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция ЗарегистрироватьОтветПоДокументу(Документ) Экспорт
	Рассылка = НайтиАктивнуюРассылкаПоДокументу(Документ);
	Если Не ЗначениеЗаполнено(Рассылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ЗарегистрироватьОтвет(
		Рассылка,
		Строка(Документ.Отправитель),
		Документ.Ссылка,
		ТекущаяДатаСеанса(),
		Строка(Документ.Заголовок));
КонецФункции

Функция ЗарегистрироватьОтвет(Рассылка, ПолучательИмя, ДокументОтвета, ДатаОтвета, ЗаголовокОтвета = "") Экспорт
	СвояТранзакция = Не ТранзакцияАктивна();
	Если СвояТранзакция Тогда
		НачатьТранзакцию();
	КонецЕсли;
	Попытка
		Результат = ЗарегистрироватьОтветВнутри(Рассылка, ПолучательИмя, ДокументОтвета, ДатаОтвета, ЗаголовокОтвета);
		Если СвояТранзакция Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
		Возврат Результат;
	Исключение
		Если СвояТранзакция Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
КонецФункции

Функция ЗарегистрироватьОтветВнутри(Рассылка, ПолучательИмя, ДокументОтвета, ДатаОтвета, ЗаголовокОтвета = "")
	ЗаблокироватьРассылку(Рассылка);
	Объект = Рассылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Получатели = ПолучателиРассылки(Рассылка);
	Найден = Ложь;
	Статус = ?(СтрНайти(НРег(Строка(ЗаголовокОтвета)), "отказ") > 0, "Отказ", "Получено");
	Если ЗначениеЗаполнено(Объект.СрокОтвета) И ДатаОтвета > Объект.СрокОтвета Тогда
		Политика = ПолитикаРассылки(Рассылка);
		Если Политика.late_policy = "reject" Тогда
			Статус = "Поздно";
		КонецЕсли;
	КонецЕсли;
	Для Каждого Стр Из Получатели Цикл
		Имя = НРег(Строка(Стр.name));
		Если Имя = НРег(Строка(ПолучательИмя)) Тогда
			Стр.Вставить("status", Статус);
			Стр.Вставить("response_id", Строка(ДокументОтвета.УникальныйИдентификатор()));
			Стр.Вставить("response_date", Строка(ДатаОтвета));
			Найден = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Не Найден Тогда
		Возврат Неопределено;
	КонецЕсли;
	Объект.ПолучателиJSON = АИС_КлиентВнешнегоСервиса.ЗаписатьJSONСтрокой(Получатели);
	Объект.Записать();
	ПересчитатьСтатус(Рассылка);
	Возврат Рассылка;
КонецФункции

Функция МожноОбрабатыватьОтвет(Рассылка, ДатаОтвета) Экспорт
	Объект = Рассылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Политика = ПолитикаРассылки(Рассылка);
	Если Не Политика.expects_response Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не Политика.open_before_deadline И ЗначениеЗаполнено(Объект.СрокОтвета) И ДатаОтвета < Объект.СрокОтвета Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.СрокОтвета) И ДатаОтвета > Объект.СрокОтвета Тогда
		Если Политика.late_policy = "reject" Тогда
			Возврат Ложь;
		КонецЕсли;
		Если Политика.late_policy = "before_decision"
			И (Объект.Статус = "ГотовоКРешению"
				ИЛИ Объект.Статус = "РешениеПринято"
				ИЛИ Объект.Статус = "Закрыта") Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	Возврат Истина;
КонецФункции

Функция ПересчитатьСтатус(Рассылка) Экспорт
	Объект = Рассылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Объект.Статус = "Закрыта" ИЛИ Объект.Статус = "РешениеПринято" Тогда
		Возврат Новый Структура("status", Объект.Статус);
	КонецЕсли;
	Политика = ПолитикаРассылки(Рассылка);
	Получатели = ПолучателиРассылки(Рассылка);
	Всего = 0;
	Получено = 0;
	Отказов = 0;
	НетОтвета = 0;
	Поздно = 0;
	Для Каждого Стр Из Получатели Цикл
		Всего = Всего + 1;
		Статус = НРег(Строка(Стр.status));
		Если Статус = "получено" ИЛИ Статус = "неполно" Тогда
			Получено = Получено + 1;
		ИначеЕсли Статус = "отказ" Тогда
			Отказов = Отказов + 1;
		ИначеЕсли Статус = "нетответа" Тогда
			НетОтвета = НетОтвета + 1;
		ИначеЕсли Статус = "поздно" Тогда
			Поздно = Поздно + 1;
		КонецЕсли;
	КонецЦикла;
	ВсеЗавершены = Всего > 0 И (Получено + Отказов + НетОтвета + Поздно >= Всего);
	СрокИстек = ЗначениеЗаполнено(Объект.СрокОтвета) И ТекущаяДатаСеанса() >= Объект.СрокОтвета;
	ГотовоКРешению = ВсеЗавершены ИЛИ СрокИстек;
	Кворум = Политика.allow_early_analysis И Получено >= Политика.target_quorum;
	Если Не Политика.expects_response Тогда
		Статус = "Отправлена";
	ИначеЕсли ГотовоКРешению Тогда
		Статус = ?(Получено >= Политика.min_responses, "ГотовоКРешению", "НедостаточноОтветов");
		Если Не ЗначениеЗаполнено(Объект.ДатаЗавершения) Тогда
			Объект.ДатаЗавершения = ТекущаяДатаСеанса();
		КонецЕсли;
	ИначеЕсли Кворум Тогда
		Статус = "Кворум";
	ИначеЕсли Получено + Отказов + НетОтвета + Поздно > 0 Тогда
		Статус = "Частично";
	Иначе
		Статус = "Ожидает";
	КонецЕсли;
	НужноЗаписать = Ложь;
	Если Объект.Статус <> Статус Тогда
		Объект.Статус = Статус;
		НужноЗаписать = Истина;
	КонецЕсли;
	Если ГотовоКРешению И Не ЗначениеЗаполнено(Объект.ДатаЗавершения) Тогда
		Объект.ДатаЗавершения = ТекущаяДатаСеанса();
		НужноЗаписать = Истина;
	КонецЕсли;
	Если НужноЗаписать Тогда
		Попытка
			Объект.Записать();
		Исключение
			Объект = Рассылка.ПолучитьОбъект();
			Если Объект <> Неопределено Тогда
				Если Объект.Статус <> Статус Тогда
					Объект.Статус = Статус;
				КонецЕсли;
				Если ГотовоКРешению И Не ЗначениеЗаполнено(Объект.ДатаЗавершения) Тогда
					Объект.ДатаЗавершения = ТекущаяДатаСеанса();
				КонецЕсли;
				Попытка
					Объект.Записать();
				Исключение
					// Параллельный контроль уже записал актуальный статус.
				КонецПопытки;
			КонецЕсли;
		КонецПопытки;
	КонецЕсли;
	Возврат Новый Структура(
		"status,counts,valid,ready,quorum",
		Статус,
		Новый Структура("total,received,declined,noanswer,late", Всего, Получено, Отказов, НетОтвета, Поздно),
		Получено,
		ГотовоКРешению,
		Кворум);
КонецФункции

// Может ли пользователь принять досрочное решение: контролёр рассылки
// или администратор; кворум/минимум уже достигнут, тип разрешает раннее решение.
Функция МожноРешитьДосрочно(Рассылка, Пользователь) Экспорт
	Объект = Рассылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Объект.Статус = "РешениеПринято" ИЛИ Объект.Статус = "Закрыта" Тогда
		Возврат Ложь;
	КонецЕсли;
	Политика = ПолитикаРассылки(Рассылка);
	Если Не Политика.allow_early_analysis ИЛИ Не Политика.expects_response Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не (Пользователь = Объект.Контролер ИЛИ ЭтоАдминистратор(Пользователь)) Тогда
		Возврат Ложь;
	КонецЕсли;
	Получено = 0;
	Для Каждого Стр Из ПолучателиРассылки(Рассылка) Цикл
		Если НРег(Строка(Стр.status)) = "получено" ИЛИ НРег(Строка(Стр.status)) = "неполно" Тогда
			Получено = Получено + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Получено >= Политика.min_responses;
КонецФункции

// Принимает досрочное решение. Право — у контролёра; администратор
// действует как аварийный обход с обязательным основанием.
Функция ПринятьРешениеДосрочно(Рассылка, Пользователь, Основание) Экспорт
	Если Не МожноРешитьДосрочно(Рассылка, Пользователь) Тогда
		Возврат Новый Структура("ОК,Ошибка", Ложь, "Нет прав или не достигнут кворум");
	КонецЕсли;
	СвояТранзакция = Не ТранзакцияАктивна();
	Если СвояТранзакция Тогда
		НачатьТранзакцию();
	КонецЕсли;
	Попытка
		ЗаблокироватьРассылку(Рассылка);
		Объект = Рассылка.ПолучитьОбъект();
		Объект.Статус = "РешениеПринято";
		Объект.ДатаЗавершения = ТекущаяДатаСеанса();
		Комментарий = "Досрочное решение: " + СокрЛП(Строка(Основание))
			+ "; пользователь: " + Строка(Пользователь);
		Если Не ПустаяСтрока(Объект.Комментарий) Тогда
			Объект.Комментарий = Объект.Комментарий + Символы.ПС + Комментарий;
		Иначе
			Объект.Комментарий = Комментарий;
		КонецЕсли;
		Объект.Записать();
		ЗавершитьПревьюЗадачу(Рассылка, Пользователь, Основание);
		ЗаписьЖурналаРегистрации(
			"АИС.Рассылки", УровеньЖурналаРегистрации.Информация,,
			Рассылка, Комментарий);
		Если СвояТранзакция Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
		Возврат Новый Структура("ОК,Ошибка", Истина, "");
	Исключение
		Если СвояТранзакция Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		Возврат Новый Структура("ОК,Ошибка", Ложь, ОписаниеОшибки());
	КонецПопытки;
КонецФункции

// Проверяет открытые рассылки: фиксирует неответивших, обновляет статусы
// и создаёт задачи на сравнение/решение/сбор недостающих ответов.
Функция ПроверитьРассылки(Предел = 50) Экспорт
	СвояТранзакция = Не ТранзакцияАктивна();
	Если СвояТранзакция Тогда
		НачатьТранзакцию();
	КонецЕсли;
	Попытка
		Результат = ПроверитьРассылкиВнутри(Предел);
		Если СвояТранзакция Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
		Возврат Результат;
	Исключение
		Если СвояТранзакция Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьИсключение;
	КонецПопытки;
КонецФункции

Функция ПроверитьРассылкиВнутри(Предел)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Статусы", СтрРазделить("Ожидает,Частично,Кворум,Просрочена,ГотовоКРешению,НедостаточноОтветов", ","));
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 200
	|	Рассылки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.АИС_Рассылки КАК Рассылки
	|ГДЕ
	|	Рассылки.Статус В (&Статусы)
	|УПОРЯДОЧИТЬ ПО
	|	Рассылки.ДатаОтправки";
	Выборка = Запрос.Выполнить().Выбрать();
	Обработано = 0;
	СозданоЗадач = 0;
	Пока Выборка.Следующий() И Обработано < Предел Цикл
		Обработано = Обработано + 1;
		ЗаблокироватьРассылку(Выборка.Ссылка);
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Объект.СрокОтвета) И ТекущаяДатаСеанса() >= Объект.СрокОтвета Тогда
			Получатели = ПолучателиРассылки(Выборка.Ссылка);
			Изменено = Ложь;
			Для Каждого Стр Из Получатели Цикл
				Если НРег(Строка(Стр.status)) = "отправлено" Тогда
					Стр.Вставить("status", "НетОтвета");
					Изменено = Истина;
				КонецЕсли;
			КонецЦикла;
			Если Изменено Тогда
				Объект.ПолучателиJSON = АИС_КлиентВнешнегоСервиса.ЗаписатьJSONСтрокой(Получатели);
				Объект.Записать();
			КонецЕсли;
		КонецЕсли;
		Результат = ПересчитатьСтатус(Выборка.Ссылка);
		Если Результат = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Вид = "";
		Если Результат.status = "ГотовоКРешению" Тогда
			Вид = ?(ПолитикаРассылки(Выборка.Ссылка).compare, "compare", "decision");
		ИначеЕсли Результат.status = "НедостаточноОтветов" Тогда
			Вид = "reserve";
		ИначеЕсли Результат.status = "Кворум" Тогда
			Вид = "preview";
		КонецЕсли;
		Если Не ПустаяСтрока(Вид) Тогда
			Если СоздатьЗадачуПоРассылка(Выборка.Ссылка, Вид, Результат) Тогда
				СозданоЗадач = СозданоЗадач + 1;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("checked,created", Обработано, СозданоЗадач);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаблокироватьРассылку(Ссылка)
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("Справочник.АИС_Рассылки");
	ЭлементБлокировки.УстановитьЗначение("Ссылка", Ссылка);
	Блокировка.Заблокировать();
КонецПроцедуры

Функция ЭтоАдминистратор(Пользователь)
	Если Не ЗначениеЗаполнено(Пользователь) Тогда
		Возврат Ложь;
	КонецЕсли;
	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(Строка(Пользователь));
	Если ПользовательИБ = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат ПользовательИБ.Роли.Содержит(Метаданные.Роли.АИС_АдминистраторСистемы);
КонецФункции

Процедура ЗавершитьПревьюЗадачу(Рассылка, Пользователь, Основание)
	Маркер = "%mailing:" + Строка(Рассылка.УникальныйИдентификатор()) + ":preview%";
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Маркер", Маркер);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Задачи.Ссылка КАК Ссылка
	|ИЗ
	|	Задача.ЗадачаИсполнителя КАК Задачи
	|ГДЕ
	|	Задачи.Выполнена = ЛОЖЬ
	|	И Задачи.Описание ПОДОБНО &Маркер";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Задача = Выборка.Ссылка.ПолучитьОбъект();
		Если Задача <> Неопределено Тогда
			Задача.Выполнена = Истина;
			Задача.ДатаИсполнения = ТекущаяДатаСеанса();
			Задача.РезультатВыполнения = "Досрочное решение принято: " + СокрЛП(Строка(Основание));
			Задача.Записать();
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ЗначениеПараметра(Параметры, Имя, ЗначениеПоУмолчанию = Неопределено)
	Значение = ЗначениеПоУмолчанию;
	Параметры.Свойство(Имя, Значение);
	Возврат Значение;
КонецФункции

Функция ПользовательПоЛогину(Логин)
	Если Логин = Неопределено ИЛИ ПустаяСтрока(Строка(Логин)) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Справочники.Пользователи.НайтиПоНаименованию(Строка(Логин), Истина);
КонецФункции

Функция СоздатьЗадачуПоРассылка(Рассылка, Вид, Результат)
	Объект = Рассылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Исполнитель = Объект.Ответственный;
	Если Не ЗначениеЗаполнено(Исполнитель) Тогда
		Исполнитель = Объект.Контролер;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Исполнитель) Тогда
		Возврат Ложь;
	КонецЕсли;
	Наименование = "";
	Если Вид = "compare" Тогда
		Наименование = "Сравнить ответы по рассылке: " + Объект.Наименование;
	ИначеЕсли Вид = "decision" Тогда
		Наименование = "Принять решение по рассылке: " + Объект.Наименование;
	ИначеЕсли Вид = "preview" Тогда
		Наименование = "Предварительно сравнить ответы: " + Объект.Наименование;
	Иначе
		Наименование = "Собрать недостающие ответы: " + Объект.Наименование;
	КонецЕсли;
	Описание =
		"Тип: " + Строка(Объект.ТипРассылки)
		+ "; статус: " + Объект.Статус
		+ "; получено: " + Результат.valid + " из " + Результат.counts.total
		+ "; срок: " + Формат(Объект.СрокОтвета, "ДЛФ=DT") + ".";
	Ключ = "mailing:" + Строка(Рассылка.УникальныйИдентификатор()) + ":" + Вид;
	Задача = АИС_ОбщегоНазначения.НайтиИлиСоздатьЗадачу(
		Исполнитель, Наименование, Описание, Неопределено, ОснованиеПоРассылке(Объект), Ключ);
	Возврат ЗначениеЗаполнено(Задача);
КонецФункции

Функция ОснованиеПоРассылке(Объект)
	Если ПустаяСтрока(Объект.ОснованиеUUID) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Ссылка = Справочники.ВнутренниеДокументы.ПолучитьСсылку(
			Новый УникальныйИдентификатор(Объект.ОснованиеUUID));
		Если Ссылка.ПолучитьОбъект() <> Неопределено Тогда
			Возврат Ссылка;
		КонецЕсли;
	Исключение
	КонецПопытки;
	Возврат Неопределено;
КонецФункции

#КонецОбласти
