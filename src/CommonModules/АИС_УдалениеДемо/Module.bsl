Процедура УдалитьДемоОбъекты() Экспорт

	УстановитьПривилегированныйРежим(Истина);

	Юрист = Справочники.Пользователи.НайтиПоНаименованию("Юрист", Истина);
	УдаленоЗадач = 0;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Задачи.Ссылка КАК Ссылка
	|ИЗ
	|	Задача.ЗадачаИсполнителя КАК Задачи
	|ГДЕ
	|	(Задачи.Наименование ПОДОБНО ""Разработать договор купли-продожи%""
	|		ИЛИ Задачи.Наименование ПОДОБНО ""Подготовить к подписанию договор купли-продожи%"")"
	+ ?(ЗначениеЗаполнено(Юрист), "
	|	И Задачи.Исполнитель = &Юрист", "");

	Если ЗначениеЗаполнено(Юрист) Тогда
		Запрос.УстановитьПараметр("Юрист", Юрист);
	КонецЕсли;

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗадачаСсылка = Выборка.Ссылка;
		УдалитьЗапускиПоЗадаче(ЗадачаСсылка);
		ОчиститьРегистрыПоЗадаче(ЗадачаСсылка);
		Попытка
			ОбъектЗадачи = ЗадачаСсылка.ПолучитьОбъект();
			Если ОбъектЗадачи <> Неопределено Тогда
				ОбъектЗадачи.Удалить();
				УдаленоЗадач = УдаленоЗадач + 1;
			КонецЕсли;
		Исключение
			ЗаписатьВЖурнал("Задача " + Строка(ЗадачаСсылка) + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	ДокументСсылка = Справочники.ВнутренниеДокументы.НайтиПоНаименованию("О договоре купли-продажи имущества", Истина);
	Если ЗначениеЗаполнено(ДокументСсылка) Тогда
		ОчиститьРегистрыДокумента(ДокументСсылка);
		Попытка
			ОбъектДокумента = ДокументСсылка.ПолучитьОбъект();
			Если ОбъектДокумента <> Неопределено Тогда
				ОбъектДокумента.Удалить();
			КонецЕсли;
		Исключение
			ЗаписатьВЖурнал("Документ " + Строка(ДокументСсылка) + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	ЗаписатьВЖурнал("Удалено задач: " + Строка(УдаленоЗадач));

КонецПроцедуры

Процедура УдалитьЗапускиПоЗадаче(ЗадачаСсылка)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Запуски.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.АИС_ЗапускиАгентов КАК Запуски
	|ГДЕ
	|	Запуски.Задача = &Задача";
	Запрос.УстановитьПараметр("Задача", ЗадачаСсылка);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			ОбъектЗапуска = Выборка.Ссылка.ПолучитьОбъект();
			Если ОбъектЗапуска <> Неопределено Тогда
				ОбъектЗапуска.Удалить();
			КонецЕсли;
		Исключение
			ЗаписатьВЖурнал("Запуск " + Строка(Выборка.Ссылка) + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

Процедура ОчиститьРегистрыПоЗадаче(ЗадачаСсылка)

	Попытка
		Набор = РегистрыСведений.АИС_КонтекстЗадачИИ.СоздатьНаборЗаписей();
		Набор.Отбор.Задача.Установить(ЗадачаСсылка);
		Набор.Прочитать();
		Если Набор.Количество() > 0 Тогда
			Набор.Очистить();
			Набор.Записать();
		КонецЕсли;
	Исключение
		ЗаписатьВЖурнал("Контекст задачи " + Строка(ЗадачаСсылка) + ": " + ОписаниеОшибки());
	КонецПопытки;

	Попытка
		Набор = РегистрыСведений.АИС_ИсторияДействийИИ.СоздатьНаборЗаписей();
		Набор.Отбор.Задача.Установить(ЗадачаСсылка);
		Набор.Прочитать();
		Если Набор.Количество() > 0 Тогда
			Набор.Очистить();
			Набор.Записать();
		КонецЕсли;
	Исключение
		ЗаписатьВЖурнал("История ИИ по задаче " + Строка(ЗадачаСсылка) + ": " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

Процедура ОчиститьРегистрыДокумента(ДокументСсылка)

	Попытка
		Набор = РегистрыСведений.РабочиеГруппы.СоздатьНаборЗаписей();
		Набор.Отбор.Объект.Установить(ДокументСсылка);
		Набор.Прочитать();
		Если Набор.Количество() > 0 Тогда
			Набор.Очистить();
			Набор.Записать();
		КонецЕсли;
	Исключение
		ЗаписатьВЖурнал("Рабочие группы документа " + Строка(ДокументСсылка) + ": " + ОписаниеОшибки());
	КонецПопытки;

	Попытка
		Набор = РегистрыСведений.СвязиДокументов.СоздатьНаборЗаписей();
		Набор.Отбор.Документ.Установить(ДокументСсылка);
		Набор.Прочитать();
		Если Набор.Количество() > 0 Тогда
			Набор.Очистить();
			Набор.Записать();
		КонецЕсли;
	Исключение
		ЗаписатьВЖурнал("Связи документа " + Строка(ДокументСсылка) + ": " + ОписаниеОшибки());
	КонецПопытки;

	Попытка
		Набор = РегистрыСведений.СвязиДокументов.СоздатьНаборЗаписей();
		Набор.Отбор.СвязанныйДокумент.Установить(ДокументСсылка);
		Набор.Прочитать();
		Если Набор.Количество() > 0 Тогда
			Набор.Очистить();
			Набор.Записать();
		КонецЕсли;
	Исключение
		ЗаписатьВЖурнал("Обратные связи документа " + Строка(ДокументСсылка) + ": " + ОписаниеОшибки());
	КонецПопытки;

	Попытка
		Набор = РегистрыСведений.СостоянияДокументов.СоздатьНаборЗаписей();
		Набор.Отбор.Документ.Установить(ДокументСсылка);
		Набор.Прочитать();
		Если Набор.Количество() > 0 Тогда
			Набор.Очистить();
			Набор.Записать();
		КонецЕсли;
	Исключение
		ЗаписатьВЖурнал("Состояния документа " + Строка(ДокументСсылка) + ": " + ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры

Процедура ЗаписатьВЖурнал(Текст)

	ЗаписьЖурналаРегистрации("АИС_УдалениеДемо", УровеньЖурналаРегистрации.Информация, , , Текст);

КонецПроцедуры
