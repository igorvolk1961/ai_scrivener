#Область ПрограммныйИнтерфейс

Функция Выполнить(Аргументы, Контекст) Экспорт
	Попытка
		Действие = СтрокаАргумента(Аргументы, "action");
		Если Действие = "create" Тогда
			Возврат Создать(Аргументы, Контекст);
		ИначеЕсли Действие = "list" Тогда
			Возврат Список(Аргументы);
		ИначеЕсли Действие = "assign" Тогда
			Возврат Назначить(Аргументы);
		ИначеЕсли Действие = "update" Тогда
			Возврат Обновить(Аргументы);
		ИначеЕсли Действие = "summary" Тогда
			Возврат Сводка(Аргументы);
		Иначе
			Возврат ОшибкаАргументов("Неизвестное действие: " + Действие);
		КонецЕсли;
	Исключение
		Возврат ОшибкаАргументов(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

Функция ВернутьДокумент(Аргументы, Контекст) Экспорт
	Попытка
		Документ = ДокументПоИд(СтрокаАргумента(Аргументы, "document_id"));
		Если Не ЗначениеЗаполнено(Документ) Тогда
			Возврат ОшибкаАргументов("Документ не найден.");
		КонецЕсли;
		ЛогинАдресата = СтрокаАргумента(Аргументы, "addressee");
		Адресат = ПользовательПоЛогину(ЛогинАдресата);
		Если Не ЗначениеЗаполнено(Адресат) Тогда
			Возврат ОшибкаАргументов("Адресат не найден: " + ЛогинАдресата);
		КонецЕсли;
		Замечания = ЗамечанияДляСоздания(ЗначениеАргумента(Аргументы, "remarks"));
		Если Замечания.Количество() = 0 Тогда
			Возврат ОшибкаАргументов("Нужно хотя бы одно замечание с текстом.");
		КонецЕсли;
		Название = СтрокаАргумента(Аргументы, "document_title");
		Если ПустаяСтрока(Название) Тогда
			Название = Строка(Документ);
		КонецЕсли;
		Текст = "Документ: " + Название + " (" + Строка(Документ.УникальныйИдентификатор()) + ")"
			+ Символы.ПС + "Возврат на доработку. Владелец документа: " + ЛогинАдресата;
		СводкаТекст = СтрокаАргумента(Аргументы, "summary");
		Если Не ПустаяСтрока(СводкаТекст) Тогда
			Текст = Текст + Символы.ПС + Символы.ПС + СводкаТекст;
		КонецЕсли;
		Текст = Текст + Символы.ПС + Символы.ПС + "Замечания:";
		Номер = 0;
		Для Каждого Замечание Из Замечания Цикл
			Номер = Номер + 1;
			Текст = Текст + Символы.ПС + Номер + ". ["
				+ Строка(Замечание.Раздел) + " " + Строка(Замечание.Пункт) + "] "
				+ ?(Замечание.Блокирующее, "блокирующее", "неблокирующее")
				+ ": " + Замечание.Текст;
		КонецЦикла;
		РезультатДокумента = СоздатьДокумент(
			"Заключение по документу «" + Название + "» (возврат на доработку)",
			Текст,
			"Заключение",
			ЛогинАдресата,
			Строка(Документ.УникальныйИдентификатор()),
			Контекст);
		Если РезультатДокумента = Неопределено Тогда
			Возврат ОшибкаАргументов("Не удалось создать заключение.");
		КонецЕсли;
		Созданные = АИС_ЗамечанияДокументов.СоздатьЗамечания(
			Документ, Замечания, Адресат, СотрудникКонтекста(Контекст), 1);
		Возврат Новый Структура(
			"Документ,Замечания,Количество",
			РезультатДокумента,
			ЗамечанияВСтруктуры(Созданные),
			Созданные.Количество());
	Исключение
		Возврат ОшибкаАргументов(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

Функция НаправитьЗамечания(Аргументы, Контекст) Экспорт
	Попытка
		Документ = ДокументПоИд(СтрокаАргумента(Аргументы, "document_id"));
		Если Не ЗначениеЗаполнено(Документ) Тогда
			Возврат ОшибкаАргументов("Документ не найден.");
		КонецЕсли;
		ЛогинАдресата = СтрокаАргумента(Аргументы, "addressee");
		Адресат = ПользовательПоЛогину(ЛогинАдресата);
		Если Не ЗначениеЗаполнено(Адресат) Тогда
			Возврат ОшибкаАргументов("Адресат не найден: " + ЛогинАдресата);
		КонецЕсли;
		Иды = ЗначениеАргумента(Аргументы, "remark_ids");
		Если ТипЗнч(Иды) <> Тип("Массив") Тогда
			Возврат ОшибкаАргументов("Нужен массив remark_ids.");
		КонецЕсли;
		Выбранные = Новый Массив;
		Для Каждого Ид Из Иды Цикл
			Замечание = ЗамечаниеПоИд(Строка(Ид));
			Если ЗначениеЗаполнено(Замечание) Тогда
				Выбранные.Добавить(Замечание);
			КонецЕсли;
		КонецЦикла;
		Если Выбранные.Количество() = 0 Тогда
			Возврат ОшибкаАргументов("Не найдены замечания для указанных remark_ids.");
		КонецЕсли;
		Текст = "Поручение по замечаниям к документу "
			+ Строка(Документ.УникальныйИдентификатор()) + Символы.ПС
			+ "Исполнитель: " + ЛогинАдресата;
		Инструкция = СтрокаАргумента(Аргументы, "instruction");
		Если Не ПустаяСтрока(Инструкция) Тогда
			Текст = Текст + Символы.ПС + Символы.ПС + Инструкция;
		КонецЕсли;
		Текст = Текст + Символы.ПС + Символы.ПС + "Исправить только перечисленные замечания:";
		Для Каждого Замечание Из Выбранные Цикл
			Текст = Текст + Символы.ПС + "- " + Строка(Замечание.УникальныйИдентификатор())
				+ " [" + Замечание.Раздел + " " + Замечание.Пункт + "] "
				+ ?(Замечание.Блокирующее, "блокирующее", "неблокирующее")
				+ ": " + Замечание.Текст;
		КонецЦикла;
		РезультатДокумента = СоздатьДокумент(
			"Поручение по замечаниям к документу (" + Выбранные.Количество() + " шт.)",
			Текст,
			"Поручение",
			ЛогинАдресата,
			Строка(Документ.УникальныйИдентификатор()),
			Контекст);
		Если РезультатДокумента = Неопределено Тогда
			Возврат ОшибкаАргументов("Не удалось создать поручение.");
		КонецЕсли;
		Обновленные = Новый Массив;
		Для Каждого Замечание Из Выбранные Цикл
			Обновленное = АИС_ЗамечанияДокументов.ОбновитьЗамечание(
				Замечание, Перечисления.АИС_СтатусыЗамечаний.ВРаботе, Адресат, Неопределено);
			Если ЗначениеЗаполнено(Обновленное) Тогда
				Обновленные.Добавить(Обновленное);
			КонецЕсли;
		КонецЦикла;
		Возврат Новый Структура(
			"Документ,Замечания",
			РезультатДокумента,
			Обновленные);
	Исключение
		Возврат ОшибкаАргументов(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Создать(Аргументы, Контекст)
	Документ = ДокументПоИд(СтрокаАргумента(Аргументы, "document_id"));
	Если Не ЗначениеЗаполнено(Документ) Тогда
		Возврат ОшибкаАргументов("Документ не найден.");
	КонецЕсли;
	Замечания = ЗамечанияДляСоздания(ЗначениеАргумента(Аргументы, "remarks"));
	Если Замечания.Количество() = 0 Тогда
		Возврат ОшибкаАргументов("Нужно хотя бы одно замечание с текстом.");
	КонецЕсли;
	Владелец = ПользовательПоЛогину(СтрокаАргумента(Аргументы, "owner"));
	Раунд = ЧислоАргумента(Аргументы, "round", 1);
	Созданные = АИС_ЗамечанияДокументов.СоздатьЗамечания(
		Документ, Замечания, Владелец, СотрудникКонтекста(Контекст), Раунд);
	Возврат Новый Структура("Замечания", ЗамечанияВСтруктуры(Созданные));
КонецФункции

Функция Список(Аргументы)
	Документ = Неопределено;
	Ид = СтрокаАргумента(Аргументы, "document_id");
	Если Не ПустаяСтрока(Ид) Тогда
		Документ = ДокументПоИд(Ид);
		Если Не ЗначениеЗаполнено(Документ) Тогда
			Возврат ОшибкаАргументов("Документ не найден.");
		КонецЕсли;
	КонецЕсли;
	Владелец = ПользовательПоЛогину(СтрокаАргумента(Аргументы, "owner"));
	Статус = СтатусПоИмени(СтрокаАргумента(Аргументы, "status"));
	СписокЗамечаний = АИС_ЗамечанияДокументов.СписокЗамечаний(Документ, Владелец, Статус);
	Возврат Новый Структура("Замечания", СписокЗамечаний);
КонецФункции

Функция Назначить(Аргументы)
	Логин = СтрокаАргумента(Аргументы, "owner");
	Владелец = ПользовательПоЛогину(Логин);
	Если Не ЗначениеЗаполнено(Владелец) Тогда
		Возврат ОшибкаАргументов("Владелец не найден: " + Логин);
	КонецЕсли;
	Иды = ЗначениеАргумента(Аргументы, "remark_ids");
	Если ТипЗнч(Иды) <> Тип("Массив") Тогда
		Возврат ОшибкаАргументов("Нужен массив remark_ids.");
	КонецЕсли;
	Обновленные = Новый Массив;
	Для Каждого Ид Из Иды Цикл
		Замечание = ЗамечаниеПоИд(Строка(Ид));
		Если Не ЗначениеЗаполнено(Замечание) Тогда
			Продолжить;
		КонецЕсли;
		Обновленное = АИС_ЗамечанияДокументов.ОбновитьЗамечание(
			Замечание, Перечисления.АИС_СтатусыЗамечаний.ВРаботе, Владелец, Неопределено);
		Если ЗначениеЗаполнено(Обновленное) Тогда
			Обновленные.Добавить(Обновленное);
		КонецЕсли;
	КонецЦикла;
	Возврат Новый Структура("Замечания", Обновленные);
КонецФункции

Функция Обновить(Аргументы)
	Замечание = ЗамечаниеПоИд(СтрокаАргумента(Аргументы, "remark_id"));
	Если Не ЗначениеЗаполнено(Замечание) Тогда
		Возврат ОшибкаАргументов("Замечание не найдено.");
	КонецЕсли;
	Статус = СтатусПоИмени(СтрокаАргумента(Аргументы, "status"));
	Владелец = ПользовательПоЛогину(СтрокаАргумента(Аргументы, "owner"));
	Решение = СтрокаАргумента(Аргументы, "resolution");
	Обновленное = АИС_ЗамечанияДокументов.ОбновитьЗамечание(
		Замечание, Статус, Владелец, ?(ПустаяСтрока(Решение), Неопределено, Решение));
	Если Не ЗначениеЗаполнено(Обновленное) Тогда
		Возврат ОшибкаАргументов("Не удалось обновить замечание.");
	КонецЕсли;
	Возврат Новый Структура("Замечание", Обновленное);
КонецФункции

Функция Сводка(Аргументы)
	Документ = ДокументПоИд(СтрокаАргумента(Аргументы, "document_id"));
	Если Не ЗначениеЗаполнено(Документ) Тогда
		Возврат ОшибкаАргументов("Документ не найден.");
	КонецЕсли;
	Возврат Новый Структура("Сводка", АИС_ЗамечанияДокументов.СводкаПоДокументу(Документ));
КонецФункции

Функция СоздатьДокумент(Заголовок, Текст, Вид, ЛогинАдресата, ОснованиеИд, Контекст)
	АргументыДокумента = Новый Структура(
		"title,content,document_type,addressee,basis_id",
		Заголовок, Текст, Вид, ЛогинАдресата, ОснованиеИд);
	Результат = АИС_ИнструментыАгента.СоздатьДокументПоАргументам(АргументыДокумента, Контекст);
	Если Не Результат.ОК Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Результат.Данные.id;
КонецФункции

Функция ЗамечанияДляСоздания(Значение)
	Результат = Новый Массив;
	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Элемент Из Значение Цикл
		Если ТипЗнч(Элемент) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		Текст = СтрокаАргумента(Элемент, "text");
		Если ПустаяСтрока(Текст) Тогда
			Продолжить;
		КонецЕсли;
		Результат.Добавить(Новый Структура(
			"Текст,Раздел,Пункт,Блокирующее,Ключ",
			Текст,
			СтрокаАргумента(Элемент, "section"),
			СтрокаАргумента(Элемент, "item"),
			?(ЗначениеАргумента(Элемент, "blocking") = Ложь, Ложь, Истина),
			""));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ЗамечанияВСтруктуры(Ссылки)
	Результат = Новый Массив;
	Если ТипЗнч(Ссылки) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Ссылка Из Ссылки Цикл
		Результат.Добавить(АИС_ЗамечанияДокументов.ЗамечаниеВСтруктуру(Ссылка));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция СтатусПоИмени(Имя)
	Имя = НРег(СокрЛП(Имя));
	Если Имя = "open" ИЛИ Имя = "открыто" Тогда
		Возврат Перечисления.АИС_СтатусыЗамечаний.Открыто;
	ИначеЕсли Имя = "in_progress" ИЛИ Имя = "вработе" Тогда
		Возврат Перечисления.АИС_СтатусыЗамечаний.ВРаботе;
	ИначеЕсли Имя = "fixed" ИЛИ Имя = "исправлено" Тогда
		Возврат Перечисления.АИС_СтатусыЗамечаний.Исправлено;
	ИначеЕсли Имя = "accepted" ИЛИ Имя = "принято" Тогда
		Возврат Перечисления.АИС_СтатусыЗамечаний.Принято;
	ИначеЕсли Имя = "rejected" ИЛИ Имя = "отклонено" Тогда
		Возврат Перечисления.АИС_СтатусыЗамечаний.Отклонено;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ЗамечаниеПоИд(Ид)
	Если ПустаяСтрока(Ид) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Ссылка = Справочники.АИС_Замечания.ПолучитьСсылку(Новый УникальныйИдентификатор(Ид));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если Ссылка.ПолучитьОбъект() = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Ссылка;
КонецФункции

Функция ДокументПоИд(Ид)
	Если ПустаяСтрока(Ид) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Ссылка = Справочники.ВнутренниеДокументы.ПолучитьСсылку(Новый УникальныйИдентификатор(Ид));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если Ссылка.ПолучитьОбъект() = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Ссылка;
КонецФункции

Функция ПользовательПоЛогину(Логин)
	Если ПустаяСтрока(Логин) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Справочники.Пользователи.НайтиПоНаименованию(Логин, Истина);
КонецФункции

Функция СотрудникКонтекста(Контекст)
	Сотрудник = Неопределено;
	Если ТипЗнч(Контекст) = Тип("Структура") Тогда
		Контекст.Свойство("Сотрудник", Сотрудник);
	КонецЕсли;
	Если ЗначениеЗаполнено(Сотрудник) Тогда
		Возврат Сотрудник;
	КонецЕсли;
	Возврат ПараметрыСеанса.ТекущийПользователь;
КонецФункции

Функция ЧислоАргумента(Аргументы, Имя, ПоУмолчанию)
	Значение = ЗначениеАргумента(Аргументы, Имя);
	Если ТипЗнч(Значение) = Тип("Число") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции

Функция ЗначениеАргумента(Аргументы, Имя)
	Значение = Неопределено;
	Если ТипЗнч(Аргументы) = Тип("Структура") Тогда
		Аргументы.Свойство(Имя, Значение);
	ИначеЕсли ТипЗнч(Аргументы) = Тип("Соответствие") Тогда
		Значение = Аргументы.Получить(Имя);
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция СтрокаАргумента(Аргументы, Имя)
	Значение = ЗначениеАргумента(Аргументы, Имя);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));
КонецФункции

Функция ОшибкаАргументов(Текст)
	Возврат Новый Структура("КодОшибки,ТекстОшибки", "invalid_arguments", Текст);
