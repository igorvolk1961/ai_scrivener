#Область ПрограммныйИнтерфейс

Функция СогласоватьТехнически(Аргументы) Экспорт
	Попытка
		Ид = СтрокаАргумента(Аргументы, "template_id");
		Если ПустаяСтрока(Ид) Тогда
			Возврат ОшибкаАргументов("Нужен template_id.");
		КонецЕсли;
		Ссылка = Справочники.ШаблоныВнутреннихДокументов.ПолучитьСсылку(
			Новый УникальныйИдентификатор(Ид));
		Объект = Ссылка.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			Возврат ОшибкаАргументов("Шаблон не найден: " + Ид);
		КонецЕсли;
		Если Объект.Статус = "Утверждён" Тогда
			Возврат Новый Структура(
				"template_id,status,task",
				Строка(Объект.Ссылка.УникальныйИдентификатор()),
				"уже утверждён",
				"");
		КонецЕсли;
		Объект.Статус = "Согласован";
		Объект.Записать();

		ЗадачаИд = "";
		Если ЗначениеЗаполнено(Объект.Автор) Тогда
			Наименование = "Утвердить шаблон: " + Объект.Заголовок;
			Описание =
				"Программист 1С технически согласовал шаблон на основе документа "
				+ """" + Объект.Заголовок + """. Утвердите его либо верните "
				+ "на доработку." + Символы.ПС + Символы.ПС
				+ "Текст шаблона:" + Символы.ПС + Объект.КомментарийКШаблону;
			Задача = АИС_ОбщегоНазначения.НайтиИлиСоздатьЗадачу(
				Объект.Автор, Наименование, Описание);
			Если ЗначениеЗаполнено(Задача) Тогда
				ЗадачаИд = Строка(Задача.УникальныйИдентификатор());
			КонецЕсли;
		КонецЕсли;
		Возврат Новый Структура(
			"template_id,status,task",
			Строка(Объект.Ссылка.УникальныйИдентификатор()),
			"согласован",
			ЗадачаИд);
	Исключение
		Возврат ОшибкаАргументов(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

Функция Утвердить(Аргументы) Экспорт
	Попытка
		Ид = СтрокаАргумента(Аргументы, "template_id");
		Если ПустаяСтрока(Ид) Тогда
			Возврат ОшибкаАргументов("Нужен template_id.");
		КонецЕсли;
		Ссылка = Справочники.ШаблоныВнутреннихДокументов.ПолучитьСсылку(
			Новый УникальныйИдентификатор(Ид));
		Объект = Ссылка.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			Возврат ОшибкаАргументов("Шаблон не найден: " + Ид);
		КонецЕсли;
		Объект.Статус = "Утверждён";
		Объект.Записать();
		Возврат Новый Структура(
			"template_id,status",
			Строка(Объект.Ссылка.УникальныйИдентификатор()),
			"утверждён");
	Исключение
		Возврат ОшибкаАргументов(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЗначениеАргумента(Аргументы, Имя)
	Значение = Неопределено;
	Если ТипЗнч(Аргументы) = Тип("Структура") Тогда
		Аргументы.Свойство(Имя, Значение);
	ИначеЕсли ТипЗнч(Аргументы) = Тип("Соответствие") Тогда
		Значение = Аргументы.Получить(Имя);
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция СтрокаАргумента(Аргументы, Имя)
	Значение = ЗначениеАргумента(Аргументы, Имя);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));
КонецФункции

Функция ОшибкаАргументов(Текст)
	Возврат Новый Структура("КодОшибки,ТекстОшибки", "invalid_arguments", Текст);
КонецФункции

#КонецОбласти
