Функция ХешСтроки(Значение)
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Строка(Значение));
	Возврат НРег(СтрЗаменить(Хеширование.ХешСумма, " ", ""));
КонецФункции

Функция ХешДвоичныхДанных(Данные)
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(Данные);
	Возврат НРег(СтрЗаменить(Хеширование.ХешСумма, " ", ""));
КонецФункции

Функция MIMEПоРасширению(ИмяФайла)
	ПозицияТочки = 0;
	Для Индекс = 1 По СтрДлина(ИмяФайла) Цикл
		Если Сред(ИмяФайла, Индекс, 1) = "." Тогда
			ПозицияТочки = Индекс;
		КонецЕсли;
	КонецЦикла;
	Если ПозицияТочки = 0 Тогда
		Возврат "text/plain";
	КонецЕсли;
	Расширение = НРег(Сред(
		ИмяФайла,
		ПозицияТочки,
		СтрДлина(ИмяФайла) - ПозицияТочки + 1));
	Если Расширение = ".pdf" Тогда
		Возврат "application/pdf";
	ИначеЕсли Расширение = ".docx" Тогда
		Возврат "application/vnd.openxmlformats-officedocument.wordprocessingml.document";
	ИначеЕсли Расширение = ".html" ИЛИ Расширение = ".htm" Тогда
		Возврат "text/html";
	ИначеЕсли Расширение = ".md" Тогда
		Возврат "text/markdown";
	КонецЕсли;
	Возврат "text/plain";
КонецФункции

