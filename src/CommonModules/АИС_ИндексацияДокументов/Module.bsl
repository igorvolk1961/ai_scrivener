КонецФункции

Функция МетаданныеСнимка(Документ)
	Данные = Новый Структура;
	Данные.Вставить("positions", Новый Массив);
	Данные.Вставить("departments", Новый Массив);
	Данные.Вставить("authors", Новый Массив);
	Данные.Вставить("addressees", Новый Массив);
	Данные.Вставить("folders", Новый Массив);

	Если РеквизитЕсть(Документ, "АИС_Должность") Тогда
		Должность = ЗначениеРеквизита(Документ, "АИС_Должность");
		Если ЗначениеЗаполнено(Должность) Тогда
			Данные.positions.Добавить(Строка(Должность.УникальныйИдентификатор()));
		КонецЕсли;
	КонецЕсли;
	ДобавитьСсылкуВМассив(Данные.authors, Документ, "Подготовил");
	ДобавитьСсылкуВМассив(Данные.authors, Документ, "Автор");
	ДобавитьСсылкуВМассив(Данные.addressees, Документ, "Адресат");
	ДобавитьСсылкуВМассив(Данные.addressees, Документ, "Корреспондент");
	Возврат Данные;
КонецФункции

Процедура ДобавитьСсылкуВМассив(Массив, Документ, ИмяРеквизита)
	Если Не РеквизитЕсть(Документ, ИмяРеквизита) Тогда
		Возврат;
	КонецЕсли;
	Значение = ЗначениеРеквизита(Документ, ИмяРеквизита);
	Если ЗначениеЗаполнено(Значение) Тогда
		Массив.Добавить(Строка(Значение.УникальныйИдентификатор()));
	КонецЕсли;
КонецПроцедуры

