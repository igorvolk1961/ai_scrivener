#Область ПрограммныйИнтерфейс

Процедура ВыполнитьИндексацию() Экспорт
	Если Не Константы.АИС_ИндексацияRAGВключена.Получить() Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Если НужнаПолнаяСверка() Тогда
			ПолнаяСверка();
			ОтметитьПолнуюСверку();
		КонецЕсли;
		Попытка
			Если НужнаОчисткаВерсий() Тогда
				АИС_ИнтеграцияСRAG.ОчиститьУстаревшиеВерсии(90);
				ОтметитьОчисткуВерсий();
			КонецЕсли;
		Исключение
			ЗаписатьОшибкуПодписки(
				"ОчиститьУстаревшиеВерсии",
				ОписаниеОшибки());
		КонецПопытки;
		РазобратьОчередь(20);
	Исключение
		ЗаписатьОшибкуПодписки("ВыполнитьИндексацию", ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

Процедура ДокументПриЗаписи(Источник, Отказ) Экспорт
	Попытка
		ПоставитьВОчередь(Источник.Ссылка, "Запись документа");
	Исключение
		ЗаписатьОшибкуПодписки("ДокументПриЗаписи", ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

Процедура ФайлПриЗаписи(Источник, Отказ) Экспорт
	Попытка
		Документ = ВладелецДокументаФайла(Источник.Ссылка);
		Если ЗначениеЗаполнено(Документ) Тогда
			ПоставитьВОчередь(Документ, "Файл или версия файла");
		КонецЕсли;
	Исключение
		ЗаписатьОшибкуПодписки("ФайлПриЗаписи", ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

Процедура РабочаяГруппаПриЗаписи(Источник, Отказ) Экспорт
	Попытка
		Если ЗначениеЗаполнено(Источник.Объект) Тогда
			ПоставитьВОчередь(Источник.Объект, "Рабочая группа");
		КонецЕсли;
	Исключение
		ЗаписатьОшибкуПодписки("РабочаяГруппаПриЗаписи", ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

Процедура СостояниеДокументаПриЗаписи(Источник, Отказ) Экспорт
	Попытка
		Если ЗначениеЗаполнено(Источник.Документ) Тогда
			ПоставитьВОчередь(Источник.Документ, "Смена состояния");
		КонецЕсли;
	Исключение
		ЗаписатьОшибкуПодписки("СостояниеДокументаПриЗаписи", ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

// Ставит документ в очередь на индексацию. Подписки вызывают только этот
// метод; тяжёлая работа выполняется регламентным заданием.
Процедура ПоставитьВОчередь(Документ, Причина = "Изменение") Экспорт
	Если Не ЗначениеЗаполнено(Документ) Тогда
		Возврат;
	КонецЕсли;
	ТипИсточника = ТипИсточникаПоДокументу(Документ);
	Если ПустаяСтрока(ТипИсточника) Тогда
		Возврат;
	КонецЕсли;

	ПрежнийРежим = УстановитьПривилегированныйРежим(Истина);
	Попытка
		Менеджер = РегистрыСведений.АИС_СостоянияИндексации.СоздатьМенеджерЗаписи();
		Менеджер.ТипИсточника = ТипИсточника;
		Менеджер.Идентификатор = Строка(Документ.УникальныйИдентификатор());
		Менеджер.Прочитать();
		Менеджер.Состояние = "Ожидает";
		Менеджер.ДатаПостановки = ТекущаяДатаСеанса();
		Менеджер.Ошибка = "";
		Менеджер.Попытки = 0;
		Менеджер.Заблокировано = "";
		Менеджер.ДатаБлокировки = '00010101';
		Менеджер.Записать();
	Исключение
		ЗаписатьОшибкуПодписки("ПоставитьВОчередь", ОписаниеОшибки());
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);
КонецПроцедуры

// Разбирает очередь: индексирует изменившиеся документы и деактивирует
// неактуальные. Возвращает структуру со счётчиками.
Функция РазобратьОчередь(МаксимумЗаписей = 20) Экспорт
	Статистика = Новый Структура("Обработано,Актуализировано,Исключено,Ошибок", 0, 0, 0, 0);

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ " + Формат(МаксимумЗаписей, "ЧГ=0") + "
	|	Состояния.ТипИсточника КАК ТипИсточника,
	|	Состояния.Идентификатор КАК Идентификатор
	|ИЗ
	|	РегистрСведений.АИС_СостоянияИндексации КАК Состояния
	|ГДЕ
	|	Состояния.ТипИсточника <> &Системный
	|	И (Состояния.Состояние = &Ожидает
	|		ИЛИ (Состояния.Состояние = &Ошибка И Состояния.Попытки < 10))
	|УПОРЯДОЧИТЬ ПО
	|	Состояния.ДатаПостановки ВОЗР";
	Запрос.УстановитьПараметр("Системный", "system");
	Запрос.УстановитьПараметр("Ожидает", "Ожидает");
	Запрос.УстановитьПараметр("Ошибка", "Ошибка");

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Статистика.Обработано = Статистика.Обработано + 1;
		Попытка
			Документ = НайтиДокументПоИдентификатору(
				Выборка.ТипИсточника,
				Выборка.Идентификатор);
			Если Не ЗначениеЗаполнено(Документ) Тогда
				АИС_ИнтеграцияСRAG.УдалитьДокумент(
					Выборка.ТипИсточника,
					Выборка.Идентификатор);
				ЗаписатьСостояние(Выборка.ТипИсточника, Выборка.Идентификатор, "Исключён", "", "", "", 0, "");
				Статистика.Исключено = Статистика.Исключено + 1;
				Продолжить;
			КонецЕсли;

			Снимок = СобратьСнимок(Документ);
			Если Снимок.ПометкаУдаления Тогда
				АИС_ИнтеграцияСRAG.УдалитьДокумент(
					Снимок.ТипИсточника,
					Снимок.ИсточникID);
				ЗаписатьСостояние(
					Снимок.ТипИсточника,
					Снимок.ИсточникID,
					"Исключён",
					Снимок.Семейство,
					"",
					"",
					0,
					"");
				Статистика.Исключено = Статистика.Исключено + 1;
				Продолжить;
			КонецЕсли;
			Если Не Снимок.Финальный ИЛИ Не Снимок.Актуален Тогда
				АИС_ИнтеграцияСRAG.ДеактивироватьДокумент(
					Снимок.ТипИсточника,
					Снимок.ИсточникID);
				ЗаписатьСостояние(
					Снимок.ТипИсточника,
					Снимок.ИсточникID,
					"Исключён",
					Снимок.Семейство,
					Снимок.ВерсияСодержимого,
					Снимок.ХешACL,
					0,
					"");
				Статистика.Исключено = Статистика.Исключено + 1;
				Продолжить;
			КонецЕсли;

			Состояние = ПрочитатьСостояние(Снимок.ТипИсточника, Снимок.ИсточникID);
			Если Состояние.ХешСодержимого = Снимок.ХешСодержимого
				И Состояние.ХешACL = Снимок.ХешACL Тогда
				ЗаписатьСостояние(
					Снимок.ТипИсточника,
					Снимок.ИсточникID,
					"Актуален",
					Снимок.Семейство,
					Снимок.ВерсияСодержимого,
					Снимок.ХешACL,
					0,
					"");
				Статистика.Актуализировано = Статистика.Актуализировано + 1;
				Продолжить;
			КонецЕсли;

			Если Состояние.ХешСодержимого = Снимок.ХешСодержимого
				И Состояние.ХешACL <> Снимок.ХешACL Тогда
				Поля = Новый Структура;
				Поля.Вставить("acl_principals", Снимок.ACLПринципалы);
				Поля.Вставить("acl_deny_principals", Снимок.ACLЗапреты);
				Поля.Вставить("acl_version", Снимок.ХешACL);
				Поля.Вставить("is_current", Снимок.Актуален);
				Поля.Вставить("family_id", Снимок.Семейство);
				АИС_ИнтеграцияСRAG.ОбновитьМетаданныеИндекса(
					Снимок.ТипИсточника,
					Снимок.ИсточникID,
					Снимок.ВерсияСодержимого,
					Поля);
				ЗаписатьСостояние(
					Снимок.ТипИсточника,
					Снимок.ИсточникID,
					"Актуален",
					Снимок.Семейство,
					Снимок.ВерсияСодержимого,
					Снимок.ХешACL,
					0,
					"");
				Статистика.Актуализировано = Статистика.Актуализировано + 1;
				Продолжить;
			КонецЕсли;

			Ответ = АИС_ИнтеграцияСRAG.ЗагрузитьДокумент(
				Снимок,
				Снимок.Текст,
				Снимок.Файл);
			ЗаписатьСостояние(
				Снимок.ТипИсточника,
				Снимок.ИсточникID,
				?(Ответ.ТребуетсяOCR, "ОжидаетOCR", "Актуален"),
				Снимок.Семейство,
				Снимок.ВерсияСодержимого,
				Снимок.ХешACL,
				0,
				"");
			Статистика.Актуализировано = Статистика.Актуализировано + 1;
		Исключение
			ОшибкаТекст = ОписаниеОшибки();
			ЗаписатьСостояние(
				Выборка.ТипИсточника,
				Выборка.Идентификатор,
				"Ошибка",
				"",
				"",
				"",
				1,
				ОшибкаТекст);
			Статистика.Ошибок = Статистика.Ошибок + 1;
			ЗаписатьОшибкуПодписки("РазобратьОчередь", ОшибкаТекст);
		КонецПопытки;
	КонецЦикла;

	Возврат Статистика;
КонецФункции

// Полная сверка: ставит в очередь все документы, включая не финальные.
Функция ПолнаяСверка() Экспорт
	Количество = 0;
	Для Каждого ИмяСправочника Из СтрРазделить(
		"ВнутренниеДокументы,ВходящиеДокументы,ИсходящиеДокументы",
		",") Цикл
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Документы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник." + ИмяСправочника + " КАК Документы";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			ПоставитьВОчередь(Выборка.Ссылка, "Полная сверка");
			Количество = Количество + 1;
		КонецЦикла;
	КонецЦикла;
	Возврат Количество;
КонецФункции

// Собирает снимок документа для RAG.
Функция СобратьСнимок(Документ) Экспорт
	ТипИсточника = ТипИсточникаПоДокументу(Документ);
	Финальность = ФинальноеСостояние(Документ);
	Текст = ТекстДокумента(Документ);
	Файл = ТекущийФайл(Документ);
	Принципалы = АИС_ПраваДоступа.ПринципалыДокумента(Документ);
	ХешACL = АИС_ПраваДоступа.ХешПринципалов(Принципалы);
	ХешФайла = ?(Файл = Неопределено, "", Файл.Хеш);
	ХешСодержимого = ХешСтроки(
		ТипИсточника + "|" + Строка(Документ.УникальныйИдентификатор())
		+ "|" + Текст + "|" + ХешФайла + "|" + Финальность.Статус);
	Семейство = ОпределитьСемейство(Документ);
	Актуален = Финальность.Финальный И ДокументАктуален(Документ);

	Снимок = Новый Структура;
	Снимок.Вставить("ТипИсточника", ТипИсточника);
	Снимок.Вставить("ИсточникID", Строка(Документ.УникальныйИдентификатор()));
	Снимок.Вставить("Семейство", Семейство);
	Снимок.Вставить("ВерсияСодержимого", ХешСодержимого);
	Снимок.Вставить("ХешСодержимого", ХешСодержимого);
	Снимок.Вставить("ХешФайла", ХешФайла);
	Снимок.Вставить("ХешACL", ХешACL);
	Снимок.Вставить("ACLПринципалы", Принципалы);
	Снимок.Вставить("ACLЗапреты", Новый Массив);
	Снимок.Вставить("Финальный", Финальность.Финальный);
	Снимок.Вставить("Актуален", Актуален);
	Снимок.Вставить("ПометкаУдаления", Финальность.ПометкаУдаления);
	Снимок.Вставить("Статус", Финальность.Статус);
	Снимок.Вставить("Состояние", Финальность.Состояние);
	Снимок.Вставить("Заголовок", ЗаголовокДокумента(Документ));
	Снимок.Вставить("ВидДокумента", ВидДокумента(Документ));
	Снимок.Вставить("Вид", ВидПоТипу(ТипИсточника));
	ДатаДокументаЗначение = ДатаДокумента(Документ);
	Если ЗначениеЗаполнено(ДатаДокументаЗначение) Тогда
		ДатаДокументаСтрокой = Формат(ДатаДокументаЗначение, "ДФ=yyyy-MM-dd");
	Иначе
		ДатаДокументаСтрокой = Неопределено;
	КонецЕсли;
	Снимок.Вставить("Номер", НомерДокумента(Документ));
	Снимок.Вставить("ДатаДокумента", ДатаДокументаСтрокой);
	Снимок.Вставить("ДатаУтверждения", Неопределено);
	Снимок.Вставить("ДатаНачалаДействия", Неопределено);
	Снимок.Вставить("Текст", Текст);
	Снимок.Вставить("Файл", Файл);
	Снимок.Вставить("Метаданные", МетаданныеСнимка(Документ));
	Возврат Снимок;
КонецФункции

// Определяет финальность и канонический статус документа.
Функция ФинальноеСостояние(Документ) Экспорт
	ТипИсточника = ТипИсточникаПоДокументу(Документ);
	Состояние = "";
	Попытка
		Состояние = Строка(Делопроизводство.ПолучитьСостояниеДокумента(Документ));
	Исключение
		Состояние = "";
	КонецПопытки;
	НеДействует = Ложь;
	Если РеквизитЕсть(Документ, "НеДействует") Тогда
		Значение = ЗначениеРеквизита(Документ, "НеДействует");
		НеДействует = Значение = Истина;
	КонецЕсли;
	ПометкаУдаления = Ложь;
	Попытка
		ПометкаУдаления = Документ.ПометкаУдаления;
	Исключение
		ПометкаУдаления = Ложь;
	КонецПопытки;

	ДопустимыеСостояния = ФинальныеСостояния(ТипИсточника, Документ);
	Финальный = ДопустимыеСостояния.Найти(Состояние) <> Неопределено
		И Не НеДействует
		И Не ПометкаУдаления;
	Возврат Новый Структура(
		"Финальный,Статус,Состояние,НеДействует,ПометкаУдаления",
		Финальный,
		КаноническийСтатус(Состояние, НеДействует, ПометкаУдаления),
		Состояние,
		НеДействует,
		ПометкаУдаления);
КонецФункции

// Определяет семейство документа: должностная инструкция — по должности,
// остальные — по явным связям версий или собственной ссылке.
Функция ОпределитьСемейство(Документ) Экспорт
	Если РеквизитЕсть(Документ, "АИС_Должность") Тогда
		Должность = ЗначениеРеквизита(Документ, "АИС_Должность");
		Если ЗначениеЗаполнено(Должность) Тогда
			Возврат "job_description:" + Строка(Должность.УникальныйИдентификатор());
		КонецЕсли;
	КонецЕсли;
	Компонента = КомпонентаСемейства(Документ);
	Если Компонента.Количество() > 1 Тогда
		Возврат Строка(КореньСемейства(Компонента).УникальныйИдентификатор());
	КонецЕсли;
	Возврат Строка(Документ.УникальныйИдентификатор());
КонецФункции

// Проверяет, является ли финальный документ актуальным в своём семействе.
Функция ДокументАктуален(Документ) Экспорт
	Если РеквизитЕсть(Документ, "НеДействует") Тогда
		Если ЗначениеРеквизита(Документ, "НеДействует") = Истина Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;

	// Для явных связей актуальна только последняя финальная карточка семейства.
	Компонента = КомпонентаСемейства(Документ);
	Если Компонента.Количество() > 1
		И Не ДокументАктуаленВСемействе(Документ, Компонента) Тогда
		Возврат Ложь;
	КонецЕсли;

	// Для должностных инструкций актуальна только последняя утверждённая
	// инструкция по должности.
	Если РеквизитЕсть(Документ, "АИС_Должность") Тогда
		Должность = ЗначениеРеквизита(Документ, "АИС_Должность");
		Если ЗначениеЗаполнено(Должность) Тогда
			ДатаТекущегоДокумента = ДатаДокумента(Документ);
			Если Не ЗначениеЗаполнено(ДатаТекущегоДокумента) Тогда
				Возврат Истина;
			КонецЕсли;
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ
			|	Документы.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.ВнутренниеДокументы КАК Документы
			|ГДЕ
			|	Документы.АИС_Должность = &Должность
			|	И Документы.Ссылка <> &Документ
			|	И НЕ Документы.ПометкаУдаления
			|	И НЕ Документы.НеДействует
			|	И Документы.Дата > &Дата";
			Запрос.УстановитьПараметр("Должность", Должность);
			Запрос.УстановитьПараметр("Документ", Документ);
			Запрос.УстановитьПараметр("Дата", ДатаТекущегоДокумента);
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				Финальность = ФинальноеСостояние(Выборка.Ссылка);
				Если Финальность.Финальный Тогда
					Возврат Ложь;
				КонецЕсли;
			КонецЦикла;
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;

	Возврат Истина;
КонецФункции

// Возвращает текущую версию основного файла документа.
Функция ТекущийФайл(Документ) Экспорт
	ИмяВладельца = ИмяРеквизитаВладельцаФайла();
	Если ПустаяСтрока(ИмяВладельца) Тогда
		Возврат Неопределено;
	КонецЕсли;

	ПоляФайла = "Файл.Ссылка КАК Ссылка, Файл.Наименование КАК Наименование";
	Если РеквизитЕстьУСправочника("Файлы", "ТекущаяВерсия") Тогда
		ПоляФайла = ПоляФайла + ", Файл.ТекущаяВерсия КАК ТекущаяВерсия";
	КонецЕсли;
	Если РеквизитЕстьУСправочника("Файлы", "ТекущаяВерсияРасширение") Тогда
		ПоляФайла = ПоляФайла + ", Файл.ТекущаяВерсияРасширение КАК ТекущаяВерсияРасширение";
	КонецЕсли;
	Если РеквизитЕстьУСправочника("Файлы", "Расширение") Тогда
		ПоляФайла = ПоляФайла + ", Файл.Расширение КАК Расширение";
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	" + ПоляФайла + "
	|ИЗ
	|	Справочник.Файлы КАК Файл
	|ГДЕ
	|	Файл." + ИмяВладельца + " = &Документ
	|	И НЕ Файл.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Файл.Ссылка УБЫВ";
	Запрос.УстановитьПараметр("Документ", Документ);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Версия = ВерсияФайла(Выборка.Ссылка, Выборка);
	Если Версия = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	ИмяФайла = СокрЛП(Выборка.Наименование);
	Расширение = "";
	Если РеквизитЕстьУСправочника("Файлы", "ТекущаяВерсияРасширение") Тогда
		Расширение = СокрЛП(Выборка.ТекущаяВерсияРасширение);
	КонецЕсли;
	Если ПустаяСтрока(Расширение) И РеквизитЕстьУСправочника("Файлы", "Расширение") Тогда
		Расширение = СокрЛП(Выборка.Расширение);
	КонецЕсли;
	Если ПустаяСтрока(Расширение) Тогда
		Расширение = СокрЛП(ЗначениеРеквизита(Версия, "Расширение"));
	КонецЕсли;
	Если Не ПустаяСтрока(Расширение) И Найти(НРег(ИмяФайла), "." + НРег(Расширение)) = 0 Тогда
		ИмяФайла = ИмяФайла + "." + Расширение;
	КонецЕсли;
	Если ПустаяСтрока(ИмяФайла) Тогда
		ИмяФайла = "document.bin";
	КонецЕсли;

	ДвоичныеДанные = ДвоичныеДанныеВерсии(Версия);
	Если ДвоичныеДанные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Новый Структура(
		"ДвоичныеДанные,ИмяФайла,MIME,Хеш",
		ДвоичныеДанные,
		ИмяФайла,
		MIMEПоРасширению(ИмяФайла),
		ХешДвоичныхДанных(ДвоичныеДанные));
КонецФункции

// Возвращает текст документа из Содержания и ключевых реквизитов.
Функция ТекстДокумента(Документ) Экспорт
	Части = Новый Массив;
	ДобавитьНепустуюЧасть(Части, ЗаголовокДокумента(Документ));
	Вид = ВидДокумента(Документ);
	Если Не ПустаяСтрока(Вид) Тогда
		ДобавитьНепустуюЧасть(Части, "Вид документа: " + Вид);
	КонецЕсли;
	Номер = НомерДокумента(Документ);
	Если Не ПустаяСтрока(Номер) Тогда
		ДобавитьНепустуюЧасть(Части, "Номер: " + Номер);
	КонецЕсли;

	Для Каждого ИмяПоля Из СтрРазделить(
		"Содержание,Описание,Текст,КраткоеСодержание,Тема",
		",") Цикл
		Если РеквизитЕсть(Документ, ИмяПоля) Тогда
			Значение = ЗначениеРеквизита(Документ, ИмяПоля);
			Если ТипЗнч(Значение) = Тип("Строка") И Не ПустаяСтрока(Значение) Тогда
				ДобавитьНепустуюЧасть(Части, Значение);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат СтрСоединить(Части, Символы.ПС + Символы.ПС);
КонецФункции

// Возвращает человекочитаемый вид источника.
Функция ВидПоТипу(ТипИсточника) Экспорт
	Если ТипИсточника = "document_incoming" Тогда
		Возврат "Входящий";
	ИначеЕсли ТипИсточника = "document_outgoing" Тогда
		Возврат "Исходящий";
	КонецЕсли;
	Возврат "Внутренний";
КонецФункции

// Возвращает тип источника для RAG.
Функция ТипИсточникаПоДокументу(Документ) Экспорт
	Если Не ЗначениеЗаполнено(Документ) Тогда
		Возврат "";
	КонецЕсли;
	МетаданныеОбъекта = Метаданные.НайтиПоТипу(ТипЗнч(Документ));
	Если МетаданныеОбъекта = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Если МетаданныеОбъекта.Имя = "ВнутренниеДокументы" Тогда
		Возврат "document_internal";
	ИначеЕсли МетаданныеОбъекта.Имя = "ВходящиеДокументы" Тогда
		Возврат "document_incoming";
	ИначеЕсли МетаданныеОбъекта.Имя = "ИсходящиеДокументы" Тогда
		Возврат "document_outgoing";
	КонецЕсли;
	Возврат "";
КонецФункции

// Возвращает ссылку на документ по типу источника и идентификатору.
Функция ДокументПоИдентификатору(ТипИсточника, Идентификатор) Экспорт
	Возврат НайтиДокументПоИдентификатору(ТипИсточника, Идентификатор);
КонецФункции

// Возвращает кандидатов в версии: карточки с одинаковым видом и похожим
// заголовком, которые не связаны явными связями версий. Решение принимает
// администратор; автоматически документы не скрываются.
//
// Параметры:
//  МаксимумГрупп - Число - ограничение числа групп в отчёте.
//
// Возвращаемое значение:
//  ТаблицаЗначений - колонки Ключ, ТипИсточника, Вид, Документ, Заголовок,
//                    Номер, Дата, Состояние, Финальный.
Функция ОтчетВозможныхВерсий(МаксимумГрупп = 50) Экспорт
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Ключ");
	Результат.Колонки.Добавить("ТипИсточника");
	Результат.Колонки.Добавить("Вид");
	Результат.Колонки.Добавить("Документ");
	Результат.Колонки.Добавить("Заголовок");
	Результат.Колонки.Добавить("Номер");
	Результат.Колонки.Добавить("Дата", Новый ОписаниеТипов("Дата"));
	Результат.Колонки.Добавить("Состояние");
	Результат.Колонки.Добавить("Финальный", Новый ОписаниеТипов("Булево"));

	Связанные = СвязанныеДокументыВерсий();
	Группы = Новый Соответствие;

	Для Каждого ОписаниеИсточника Из ИсточникиИндексации() Цикл
		Поля = ПоляОтчетаВерсий(ОписаниеИсточника.ИмяСправочника);
		Если Поля.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	" + СтрСоединить(Поля, ", ") + "
		|ИЗ
		|	Справочник." + ОписаниеИсточника.ИмяСправочника + " КАК Документ";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.ПометкаУдаления Тогда
				Продолжить;
			КонецЕсли;
			ЕстьДолжность = Ложь;
			Если РеквизитЕстьВВыборке(Выборка, "АИС_Должность") Тогда
				ЕстьДолжность = ЗначениеЗаполнено(Выборка.АИС_Должность);
			КонецЕсли;
			Если ЕстьДолжность Тогда
				Продолжить;
			КонецЕсли;
			Заголовок = СтрокаПоляВыборки(Выборка, "Заголовок");
			Если ПустаяСтрока(Заголовок) Тогда
				Заголовок = СтрокаПоляВыборки(Выборка, "Наименование");
			КонецЕсли;
			Если ПустаяСтрока(Заголовок) Тогда
				Продолжить;
			КонецЕсли;
			Вид = СтрокаПоляВыборки(Выборка, "ВидДокумента");
			Ключ = ОписаниеИсточника.ТипИсточника + "|"
				+ НормализованныйКлюч(Вид) + "|" + НормализованныйКлюч(Заголовок);
			Если Группы.Получить(Ключ) = Неопределено Тогда
				Группы.Вставить(Ключ, Новый Массив);
			КонецЕсли;
			Элемент = Новый Структура;
			Элемент.Вставить("ТипИсточника", ОписаниеИсточника.ТипИсточника);
			Элемент.Вставить("Вид", Вид);
			Элемент.Вставить("Документ", Выборка.Ссылка);
			Элемент.Вставить("Заголовок", Заголовок);
			Элемент.Вставить("Номер", СтрокаПоляВыборки(Выборка, "Номер"));
			Элемент.Вставить("Дата", ЗначениеПоляВыборки(Выборка, "Дата"));
			Элемент.Вставить(
				"СвязиВерсий",
				Связанные.Получить(Строка(Выборка.Ссылка.УникальныйИдентификатор())) <> Неопределено);
			Группы.Получить(Ключ).Добавить(Элемент);
		КонецЦикла;
	КонецЦикла;

	КоличествоГрупп = 0;
	Для Каждого КлючИЗначение Из Группы Цикл
		Если КоличествоГрупп >= МаксимумГрупп Тогда
			Прервать;
		КонецЕсли;
		Элементы = КлючИЗначение.Значение;
		Если Элементы.Количество() < 2 Тогда
			Продолжить;
		КонецЕсли;
		ЕстьФинальный = Ложь;
		ЕстьСвязь = Ложь;
		Для Каждого Элемент Из Элементы Цикл
			Если Элемент.СвязиВерсий Тогда
				ЕстьСвязь = Истина;
				Прервать;
			КонецЕсли;
			Финальность = ФинальноеСостояние(Элемент.Документ);
			Элемент.Вставить("Состояние", Финальность.Состояние);
			Элемент.Вставить("Финальный", Финальность.Финальный);
			ЕстьФинальный = ЕстьФинальный ИЛИ Финальность.Финальный;
		КонецЦикла;
		Если ЕстьСвязь ИЛИ Не ЕстьФинальный Тогда
			Продолжить;
		КонецЕсли;
		КоличествоГрупп = КоличествоГрупп + 1;
		Для Каждого Элемент Из Элементы Цикл
			Строка = Результат.Добавить();
			Строка.Ключ = КлючИЗначение.Ключ;
			Строка.ТипИсточника = Элемент.ТипИсточника;
			Строка.Вид = Элемент.Вид;
			Строка.Документ = Элемент.Документ;
			Строка.Заголовок = Элемент.Заголовок;
			Строка.Номер = Элемент.Номер;
			Строка.Дата = ?(ТипЗнч(Элемент.Дата) = Тип("Дата"), Элемент.Дата, '00010101');
			Строка.Состояние = ?(Элемент.Свойство("Состояние"), Элемент.Состояние, "");
			Строка.Финальный = ?(Элемент.Свойство("Финальный"), Элемент.Финальный, Ложь);
		КонецЦикла;
	КонецЦикла;

	Результат.Сортировать("ТипИсточника, Заголовок");
	Возврат Результат;
КонецФункции

// Собирает текстовый отчёт для этапа 0: фактические состояния документов,
// используемые типы связей, поля файлов, рабочие группы и очередь индексации.
//
// Возвращаемое значение:
//  Строка - многострочный отчёт.
Функция ИнвентаризацияИндексации() Экспорт
	Строки = Новый Массив;
	Строки.Добавить("Инвентаризация документов для RAG");
	Строки.Добавить("Дата: " + Формат(ТекущаяДатаСеанса(), "ДФ=yyyy-MM-dd HH:mm:ss"));
	Строки.Добавить("");

	КэшФинальных = Новый Соответствие;
	КэшФинальных.Вставить("document_internal", ФинальныеСостояния("document_internal"));
	КэшФинальных.Вставить("document_incoming", ФинальныеСостояния("document_incoming"));
	КэшФинальных.Вставить("document_outgoing", ФинальныеСостояния("document_outgoing"));
	КэшФинальных.Вставить("job_description", ФинальныеСостояния("job_description"));

	ВсегоДокументов = 0;
	Для Каждого ОписаниеИсточника Из ИсточникиИндексации() Цикл
		Итоги = ИнвентаризацияИсточника(ОписаниеИсточника, КэшФинальных);
		ВсегоДокументов = ВсегоДокументов + Итоги.Всего;
		Строки.Добавить(ОписаниеИсточника.ИмяСправочника
			+ " (" + ОписаниеИсточника.ТипИсточника + "):");
		Строки.Добавить("  всего: " + Итоги.Всего
			+ ", помечено удаления: " + Итоги.ПометкаУдаления
			+ ", НеДействует: " + Итоги.НеДействует);
		Строки.Добавить("  финальных: " + Итоги.Финальных
			+ ", с файлом: " + Итоги.СФайлом
			+ ?(ОписаниеИсточника.ТипИсточника = "document_internal",
				", должностных инструкций: " + Итоги.СДолжностью,
				""));
		Строки.Добавить("  состояния:");
		Для Каждого СостояниеИКоличество Из Итоги.Состояния Цикл
			Строки.Добавить("    " + СостояниеИКоличество.Ключ
				+ ": " + СостояниеИКоличество.Значение);
		КонецЦикла;
		Строки.Добавить("");
	КонецЦикла;

	Строки.Добавить("Всего документов: " + ВсегоДокументов);
	Строки.Добавить("");

	Строки.Добавить("Связи документов по типам:");
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Связи.ТипСвязи КАК ТипСвязи,
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	РегистрСведений.СвязиДокументов КАК Связи
	|СГРУППИРОВАТЬ ПО
	|	Связи.ТипСвязи
	|УПОРЯДОЧИТЬ ПО
	|	Количество УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строки.Добавить("  " + Строка(Выборка.ТипСвязи) + ": " + Выборка.Количество);
	КонецЦикла;
	Строки.Добавить("  версионные: НеДействуетВСоответствии, ДелаетНедействующим");
	Строки.Добавить("");

	Строки.Добавить("Файлы:");
	ИмяВладельцаФайла = ИмяРеквизитаВладельцаФайла();
	Строки.Добавить("  реквизит владельца: "
		+ ?(ПустаяСтрока(ИмяВладельцаФайла), "<не найден>", ИмяВладельцаФайла));
	Строки.Добавить("  ТекущаяВерсия: "
		+ ?(РеквизитЕстьУСправочника("Файлы", "ТекущаяВерсия"), "есть", "нет"));
	Строки.Добавить("  ТекущаяВерсияРасширение: "
		+ ?(РеквизитЕстьУСправочника("Файлы", "ТекущаяВерсияРасширение"), "есть", "нет"));
	Строки.Добавить("  Расширение: "
		+ ?(РеквизитЕстьУСправочника("Файлы", "Расширение"), "есть", "нет"));
	Строки.Добавить("  файлов: " + КоличествоЗаписей("Справочник.Файлы")
		+ ", версий: " + КоличествоЗаписей("Справочник.ВерсииФайлов"));
	Строки.Добавить("");

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Записей,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ РабочиеГруппы.Объект) КАК Объектов,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ РабочиеГруппы.Участник) КАК Участников
	|ИЗ
	|	РегистрСведений.РабочиеГруппы КАК РабочиеГруппы";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Строки.Добавить("Рабочие группы: записей " + Выборка.Записей
			+ ", объектов " + Выборка.Объектов
			+ ", участников " + Выборка.Участников);
	КонецЕсли;
	Строки.Добавить("");

	Строки.Добавить("Очередь индексации:");
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Состояния.Состояние КАК Состояние,
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	РегистрСведений.АИС_СостоянияИндексации КАК Состояния
	|ГДЕ
	|	Состояния.ТипИсточника <> &Системный
	|СГРУППИРОВАТЬ ПО
	|	Состояния.Состояние
	|УПОРЯДОЧИТЬ ПО
	|	Количество УБЫВ";
	Запрос.УстановитьПараметр("Системный", "system");
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строки.Добавить("  " + Выборка.Состояние + ": " + Выборка.Количество);
	КонецЦикла;

	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ИсточникиИндексации()
	Результат = Новый Массив;
	Результат.Добавить(Новый Структура(
		"ТипИсточника,ИмяСправочника",
		"document_internal",
		"ВнутренниеДокументы"));
	Результат.Добавить(Новый Структура(
		"ТипИсточника,ИмяСправочника",
		"document_incoming",
		"ВходящиеДокументы"));
	Результат.Добавить(Новый Структура(
		"ТипИсточника,ИмяСправочника",
		"document_outgoing",
		"ИсходящиеДокументы"));
	Возврат Результат;
КонецФункции

Функция ИнвентаризацияИсточника(ОписаниеИсточника, КэшФинальных)
	Итоги = Новый Структура;
	Итоги.Вставить("Всего", 0);
	Итоги.Вставить("ПометкаУдаления", 0);
	Итоги.Вставить("НеДействует", 0);
	Итоги.Вставить("Финальных", 0);
	Итоги.Вставить("СФайлом", 0);
	Итоги.Вставить("СДолжностью", 0);
	Итоги.Вставить("Состояния", Новый Соответствие);

	Поля = Новый Массив;
	Поля.Добавить("Документ.Ссылка КАК Ссылка");
	Поля.Добавить("Документ.ПометкаУдаления КАК ПометкаУдаления");
	Для Каждого ИмяПоля Из СтрРазделить("НеДействует,АИС_Должность", ",") Цикл
		Если РеквизитЕстьУСправочника(ОписаниеИсточника.ИмяСправочника, ИмяПоля) Тогда
			Поля.Добавить("Документ." + ИмяПоля + " КАК " + ИмяПоля);
		КонецЕсли;
	КонецЦикла;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	" + СтрСоединить(Поля, ", ") + "
	|ИЗ
	|	Справочник." + ОписаниеИсточника.ИмяСправочника + " КАК Документ";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Итоги.Всего = Итоги.Всего + 1;
		Если Выборка.ПометкаУдаления Тогда
			Итоги.ПометкаУдаления = Итоги.ПометкаУдаления + 1;
		КонецЕсли;

		НеДействует = Ложь;
		Если РеквизитЕстьВВыборке(Выборка, "НеДействует") Тогда
			НеДействует = Выборка.НеДействует = Истина;
			Если НеДействует Тогда
				Итоги.НеДействует = Итоги.НеДействует + 1;
			КонецЕсли;
		КонецЕсли;

		КлючФинальности = ОписаниеИсточника.ТипИсточника;
		ЕстьДолжность = Ложь;
		Если РеквизитЕстьВВыборке(Выборка, "АИС_Должность") Тогда
			ЕстьДолжность = ЗначениеЗаполнено(Выборка.АИС_Должность);
		КонецЕсли;
		Если ЕстьДолжность Тогда
			КлючФинальности = "job_description";
			Итоги.СДолжностью = Итоги.СДолжностью + 1;
		КонецЕсли;

		Состояние = "";
		Попытка
			Состояние = Строка(Делопроизводство.ПолучитьСостояниеДокумента(Выборка.Ссылка));
		Исключение
			Состояние = "";
		КонецПопытки;
		Если Не ПустаяСтрока(Состояние) Тогда
			ДобавитьКоличествоВСоответствие(Итоги.Состояния, Состояние);
		Иначе
			ДобавитьКоличествоВСоответствие(Итоги.Состояния, "<без состояния>");
		КонецЕсли;

		Допустимые = КэшФинальных.Получить(КлючФинальности);
		Финальный = Ложь;
		Если Не Выборка.ПометкаУдаления
			И Не НеДействует
			И Допустимые <> Неопределено Тогда
			Финальный = Допустимые.Найти(Состояние) <> Неопределено;
		КонецЕсли;
		Если Финальный Тогда
			Итоги.Финальных = Итоги.Финальных + 1;
		КонецЕсли;
	КонецЦикла;

	ИмяВладельца = ИмяРеквизитаВладельцаФайла();
	Если Не ПустаяСтрока(ИмяВладельца) Тогда
		ЗапросФайлов = Новый Запрос;
		ЗапросФайлов.Текст =
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Файлы." + ИмяВладельца + ") КАК Количество
		|ИЗ
		|	Справочник.Файлы КАК Файлы
		|ГДЕ
		|	НЕ Файлы.ПометкаУдаления
		|	И Файлы." + ИмяВладельца + " В
		|		(ВЫБРАТЬ
		|			Документы.Ссылка
		|		ИЗ
		|			Справочник." + ОписаниеИсточника.ИмяСправочника + " КАК Документы)";
		ВыборкаФайлов = ЗапросФайлов.Выполнить().Выбрать();
		Если ВыборкаФайлов.Следующий() Тогда
			Итоги.СФайлом = ВыборкаФайлов.Количество;
		КонецЕсли;
	КонецЕсли;

	Возврат Итоги;
КонецФункции

Процедура ДобавитьКоличествоВСоответствие(Соответствие, Ключ)
	Текущее = Соответствие.Получить(Ключ);
	Соответствие.Вставить(Ключ, ?(Текущее = Неопределено, 1, Текущее + 1));
КонецПроцедуры

Функция КоличествоЗаписей(ПолноеИмя)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество ИЗ " + ПолноеИмя;
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	КонецЕсли;
	Возврат 0;
КонецФункции

Функция ПоляОтчетаВерсий(ИмяСправочника)
	Поля = Новый Массив;
	Поля.Добавить("Документ.Ссылка КАК Ссылка");
	Поля.Добавить("Документ.ПометкаУдаления КАК ПометкаУдаления");
	Для Каждого ИмяПоля Из СтрРазделить(
		"Заголовок,Наименование,ВидДокумента,Номер,Дата,АИС_Должность",
		",") Цикл
		Если РеквизитЕстьУСправочника(ИмяСправочника, ИмяПоля) Тогда
			Поля.Добавить("Документ." + ИмяПоля + " КАК " + ИмяПоля);
		КонецЕсли;
	КонецЦикла;
	Возврат Поля;
КонецФункции

Функция РеквизитЕстьВВыборке(Выборка, ИмяПоля)
	Попытка
		Значение = Выборка[ИмяПоля];
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция ЗначениеПоляВыборки(Выборка, ИмяПоля)
	Попытка
		Возврат Выборка[ИмяПоля];
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

Функция СтрокаПоляВыборки(Выборка, ИмяПоля)
	Значение = ЗначениеПоляВыборки(Выборка, ИмяПоля);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));
КонецФункции

Функция НормализованныйКлюч(Значение)
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Текст = НРег(Строка(Значение));
	Текст = СтрЗаменить(Текст, "ё", "е");
	Разделители = ".,;:!?()[]{}-/+*""'«»№#";
	Для Индекс = 1 По СтрДлина(Разделители) Цикл
		Текст = СтрЗаменить(Текст, Сред(Разделители, Индекс, 1), " ");
	КонецЦикла;
	Пока Найти(Текст, "  ") > 0 Цикл
		Текст = СтрЗаменить(Текст, "  ", " ");
	КонецЦикла;
	Возврат СокрЛП(Текст);
КонецФункции

Функция СвязанныеДокументыВерсий()
	Результат = Новый Соответствие;
	Типы = ТипыСвязейВерсий();
	Если Типы.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Связи.Документ КАК Документ,
	|	Связи.СвязанныйДокумент КАК СвязанныйДокумент
	|ИЗ
	|	РегистрСведений.СвязиДокументов КАК Связи
	|ГДЕ
	|	Связи.ТипСвязи В (&Типы)";
	Запрос.УстановитьПараметр("Типы", Типы);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ЗначениеЗаполнено(Выборка.Документ) Тогда
			Результат.Вставить(
				Строка(Выборка.Документ.УникальныйИдентификатор()),
				Истина);
		КонецЕсли;
		Если ЗначениеЗаполнено(Выборка.СвязанныйДокумент) Тогда
			Результат.Вставить(
				Строка(Выборка.СвязанныйДокумент.УникальныйИдентификатор()),
				Истина);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция КомпонентаСемейства(Документ)
	Компонента = Новый Массив;
	Посещённые = Новый Соответствие;
	ДобавитьВКомпонентуСемейства(Документ, Компонента, Посещённые);
	Возврат Компонента;
КонецФункции

Процедура ДобавитьВКомпонентуСемейства(Документ, Компонента, Посещённые)
	Ключ = Строка(Документ.УникальныйИдентификатор());
	Если Посещённые.Получить(Ключ) <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	Посещённые.Вставить(Ключ, Истина);
	Компонента.Добавить(Документ);
	Для Каждого Связанный Из СвязанныеВерсии(Документ) Цикл
		Если ЗначениеЗаполнено(Связанный) Тогда
			ДобавитьВКомпонентуСемейства(Связанный, Компонента, Посещённые);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция СвязанныеВерсии(Документ)
	Типы = ТипыСвязейВерсий();
	Если Типы.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Связи.СвязанныйДокумент КАК СвязанныйДокумент
	|ИЗ
	|	РегистрСведений.СвязиДокументов КАК Связи
	|ГДЕ
	|	Связи.Документ = &Документ
	|	И Связи.ТипСвязи В (&Типы)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Связи.Документ
	|ИЗ
	|	РегистрСведений.СвязиДокументов КАК Связи
	|ГДЕ
	|	Связи.СвязанныйДокумент = &Документ
	|	И Связи.ТипСвязи В (&Типы)";
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.УстановитьПараметр("Типы", Типы);
	Выборка = Запрос.Выполнить().Выбрать();
	Результат = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Выборка.СвязанныйДокумент);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ТипыСвязейВерсий()
	Результат = Новый Массив;
	Попытка
		Результат.Добавить(Справочники.ТипыСвязей.НеДействуетВСоответствии);
		Результат.Добавить(Справочники.ТипыСвязей.ДелаетНедействующим);
	Исключение
		Возврат Новый Массив;
	КонецПопытки;
	Возврат Результат;
КонецФункции

Функция КореньСемейства(Компонента)
	Корень = Неопределено;
	ДатаКорня = '00010101';
	Для Каждого Документ Из Компонента Цикл
		ДатаДокументаЗначение = ДатаСозданияДокумента(Документ);
		Если Корень = Неопределено Тогда
			Корень = Документ;
			ДатаКорня = ДатаДокументаЗначение;
			Продолжить;
		КонецЕсли;
		Если ДатаДокументаЗначение < ДатаКорня Тогда
			Корень = Документ;
			ДатаКорня = ДатаДокументаЗначение;
		ИначеЕсли ДатаДокументаЗначение = ДатаКорня
			И Строка(Документ.УникальныйИдентификатор())
				< Строка(Корень.УникальныйИдентификатор()) Тогда
			Корень = Документ;
		КонецЕсли;
	КонецЦикла;
	Возврат Корень;
КонецФункции

Функция ДатаСозданияДокумента(Документ)
	Для Каждого ИмяПоля Из СтрРазделить(
		"ДатаСоздания,Дата,ДатаРегистрации",
		",") Цикл
		Если РеквизитЕсть(Документ, ИмяПоля) Тогда
			Значение = ЗначениеРеквизита(Документ, ИмяПоля);
			Если ТипЗнч(Значение) = Тип("Дата") И ЗначениеЗаполнено(Значение) Тогда
				Возврат Значение;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат '00010101';
КонецФункции

Функция ДокументАктуаленВСемействе(Документ, Компонента)
	ДатаТекущего = ДатаСозданияДокумента(Документ);
	ИдентификаторТекущего = Строка(Документ.УникальныйИдентификатор());
	Для Каждого Другой Из Компонента Цикл
		Если Другой = Документ Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			Если Другой.ПометкаУдаления Тогда
				Продолжить;
			КонецЕсли;
		Исключение
			Продолжить;
		КонецПопытки;
		Финальность = ФинальноеСостояние(Другой);
		Если Не Финальность.Финальный Тогда
			Продолжить;
		КонецЕсли;
		ДатаДругого = ДатаСозданияДокумента(Другой);
		ИдентификаторДругого = Строка(Другой.УникальныйИдентификатор());
		Если ДатаДругого > ДатаТекущего
			ИЛИ (ДатаДругого = ДатаТекущего
				И ИдентификаторДругого > ИдентификаторТекущего) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ФинальныеСостояния(ТипИсточника, Документ = Неопределено)
	Ключ = ТипИсточника;
	Если Документ <> Неопределено И РеквизитЕсть(Документ, "АИС_Должность") Тогда
		Если ЗначениеЗаполнено(ЗначениеРеквизита(Документ, "АИС_Должность")) Тогда
			Ключ = "job_description";
		КонецЕсли;
	КонецЕсли;

	ТекстНастроек = СокрЛП(Константы.АИС_НастройкиИндексацииДокументов.Получить());
	Если Не ПустаяСтрока(ТекстНастроек) Тогда
		Попытка
			Чтение = Новый ЧтениеJSON;
			Чтение.УстановитьСтроку(ТекстНастроек);
			Данные = ПрочитатьJSON(Чтение, Ложь);
			Чтение.Закрыть();
			Значение = АИС_ИнтеграцияСRAG.ЗначениеJSON(Данные, Ключ);
			Если ТипЗнч(Значение) = Тип("Массив") И Значение.Количество() > 0 Тогда
				Возврат Значение;
			КонецЕсли;
		Исключение
			ЗаписатьОшибкуПодписки("ФинальныеСостояния", ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;

	Результат = Новый Массив;
	Если Ключ = "document_incoming" Тогда
		Результат.Добавить("Зарегистрирован");
		Результат.Добавить("Исполнен");
	ИначеЕсли Ключ = "document_outgoing" Тогда
		Результат.Добавить("Подписан");
		Результат.Добавить("Отправлен");
	Иначе
		Результат.Добавить("Утвержден");
		Результат.Добавить("Утверждён");
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция КаноническийСтатус(Состояние, НеДействует = Ложь, ПометкаУдаления = Ложь)
	Если ПометкаУдаления Тогда
		Возврат "archived";
	КонецЕсли;
	Если НеДействует Тогда
		Возврат "cancelled";
	КонецЕсли;
	Нормализованное = НРег(СтрЗаменить(СокрЛП(Состояние), " ", ""));
	Если Нормализованное = "утвержден" ИЛИ Нормализованное = "утверждён" Тогда
		Возврат "approved";
	ИначеЕсли Нормализованное = "подписан" Тогда
		Возврат "signed";
	ИначеЕсли Нормализованное = "отправлен" Тогда
		Возврат "sent";
	ИначеЕсли Нормализованное = "зарегистрирован" Тогда
		Возврат "registered";
	ИначеЕсли Нормализованное = "исполнен" Тогда
		Возврат "executed";
	ИначеЕсли Найти(Нормализованное, "согласован") > 0 ИЛИ Найти(Нормализованное, "утвержд") > 0 Тогда
		Возврат "in_review";
	ИначеЕсли Нормализованное = "отменен" ИЛИ Нормализованное = "отменён" ИЛИ Нормализованное = "недействует" Тогда
		Возврат "cancelled";
	ИначеЕсли Нормализованное = "устарел" Тогда
		Возврат "superseded";
	КонецЕсли;
	Возврат "draft";
КонецФункции

Функция ЗаголовокДокумента(Документ)
	Для Каждого ИмяПоля Из СтрРазделить("Заголовок,Наименование,Тема", ",") Цикл
		Если РеквизитЕсть(Документ, ИмяПоля) Тогда
			Значение = ЗначениеРеквизита(Документ, ИмяПоля);
			Если ТипЗнч(Значение) = Тип("Строка") И Не ПустаяСтрока(Значение) Тогда
				Возврат СокрЛП(Значение);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат "Документ " + Строка(Документ.УникальныйИдентификатор());
КонецФункции

