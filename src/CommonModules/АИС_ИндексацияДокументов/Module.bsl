Функция ПрочитатьСостояние(ТипИсточника, Идентификатор)
	Менеджер = РегистрыСведений.АИС_СостоянияИндексации.СоздатьМенеджерЗаписи();
	Менеджер.ТипИсточника = ТипИсточника;
	Менеджер.Идентификатор = Идентификатор;
	Менеджер.Прочитать();
	Возврат Новый Структура(
		"ХешСодержимого,ХешACL,ВерсияСодержимого,Семейство,Состояние",
		Менеджер.ХешСодержимого,
		Менеджер.ХешACL,
		Менеджер.ВерсияСодержимого,
		Менеджер.Семейство,
		Менеджер.Состояние);
КонецФункции

Процедура ЗаписатьСостояние(ТипИсточника, Идентификатор, Состояние, Семейство, Версия, ХешACL, Попытки, Ошибка)
	Менеджер = РегистрыСведений.АИС_СостоянияИндексации.СоздатьМенеджерЗаписи();
	Менеджер.ТипИсточника = ТипИсточника;
	Менеджер.Идентификатор = Идентификатор;
	Менеджер.Прочитать();
	Менеджер.Состояние = Состояние;
	Менеджер.Семейство = Семейство;
	Менеджер.ВерсияСодержимого = Версия;
	Менеджер.ХешСодержимого = Версия;
	Менеджер.ХешACL = ХешACL;
	Менеджер.Попытки = ?(Попытки > 0, Менеджер.Попытки + Попытки, 0);
	Менеджер.Ошибка = Ошибка;
	Менеджер.ДатаИндексации = ТекущаяДатаСеанса();
	Менеджер.Заблокировано = "";
	Менеджер.ДатаБлокировки = '00010101';
	Менеджер.Записать();
КонецПроцедуры

Функция НайтиДокументПоИдентификатору(ТипИсточника, Идентификатор)
	Если ТипИсточника = "document_internal" Тогда
		ИмяСправочника = "ВнутренниеДокументы";
	ИначеЕсли ТипИсточника = "document_incoming" Тогда
		ИмяСправочника = "ВходящиеДокументы";
	ИначеЕсли ТипИсточника = "document_outgoing" Тогда
		ИмяСправочника = "ИсходящиеДокументы";
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		ИдентификаторСсылки = Новый УникальныйИдентификатор(Идентификатор);
		Если ТипИсточника = "document_internal" Тогда
			Ссылка = Справочники.ВнутренниеДокументы.ПолучитьСсылку(ИдентификаторСсылки);
		ИначеЕсли ТипИсточника = "document_incoming" Тогда
			Ссылка = Справочники.ВходящиеДокументы.ПолучитьСсылку(ИдентификаторСсылки);
		Иначе
			Ссылка = Справочники.ИсходящиеДокументы.ПолучитьСсылку(ИдентификаторСсылки);
		КонецЕсли;
		Если Ссылка.Пустая() Тогда
			Возврат Неопределено;
		КонецЕсли;
		Возврат Ссылка;
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция ВладелецДокументаФайла(Ссылка)
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	МетаданныеОбъекта = Метаданные.НайтиПоТипу(ТипЗнч(Ссылка));
	Если МетаданныеОбъекта = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если МетаданныеОбъекта.Имя = "ВерсииФайлов" Тогда
		Для Каждого ИмяПоля Из СтрРазделить("Владелец,Файл", ",") Цикл
			Если РеквизитЕстьПоМетаданным(МетаданныеОбъекта, ИмяПоля) Тогда
				Владелец = ЗначениеРеквизита(Ссылка, ИмяПоля);
				Если ЗначениеЗаполнено(Владелец) Тогда
					Если Не ПустаяСтрока(ТипИсточникаПоДокументу(Владелец)) Тогда
						Возврат Владелец;
					КонецЕсли;
					Возврат ВладелецДокументаФайла(Владелец);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		Возврат Неопределено;
	КонецЕсли;
	Если МетаданныеОбъекта.Имя = "Файлы" Тогда
		Для Каждого ИмяПоля Из СтрРазделить("Владелец,ВладелецФайла,Объект", ",") Цикл
			Если РеквизитЕстьПоМетаданным(МетаданныеОбъекта, ИмяПоля) Тогда
				Владелец = ЗначениеРеквизита(Ссылка, ИмяПоля);
				Если ЗначениеЗаполнено(Владелец) Тогда
					ТипВладельца = ТипИсточникаПоДокументу(Владелец);
					Если Не ПустаяСтрока(ТипВладельца) Тогда
						Возврат Владелец;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ВерсияФайла(Файл, ВыборкаФайла)
	Если РеквизитЕстьУСправочника("Файлы", "ТекущаяВерсия") Тогда
		ТекущаяВерсия = ВыборкаФайла.ТекущаяВерсия;
		Если ЗначениеЗаполнено(ТекущаяВерсия) Тогда
			Возврат ТекущаяВерсия;
		КонецЕсли;
	КонецЕсли;

	ИмяВладельца = "";
	Для Каждого ИмяПоля Из СтрРазделить("Владелец,Файл", ",") Цикл
		Если РеквизитЕстьУСправочника("ВерсииФайлов", ИмяПоля) Тогда
			ИмяВладельца = ИмяПоля;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ПустаяСтрока(ИмяВладельца) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Версии.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВерсииФайлов КАК Версии
	|ГДЕ
	|	Версии." + ИмяВладельца + " = &Файл
	|УПОРЯДОЧИТЬ ПО
	|	Версии.НомерВерсии УБЫВ";
	Запрос.УстановитьПараметр("Файл", Файл);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ДвоичныеДанныеВерсии(Версия)
	Для Каждого ИмяПоля Из СтрРазделить(
		"ХранилищеФайла,ФайлХранилище,ДанныеФайла,Хранилище",
		",") Цикл
		Если Не РеквизитЕсть(Версия, ИмяПоля) Тогда
			Продолжить;
		КонецЕсли;
		Значение = ЗначениеРеквизита(Версия, ИмяПоля);
		Если Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Если ТипЗнч(Значение) = Тип("ХранилищеЗначения") Тогда
			Возврат Значение.Получить();
		ИначеЕсли ТипЗнч(Значение) = Тип("ДвоичныеДанные") Тогда
			Возврат Значение;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция ИмяРеквизитаВладельцаФайла()
	Для Каждого ИмяПоля Из СтрРазделить("Владелец,ВладелецФайла,Объект", ",") Цикл
		Если РеквизитЕстьУСправочника("Файлы", ИмяПоля) Тогда
			Возврат ИмяПоля;
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция РеквизитЕсть(Ссылка, ИмяРеквизита)
	Попытка
		МетаданныеОбъекта = Метаданные.НайтиПоТипу(ТипЗнч(Ссылка));
		Возврат РеквизитЕстьПоМетаданным(МетаданныеОбъекта, ИмяРеквизита);
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция РеквизитЕстьПоМетаданным(МетаданныеОбъекта, ИмяРеквизита)
	Если МетаданныеОбъекта = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат МетаданныеОбъекта.Реквизиты.Найти(ИмяРеквизита) <> Неопределено;
КонецФункции

Функция РеквизитЕстьУСправочника(ИмяСправочника, ИмяРеквизита)
