#Область ПрограммныйИнтерфейс

// Обработчик подписки на событие АИС_ВнутреннийДокументПриЗаписи
// (Catalog.ВнутренниеДокументы, OnWrite). Первый, самый простой шаг
// оповещения: если у внутреннего документа заполнен "Адресат", адресат
// получает обычную задачу исполнителя с ссылкой на документ в названии.
// Пока без классификации по АИС_ТипыТриггеров/АИС_ТипыДействий и без
// АИС_КонтекстЗадачИИ — это следующий шаг, после того как сама доставка
// уведомления проверена и видна в интерфейсе адресата.
Процедура ВнутреннийДокументПриЗаписи(Источник, Отказ) Экспорт
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Источник.Адресат) Тогда
		Возврат;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	Наименование = "Ознакомиться: " + Источник.Заголовок;
	АИС_ОбщегоНазначения.НайтиИлиСоздатьЗадачу(Источник.Адресат, Наименование, Источник.Содержание);
КонецПроцедуры

#КонецОбласти
