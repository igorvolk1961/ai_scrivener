#Область ПрограммныйИнтерфейс

// Обработчик подписки на событие АИС_ВнутреннийДокументПриЗаписи
// (Catalog.ВнутренниеДокументы, OnWrite). Если у внутреннего документа
// заполнен "Адресат" - адресат получает задачу исполнителя с полным
// текстом документа. Это формальный триггер
// (docs/data-model.md §7: "Триггеры... создают базовую задачу и запись
// АИС_КонтекстЗадачИИ") - классифицируется через АИС_ТипыТриггеров/
// АИС_ТипыДействий, классификация пишется в АИС_КонтекстЗадачИИ вместе с
// результатом автоматического поиска шаблонов
// (НайтиШаблоныВнутреннихДокументов) - решение, использовать ли найденное
// (и какой из кандидатов), остаётся за исполнителем задачи (или его
// симулятором): серверный поиск - это подсказка, не выбор за него.
//
// Должностные обязанности исполнителя сюда намеренно не примешиваются:
// неверно, если ЛЮБОЙ исполнитель любой задачи начинает запрашивать у
// начальника должностную инструкцию только потому, что её нет в базе (так
// не делают в жизни). Вместо этого обязанности нужны конкретно HR в
// процессе найма - см. ОбработатьЗаявкуНаНайм ниже и
// plans/2026-10-26-enterprise-simulator.md.
Процедура ВнутреннийДокументПриЗаписи(Источник, Отказ) Экспорт
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);

	ВидДокументаНаименование = "";
	Если ЗначениеЗаполнено(Источник.ВидДокумента) Тогда
		ВидДокументаНаименование = Источник.ВидДокумента.Наименование;
	КонецЕсли;

	Если ВидДокументаНаименование = "Заявка на найм" Тогда
		// Заявка на найм обрабатывается отдельным сценарием (см.
		// ОбработатьЗаявкуНаНайм) - не обычным "Ознакомиться": пока
		// зарплатная вилка не согласована бухгалтером, адресату (HR)
		// задача вообще не ставится, вместо неё - задача Главному
		// Бухгалтеру.
		ОбработатьЗаявкуНаНайм(Источник.Ссылка);
	Иначе
		Если ЗначениеЗаполнено(Источник.Адресат) Тогда
			ТипТриггера = АИС_ОбщегоНазначения.НайтиИлиСоздатьТипТриггера("ВнутреннийДокументАдресованДЛ");
			ТипДействия = АИС_ОбщегоНазначения.НайтиИлиСоздатьТипДействия(
				"ОзнакомитьсяИИсполнить", Перечисления.ТипыОбъектов.ВнутренниеДокументы);

			Наименование = "Ознакомиться: " + Источник.Заголовок;
			Задача = АИС_ОбщегоНазначения.НайтиИлиСоздатьЗадачу(Источник.Адресат, Наименование, Источник.Содержание);

			Кандидаты = АИС_ОбщегоНазначения.НайтиШаблоныВнутреннихДокументов(Источник.ВидДокумента);
			АИС_ОбщегоНазначения.СохранитьКонтекстЗадачи(Задача, ТипТриггера, ТипДействия, Кандидаты);
		КонецЕсли;

		Если ВидДокументаНаименование = "Должностная инструкция" И ЗначениеЗаполнено(Источник.АИС_Должность) Тогда
			// Могла прийти как раз та инструкция, которую ждала одна или
			// несколько ранее согласованных бухгалтером заявок на найм -
			// пересчитываем их, не дожидаясь отдельного "пинка" (тот же
			// принцип, что и у остальных триггеров в системе).
			ПереоценитьЗаявкиОжидающиеДолжность(Источник.АИС_Должность);
		КонецЕсли;
	КонецЕсли;

	ПроверитьНеобходимостьШаблона(Источник);
КонецПроцедуры

// Обрабатывает заявку на найм (ВидДокумента.Наименование = "Заявка на
// найм") - см. решение от 2026-10-26 в
// plans/2026-10-26-enterprise-simulator.md: HR не принимает заявку
// напрямую, а сначала проверяет - через это расширение, а не силами
// симулируемого HR - два условия:
//
// 1. Зарплатная вилка согласована Главным Бухгалтером
//    (АИС_СтатусСогласованияБухгалтера). Пока статус пуст - задача
//    ставится ЕМУ, не HR: он сам решает, устраивает ли вилка как есть,
//    нужно ли её вписать (через ОбновлённыйТекст в
//    /hiring-requests/accounting-decision) или заявку отклонить. "Вилка
//    отсутствует" и "вилка не согласована" намеренно не различаются -
//    в обоих случаях решение за бухгалтером, а не за HR.
// 2. По каждой запрошенной должности (ТЧ АИС_ЗапрашиваемыеДолжности) в
//    базе есть документ "Должностная инструкция"
//    (НайтиДолжностнуюИнструкцию). Если нет - запрос уходит не
//    "вышестоящему ДЛ" вообще, а конкретно тому, кто подал эту заявку
//    (Подготовил) - он просил нанять эту позицию, ему и описывать её
//    обязанности.
//
// Только когда оба условия выполнены - HR получает обычную задачу на
// обработку найма. Вызывается при записи самой заявки и повторно
// (идемпотентно) из ПринятьРешениеБухгалтера_POST и
// ПереоценитьЗаявкиОжидающиеДолжность по мере того, как становятся
// известны недостающие сведения.
Процедура ОбработатьЗаявкуНаНайм(Заявка) Экспорт
	Если ПустаяСтрока(Заявка.АИС_СтатусСогласованияБухгалтера) Тогда
		Бухгалтер = Справочники.Пользователи.НайтиПоНаименованию("ГлавныйБухгалтер", Истина);
		Если ЗначениеЗаполнено(Бухгалтер) Тогда
			Наименование = "Согласовать зарплатную вилку: " + Заявка.Заголовок;
			Описание =
				"Поступила заявка на найм. Проверьте, указана ли зарплатная вилка по "
				+ "каждой запрашиваемой позиции, и примите решение (POST "
				+ "/hiring-requests/accounting-decision, Заявка="
				+ Строка(Заявка.УникальныйИдентификатор())
				+ ", Решение=""Согласовать"" - по необходимости с переписанным текстом в "
				+ "поле ОбновлённыйТекст, если вилку нужно вписать самому - или "
				+ "Решение=""Отклонить"" с комментарием)." + Символы.ПС + Символы.ПС
				+ "Текст заявки:" + Символы.ПС + Заявка.Содержание;
			АИС_ОбщегоНазначения.НайтиИлиСоздатьЗадачу(Бухгалтер, Наименование, Описание);
		КонецЕсли;
		Возврат;
	ИначеЕсли Заявка.АИС_СтатусСогласованияБухгалтера = "Отклонено" Тогда
		// Уведомление автору уже отправлено в момент принятия решения
		// (ПринятьРешениеБухгалтера_POST) - цепочка найма дальше не идёт.
		Возврат;
	КонецЕсли;

	НедостающиеДолжности = Новый Массив;
	Для Каждого Строка Из Заявка.АИС_ЗапрашиваемыеДолжности Цикл
		Если Не ЗначениеЗаполнено(АИС_ОбщегоНазначения.НайтиДолжностнуюИнструкцию(Строка.Должность)) Тогда
			НедостающиеДолжности.Добавить(Строка.Должность);
		КонецЕсли;
	КонецЦикла;

	Если НедостающиеДолжности.Количество() > 0 Тогда
		Если ЗначениеЗаполнено(Заявка.Подготовил) Тогда
			Перечень = "";
			Для Каждого Должность Из НедостающиеДолжности Цикл
				Перечень = Перечень + ?(Перечень = "", "", ", ") + Строка(Должность);
			КонецЦикла;
			Наименование = "Подготовьте должностные обязанности: " + Перечень;
			Описание =
				"Для найма по заявке """ + Заявка.Заголовок + """ в базе нет документа вида "
				+ """Должностная инструкция"" для: " + Перечень + ". Подготовьте текст "
				+ "обязанностей для каждой позиции (документ вида ""Должностная "
				+ "инструкция"" с заполненным полем Должность) - отдел кадров использует "
				+ "его на собеседованиях с кандидатами.";
			АИС_ОбщегоНазначения.НайтиИлиСоздатьЗадачу(Заявка.Подготовил, Наименование, Описание);
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Если ЗначениеЗаполнено(Заявка.Адресат) Тогда
		Наименование = "Обработать заявку на найм: " + Заявка.Заголовок;
		Описание = Заявка.Содержание;
		Если ЗначениеЗаполнено(Заявка.Подготовил) Тогда
			// HR должен знать, кто подал заявку, чтобы назначить его
			// руководителем нового сотрудника (НайтиИлиСоздатьЗадачу хранит
			// только текст - структурированной ссылки на заявку в задаче нет).
			Описание = Описание + Символы.ПС + Символы.ПС
				+ "(Заявку подал: " + Строка(Заявка.Подготовил) + ")";
		КонецЕсли;
		АИС_ОбщегоНазначения.НайтиИлиСоздатьЗадачу(Заявка.Адресат, Наименование, Описание);
	КонецЕсли;
КонецПроцедуры

// Пересматривает заявки на найм, уже согласованные бухгалтером, но
// ожидавшие документ "Должностная инструкция" по конкретной должности -
// вызывается при записи такого документа (см. ВнутреннийДокументПриЗаписи).
// Повторный вызов ОбработатьЗаявкуНаНайм безопасен (идемпотентен по паре
// Исполнитель/Наименование задачи).
Процедура ПереоценитьЗаявкиОжидающиеДолжность(Должность) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Должность", Должность);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Заявки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВнутренниеДокументы.АИС_ЗапрашиваемыеДолжности КАК Позиции
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВнутренниеДокументы КАК Заявки
	|		ПО Позиции.Ссылка = Заявки.Ссылка
	|ГДЕ
	|	Позиции.Должность = &Должность
	|	И Заявки.ВидДокумента.Наименование = ""Заявка на найм""
	|	И Заявки.АИС_СтатусСогласованияБухгалтера = ""Согласовано""
	|	И НЕ Заявки.ПометкаУдаления";
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбработатьЗаявкуНаНайм(Выборка.Ссылка);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Если документ составлен без шаблона (АИС_ИспользованШаблон не заполнен)
// или на основе шаблона, но дополнен сверх него (АИС_ДополненоРазделами) -
// формирует (через ИИ, НА СТОРОНЕ расширения - не задачей внешнему агенту)
// черновик шаблона и ставит автору исходного документа задачу утвердить
// его. "Делопроизводитель" здесь - реальный пользователь, на которого
// атрибутируется это техническое действие (для правдивого аудита), а не
// роль, отыгрываемая внешним симулятором: формирование и техническое
// согласование шаблона - функция самого расширения (ai_scrivener),
// отличие от того, как обычные сотрудники реагируют на задачи.
Процедура ПроверитьНеобходимостьШаблона(Источник)
	НужноШаблонизировать = Не ЗначениеЗаполнено(Источник.АИС_ИспользованШаблон) Или Источник.АИС_ДополненоРазделами;
	Если Не НужноШаблонизировать Тогда
		Возврат;
	КонецЕсли;

	Делопроизводитель = Справочники.Пользователи.НайтиПоНаименованию("Делопроизводитель", Истина);
	Если ЗначениеЗаполнено(Делопроизводитель) И Источник.Подготовил = Делопроизводитель Тогда
		// Не шаблонизируем документы, которые сам процесс формирования шаблона
		// мог бы породить (нет таких сейчас, но на будущее) - иначе цикл.
		Возврат;
	КонецЕсли;

	Попытка
		СистемныйПромпт =
			"Ты - Делопроизводитель, технический специалист по документообороту "
			+ "предприятия. Твоя задача - обобщить готовый документ в "
			+ "переиспользуемый шаблон: перепиши текст, заменив всё, что "
			+ "меняется от случая к случаю (суммы, ФИО, должности, даты, "
			+ "конкретные формулировки поручений и т.п.), на плейсхолдеры в "
			+ "квадратных скобках с явным указанием, кто/что является "
			+ "источником значения (например, ""[ОКЛАД - определяет Главный "
			+ "бухгалтер]""). Прежде чем выдать результат, самостоятельно "
			+ "проверь его как технический специалист: логичность структуры, "
			+ "полнота плейсхолдеров, корректность формулировок. Выдай только "
			+ "финальный текст шаблона, без пояснений от себя.";
		ПользовательскийПромпт =
			"Исходный документ (вид: " + Строка(Источник.ВидДокумента)
			+ ", заголовок: """ + Источник.Заголовок + """):" + Символы.ПС + Символы.ПС
			+ Источник.Содержание;
		ТекстШаблона = АИС_ОбщегоНазначения.ВызватьИИ(СистемныйПромпт, ПользовательскийПромпт);
	Исключение
		Текст = "Не удалось сформировать шаблон по документу """ + Источник.Заголовок + """: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("АИС.Уведомления", УровеньЖурналаРегистрации.Ошибка,,, Текст);
		Возврат;
	КонецПопытки;

	Шаблон = АИС_ОбщегоНазначения.СоздатьЧерновикШаблона(
		Источник.ВидДокумента, Источник.Заголовок, Источник.Заголовок, ТекстШаблона);

	Если ЗначениеЗаполнено(Источник.Подготовил) Тогда
		Наименование = "Утвердить шаблон: " + Источник.Заголовок;
		Описание =
			"Делопроизводитель подготовил шаблон на основе вашего документа "
			+ """" + Источник.Заголовок + """. Утвердите (POST /templates/approve, "
			+ "УникальныйИдентификатор=" + Строка(Шаблон.УникальныйИдентификатор())
			+ ") либо дополните замечаниями и верните на доработку." + Символы.ПС + Символы.ПС
			+ "Текст шаблона:" + Символы.ПС + ТекстШаблона;
		АИС_ОбщегоНазначения.НайтиИлиСоздатьЗадачу(Источник.Подготовил, Наименование, Описание);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
