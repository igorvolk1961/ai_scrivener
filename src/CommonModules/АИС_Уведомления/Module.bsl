#Область ПрограммныйИнтерфейс

// Обработчик подписки на событие АИС_ВнутреннийДокументПриЗаписи
// (Catalog.ВнутренниеДокументы, OnWrite). Если у внутреннего документа
// заполнен "Адресат" - адресат получает задачу исполнителя с полным
// текстом документа. Вместе с задачей расширение САМО ищет подходящие
// шаблоны (НайтиШаблоныВнутреннихДокументов) и сохраняет кандидатов в
// АИС_КонтекстЗадачИИ - решение, использовать ли найденное (и какой из
// кандидатов), остаётся за исполнителем задачи (или его симулятором):
// серверный поиск - это подсказка, не выбор за него. Пока без
// классификации по АИС_ТипыТриггеров/АИС_ТипыДействий - это следующий шаг.
Процедура ВнутреннийДокументПриЗаписи(Источник, Отказ) Экспорт
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Источник.Адресат) Тогда
		Возврат;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	Наименование = "Ознакомиться: " + Источник.Заголовок;
	Задача = АИС_ОбщегоНазначения.НайтиИлиСоздатьЗадачу(Источник.Адресат, Наименование, Источник.Содержание);

	Кандидаты = АИС_ОбщегоНазначения.НайтиШаблоныВнутреннихДокументов(Источник.ВидДокумента);
	АИС_ОбщегоНазначения.СохранитьКандидатовШаблонов(Задача, Кандидаты);
КонецПроцедуры

#КонецОбласти
