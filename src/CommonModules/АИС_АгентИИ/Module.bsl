Функция ДанныеЗадачи(Задача)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Задача.Description КАК Наименование,
		|	Задача.Исполнитель КАК Исполнитель,
		|	Задача.Выполнена КАК Выполнена
		|ИЗ
		|	Задача.ЗадачаИсполнителя КАК Задача
		|ГДЕ
		|	Задача.Ссылка = &Задача
		|	И НЕ Задача.ПометкаУдаления";
	Запрос.УстановитьПараметр("Задача", Задача);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() ИЛИ Выборка.Выполнена Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Выборка.Исполнитель) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("Наименование,Исполнитель", Выборка.Наименование, Выборка.Исполнитель);
КонецФункции

Процедура ДобавитьИнструменты(Инструменты, Список)
	Для Каждого Имя Из СтрРазделить(Список, ",") Цикл
		Имя = СокрЛП(Имя);
		Если Не ПустаяСтрока(Имя) И Инструменты.Найти(Имя) = Неопределено Тогда
			Инструменты.Добавить(Имя);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

