Функция КонтекстЗадачи(Задача)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Контекст.ТипТриггера КАК ТипТриггера,
		|	Контекст.ТипДействия КАК ТипДействия,
		|	Контекст.СостояниеИИ КАК СостояниеИИ,
		|	Контекст.КлючИдемпотентности КАК КлючИдемпотентности,
		|	Контекст.КандидатыШаблонов КАК КандидатыШаблонов
		|ИЗ
		|	РегистрСведений.АИС_КонтекстЗадачИИ КАК Контекст
		|ГДЕ
		|	Контекст.Задача = &Задача";
	Запрос.УстановитьПараметр("Задача", Задача);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Новый Структура("trigger,action,state,key,candidates", "", "", "", "", Новый Массив);
	КонецЕсли;
	Кандидаты = Новый Массив;
	Если Не ПустаяСтрока(Выборка.КандидатыШаблонов) Тогда
		Попытка
			Значение = АИС_КлиентВнешнегоСервиса.ПрочитатьJSONИзСтроки(Выборка.КандидатыШаблонов);
			Если ТипЗнч(Значение) = Тип("Массив") Тогда
				Кандидаты = Значение;
			КонецЕсли;
		Исключение
			Кандидаты = Новый Массив;
		КонецПопытки;
	КонецЕсли;
	Возврат Новый Структура(
		"trigger,action,state,key,candidates",
		Строка(Выборка.ТипТриггера),
		Строка(Выборка.ТипДействия),
		Строка(Выборка.СостояниеИИ),
		Строка(Выборка.КлючИдемпотентности),
		Кандидаты);
КонецФункции

