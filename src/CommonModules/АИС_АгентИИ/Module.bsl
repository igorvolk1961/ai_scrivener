Процедура ОтменитьЗапуск(Запуск, Причина) Экспорт
	Попытка
		Объект = ?(ТипЗнч(Запуск) = Тип("СправочникОбъект.АИС_ЗапускиАгентов"),
			Запуск, Запуск.ПолучитьОбъект());
	Исключение
		Возврат;
	КонецПопытки;
	Если Объект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Объект.Состояние = Перечисления.АИС_СостоянияЗапусковАгента.Отменен;
	Объект.Ошибка = Причина;
	Объект.ДатаЗавершения = ТекущаяДатаСеанса();
	Объект.ДатаОбновления = ТекущаяДатаСеанса();
	Объект.Заблокирован = Ложь;
	Объект.Записать();

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Взаимодействия.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.АИС_ВзаимодействияИИ КАК Взаимодействия
		|ГДЕ
		|	Взаимодействия.Запуск = &Запуск
		|	И Взаимодействия.Статус = &Ожидает";
	Запрос.УстановитьПараметр("Запуск", Объект.Ссылка);
	Запрос.УстановитьПараметр("Ожидает", Перечисления.АИС_СостоянияВзаимодействийИИ.Ожидает);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			Взаимодействие = Выборка.Ссылка.ПолучитьОбъект();
			Если Взаимодействие = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Взаимодействие.Статус = Перечисления.АИС_СостоянияВзаимодействийИИ.Отменен;
			Взаимодействие.Записать();
			ЗакрытьУведомление(Взаимодействие, "Запуск отменен");
		Исключение
			ЗаписьЖурналаРегистрации(
				"АИС.АгентИИ",
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				"Не удалось отменить взаимодействие " + Строка(Выборка.Ссылка) + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

Процедура ЗакрытьУведомление(Взаимодействие, Результат)
	Если Не ЗначениеЗаполнено(Взаимодействие.ЗадачаУведомление) Тогда
		Возврат;
	КонецЕсли;
	Задача = Взаимодействие.ЗадачаУведомление.ПолучитьОбъект();
	Если Задача = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Задача.Выполнена = Истина;
	Задача.ДатаИсполнения = ТекущаяДатаСеанса();
	Задача.РезультатВыполнения = Результат;
	Задача.Записать();
КонецПроцедуры

Процедура ЗавершитьСОшибкой(Объект, Текст)
