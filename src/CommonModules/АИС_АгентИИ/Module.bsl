#Область ПрограммныйИнтерфейс

Функция ОбеспечитьНастройкиАгента(Сотрудник) Экспорт
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		ВызватьИсключение "Не указан сотрудник для настройки ИИ-агента";
	КонецЕсли;

	Существующая = НайтиПоСотруднику(Сотрудник);
	Если ЗначениеЗаполнено(Существующая) Тогда
		Возврат Существующая;
	КонецЕсли;

	Объект = Справочники.АИС_НастройкиАгента.СоздатьЭлемент();
	Объект.Наименование = "Агент: " + Сотрудник.Наименование;
	Объект.Сотрудник = Сотрудник;
	Объект.Включен = Ложь;
	Объект.СтатусПромпта = Перечисления.АИС_СтатусыПромптаАгента.НеСформирован;
	Объект.МаксШагов = 20;
	Объект.ДатаСоздания = ТекущаяДатаСеанса();
	Объект.ДатаОбновления = ТекущаяДатаСеанса();
	Объект.Записать();
	Возврат Объект.Ссылка;
КонецФункции

Процедура ОбеспечитьНастройкиВсехАгентов() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Пользователи.Ссылка КАК Сотрудник
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|ГДЕ
		|	НЕ Пользователи.ПометкаУдаления
		|	И НЕ Пользователи.ЭтоГруппа";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОбеспечитьНастройкиАгента(Выборка.Сотрудник);
	КонецЦикла;
КонецПроцедуры

Функция НайтиПоСотруднику(Сотрудник) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Настройки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.АИС_НастройкиАгента КАК Настройки
		|ГДЕ
		|	Настройки.Сотрудник = &Сотрудник
		|	И НЕ Настройки.ПометкаУдаления";
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.АИС_НастройкиАгента.ПустаяСсылка();
КонецФункции

// Формирует роль-промпт агента по действующей должностной инструкции или,
// если её нет, по названию должности. Ошибка генерации оставляет агента
// выключенным, даже если включено автовключение.
Функция СформироватьРольПромпт(Настройка) Экспорт
	Если Не ЗначениеЗаполнено(Настройка) Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Объект = ?(ТипЗнч(Настройка) = Тип("СправочникОбъект.АИС_НастройкиАгента"),
			Настройка, Настройка.ПолучитьОбъект());
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Если Объект = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	ДолжностьСсылка = ДолжностьСотрудникаСсылка(Объект.Сотрудник);
	Если Не ЗначениеЗаполнено(ДолжностьСсылка) Тогда
		Объект.СтатусПромпта = Перечисления.АИС_СтатусыПромптаАгента.Ошибка;
		Объект.ОшибкаГенерации = "Не определена должность сотрудника";
		Объект.ДатаОбновления = ТекущаяДатаСеанса();
		Объект.Записать();
		Возврат Ложь;
	КонецЕсли;
	Должность = Строка(ДолжностьСсылка);

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Параметры.Промпт.Текст КАК Текст,
		|	Параметры.Модель КАК Модель,
		|	Параметры.Температура КАК Температура,
		|	Параметры.МаксимумТокенов КАК МаксимумТокенов
		|ИЗ
		|	Справочник.АИС_ПромптПараметры КАК Параметры
		|ГДЕ
		|	Параметры.Наименование = ""РольАгента""
		|	И Параметры.Активность
		|	И НЕ Параметры.ПометкаУдаления
		|	И НЕ Параметры.Промпт.ПометкаУдаления
		|	И Параметры.Промпт.Активность";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Или ПустаяСтрока(Выборка.Текст) Тогда
		Объект.СтатусПромпта = Перечисления.АИС_СтатусыПромптаАгента.Ошибка;
		Объект.ОшибкаГенерации = "Не найден активный промпт РольАгента";
		Объект.ДатаОбновления = ТекущаяДатаСеанса();
		Объект.Записать();
		Возврат Ложь;
	КонецЕсли;

	Объект.СтатусПромпта = Перечисления.АИС_СтатусыПромптаАгента.Черновик;
	Объект.ОшибкаГенерации = "";
	Объект.ДатаОбновления = ТекущаяДатаСеанса();
	Объект.Записать();

	ТекстИнструкции = ТекстДолжностнойИнструкции(ДолжностьСсылка);
	ПользовательскийПромпт = "Должность: " + Должность + Символы.ПС + Символы.ПС;
	Если ПустаяСтрока(ТекстИнструкции) Тогда
		ПользовательскийПромпт = ПользовательскийПромпт
			+ "Должностная инструкция не найдена. Сформируй роль по названию должности, "
			+ "не придумывая фактов.";
	Иначе
		ПользовательскийПромпт = ПользовательскийПромпт
			+ "Должностная инструкция:" + Символы.ПС + ТекстИнструкции;
	КонецЕсли;

	Попытка
		Текст = АИС_ОбщегоНазначения.ВызватьИИ(
			Выборка.Текст,
			ПользовательскийПромпт,
			Выборка.Модель,
			Выборка.Температура,
			Выборка.МаксимумТокенов);
		Если ПустаяСтрока(СокрЛП(Текст)) Тогда
			ВызватьИсключение "LLM вернул пустой роль-промпт";
		КонецЕсли;
		Объект.РольПромпт = Текст;
		Объект.СтатусПромпта = Перечисления.АИС_СтатусыПромптаАгента.Сформирован;
		Объект.ОшибкаГенерации = "";
		Если Константы.АИС_АвтоВключениеАгентов.Получить() Тогда
			Объект.Включен = Истина;
		КонецЕсли;
	Исключение
		Объект.СтатусПромпта = Перечисления.АИС_СтатусыПромптаАгента.Ошибка;
		Объект.ОшибкаГенерации = ОписаниеОшибки();
	КонецПопытки;
	Объект.ДатаОбновления = ТекущаяДатаСеанса();
	Объект.Записать();
	Возврат Объект.СтатусПромпта = Перечисления.АИС_СтатусыПромптаАгента.Сформирован;
КонецФункции

// Генерирует промпты для настроек, которые ещё не сформированы. Вызывается
// регламентным заданием очереди; Предел ограничивает число LLM-вызовов за цикл.
Процедура СформироватьОжидающиеПромпты(Предел = 1) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Настройки.Ссылка КАК Настройка
		|ИЗ
		|	Справочник.АИС_НастройкиАгента КАК Настройки
		|ГДЕ
		|	Настройки.СтатусПромпта В (&НеСформирован, &Черновик)
		|	И НЕ Настройки.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Настройки.ДатаОбновления";
	Запрос.УстановитьПараметр("НеСформирован", Перечисления.АИС_СтатусыПромптаАгента.НеСформирован);
	Запрос.УстановитьПараметр("Черновик", Перечисления.АИС_СтатусыПромптаАгента.Черновик);
	Выборка = Запрос.Выполнить().Выбрать();
	Обработано = 0;
	Пока Выборка.Следующий() И Обработано < Предел Цикл
		Попытка
			СформироватьРольПромпт(Выборка.Настройка);
		Исключение
			ЗаписьЖурналаРегистрации(
				"АИС.АгентИИ",
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				"Не удалось сформировать роль-промпт: " + ОписаниеОшибки());
		КонецПопытки;
		Обработано = Обработано + 1;
	КонецЦикла;
КонецПроцедуры

// Backfill: создаёт настройки для всех пользователей и формирует промпты
// для тех, у кого они ещё не сформированы.
Процедура СформироватьВсеРольПромпты(Предел = 50) Экспорт
	ОбеспечитьНастройкиВсехАгентов();
	СформироватьОжидающиеПромпты(Предел);
КонецПроцедуры

// Импортирует ролевые промпты из каталога system_prompts/*.md, как их
// готовил симулятор. Имя файла без .md сопоставляется с логином пользователя.
Функция ИмпортироватьРольПромпты(Каталог) Экспорт
	Каталог = СокрЛП(Каталог);
	Если ПустаяСтрока(Каталог) Тогда
		Возврат "Каталог промптов не задан.";
	КонецЕсли;
	ФайлКаталога = Новый Файл(Каталог);
	Если Не ФайлКаталога.Существует() ИЛИ Не ФайлКаталога.ЭтоКаталог() Тогда
		Возврат "Каталог промптов не найден: " + Каталог;
	КонецЕсли;
	Попытка
		Файлы = НайтиФайлы(Каталог, "*.md");
	Исключение
		Возврат "Не удалось прочитать каталог промптов: " + ОписаниеОшибки();
	КонецПопытки;

	Импортировано = 0;
	Пропущено = 0;
	Для Каждого Файл Из Файлы Цикл
		Если Файл.ЭтоКаталог() Тогда
			Продолжить;
		КонецЕсли;
		Имя = Файл.Имя;
		Если СтрДлина(Имя) <= 3 ИЛИ Прав(НРег(Имя), 3) <> ".md" Тогда
			Продолжить;
		КонецЕсли;
		Логин = Лев(Имя, СтрДлина(Имя) - 3);
		Сотрудник = Справочники.Пользователи.НайтиПоНаименованию(Логин, Истина);
		Если Не ЗначениеЗаполнено(Сотрудник) Тогда
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;
		Попытка
			Чтение = Новый ЧтениеТекста(Файл.ПолноеИмя, "UTF-8");
			Текст = Чтение.Прочитать();
			Чтение.Закрыть();
		Исключение
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецПопытки;
		Если ПустаяСтрока(СокрЛП(Текст)) Тогда
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;
		Текст = СтрЗаменить(Текст, "агент-симулятор", "ИИ-агент");
		Настройка = НайтиПоСотруднику(Сотрудник);
		Если Не ЗначениеЗаполнено(Настройка) Тогда
			Настройка = ОбеспечитьНастройкиАгента(Сотрудник);
		КонецЕсли;
		Объект = Настройка.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			Пропущено = Пропущено + 1;
			Продолжить;
		КонецЕсли;
		Объект.РольПромпт = Текст;
		Объект.СтатусПромпта = Перечисления.АИС_СтатусыПромптаАгента.Сформирован;
		Объект.ОшибкаГенерации = "";
		Объект.ДатаОбновления = ТекущаяДатаСеанса();
		Если Константы.АИС_АвтоВключениеАгентов.Получить() Тогда
			Объект.Включен = Истина;
		КонецЕсли;
		Объект.Записать();
		Импортировано = Импортировано + 1;
	КонецЦикла;
	Возврат "Импортировано промптов: " + Импортировано + ", пропущено: " + Пропущено + ".";
КонецФункции

Функция ИмпортироватьПромптыСценария(Корень) Экспорт
	Корень = СокрЛП(Корень);
	Если ПустаяСтрока(Корень) Тогда
		Возврат "Каталог сценария не задан.";
	КонецЕсли;
	Если Не ЭтоКаталог(Корень) Тогда
		Возврат "Каталог сценария не найден: " + Корень;
	КонецЕсли;
	Результаты = Новый Массив;
	СистемныйФайл = Корень + "/prompts/system.md";
	Если ЭтоФайл(СистемныйФайл) Тогда
		ТекстСистемы = ПрочитатьТекст(СистемныйФайл);
		Если Не ПустаяСтрока(СокрЛП(ТекстСистемы)) Тогда
			АИС_Промпты.ОбеспечитьТекст(
				"БазовыйПромптАгента",
				АдаптироватьБазовыйПромпт(ТекстСистемы),
				"Импортировано из prompts/system.md");
			Результаты.Добавить("базовый промпт");
		КонецЕсли;
	КонецЕсли;
	ПрофильФайл = Корень + "/profiles/ooo-delo-v-shlyape.md";
	Если ЭтоФайл(ПрофильФайл) Тогда
		ТекстПрофиля = ПрочитатьТекст(ПрофильФайл);
		Если Не ПустаяСтрока(СокрЛП(ТекстПрофиля)) Тогда
			АИС_Промпты.ОбеспечитьТекст(
				"ПрофильКомпании",
				ТекстПрофиля,
				"Импортировано из profiles/ooo-delo-v-shlyape.md");
			Результаты.Добавить("профиль компании");
		КонецЕсли;
	КонецЕсли;
	РезультатРолей = ИмпортироватьРольПромпты(Корень + "/system_prompts");
	Если Результаты.Количество() = 0 Тогда
		Возврат "Базовый промпт и профиль не найдены. " + РезультатРолей;
	КонецЕсли;
	Возврат "Импортировано: " + СтрСоединить(Результаты, ", ") + ". " + РезультатРолей;
КонецФункции


Функция ПоставитьЗадачуВОчередь(Задача, Причина = "") Экспорт
	Если Не Константы.АИС_АгентВключен.Получить() Тогда
		Возврат Справочники.АИС_ЗапускиАгентов.ПустаяСсылка();
	КонецЕсли;
	Если Не ЕстьКонтекстЗадачи(Задача) Тогда
		Возврат Справочники.АИС_ЗапускиАгентов.ПустаяСсылка();
	КонецЕсли;

	ДанныеЗадачи = ДанныеЗадачи(Задача);
	Если ДанныеЗадачи = Неопределено Тогда
		Возврат Справочники.АИС_ЗапускиАгентов.ПустаяСсылка();
	КонецЕсли;
	Настройка = НайтиПоСотруднику(ДанныеЗадачи.Исполнитель);
	Если Не ЗначениеЗаполнено(Настройка)
		ИЛИ Не Настройка.Включен
		ИЛИ ПустаяСтрока(Настройка.РольПромпт) Тогда
		Возврат Справочники.АИС_ЗапускиАгентов.ПустаяСсылка();
	КонецЕсли;
	Существующий = НайтиАктивныйЗапуск(Задача);
	Если ЗначениеЗаполнено(Существующий) Тогда
		Возврат Существующий;
	КонецЕсли;

	Объект = Справочники.АИС_ЗапускиАгентов.СоздатьЭлемент();
	Объект.Наименование = "Запуск: " + СокрЛП(ДанныеЗадачи.Наименование);
	Объект.Задача = Задача;
	Объект.Сотрудник = ДанныеЗадачи.Исполнитель;
	Объект.Состояние = Перечисления.АИС_СостоянияЗапусковАгента.Ожидает;
	Объект.Шаг = 0;
	Объект.МаксШагов = ?(Настройка.МаксШагов > 0, Настройка.МаксШагов, 20);
	Объект.ВерсияКонтекста = 1;
	Объект.Попытки = 0;
	Объект.СледующаяПопытка = ТекущаяДатаСеанса();
	Объект.ДатаНачала = ТекущаяДатаСеанса();
	Объект.ДатаОбновления = ТекущаяДатаСеанса();
	Объект.КлючИдемпотентности = Строка(Задача.УникальныйИдентификатор());
	Объект.Записать();
	УстранитьДублиЗапусков(Задача, Объект.Ссылка);
	Возврат НайтиАктивныйЗапуск(Задача);
КонецФункции

Процедура УстранитьДублиЗапусков(Задача, НовыйЗапуск)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Запуски.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.АИС_ЗапускиАгентов КАК Запуски
		|ГДЕ
		|	Запуски.Задача = &Задача
		|	И Запуски.Состояние В (&АктивныеСостояния)
		|УПОРЯДОЧИТЬ ПО
		|	Запуски.ДатаНачала,
		|	Запуски.Ссылка";
	Запрос.УстановитьПараметр("Задача", Задача);
	Запрос.УстановитьПараметр("АктивныеСостояния", АктивныеСостояния());
	Выборка = Запрос.Выполнить().Выбрать();
	Первый = Истина;
	Пока Выборка.Следующий() Цикл
		Если Первый Тогда
			Первый = Ложь;
			Продолжить;
		КонецЕсли;
		Если Выборка.Ссылка <> НовыйЗапуск Тогда
			Попытка
				ОтменитьЗапуск(Выборка.Ссылка, "Дубликат запуска по задаче");
			Исключение
				ЗаписьЖурналаРегистрации(
					"АИС.АгентИИ",
					УровеньЖурналаРегистрации.Предупреждение,
					,
					,
					"Не удалось отменить дубль запуска " + Строка(Выборка.Ссылка) + ": " + ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция НайтиАктивныйЗапуск(Задача) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Запуски.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.АИС_ЗапускиАгентов КАК Запуски
		|ГДЕ
		|	Запуски.Задача = &Задача
		|	И Запуски.Состояние В (&АктивныеСостояния)";
	Запрос.УстановитьПараметр("Задача", Задача);
	Состояния = Новый Массив;
	Состояния.Добавить(Перечисления.АИС_СостоянияЗапусковАгента.Ожидает);
	Состояния.Добавить(Перечисления.АИС_СостоянияЗапусковАгента.Выполняется);
	Состояния.Добавить(Перечисления.АИС_СостоянияЗапусковАгента.ОжидаетОтвета);
	Запрос.УстановитьПараметр("АктивныеСостояния", Состояния);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Справочники.АИС_ЗапускиАгентов.ПустаяСсылка();
КонецФункции

Функция ЕстьКонтекстЗадачи(Задача) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Контекст.Задача КАК Задача
		|ИЗ
		|	РегистрСведений.АИС_КонтекстЗадачИИ КАК Контекст
		|ГДЕ
		|	Контекст.Задача = &Задача";
	Запрос.УстановитьПараметр("Задача", Задача);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат Выборка.Следующий();
КонецФункции

// Создаёт контекст для ручной передачи задачи агенту. Ручная передача не
// является документным триггером, поэтому классификация не заполняется:
// агент получает задачу и предмет как есть.
Функция ОбеспечитьРучнойКонтекст(Задача) Экспорт
	Если Не ЗначениеЗаполнено(Задача) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ЕстьКонтекстЗадачи(Задача) Тогда
		Возврат Истина;
	КонецЕсли;
	АИС_ОбщегоНазначения.СохранитьКонтекстЗадачи(
		Задача,
		Справочники.АИС_ТипыТриггеров.ПустаяСсылка(),
		Справочники.АИС_ТипыДействий.ПустаяСсылка(),
		Новый Массив);
	Возврат Истина;
КонецФункции

// Ручная передача задачи агенту: создаёт контекст, если его нет, и ставит
// run в очередь. Возвращает ссылку на запуск или пустую ссылку.
Функция ПередатьЗадачуВОчередь(Задача, Причина = "РучнаяПередача") Экспорт
	Если Не ОбеспечитьРучнойКонтекст(Задача) Тогда
		Возврат Справочники.АИС_ЗапускиАгентов.ПустаяСсылка();
	КонецЕсли;
	Возврат ПоставитьЗадачуВОчередь(Задача, Причина);
КонецФункции


Функция СоздатьВзаимодействие(Вид, Запуск, Задача, Сотрудник, Заголовок, Текст, PayloadJSON) Экспорт
	Часов = Константы.АИС_ТаймаутВзаимодействияЧасов.Получить();
	Если Часов <= 0 Тогда
		Часов = 24;
	КонецЕсли;
	Объект = Справочники.АИС_ВзаимодействияИИ.СоздатьЭлемент();
	Объект.Наименование = "ИИ: " + Лев(СокрЛП(Заголовок), 140);
	Объект.Вид = Вид;
	Объект.Запуск = Запуск;
	Объект.Задача = Задача;
	Объект.Сотрудник = Сотрудник;
	Объект.Статус = Перечисления.АИС_СостоянияВзаимодействийИИ.Ожидает;
	Объект.Заголовок = Лев(СокрЛП(Заголовок), 150);
	Объект.Текст = Текст;
	Объект.PayloadJSON = PayloadJSON;
	Объект.ДатаСоздания = ТекущаяДатаСеанса();
	Объект.СрокОтвета = ДобавитьКДате(ТекущаяДатаСеанса(), "Час", Часов);
	Объект.Версия = 1;
	Объект.КлючИдемпотентности = "ai-interaction:" + Строка(Запуск.УникальныйИдентификатор());
	Объект.Записать();
	ЗадачаУведомление = АИС_ОбщегоНазначения.НайтиИлиСоздатьЗадачу(
		Сотрудник,
		"Ответить ИИ: " + Заголовок,
		Текст,
		Сотрудник,
		Задача,
		"ai-interaction:" + Строка(Объект.Ссылка.УникальныйИдентификатор()));
	Объект.ЗадачаУведомление = ЗадачаУведомление;
	Объект.Записать();
	Возврат Объект.Ссылка;
КонецФункции

Процедура ЗавершитьЗадачу(Задача, Результат = "") Экспорт
	Если Не ЗначениеЗаполнено(Задача) Тогда
		Возврат;
	КонецЕсли;
	Объект = Задача.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Объект.Выполнена = Истина;
	Объект.ДатаИсполнения = ТекущаяДатаСеанса();
	Объект.РезультатВыполнения = Результат;
	Объект.Записать();
КонецПроцедуры


Функция РазрешенныеИнструменты() Экспорт
	Инструменты = АИС_ИнструментыАгента.БазовыеИнструменты();
	Если Константы.АИС_ГруппаДокументыВключена.Получить() Тогда
		ДобавитьИнструменты(Инструменты, "list_documents,read_document,check_document_access,create_draft,create_information_request,submit_draft_for_review,create_document,approve_document,cancel_document");
	КонецЕсли;
	Если Константы.АИС_ГруппаПоискЗнанияВключена.Получить() Тогда
		ДобавитьИнструменты(Инструменты, "search_example,search_knowledge_base,get_checklist,get_job_description");
	КонецЕсли;
	Если Константы.АИС_ГруппаИнтернетВключена.Получить() Тогда
		ДобавитьИнструменты(Инструменты, "search_internet,save_external_example");
	КонецЕсли;
	Если Константы.АИС_ГруппаПерсоналОргструктураВключена.Получить() Тогда
		ДобавитьИнструменты(Инструменты, "hire_employee,propose_system_prompt,accounting_decision,list_employees,list_departments,create_department");
	КонецЕсли;
	Если Константы.АИС_ГруппаРазделыДокументовВключена.Получить() Тогда
		ДобавитьИнструменты(Инструменты, "manage_document_sections");
	КонецЕсли;
	Если Константы.АИС_ГруппаЗамечанияВключена.Получить() Тогда
		ДобавитьИнструменты(Инструменты, "manage_remarks,return_document,route_remarks");
	КонецЕсли;
	Если Константы.АИС_ГруппаКорпусЗнанийВключена.Получить() Тогда
		ДобавитьИнструменты(Инструменты, "kb_download,kb_register_material,kb_list_materials");
	КонецЕсли;
	Возврат ПересечьСРеализованными(Инструменты);
КонецФункции

// Набор инструментов, для которых в dispatcher есть реализация. В allowlist
// попадают только они, иначе включение группы приводит к tool_not_implemented.
Функция РеализованныеИнструменты() Экспорт
	Инструменты = АИС_ИнструментыАгента.БазовыеИнструменты();
	ДобавитьИнструменты(Инструменты, "list_documents,read_document,check_document_access,create_draft,create_information_request,submit_draft_for_review,create_document,approve_document,cancel_document");
	ДобавитьИнструменты(Инструменты, "search_example,search_knowledge_base,get_checklist,get_job_description,search_internet");
	ДобавитьИнструменты(Инструменты, "hire_employee,propose_system_prompt,accounting_decision,list_employees,list_departments,create_department");
	ДобавитьИнструменты(Инструменты, "manage_document_sections");
	ДобавитьИнструменты(Инструменты, "manage_remarks,return_document,route_remarks");
	ДобавитьИнструменты(Инструменты, "kb_list_materials,kb_register_material");
	Возврат Инструменты;
КонецФункции

Функция СнимокЗапуска(Запуск) Экспорт
	ЗапускОбъект = Запуск.ПолучитьОбъект();
	Настройка = НайтиПоСотруднику(ЗапускОбъект.Сотрудник);
	Данные = ДанныеЗадачиДляСнимка(ЗапускОбъект.Задача);
	Если Данные = Неопределено Тогда
		ВызватьИсключение "Задача запуска не найдена или уже выполнена";
	КонецЕсли;
	Контекст = КонтекстЗадачи(ЗапускОбъект.Задача);
	Контекст.Вставить("approval", ОдобрениеДляСнимка(ЗапускОбъект));
	Сообщения = СообщенияЗапуска(ЗапускОбъект);
	Должность = ДолжностьСотрудника(ЗапускОбъект.Сотрудник);

	ТипПредмета = "Задача";
	ИдПредмета = Строка(Данные.Ссылка.УникальныйИдентификатор());
	ЗаголовокПредмета = Данные.ПредметСтрокой;
	Предмет = Данные.Предмет;
	Если ЗначениеЗаполнено(Предмет) Тогда
		Если ТипЗнч(Предмет) = Тип("СправочникСсылка.ВнутренниеДокументы") Тогда
			ТипПредмета = "ВнутреннийДокумент";
			ЗаголовокПредмета = Предмет.Заголовок;
		Иначе
			ТипПредмета = Строка(ТипЗнч(Предмет));
			ЗаголовокПредмета = Строка(Предмет);
		КонецЕсли;
		Попытка
			ИдПредмета = Строка(Предмет.УникальныйИдентификатор());
		Исключение
			ИдПредмета = "";
		КонецПопытки;
	КонецЕсли;

	Задача = Новый Структура(
		"id,title,description,executor,author,due_at,subject",
		Строка(Данные.Ссылка.УникальныйИдентификатор()),
		Данные.Description,
		Данные.Description,
		Строка(ЗапускОбъект.Сотрудник.Наименование),
		Строка(Данные.Автор.Наименование),
		Данные.СрокИсполнения,
		Новый Структура("type,id,title", ТипПредмета, ИдПредмета, ЗаголовокПредмета));
	Агент = Новый Структура(
		"login,position,role_prompt,base_prompt,company_profile",
		Строка(ЗапускОбъект.Сотрудник.Наименование),
		Должность,
		?(Настройка = Неопределено, "", Настройка.РольПромпт),
		АИС_Промпты.ТекстПоИмени("БазовыйПромптАгента"),
		АИС_Промпты.ТекстПоИмени("ПрофильКомпании"));
	ЛЛМ = Новый Структура(
		"model,temperature,max_tokens",
		Константы.АИС_МодельАгента.Получить(),
		Константы.АИС_ТемператураАгента.Получить(),
		Константы.АИС_МаксимумТокеновАгента.Получить());
	Политика = Новый Структура(
		"approval_gate,allowed_addressees,web_search,knowledge,max_steps",
		Истина,
		Новый Массив,
		Константы.АИС_ГруппаИнтернетВключена.Получить(),
		Константы.АИС_ГруппаПоискЗнанияВключена.Получить(),
		ЗапускОбъект.МаксШагов);

	Возврат Новый Структура(
		"protocol_version,run_version,task,agent,context,messages,llm,allowed_tools,policy",
		1,
		ЗапускОбъект.ВерсияКонтекста,
		Задача,
		Агент,
		Контекст,
		Сообщения,
		ЛЛМ,
		РазрешенныеИнструменты(),
		Политика);
КонецФункции


Процедура ВыполнитьОдинШаг(Запуск) Экспорт
	Объект = Запуск.ПолучитьОбъект();
	Если Объект = Неопределено ИЛИ Объект.Заблокирован Тогда
		Возврат;
	КонецЕсли;
	Если Не Константы.АИС_АгентВключен.Получить() Тогда
		ОтменитьЗапуск(Объект, "ИИ-агент выключен администратором");
		Возврат;
	КонецЕсли;
	Настройка = НайтиПоСотруднику(Объект.Сотрудник);
	Если Не ЗначениеЗаполнено(Настройка)
		ИЛИ Не Настройка.Включен
		ИЛИ ПустаяСтрока(Настройка.РольПромпт) Тогда
		ОтменитьЗапуск(Объект, "Агент сотрудника выключен или роль-промпт не сформирован");
		Возврат;
	КонецЕсли;
	Если Объект.Шаг >= Объект.МаксШагов Тогда
		ЗавершитьСОшибкой(Объект, "Достигнут лимит шагов агента");
		Возврат;
	КонецЕсли;

	Объект.Заблокирован = Истина;
	Объект.Записать();
	Попытка
		Снимок = СнимокЗапуска(Запуск);
		Ответ = АИС_ИнтеграцияСАгентом.ВыполнитьШаг(Снимок);
		Если Ответ.Тип = "error" Тогда
			ЗавершитьСОшибкой(Объект, Ответ.Код + ": " + Ответ.Ошибка);
			Возврат;
		КонецЕсли;
		Если Ответ.ВерсияПротокола <> 1 Тогда
			ЗавершитьСОшибкой(Объект, "Неподдерживаемая версия протокола agent-service");
			Возврат;
		КонецЕсли;
		Если Ответ.ВерсияЗапуска <> Объект.ВерсияКонтекста Тогда
			ЗавершитьСОшибкой(Объект, "Устаревшая версия запуска в ответе agent-service");
			Возврат;
		КонецЕсли;

		Если Ответ.Тип = "final" Тогда
			Если ЗадачаВыполнена(Объект.Задача) Тогда
				Объект.Состояние = Перечисления.АИС_СостоянияЗапусковАгента.Завершен;
				Объект.Ошибка = "";
				Объект.Попытки = 0;
			Иначе
				Объект.Состояние = Перечисления.АИС_СостоянияЗапусковАгента.ТребуетВнимания;
				Объект.Ошибка = "Агент завершил работу без complete_task";
			КонецЕсли;
			Объект.ДатаЗавершения = ТекущаяДатаСеанса();
			Объект.ДатаОбновления = ТекущаяДатаСеанса();
			Объект.Заблокирован = Ложь;
			Объект.Записать();
			Возврат;
		КонецЕсли;

		Сообщения = СообщенияЗапуска(Объект);
		ДобавитьВызовАссистента(Сообщения, Ответ);
		Разрешенные = Снимок.allowed_tools;
		Контекст = Новый Структура(
			"Запуск,Задача,Сотрудник,РазрешенныеИнструменты,Инструмент,CallID,Шаг",
			Запуск,
			Объект.Задача,
			Объект.Сотрудник,
			Разрешенные,
			Ответ.Инструмент,
			Ответ.CallID,
			Объект.Шаг);
		Вызов = АИС_ИнструментыАгента.ВыполнитьИнструмент(Ответ.Инструмент, Ответ.Аргументы, Контекст);
		ДобавитьРезультатИнструмента(Сообщения, Ответ.CallID, Вызов);
		Объект.СообщенияJSON = АИС_КлиентВнешнегоСервиса.ЗаписатьJSON(Сообщения);
		Объект.Шаг = Объект.Шаг + 1;
		Объект.ВерсияКонтекста = Объект.ВерсияКонтекста + 1;
		Объект.ДатаОбновления = ТекущаяДатаСеанса();
		Объект.СледующаяПопытка = ТекущаяДатаСеанса();
		Если Вызов.Остановить Тогда
			Объект.Состояние = Перечисления.АИС_СостоянияЗапусковАгента.ОжидаетОтвета;
			Объект.Попытки = 0;
			Объект.Ошибка = "";
		ИначеЕсли Не Вызов.ОК Тогда
			Если Вызов.Ошибка.Код = "approval_required" Тогда
				Объект.Попытки = Объект.Попытки + 1;
				Объект.Ошибка = "";
				Если Объект.Попытки > 2 Тогда
					Объект.Состояние = Перечисления.АИС_СостоянияЗапусковАгента.ТребуетВнимания;
					Объект.Ошибка = "Агент не запросил одобрение после approval_required";
				Иначе
					Объект.Состояние = Перечисления.АИС_СостоянияЗапусковАгента.Ожидает;
				КонецЕсли;
			Иначе
				Объект.Состояние = Перечисления.АИС_СостоянияЗапусковАгента.Ошибка;
				Объект.Ошибка = Вызов.Ошибка.Код + ": " + Вызов.Ошибка.Текст;
			КонецЕсли;
		Иначе
			Объект.Состояние = Перечисления.АИС_СостоянияЗапусковАгента.Ожидает;
			Объект.Попытки = 0;
			Объект.Ошибка = "";
		КонецЕсли;
		Объект.Заблокирован = Ложь;
		Объект.Записать();
	Исключение
		ТекстОшибки = ОписаниеОшибки();
		Объект.Попытки = Объект.Попытки + 1;
		Если Объект.Попытки <= 3 Тогда
			Объект.Состояние = Перечисления.АИС_СостоянияЗапусковАгента.Ожидает;
			Объект.Ошибка = "";
			Объект.СледующаяПопытка = ДобавитьКДате(
				ТекущаяДатаСеанса(), "Секунда", 30 * Объект.Попытки);
			Объект.ДатаОбновления = ТекущаяДатаСеанса();
			Объект.Заблокирован = Ложь;
			Объект.Записать();
			ЗаписьЖурналаРегистрации(
				"АИС.АгентИИ",
				УровеньЖурналаРегистрации.Предупреждение,
				,
				,
				"Шаг агента не выполнен, повтор " + Объект.Попытки + ": " + ТекстОшибки);
		Иначе
			ЗавершитьСОшибкой(Объект, ТекстОшибки);
		КонецЕсли;
	КонецПопытки;
КонецПроцедуры

Процедура ОбработатьОчередь(Предел = 5) Экспорт
	Попытка
		ИстечьПросроченныеВзаимодействия();
	Исключение
		ЗаписьЖурналаРегистрации(
			"АИС.АгентИИ",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			"Не удалось обработать таймауты взаимодействий: " + ОписаниеОшибки());
	КонецПопытки;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Запуски.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.АИС_ЗапускиАгентов КАК Запуски
		|ГДЕ
		|	Запуски.Состояние = &Ожидает
		|	И Запуски.СледующаяПопытка <= &Сейчас
		|	И НЕ Запуски.Заблокирован";
	Запрос.УстановитьПараметр("Ожидает", Перечисления.АИС_СостоянияЗапусковАгента.Ожидает);
	Запрос.УстановитьПараметр("Сейчас", ТекущаяДатаСеанса());
	Выборка = Запрос.Выполнить().Выбрать();
	Обработано = 0;
	Пока Выборка.Следующий() И Обработано < Предел Цикл
		ВыполнитьОдинШаг(Выборка.Ссылка);
		Обработано = Обработано + 1;
	КонецЦикла;
КонецПроцедуры


Процедура ПродолжитьПослеОтвета(Взаимодействие) Экспорт
	ОбъектВзаимодействия = Взаимодействие.ПолучитьОбъект();
	Если ОбъектВзаимодействия = Неопределено ИЛИ Не ЗначениеЗаполнено(ОбъектВзаимодействия.Запуск) Тогда
		Возврат;
	КонецЕсли;
	ЗапускОбъект = ОбъектВзаимодействия.Запуск.ПолучитьОбъект();
	Если ЗапускОбъект = Неопределено ИЛИ ЗапускОбъект.Состояние <> Перечисления.АИС_СостоянияЗапусковАгента.ОжидаетОтвета Тогда
		Возврат;
	КонецЕсли;

	Payload = АИС_КлиентВнешнегоСервиса.ПрочитатьJSONИзСтроки(ОбъектВзаимодействия.PayloadJSON);
	CallID = Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Payload, "call_id"));
	Если ПустаяСтрока(ОбъектВзаимодействия.ОтветJSON) Тогда
		Ответ = Новый Структура("decision,text", "answered", "");
	Иначе
		Ответ = АИС_КлиентВнешнегоСервиса.ПрочитатьJSONИзСтроки(ОбъектВзаимодействия.ОтветJSON);
	КонецЕсли;
	Решение = Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Ответ, "decision"));
	Инструмент = Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Payload, "tool"));
	Если Инструмент = "request_action_approval" Тогда
		Вид = Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Payload, "subject_kind"));
		ИнструментДействия = Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Payload, "action_tool"));
		АргументыДействия = АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Payload, "action_arguments");
		Если ПустаяСтрока(Вид) Тогда
			Вид = ?(ПустаяСтрока(ИнструментДействия), "documents", "action");
		КонецЕсли;
		ТекстОтвета = Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Ответ, "text"));
		Если ПустаяСтрока(ТекстОтвета) Тогда
			ТекстОтвета = Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Ответ, "answer_text"));
		КонецЕсли;
		УстановитьОдобрение(
			ЗапускОбъект.Ссылка,
			Вид,
			ИнструментДействия,
			АргументыДействия,
			Решение,
			ТекстОтвета,
			Строка(ОбъектВзаимодействия.Ссылка.УникальныйИдентификатор()));
	КонецЕсли;
	Данные = Новый Структура(
		"ok,data",
		Истина,
		Новый Структура(
			"interaction_id,decision,answer",
			Строка(ОбъектВзаимодействия.Ссылка.УникальныйИдентификатор()),
			Решение,
			Ответ));

	Сообщения = СообщенияЗапуска(ЗапускОбъект);
	Сообщения.Добавить(Новый Структура(
		"role,tool_call_id,content",
		"tool",
		CallID,
		АИС_КлиентВнешнегоСервиса.ЗаписатьJSON(Данные)));
	ЗапускОбъект.СообщенияJSON = АИС_КлиентВнешнегоСервиса.ЗаписатьJSON(Сообщения);
	ЗапускОбъект.Состояние = Перечисления.АИС_СостоянияЗапусковАгента.Ожидает;
	ЗапускОбъект.ВерсияКонтекста = ЗапускОбъект.ВерсияКонтекста + 1;
	ЗапускОбъект.СледующаяПопытка = ТекущаяДатаСеанса();
	ЗапускОбъект.ДатаОбновления = ТекущаяДатаСеанса();
	ЗапускОбъект.Заблокирован = Ложь;
	ЗапускОбъект.Записать();
КонецПроцедуры


Функция ПроверитьОдобрение(Запуск, Инструмент = "", Аргументы = Неопределено) Экспорт
	Объект = Запуск.ПолучитьОбъект();
	Если Объект = Неопределено ИЛИ ПустаяСтрока(Объект.ОдобрениеJSON) Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Состояние = АИС_КлиентВнешнегоСервиса.ПрочитатьJSONИзСтроки(Объект.ОдобрениеJSON);
		Если Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Состояние, "decision")) <> "approved" Тогда
			Возврат Ложь;
		КонецЕсли;
		Если АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Состояние, "consumed") = Истина Тогда
			Возврат Ложь;
		КонецЕсли;
		Вид = Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Состояние, "subject_kind"));
		Если Вид = "action" Тогда
			Если Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Состояние, "tool")) <> Инструмент Тогда
				Возврат Ложь;
			КонецЕсли;
			ОжидаемыйХеш = Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Состояние, "args_hash"));
			Возврат Не ПустаяСтрока(ОжидаемыйХеш) И ОжидаемыйХеш = ХешАргументов(Аргументы);
		ИначеЕсли Вид = "documents" Тогда
			ОжидаемыйИнструмент = Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Состояние, "tool"));
			Если Не ПустаяСтрока(ОжидаемыйИнструмент) И ОжидаемыйИнструмент <> Инструмент Тогда
				Возврат Ложь;
			КонецЕсли;
			Возврат ДокументныеИнструменты().Найти(Инструмент) <> Неопределено;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	Возврат Ложь;
КонецФункции

Процедура УстановитьОдобрение(Запуск, Вид, Инструмент, Аргументы, Решение, Текст, IDВзаимодействия) Экспорт
	Объект = Запуск.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Хеш = "";
	АргументыJSON = "";
	Если Вид = "action" Тогда
		Хеш = ХешАргументов(Аргументы);
		АргументыJSON = АИС_КлиентВнешнегоСервиса.ЗаписатьJSON(Аргументы);
	КонецЕсли;
	Объект.ОдобрениеJSON = АИС_КлиентВнешнегоСервиса.ЗаписатьJSON(Новый Структура(
		"subject_kind,tool,args_hash,args_json,decision,answer_text,interaction_id,consumed,created_at",
		Вид, Инструмент, Хеш, АргументыJSON, Решение, Текст, IDВзаимодействия, Ложь, ТекущаяДатаСеанса()));
	Объект.ДатаОбновления = ТекущаяДатаСеанса();
	Объект.Записать();
КонецПроцедуры

Процедура ПометитьОдобрениеИспользованным(Запуск) Экспорт
	Объект = Запуск.ПолучитьОбъект();
	Если Объект = Неопределено ИЛИ ПустаяСтрока(Объект.ОдобрениеJSON) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Состояние = АИС_КлиентВнешнегоСервиса.ПрочитатьJSONИзСтроки(Объект.ОдобрениеJSON);
		Состояние.Вставить("consumed", Истина);
		Объект.ОдобрениеJSON = АИС_КлиентВнешнегоСервиса.ЗаписатьJSON(Состояние);
		Объект.Записать();
	Исключение
		Возврат;
	КонецПопытки;
КонецПроцедуры

Функция ПовторитьЗапуск(Запуск) Экспорт
	Объект = Запуск.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат "Запуск не найден.";
	КонецЕсли;
	Если Объект.Состояние = Перечисления.АИС_СостоянияЗапусковАгента.ОжидаетОтвета Тогда
		Возврат "Сначала ответьте на запрос агента.";
	КонецЕсли;
	Если Объект.Состояние = Перечисления.АИС_СостоянияЗапусковАгента.Завершен Тогда
		Возврат "Запуск уже завершен.";
	КонецЕсли;
	Если Не Константы.АИС_АгентВключен.Получить() Тогда
		Возврат "ИИ-агент выключен администратором.";
	КонецЕсли;
	Настройка = НайтиПоСотруднику(Объект.Сотрудник);
	Если Не ЗначениеЗаполнено(Настройка)
		ИЛИ Не Настройка.Включен
		ИЛИ ПустаяСтрока(Настройка.РольПромпт) Тогда
		Возврат "Агент сотрудника не включен или роль-промпт не сформирован.";
	КонецЕсли;
	Если ЗадачаВыполнена(Объект.Задача) Тогда
		Возврат "Задача уже выполнена.";
	КонецЕсли;
	Объект.Состояние = Перечисления.АИС_СостоянияЗапусковАгента.Ожидает;
	Объект.Попытки = 0;
	Объект.Ошибка = "";
	Объект.Заблокирован = Ложь;
	Объект.СледующаяПопытка = ТекущаяДатаСеанса();
	Объект.ДатаОбновления = ТекущаяДатаСеанса();
	Объект.Записать();
	Возврат "Запуск поставлен в очередь.";
КонецФункции

Функция КлючИнструмента(Запуск, Шаг, Инструмент, Аргументы) Экспорт
	СтрокаКлюча = Строка(Запуск.УникальныйИдентификатор()) + "|"
		+ Строка(Шаг) + "|" + Инструмент + "|" + ХешАргументов(Аргументы);
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(СтрокаКлюча);
	Хеш = НРег(СтрЗаменить(Хеширование.ХешСумма, " ", ""));
	Возврат Лев(Хеш, 8) + "-" + Сред(Хеш, 9, 4) + "-" + Сред(Хеш, 13, 4)
		+ "-" + Сред(Хеш, 17, 4) + "-" + Сред(Хеш, 21, 12);
КонецФункции

Функция РезультатИзJSON(Текст) Экспорт
	Если ПустаяСтрока(Текст) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Значение = АИС_КлиентВнешнегоСервиса.ПрочитатьJSONИзСтроки(Текст);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если ТипЗнч(Значение) = Тип("Структура") ИЛИ ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Возврат Значение;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция НайтиЗаписьИнструмента(Ключ) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	История.Статус КАК Статус,
		|	История.Результат КАК Результат
		|ИЗ
		|	РегистрСведений.АИС_ИсторияДействийИИ КАК История
		|ГДЕ
		|	История.ИдентификаторЗаписи = &Ключ
		|УПОРЯДОЧИТЬ ПО
		|	История.Период УБЫВ";
	Запрос.УстановитьПараметр("Ключ", Ключ);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Новый Структура("Статус,Результат", Выборка.Статус, Выборка.Результат);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ЗарегистрироватьНачалоИнструмента(Параметры) Экспорт
	Существующая = НайтиЗаписьИнструмента(Параметры.Ключ);
	Если Существующая <> Неопределено Тогда
		Если Существующая.Статус = "ok" Тогда
			Возврат Новый Структура("Статус,Результат", "выполнен", Существующая.Результат);
		ИначеЕсли Существующая.Статус = "started" Тогда
			Возврат Новый Структура("Статус,Результат", "в_процессе", "");
		КонецЕсли;
	КонецЕсли;
	Параметры.Статус = "started";
	ЗаписатьИсториюИнструмента(Параметры);
	Возврат Новый Структура("Статус,Результат", "новый", "");
КонецФункции

Процедура ЗаписатьИсториюИнструмента(Параметры) Экспорт
	Попытка
		Запись = РегистрыСведений.АИС_ИсторияДействийИИ.СоздатьМенеджерЗаписи();
		Запись.Период = ТекущаяДатаСеанса();
		Запись.ИдентификаторЗаписи = Параметры.Ключ;
		Запись.ДатаВремя = ТекущаяДатаСеанса();
		Запись.Запуск = Параметры.Запуск;
		Запись.Задача = Параметры.Задача;
		Запись.ТипДействия = Справочники.АИС_ТипыДействий.ПустаяСсылка();
		Запись.Шаг = Параметры.Шаг;
		Запись.Инструмент = Параметры.Инструмент;
		Запись.Группа = Параметры.Группа;
		Запись.ХешАргументов = ХешАргументов(Параметры.Аргументы);
		Запись.ВходныеДанные = ЗаписатьJSONБезопасно(Параметры.Аргументы);
		Запись.Статус = Параметры.Статус;
		Запись.Результат = ?(Параметры.Результат = Неопределено,
			"", ЗаписатьJSONБезопасно(Параметры.Результат));
		Запись.Ошибка = Параметры.Ошибка;
		Запись.Промпт = "";
		Запись.Ответ = "";
		Запись.Модель = "";
		Запись.ВерсияПромпта = 0;
		Запись.Токены = 0;
		Запись.Стоимость = 0;
		Запись.Длительность = Параметры.Длительность;
		Запись.Записать();
	Исключение
		ЗаписьЖурналаРегистрации(
			"АИС.АгентИИ",
			УровеньЖурналаРегистрации.Предупреждение,
			,
			,
			"Не удалось записать аудит инструмента: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

Функция ЗаписатьJSONБезопасно(Значение)
	Попытка
		Возврат АИС_КлиентВнешнегоСервиса.ЗаписатьJSON(Значение);
	Исключение
		Возврат Строка(Значение);
	КонецПопытки;
КонецФункции

Функция ЭтоКаталог(Путь)
	Файл = Новый Файл(Путь);
	Возврат Файл.Существует() И Файл.ЭтоКаталог();
КонецФункции

Функция ЭтоФайл(Путь)
	Файл = Новый Файл(Путь);
	Возврат Файл.Существует() И Не Файл.ЭтоКаталог();
КонецФункции

Функция ПрочитатьТекст(Путь)
	Попытка
		Чтение = Новый ЧтениеТекста(Путь, "UTF-8");
		Текст = Чтение.Прочитать();
		Чтение.Закрыть();
		Возврат Текст;
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

Функция АдаптироватьБазовыйПромпт(Текст)
	Текст = СтрЗаменить(
		Текст,
		"Ты — симулятор. Если приказ требует сходить, осмотреть, проверить, провести инвентаризацию или иное физическое действие **в пределах твоей зоны ответственности**, разрешается подтвердить, что действие выполнено, и привести правдоподобный результат. С большей вероятностью результат должен быть успешным; отклонения и недостатки указывай только если они правдоподобны и полезны для сценария.",
		"Если приказ требует физического действия, которого ты не можешь выполнить (сходить, осмотреть, проверить, провести инвентаризацию), задай вопрос человеку-пользователю. Не подтверждай действие и не выдумывай результат.");
	Текст = СтрЗаменить(
		Текст,
		"Симулировать физические действия можно только в пределах своей зоны ответственности; чужие осмотры и проверки не подменяй.",
		"Физические действия, осмотры и проверки выполняет человек; если они нужны, задай вопрос пользователю.");
	Текст = СтрЗаменить(
		Текст,
		"- Задачи по наполнению уже раздаются симулятором каждому сотруднику детерминированно. Не создавай их повторно и не перепоручай: работай со своей задачей и отчётами исполнителей.",
		"- Задачи по наполнению раздаёт человек-пользователь. Не создавай их сам и не перепоручай: работай со своей задачей и отчётами исполнителей.");
	Текст = СтрЗаменить(
		Текст,
		"Оркестратор вернётся к ней после закрытия задач нижнего уровня.",
		"К задаче можно вернуться после закрытия задач нижнего уровня.");
	Текст = СтрЗаменить(Текст, "агент-симулятор", "ИИ-агент");
	Возврат Текст;
КонецФункции

// Переводит просроченные запросы к пользователю и их запуски в состояние
// Истек. Вызывается регламентным заданием АИС_АгентТаймауты.
Процедура ИстечьПросроченныеВзаимодействия() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Взаимодействия.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.АИС_ВзаимодействияИИ КАК Взаимодействия
		|ГДЕ
		|	Взаимодействия.Статус = &Ожидает
		|	И Взаимодействия.СрокОтвета <> &ПустаяДата
		|	И Взаимодействия.СрокОтвета < &Сейчас";
	Запрос.УстановитьПараметр("Ожидает", Перечисления.АИС_СостоянияВзаимодействийИИ.Ожидает);
	Запрос.УстановитьПараметр("ПустаяДата", Дата(1, 1, 1));
	Запрос.УстановитьПараметр("Сейчас", ТекущаяДатаСеанса());
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Попытка
			Взаимодействие = Выборка.Ссылка.ПолучитьОбъект();
			Если Взаимодействие = Неопределено
				ИЛИ Взаимодействие.Статус <> Перечисления.АИС_СостоянияВзаимодействийИИ.Ожидает Тогда
				Продолжить;
			КонецЕсли;
			Взаимодействие.Статус = Перечисления.АИС_СостоянияВзаимодействийИИ.Истек;
			Взаимодействие.Записать();
			ЗакрытьУведомление(Взаимодействие, "Срок ответа истек");
			Если Не ЗначениеЗаполнено(Взаимодействие.Запуск) Тогда
				Продолжить;
			КонецЕсли;
			ЗапускОбъект = Взаимодействие.Запуск.ПолучитьОбъект();
			Если ЗапускОбъект = Неопределено
				ИЛИ ЗапускОбъект.Состояние <> Перечисления.АИС_СостоянияЗапусковАгента.ОжидаетОтвета Тогда
				Продолжить;
			КонецЕсли;
			ЗапускОбъект.Состояние = Перечисления.АИС_СостоянияЗапусковАгента.Истек;
			ЗапускОбъект.Ошибка = "Истек срок ответа пользователя";
			ЗапускОбъект.ДатаЗавершения = ТекущаяДатаСеанса();
			ЗапускОбъект.ДатаОбновления = ТекущаяДатаСеанса();
			ЗапускОбъект.Заблокирован = Ложь;
			ЗапускОбъект.Записать();
		Исключение
			ЗаписьЖурналаРегистрации(
				"АИС.АгентИИ",
				УровеньЖурналаРегистрации.Ошибка,
				,
				,
				"Не удалось истечь взаимодействие " + Строка(Выборка.Ссылка) + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры


#КонецОбласти

