#Область ПрограммныйИнтерфейс

// Создаёт внутренний документ по шаблону и экземпляры разделов из
// плейсхолдеров шаблона с Вид = Раздел. Возвращает структуру:
// Документ, Разделы (массив ссылок).
Функция СоздатьДокументПоШаблону(Шаблон, Заголовок, Автор) Экспорт
	Если Не ЗначениеЗаполнено(Шаблон) Или Не ЗначениеЗаполнено(Автор) Тогда
		ВызватьИсключение "Не указан шаблон или автор документа.";
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);

	Документ = Справочники.ВнутренниеДокументы.СоздатьЭлемент();
	Документ.ОбработкаЗаполнения(Неопределено, Ложь);
	Документ.ВидДокумента = Шаблон.ВидДокумента;
	Документ.Заголовок = Заголовок;
	Документ.Содержание = Строка(Шаблон.КомментарийКШаблону);
	Документ.Подготовил = Автор;
	Документ.ДатаСоздания = ТекущаяДатаСеанса();
	Документ.Записать();

	Разделы = Новый Массив;
	Для Каждого Плейсхолдер Из Шаблон.АИС_Плейсхолдеры Цикл
		Если Плейсхолдер.Вид <> Перечисления.АИС_ВидыПлейсхолдеров.Раздел Тогда
			Продолжить;
		КонецЕсли;
		Раздел = СоздатьРазделДокумента(
			Документ,
			Неопределено,
			Шаблон,
			Плейсхолдер.Маркер,
			Плейсхолдер.Заголовок,
			Плейсхолдер.Порядок,
			Плейсхолдер.Обязательность,
			Плейсхолдер.Формат);
		Разделы.Добавить(Раздел);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Документ", Документ.Ссылка);
	Результат.Вставить("Разделы", Разделы);
	Возврат Результат;
КонецФункции

// Черновик без шаблона: документ с верхнеуровневыми разделами.
Функция СоздатьЧерновикСРазделами(Заголовок, Автор, Разделы, Вид = "План") Экспорт
	УстановитьПривилегированныйРежим(Истина);
	ВидДокумента = АИС_ОбщегоНазначения.НайтиИлиСоздатьЭлемент(
		Справочники.ВидыВнутреннихДокументов, Вид);
	ВидДокумента.Записать();
	СлужебныйШаблон = ОбеспечитьСлужебныйШаблонРазделов();
	Объект = Справочники.ВнутренниеДокументы.СоздатьЭлемент();
	Объект.ОбработкаЗаполнения(Неопределено, Ложь);
	Объект.ВидДокумента = ВидДокумента.Ссылка;
	Объект.Заголовок = Заголовок;
	Объект.Содержание = "";
	Объект.Подготовил = Автор;
	Объект.ДатаСоздания = ТекущаяДатаСеанса();
	Объект.Записать();

	Созданные = Новый Массив;
	Номер = 0;
	Для Каждого Описание Из Разделы Цикл
		Номер = Номер + 1;
		ЗаголовокРаздела = ?(ТипЗнч(Описание) = Тип("Структура"),
			Строка(Описание.Заголовок), Строка(Описание));
		Маркер = ?(ТипЗнч(Описание) = Тип("Структура"),
			Строка(Описание.Маркер), "РАЗДЕЛ_" + Формат(Номер, "ЧГ=0"));
		Порядок = ?(ТипЗнч(Описание) = Тип("Структура"), Описание.Порядок, Номер);
		Обязательный = ?(ТипЗнч(Описание) = Тип("Структура"), Описание.Обязательный, Истина);
		Раздел = СоздатьРазделДокумента(
			Объект.Ссылка, Неопределено, СлужебныйШаблон.Ссылка,
			Маркер, ЗаголовокРаздела, Порядок, Обязательный, "");
		Созданные.Добавить(Раздел);
	КонецЦикла;
	Объект.Содержание = СобратьЗаголовки(Созданные);
	Объект.Записать();

	Результат = Новый Структура;
	Результат.Вставить("Документ", Объект.Ссылка);
	Результат.Вставить("Разделы", Созданные);
	Возврат Результат;
КонецФункции

// Издаёт индивидуальное распоряжение по разделу, связывает его с черновиком
// и назначает ответственного. Задача создаётся штатной подпиской/помощником.
Функция ИздатьРаспоряжениеПоРазделу(Раздел, Исполнитель, Автор,
	Заголовок = "", Содержание = "") Экспорт
	Если Не ЗначениеЗаполнено(Раздел) Или Не ЗначениеЗаполнено(Исполнитель) Тогда
		Возврат Неопределено;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	РазделОбъект = Раздел.ПолучитьОбъект();
	Если РазделОбъект = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Вид = АИС_ОбщегоНазначения.НайтиИлиСоздатьЭлемент(
		Справочники.ВидыВнутреннихДокументов, "Распоряжение");
	Вид.Записать();
	Распоряжение = Справочники.ВнутренниеДокументы.СоздатьЭлемент();
	Распоряжение.ОбработкаЗаполнения(Неопределено, Ложь);
	Распоряжение.ВидДокумента = Вид.Ссылка;
	Распоряжение.Заголовок = ?(ПустаяСтрока(Заголовок),
		"О подготовке раздела: " + РазделОбъект.Заголовок, Заголовок);
	Распоряжение.Содержание = ?(ПустаяСтрока(Содержание),
		"Подготовить раздел «" + РазделОбъект.Заголовок + "» документа "
			+ Строка(РазделОбъект.Документ) + ". Раздел: " + Строка(Раздел) + ".",
		Содержание);
	Распоряжение.Подготовил = Автор;
	Распоряжение.Адресат = Исполнитель;
	Распоряжение.ДатаСоздания = ТекущаяДатаСеанса();
	Распоряжение.Записать();

	// Связь документа-поручения с черновиком: основание -> поручение.
	АИС_ОбщегоНазначения.СоздатьСвязьДокументаСОснованием(
		Распоряжение.Ссылка, РазделОбъект.Документ);

	Задача = АИС_ОбщегоНазначения.НайтиИлиСоздатьЗадачу(
		Исполнитель,
		"Разработать раздел: " + РазделОбъект.Заголовок,
		"Рассмотрите распоряжение " + Строка(Распоряжение.Ссылка)
			+ " и подготовьте раздел «" + РазделОбъект.Заголовок + "».",
		Автор,
		Распоряжение.Ссылка,
		"section-order:" + Строка(Раздел.УникальныйИдентификатор()));
	РазделОбъект.Ответственный = Исполнитель;
	РазделОбъект.Задача = Задача;
	РазделОбъект.Распоряжение = Распоряжение.Ссылка;
	РазделОбъект.Статус = Перечисления.АИС_СостоянияРазделов.Черновик;
	РазделОбъект.Записать();

	Результат = Новый Структура;
	Результат.Вставить("Раздел", Раздел);
	Результат.Вставить("Распоряжение", Распоряжение.Ссылка);
	Результат.Вставить("Задача", Задача);
	Возврат Результат;
КонецФункции

// Назначает раздел исполнителю: создаёт штатную задачу с предметом-документом,
// а связь с конкретным разделом хранит в АИС_РазделыДокумента.Задача.
Функция НазначитьРаздел(Раздел, Исполнитель, Автор = Неопределено) Экспорт
	Если Не ЗначениеЗаполнено(Раздел) Или Не ЗначениеЗаполнено(Исполнитель) Тогда
		Возврат Неопределено;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Объект = Раздел.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	АвторЗадачи = ?(ЗначениеЗаполнено(Автор), Автор, Объект.Документ.Подготовил);
	Наименование = "Разработать раздел: " + Объект.Заголовок;
	Описание =
		"Документ: " + Строка(Объект.Документ) + Символы.ПС
		+ "Раздел: " + Строка(Раздел) + Символы.ПС
		+ "Маркер: " + Объект.Раздел + Символы.ПС
		+ "Заголовок: " + Объект.Заголовок + Символы.ПС
		+ "Разработайте содержание раздела. При необходимости создайте подразделы "
		+ "и назначьте их исполнителям. Готовый текст сохраните в раздел и отправьте "
		+ "на подтверждение руководителю.";
	Задача = АИС_ОбщегоНазначения.НайтиИлиСоздатьЗадачу(
		Исполнитель, Наименование, Описание, АвторЗадачи, Объект.Документ,
		"section-assign:" + Строка(Раздел.УникальныйИдентификатор()));
	Если Не ЗначениеЗаполнено(Задача) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Объект.Ответственный = Исполнитель;
	Объект.Задача = Задача;
	Если Объект.Статус = Перечисления.АИС_СостоянияРазделов.НеНачат Тогда
		Объект.Статус = Перечисления.АИС_СостоянияРазделов.Черновик;
	КонецЕсли;
	Объект.Записать();
	Возврат Задача;
КонецФункции

// Сохраняет текст раздела. При Отправить = Истина переводит раздел в
// «На подтверждении» и создаёт задачу руководителю раздела (если известен).
Функция ЗаписатьСодержаниеРаздела(Раздел, Содержание,
	Отправить = Ложь, Автор = Неопределено) Экспорт
	Если Не ЗначениеЗаполнено(Раздел) Тогда
		Возврат Ложь;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Объект = Раздел.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Объект.Содержание = Содержание;
	Если Отправить Тогда
		Объект.Статус = Перечисления.АИС_СостоянияРазделов.НаПодтверждении;
	КонецЕсли;
	Объект.Записать();
	Если Отправить Тогда
		Руководитель = Неопределено;
		Если ЗначениеЗаполнено(Объект.Родитель) Тогда
			РодительОбъект = Объект.Родитель.ПолучитьОбъект();
			Если РодительОбъект <> Неопределено Тогда
				Руководитель = РодительОбъект.Ответственный;
			КонецЕсли;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Руководитель) Тогда
			Руководитель = Объект.Документ.Подготовил;
		КонецЕсли;
		Если ЗначениеЗаполнено(Руководитель) Тогда
			АИС_ОбщегоНазначения.НайтиИлиСоздатьЗадачу(
				Руководитель,
				"Подтвердить раздел: " + Объект.Заголовок,
				"Проверьте и подтвердите раздел «" + Объект.Заголовок + "» документа "
					+ Строка(Объект.Документ) + ". Раздел: " + Строка(Раздел) + ".",
				?(ЗначениеЗаполнено(Автор), Автор, Объект.Ответственный),
				Объект.Документ,
				"section-confirm:" + Строка(Раздел.УникальныйИдентификатор()));
		КонецЕсли;
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Создаёт подраздел и назначает его исполнителю. Родитель определяет
// документ, владельца и иерархию.
Функция СоздатьПодраздел(Родитель, Заголовок, Исполнитель = Неопределено,
	Автор = Неопределено) Экспорт
	Если Не ЗначениеЗаполнено(Родитель) Тогда
		Возврат Неопределено;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	РодительОбъект = Родитель.ПолучитьОбъект();
	Если РодительОбъект = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Раздел = СоздатьРазделДокумента(
		РодительОбъект.Документ,
		Родитель,
		РодительОбъект.Владелец,
		Строка(Новый УникальныйИдентификатор()),
		Заголовок,
		РодительОбъект.Порядок + 1,
		Ложь,
		"");
	Если ЗначениеЗаполнено(Исполнитель) Тогда
		НазначитьРаздел(Раздел, Исполнитель, Автор);
	КонецЕсли;
	Возврат Раздел;
КонецФункции

// Проверяет, что пользователь вправе подтвердить раздел: ответственный
// раздела, ответственный родительского раздела (для подраздела) или автор
// документа (для раздела верхнего уровня). Это соответствует адресации
// задач в ЗаписатьСодержаниеРаздела.
Функция МожетПодтверждатьРаздел(Раздел, Пользователь) Экспорт
	Если Не ЗначениеЗаполнено(Раздел) Или Не ЗначениеЗаполнено(Пользователь) Тогда
		Возврат Ложь;
	КонецЕсли;
	Объект = Раздел.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Объект.Ответственный = Пользователь Тогда
		Возврат Истина;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.Родитель) Тогда
		РодительОбъект = Объект.Родитель.ПолучитьОбъект();
		Если РодительОбъект <> Неопределено
			И РодительОбъект.Ответственный = Пользователь Тогда
			Возврат Истина;
		КонецЕсли;
	Иначе
		Если Объект.Документ.Подготовил = Пользователь Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	Возврат Ложь;
КонецФункции

// Возвращает подразделы, которые ещё не подтверждены.
Функция НеПодтверждённыеПодразделы(Раздел) Экспорт
	Результат = Новый Массив;
	Если Не ЗначениеЗаполнено(Раздел) Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Родитель", Раздел);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Разделы.Ссылка КАК Ссылка,
	|	Разделы.Заголовок КАК Заголовок,
	|	Разделы.Статус КАК Статус
	|ИЗ
	|	Справочник.АИС_РазделыДокумента КАК Разделы
	|ГДЕ
	|	Разделы.Родитель = &Родитель
	|	И НЕ Разделы.ПометкаУдаления
	|	И Разделы.Статус <> ЗНАЧЕНИЕ(Перечисление.АИС_СостоянияРазделов.Подтвержден)";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Новый Структура;
		Строка.Вставить("Ссылка", Выборка.Ссылка);
		Строка.Вставить("Заголовок", Выборка.Заголовок);
		Строка.Вставить("Статус", Выборка.Статус);
		Результат.Добавить(Строка);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Проверяет готовность документа к сборке: подтверждены все разделы,
// которые обязательны или уже содержат текст. Пустые необязательные
// разделы сборку не блокируют.
Функция ПроверитьГотовностьДокумента(Документ) Экспорт
	Результат = Новый Структура;
	Результат.Вставить("Готов", Ложь);
	Результат.Вставить("Всего", 0);
	Результат.Вставить("Подтверждено", 0);
	Результат.Вставить("Неподтверждённые", Новый Массив);
	Если Не ЗначениеЗаполнено(Документ) Тогда
		Возврат Результат;
	КонецЕсли;
	Разделы = ПолучитьРазделы(Документ);
	Результат.Всего = Разделы.Количество();
	Для Каждого Раздел Из Разделы Цикл
		Если Раздел.Статус = Перечисления.АИС_СостоянияРазделов.Подтвержден Тогда
			Результат.Подтверждено = Результат.Подтверждено + 1;
		ИначеЕсли Раздел.Обязательный Или Не ПустаяСтрока(Раздел.Содержание) Тогда
			Результат.Неподтверждённые.Добавить(Раздел);
		КонецЕсли;
	КонецЦикла;
	Результат.Готов = Результат.Неподтверждённые.Количество() = 0;
	Возврат Результат;
КонецФункции

// Подтверждает раздел. Нельзя подтвердить раздел, пока не подтверждены
// его подразделы, и нельзя подтверждать чужие разделы.
Функция ПодтвердитьРаздел(Раздел, Пользователь) Экспорт
	Если Не ЗначениеЗаполнено(Раздел) Тогда
		Возврат Ложь;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Объект = Раздел.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Не МожетПодтверждатьРаздел(Раздел, Пользователь) Тогда
		ВызватьИсключение "Недостаточно прав для подтверждения раздела: "
			+ Объект.Заголовок;
	КонецЕсли;
	НеПодтверждены = НеПодтверждённыеПодразделы(Раздел);
	Если НеПодтверждены.Количество() > 0 Тогда
		Заголовки = Новый Массив;
		Для Каждого Строка Из НеПодтверждены Цикл
			Заголовки.Добавить(Строка.Заголовок);
		КонецЦикла;
		ВызватьИсключение "Нельзя подтвердить раздел «" + Объект.Заголовок
			+ "»: не подтверждены подразделы: " + СтрСоединить(Заголовки, "; ");
	КонецЕсли;
	Объект.Статус = Перечисления.АИС_СостоянияРазделов.Подтвержден;
	Объект.Подтвердил = Пользователь;
	Объект.ДатаПодтверждения = ТекущаяДатаСеанса();
	Объект.Записать();
	Возврат Истина;
КонецФункции

// Собирает итоговый текст из подтверждённых разделов, записывает его в
// документ и создаёт задачу утверждения. Возвращает текст или Неопределено.
Функция СобратьДокумент(Документ, Утверждающий = Неопределено, Автор = Неопределено) Экспорт
	Если Не ЗначениеЗаполнено(Документ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Разделы = ПолучитьРазделы(Документ);
	Если Разделы.Количество() = 0 Тогда
		ВызватьИсключение "У документа нет разделов.";
	КонецЕсли;
	Готовность = ПроверитьГотовностьДокумента(Документ);
	Если Не Готовность.Готов Тогда
		Заголовки = Новый Массив;
		Для Каждого Раздел Из Готовность.Неподтверждённые Цикл
			Заголовки.Добавить(Раздел.Заголовок);
		КонецЦикла;
		ВызватьИсключение "Не подтверждены разделы: "
			+ СтрСоединить(Заголовки, "; ");
	КонецЕсли;
	Текст = СобратьТекстРазделов(Разделы, Неопределено, Истина);
	Объект = Документ.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Объект.Содержание = Текст;
	Объект.Записать();
	Если ЗначениеЗаполнено(Утверждающий) Тогда
		Наименование = "Рассмотреть: " + Объект.Заголовок;
		Описание = "Собран итоговый документ. Проверьте разделы и утвердите документ. "
			+ "Итоговый текст:" + Символы.ПС + Символы.ПС + Текст;
		АИС_ОбщегоНазначения.НайтиИлиСоздатьЗадачу(
			Утверждающий, Наименование, Описание,
			?(ЗначениеЗаполнено(Автор), Автор, Объект.Подготовил), Документ,
			"document-approve:" + Строка(Документ.УникальныйИдентификатор()));
	КонецЕсли;
	Возврат Текст;
КонецФункции

// Плоский список разделов документа с иерархией и содержимым.
Функция ПолучитьРазделы(Документ) Экспорт
	Результат = Новый Массив;
	Если Не ЗначениеЗаполнено(Документ) Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Разделы.Ссылка КАК Ссылка,
	|	Разделы.Родитель КАК Родитель,
	|	Разделы.Заголовок КАК Заголовок,
	|	Разделы.Раздел КАК Раздел,
	|	Разделы.Порядок КАК Порядок,
	|	Разделы.Обязательный КАК Обязательный,
	|	Разделы.Содержание КАК Содержание,
	|	Разделы.Ответственный КАК Ответственный,
	|	Разделы.Задача КАК Задача,
	|	Разделы.Распоряжение КАК Распоряжение,
	|	Разделы.Статус КАК Статус
	|ИЗ
	|	Справочник.АИС_РазделыДокумента КАК Разделы
	|ГДЕ
	|	Разделы.Документ = &Документ
	|	И НЕ Разделы.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Разделы.Порядок, Разделы.Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Новый Структура;
		Строка.Вставить("Ссылка", Выборка.Ссылка);
		Строка.Вставить("Родитель", Выборка.Родитель);
		Строка.Вставить("Заголовок", Выборка.Заголовок);
		Строка.Вставить("Раздел", Выборка.Раздел);
		Строка.Вставить("Порядок", Выборка.Порядок);
		Строка.Вставить("Обязательный", Выборка.Обязательный);
		Строка.Вставить("Содержание", Выборка.Содержание);
		Строка.Вставить("Ответственный", Выборка.Ответственный);
		Строка.Вставить("Задача", Выборка.Задача);
		Строка.Вставить("Распоряжение", Выборка.Распоряжение);
		Строка.Вставить("Статус", Выборка.Статус);
		Результат.Добавить(Строка);
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОбеспечитьСлужебныйШаблонРазделов()
	Шаблон = Справочники.ШаблоныВнутреннихДокументов.НайтиПоНаименованию(
		"Служебный шаблон разделов", Истина);
	Если ЗначениеЗаполнено(Шаблон) Тогда
		Возврат Шаблон;
	КонецЕсли;
	Вид = АИС_ОбщегоНазначения.НайтиИлиСоздатьЭлемент(
		Справочники.ВидыВнутреннихДокументов, "Документ");
	Вид.Записать();
	Объект = Справочники.ШаблоныВнутреннихДокументов.СоздатьЭлемент();
	Объект.Наименование = "Служебный шаблон разделов";
	Объект.Заголовок = "Служебный шаблон разделов";
	Объект.ВидДокумента = Вид.Ссылка;
	Объект.Статус = "Утверждён";
	Объект.Записать();
	Возврат Объект.Ссылка;
КонецФункции

Функция СобратьЗаголовки(Разделы)
	Текст = "";
	Для Каждого Раздел Из Разделы Цикл
		Объект = Раздел.ПолучитьОбъект();
		Текст = Текст + Объект.Заголовок + Символы.ПС + Символы.ПС;
	КонецЦикла;
	Возврат Текст;
КонецФункции

Функция СоздатьРазделДокумента(Документ, Родитель, Владелец, Маркер, Заголовок,
	Порядок, Обязательный, Формат)
	Объект = Справочники.АИС_РазделыДокумента.СоздатьЭлемент();
	// Владелец справочника — шаблон; конкретный документ хранится в Документ.
	Объект.Владелец = Владелец;
	Объект.Наименование = Заголовок;
	Объект.Раздел = Маркер;
	Объект.Заголовок = Заголовок;
	Объект.Порядок = Порядок;
	Объект.Обязательный = Обязательный;
	Объект.Формат = Формат;
	Объект.Документ = Документ;
	Объект.Родитель = Родитель;
	Объект.Статус = Перечисления.АИС_СостоянияРазделов.НеНачат;
	Объект.Записать();
	Возврат Объект.Ссылка;
КонецФункции

Функция СобратьТекстРазделов(Разделы, Родитель, ТолькоПодтверждённые = Ложь)
	Текст = "";
	Для Каждого Раздел Из Разделы Цикл
		// Для верхнего уровня Родитель = Неопределено, а у корневых разделов
		// реквизит Родитель — пустая ссылка, а не Неопределено.
		РодительРаздела = ?(ЗначениеЗаполнено(Раздел.Родитель), Раздел.Родитель, Неопределено);
		Если РодительРаздела <> Родитель Тогда
			Продолжить;
		КонецЕсли;
		Если ТолькоПодтверждённые
			И Раздел.Статус <> Перечисления.АИС_СостоянияРазделов.Подтвержден Тогда
			Продолжить;
		КонецЕсли;
		Текст = Текст + Раздел.Заголовок + Символы.ПС + Раздел.Содержание
			+ Символы.ПС + Символы.ПС;
		Текст = Текст + СобратьТекстРазделов(Разделы, Раздел.Ссылка, ТолькоПодтверждённые);
	КонецЦикла;
	Возврат Текст;
КонецФункции

#КонецОбласти
