#Область ПрограммныйИнтерфейс

// Создаёт внутренний документ по шаблону и экземпляры разделов из
// плейсхолдеров шаблона с Вид = Раздел. Возвращает структуру:
// Документ, Разделы (массив ссылок).
Функция СоздатьДокументПоШаблону(Шаблон, Заголовок, Автор) Экспорт
	Если Не ЗначениеЗаполнено(Шаблон) Или Не ЗначениеЗаполнено(Автор) Тогда
		ВызватьИсключение "Не указан шаблон или автор документа.";
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);

	Документ = Справочники.ВнутренниеДокументы.СоздатьЭлемент();
	Документ.ОбработкаЗаполнения(Неопределено, Ложь);
	Документ.ВидДокумента = Шаблон.ВидДокумента;
	Документ.Заголовок = Заголовок;
	Документ.Содержание = Строка(Шаблон.КомментарийКШаблону);
	Документ.Подготовил = Автор;
	Документ.ДатаСоздания = ТекущаяДатаСеанса();
	Документ.Записать();

	Разделы = Новый Массив;
	Для Каждого Плейсхолдер Из Шаблон.АИС_Плейсхолдеры Цикл
		Если Плейсхолдер.Вид <> Перечисления.АИС_ВидыПлейсхолдеров.Раздел Тогда
			Продолжить;
		КонецЕсли;
		Раздел = СоздатьРазделДокумента(
			Документ,
			Неопределено,
			Шаблон,
			Плейсхолдер.Маркер,
			Плейсхолдер.Заголовок,
			Плейсхолдер.Порядок,
			Плейсхолдер.Обязательность,
			Плейсхолдер.Формат);
		Разделы.Добавить(Раздел);
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Документ", Документ.Ссылка);
	Результат.Вставить("Разделы", Разделы);
	Возврат Результат;
КонецФункции

// Назначает раздел исполнителю: создаёт штатную задачу с предметом-документом,
// а связь с конкретным разделом хранит в АИС_РазделыДокумента.Задача.
Функция НазначитьРаздел(Раздел, Исполнитель, Автор = Неопределено) Экспорт
	Если Не ЗначениеЗаполнено(Раздел) Или Не ЗначениеЗаполнено(Исполнитель) Тогда
		Возврат Неопределено;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Объект = Раздел.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	АвторЗадачи = ?(ЗначениеЗаполнено(Автор), Автор, Объект.Документ.Подготовил);
	Наименование = "Разработать раздел: " + Объект.Заголовок;
	Описание =
		"Документ: " + Строка(Объект.Документ) + "\n"
		+ "Раздел: " + Строка(Раздел) + "\n"
		+ "Маркер: " + Объект.Раздел + "\n"
		+ "Заголовок: " + Объект.Заголовок + "\n"
		+ "Разработайте содержание раздела. При необходимости создайте подразделы "
		+ "и назначьте их исполнителям. Готовый текст сохраните в раздел и отправьте "
		+ "на подтверждение руководителю.";
	Задача = АИС_ОбщегоНазначения.НайтиИлиСоздатьЗадачу(
		Исполнитель, Наименование, Описание, АвторЗадачи, Объект.Документ);
	Если Не ЗначениеЗаполнено(Задача) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Объект.Ответственный = Исполнитель;
	Объект.Задача = Задача;
	Если Объект.Статус = Перечисления.АИС_СостоянияРазделов.НеНачат Тогда
		Объект.Статус = Перечисления.АИС_СостоянияРазделов.Черновик;
	КонецЕсли;
	Объект.Записать();
	Возврат Задача;
КонецФункции

// Сохраняет текст раздела. При Отправить = Истина переводит раздел в
// «На подтверждении» и создаёт задачу руководителю раздела (если известен).
Функция ЗаписатьСодержаниеРаздела(Раздел, Содержание,
	Отправить = Ложь, Автор = Неопределено) Экспорт
	Если Не ЗначениеЗаполнено(Раздел) Тогда
		Возврат Ложь;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Объект = Раздел.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Объект.Содержание = Содержание;
	Если Отправить Тогда
		Объект.Статус = Перечисления.АИС_СостоянияРазделов.НаПодтверждении;
	КонецЕсли;
	Объект.Записать();
	Если Отправить Тогда
		Руководитель = Неопределено;
		Если ЗначениеЗаполнено(Объект.Родитель) Тогда
			РодительОбъект = Объект.Родитель.ПолучитьОбъект();
			Если РодительОбъект <> Неопределено Тогда
				Руководитель = РодительОбъект.Ответственный;
			КонецЕсли;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Руководитель) Тогда
			Руководитель = Объект.Документ.Подготовил;
		КонецЕсли;
		Если ЗначениеЗаполнено(Руководитель) Тогда
			АИС_ОбщегоНазначения.НайтиИлиСоздатьЗадачу(
				Руководитель,
				"Подтвердить раздел: " + Объект.Заголовок,
				"Проверьте и подтвердите раздел «" + Объект.Заголовок + "» документа "
					+ Строка(Объект.Документ) + ". Раздел: " + Строка(Раздел) + ".",
				?(ЗначениеЗаполнено(Автор), Автор, Объект.Ответственный),
				Объект.Документ);
		КонецЕсли;
	КонецЕсли;
	Возврат Истина;
КонецФункции

// Создаёт подраздел и назначает его исполнителю. Родитель определяет
// документ, владельца и иерархию.
Функция СоздатьПодраздел(Родитель, Заголовок, Исполнитель = Неопределено,
	Автор = Неопределено) Экспорт
	Если Не ЗначениеЗаполнено(Родитель) Тогда
		Возврат Неопределено;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	РодительОбъект = Родитель.ПолучитьОбъект();
	Если РодительОбъект = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Раздел = СоздатьРазделДокумента(
		РодительОбъект.Документ,
		Родитель,
		РодительОбъект.Владелец,
		Строка(Новый УникальныйИдентификатор()),
		Заголовок,
		РодительОбъект.Порядок + 1,
		Ложь,
		"");
	Если ЗначениеЗаполнено(Исполнитель) Тогда
		НазначитьРаздел(Раздел, Исполнитель, Автор);
	КонецЕсли;
	Возврат Раздел;
КонецФункции

// Подтверждает раздел. Если все обязательные разделы документа подтверждены,
// документ можно собирать.
Функция ПодтвердитьРаздел(Раздел, Пользователь) Экспорт
	Если Не ЗначениеЗаполнено(Раздел) Тогда
		Возврат Ложь;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Объект = Раздел.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Объект.Статус = Перечисления.АИС_СостоянияРазделов.Подтвержден;
	Объект.Подтвердил = Пользователь;
	Объект.ДатаПодтверждения = ТекущаяДатаСеанса();
	Объект.Записать();
	Возврат Истина;
КонецФункции

// Собирает итоговый текст из подтверждённых разделов, записывает его в
// документ и создаёт задачу утверждения. Возвращает текст или Неопределено.
Функция СобратьДокумент(Документ, Утверждающий = Неопределено, Автор = Неопределено) Экспорт
	Если Не ЗначениеЗаполнено(Документ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	Разделы = ПолучитьРазделы(Документ);
	Если Разделы.Количество() = 0 Тогда
		ВызватьИсключение "У документа нет разделов.";
	КонецЕсли;
	Для Каждого Раздел Из Разделы Цикл
		Если Раздел.Обязательный
			И Раздел.Статус <> Перечисления.АИС_СостоянияРазделов.Подтвержден Тогда
			ВызватьИсключение "Не подтверждён обязательный раздел: " + Раздел.Заголовок;
		КонецЕсли;
	КонецЦикла;
	Текст = СобратьТекстРазделов(Разделы, Неопределено);
	Объект = Документ.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Объект.Содержание = Текст;
	Объект.Записать();
	Если ЗначениеЗаполнено(Утверждающий) Тогда
		Наименование = "Рассмотреть: " + Объект.Заголовок;
		Описание = "Собран итоговый документ. Проверьте разделы и утвердите документ. "
			+ "Итоговый текст:\n\n" + Текст;
		АИС_ОбщегоНазначения.НайтиИлиСоздатьЗадачу(
			Утверждающий, Наименование, Описание,
			?(ЗначениеЗаполнено(Автор), Автор, Объект.Подготовил), Документ);
	КонецЕсли;
	Возврат Текст;
КонецФункции

// Плоский список разделов документа с иерархией и содержимым.
Функция ПолучитьРазделы(Документ) Экспорт
	Результат = Новый Массив;
	Если Не ЗначениеЗаполнено(Документ) Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Разделы.Ссылка КАК Ссылка,
	|	Разделы.Родитель КАК Родитель,
	|	Разделы.Заголовок КАК Заголовок,
	|	Разделы.Раздел КАК Раздел,
	|	Разделы.Порядок КАК Порядок,
	|	Разделы.Обязательный КАК Обязательный,
	|	Разделы.Содержание КАК Содержание,
	|	Разделы.Ответственный КАК Ответственный,
	|	Разделы.Задача КАК Задача,
	|	Разделы.Статус КАК Статус
	|ИЗ
	|	Справочник.АИС_РазделыДокумента КАК Разделы
	|ГДЕ
	|	Разделы.Документ = &Документ
	|	И НЕ Разделы.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Разделы.Порядок, Разделы.Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Новый Структура;
		Строка.Вставить("Ссылка", Выборка.Ссылка);
		Строка.Вставить("Родитель", Выборка.Родитель);
		Строка.Вставить("Заголовок", Выборка.Заголовок);
		Строка.Вставить("Раздел", Выборка.Раздел);
		Строка.Вставить("Порядок", Выборка.Порядок);
		Строка.Вставить("Обязательный", Выборка.Обязательный);
		Строка.Вставить("Содержание", Выборка.Содержание);
		Строка.Вставить("Ответственный", Выборка.Ответственный);
		Строка.Вставить("Задача", Выборка.Задача);
		Строка.Вставить("Статус", Выборка.Статус);
		Результат.Добавить(Строка);
	КонецЦикла;
	Возврат Результат;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьРазделДокумента(Документ, Родитель, Владелец, Маркер, Заголовок,
	Порядок, Обязательный, Формат)
	Объект = Справочники.АИС_РазделыДокумента.СоздатьЭлемент();
	// Владелец справочника — шаблон; конкретный документ хранится в Документ.
	Объект.Владелец = Владелец;
	Объект.Наименование = Заголовок;
	Объект.Раздел = Маркер;
	Объект.Заголовок = Заголовок;
	Объект.Порядок = Порядок;
	Объект.Обязательный = Обязательный;
	Объект.Формат = Формат;
	Объект.Документ = Документ;
	Объект.Родитель = Родитель;
	Объект.Статус = Перечисления.АИС_СостоянияРазделов.НеНачат;
	Объект.Записать();
	Возврат Объект.Ссылка;
КонецФункции

Функция СобратьТекстРазделов(Разделы, Родитель)
	Текст = "";
	Для Каждого Раздел Из Разделы Цикл
		Если Раздел.Родитель <> Родитель Тогда
			Продолжить;
		КонецЕсли;
		Текст = Текст + Раздел.Заголовок + "\n" + Раздел.Содержание + "\n\n";
		Текст = Текст + СобратьТекстРазделов(Разделы, Раздел.Ссылка);
	КонецЦикла;
	Возврат Текст;
КонецФункции

#КонецОбласти
