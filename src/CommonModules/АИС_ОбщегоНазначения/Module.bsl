#Область ПрограммныйИнтерфейс

// Находит элемент справочника по наименованию или создаёт новый (не записывая).
// Используется для идемпотентного наполнения данными: повторный вызов с тем
// же наименованием возвращает существующий объект для правки на месте, а не
// создаёт дубль.
Функция НайтиИлиСоздатьЭлемент(Менеджер, Наименование) Экспорт
	Ссылка = Менеджер.НайтиПоНаименованию(Наименование, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка.ПолучитьОбъект();
	КонецЕсли;
	Объект = Менеджер.СоздатьЭлемент();
	Объект.Наименование = Наименование;
	Возврат Объект;
КонецФункции

// Задача — всегда Задача.ЗадачаИсполнителя (docs/data-model.md §5); отдельного
// справочника-обёртки нет. В 1С:ДО такие задачи не создаются напрямую —
// только как результат старта бизнес-процесса. Для одноразовой, никому не
// адресованной задачи используется штатный процесс БизнесПроцессы.Исполнение
// без привязки к документу (по образцу
// BusinessProcesses.Рассмотрение.ObjectModule.СформироватьИсполнениеОбработка
// в базовой конфигурации): СоздатьБизнесПроцесс() -> заполнить -> Записать() ->
// Старт(); платформенный метод .Старт() порождает ЗадачаИсполнителя на
// исполнителя из ТЧ "Исполнители". Идемпотентно по паре
// (Исполнитель, Наименование), но только пока существующая задача ещё НЕ
// выполнена (см. фильтр "Выполнена = ЛОЖЬ" в запросе ниже): без него
// повторный триггер с тем же именем после того, как исполнитель уже
// закрыл такую задачу раньше, тихо дозаполнял бы Описание на СТАРОЙ
// выполненной задаче и возвращал её ссылку - вызывающая сторона не видела
// бы ошибки, но новая задача не появлялась бы в GET /tasks (который
// фильтрует Выполнена=ЛОЖЬ) вообще. Баг найден эмпирически 2026-10-26:
// приказ "О формировании службы главного инженера" создавался успешно
// (Статус: "создан"), но у адресата задача не появлялась - ровно из-за
// одноимённой уже выполненной задачи от более раннего прогона.
// Описание - полный текст задачи (например, содержание приказа), который
// исполнитель увидит вместе с её названием; по умолчанию - значение для
// старых вызовов без контекста (демо-данные).
// Предмет - документ-основание (обычно Справочник.ВнутренниеДокументы).
// Заполняется в штатной мультипредметности бизнес-процесса и задачи, чтобы
// задача была однозначно связана с приказом/документом, а не определялась
// по тексту наименования. Это позволяет отличать задачу по конкретному
// приказу от чужих и последующих задач.
Функция НайтиИлиСоздатьЗадачу(Исполнитель, Наименование, Описание = Неопределено, Автор = Неопределено, Предмет = Неопределено) Экспорт
	// ЗадачаИсполнителя.Наименование обрезается платформой до 150 символов
	// при записи (эмпирически подтверждено 2026-10-26) - без этой обрезки
	// здесь параметр поиска (полная, не обрезанная строка) никогда не
	// совпадёт с уже сохранённым (обрезанным) значением, и каждый повторный
	// вызов с длинным Наименованием (например, список из многих
	// запрошенных должностей) создавал бы новую задачу вместо нахождения
	// существующей - найдено на примере заявки на найм с 12 позициями.
	Если СтрДлина(Наименование) > 150 Тогда
		Наименование = Лев(Наименование, 150);
	КонецЕсли;

	// Если есть предмет, идемпотентность ищем по нему, а не по наименованию:
	// 1С:ДО дополняет наименование задачи представлением предмета, поэтому
	// точное сравнение с исходным текстом не находит уже созданную задачу
	// и плодит дубли (например, задача подписки + резервная задача).
	Если ЗначениеЗаполнено(Предмет) Тогда
		ЗапросПоПредмету = Новый Запрос;
		ЗапросПоПредмету.УстановитьПараметр("Исполнитель", Исполнитель);
		ЗапросПоПредмету.УстановитьПараметр("Предмет", Предмет);
		ЗапросПоПредмету.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Задачи.Ссылка КАК Ссылка
		|ИЗ
		|	Задача.ЗадачаИсполнителя КАК Задачи
		|ГДЕ
		|	Задачи.Исполнитель = &Исполнитель
		|	И Задачи.Выполнена = ЛОЖЬ
		|	И Задачи.Ссылка В
		|		(ВЫБРАТЬ
		|			ПредметыЗадачи.Ссылка КАК Ссылка
		|		ИЗ
		|			Задача.ЗадачаИсполнителя.Предметы КАК ПредметыЗадачи
		|		ГДЕ
		|			ПредметыЗадачи.Предмет = &Предмет)
		|УПОРЯДОЧИТЬ ПО
		|	Задачи.ДатаНачала УБЫВ";
		НайденнаяЗадача = ЗапросПоПредмету.Выполнить().Выбрать();
		Если НайденнаяЗадача.Следующий() Тогда
			ЗадачаОбъект = НайденнаяЗадача.Ссылка.ПолучитьОбъект();
			ТребуетсяЗапись = Ложь;
			Если Не ЗначениеЗаполнено(ЗадачаОбъект.ДатаНачала) Тогда
				ЗадачаОбъект.ДатаНачала = ТекущаяДатаСеанса();
				ТребуетсяЗапись = Истина;
			КонецЕсли;
			Если Описание <> Неопределено И ЗадачаОбъект.Описание <> Описание Тогда
				ЗадачаОбъект.Описание = Описание;
				ТребуетсяЗапись = Истина;
			КонецЕсли;
			Если ТребуетсяЗапись Тогда
				ЗадачаОбъект.Записать();
			КонецЕсли;
			ОбеспечитьПапкуЗадачи(Предмет, Исполнитель);
			Возврат НайденнаяЗадача.Ссылка;
		КонецЕсли;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Исполнитель", Исполнитель);
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЗадачаИсполнителя.Ссылка КАК Ссылка
	|ИЗ
	|	Задача.ЗадачаИсполнителя КАК ЗадачаИсполнителя
	|ГДЕ
	|	ЗадачаИсполнителя.Исполнитель = &Исполнитель
	|	И ЗадачаИсполнителя.Наименование = &Наименование
	|	И ЗадачаИсполнителя.Выполнена = ЛОЖЬ
	|УПОРЯДОЧИТЬ ПО
	|	ЗадачаИсполнителя.ДатаНачала УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ОснованиеЗадачи = Неопределено;
		Если ЗначениеЗаполнено(Предмет) Тогда
			ОснованиеЗадачи = ПолучитьОснованиеЗадачи(Выборка.Ссылка);
			Если ЗначениеЗаполнено(ОснованиеЗадачи) И ОснованиеЗадачи <> Предмет Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		// Идемпотентность — по паре (Исполнитель, Наименование), а не по всей
		// задаче целиком: при повторном вызове с другим Описанием (например,
		// документ, породивший задачу, был пересоздан с другим текстом)
		// дозаполняем его на уже существующей задаче, а не создаём дубль.
		ЗадачаОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ТребуетсяЗапись = Ложь;
		Если Не ЗначениеЗаполнено(ЗадачаОбъект.ДатаНачала) Тогда
			ЗадачаОбъект.ДатаНачала = ТекущаяДатаСеанса();
			ТребуетсяЗапись = Истина;
		КонецЕсли;
		Если Описание <> Неопределено И ЗадачаОбъект.Описание <> Описание Тогда
			ЗадачаОбъект.Описание = Описание;
			ТребуетсяЗапись = Истина;
		КонецЕсли;
		Если ЗначениеЗаполнено(Предмет) И Не ЗначениеЗаполнено(ОснованиеЗадачи) Тогда
			Если ДобавитьПредметВЗадачу(ЗадачаОбъект, Предмет) Тогда
				ТребуетсяЗапись = Истина;
			КонецЕсли;
		КонецЕсли;
		Если ТребуетсяЗапись Тогда
			ЗадачаОбъект.Записать();
		КонецЕсли;
		ОбеспечитьПапкуЗадачи(Предмет, Исполнитель);
		Возврат Выборка.Ссылка;
	КонецЦикла;

	// Автор задачи - тот, кто поставил поручение, а не исполнитель.
	// Если вызывающая сторона не передала автора, используем текущего
	// пользователя сеанса; в служебном контексте без пользователя - исполнителя.
	Если Не ЗначениеЗаполнено(Автор) Тогда
		Автор = ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Автор) Тогда
		Автор = Исполнитель;
	КонецЕсли;

	// .СоздатьБизнесПроцесс() не вызывает приватную (не экспортную)
	// ОбработкаЗаполнения базовой конфигурации — она срабатывает только при
	// интерактивном создании через форму. Поэтому обязательные поля (включая
	// платформенный системный атрибут "Дата", который не может быть пустой
	// датой у объекта вида "бизнес-процесс") заполняем сами.
	Процесс = БизнесПроцессы.Исполнение.СоздатьБизнесПроцесс();
	Процесс.Дата = ТекущаяДатаСеанса();
	// ДатаНачала нужна не только для маршрута: при прикреплении предмета
	// 1С:ДО пишет состояние документа с периодом из ДатаНачала. Пустая
	// дата валит запись "Period cannot be empty".
	Процесс.ДатаНачала = ТекущаяДатаСеанса();
	// КоличествоИтераций обязательно >= 1 (fillChecking ShowError), номер
	// итерации инициализируем вместе с ним. Платформа не применяет
	// fillValue при программном СоздатьБизнесПроцесс(), а без предметов
	// проверка заполнения не запускается - с предметом процесс иначе не
	// стартует.
	Процесс.НомерИтерации = 1;
	Процесс.КоличествоИтераций = 1;
	Процесс.Автор = Автор;
	Процесс.Важность = Перечисления.ВариантыВажностиЗадачи.Обычная;
	Процесс.ВариантИсполнения = Перечисления.ВариантыМаршрутизацииЗадач.Параллельно;
	Процесс.Наименование = Наименование;
	Процесс.Описание = ?(Описание = Неопределено, "Демонстрационная задача.", Описание);
	Строка = Процесс.Исполнители.Добавить();
	Строка.Исполнитель = Исполнитель;
	Строка.НаименованиеЗадачи = Наименование;
	Процесс.Записать();
	Если ЗначениеЗаполнено(Предмет) Тогда
		// Штатная мультипредметность: предмет процесса переносится в
		// ПредметыЗадач и далее в задачу при её создании процессом.
		Мультипредметность.ПередатьПредметыПроцессу(Процесс, Предмет, Ложь, Истина);
		ЗаполнитьИменаПредметовПроцесса(Процесс, Предмет);
		Процесс.Записать();
	КонецЕсли;
	Процесс.Старт();

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("БизнесПроцесс", Процесс.Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗадачаИсполнителя.Ссылка КАК Ссылка
	|ИЗ
	|	Задача.ЗадачаИсполнителя КАК ЗадачаИсполнителя
	|ГДЕ
	|	ЗадачаИсполнителя.БизнесПроцесс = &БизнесПроцесс";
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	// ДатаНачала задачи - не только для сортировки: по ней симулятор
	// ограничивает обработку задачами текущего изданного приказа. Платформа
	// не заполняет её при программном старте процесса.
	ЗадачаОбъект = Выборка.Ссылка.ПолучитьОбъект();
	ТребуетсяЗапись = Ложь;
	Если Не ЗначениеЗаполнено(ЗадачаОбъект.ДатаНачала) Тогда
		ЗадачаОбъект.ДатаНачала = Процесс.ДатаНачала;
		ТребуетсяЗапись = Истина;
	КонецЕсли;
	Если ЗначениеЗаполнено(Предмет) Тогда
		// Страховка на случай, если передача предметов процессу не сработала
		// (например, маршрут процесса не дал действий): задача всё равно
		// должна иметь структурированную связь с документом-основанием.
		Если ДобавитьПредметВЗадачу(ЗадачаОбъект, Предмет) Тогда
			ТребуетсяЗапись = Истина;
		КонецЕсли;
	КонецЕсли;
	Если ТребуетсяЗапись Тогда
		ЗадачаОбъект.Записать();
	КонецЕсли;
	ОбеспечитьПапкуЗадачи(Предмет, Исполнитель);
	Возврат Выборка.Ссылка;
КонецФункции

// Отменяет документ штатным механизмом 1С:ДО: связь
// «Не действует в соответствии» от отменяемого документа к отменяющему.
// СвязиДокументов автоматически устанавливает реквизит НеДействует.
Процедура ОтменитьДокумент(Документ, Основание, Комментарий = "") Экспорт
	Если Не ЗначениеЗаполнено(Документ) Или Не ЗначениеЗаполнено(Основание)
		Или Документ = Основание Тогда
		Возврат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	ТипСвязи = Справочники.ТипыСвязей.НеДействуетВСоответствии;
	СвязиДокументов.СоздатьНастройкуСвязи(
		ТипСвязи,
		Справочники.ВидыВнутреннихДокументов.ПустаяСсылка(),
		Справочники.ВидыВнутреннихДокументов.ПустаяСсылка(),
		Перечисления.ХарактерСвязей.Единичная,
		Справочники.ТипыСвязей.ДелаетНеДействующим,
		Перечисления.ХарактерСвязей.Множественная,
		Истина);
	СвязиДокументов.СоздатьСвязь(Документ, Основание, ТипСвязи, Комментарий);
	// СоздатьСвязь только пишет регистр; реквизит НеДействует у документа
	// устанавливает отдельная процедура штатной подсистемы.
	СвязиДокументов.УстановитьРеквизитыПриДобавленииСвязи(
		Документ, Неопределено, ТипСвязи);
КонецПроцедуры

// Возвращает документ-основание задачи из штатной мультипредметности.
// Сейчас в проекте основанием считается первый предмет типа
// Справочник.ВнутренниеДокументы; для задач без предмета возвращает
// Неопределено.
Функция ПолучитьОснованиеЗадачи(Задача) Экспорт
	Если Не ЗначениеЗаполнено(Задача) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Задача", Задача);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПредметыЗадачи.Предмет КАК Предмет
	|ИЗ
	|	Задача.ЗадачаИсполнителя.Предметы КАК ПредметыЗадачи
	|ГДЕ
	|	ПредметыЗадачи.Ссылка = &Задача";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ТипЗнч(Выборка.Предмет) = Тип("СправочникСсылка.ВнутренниеДокументы") Тогда
			Возврат Выборка.Предмет;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Добавляет предмет в ТЧ Предметы задачи, если его там ещё нет.
// Возвращает Истина, если объект задачи изменён и требует записи.
Функция ДобавитьПредметВЗадачу(ЗадачаОбъект, Предмет)
	Если ЗадачаОбъект = Неопределено Или Не ЗначениеЗаполнено(Предмет) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ЗадачаОбъект.Предметы.Найти(Предмет, "Предмет") <> Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Строка = ЗадачаОбъект.Предметы.Добавить();
	Строка.Предмет = Предмет;
	Строка.ИмяПредмета = МультипредметностьВызовСервера.ПолучитьСсылкуНаИмяПредметаПоСсылкеНаПредмет(Предмет);
	Строка.РольПредмета = Перечисления.РолиПредметов.Основной;
	Возврат Истина;
КонецФункции

// ПередатьПредметыПроцессу может оставить ИмяПредмета пустым, если у
// процесса уже была заготовка предмета (иначе ПроверитьЗаполнение не
// пропускает старт процесса). Заполняем имена в предметах и в
// ПредметыЗадач перед записью/стартом.
Функция ЗаполнитьИменаПредметовПроцесса(Процесс, Предмет)
	ИмяПредмета = МультипредметностьВызовСервера.ПолучитьСсылкуНаИмяПредметаПоСсылкеНаПредмет(Предмет);
	Изменено = Ложь;
	Для Каждого Строка Из Процесс.Предметы Цикл
		Если Строка.Предмет = Предмет И Не ЗначениеЗаполнено(Строка.ИмяПредмета) Тогда
			Строка.ИмяПредмета = ИмяПредмета;
			Изменено = Истина;
		КонецЕсли;
		Если Строка.Предмет = Предмет И Не ЗначениеЗаполнено(Строка.РольПредмета) Тогда
			Строка.РольПредмета = Перечисления.РолиПредметов.Основной;
			Изменено = Истина;
		КонецЕсли;
	КонецЦикла;
	Для Каждого Строка Из Процесс.ПредметыЗадач Цикл
		Если Не ЗначениеЗаполнено(Строка.ИмяПредмета) Тогда
			Строка.ИмяПредмета = ИмяПредмета;
			Изменено = Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Изменено;
КонецФункции

// Штатная связь "приказ -> документ-результат". Тип связи и настройка
// создаются идемпотентно: СвязиДокументов.СоздатьСвязь не работает без
// записи в РегистрСведений.НастройкаСвязей для пары видов документов.
Функция ОбеспечитьСвязьИсполненияПриказа() Экспорт
	ТипСвязиОбъект = НайтиИлиСоздатьЭлемент(Справочники.ТипыСвязей, "Исполнение приказа");
	Если Не ЗначениеЗаполнено(ТипСвязиОбъект.Ссылка) Тогда
		ТипСвязиОбъект.Записать();
	КонецЕсли;
	ТипОбратнойСвязиОбъект = НайтиИлиСоздатьЭлемент(Справочники.ТипыСвязей, "Основание приказа");
	Если Не ЗначениеЗаполнено(ТипОбратнойСвязиОбъект.Ссылка) Тогда
		ТипОбратнойСвязиОбъект.Записать();
	КонецЕсли;
	СвязиДокументов.СоздатьНастройкуСвязи(
		ТипСвязиОбъект.Ссылка,
		Справочники.ВидыВнутреннихДокументов.ПустаяСсылка(),
		Справочники.ВидыВнутреннихДокументов.ПустаяСсылка(),
		Перечисления.ХарактерСвязей.Множественная,
		ТипОбратнойСвязиОбъект.Ссылка,
		Перечисления.ХарактерСвязей.Множественная,
		Истина);
	Настройка = Новый Структура;
	Настройка.Вставить("ТипСвязи", ТипСвязиОбъект.Ссылка);
	Настройка.Вставить("ТипОбратнойСвязи", ТипОбратнойСвязиОбъект.Ссылка);
	Возврат Настройка;
КонецФункции

// Создаёт штатную связь "основание -> документ" (приказ -> результат).
// Ошибка связи не отменяет уже созданный документ; она пишется в журнал,
// а критерий завершения приказа в симуляторе останется невыполненным.
Функция СоздатьСвязьДокументаСОснованием(Документ, Основание) Экспорт
	Если Не ЗначениеЗаполнено(Документ) Или Не ЗначениеЗаполнено(Основание)
		Или Документ = Основание Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТипЗнч(Документ) <> Тип("СправочникСсылка.ВнутренниеДокументы")
		Или ТипЗнч(Основание) <> Тип("СправочникСсылка.ВнутренниеДокументы") Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Настройка = ОбеспечитьСвязьИсполненияПриказа();
		СвязиДокументов.СоздатьСвязь(Основание, Документ, Настройка.ТипСвязи);
		Возврат Истина;
	Исключение
		Текст = "Не удалось связать документ " + Строка(Документ) + " с основанием "
			+ Строка(Основание) + ": " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("АИС.ОбщегоНазначения", УровеньЖурналаРегистрации.Ошибка,,, Текст);
		Возврат Ложь;
	КонецПопытки;
КонецФункции

// Возвращает массив структур связанных документов-результатов для приказа.
Функция ПолучитьСвязиДокумента(Документ) Экспорт
	Связи = Новый Массив;
	Если Не ЗначениеЗаполнено(Документ) Тогда
		Возврат Связи;
	КонецЕсли;
	ТипСвязи = Справочники.ТипыСвязей.НайтиПоНаименованию("Исполнение приказа", Истина);
	Если Не ЗначениеЗаполнено(ТипСвязи) Тогда
		Возврат Связи;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.УстановитьПараметр("ТипСвязи", ТипСвязи);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Связи.СвязанныйДокумент КАК СвязанныйДокумент,
	|	Связи.Комментарий КАК Комментарий,
	|	Связи.Установил КАК Установил,
	|	Связи.ДатаУстановки КАК ДатаУстановки
	|ИЗ
	|	РегистрСведений.СвязиДокументов КАК Связи
	|ГДЕ
	|	Связи.Документ = &Документ
	|	И Связи.ТипСвязи = &ТипСвязи";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ТипЗнч(Выборка.СвязанныйДокумент) <> Тип("СправочникСсылка.ВнутренниеДокументы") Тогда
			Продолжить;
		КонецЕсли;
		Связь = Новый Структура;
		Связь.Вставить("УникальныйИдентификатор", Строка(Выборка.СвязанныйДокумент.УникальныйИдентификатор()));
		Связь.Вставить("Заголовок", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выборка.СвязанныйДокумент, "Заголовок"));
		Связь.Вставить("Вид", Строка(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выборка.СвязанныйДокумент, "ВидДокумента")));
		Связь.Вставить("Автор", Строка(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выборка.СвязанныйДокумент, "Подготовил")));
		Связь.Вставить("Дата", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выборка.СвязанныйДокумент, "ДатаСоздания"));
		Связь.Вставить("Комментарий", Выборка.Комментарий);
		Связь.Вставить("Установил", Строка(Выборка.Установил));
		Связь.Вставить("ДатаУстановки", Выборка.ДатаУстановки);
		Связи.Добавить(Связь);
	КонецЦикла;
	Возврат Связи;
КонецФункции

// Статус обработки приказа: задачи, у которых предмет = приказ, и связанные
// документы-результаты. Используется симулятором вместо поиска по тексту.
Функция ПолучитьСтатусПриказа(Документ) Экспорт
	Если Не ЗначениеЗаполнено(Документ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Объект = Документ.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	ДокументОписание = Новый Структура;
	ДокументОписание.Вставить("УникальныйИдентификатор", Строка(Документ.УникальныйИдентификатор()));
	ДокументОписание.Вставить("Заголовок", Объект.Заголовок);
	ДокументОписание.Вставить("Вид", Строка(Объект.ВидДокумента));
	ДокументОписание.Вставить("Автор", Строка(Объект.Подготовил));

	ЗадачиПриказа = Новый Массив;
	ЗадачаВыполнена = Ложь;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Документ", Документ);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Задачи.Ссылка КАК Ссылка,
	|	Задачи.Наименование КАК Наименование,
	|	Задачи.Выполнена КАК Выполнена,
	|	Задачи.ДатаНачала КАК ДатаНачала,
	|	Задачи.РезультатВыполнения КАК РезультатВыполнения,
	|	Задачи.Исполнитель КАК Исполнитель
	|ИЗ
	|	Задача.ЗадачаИсполнителя КАК Задачи
	|ГДЕ
	|	Задачи.Ссылка В
	|		(ВЫБРАТЬ
	|			ПредметыЗадачи.Ссылка КАК Ссылка
	|		ИЗ
	|			Задача.ЗадачаИсполнителя.Предметы КАК ПредметыЗадачи
	|		ГДЕ
	|			ПредметыЗадачи.Предмет = &Документ)
	|УПОРЯДОЧИТЬ ПО
	|	Задачи.ДатаНачала";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Задача = Новый Структура;
		Задача.Вставить("УникальныйИдентификатор", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Задача.Вставить("Наименование", Выборка.Наименование);
		Задача.Вставить("Выполнена", Выборка.Выполнена);
		Задача.Вставить("ДатаНачала", Выборка.ДатаНачала);
		Задача.Вставить("РезультатВыполнения", Выборка.РезультатВыполнения);
		Задача.Вставить("Исполнитель", Строка(Выборка.Исполнитель));
		ЗадачиПриказа.Добавить(Задача);
		Если Выборка.Выполнена Тогда
			ЗадачаВыполнена = Истина;
		КонецЕсли;
	КонецЦикла;

	Статус = Новый Структура;
	Статус.Вставить("Документ", ДокументОписание);
	Статус.Вставить("Задачи", ЗадачиПриказа);
	Статус.Вставить("ЗадачаВыполнена", ЗадачаВыполнена);
	Статус.Вставить("Связи", ПолучитьСвязиДокумента(Документ));
	Возврат Статус;
КонецФункции

// Поиск шаблонов Справочник.ШаблоныВнутреннихДокументов по виду документа
// и/или ключевому слову в Наименовании/Заголовке. Общая логика для
// HTTPService (GET /templates, ручной поиск по запросу) и для
// автоматического поиска при создании адресной задачи (см.
// СохранитьКандидатовШаблонов) - сервер ищет сам, решение использовать
// найденное или нет остаётся за исполнителем задачи.
Функция НайтиШаблоныВнутреннихДокументов(ВидДокумента = Неопределено, КлючевоеСлово = Неопределено) Экспорт
	Текст =
	"ВЫБРАТЬ
	|	Шаблоны.Ссылка КАК Ссылка,
	|	Шаблоны.Наименование КАК Наименование,
	|	Шаблоны.Заголовок КАК Заголовок,
	|	Шаблоны.КомментарийКШаблону КАК КомментарийКШаблону
	|ИЗ
	|	Справочник.ШаблоныВнутреннихДокументов КАК Шаблоны
	|ГДЕ
	|	НЕ Шаблоны.ПометкаУдаления
	|	И НЕ Шаблоны.ЭтоГруппа
	|	И Шаблоны.Статус = ""Утверждён""";

	Запрос = Новый Запрос;
	Если ЗначениеЗаполнено(ВидДокумента) Тогда
		Запрос.УстановитьПараметр("ВидДокумента", ВидДокумента);
		Текст = Текст + "
		|	И Шаблоны.ВидДокумента = &ВидДокумента";
	КонецЕсли;
	Если Не ПустаяСтрока(КлючевоеСлово) Тогда
		Запрос.УстановитьПараметр("КлючевоеСлово", "%" + КлючевоеСлово + "%");
		Текст = Текст + "
		|	И (Шаблоны.Наименование ПОДОБНО &КлючевоеСлово
		|	ИЛИ Шаблоны.Заголовок ПОДОБНО &КлючевоеСлово)";
	КонецЕсли;
	Запрос.Текст = Текст;

	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();

	Кандидаты = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Кандидат = Новый Структура;
		Кандидат.Вставить("УникальныйИдентификатор", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Кандидат.Вставить("Наименование", Выборка.Наименование);
		Кандидат.Вставить("Заголовок", Выборка.Заголовок);
		Кандидат.Вставить("КомментарийКШаблону", Выборка.КомментарийКШаблону);
		Кандидаты.Добавить(Кандидат);
	КонецЦикла;
	Возврат Кандидаты;
КонецФункции

// Сохраняет контекст реагирования на триггер в АИС_КонтекстЗадачИИ,
// привязав к базовой задаче: классификацию (ТипТриггера/ТипДействия) и
// результат автоматического поиска шаблонов (НайтиШаблоныВнутреннихДокументов,
// Кандидаты). Исполнитель (ДЛ/его симулятор) читает всё это вместе с
// задачей и сам решает, использовать ли один из найденных шаблонов. Пустой
// массив кандидатов тоже сохраняется явно (а не пропускается) - "шаблон не
// найден" для исполнителя равнозначно "решил не использовать шаблон", и
// это тоже результат поиска, а не его отсутствие.
// ТипТриггера/ТипДействия - Неопределено, если классификация неприменима
// (например, старые вызовы без триггера).
Процедура СохранитьКонтекстЗадачи(Задача, ТипТриггера, ТипДействия, Кандидаты) Экспорт
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписьJSON.ЗаписатьНачалоМассива();
	Для Каждого Кандидат Из Кандидаты Цикл
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписьJSON.ЗаписатьИмяСвойства("УникальныйИдентификатор");
		ЗаписьJSON.ЗаписатьЗначение(Кандидат.УникальныйИдентификатор);
		ЗаписьJSON.ЗаписатьИмяСвойства("Наименование");
		ЗаписьJSON.ЗаписатьЗначение(Кандидат.Наименование);
		ЗаписьJSON.ЗаписатьИмяСвойства("Заголовок");
		ЗаписьJSON.ЗаписатьЗначение(Кандидат.Заголовок);
		ЗаписьJSON.ЗаписатьИмяСвойства("КомментарийКШаблону");
		ЗаписьJSON.ЗаписатьЗначение(Кандидат.КомментарийКШаблону);
		ЗаписьJSON.ЗаписатьКонецОбъекта();
	КонецЦикла;
	ЗаписьJSON.ЗаписатьКонецМассива();

	Набор = РегистрыСведений.АИС_КонтекстЗадачИИ.СоздатьНаборЗаписей();
	Набор.Отбор.Задача.Установить(Задача);
	Запись = Набор.Добавить();
	Запись.Задача = Задача;
	Запись.Период = ТекущаяДатаСеанса();
	Запись.ТипТриггера = ТипТриггера;
	Запись.ТипДействия = ТипДействия;
	Запись.КандидатыШаблонов = ЗаписьJSON.Закрыть();
	Набор.Записать();
КонецПроцедуры

// Читает кандидатов шаблонов, сохранённых СохранитьКандидатовШаблонов для
// данной задачи. Пустой массив, если автопоиск не выполнялся (например,
// для задач, не связанных с документом) или ничего не нашёл.
Функция ПолучитьКандидатовШаблонов(Задача) Экспорт
	Набор = РегистрыСведений.АИС_КонтекстЗадачИИ.СоздатьНаборЗаписей();
	Набор.Отбор.Задача.Установить(Задача);
	Набор.Прочитать();
	Если Набор.Количество() = 0 Или ПустаяСтрока(Набор[0].КандидатыШаблонов) Тогда
		Возврат Новый Массив;
	КонецЕсли;

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(Набор[0].КандидатыШаблонов);
	Значение = ПрочитатьJSON(ЧтениеJSON, Ложь);
	ЧтениеJSON.Закрыть();
	Возврат Значение;
КонецФункции

// Находит непосредственного начальника сотрудника через штатный
// РегистрСведений.ПодчиненностьСотрудников базовой конфигурации (не
// адаптирован в расширение - чтение напрямую через BSL работает без
// адаптации, она нужна только для подписок на события). Неопределено, если
// начальника в системе нет (например, генеральный директор).
Функция НайтиРуководителя(Сотрудник) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Подчиненный", Сотрудник);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Подчиненность.Руководитель КАК Руководитель
	|ИЗ
	|	РегистрСведений.ПодчиненностьСотрудников КАК Подчиненность
	|ГДЕ
	|	Подчиненность.Подчиненный = &Подчиненный";
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Руководитель;
КонецФункции

// Устанавливает (идемпотентно, заменяя прежнюю запись) непосредственного
// начальника сотрудника в РегистрСведений.ПодчиненностьСотрудников.
// Руководитель = Неопределено - снимает привязку (сотрудник без начальника
// в системе), не создавая запись.
Процедура УстановитьРуководителя(Сотрудник, Руководитель) Экспорт
	// Пишем одну запись через менеджер записи. Набор записей с частичным
	// отбором на этом независимом регистре с несколькими измерениями
	// заменял весь регистр, поэтому используем точечную запись.
	Если Не ЗначениеЗаполнено(Руководитель) Тогда
		Возврат;
	КонецЕсли;

	Запись = РегистрыСведений.ПодчиненностьСотрудников.СоздатьМенеджерЗаписи();
	Запись.Подчиненный = Сотрудник;
	Запись.Руководитель = Руководитель;
	Запись.Записать();
КонецПроцедуры

// Находит действующую должностную инструкцию (Справочник.ВнутренниеДокументы,
// ВидДокумента.Наименование = "Должностная инструкция", АИС_Должность =
// Должность) - документ, который должен существовать для каждой должности
// и из которого исполнитель/его симулятор узнаёт свои обязанности.
// Неопределено, если не найдена. Эскалация происходит не на уровне
// произвольного исполнителя задачи, а конкретно при найме: HR, обрабатывая
// заявку на найм, запрашивает текст обязанностей у подавшего заявку - см.
// АИС_Уведомления.ОбработатьЗаявкуНаНайм (решение зафиксировано
// 2026-10-26, после отклонения первой - универсальной - реализации).
Функция НайтиДолжностнуюИнструкцию(Должность) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Должность", Должность);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Документы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВнутренниеДокументы КАК Документы
	|ГДЕ
	|	Документы.ВидДокумента.Наименование = ""Должностная инструкция""
	|	И Документы.АИС_Должность = &Должность
	|	И НЕ Документы.ПометкаУдаления";
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Ссылка;
КонецФункции

// Идемпотентно находит или создаёт элемент Справочник.АИС_ТипыТриггеров,
// записывает (если ещё не было) и возвращает ссылку.
Функция НайтиИлиСоздатьТипТриггера(Наименование) Экспорт
	Объект = НайтиИлиСоздатьЭлемент(Справочники.АИС_ТипыТриггеров, Наименование);
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.Записать();
	КонецЕсли;
	Возврат Объект.Ссылка;
КонецФункции

// Идемпотентно находит или создаёт элемент Справочник.АИС_ТипыДействий с
// заданным ТипОбъекта (какой справочник шаблонов использовать для действий
// этого типа - см. docs/data-model.md §3). Если элемент уже существует,
// ТипОбъекта на нём не перезаписывается (считается заданным один раз при
// заведении типа действия).
Функция НайтиИлиСоздатьТипДействия(Наименование, ТипОбъекта) Экспорт
	Объект = НайтиИлиСоздатьЭлемент(Справочники.АИС_ТипыДействий, Наименование);
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Объект.ТипОбъекта = ТипОбъекта;
		Объект.Записать();
	КонецЕсли;
	Возврат Объект.Ссылка;
КонецФункции

// Вызывает LLM (OpenAI-совместимый chat completions API) напрямую из BSL -
// для ИИ-операций, которые должны выполняться НА СТОРОНЕ расширения
// (например, формирование шаблона документа - см. АИС_Уведомления), а не
// во внешнем симуляторе. Ключ/модель - Константа.АИС_КлючИИ/АИС_МодельИИ
// (те же значения DEEPSEEK_API_KEY/DEEPSEEK_MODEL из .env, что используют
// агенты симулятора - общий ключ на все ИИ-вызовы проекта). Провайдер
// сейчас DeepSeek (api.deepseek.com) - не вынесен в константу, т.к. смена
// провайдера потребует править и структуру запроса/ответа, не только
// адрес. Исходящий HTTPS из-под Safe Mode расширения работает (проверено
// эмпирически).
//
// Возвращает текст ответа модели (choices[0].message.content). Бросает
// исключение при сетевой ошибке, ошибке API или пустом ключе - вызывающая
// сторона уже оборачивает свои операции в Попытка/Исключение.
Функция ВызватьИИ(СистемныйПромпт, ПользовательскийПромпт, Модель = Неопределено, Температура = Неопределено, МаксимумТокенов = Неопределено) Экспорт
	Ключ = Константы.АИС_КлючИИ.Получить();
	Если ПустаяСтрока(Ключ) Тогда
		ВызватьИсключение "Не задан Константа.АИС_КлючИИ";
	КонецЕсли;

	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписьJSON.ЗаписатьНачалоОбъекта();
	Если Не ЗначениеЗаполнено(Модель) Тогда
		Модель = Константы.АИС_МодельИИ.Получить();
	КонецЕсли;
	Если ПустаяСтрока(Модель) Тогда
		Модель = "deepseek-chat";
	КонецЕсли;

	ЗаписьJSON.ЗаписатьИмяСвойства("model");
	ЗаписьJSON.ЗаписатьЗначение(Модель);
	Если Температура <> Неопределено Тогда
		ЗаписьJSON.ЗаписатьИмяСвойства("temperature");
		ЗаписьJSON.ЗаписатьЗначение(Температура);
	КонецЕсли;
	Если МаксимумТокенов <> Неопределено Тогда
		ЗаписьJSON.ЗаписатьИмяСвойства("max_tokens");
		ЗаписьJSON.ЗаписатьЗначение(МаксимумТокенов);
	КонецЕсли;
	ЗаписьJSON.ЗаписатьИмяСвойства("messages");
	ЗаписьJSON.ЗаписатьНачалоМассива();
	ЗаписьJSON.ЗаписатьНачалоОбъекта();
	ЗаписьJSON.ЗаписатьИмяСвойства("role");
	ЗаписьJSON.ЗаписатьЗначение("system");
	ЗаписьJSON.ЗаписатьИмяСвойства("content");
	ЗаписьJSON.ЗаписатьЗначение(СистемныйПромпт);
	ЗаписьJSON.ЗаписатьКонецОбъекта();
	ЗаписьJSON.ЗаписатьНачалоОбъекта();
	ЗаписьJSON.ЗаписатьИмяСвойства("role");
	ЗаписьJSON.ЗаписатьЗначение("user");
	ЗаписьJSON.ЗаписатьИмяСвойства("content");
	ЗаписьJSON.ЗаписатьЗначение(ПользовательскийПромпт);
	ЗаписьJSON.ЗаписатьКонецОбъекта();
	ЗаписьJSON.ЗаписатьКонецМассива();
	ЗаписьJSON.ЗаписатьКонецОбъекта();
	ТелоЗапроса = ЗаписьJSON.Закрыть();

	Соединение = Новый HTTPСоединение("api.deepseek.com", 443, , , , 60, Новый ЗащищенноеСоединениеOpenSSL);
	HTTPЗапрос = Новый HTTPЗапрос("/v1/chat/completions");
	HTTPЗапрос.Заголовки.Вставить("Authorization", "Bearer " + Ключ);
	HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json");
	HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса);

	HTTPОтвет = Соединение.ОтправитьДляОбработки(HTTPЗапрос);
	ТелоОтвета = HTTPОтвет.ПолучитьТелоКакСтроку();
	Если HTTPОтвет.КодСостояния <> 200 Тогда
		ВызватьИсключение "ИИ API вернул " + Строка(HTTPОтвет.КодСостояния) + ": " + ТелоОтвета;
	КонецЕсли;

	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
	Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
	ЧтениеJSON.Закрыть();

	ПерваяОпция = Данные.choices.Получить(0);
	Возврат ПерваяОпция.message.content;
КонецФункции

// Создаёт черновик шаблона внутреннего документа (Статус="Черновик" - не
// попадает в НайтиШаблоныВнутреннихДокументов, пока не утверждён). Общая
// логика для HTTPService (POST /templates, ручное создание) и для
// автоматического формирования шаблона средствами ИИ (см.
// АИС_Уведомления.ПроверитьНеобходимостьШаблона). Автор - автор исходного
// документа; он утверждает шаблон после технического согласования
// Программистом 1С.
Функция СоздатьЧерновикШаблона(ВидДокумента, Наименование, Заголовок, КомментарийКШаблону, Автор = Неопределено) Экспорт
	Объект = Справочники.ШаблоныВнутреннихДокументов.СоздатьЭлемент();
	Объект.Наименование = Наименование;
	Объект.ВидДокумента = ВидДокумента;
	Объект.Заголовок = Заголовок;
	Объект.КомментарийКШаблону = КомментарийКШаблону;
	Если ЗначениеЗаполнено(Автор) Тогда
		Объект.Автор = Автор;
	КонецЕсли;
	Объект.Статус = "Черновик";
	Объект.Записать();
	Возврат Объект.Ссылка;
КонецФункции

Процедура ОбеспечитьПапкуЗадачи(Предмет, Исполнитель)
	Если ЗначениеЗаполнено(Предмет)
		И АИС_ПапкиДокументов.ЭтоПоддерживаемыйДокумент(Предмет) Тогда
		АИС_ПапкиДокументов.ДобавитьДокументВПапку(
			Предмет,
			Исполнитель,
			Перечисления.АИС_НазначенияПапокДокументов.Полученные,
			Перечисления.АИС_ИсточникиПривязкиДокументов.Автоматически);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
