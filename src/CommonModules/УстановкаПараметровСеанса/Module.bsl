#Область ПрограммныйИнтерфейс

Процедура УстановитьПараметрыСеанса() Экспорт
	ПараметрыСеанса.АИС_ТекущееДЛ = ПараметрыСеанса.ТекущийПользователь;
	ПараметрыСеанса.АИС_GUIDЗадачИсполнителя = АИС_GUIDЗадачТекущегоИсполнителя();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает массив строковых представлений УникальныйИдентификатор для задач,
// у которых исполнителем указано текущее ДЛ (АИС_ТекущееДЛ).
// RLS-условия сравнивают строковый реквизит "Задача" с элементами этого массива,
// так как собственные объекты расширения хранят GUID задачи строкой, а не TaskRef
// (прямая ссылка TaskRef на объект Задача приводила к падению платформы
// при загрузке/редактировании прав расширения).
Функция АИС_GUIDЗадачТекущегоИсполнителя()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Задачи.Ссылка КАК Ссылка
	|ИЗ
	|	Задача.ЗадачаИсполнителя КАК Задачи
	|ГДЕ
	|	Задачи.Исполнитель = &ТекущееДЛ";
	Запрос.УстановитьПараметр("ТекущееДЛ", ПараметрыСеанса.АИС_ТекущееДЛ);

	ИдентификаторыЗадач = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ИдентификаторыЗадач.Добавить(Строка(Выборка.Ссылка.УникальныйИдентификатор()));
	КонецЦикла;

	Возврат ИдентификаторыЗадач;
КонецФункции

#КонецОбласти
