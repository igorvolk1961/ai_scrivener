#Область ПрограммныйИнтерфейс

// Заполняет тексты промптов и их параметры. Не создаёт пользователей,
// должности и демонстрационные данные предприятия - этим занимается
// симулятор. Идемпотентно: записи ищутся по наименованию и обновляются.
Функция Заполнить(АвтоШаблоныАктивны = Ложь) Экспорт
	СоздатьПромпт(
		"ФормированиеШаблонаПоДокументу",
		"Ты - Программист 1С, технический специалист по документообороту "
		+ "предприятия. Твоя задача - обобщить готовый документ в "
		+ "переиспользуемый шаблон: перепиши текст, заменив всё, что "
		+ "меняется от случая к случаю (суммы, ФИО, должности, даты, "
		+ "конкретные формулировки поручений и т.п.), на плейсхолдеры в "
		+ "квадратных скобках с явным указанием, кто/что является "
		+ "источником значения (например, ""[ОКЛАД - определяет Главный "
		+ "бухгалтер]""). Прежде чем выдать результат, самостоятельно "
		+ "проверь его как технический специалист: логичность структуры, "
		+ "полнота плейсхолдеров, корректность формулировок. Выдай только "
		+ "финальный текст шаблона, без пояснений от себя.",
		"Системный промпт автошаблонизации внутреннего документа.",
		"deepseek-chat", 0.2, 2000, АвтоШаблоныАктивны);

	СоздатьПромпт(
		"КлассификацияПроизвольногоСобытия",
		"Определи тип события и требуемое действие.",
		"Заготовка для классификации событий; пока не используется оркестратором.",
		"deepseek-chat", 0.2, 2000);

	СоздатьПромпт(
		"АнализСрываСрока",
		"Проанализируй причины срыва срока и предложи план.",
		"Заготовка для анализа срывов сроков; пока не используется оркестратором.",
		"deepseek-chat", 0.2, 2000);

	Возврат "Промпты заполнены.";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СоздатьПромпт(Имя, Текст, Комментарий, Модель, Температура, МаксимумТокенов, Активность = Истина)
	Промпт = АИС_ОбщегоНазначения.НайтиИлиСоздатьЭлемент(Справочники.АИС_Промпты, Имя);
	Промпт.Текст = Текст;
	Промпт.Комментарий = Комментарий;
	Промпт.Версия = 1;
	Промпт.Активность = Активность;
	Промпт.Записать();

	Параметр = АИС_ОбщегоНазначения.НайтиИлиСоздатьЭлемент(Справочники.АИС_ПромптПараметры, Имя);
	Параметр.Промпт = Промпт.Ссылка;
	Параметр.Модель = Модель;
	Параметр.Температура = Температура;
	Параметр.МаксимумТокенов = МаксимумТокенов;
	Параметр.Версия = 1;
	Параметр.Активность = Активность;
	Параметр.Записать();
КонецПроцедуры

#КонецОбласти
