#Область ПрограммныйИнтерфейс

// Создаёт или обновляет демонстрационные данные; повторный вызов идемпотентен.
// Пишет результат (успех или полный текст ошибки) в Журнал регистрации
// и в файл, чтобы его можно было прочитать без интерактивного доступа к базе.
// Возвращаемое значение:
//  Строка - результат заполнения или текст ошибки.
Функция Заполнить() Экспорт
	// Заполнение демоданных — служебная (не пользовательская) операция:
	// создание бизнес-пользователей/физлиц в 1С:ДО требует привилегированного
	// режима, так как запись их полей защищена группами доступа к персональным
	// данным, которые не настроены в демо-базе (нет назначенного профиля
	// доступа у администратора). УстановитьПривилегированныйРежим здесь не
	// снимает принудительный безопасный режим расширения — это отдельное,
	// persistent-свойство присоединения расширения к ИБ
	// (РасширениеКонфигурации.БезопасныйРежим), не BSL-фрейм
	// УстановитьБезопасныйРежим. Пытаемся снять его программно ниже, чтобы не
	// щёлкать чекбокс в Конфигураторе после каждой переустановки базы.
	УстановитьПривилегированныйРежим(Истина);
	ОтключитьБезопасныйРежимРасширения();
	Попытка
		Результат = ЗаполнитьВнутри();
		ЗаписатьРезультат(Результат, Ложь);
	Исключение
		Результат = "Ошибка заполнения демоданных: " + ОписаниеОшибки();
		ЗаписатьРезультат(Результат, Истина);
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Результат;
КонецФункции

Процедура ЗаполнитьПоРасписанию() Экспорт
	Заполнить();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Снятие флажка "Безопасный режим" у этого расширения в Конфигураторе — это
// persistent-свойство присоединения расширения к ИБ, доступное программно как
// РасширенияКонфигурации.Получить() -> РасширениеКонфигурации.БезопасныйРежим
// (документировано в синтакс-помощнике, ConfigurationExtension.SafeMode), а не
// BSL-фрейм УстановитьБезопасныйРежим. У этого свойства есть сеттер и метод
// .Записать() — но платформа физически не позволяет вызвать его, пока
// безопасный режим ещё включён (подтверждено на практике, платформа бросает
// "Изменение расширения конфигурации недоступно в безопасном режиме"): иначе
// расширение могло бы само себя разблокировать, что было бы дырой в
// безопасности. Поэтому эта процедура работает только "с той стороны" — когда
// режим уже снят руками в Конфигураторе, снимать нечего, и вызов ниже просто
// не выполняется (Если Расширение.БезопасныйРежим). Флажок всё равно нужно
// снимать руками после каждой переустановки базы.
Процедура ОтключитьБезопасныйРежимРасширения()
	Попытка
		Для Каждого Расширение Из РасширенияКонфигурации.Получить() Цикл
			Если Расширение.Имя = "ai_scrivener" И Расширение.БезопасныйРежим Тогда
				Расширение.БезопасныйРежим = Ложь;
				Расширение.Записать();
				ЗаписьЖурналаРегистрации("АИС.БезопасныйРежим", УровеньЖурналаРегистрации.Информация,,,
					"Безопасный режим расширения ai_scrivener снят программно.");
			КонецЕсли;
		КонецЦикла;
	Исключение
		ЗаписьЖурналаРегистрации("АИС.БезопасныйРежим", УровеньЖурналаРегистрации.Предупреждение,,,
			"Не удалось снять безопасный режим программно: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

Процедура ЗаписатьРезультат(Текст, ЭтоОшибка)
	Уровень = ?(ЭтоОшибка, УровеньЖурналаРегистрации.Ошибка, УровеньЖурналаРегистрации.Информация);
	ЗаписьЖурналаРегистрации("АИС.ЗаполнениеДемоДанных", Уровень,,, Текст);

	Попытка
		Запись = Новый ЗаписьТекста("/tmp/kilo/b4-result.txt", КодировкаТекста.UTF8);
		Запись.Записать(Текст);
		Запись.Закрыть();
	Исключение
		// Путь для результата недоступен — запись в Журнал регистрации выше уже
		// сохранила основной результат; фиксируем и саму причину сбоя записи файла.
		ЗаписьЖурналаРегистрации("АИС.ЗаполнениеДемоДанных", УровеньЖурналаРегистрации.Предупреждение,,,
			"Не удалось записать результат в файл: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

Функция ЗаполнитьВнутри()
	Должности = СоздатьДолжности();
	ДемоПользователи = СоздатьПользователей(Должности);
	СоздатьДелегирование(ДемоПользователи);
	ВидыДокументов = СоздатьВидыДокументов(ДемоПользователи["ДЛ1"]);
	Типы = СоздатьТипы(ДемоПользователи["ДЛ1"]);
	СоздатьШаблоны(ДемоПользователи["ДЛ1"], ВидыДокументов);
	СоздатьОбязанности(ДемоПользователи["ДЛ1"], Должности, ВидыДокументов, Типы);
	СоздатьПромпты(ДемоПользователи["ДЛ1"]);
	СоздатьДемоЗадачи(ДемоПользователи, Типы);
	Возврат "Демоданные заполнены.";
КонецФункции

Функция СоздатьДолжности()
	Должности = Новый Соответствие;
	Для Каждого Имя Из СписокДолжностей() Цикл
		Должности.Вставить(Имя, НайтиИлиСоздатьЭлемент(Справочники.Должности, Имя));
	КонецЦикла;
	Возврат Должности;
КонецФункции

Функция СписокДолжностей()
	Должности = Новый Массив;
	Должности.Добавить("Специалист");
	Должности.Добавить("Ведущий специалист");
	Должности.Добавить("Руководитель отдела");
	Возврат Должности;
КонецФункции

Функция СоздатьПользователей(Должности)
	ДемоПользователи = Новый Соответствие;
	ДемоПользователи.Вставить("ДЛ1", СоздатьПользователя("ДЛ1", "Иванов Иван Иванович", Должности["Специалист"], Метаданные.Роли.АИС_ДолжностноеЛицо));
	ДемоПользователи.Вставить("ДЛ2", СоздатьПользователя("ДЛ2", "Петров Петр Петрович", Должности["Ведущий специалист"], Метаданные.Роли.АИС_ДолжностноеЛицо));
	ДемоПользователи.Вставить("Руководитель", СоздатьПользователя("Руководитель", "Сидоров Сидор Сидорович", Должности["Руководитель отдела"], Метаданные.Роли.АИС_ВышестоящееДолжностноеЛицо));
	ДемоПользователи.Вставить("Аудитор", СоздатьПользователя("Аудитор", "Аудитор Аудитор Аудиторович", Должности["Специалист"], Метаданные.Роли.АИС_Аудитор));
	// Админ и БезРоли — не для сценариев заполнения, а для негативных тестов
	// доступа B5 (tests/1c/test_access.md): проверяют, что администратор не
	// видит содержимое задач, а пользователь без роли расширения не получает
	// доступ к объектам АИС_*. Роль расширения для БезРоли не задаётся (Неопределено).
	ДемоПользователи.Вставить("Админ", СоздатьПользователя("Админ", "Админов Админ Админович", Должности["Специалист"], Метаданные.Роли.АИС_АдминистраторСистемы));
	ДемоПользователи.Вставить("БезРоли", СоздатьПользователя("БезРоли", "Безролев Без Ролевич", Должности["Специалист"], Неопределено));
	Возврат ДемоПользователи;
КонецФункции

// Справочник.Пользователи в 1С:ДО жёстко связан с реальной учётной записью ИБ:
// ПередЗаписью (ПользователиСлужебный.ПользовательОбъектПередЗаписью) всегда
// запускает синхронизацию с ПользовательИнформационнойБазы, и при создании
// элемента без неё падает на попытке записать защищённое поле. Поэтому
// создаём настоящую учётную запись ИБ и регистрируем её официальным способом
// (ДополнительныеСвойства.ОписаниеПользователяИБ), как это делает сам модуль
// Пользователи (см. Пользователи.СоздатьАдминистратора). Важно: локальная
// переменная в этом модуле НЕ должна называться "Пользователи" — совпадение
// с именем этого общего модуля вызывает платформенную ошибку "Поле объекта
// недоступно для записи (Пользователи)" ещё до вызова ПользователиИБ.Записать()
// (подтверждено контрольным экспериментом: с именем "Пользователи" падает
// раньше точки, где должен появляться диалог "Защита от опасных действий";
// с "ДемоПользователи" доходит до него и успешно создаёт всех пользователей).
// РольРасширения = Неопределено — пользователь без роли расширения (демо
// "БезРоли" для негативного теста B5: доступ к объектам АИС_* должен быть
// запрещён).
Функция СоздатьПользователя(Имя, ФИО, Должность, РольРасширения)
	ФизЛицо = НайтиИлиСоздатьЭлемент(Справочники.ФизическиеЛица, ФИО);
	ФизЛицо.Наименование = ФИО;
	ФизЛицо.Записать();

	Пользователь = Справочники.Пользователи.НайтиПоНаименованию(Имя, Истина);
	Если Не ЗначениеЗаполнено(Пользователь) Тогда
		ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(Имя);
		Если ПользовательИБ = Неопределено Тогда
			ПользовательИБ = ПользователиИнформационнойБазы.СоздатьПользователя();
			ПользовательИБ.Имя = Имя;
			ПользовательИБ.ПолноеИмя = ФИО;
			ПользовательИБ.ПоказыватьВСпискеВыбора = Истина;
			ПользовательИБ.Роли.Добавить(Метаданные.Роли.БазовыеПраваДокументооборот);
			ПользовательИБ.Роли.Добавить(Метаданные.Роли.БазовыеПраваБСП);
			Если РольРасширения <> Неопределено Тогда
				ПользовательИБ.Роли.Добавить(РольРасширения);
			КонецЕсли;
			ПользовательИБ.Записать();
		КонецЕсли;

		Объект = Справочники.Пользователи.СоздатьЭлемент();
		Объект.Наименование = Имя;
		Объект.ФизЛицо = ФизЛицо.Ссылка;

		ОписаниеПользователяИБ = Новый Структура;
		ОписаниеПользователяИБ.Вставить("Действие", "Записать");
		ОписаниеПользователяИБ.Вставить("УникальныйИдентификатор", ПользовательИБ.УникальныйИдентификатор);
		Объект.ДополнительныеСвойства.Вставить("ОписаниеПользователяИБ", ОписаниеПользователяИБ);

		Объект.Записать();
		Пользователь = Объект.Ссылка;
	КонецЕсли;

	Набор = РегистрыСведений.СведенияОПользователяхДокументооборот.СоздатьНаборЗаписей();
	Набор.Отбор.Пользователь.Установить(Пользователь);
	Запись = Набор.Добавить();
	Запись.Период = Дата(1, 1, 1);
	Запись.Пользователь = Пользователь;
	Запись.Должность = Должность.Ссылка;
	Набор.Записать();

	Возврат Пользователь;
КонецФункции

Процедура СоздатьДелегирование(ДемоПользователи)
	Имя = "Делегирование ДЛ1 → ДЛ2";
	Делегирование = Справочники.ДелегированиеПрав.НайтиПоНаименованию(Имя, Истина);
	Если Не ЗначениеЗаполнено(Делегирование) Тогда
		Объект = Справочники.ДелегированиеПрав.СоздатьЭлемент();
		Объект.Наименование = Имя;
		Объект.ОтКого = ДемоПользователи["ДЛ1"];
		Объект.Кому = ДемоПользователи["ДЛ2"];
		Объект.ДатаНачалаДействия = НачалоДня(ТекущаяДата());
		Объект.ДатаОкончанияДействия = КонецДня(ДобавитьМесяц(ТекущаяДата(), 1));
		Объект.Действует = Истина;
		Объект.Комментарий = "Демоданные";
		Объект.Записать();
	КонецЕсли;
КонецПроцедуры

Функция СоздатьВидыДокументов(Автор)
	Виды = Новый Соответствие;
	Виды.Вставить("Входящий", СоздатьВидВходящегоДокумента("Авария", Автор));
	Виды.Вставить("Исходящий", СоздатьВидИсходящегоДокумента("Служебная записка", Автор));
	Возврат Виды;
КонецФункции

Функция СоздатьВидВходящегоДокумента(Имя, Автор)
	Объект = НайтиИлиСоздатьЭлемент(Справочники.ВидыВходящихДокументов, Имя);
	Объект.СпособНумерации = Перечисления.СпособыНумерации.Автоматически;
	Объект.Записать();
	Возврат Объект.Ссылка;
КонецФункции

Функция СоздатьВидИсходящегоДокумента(Имя, Автор)
	Объект = НайтиИлиСоздатьЭлемент(Справочники.ВидыИсходящихДокументов, Имя);
	Объект.СпособНумерации = Перечисления.СпособыНумерации.Автоматически;
	Объект.Записать();
	Возврат Объект.Ссылка;
КонецФункции

Функция СоздатьТипы(Автор)
	Типы = Новый Соответствие;
	Типы.Вставить("Триггер", СоздатьТипТриггера("Входящий документ", Автор));
	Типы.Вставить("Действие", СоздатьТипДействия("Подготовить проект", Автор));
	Возврат Типы;
КонецФункции

Функция СоздатьТипТриггера(Имя, Автор)
	Объект = НайтиИлиСоздатьЭлемент(Справочники.АИС_ТипыТриггеров, Имя);
	Объект.Записать();
	Возврат Объект.Ссылка;
КонецФункции

Функция СоздатьТипДействия(Имя, Автор)
	Объект = НайтиИлиСоздатьЭлемент(Справочники.АИС_ТипыДействий, Имя);
	Объект.ТипОбъекта = ПредопределенноеЗначение("Перечисление.ТипыОбъектов.ИсходящиеДокументы");
	Объект.Записать();
	Возврат Объект.Ссылка;
КонецФункции

Процедура СоздатьШаблоны(Автор, ВидыДокументов)
	СоздатьШаблон(Справочники.ШаблоныИсходящихДокументов, "Шаблон исходящего письма", Автор);
	СоздатьШаблон(Справочники.ШаблоныВходящихДокументов, "Шаблон входящего письма", Автор);
	СоздатьШаблон(Справочники.ШаблоныВнутреннихДокументов, "Шаблон внутренней записки", Автор);
КонецПроцедуры

Процедура СоздатьШаблон(Менеджер, Имя, Автор)
	Объект = НайтиИлиСоздатьЭлемент(Менеджер, Имя);
	Объект.Автор = Автор;
	Если Объект.АИС_Плейсхолдеры.Количество() = 0 Тогда
		Строка = Объект.АИС_Плейсхолдеры.Добавить();
		Строка.Имя = "ФИО";
		Строка.Описание = "ФИО подписанта";
		Строка.Вид = Перечисления.АИС_ВидыПлейсхолдеров.Значение;
		Строка.ТипДанных = "Строка";
		Строка.Обязательность = Истина;
		Строка.СпособЗаполнения = Перечисления.АИС_СпособыЗаполнения.РучнойВвод;
		Строка.Порядок = 1;
		Строка.Маркер = "{{ФИО}}";
		Строка.Статус = "Принят";
	КонецЕсли;
	Объект.Записать();
КонецПроцедуры

Процедура СоздатьОбязанности(Автор, Должности, ВидыДокументов, Типы)
	СоздатьОбязанность("Общая обязанность ДЛ1", Автор, Должности["Специалист"], Типы["Триггер"], Типы["Действие"], Неопределено, Неопределено, 10);
	СоздатьОбязанность("Специфичная обязанность: авария", Автор, Должности["Специалист"], Типы["Триггер"], Типы["Действие"], ВидыДокументов["Входящий"], ВидыДокументов["Исходящий"], 20);
КонецПроцедуры

Процедура СоздатьОбязанность(Имя, Автор, Должность, ТипТриггера, ТипДействия, Характеристика, ТребуемыйВид, Приоритет)
	Объект = НайтиИлиСоздатьЭлемент(Справочники.АИС_ДолжностныеОбязанности, Имя);
	Объект.Должность = Должность.Ссылка;
	Объект.Текст = "Демонстрационная обязанность";
	Объект.ДатаУтверждения = ТекущаяДата();
	Объект.ТипТриггера = ТипТриггера;
	Объект.ТипДействия = ТипДействия;
	Объект.Характеристика = Характеристика;
	Объект.ТребуемыйВидДокумента = ТребуемыйВид;
	Объект.Приоритет = Приоритет;
	Объект.Активность = Истина;
	Объект.Версия = 1;
	Объект.Записать();
КонецПроцедуры

Процедура СоздатьПромпты(Автор)
	СоздатьПромпт("КлассификацияПроизвольногоСобытия", "Определи тип события и требуемое действие.", Автор);
	СоздатьПромпт("АнализСрываСрока", "Проанализируй причины срыва срока и предложи план.", Автор);
КонецПроцедуры

Процедура СоздатьПромпт(Имя, Текст, Автор)
	Шаблон = НайтиИлиСоздатьЭлемент(Справочники.ШаблоныТекстов, Имя);
	Шаблон.Шаблон = Текст;
	Шаблон.Записать();

	Параметр = НайтиИлиСоздатьЭлемент(Справочники.АИС_ПромптПараметры, Имя);
	Параметр.ТекстПромпта = Шаблон.Ссылка;
	Параметр.Модель = "deepseek-chat";
	Параметр.МаксимумТокенов = 2000;
	Параметр.Версия = 1;
	Параметр.Активность = Истина;
	Параметр.Записать();
КонецПроцедуры

// Готовит по одной задаче для ДЛ1 и ДЛ2 (с записями АИС_КонтекстЗадачИИ и
// АИС_СостоянияПлейсхолдеров) — это подготовка для негативных тестов доступа
// B5 (tests/1c/test_access.md, сценарий A1: ДЛ1 не видит задачу ДЛ2), а не
// часть самого сценария ИИ-оркестрации (запись обычная, задача не реально
// обрабатывается).
Процедура СоздатьДемоЗадачи(ДемоПользователи, Типы)
	Задача1 = НайтиИлиСоздатьЗадачу(ДемоПользователи["ДЛ1"], "Демо-задача ДЛ1");
	ЗаполнитьКонтекстЗадачи(Задача1, Типы);
	Задача2 = НайтиИлиСоздатьЗадачу(ДемоПользователи["ДЛ2"], "Демо-задача ДЛ2");
	ЗаполнитьКонтекстЗадачи(Задача2, Типы);
КонецПроцедуры

// Задача — всегда Задача.ЗадачаИсполнителя (docs/data-model.md §5); отдельного
// справочника-обёртки нет. В 1С:ДО такие задачи не создаются напрямую —
// только как результат старта бизнес-процесса. Для одноразовой, никому не
// адресованной задачи используется штатный процесс БизнесПроцессы.Исполнение
// без привязки к документу (по образцу
// BusinessProcesses.Рассмотрение.ObjectModule.СформироватьИсполнениеОбработка
// в базовой конфигурации): СоздатьБизнесПроцесс() -> заполнить -> Записать() ->
// Старт(); платформенный метод .Старт() порождает ЗадачаИсполнителя на
// исполнителя из ТЧ "Исполнители".
Функция НайтиИлиСоздатьЗадачу(Исполнитель, Наименование)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Исполнитель", Исполнитель);
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗадачаИсполнителя.Ссылка КАК Ссылка
	|ИЗ
	|	Задача.ЗадачаИсполнителя КАК ЗадачаИсполнителя
	|ГДЕ
	|	ЗадачаИсполнителя.Исполнитель = &Исполнитель
	|	И ЗадачаИсполнителя.Наименование = &Наименование";
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	КонецЕсли;

	// .СоздатьБизнесПроцесс() не вызывает приватную (не экспортную)
	// ОбработкаЗаполнения базовой конфигурации — она срабатывает только при
	// интерактивном создании через форму. Поэтому обязательные поля (включая
	// платформенный системный атрибут "Дата", который не может быть пустой
	// датой у объекта вида "бизнес-процесс") заполняем сами.
	Процесс = БизнесПроцессы.Исполнение.СоздатьБизнесПроцесс();
	Процесс.Дата = ТекущаяДатаСеанса();
	Процесс.Автор = Исполнитель;
	Процесс.Важность = Перечисления.ВариантыВажностиЗадачи.Обычная;
	Процесс.ВариантИсполнения = Перечисления.ВариантыМаршрутизацииЗадач.Параллельно;
	Процесс.Наименование = Наименование;
	Процесс.Описание = "Демонстрационная задача.";
	Строка = Процесс.Исполнители.Добавить();
	Строка.Исполнитель = Исполнитель;
	Строка.НаименованиеЗадачи = Наименование;
	Процесс.Записать();
	Процесс.Старт();

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("БизнесПроцесс", Процесс.Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЗадачаИсполнителя.Ссылка КАК Ссылка
	|ИЗ
	|	Задача.ЗадачаИсполнителя КАК ЗадачаИсполнителя
	|ГДЕ
	|	ЗадачаИсполнителя.БизнесПроцесс = &БизнесПроцесс";
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Ссылка;
КонецФункции

Процедура ЗаполнитьКонтекстЗадачи(Задача, Типы)
	НаборКонтекста = РегистрыСведений.АИС_КонтекстЗадачИИ.СоздатьНаборЗаписей();
	НаборКонтекста.Отбор.Задача.Установить(Задача);
	ЗаписьКонтекста = НаборКонтекста.Добавить();
	ЗаписьКонтекста.Задача = Задача;
	ЗаписьКонтекста.ТипТриггера = Типы["Триггер"];
	ЗаписьКонтекста.ТипДействия = Типы["Действие"];
	ЗаписьКонтекста.СостояниеИИ = Перечисления.АИС_СостоянияЗадач.Инициация;
	ЗаписьКонтекста.Версия = 1;
	НаборКонтекста.Записать();

	НаборПлейсхолдера = РегистрыСведений.АИС_СостоянияПлейсхолдеров.СоздатьНаборЗаписей();
	НаборПлейсхолдера.Отбор.Задача.Установить(Задача);
	НаборПлейсхолдера.Отбор.ИмяПлейсхолдера.Установить("ФИО");
	ЗаписьПлейсхолдера = НаборПлейсхолдера.Добавить();
	ЗаписьПлейсхолдера.Задача = Задача;
	ЗаписьПлейсхолдера.ИмяПлейсхолдера = "ФИО";
	ЗаписьПлейсхолдера.ВидПлейсхолдера = Перечисления.АИС_ВидыПлейсхолдеров.Значение;
	ЗаписьПлейсхолдера.Источник = Перечисления.АИС_СпособыЗаполнения.РучнойВвод;
	ЗаписьПлейсхолдера.Состояние = Перечисления.АИС_СтатусыПлейсхолдеров.Заполнен;
	ЗаписьПлейсхолдера.Значение = "Демо-значение";
	НаборПлейсхолдера.Записать();
КонецПроцедуры

Функция НайтиИлиСоздатьЭлемент(Менеджер, Наименование)
	Ссылка = Менеджер.НайтиПоНаименованию(Наименование, Истина);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ссылка.ПолучитьОбъект();
	КонецЕсли;
	Объект = Менеджер.СоздатьЭлемент();
	Объект.Наименование = Наименование;
	Возврат Объект;
КонецФункции

#КонецОбласти
