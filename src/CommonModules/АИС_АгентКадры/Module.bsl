#Область ПрограммныйИнтерфейс

Функция СписокСотрудников(Аргументы) Экспорт
	Фильтр = НРег(СтрокаАргумента(Аргументы, "query"));
	Предел = Предел(Аргументы, 100, 200);
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Пользователи.Наименование КАК Логин,
		|	Пользователи.Недействителен КАК Недействителен,
		|	Сведения.Должность.Наименование КАК Должность,
		|	Сведения.Подразделение.Наименование КАК Подразделение,
		|	Подчиненность.Руководитель.Наименование КАК Руководитель
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияОПользователяхДокументооборот КАК Сведения
		|		ПО Сведения.Пользователь = Пользователи.Ссылка
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПодчиненностьСотрудников КАК Подчиненность
		|		ПО Подчиненность.Подчиненный = Пользователи.Ссылка
		|ГДЕ
		|	Пользователи.ПометкаУдаления = ЛОЖЬ
		|	И НЕ Пользователи.ЭтоГруппа
		|УПОРЯДОЧИТЬ ПО
		|	Логин";
	Выборка = Запрос.Выполнить().Выбрать();
	Сотрудники = Новый Массив;
	Пока Выборка.Следующий() И Сотрудники.Количество() < Предел Цикл
		Логин = СокрЛП(Строка(Выборка.Логин));
		Должность = ?(ЗначениеЗаполнено(Выборка.Должность), СокрЛП(Строка(Выборка.Должность)), "");
		Подразделение = ?(ЗначениеЗаполнено(Выборка.Подразделение), СокрЛП(Строка(Выборка.Подразделение)), "");
		Руководитель = ?(ЗначениеЗаполнено(Выборка.Руководитель), СокрЛП(Строка(Выборка.Руководитель)), "");
		Если Не ПустаяСтрока(Фильтр)
			И СтрНайти(НРег(Логин + " " + Должность + " " + Подразделение + " " + Руководитель), Фильтр) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Сотрудники.Добавить(Новый Структура(
			"login,name,position,department,manager,active",
			Логин,
			Логин,
			Должность,
			Подразделение,
			Руководитель,
			Не Выборка.Недействителен));
	КонецЦикла;
	Возврат Новый Структура("Сотрудники", Сотрудники);
КонецФункции

Функция ПринятьСотрудника(Аргументы) Экспорт
	Попытка
		Логин = СтрокаАргумента(Аргументы, "login");
		ФИО = СтрокаАргумента(Аргументы, "name");
		ДолжностьИмя = СтрокаАргумента(Аргументы, "position");
		Если ПустаяСтрока(Логин) ИЛИ ПустаяСтрока(ФИО) ИЛИ ПустаяСтрока(ДолжностьИмя) Тогда
			Возврат ОшибкаАргументов("Для найма нужны login, name и position.");
		КонецЕсли;
		ИменаРолей = ЗначениеАргумента(Аргументы, "roles");
		Если ТипЗнч(ИменаРолей) <> Тип("Массив") Тогда
			ИменаРолей = Новый Массив;
		КонецЕсли;
		РуководительЛогин = СтрокаАргумента(Аргументы, "manager");
		РазрешитьБез = ЗначениеАргумента(Аргументы, "allow_without_manager") = Истина;
		Должность = АИС_ОбщегоНазначения.НайтиИлиСоздатьЭлемент(Справочники.Должности, ДолжностьИмя);
		Должность.Записать();
		Роли = АИС_Сотрудники.РолиПоИменам(ИменаРолей);
		Руководитель = Неопределено;
		Если Не ПустаяСтрока(РуководительЛогин) Тогда
			Руководитель = Справочники.Пользователи.НайтиПоНаименованию(РуководительЛогин, Истина);
		КонецЕсли;
		Сотрудник = АИС_Сотрудники.СоздатьСотрудника(
			Логин, ФИО, Должность, Роли, Неопределено, Руководитель, РазрешитьБез);
		Возврат Новый Структура(
			"Статус,Логин,УникальныйИдентификатор,РуководительНайден",
			"создан",
			Логин,
			Строка(Сотрудник.УникальныйИдентификатор()),
			ЗначениеЗаполнено(Руководитель));
	Исключение
		Возврат ОшибкаАргументов(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

Функция СоздатьПодразделение(Аргументы) Экспорт
	Попытка
		Наименование = СтрокаАргумента(Аргументы, "name");
		РуководительЛогин = СтрокаАргумента(Аргументы, "manager");
		Если ПустаяСтрока(Наименование) ИЛИ ПустаяСтрока(РуководительЛогин) Тогда
			Возврат ОшибкаАргументов("Для подразделения нужны name и manager.");
		КонецЕсли;
		Руководитель = Справочники.Пользователи.НайтиПоНаименованию(РуководительЛогин, Истина);
		Если Не ЗначениеЗаполнено(Руководитель) Тогда
			Возврат ОшибкаАргументов("Руководитель не найден: " + РуководительЛогин);
		КонецЕсли;
		Объект = АИС_ОбщегоНазначения.НайтиИлиСоздатьЭлемент(
			Справочники.СтруктураПредприятия, Наименование);
		Объект.Наименование = Наименование;
		Объект.Руководитель = Руководитель;
		РодительИмя = СтрокаАргумента(Аргументы, "parent");
		Если Наименование = "Предприятие" Тогда
			Объект.Родитель = Справочники.СтруктураПредприятия.ПустаяСсылка();
		Иначе
			Если ПустаяСтрока(РодительИмя) ИЛИ РодительИмя = "Дирекция" Тогда
				РодительИмя = "Предприятие";
			КонецЕсли;
			Корень = АИС_ОбщегоНазначения.НайтиИлиСоздатьЭлемент(
				Справочники.СтруктураПредприятия, "Предприятие");
			Если Не ЗначениеЗаполнено(Корень.Руководитель) Тогда
				Собственник = Справочники.Пользователи.НайтиПоНаименованию("Собственник", Истина);
				Если ЗначениеЗаполнено(Собственник) Тогда
					Корень.Руководитель = Собственник;
				КонецЕсли;
			КонецЕсли;
			Корень.Записать();
			Родитель = Справочники.СтруктураПредприятия.НайтиПоНаименованию(РодительИмя, Истина);
			Если Не ЗначениеЗаполнено(Родитель) Тогда
				Возврат ОшибкаАргументов("Родитель не найден: " + РодительИмя);
			КонецЕсли;
			Объект.Родитель = Родитель;
		КонецЕсли;
		Объект.Записать();

		ПользовательОбъект = Руководитель.ПолучитьОбъект();
		ПользовательОбъект.Подразделение = Объект.Ссылка;
		ПользовательОбъект.Записать();

		Запись = РегистрыСведений.СведенияОПользователяхДокументооборот.СоздатьМенеджерЗаписи();
		Запись.Период = Дата(1, 1, 1);
		Запись.Пользователь = Руководитель;
		Запись.Прочитать();
		Запись.Подразделение = Объект.Ссылка;
		Запись.Записать();

		АИС_ОбщегоНазначения.СинхронизироватьПодчиненностьПоДолжностям();
		АИС_ОбщегоНазначения.НазначитьПодразделенияПоДолжностям();

		Возврат Новый Структура(
			"Статус,Наименование,Руководитель,УникальныйИдентификатор",
			"ok",
			Наименование,
			Строка(Руководитель),
			Строка(Объект.Ссылка.УникальныйИдентификатор()));
	Исключение
		Возврат ОшибкаАргументов(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

Функция РешениеБухгалтера(Аргументы) Экспорт
	Попытка
		ЗаявкаИд = СтрокаАргумента(Аргументы, "request_id");
		Решение = СтрокаАргумента(Аргументы, "decision");
		Если ПустаяСтрока(ЗаявкаИд) ИЛИ (Решение <> "Согласовать" И Решение <> "Отклонить") Тогда
			Возврат ОшибкаАргументов("Нужны request_id и decision = Согласовать|Отклонить.");
		КонецЕсли;
		Ссылка = Справочники.ВнутренниеДокументы.ПолучитьСсылку(
			Новый УникальныйИдентификатор(ЗаявкаИд));
		Объект = Ссылка.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			Возврат ОшибкаАргументов("Заявка не найдена: " + ЗаявкаИд);
		КонецЕсли;
		ОбновленныйТекст = СтрокаАргумента(Аргументы, "updated_text");
		Если Не ПустаяСтрока(ОбновленныйТекст) Тогда
			Объект.Содержание = ОбновленныйТекст;
		КонецЕсли;
		Комментарий = СтрокаАргумента(Аргументы, "comment");
		Объект.АИС_СтатусСогласованияБухгалтера = ?(Решение = "Согласовать", "Согласовано", "Отклонено");
		Объект.Записать();
		Если ЗначениеЗаполнено(Объект.Подготовил) Тогда
			Если Решение = "Согласовать" Тогда
				Наименование = "Зарплатная вилка согласована: " + Объект.Заголовок;
				Описание = "Главный бухгалтер согласовал заявку на найм """ + Объект.Заголовок + """.";
			Иначе
				Наименование = "Заявка на найм отклонена: " + Объект.Заголовок;
				Описание = "Главный бухгалтер отклонил заявку на найм """ + Объект.Заголовок + """."
					+ ?(ПустаяСтрока(Комментарий), "", Символы.ПС + "Комментарий: " + Комментарий);
			КонецЕсли;
			АИС_ОбщегоНазначения.НайтиИлиСоздатьЗадачу(Объект.Подготовил, Наименование, Описание);
		КонецЕсли;
		Возврат Новый Структура("Статус", Объект.АИС_СтатусСогласованияБухгалтера);
	Исключение
		Возврат ОшибкаАргументов(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

Функция ПредложитьПромпт(Аргументы) Экспорт
	Попытка
		Логин = СтрокаАргумента(Аргументы, "login");
		Если ПустаяСтрока(Логин) Тогда
			Возврат ОшибкаАргументов("Нужен login сотрудника.");
		КонецЕсли;
		Сотрудник = Справочники.Пользователи.НайтиПоНаименованию(Логин, Истина);
		Если Не ЗначениеЗаполнено(Сотрудник) Тогда
			Возврат ОшибкаАргументов("Сотрудник не найден: " + Логин);
		КонецЕсли;
		Настройка = АИС_АгентИИ.НайтиПоСотруднику(Сотрудник);
		Если Не ЗначениеЗаполнено(Настройка) Тогда
			Настройка = АИС_АгентИИ.ОбеспечитьНастройкиАгента(Сотрудник);
		КонецЕсли;
		Сформирован = АИС_АгентИИ.СформироватьРольПромпт(Настройка);
		Объект = Настройка.ПолучитьОбъект();
		Возврат Новый Структура(
			"Логин,Сформирован,Статус,Промпт",
			Логин,
			Сформирован,
			Строка(Объект.СтатусПромпта),
			Объект.РольПромпт);
	Исключение
		Возврат ОшибкаАргументов(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

Функция СписокПодразделений(Аргументы) Экспорт	Фильтр = НРег(СтрокаАргумента(Аргументы, "query"));
	Предел = Предел(Аргументы, 100, 200);
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Подразделения.Наименование КАК Наименование,
		|	Подразделения.Родитель.Наименование КАК Родитель,
		|	Подразделения.Руководитель.Наименование КАК Руководитель
		|ИЗ
		|	Справочник.СтруктураПредприятия КАК Подразделения
		|ГДЕ
		|	НЕ Подразделения.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Подразделения.Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	Подразделения = Новый Массив;
	Пока Выборка.Следующий() И Подразделения.Количество() < Предел Цикл
		Наименование = СокрЛП(Строка(Выборка.Наименование));
		Родитель = ?(ЗначениеЗаполнено(Выборка.Родитель), СокрЛП(Строка(Выборка.Родитель)), "");
		Руководитель = ?(ЗначениеЗаполнено(Выборка.Руководитель), СокрЛП(Строка(Выборка.Руководитель)), "");
		Если Не ПустаяСтрока(Фильтр)
			И СтрНайти(НРег(Наименование + " " + Родитель + " " + Руководитель), Фильтр) = 0 Тогда
			Продолжить;
		КонецЕсли;
		Подразделения.Добавить(Новый Структура(
			"name,parent,manager", Наименование, Родитель, Руководитель));
	КонецЦикла;
	Возврат Новый Структура("Подразделения", Подразделения);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОшибкаАргументов(Текст)
	Возврат Новый Структура("КодОшибки,ТекстОшибки", "invalid_arguments", Текст);
КонецФункции

Функция ЗначениеАргумента(Аргументы, Имя)
	Значение = Неопределено;
	Если ТипЗнч(Аргументы) = Тип("Структура") Тогда
		Аргументы.Свойство(Имя, Значение);
	ИначеЕсли ТипЗнч(Аргументы) = Тип("Соответствие") Тогда
		Значение = Аргументы.Получить(Имя);
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция СтрокаАргумента(Аргументы, Имя)
	Значение = ЗначениеАргумента(Аргументы, Имя);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));
КонецФункции

Функция Предел(Аргументы, ПоУмолчанию, Максимум)
	Значение = ЗначениеАргумента(Аргументы, "limit");
	Если ТипЗнч(Значение) = Тип("Число") И Значение > 0 Тогда
		Возврат Мин(Значение, Максимум);
	КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции

#КонецОбласти
