#Область ПрограммныйИнтерфейс

Функция ЗаписатьJSONСтрокой(Значение) Экспорт
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьЗначениеJSONВПоток(ЗаписьJSON, Значение);
	Возврат ЗаписьJSON.Закрыть();
КонецФункции

Функция ПрочитатьJSONИзСтроки(ТелоОтвета) Экспорт
	Если ПустаяСтрока(ТелоОтвета) Тогда
		ВызватьИсключение "Сервис вернул пустой ответ";
	КонецЕсли;
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
	Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
	ЧтениеJSON.Закрыть();
	Возврат Данные;
КонецФункции

Функция ЗначениеJSON(Данные, Имя) Экспорт
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Значение = Неопределено;
		Данные.Свойство(Имя, Значение);
		Возврат Значение;
	ИначеЕсли ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Возврат Данные.Получить(Имя);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ВыполнитьЗапрос(Адрес, Токен, Таймаут, Повторы, Метод, Путь, ТелоЗапроса = Неопределено, ТребуетсяТокен = Истина, ИмяСервиса = "Сервис") Экспорт
	Адрес = СокрЛП(Адрес);
	Если ПустаяСтрока(Адрес) Тогда
		ВызватьИсключение "Не задан адрес " + ИмяСервиса;
	КонецЕсли;
	Токен = СокрЛП(Токен);
	Если ТребуетсяТокен И ПустаяСтрока(Токен) Тогда
		ВызватьИсключение "Не задан токен " + ИмяСервиса;
	КонецЕсли;
	Если Таймаут <= 0 Тогда
		ВызватьИсключение "Не задан таймаут " + ИмяСервиса;
	КонецЕсли;
	Если Повторы < 1 Тогда
		Повторы = 1;
	КонецЕсли;

	Реквизиты = РазобратьАдрес(Адрес, ИмяСервиса);
	Соединение = Новый HTTPСоединение(
		Реквизиты.Хост,
		Реквизиты.Порт,
		,
		,
		,
		Таймаут,
		Реквизиты.ЗащищенноеСоединение);
	ПолныйПуть = Реквизиты.БазовыйПуть + Путь;
	ОшибкаТекста = "";

	Для НомерПопытки = 1 По Повторы Цикл
		ФатальнаяОшибка = "";
		Попытка
			HTTPЗапрос = Новый HTTPЗапрос(ПолныйПуть);
			Если ТелоЗапроса <> Неопределено Тогда
				HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса);
			КонецЕсли;
			HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json");
			Если Не ПустаяСтрока(Токен) Тогда
				HTTPЗапрос.Заголовки.Вставить("X-Service-Token", Токен);
			КонецЕсли;
			HTTPОтвет = Соединение.ВызватьHTTPМетод(ВРег(Метод), HTTPЗапрос);
			Код = HTTPОтвет.КодСостояния;
			ТелоОтвета = HTTPОтвет.ПолучитьТелоКакСтроку();
			КодСтрокой = Строка(Код);
			Если Лев(КодСтрокой, 1) = "2" Тогда
				Возврат ТелоОтвета;
			ИначеЕсли Лев(КодСтрокой, 1) = "4" Тогда
				ФатальнаяОшибка = ИмяСервиса + " вернул " + Код + ": " + ТелоОтвета;
			Иначе
				ОшибкаТекста = ИмяСервиса + " вернул " + Код + ": " + ТелоОтвета;
			КонецЕсли;
		Исключение
			ОшибкаТекста = ОписаниеОшибки();
		КонецПопытки;

		Если Не ПустаяСтрока(ФатальнаяОшибка) Тогда
			ВызватьИсключение ФатальнаяОшибка;
		КонецЕсли;
		Если НомерПопытки = Повторы Тогда
			ВызватьИсключение "Ошибка " + ИмяСервиса + ": " + ОшибкаТекста;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение ИмяСервиса + " недоступен";
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаписатьЗначениеJSONВПоток(ЗаписьJSON, Значение)
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Структура") ИЛИ ТипЗначения = Тип("Соответствие") Тогда
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		Для Каждого Элемент Из Значение Цикл
			ЗаписьJSON.ЗаписатьИмяСвойства(Строка(Элемент.Ключ));
			ЗаписатьЗначениеJSONВПоток(ЗаписьJSON, Элемент.Значение);
		КонецЦикла;
		ЗаписьJSON.ЗаписатьКонецОбъекта();
	ИначеЕсли ТипЗначения = Тип("Массив") Тогда
		ЗаписьJSON.ЗаписатьНачалоМассива();
		Для Каждого Элемент Из Значение Цикл
			ЗаписатьЗначениеJSONВПоток(ЗаписьJSON, Элемент);
		КонецЦикла;
		ЗаписьJSON.ЗаписатьКонецМассива();
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		ЗаписьJSON.ЗаписатьЗначение(Формат(Значение, "ДФ=yyyy-MM-ddTHH:mm:ssZ"));
	ИначеЕсли ТипЗначения = Тип("Булево") ИЛИ ТипЗначения = Тип("Число") ИЛИ ТипЗначения = Тип("Строка") ИЛИ ТипЗначения = Тип("Неопределено") Тогда
		ЗаписьJSON.ЗаписатьЗначение(Значение);
	Иначе
		ЗаписьJSON.ЗаписатьЗначение(Строка(Значение));
	КонецЕсли;
КонецПроцедуры

Функция РазобратьАдрес(Адрес, ИмяСервиса = "Сервис")
	Адрес = СокрЛП(Адрес);
	ЗащищенноеСоединение = Неопределено;
	Низ = НРег(Адрес);
	Если СтрНачинаетсяС(Низ, "https://") Тогда
		Смещение = СтрДлина("https://") + 1;
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
	ИначеЕсли СтрНачинаетсяС(Низ, "http://") Тогда
		Смещение = СтрДлина("http://") + 1;
	Иначе
		ВызватьИсключение "Адрес " + ИмяСервиса + " должен начинаться с http:// или https://";
	КонецЕсли;

	Остаток = Сред(Адрес, Смещение);
	ПозицияСлэша = СтрНайти(Остаток, "/");
	Если ПозицияСлэша > 0 Тогда
		БазовыйПуть = Сред(Остаток, ПозицияСлэша);
		ХостПорт = Лев(Остаток, ПозицияСлэша - 1);
	Иначе
		БазовыйПуть = "";
		ХостПорт = Остаток;
	КонецЕсли;
	Если Прав(БазовыйПуть, 1) = "/" Тогда
		БазовыйПуть = Лев(БазовыйПуть, СтрДлина(БазовыйПуть) - 1);
	КонецЕсли;

	ПозицияДвоеточия = СтрНайти(ХостПорт, ":");
	Если ПозицияДвоеточия = 0 Тогда
		ВызватьИсключение "В адресе " + ИмяСервиса + " явно укажите порт";
	КонецЕсли;
	Хост = Лев(ХостПорт, ПозицияДвоеточия - 1);
	Порт = Число(Сред(ХостПорт, ПозицияДвоеточия + 1));
	Если ПустаяСтрока(Хост) ИЛИ Порт <= 0 Тогда
		ВызватьИсключение "Не удалось разобрать адрес " + ИмяСервиса;
	КонецЕсли;

	Возврат Новый Структура(
		"Хост,Порт,БазовыйПуть,ЗащищенноеСоединение",
		Хост,
		Порт,
		БазовыйПуть,
		ЗащищенноеСоединение);
КонецФункции

#КонецОбласти
