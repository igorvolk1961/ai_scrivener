#Область ПрограммныйИнтерфейс

Функция Поиск(Запрос, Лимит = 5, Локаль = "ru", БезопасныйПоиск = Истина) Экспорт
	Запрос = СокрЛП(Запрос);
	Если ПустаяСтрока(Запрос) Тогда
		ВызватьИсключение "Пустой запрос к search-service";
	КонецЕсли;

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ТелоЗапроса = Новый Структура("query,limit,locale,safe_search", Запрос, Лимит, Локаль, БезопасныйПоиск);
	ТелоОтвета = ВыполнитьЗапрос(
		"POST",
		"/v1/search",
		АИС_КлиентВнешнегоСервиса.ЗаписатьJSONСтрокой(ТелоЗапроса),
		Истина);
	Данные = АИС_КлиентВнешнегоСервиса.ПрочитатьJSONИзСтроки(ТелоОтвета);
	РезультатыJSON = АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Данные, "results");
	Если ТипЗнч(РезультатыJSON) <> Тип("Массив") Тогда
		РезультатыJSON = Новый Массив;
	КонецЕсли;

	Результаты = Новый Массив;
	Для Каждого ЭлементJSON Из РезультатыJSON Цикл
		Результаты.Добавить(Новый Структура(
			"Заголовок,URL,Фрагмент,Источник,Ранг",
			Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(ЭлементJSON, "title")),
			Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(ЭлементJSON, "url")),
			Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(ЭлементJSON, "snippet")),
			Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(ЭлементJSON, "source")),
			АИС_КлиентВнешнегоСервиса.ЗначениеJSON(ЭлементJSON, "rank")));
	КонецЦикла;

	Возврат Новый Структура(
		"Результаты,Провайдер,Длительность",
		Результаты,
		Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Данные, "provider")),
		(ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000);
КонецФункции

Функция ПроверитьДоступность() Экспорт
	Попытка
		ТелоОтвета = ВыполнитьЗапрос("GET", "/health", Неопределено, Ложь);
		Данные = АИС_КлиентВнешнегоСервиса.ПрочитатьJSONИзСтроки(ТелоОтвета);
		Возврат Новый Структура(
			"Доступен,КодСостояния,Ошибка,Провайдер,Версия",
			Истина,
			0,
			"",
			Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Данные, "provider")),
			Строка(АИС_КлиентВнешнегоСервиса.ЗначениеJSON(Данные, "version")));
	Исключение
		Возврат Новый Структура(
			"Доступен,КодСостояния,Ошибка,Провайдер,Версия",
			Ложь,
			0,
			ОписаниеОшибки(),
			"",
			"");
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВыполнитьЗапрос(Метод, Путь, ТелоЗапроса = Неопределено, ТребуетсяТокен = Истина)
	Возврат АИС_КлиентВнешнегоСервиса.ВыполнитьЗапрос(
		Константы.АИС_АдресSearchService.Получить(),
		"",
		Константы.АИС_ТаймаутSearchService.Получить(),
		Константы.АИС_ПовторыSearchService.Получить(),
		Метод,
		Путь,
		ТелоЗапроса,
		Ложь,
		"search-service");
КонецФункции

#КонецОбласти
