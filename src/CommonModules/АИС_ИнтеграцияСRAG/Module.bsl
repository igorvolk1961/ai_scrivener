#Область ПрограммныйИнтерфейс

// Выполняет поиск по базе знаний через RAG-сервис.
//
// Параметры:
//  Запрос      - Строка - текст вопроса.
//  Фильтры     - Структура, Неопределено - фильтры /v1/retrieve.
//  TopK        - Число, Неопределено - число документов в ответе.
//  CandidateK  - Число, Неопределено - число кандидатов до rerank.
//
// Возвращаемое значение:
//  Структура:
//   * Найден - Булево;
//   * Результаты - Массив структур документов;
//   * Диагностика - Структура, Неопределено;
//   * Длительность - Число - секунды.
Функция Поиск(Запрос, Фильтры = Неопределено, TopK = Неопределено, CandidateK = Неопределено, Scope = "knowledge") Экспорт
	Запрос = СокрЛП(Запрос);
	Если ПустаяСтрока(Запрос) Тогда
		ВызватьИсключение "Пустой запрос к базе знаний";
	КонецЕсли;

	Начало = ТекущаяУниверсальнаяДатаВМиллисекундах();
	ТелоОтвета = ВыполнитьЗапрос(
		"POST",
		"/v1/retrieve",
		ТелоПоиска(Запрос, Фильтры, TopK, CandidateK, Scope));
	Результат = РазобратьПоиск(ТелоОтвета);
	Результат.Вставить(
		"Длительность",
		(ТекущаяУниверсальнаяДатаВМиллисекундах() - Начало) / 1000);
	Возврат Результат;
КонецФункции

// Выполняет поиск по документам документооборота с ACL текущего пользователя.
Функция ПоискДокументов(Запрос, Пользователь, Дата = Неопределено, Фильтры = Неопределено) Экспорт
	Если Дата = Неопределено Тогда
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;
	Принципалы = АИС_ПраваДоступа.ПринципалыПользователя(Пользователь, Дата);
	Если Принципалы.Количество() = 0 Тогда
		ВызватьИсключение "Не удалось определить принципалы доступа пользователя";
	КонецЕсли;

	ИтоговыеФильтры = Новый Структура;
	Если Фильтры <> Неопределено Тогда
		Для Каждого КлючИЗначение Из Фильтры Цикл
			ИтоговыеФильтры.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
	КонецЕсли;

	// Ограничения безопасности выставляются после пользовательских фильтров,
	// чтобы их нельзя было переопределить и расширить область поиска.
	ИтоговыеФильтры.Вставить(
		"source_types",
		СтрРазделить("document_internal,document_incoming,document_outgoing", ","));
	ИтоговыеФильтры.Вставить(
		"statuses",
		СтрРазделить("approved,signed,sent,registered,executed", ","));
	ИтоговыеФильтры.Вставить("active", Истина);
	ИтоговыеФильтры.Вставить("is_current", Истина);
	ИтоговыеФильтры.Вставить("acl_principals", Принципалы);
	ИтоговыеФильтры.Вставить("acl_deny_principals", Новый Массив);

	Возврат Поиск(Запрос, ИтоговыеФильтры, , , "documents");
КонецФункции

// Загружает снимок документа в коллекцию документов RAG.
//
// Параметры:
//  Снимок - Структура - поля source_id, family_id, version, title, doc_type,
//           doc_kind, registration_number, document_date, status, approved_at,
//           effective_from, is_current, content_hash, acl_principals,
//           acl_deny_principals, acl_version, metadata.
//  Текст - Строка - текст Содержания.
//  Файл - Структура, Неопределено - ДвоичныеДанные, ИмяФайла, MIME, Хеш.
Функция ЗагрузитьДокумент(Снимок, Текст, Файл = Неопределено) Экспорт
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписьJSON.ЗаписатьНачалоОбъекта();
	ЗаписьJSON.ЗаписатьИмяСвойства("source_type");
	ЗаписьJSON.ЗаписатьЗначение(Снимок.ТипИсточника);
	ЗаписьJSON.ЗаписатьИмяСвойства("document");
	ЗаписатьСнимокJSON(ЗаписьJSON, Снимок);
	Если Не ПустаяСтрока(Текст) Тогда
		ЗаписьJSON.ЗаписатьИмяСвойства("text");
		ЗаписьJSON.ЗаписатьЗначение(Текст);
	КонецЕсли;
	Если Файл <> Неопределено Тогда
		ЗаписьJSON.ЗаписатьИмяСвойства("file_base64");
		ЗаписьJSON.ЗаписатьЗначение(Base64Строка(Файл.ДвоичныеДанные));
		ЗаписьJSON.ЗаписатьИмяСвойства("file_name");
		ЗаписьJSON.ЗаписатьЗначение(Файл.ИмяФайла);
		ЗаписьJSON.ЗаписатьИмяСвойства("mime");
		ЗаписьJSON.ЗаписатьЗначение(Файл.MIME);
	КонецЕсли;
	ЗаписьJSON.ЗаписатьКонецОбъекта();
	ТелоОтвета = ВыполнитьЗапрос("POST", "/v1/index/document/base64", ЗаписьJSON.Закрыть());
	Данные = ПрочитатьJSONИзСтроки(ТелоОтвета);
	Возврат Новый Структура(
		"ИсточникID,Версия,КоличествоЧанков,ТребуетсяOCR,ХешСодержимого",
		Строка(ЗначениеJSON(Данные, "source_id")),
		Строка(ЗначениеJSON(Данные, "version")),
		ЗначениеJSON(Данные, "indexed_chunks"),
		ЗначениеJSON(Данные, "requires_ocr"),
		Строка(ЗначениеJSON(Данные, "content_hash")));
КонецФункции

// Обновляет payload без переэмбеддинга.
Функция ОбновитьМетаданныеИндекса(ТипИсточника, ИсточникID, Версия, Поля) Экспорт
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписьJSON.ЗаписатьНачалоОбъекта();
	ЗаписьJSON.ЗаписатьИмяСвойства("source_type");
	ЗаписьJSON.ЗаписатьЗначение(ТипИсточника);
	ЗаписьJSON.ЗаписатьИмяСвойства("source_id");
	ЗаписьJSON.ЗаписатьЗначение(ИсточникID);
	Если Не ПустаяСтрока(Версия) Тогда
		ЗаписьJSON.ЗаписатьИмяСвойства("version");
		ЗаписьJSON.ЗаписатьЗначение(Версия);
	КонецЕсли;
	ЗаписьJSON.ЗаписатьИмяСвойства("payload");
	ЗаписатьОбъектJSON(ЗаписьJSON, Поля);
	ЗаписьJSON.ЗаписатьКонецОбъекта();
	ТелоОтвета = ВыполнитьЗапрос("POST", "/v1/index/metadata", ЗаписьJSON.Закрыть());
	Данные = ПрочитатьJSONИзСтроки(ТелоОтвета);
	Возврат ЗначениеJSON(Данные, "updated") = Истина;
КонецФункции

// Деактивирует документ, сохраняя точки в индексе для аудита.
Функция ДеактивироватьДокумент(ТипИсточника, ИсточникID, Версия = Неопределено) Экспорт
	Поля = Новый Структура("active,is_current", Ложь, Ложь);
	Возврат ОбновитьМетаданныеИндекса(ТипИсточника, ИсточникID, Версия, Поля);
КонецФункции

// Удаляет документ из коллекции документов RAG.
Функция УдалитьДокумент(ТипИсточника, ИсточникID) Экспорт
	Если ПустаяСтрока(ТипИсточника) ИЛИ ПустаяСтрока(ИсточникID) Тогда
		Возврат Ложь;
	КонецЕсли;
	ТелоОтвета = ВыполнитьЗапрос(
		"DELETE",
		"/v1/index/" + ТипИсточника + "/" + ИсточникID + "?scope=documents");
	Данные = ПрочитатьJSONИзСтроки(ТелоОтвета);
	Возврат ЗначениеJSON(Данные, "deleted") = Истина;
КонецФункции

// Удаляет старые неактивные версии документов из коллекции документов.
Функция ОчиститьУстаревшиеВерсии(СрокХраненияДней = 90) Экспорт
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписьJSON.ЗаписатьНачалоОбъекта();
	ЗаписьJSON.ЗаписатьИмяСвойства("older_than_hours");
	ЗаписьJSON.ЗаписатьЗначение(СрокХраненияДней * 24);
	ЗаписьJSON.ЗаписатьИмяСвойства("scope");
	ЗаписьJSON.ЗаписатьЗначение("documents");
	ЗаписьJSON.ЗаписатьКонецОбъекта();
	ТелоОтвета = ВыполнитьЗапрос(
		"POST",
		"/v1/index/cleanup",
		ЗаписьJSON.Закрыть());
	Данные = ПрочитатьJSONИзСтроки(ТелоОтвета);
	Возврат ЗначениеJSON(Данные, "deleted");
КонецФункции

Функция ТекстДокумента(ИсточникID) Экспорт
	Если ПустаяСтрока(ИсточникID) Тогда
		ВызватьИсключение "Пустой идентификатор источника";
	КонецЕсли;
	ТелоОтвета = ВыполнитьЗапрос(
		"GET",
		"/v1/documents/" + ИсточникID + "/text");
	Данные = ПрочитатьJSONИзСтроки(ТелоОтвета);
	Возврат Новый Структура(
		"Текст,Заголовок,ДокументТип",
		Строка(ЗначениеJSON(Данные, "text")),
		Строка(ЗначениеJSON(Данные, "title")),
		Строка(ЗначениеJSON(Данные, "doc_type")));
КонецФункции

// Возвращает короткоживущую ссылку на PDF-представление документа.
Функция СсылкаНаPDF(ИсточникID) Экспорт
	Если ПустаяСтрока(ИсточникID) Тогда
		ВызватьИсключение "Пустой идентификатор источника";
	КонецЕсли;
	ТелоОтвета = ВыполнитьЗапрос(
		"POST",
		"/v1/documents/" + ИсточникID + "/pdf-link");
	Данные = ПрочитатьJSONИзСтроки(ТелоОтвета);
	Возврат Строка(ЗначениеJSON(Данные, "url"));
КонецФункции

// Проверяет доступность RAG-сервиса и возвращает состояние alias.
Функция ПроверитьДоступность() Экспорт
	Попытка
		ТелоОтвета = ВыполнитьЗапрос("GET", "/health", Неопределено, Ложь);
		Данные = ПрочитатьJSONИзСтроки(ТелоОтвета);
		Возврат Новый Структура(
			"Доступен,КодСостояния,Ошибка,СостояниеКоллекции",
			Истина,
			200,
			"",
			ЗначениеJSON(Данные, "collection_state"));
	Исключение
		Возврат Новый Структура(
			"Доступен,КодСостояния,Ошибка,СостояниеКоллекции",
			Ложь,
			0,
			ОписаниеОшибки(),
			Неопределено);
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТелоПоиска(Запрос, Фильтры, TopK, CandidateK, Scope = "knowledge")
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписьJSON.ЗаписатьНачалоОбъекта();
	ЗаписьJSON.ЗаписатьИмяСвойства("query");
	ЗаписьJSON.ЗаписатьЗначение(Запрос);
	Если Не ПустаяСтрока(Scope) И Scope <> "knowledge" Тогда
		ЗаписьJSON.ЗаписатьИмяСвойства("scope");
		ЗаписьJSON.ЗаписатьЗначение(Scope);
	КонецЕсли;
	Если TopK <> Неопределено Тогда
		ЗаписьJSON.ЗаписатьИмяСвойства("top_k");
		ЗаписьJSON.ЗаписатьЗначение(TopK);
	КонецЕсли;
	Если CandidateK <> Неопределено Тогда
		ЗаписьJSON.ЗаписатьИмяСвойства("candidate_k");
		ЗаписьJSON.ЗаписатьЗначение(CandidateK);
	КонецЕсли;
	Если Фильтры <> Неопределено Тогда
		ЗаписьJSON.ЗаписатьИмяСвойства("filters");
		ЗаписатьОбъектJSON(ЗаписьJSON, Фильтры);
	КонецЕсли;
	ЗаписьJSON.ЗаписатьКонецОбъекта();
	Возврат ЗаписьJSON.Закрыть();
КонецФункции

Процедура ЗаписатьСнимокJSON(ЗаписьJSON, Снимок)
	ЗаписьJSON.ЗаписатьНачалоОбъекта();
	ЗаписатьПолеJSON(ЗаписьJSON, "source_id", Снимок.ИсточникID);
	ЗаписатьПолеJSON(ЗаписьJSON, "family_id", Снимок.Семейство);
	ЗаписатьПолеJSON(ЗаписьJSON, "version", Снимок.ВерсияСодержимого);
	ЗаписатьПолеJSON(ЗаписьJSON, "title", Снимок.Заголовок);
	ЗаписатьПолеJSON(ЗаписьJSON, "doc_type", Снимок.ВидДокумента);
	ЗаписатьПолеJSON(ЗаписьJSON, "doc_kind", Снимок.Вид);
	ЗаписатьПолеJSON(ЗаписьJSON, "registration_number", Снимок.Номер);
	ЗаписатьПолеJSON(ЗаписьJSON, "document_date", Снимок.ДатаДокумента);
	ЗаписатьПолеJSON(ЗаписьJSON, "status", Снимок.Статус);
	ЗаписатьПолеJSON(ЗаписьJSON, "approved_at", Снимок.ДатаУтверждения);
	ЗаписатьПолеJSON(ЗаписьJSON, "effective_from", Снимок.ДатаНачалаДействия);
	ЗаписатьПолеJSON(ЗаписьJSON, "is_current", Снимок.Актуален);
	ЗаписатьПолеJSON(ЗаписьJSON, "content_hash", Снимок.ХешСодержимого);
	ЗаписатьПолеJSON(ЗаписьJSON, "file_hash", Снимок.ХешФайла);
	ЗаписатьПолеJSON(ЗаписьJSON, "acl_principals", Снимок.ACLПринципалы);
	ЗаписатьПолеJSON(ЗаписьJSON, "acl_deny_principals", Снимок.ACLЗапреты);
	ЗаписатьПолеJSON(ЗаписьJSON, "acl_version", Снимок.ХешACL);
	ЗаписьJSON.ЗаписатьИмяСвойства("metadata");
	ЗаписатьОбъектJSON(ЗаписьJSON, Снимок.Метаданные);
	ЗаписьJSON.ЗаписатьКонецОбъекта();
КонецПроцедуры

Процедура ЗаписатьПолеJSON(ЗаписьJSON, Имя, Значение)
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Неопределено") Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗначения = Тип("Строка") И ПустаяСтрока(Значение) Тогда
		Возврат;
	КонецЕсли;
	ЗаписьJSON.ЗаписатьИмяСвойства(Имя);
	Если ТипЗначения = Тип("Массив") Тогда
		ЗаписьJSON.ЗаписатьНачалоМассива();
		Для Каждого Элемент Из Значение Цикл
			Попытка
				ЗаписьJSON.ЗаписатьЗначение(Элемент);
			Исключение
				ЗаписьJSON.ЗаписатьЗначение(Строка(Элемент));
			КонецПопытки;
		КонецЦикла;
		ЗаписьJSON.ЗаписатьКонецМассива();
	ИначеЕсли ТипЗначения = Тип("Структура") ИЛИ ТипЗначения = Тип("Соответствие") Тогда
		ЗаписатьОбъектJSON(ЗаписьJSON, Значение);
	Иначе
		Попытка
			ЗаписьJSON.ЗаписатьЗначение(Значение);
		Исключение
			ЗаписьJSON.ЗаписатьЗначение("");
		КонецПопытки;
	КонецЕсли;
КонецПроцедуры

// Пишет структуру/соответствие верхнего уровня. Значения полей — только
// скаляры или массивы скаляров; вложенные структуры здесь не встречаются.
Процедура ЗаписатьОбъектJSON(ЗаписьJSON, Значение)
	ЗаписьJSON.ЗаписатьНачалоОбъекта();
	Для Каждого Элемент Из Значение Цикл
		ЗаписатьПолеJSON(ЗаписьJSON, Строка(Элемент.Ключ), Элемент.Значение);
	КонецЦикла;
	ЗаписьJSON.ЗаписатьКонецОбъекта();
КонецПроцедуры

Функция ЗначениеJSON(Данные, Имя) Экспорт
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Значение = Неопределено;
		Данные.Свойство(Имя, Значение);
		Возврат Значение;
	ИначеЕсли ТипЗнч(Данные) = Тип("Соответствие") Тогда
		Возврат Данные.Получить(Имя);
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция РазобратьПоиск(ТелоОтвета)
	Данные = ПрочитатьJSONИзСтроки(ТелоОтвета);
	РезультатыJSON = ЗначениеJSON(Данные, "results");
	Если ТипЗнч(РезультатыJSON) <> Тип("Массив") Тогда
		РезультатыJSON = Новый Массив;
	КонецЕсли;

	Результаты = Новый Массив;
	Для Каждого ЭлементJSON Из РезультатыJSON Цикл
		Фрагменты = Новый Массив;
		ЧанкиJSON = ЗначениеJSON(ЭлементJSON, "chunks");
		Если ТипЗнч(ЧанкиJSON) = Тип("Массив") Тогда
			Для Каждого ЧанкJSON Из ЧанкиJSON Цикл
				Фрагменты.Добавить(
					Новый Структура(
						"Текст,Пункт,Раздел,СтраницаНачало,СтраницаКонец,Вид,Родитель,Score,Версия",
						Строка(ЗначениеJSON(ЧанкJSON, "text")),
						Строка(ЗначениеJSON(ЧанкJSON, "clause")),
						ЗначениеJSON(ЧанкJSON, "section_path"),
						ЗначениеJSON(ЧанкJSON, "page_start"),
						ЗначениеJSON(ЧанкJSON, "page_end"),
						Строка(ЗначениеJSON(ЧанкJSON, "kind")),
						ЗначениеJSON(ЧанкJSON, "parent_id"),
						ЗначениеJSON(ЧанкJSON, "score"),
						Строка(ЗначениеJSON(ЧанкJSON, "version"))));
			КонецЦикла;
		КонецЕсли;

		Результаты.Добавить(
			Новый Структура(
				"ИсточникТип,ИсточникID,Заголовок,Score,ScoreType,Метаданные,Фрагменты",
				Строка(ЗначениеJSON(ЭлементJSON, "source_type")),
				Строка(ЗначениеJSON(ЭлементJSON, "source_id")),
				Строка(ЗначениеJSON(ЭлементJSON, "title")),
				ЗначениеJSON(ЭлементJSON, "score"),
				Строка(ЗначениеJSON(ЭлементJSON, "score_type")),
				ЗначениеJSON(ЭлементJSON, "metadata"),
				Фрагменты));
	КонецЦикла;

	Возврат Новый Структура(
		"Найден,Результаты,Диагностика",
		Результаты.Количество() > 0,
		Результаты,
		ЗначениеJSON(Данные, "diagnostics"));
КонецФункции

Функция ПрочитатьJSONИзСтроки(ТелоОтвета)
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
	Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
	ЧтениеJSON.Закрыть();
	Возврат Данные;
КонецФункции

Функция ВыполнитьЗапрос(Метод, Путь, ТелоЗапроса = Неопределено, ТребуетсяТокен = Истина)
	Адрес = СокрЛП(Константы.АИС_АдресRAGСервиса.Получить());
	Если ПустаяСтрока(Адрес) Тогда
		ВызватьИсключение "Не задан Константа.АИС_АдресRAGСервиса";
	КонецЕсли;
	Таймаут = Константы.АИС_ТаймаутRAGСервиса.Получить();
	Если Таймаут <= 0 Тогда
		ВызватьИсключение "Не задан Константа.АИС_ТаймаутRAGСервиса";
	КонецЕсли;
	Повторы = Константы.АИС_ПовторыRAGСервиса.Получить();
	Если Повторы < 1 Тогда
		Повторы = 1;
	КонецЕсли;

	Реквизиты = РазобратьАдрес(Адрес);
	Соединение = Новый HTTPСоединение(
		Реквизиты.Хост,
		Реквизиты.Порт,
		,
		,
		,
		Таймаут,
		Реквизиты.ЗащищенноеСоединение);
	ПолныйПуть = Реквизиты.БазовыйПуть + Путь;
	ОшибкаТекста = "";

	Для НомерПопытки = 1 По Повторы Цикл
		ФатальнаяОшибка = "";
		Попытка
			HTTPЗапрос = Новый HTTPЗапрос(ПолныйПуть);
			Если ТелоЗапроса <> Неопределено Тогда
				HTTPЗапрос.УстановитьТелоИзСтроки(ТелоЗапроса);
			КонецЕсли;
			HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/json");
			HTTPОтвет = Соединение.ВызватьHTTPМетод(ВРег(Метод), HTTPЗапрос);
			Код = HTTPОтвет.КодСостояния;
			ТелоОтвета = HTTPОтвет.ПолучитьТелоКакСтроку();
			Если Код >= 200 И Код < 300 Тогда
				Возврат ТелоОтвета;
			КонецЕсли;
			Если Код >= 400 И Код < 500 Тогда
				ФатальнаяОшибка = "RAG-сервис вернул " + Код + ": " + ТелоОтвета;
			Иначе
				ОшибкаТекста = "RAG-сервис вернул " + Код + ": " + ТелоОтвета;
			КонецЕсли;
		Исключение
			ОшибкаТекста = ОписаниеОшибки();
		КонецПопытки;

		Если Не ПустаяСтрока(ФатальнаяОшибка) Тогда
			ВызватьИсключение ФатальнаяОшибка;
		КонецЕсли;
		Если НомерПопытки = Повторы Тогда
			ВызватьИсключение "Ошибка RAG-сервиса: " + ОшибкаТекста;
		КонецЕсли;
	КонецЦикла;

	ВызватьИсключение "RAG-сервис недоступен";
КонецФункции

Функция РазобратьАдрес(Адрес)
	Адрес = СокрЛП(Адрес);
	ЗащищенноеСоединение = Неопределено;
	Порт = Неопределено;
	Если Найти(НРег(Адрес), "https://") = 1 Тогда
		Адрес = Сред(Адрес, 9);
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
	ИначеЕсли Найти(НРег(Адрес), "http://") = 1 Тогда
		Адрес = Сред(Адрес, 8);
	Иначе
		ВызватьИсключение "Адрес RAG-сервиса должен начинаться с http:// или https://";
	КонецЕсли;

	ПозицияСлэша = Найти(Адрес, "/");
	Если ПозицияСлэша > 0 Тогда
		БазовыйПуть = Сред(Адрес, ПозицияСлэша);
		Адрес = Лев(Адрес, ПозицияСлэша - 1);
	Иначе
		БазовыйПуть = "";
	КонецЕсли;
	Если Прав(БазовыйПуть, 1) = "/" Тогда
		БазовыйПуть = Лев(БазовыйПуть, СтрДлина(БазовыйПуть) - 1);
	КонецЕсли;

	ПозицияДвоеточия = Найти(Адрес, ":");
	Если ПозицияДвоеточия > 0 Тогда
		Хост = Лев(Адрес, ПозицияДвоеточия - 1);
		Порт = Число(Сред(Адрес, ПозицияДвоеточия + 1));
	Иначе
		ВызватьИсключение "В адресе RAG-сервиса явно укажите порт";
	КонецЕсли;
	Если ПустаяСтрока(Хост) Тогда
		ВызватьИсключение "Не удалось определить хост RAG-сервиса";
	КонецЕсли;

	Возврат Новый Структура(
		"Хост,Порт,БазовыйПуть,ЗащищенноеСоединение",
		Хост,
		Порт,
		БазовыйПуть,
		ЗащищенноеСоединение);
КонецФункции

#КонецОбласти
