#Область ПрограммныйИнтерфейс

// Возвращает признак поддерживаемого документа: внутренний, входящий или
// исходящий. Файлы и прочие объекты в регистр не включаются.
Функция ЭтоПоддерживаемыйДокумент(Значение) Экспорт
	Тип = ТипЗнч(Значение);
	Возврат Тип = Тип("СправочникСсылка.ВнутренниеДокументы")
		Или Тип = Тип("СправочникСсылка.ВходящиеДокументы")
		Или Тип = Тип("СправочникСсылка.ИсходящиеДокументы");
КонецФункции

// Создаёт (идемпотентно) корневую папку сотрудника и две подпапки:
// «Полученные на обработку» и «Сформированные». Возвращает структуру ссылок.
Функция ОбеспечитьПапкиСотрудника(Сотрудник) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Корень = НайтиПапку(Сотрудник, Справочники.ПапкиВнутреннихДокументов.ПустаяСсылка(),
		"Документы: " + Строка(Сотрудник));
	Если Не ЗначениеЗаполнено(Корень) Тогда
		Корень = СоздатьПапку(Сотрудник, Справочники.ПапкиВнутреннихДокументов.ПустаяСсылка(),
			"Документы: " + Строка(Сотрудник), "Документы сотрудника " + Строка(Сотрудник));
	КонецЕсли;
	Полученные = НайтиПапку(Сотрудник, Корень, "Полученные на обработку");
	Если Не ЗначениеЗаполнено(Полученные) Тогда
		Полученные = СоздатьПапку(Сотрудник, Корень, "Полученные на обработку",
			"Документы, поступившие сотруднику на обработку");
	КонецЕсли;
	Сформированные = НайтиПапку(Сотрудник, Корень, "Сформированные");
	Если Не ЗначениеЗаполнено(Сформированные) Тогда
		Сформированные = СоздатьПапку(Сотрудник, Корень, "Сформированные",
			"Документы, подготовленные сотрудником");
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("Корень", Корень);
	Результат.Вставить("Полученные", Полученные);
	Результат.Вставить("Сформированные", Сформированные);
	Возврат Результат;
КонецФункции

// Добавляет документ в папку сотрудника. Если папка не указана, выбирается
// стандартная папка по назначению (Полученные/Сформированные). Для
// назначения «Дополнительные» папка обязательна.
Функция ДобавитьДокументВПапку(Документ, Сотрудник, Назначение,
	Источник = Неопределено, Папка = Неопределено, Комментарий = "") Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Если Не ЭтоПоддерживаемыйДокумент(Документ) Или Не ЗначениеЗаполнено(Сотрудник) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если Источник = Неопределено Тогда
		Источник = Перечисления.АИС_ИсточникиПривязкиДокументов.API;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Папка) Тогда
		ПапкиСотрудника = ОбеспечитьПапкиСотрудника(Сотрудник);
		Если ПапкиСотрудника = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		Если Назначение = Перечисления.АИС_НазначенияПапокДокументов.Полученные Тогда
			Папка = ПапкиСотрудника.Полученные;
		ИначеЕсли Назначение = Перечисления.АИС_НазначенияПапокДокументов.Сформированные Тогда
			Папка = ПапкиСотрудника.Сформированные;
		Иначе
			Папка = ПапкиСотрудника.Корень;
		КонецЕсли;
	КонецЕсли;

	МенеджерЗаписи = РегистрыСведений.АИС_ДокументыВПапках.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период = Дата(1, 1, 1);
	МенеджерЗаписи.Документ = Документ;
	МенеджерЗаписи.Папка = Папка;
	МенеджерЗаписи.Сотрудник = Сотрудник;
	МенеджерЗаписи.Назначение = Назначение;
	МенеджерЗаписи.Источник = Источник;
	МенеджерЗаписи.ДатаДобавления = ТекущаяДатаСеанса();
	МенеджерЗаписи.Добавил = ПараметрыСеанса.ТекущийПользователь;
	МенеджерЗаписи.Комментарий = Комментарий;
	МенеджерЗаписи.Записать();
	Возврат Истина;
КонецФункции

// Раскладывает документ по папкам автора и адресата. Вызывается подпиской
// на запись документа; идемпотентно.
Функция РазложитьДокумент(Документ) Экспорт
	Если Не ЭтоПоддерживаемыйДокумент(Документ) Тогда
		Возврат 0;
	КонецЕсли;
	Количество = 0;
	Автор = ЗначениеРеквизитаЕслиЕсть(Документ, "Подготовил");
	Если ТипЗнч(Автор) = Тип("СправочникСсылка.Пользователи") И ЗначениеЗаполнено(Автор) Тогда
		Если ДобавитьДокументВПапку(Документ, Автор,
			Перечисления.АИС_НазначенияПапокДокументов.Сформированные,
			Перечисления.АИС_ИсточникиПривязкиДокументов.Автоматически) Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЕсли;
	Если ТипЗнч(Документ) = Тип("СправочникСсылка.ВнутренниеДокументы")
		Или ТипЗнч(Документ) = Тип("СправочникСсылка.ВходящиеДокументы") Тогда
		Адресат = ЗначениеРеквизитаЕслиЕсть(Документ, "Адресат");
		Если ТипЗнч(Адресат) = Тип("СправочникСсылка.Пользователи") И ЗначениеЗаполнено(Адресат) Тогда
			Если ДобавитьДокументВПапку(Документ, Адресат,
				Перечисления.АИС_НазначенияПапокДокументов.Полученные,
				Перечисления.АИС_ИсточникиПривязкиДокументов.Автоматически) Тогда
				Количество = Количество + 1;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат Количество;
КонецФункции

// Раскладывает предметы задачи в «Полученные» исполнителя. Нужно для задач,
// созданных через API/подписку, где документ может быть входящим/исходящим.
Функция РазложитьПоЗадаче(Задача) Экспорт
	Если Не ЗначениеЗаполнено(Задача) Тогда
		Возврат 0;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Задача", Задача);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПредметыЗадачи.Предмет КАК Предмет
	|ИЗ
	|	Задача.ЗадачаИсполнителя.Предметы КАК ПредметыЗадачи
	|ГДЕ
	|	ПредметыЗадачи.Ссылка = &Задача";
	Выборка = Запрос.Выполнить().Выбрать();
	Исполнитель = ЗначениеРеквизитаЕслиЕсть(Задача, "Исполнитель");
	Если ТипЗнч(Исполнитель) <> Тип("СправочникСсылка.Пользователи") Тогда
		Возврат 0;
	КонецЕсли;
	Количество = 0;
	Пока Выборка.Следующий() Цикл
		Если ЭтоПоддерживаемыйДокумент(Выборка.Предмет) Тогда
			Если ДобавитьДокументВПапку(Выборка.Предмет, Исполнитель,
				Перечисления.АИС_НазначенияПапокДокументов.Полученные,
				Перечисления.АИС_ИсточникиПривязкиДокументов.Автоматически) Тогда
				Количество = Количество + 1;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;
КонецФункции

// Разовый backfill: создаёт папки для всех пользователей, раскладывает
// существующие документы по автору/адресату и задачи по исполнителям.
Функция ЗаполнитьПапкиПоСуществующимДокументам() Экспорт
	УстановитьПривилегированныйРежим(Истина);
	КоличествоПользователей = 0;
	ВыборкаПользователей = Справочники.Пользователи.Выбрать();
	Пока ВыборкаПользователей.Следующий() Цикл
		Если ВыборкаПользователей.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		ОбеспечитьПапкиСотрудника(ВыборкаПользователей.Ссылка);
		КоличествоПользователей = КоличествоПользователей + 1;
	КонецЦикла;

	КоличествоДокументов = 0;
	Для Каждого ИмяСправочника Из СтрРазделить("ВнутренниеДокументы,ВходящиеДокументы,ИсходящиеДокументы", ",") Цикл
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Документы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник." + ИмяСправочника + " КАК Документы
		|ГДЕ
		|	НЕ Документы.ПометкаУдаления";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			РазложитьДокумент(Выборка.Ссылка);
			КоличествоДокументов = КоличествоДокументов + 1;
		КонецЦикла;
	КонецЦикла;

	КоличествоЗадач = 0;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Задачи.Ссылка КАК Ссылка
	|ИЗ
	|	Задача.ЗадачаИсполнителя КАК Задачи
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Задача.ЗадачаИсполнителя.Предметы КАК ПредметыЗадачи
	|		ПО ПредметыЗадачи.Ссылка = Задачи.Ссылка
	|ГДЕ
	|	НЕ Задачи.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		РазложитьПоЗадаче(Выборка.Ссылка);
		КоличествоЗадач = КоличествоЗадач + 1;
	КонецЦикла;

	Результат = Новый Структура;
	Результат.Вставить("Пользователей", КоличествоПользователей);
	Результат.Вставить("Документов", КоличествоДокументов);
	Результат.Вставить("Задач", КоличествоЗадач);
	Возврат Результат;
КонецФункции

// Возвращает плоский список папок сотрудника (с родителем и путём) и
// количеством документов в каждой папке.
Функция ПолучитьПапкиСотрудника(Сотрудник) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = ПолучитьПапкиСотрудникаПривилегированно(Сотрудник);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Результат;
КонецФункции

Функция ПолучитьПапкиСотрудникаПривилегированно(Сотрудник)
	Результат = Новый Массив;
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Папки.Ссылка КАК Ссылка,
	|	Папки.Наименование КАК Наименование,
	|	Папки.Родитель КАК Родитель,
	|	Папки.Описание КАК Описание
	|ИЗ
	|	Справочник.ПапкиВнутреннихДокументов КАК Папки
	|ГДЕ
	|	Папки.Ответственный = &Сотрудник
	|	И НЕ Папки.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Папки.Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Папка = Новый Структура;
		Папка.Вставить("УникальныйИдентификатор", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		Папка.Вставить("Наименование", Выборка.Наименование);
		Папка.Вставить("Описание", Выборка.Описание);
		Папка.Вставить("Родитель", ?(ЗначениеЗаполнено(Выборка.Родитель),
			Строка(Выборка.Родитель.УникальныйИдентификатор()), ""));
		Папка.Вставить("Путь", ПолучитьПутьПапки(Выборка.Ссылка));
		Папка.Вставить("КоличествоДокументов", КоличествоДокументовВПапке(Выборка.Ссылка));
		Результат.Добавить(Папка);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Возвращает документы сотрудника с метаданными, пригодными для RAG-фильтров:
// сотрудник, папка, путь, назначение, источник.
Функция ПолучитьДокументыПоСотруднику(Сотрудник, Назначение = Неопределено,
	Папка = Неопределено, Документ = Неопределено) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = ПолучитьДокументыПоСотрудникуПривилегированно(
			Сотрудник, Назначение, Папка, Документ);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Результат;
КонецФункции

Функция ПолучитьДокументыПоСотрудникуПривилегированно(Сотрудник, Назначение = Неопределено,
	Папка = Неопределено, Документ = Неопределено) Экспорт

	Результат = Новый Массив;
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Текст = "ВЫБРАТЬ
	|	Записи.Документ КАК Документ,
	|	Записи.Папка КАК Папка,
	|	Записи.Сотрудник КАК Сотрудник,
	|	Записи.Назначение КАК Назначение,
	|	Записи.Источник КАК Источник,
	|	Записи.ДатаДобавления КАК ДатаДобавления,
	|	Записи.Комментарий КАК Комментарий
	|ИЗ
	|	РегистрСведений.АИС_ДокументыВПапках КАК Записи
	|ГДЕ
	|	Записи.Сотрудник = &Сотрудник";
	Если ЗначениеЗаполнено(Назначение) Тогда
		Текст = Текст + " И Записи.Назначение = &Назначение";
		Запрос.УстановитьПараметр("Назначение", Назначение);
	КонецЕсли;
	Если ЗначениеЗаполнено(Папка) Тогда
		Текст = Текст + " И Записи.Папка = &Папка";
		Запрос.УстановитьПараметр("Папка", Папка);
	КонецЕсли;
	Если ЗначениеЗаполнено(Документ) Тогда
		Текст = Текст + " И Записи.Документ = &Документ";
		Запрос.УстановитьПараметр("Документ", Документ);
	КонецЕсли;
	Запрос.Текст = Текст;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДокументСсылка = Выборка.Документ;
		Строка = Новый Структура;
		Строка.Вставить("УникальныйИдентификатор", Строка(ДокументСсылка.УникальныйИдентификатор()));
		Строка.Вставить("Тип", ТипДокумента(ДокументСсылка));
		Строка.Вставить("Заголовок", ЗначениеРеквизитаЕслиЕсть(ДокументСсылка, "Заголовок"));
		Строка.Вставить("Вид", Строка(ЗначениеРеквизитаЕслиЕсть(ДокументСсылка, "ВидДокумента")));
		Строка.Вставить("Дата", ЗначениеРеквизитаЕслиЕсть(ДокументСсылка, "ДатаСоздания"));
		Строка.Вставить("Папка", Строка(Выборка.Папка.УникальныйИдентификатор()));
		Строка.Вставить("Путь", ПолучитьПутьПапки(Выборка.Папка));
		Строка.Вставить("Сотрудник", Строка(Выборка.Сотрудник));
		Строка.Вставить("Назначение", Строка(Выборка.Назначение));
		Строка.Вставить("Источник", Строка(Выборка.Источник));
		Строка.Вставить("ДатаДобавления", Выборка.ДатаДобавления);
		Строка.Вставить("Комментарий", Выборка.Комментарий);
		Результат.Добавить(Строка);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Все папки, в которых состоит документ (для метаданных RAG).
Функция ПолучитьПапкиДокумента(Документ, Сотрудник = Неопределено) Экспорт
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Результат = ПолучитьПапкиДокументаПривилегированно(Документ, Сотрудник);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Результат;
КонецФункции

Функция ПолучитьПапкиДокументаПривилегированно(Документ, Сотрудник = Неопределено)
	Результат = Новый Массив;
	Если Не ЭтоПоддерживаемыйДокумент(Документ) Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Документ", Документ);
	Текст = "ВЫБРАТЬ
	|	Записи.Папка КАК Папка,
	|	Записи.Сотрудник КАК Сотрудник,
	|	Записи.Назначение КАК Назначение,
	|	Записи.Источник КАК Источник
	|ИЗ
	|	РегистрСведений.АИС_ДокументыВПапках КАК Записи
	|ГДЕ
	|	Записи.Документ = &Документ";
	Если ЗначениеЗаполнено(Сотрудник) Тогда
		Текст = Текст + " И Записи.Сотрудник = &Сотрудник";
		Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	КонецЕсли;
	Запрос.Текст = Текст;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Новый Структура;
		Строка.Вставить("Папка", Строка(Выборка.Папка.УникальныйИдентификатор()));
		Строка.Вставить("Путь", ПолучитьПутьПапки(Выборка.Папка));
		Строка.Вставить("Сотрудник", Строка(Выборка.Сотрудник));
		Строка.Вставить("Назначение", Строка(Выборка.Назначение));
		Строка.Вставить("Источник", Строка(Выборка.Источник));
		Результат.Добавить(Строка);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Полный путь папки: «Корень / Подпапка / ...».
Функция ПолучитьПутьПапки(Папка) Экспорт
	Если Не ЗначениеЗаполнено(Папка) Тогда
		Возврат "";
	КонецЕсли;
	Части = Новый Массив;
	Текущая = Папка;
	Счетчик = 0;
	Пока ЗначениеЗаполнено(Текущая) И Счетчик < 50 Цикл
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Текущая, "Наименование, Родитель");
		Части.Добавить(Реквизиты.Наименование);
		Текущая = Реквизиты.Родитель;
		Счетчик = Счетчик + 1;
	КонецЦикла;
	Путь = "";
	Индекс = Части.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Если Не ПустаяСтрока(Путь) Тогда
			Путь = Путь + " / ";
		КонецЕсли;
		Путь = Путь + Части[Индекс];
		Индекс = Индекс - 1;
	КонецЦикла;
	Возврат Путь;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Обработчик подписки на запись документа: раскладывает автора и адресата.
Процедура ДокументПриЗаписи(Источник, Отказ) Экспорт
	Если Источник.ОбменДанными.Загрузка Или Источник.ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	РазложитьДокумент(Источник.Ссылка);
КонецПроцедуры

Функция ЗначениеРеквизитаЕслиЕсть(Документ, ИмяРеквизита)
	Если Не ЗначениеЗаполнено(Документ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	МетаданныеОбъекта = Документ.Метаданные();
	Если МетаданныеОбъекта.Реквизиты.Найти(ИмяРеквизита) = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, ИмяРеквизита);
КонецФункции

Функция ТипДокумента(Документ)
	Тип = ТипЗнч(Документ);
	Если Тип = Тип("СправочникСсылка.ВнутренниеДокументы") Тогда
		Возврат "Внутренний";
	ИначеЕсли Тип = Тип("СправочникСсылка.ВходящиеДокументы") Тогда
		Возврат "Входящий";
	ИначеЕсли Тип = Тип("СправочникСсылка.ИсходящиеДокументы") Тогда
		Возврат "Исходящий";
	КонецЕсли;
	Возврат "";
КонецФункции

Функция НайтиПапку(Сотрудник, Родитель, Наименование)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("Родитель", Родитель);
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Папки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПапкиВнутреннихДокументов КАК Папки
	|ГДЕ
	|	Папки.Ответственный = &Сотрудник
	|	И Папки.Родитель = &Родитель
	|	И Папки.Наименование = &Наименование
	|	И НЕ Папки.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция СоздатьПапку(Сотрудник, Родитель, Наименование, Описание)
	Объект = Справочники.ПапкиВнутреннихДокументов.СоздатьЭлемент();
	Объект.Родитель = Родитель;
	Объект.Наименование = Наименование;
	Объект.Описание = Описание;
	Объект.Ответственный = Сотрудник;
	Объект.ДатаСоздания = ТекущаяДатаСеанса();
	Объект.Записать();
	Возврат Объект.Ссылка;
КонецФункции

Функция КоличествоДокументовВПапке(Папка)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Папка", Папка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*) КАК Количество
	|ИЗ
	|	РегистрСведений.АИС_ДокументыВПапках КАК Записи
	|ГДЕ
	|	Записи.Папка = &Папка";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Количество;
	КонецЕсли;
	Возврат 0;
КонецФункции

#КонецОбласти
