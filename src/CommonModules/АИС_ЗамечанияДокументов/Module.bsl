// Реестр замечаний к внутренним документам.
//
// Замечание — отдельная запись справочника АИС_Замечания, а не строка в
// тексте заключения. Это позволяет вернуть документ его владельцу, передать
// конкретному владельцу раздела только нужные пункты и проверять статусы без
// повторного чтения всего документа.

Функция СоздатьЗамечания(Документ, Замечания, Владелец, Автор, Раунд = 1) Экспорт
	Результат = Новый Массив;
	Если Не ЗначениеЗаполнено(Документ) Тогда
		ВызватьИсключение "Не указан документ для замечаний.";
	КонецЕсли;
	Номер = 0;
	Для Каждого Данные Из Замечания Цикл
		Текст = "";
		Данные.Свойство("Текст", Текст);
		Если ПустаяСтрока(Строка(Текст)) Тогда
			Продолжить;
		КонецЕсли;
		Номер = Номер + 1;
		Объект = Справочники.АИС_Замечания.СоздатьЭлемент();
		Объект.Наименование = "Замечание " + Номер;
		Объект.Документ = Документ;
		Раздел = Неопределено;
		Данные.Свойство("Раздел", Раздел);
		Если ТипЗнч(Раздел) = Тип("Строка") Тогда
			Раздел = РазделПоУникальномуИдентификатору(Строка(Раздел));
		КонецЕсли;
		Если ЗначениеЗаполнено(Раздел) Тогда
			Объект.Раздел = Раздел;
		КонецЕсли;
		Пункт = "";
		Данные.Свойство("Пункт", Пункт);
		Объект.Пункт = Строка(Пункт);
		Объект.Текст = Строка(Текст);
		Объект.ВладелецЗамечания = Владелец;
		Объект.Автор = Автор;
		Блокирующее = Истина;
		Данные.Свойство("Блокирующее", Блокирующее);
		Объект.Блокирующее = ?(Блокирующее = Неопределено, Истина, Булево(Блокирующее));
		Объект.Статус = Перечисления.АИС_СтатусыЗамечаний.Открыто;
		Объект.Раунд = Раунд;
		Ключ = "";
		Данные.Свойство("Ключ", Ключ);
		Объект.Ключ = Строка(Ключ);
		Объект.ДатаСоздания = ТекущаяДатаСеанса();
		Объект.ДатаИзменения = Объект.ДатаСоздания;
		Объект.Записать();
		Результат.Добавить(Объект.Ссылка);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция СписокЗамечаний(Документ = Неопределено, Владелец = Неопределено, Статус = Неопределено) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Замечания.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.АИС_Замечания КАК Замечания
	|ГДЕ
	|	НЕ Замечания.ПометкаУдаления";
	Если ЗначениеЗаполнено(Документ) Тогда
		Запрос.Текст = Запрос.Текст + " И Замечания.Документ = &Документ";
		Запрос.УстановитьПараметр("Документ", Документ);
	КонецЕсли;
	Если ЗначениеЗаполнено(Владелец) Тогда
		Запрос.Текст = Запрос.Текст + " И Замечания.ВладелецЗамечания = &Владелец";
		Запрос.УстановитьПараметр("Владелец", Владелец);
	КонецЕсли;
	Если ЗначениеЗаполнено(Статус) Тогда
		Запрос.Текст = Запрос.Текст + " И Замечания.Статус = &Статус";
		Запрос.УстановитьПараметр("Статус", Статус);
	КонецЕсли;
	Запрос.Текст = Запрос.Текст + " УПОРЯДОЧИТЬ ПО Замечания.ДатаСоздания, Замечания.Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	Результат = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(ЗамечаниеВСтруктуру(Выборка.Ссылка));
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ЗамечаниеВСтруктуру(Ссылка) Экспорт
	Объект = Ссылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("Ссылка", Строка(Ссылка.УникальныйИдентификатор()));
	Результат.Вставить("Наименование", Объект.Наименование);
	Результат.Вставить("Документ", Строка(Объект.Документ.УникальныйИдентификатор()));
	Результат.Вставить("ДокументЗаголовок", ?(ЗначениеЗаполнено(Объект.Документ), Объект.Документ.Наименование, ""));
	Результат.Вставить("Раздел", ?(ЗначениеЗаполнено(Объект.Раздел), Строка(Объект.Раздел.УникальныйИдентификатор()), ""));
	Результат.Вставить("РазделЗаголовок", ?(ЗначениеЗаполнено(Объект.Раздел), Объект.Раздел.Заголовок, ""));
	Результат.Вставить("Пункт", Объект.Пункт);
	Результат.Вставить("Текст", Объект.Текст);
	Результат.Вставить("Владелец", ?(ЗначениеЗаполнено(Объект.ВладелецЗамечания), Объект.ВладелецЗамечания.Наименование, ""));
	Результат.Вставить("Автор", ?(ЗначениеЗаполнено(Объект.Автор), Объект.Автор.Наименование, ""));
	Результат.Вставить("Блокирующее", Объект.Блокирующее);
	Результат.Вставить("Статус", Строка(Объект.Статус));
	Результат.Вставить("Раунд", Объект.Раунд);
	Результат.Вставить("Решение", Объект.Решение);
	Результат.Вставить("Задача", ?(ЗначениеЗаполнено(Объект.Задача), Строка(Объект.Задача.УникальныйИдентификатор()), ""));
	Результат.Вставить("ДатаСоздания", Строка(Объект.ДатаСоздания));
	Результат.Вставить("ДатаИзменения", Строка(Объект.ДатаИзменения));
	Возврат Результат;
КонецФункции

Функция ОбновитьЗамечание(Замечание, Статус = Неопределено, Владелец = Неопределено, Решение = Неопределено) Экспорт
	Если Не ЗначениеЗаполнено(Замечание) Тогда
		ВызватьИсключение "Не указано замечание.";
	КонецЕсли;
	Объект = Замечание.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		ВызватьИсключение "Замечание не найдено.";
	КонецЕсли;
	Если Статус <> Неопределено Тогда
		Объект.Статус = Статус;
	КонецЕсли;
	Если Владелец <> Неопределено Тогда
		Объект.ВладелецЗамечания = Владелец;
	КонецЕсли;
	Если Решение <> Неопределено Тогда
		Объект.Решение = Строка(Решение);
	КонецЕсли;
	Объект.ДатаИзменения = ТекущаяДатаСеанса();
	Объект.Записать();
	Возврат ЗамечаниеВСтруктуру(Замечание);
КонецФункции

Функция СводкаПоДокументу(Документ) Экспорт
	Замечания = СписокЗамечаний(Документ);
	Результат = Новый Структура;
	Результат.Вставить("Документ", Строка(Документ.УникальныйИдентификатор()));
	Результат.Вставить("Всего", Замечания.Количество());
	Статусы = Новый Структура("Открыто,ВРаботе,Исправлено,Принято,Отклонено", 0, 0, 0, 0, 0);
	ОткрытыхБлокирующих = 0;
	Для Каждого Замечание Из Замечания Цикл
		ИмяСтатуса = Строка(Замечание.Статус);
		Если Статусы.Свойство(ИмяСтатуса) Тогда
			Статусы[ИмяСтатуса] = Статусы[ИмяСтатуса] + 1;
		КонецЕсли;
		Если Замечание.Блокирующее
			И ИмяСтатуса <> "Принято"
			И ИмяСтатуса <> "Отклонено" Тогда
			ОткрытыхБлокирующих = ОткрытыхБлокирующих + 1;
		КонецЕсли;
	КонецЦикла;
	Результат.Вставить("Открыто", Статусы.Открыто);
	Результат.Вставить("ВРаботе", Статусы.ВРаботе);
	Результат.Вставить("Исправлено", Статусы.Исправлено);
	Результат.Вставить("Принято", Статусы.Принято);
	Результат.Вставить("Отклонено", Статусы.Отклонено);
	Результат.Вставить("ОткрытыхБлокирующих", ОткрытыхБлокирующих);
	Результат.Вставить("Готов", ОткрытыхБлокирующих = 0);
	Возврат Результат;
КонецФункции

Функция РазделПоУникальномуИдентификатору(Ид)
	Если ПустаяСтрока(Ид) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Ссылка = Справочники.АИС_РазделыДокумента.ПолучитьСсылку(
			Новый УникальныйИдентификатор(Ид));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если Ссылка.ПолучитьОбъект() = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Ссылка;
КонецФункции
