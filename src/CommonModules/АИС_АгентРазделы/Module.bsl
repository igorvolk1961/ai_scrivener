#Область ПрограммныйИнтерфейс

Функция Выполнить(Аргументы, Контекст) Экспорт
	Попытка
		Действие = СтрокаАргумента(Аргументы, "action");
		Автор = АвторЗапроса(Аргументы, Контекст);
		Если Действие = "create_document" Тогда
			Возврат СоздатьДокумент(Аргументы, Автор);
		ИначеЕсли Действие = "create_draft" Тогда
			Возврат СоздатьЧерновик(Аргументы, Автор);
		ИначеЕсли Действие = "issue_section_order" Тогда
			Возврат ИздатьРаспоряжение(Аргументы, Автор);
		ИначеЕсли Действие = "list_sections" Тогда
			Возврат СписокРазделов(Аргументы);
		ИначеЕсли Действие = "assign_section" Тогда
			Возврат НазначитьРаздел(Аргументы, Автор);
		ИначеЕсли Действие = "write_section" Тогда
			Возврат ЗаписатьРаздел(Аргументы, Автор);
		ИначеЕсли Действие = "create_subsection" Тогда
			Возврат СоздатьПодраздел(Аргументы, Автор);
		ИначеЕсли Действие = "approve_section" Тогда
			Возврат ПодтвердитьРаздел(Аргументы, Автор);
		ИначеЕсли Действие = "assemble_document" Тогда
			Возврат СобратьДокумент(Аргументы, Автор);
		Иначе
			Возврат ОшибкаАргументов("Неизвестное действие: " + Действие);
		КонецЕсли;
	Исключение
		Возврат ОшибкаАргументов(ОписаниеОшибки());
	КонецПопытки;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьДокумент(Аргументы, Автор)
	Шаблон = ШаблонПоИд(СтрокаАргумента(Аргументы, "template_id"));
	Если Не ЗначениеЗаполнено(Шаблон) Тогда
		Возврат ОшибкаАргументов("Шаблон не найден.");
	КонецЕсли;
	Заголовок = СтрокаАргумента(Аргументы, "title");
	Если ПустаяСтрока(Заголовок) Тогда
		Возврат ОшибкаАргументов("Нужен заголовок документа.");
	КонецЕсли;
	Создано = АИС_РазделыДокументов.СоздатьДокументПоШаблону(Шаблон, Заголовок, Автор);
	Возврат Новый Структура(
		"Документ,Разделы",
		Строка(Создано.Документ.УникальныйИдентификатор()),
		РазделыВСтруктуры(АИС_РазделыДокументов.ПолучитьРазделы(Создано.Документ)));
КонецФункции

Функция СоздатьЧерновик(Аргументы, Автор)
	Заголовок = СтрокаАргумента(Аргументы, "title");
	Если ПустаяСтрока(Заголовок) Тогда
		Возврат ОшибкаАргументов("Нужен заголовок черновика.");
	КонецЕсли;
	Разделы = МассивСтрок(ЗначениеАргумента(Аргументы, "sections"));
	Если Разделы.Количество() = 0 Тогда
		Возврат ОшибкаАргументов("Нужен хотя бы один раздел.");
	КонецЕсли;
	Если Разделы.Количество() > 7 Тогда
		Возврат ОшибкаАргументов(
			"Черновик должен содержать не более 7 укрупнённых разделов верхнего уровня.");
	КонецЕсли;
	Для Каждого ЗаголовокРаздела Из Разделы Цикл
		Если СтрДлина(ЗаголовокРаздела) > 60 ИЛИ СтрНайти(ЗаголовокРаздела, ":") > 0 Тогда
			Возврат ОшибкаАргументов(
				"Заголовок раздела «" + ЗаголовокРаздела + "» слишком подробный.");
		КонецЕсли;
	КонецЦикла;
	Вид = СтрокаАргумента(Аргументы, "kind");
	Если ПустаяСтрока(Вид) Тогда
		Вид = "План";
	КонецЕсли;
	Создано = АИС_РазделыДокументов.СоздатьЧерновикСРазделами(Заголовок, Автор, Разделы, Вид);
	Возврат Новый Структура(
		"Документ,Разделы",
		Строка(Создано.Документ.УникальныйИдентификатор()),
		РазделыВСтруктуры(АИС_РазделыДокументов.ПолучитьРазделы(Создано.Документ)));
КонецФункции

Функция ИздатьРаспоряжение(Аргументы, Автор)
	Раздел = РазделПоИд(СтрокаАргумента(Аргументы, "section_id"));
	Если Не ЗначениеЗаполнено(Раздел) Тогда
		Возврат ОшибкаАргументов("Раздел не найден.");
	КонецЕсли;
	Исполнитель = ПользовательПоЛогину(СтрокаАргумента(Аргументы, "employee"));
	Если Не ЗначениеЗаполнено(Исполнитель) Тогда
		Возврат ОшибкаАргументов("Исполнитель не найден.");
	КонецЕсли;
	Издано = АИС_РазделыДокументов.ИздатьРаспоряжениеПоРазделу(
		Раздел,
		Исполнитель,
		Автор,
		СтрокаАргумента(Аргументы, "order_title"),
		СтрокаАргумента(Аргументы, "instruction"));
	Если Издано = Неопределено Тогда
		Возврат ОшибкаАргументов("Не удалось издать распоряжение по разделу.");
	КонецЕсли;
	Возврат Новый Структура(
		"Раздел,Распоряжение,Задача",
		Строка(Раздел.УникальныйИдентификатор()),
		Строка(Издано.Распоряжение.УникальныйИдентификатор()),
		?(ЗначениеЗаполнено(Издано.Задача),
			Строка(Издано.Задача.УникальныйИдентификатор()), ""));
КонецФункции

Функция СписокРазделов(Аргументы)
	Документ = ДокументПоИд(СтрокаАргумента(Аргументы, "document_id"));
	Если Не ЗначениеЗаполнено(Документ) Тогда
		Возврат ОшибкаАргументов("Документ не найден.");
	КонецЕсли;
	Возврат Новый Структура(
		"Документ,Разделы",
		Строка(Документ.УникальныйИдентификатор()),
		РазделыВСтруктуры(АИС_РазделыДокументов.ПолучитьРазделы(Документ)));
КонецФункции

Функция НазначитьРаздел(Аргументы, Автор)
	Раздел = РазделПоИд(СтрокаАргумента(Аргументы, "section_id"));
	Если Не ЗначениеЗаполнено(Раздел) Тогда
		Возврат ОшибкаАргументов("Раздел не найден.");
	КонецЕсли;
	Исполнитель = ПользовательПоЛогину(СтрокаАргумента(Аргументы, "employee"));
	Если Не ЗначениеЗаполнено(Исполнитель) Тогда
		Возврат ОшибкаАргументов("Исполнитель не найден.");
	КонецЕсли;
	Задача = АИС_РазделыДокументов.НазначитьРаздел(Раздел, Исполнитель, Автор);
	Возврат Новый Структура(
		"Раздел,Задача",
		Строка(Раздел.УникальныйИдентификатор()),
		?(ЗначениеЗаполнено(Задача), Строка(Задача.УникальныйИдентификатор()), ""));
КонецФункции

Функция ЗаписатьРаздел(Аргументы, Автор)
	Раздел = РазделПоИд(СтрокаАргумента(Аргументы, "section_id"));
	Если Не ЗначениеЗаполнено(Раздел) Тогда
		Возврат ОшибкаАргументов("Раздел не найден.");
	КонецЕсли;
	Отправить = ЗначениеАргумента(Аргументы, "submit") = Истина;
	Записано = АИС_РазделыДокументов.ЗаписатьСодержаниеРаздела(
		Раздел, СтрокаАргумента(Аргументы, "content"), Отправить, Автор);
	Возврат Новый Структура(
		"Раздел,Записано",
		Строка(Раздел.УникальныйИдентификатор()),
		Записано);
КонецФункции

Функция СоздатьПодраздел(Аргументы, Автор)
	Родитель = РазделПоИд(СтрокаАргумента(Аргументы, "parent_section_id"));
	Если Не ЗначениеЗаполнено(Родитель) Тогда
		Возврат ОшибкаАргументов("Родительский раздел не найден.");
	КонецЕсли;
	Заголовок = СтрокаАргумента(Аргументы, "title");
	Если ПустаяСтрока(Заголовок) Тогда
		Возврат ОшибкаАргументов("Нужен заголовок подраздела.");
	КонецЕсли;
	Исполнитель = Неопределено;
	Логин = СтрокаАргумента(Аргументы, "employee");
	Если Не ПустаяСтрока(Логин) Тогда
		Исполнитель = ПользовательПоЛогину(Логин);
		Если Не ЗначениеЗаполнено(Исполнитель) Тогда
			Возврат ОшибкаАргументов("Исполнитель не найден: " + Логин);
		КонецЕсли;
	КонецЕсли;
	Подраздел = АИС_РазделыДокументов.СоздатьПодраздел(Родитель, Заголовок, Исполнитель, Автор);
	Если Подраздел = Неопределено Тогда
		Возврат ОшибкаАргументов("Не удалось создать подраздел.");
	КонецЕсли;
	Возврат Новый Структура("Раздел", Строка(Подраздел.УникальныйИдентификатор()));
КонецФункции

Функция ПодтвердитьРаздел(Аргументы, Автор)
	Раздел = РазделПоИд(СтрокаАргумента(Аргументы, "section_id"));
	Если Не ЗначениеЗаполнено(Раздел) Тогда
		Возврат ОшибкаАргументов("Раздел не найден.");
	КонецЕсли;
	Подтверждено = АИС_РазделыДокументов.ПодтвердитьРаздел(Раздел, Автор);
	Возврат Новый Структура(
		"Раздел,Подтверждено",
		Строка(Раздел.УникальныйИдентификатор()),
		Подтверждено);
КонецФункции

Функция СобратьДокумент(Аргументы, Автор)
	Документ = ДокументПоИд(СтрокаАргумента(Аргументы, "document_id"));
	Если Не ЗначениеЗаполнено(Документ) Тогда
		Возврат ОшибкаАргументов("Документ не найден.");
	КонецЕсли;
	Утверждающий = Неопределено;
	Логин = СтрокаАргумента(Аргументы, "approver");
	Если Не ПустаяСтрока(Логин) Тогда
		Утверждающий = ПользовательПоЛогину(Логин);
		Если Не ЗначениеЗаполнено(Утверждающий) Тогда
			Возврат ОшибкаАргументов("Утверждающий не найден: " + Логин);
		КонецЕсли;
	КонецЕсли;
	Текст = АИС_РазделыДокументов.СобратьДокумент(Документ, Утверждающий, Автор);
	Возврат Новый Структура(
		"Документ,Содержание",
		Строка(Документ.УникальныйИдентификатор()),
		?(Текст = Неопределено, "", Текст));
КонецФункции

Функция РазделыВСтруктуры(Разделы)
	Результат = Новый Массив;
	Для Каждого Раздел Из Разделы Цикл
		Строка = Новый Структура;
		Строка.Вставить("Раздел", Строка(Раздел.Ссылка.УникальныйИдентификатор()));
		Строка.Вставить("Родитель",
			?(ЗначениеЗаполнено(Раздел.Родитель),
				Строка(Раздел.Родитель.УникальныйИдентификатор()), ""));
		Строка.Вставить("Заголовок", Раздел.Заголовок);
		Строка.Вставить("Маркер", Раздел.Раздел);
		Строка.Вставить("Порядок", Раздел.Порядок);
		Строка.Вставить("Обязательный", Раздел.Обязательный);
		Строка.Вставить("Содержание", Раздел.Содержание);
		Строка.Вставить("Ответственный", Строка(Раздел.Ответственный));
		Строка.Вставить("Задача",
			?(ЗначениеЗаполнено(Раздел.Задача),
				Строка(Раздел.Задача.УникальныйИдентификатор()), ""));
		Строка.Вставить("Распоряжение",
			?(ЗначениеЗаполнено(Раздел.Распоряжение),
				Строка(Раздел.Распоряжение.УникальныйИдентификатор()), ""));
		Строка.Вставить("Статус", Строка(Раздел.Статус));
		Результат.Добавить(Строка);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция МассивСтрок(Значение)
	Результат = Новый Массив;
	Если ТипЗнч(Значение) <> Тип("Массив") Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого Элемент Из Значение Цикл
		Если ТипЗнч(Элемент) = Тип("Структура") Тогда
			Результат.Добавить(СтрокаАргумента(Элемент, "title"));
		Иначе
			Результат.Добавить(СокрЛП(Строка(Элемент)));
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция АвторЗапроса(Аргументы, Контекст)
	Логин = СтрокаАргумента(Аргументы, "author");
	Если Не ПустаяСтрока(Логин) Тогда
		Пользователь = ПользовательПоЛогину(Логин);
		Если Не ЗначениеЗаполнено(Пользователь) Тогда
			ВызватьИсключение "Автор не найден: " + Логин;
		КонецЕсли;
		Возврат Пользователь;
	КонецЕсли;
	Сотрудник = Неопределено;
	Если ТипЗнч(Контекст) = Тип("Структура") Тогда
		Контекст.Свойство("Сотрудник", Сотрудник);
	КонецЕсли;
	Если ЗначениеЗаполнено(Сотрудник) Тогда
		Возврат Сотрудник;
	КонецЕсли;
	Возврат ПараметрыСеанса.ТекущийПользователь;
КонецФункции

Функция ПользовательПоЛогину(Логин)
	Если ПустаяСтрока(Логин) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Справочники.Пользователи.НайтиПоНаименованию(Логин, Истина);
КонецФункции

Функция ДокументПоИд(Ид)
	Если ПустаяСтрока(Ид) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Ссылка = Справочники.ВнутренниеДокументы.ПолучитьСсылку(Новый УникальныйИдентификатор(Ид));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если Ссылка.ПолучитьОбъект() = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Ссылка;
КонецФункции

Функция РазделПоИд(Ид)
	Если ПустаяСтрока(Ид) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Ссылка = Справочники.АИС_РазделыДокумента.ПолучитьСсылку(
			Новый УникальныйИдентификатор(Ид));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если Ссылка.ПолучитьОбъект() = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Ссылка;
КонецФункции

Функция ШаблонПоИд(Ид)
	Если ПустаяСтрока(Ид) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого ИмяСправочника Из СтрРазделить(
		"ШаблоныВнутреннихДокументов,ШаблоныВходящихДокументов,ШаблоныИсходящихДокументов", ",") Цикл
		Попытка
			Ссылка = Справочники[ИмяСправочника].ПолучитьСсылку(
				Новый УникальныйИдентификатор(Ид));
		Исключение
			Продолжить;
		КонецПопытки;
		Если Ссылка.ПолучитьОбъект() <> Неопределено Тогда
			Возврат Ссылка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция ЗначениеАргумента(Аргументы, Имя)
	Значение = Неопределено;
	Если ТипЗнч(Аргументы) = Тип("Структура") Тогда
		Аргументы.Свойство(Имя, Значение);
	ИначеЕсли ТипЗнч(Аргументы) = Тип("Соответствие") Тогда
		Значение = Аргументы.Получить(Имя);
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция СтрокаАргумента(Аргументы, Имя)
	Значение = ЗначениеАргумента(Аргументы, Имя);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));
КонецФункции

Функция ОшибкаАргументов(Текст)
	Возврат Новый Структура("КодОшибки,ТекстОшибки", "invalid_arguments", Текст);
КонецФункции

#КонецОбласти
