#Область ПрограммныйИнтерфейс

// Регистрирует материал корпуса или обновляет существующий по SHA-256.
// Идемпотентно: повторный вызов с тем же Хеш не создаёт дубль.
//
// Параметры:
//  Данные - Структура - поля Хеш, Наименование, Размер, MIME, Путь,
//           ВидДокумента, Статус, Комментарий.
//
// Возвращаемое значение:
//  СправочникСсылка.АИС_МатериалыЗнаний - запись материала.
Функция ЗарегистрироватьМатериал(Данные) Экспорт
	Хеш = НормализоватьХеш(СвойствоДанных(Данные, "Хеш"));
	Если Не ЭтоХешSHA256(Хеш) Тогда
		ВызватьИсключение("Хеш материала обязан содержать 64 hex-символа.");
	КонецЕсли;

	Наименование = СокрЛП(СвойствоДанных(Данные, "Наименование"));
	Если ПустаяСтрока(Наименование) Тогда
		Наименование = Лев(Хеш, 12);
	КонецЕсли;

	Путь = СокрЛП(СвойствоДанных(Данные, "Путь"));
	Размер = ЧислоИлиНоль(СвойствоДанных(Данные, "Размер", 0));
	Если Не ПустаяСтрока(Путь) Тогда
		Путь = ПроверитьПуть(Путь);
		КореньКорпуса = КаталогКорпуса();
		Пока СтрДлина(КореньКорпуса) > 1
			И (Прав(КореньКорпуса, 1) = "/" Или Прав(КореньКорпуса, 1) = "\") Цикл
			КореньКорпуса = Лев(КореньКорпуса, СтрДлина(КореньКорпуса) - 1);
		КонецЦикла;
		ФайлМатериала = Новый Файл(КореньКорпуса + "/" + Путь);
		Если ФайлМатериала.Существует() И Размер > 0 И ФайлМатериала.Размер <> Размер Тогда
			ВызватьИсключение(
				"Размер файла материала не совпадает с манифестом: "
				+ Строка(ФайлМатериала.Размер) + " <> " + Строка(Размер));
		КонецЕсли;
	КонецЕсли;

	Блокировка = ЗаблокироватьЗапись("Справочник.АИС_МатериалыЗнаний", "Хеш", Хеш);

	Материал = НайтиМатериалПоХешу(Хеш);
	Если Материал = Неопределено Тогда
		Материал = Справочники.АИС_МатериалыЗнаний.СоздатьЭлемент();
		Материал.Хеш = Хеш;
	КонецЕсли;

	Материал.Наименование = Наименование;
	Материал.Размер = Размер;
	Материал.MIME = СокрЛП(СвойствоДанных(Данные, "MIME"));
	Материал.ПутьВХранилище = Путь;
	Материал.ВидДокумента = СокрЛП(СвойствоДанных(Данные, "ВидДокумента"));
	Материал.Статус = СтатусМатериала(СвойствоДанных(Данные, "Статус"));
	Материал.Комментарий = СокрЛП(СвойствоДанных(Данные, "Комментарий"));
	Материал.Записать();

	Возврат Материал.Ссылка;
КонецФункции

// Регистрирует факт загрузки материала сотрудником.
// Идемпотентно по КодЗагрузки = SHA-256(sha256|source_url|employee|task).
//
// Параметры:
//  Данные - Структура - поля Хеш, ИсточникURL, Сотрудник, Должность,
//           Задача, ВидИсточника, АвторОрган, ДатаПубликации,
//           ДатаЗагрузки, Лицензия, Статус, Комментарий.
//
// Возвращаемое значение:
//  СправочникСсылка.АИС_ЗагрузкиМатериалов - запись загрузки.
Функция ЗарегистрироватьЗагрузку(Данные) Экспорт
	Хеш = НормализоватьХеш(СвойствоДанных(Данные, "Хеш"));
	Если Не ЭтоХешSHA256(Хеш) Тогда
		ВызватьИсключение("Хеш загрузки обязан содержать 64 hex-символа.");
	КонецЕсли;

	ИсточникURL = СокрЛП(СвойствоДанных(Данные, "ИсточникURL"));
	ЛогинСотрудника = СокрЛП(СвойствоДанных(Данные, "Сотрудник"));
	Если ПустаяСтрока(ЛогинСотрудника) Тогда
		Сотрудник = ТекущийСотрудник();
		Если Не ЗначениеЗаполнено(Сотрудник) Тогда
			ВызватьИсключение("Не указан сотрудник, а текущий пользователь не определён.");
		КонецЕсли;
		ЛогинСотрудника = Сотрудник.Наименование;
	Иначе
		Сотрудник = СотрудникПоЛогину(ЛогинСотрудника);
		Если Сотрудник = Неопределено Тогда
			ВызватьИсключение("Сотрудник не найден: " + ЛогинСотрудника);
		КонецЕсли;
	КонецЕсли;

	ЗадачаИд = СокрЛП(СвойствоДанных(Данные, "Задача"));
	Задача = ЗадачаПоИдентификатору(ЗадачаИд);
	КодЗагрузки = ХешКлючаЗагрузки(Хеш, ИсточникURL, ЛогинСотрудника, ЗадачаИд);

	Материал = НайтиМатериалПоХешу(Хеш);
	Если Материал = Неопределено Тогда
		ДанныеМатериала = Новый Структура;
		ДанныеМатериала.Вставить("Хеш", Хеш);
		ДанныеМатериала.Вставить("Наименование", СвойствоДанных(Данные, "Наименование"));
		ДанныеМатериала.Вставить("Путь", СвойствоДанных(Данные, "Путь"));
		ДанныеМатериала.Вставить("MIME", СвойствоДанных(Данные, "MIME"));
		ДанныеМатериала.Вставить("Размер", СвойствоДанных(Данные, "Размер", 0));
		ДанныеМатериала.Вставить("ВидДокумента", СвойствоДанных(Данные, "ВидДокумента"));
		ДанныеМатериала.Вставить("Статус", "Проверен");
		ДанныеМатериала.Вставить("Комментарий", "Создан компенсационно при импорте загрузки.");
		ЗарегистрироватьМатериал(ДанныеМатериала);
		Материал = НайтиМатериалПоХешу(Хеш);
	КонецЕсли;

	Блокировка = ЗаблокироватьЗапись(
		"Справочник.АИС_ЗагрузкиМатериалов", "КодЗагрузки", КодЗагрузки);

	Загрузка = НайтиЗагрузкуПоКоду(КодЗагрузки);
	Если Загрузка = Неопределено Тогда
		Загрузка = Справочники.АИС_ЗагрузкиМатериалов.СоздатьЭлемент();
		Загрузка.КодЗагрузки = КодЗагрузки;
	КонецЕсли;

	ДатаЗагрузки = ДатаИзСтроки(СвойствоДанных(Данные, "ДатаЗагрузки"));
	Если Не ЗначениеЗаполнено(ДатаЗагрузки) Тогда
		ДатаЗагрузки = ТекущаяДатаСеанса();
	КонецЕсли;

	Загрузка.Владелец = Материал;
	Загрузка.Наименование = ЛогинСотрудника + " / " + Формат(ДатаЗагрузки, "ДФ=yyyy-MM-dd");
	Загрузка.Сотрудник = Сотрудник;
	Загрузка.Должность = ДолжностьПоНаименованию(СвойствоДанных(Данные, "Должность"));
	Загрузка.Задача = Задача;
	Загрузка.ИсточникURL = ИсточникURL;
	Загрузка.ВидИсточника = СокрЛП(СвойствоДанных(Данные, "ВидИсточника"));
	Загрузка.АвторОрган = СокрЛП(СвойствоДанных(Данные, "АвторОрган"));
	Загрузка.ДатаПубликации = ДатаИзСтроки(СвойствоДанных(Данные, "ДатаПубликации"));
	Загрузка.ДатаЗагрузки = ДатаЗагрузки;
	Загрузка.Лицензия = СокрЛП(СвойствоДанных(Данные, "Лицензия"));
	Загрузка.Статус = СтатусЗагрузки(СвойствоДанных(Данные, "Статус"));
	Загрузка.Комментарий = СокрЛП(СвойствоДанных(Данные, "Комментарий"));
	Загрузка.Записать();

	Возврат Загрузка.Ссылка;
КонецФункции

// Ищет материал по SHA-256.
Функция НайтиМатериалПоХешу(Хеш) Экспорт
	Хеш = НормализоватьХеш(Хеш);
	Если Не ЭтоХешSHA256(Хеш) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Хеш", Хеш);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Материалы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.АИС_МатериалыЗнаний КАК Материалы
	|ГДЕ
	|	Материалы.Хеш = &Хеш";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Ищет факт загрузки по КодЗагрузки.
Функция НайтиЗагрузкуПоКоду(КодЗагрузки) Экспорт
	КодЗагрузки = СокрЛП(КодЗагрузки);
	Если ПустаяСтрока(КодЗагрузки) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("КодЗагрузки", КодЗагрузки);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Загрузки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.АИС_ЗагрузкиМатериалов КАК Загрузки
	|ГДЕ
	|	Загрузки.КодЗагрузки = &КодЗагрузки";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

// Возвращает материалы по фильтру.
//
// Параметры:
//  Хеш - Строка - точный SHA-256 или пустая строка.
//  Статус - Строка - статус или пустая строка.
//
// Возвращаемое значение:
//  Массив - структуры с полями материала.
Функция МатериалыПоФильтру(Хеш = "", Статус = "") Экспорт
	Запрос = Новый Запрос;
	Текст =
	"ВЫБРАТЬ
	|	Материалы.Ссылка КАК Ссылка,
	|	Материалы.Наименование КАК Наименование,
	|	Материалы.Хеш КАК Хеш,
	|	Материалы.Размер КАК Размер,
	|	Материалы.MIME КАК MIME,
	|	Материалы.ПутьВХранилище КАК ПутьВХранилище,
	|	Материалы.ВидДокумента КАК ВидДокумента,
	|	Материалы.Статус КАК Статус,
	|	Материалы.Комментарий КАК Комментарий
	|ИЗ
	|	Справочник.АИС_МатериалыЗнаний КАК Материалы
	|ГДЕ
	|	ИСТИНА";
	Если Не ПустаяСтрока(Хеш) Тогда
		Текст = Текст + "
		|	И Материалы.Хеш = &Хеш";
		Запрос.УстановитьПараметр("Хеш", НормализоватьХеш(Хеш));
	КонецЕсли;
	Если Не ПустаяСтрока(Статус) Тогда
		Текст = Текст + "
		|	И Материалы.Статус = &Статус";
		Запрос.УстановитьПараметр("Статус", СтатусМатериала(Статус));
	КонецЕсли;
	Текст = Текст + "
	|УПОРЯДОЧИТЬ ПО
	|	Материалы.Наименование";
	Запрос.Текст = Текст;

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Новый Структура;
		Строка.Вставить("Ссылка", Выборка.Ссылка);
		Строка.Вставить("Наименование", Выборка.Наименование);
		Строка.Вставить("Хеш", Выборка.Хеш);
		Строка.Вставить("Размер", Выборка.Размер);
		Строка.Вставить("MIME", Выборка.MIME);
		Строка.Вставить("ПутьВХранилище", Выборка.ПутьВХранилище);
		Строка.Вставить("ВидДокумента", Выборка.ВидДокумента);
		Строка.Вставить("Статус", Выборка.Статус);
		Строка.Вставить("Комментарий", Выборка.Комментарий);
		Результат.Добавить(Строка);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Возвращает загрузки по фильтру.
//
// Параметры:
//  Хеш - Строка - SHA-256 материала или пустая строка.
//  ЛогинСотрудника - Строка - логин или пустая строка.
//  ЗадачаИд - Строка - UUID задачи или пустая строка.
//  Статус - Строка - статус или пустая строка.
Функция ЗагрузкиПоФильтру(Хеш = "", ЛогинСотрудника = "", ЗадачаИд = "", Статус = "") Экспорт
	Запрос = Новый Запрос;
	Текст =
	"ВЫБРАТЬ
	|	Загрузки.Ссылка КАК Ссылка,
	|	Загрузки.Наименование КАК Наименование,
	|	Загрузки.КодЗагрузки КАК КодЗагрузки,
	|	Загрузки.Владелец КАК Материал,
	|	Загрузки.Владелец.Хеш КАК Хеш,
	|	Загрузки.Сотрудник КАК Сотрудник,
	|	Загрузки.Должность КАК Должность,
	|	Загрузки.Задача КАК Задача,
	|	Загрузки.ИсточникURL КАК ИсточникURL,
	|	Загрузки.ВидИсточника КАК ВидИсточника,
	|	Загрузки.АвторОрган КАК АвторОрган,
	|	Загрузки.ДатаПубликации КАК ДатаПубликации,
	|	Загрузки.ДатаЗагрузки КАК ДатаЗагрузки,
	|	Загрузки.Лицензия КАК Лицензия,
	|	Загрузки.Статус КАК Статус,
	|	Загрузки.Комментарий КАК Комментарий
	|ИЗ
	|	Справочник.АИС_ЗагрузкиМатериалов КАК Загрузки
	|ГДЕ
	|	ИСТИНА";
	Если Не ПустаяСтрока(Хеш) Тогда
		Текст = Текст + "
		|	И Загрузки.Владелец.Хеш = &Хеш";
		Запрос.УстановитьПараметр("Хеш", НормализоватьХеш(Хеш));
	КонецЕсли;
	Если Не ПустаяСтрока(ЛогинСотрудника) Тогда
		Текст = Текст + "
		|	И Загрузки.Сотрудник.Наименование = &Сотрудник";
		Запрос.УстановитьПараметр("Сотрудник", ЛогинСотрудника);
	КонецЕсли;
	Если Не ПустаяСтрока(ЗадачаИд) Тогда
		Задача = ЗадачаПоИдентификатору(ЗадачаИд);
		Если Задача = Неопределено Тогда
			Возврат Новый Массив;
		КонецЕсли;
		Текст = Текст + "
		|	И Загрузки.Задача = &Задача";
		Запрос.УстановитьПараметр("Задача", Задача);
	КонецЕсли;
	Если Не ПустаяСтрока(Статус) Тогда
		Текст = Текст + "
		|	И Загрузки.Статус = &Статус";
		Запрос.УстановитьПараметр("Статус", СтатусЗагрузки(Статус));
	КонецЕсли;
	Текст = Текст + "
	|УПОРЯДОЧИТЬ ПО
	|	Загрузки.ДатаЗагрузки УБЫВ,
	|	Загрузки.Наименование";
	Запрос.Текст = Текст;

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Новый Структура;
		Строка.Вставить("Ссылка", Выборка.Ссылка);
		Строка.Вставить("Наименование", Выборка.Наименование);
		Строка.Вставить("КодЗагрузки", Выборка.КодЗагрузки);
		Строка.Вставить("Материал", Выборка.Материал);
		Строка.Вставить("Хеш", Выборка.Хеш);
		Строка.Вставить("Сотрудник", Выборка.Сотрудник);
		Строка.Вставить("Должность", Выборка.Должность);
		Строка.Вставить("Задача", Выборка.Задача);
		Строка.Вставить("ИсточникURL", Выборка.ИсточникURL);
		Строка.Вставить("ВидИсточника", Выборка.ВидИсточника);
		Строка.Вставить("АвторОрган", Выборка.АвторОрган);
		Строка.Вставить("ДатаПубликации", Выборка.ДатаПубликации);
		Строка.Вставить("ДатаЗагрузки", Выборка.ДатаЗагрузки);
		Строка.Вставить("Лицензия", Выборка.Лицензия);
		Строка.Вставить("Статус", Выборка.Статус);
		Строка.Вставить("Комментарий", Выборка.Комментарий);
		Результат.Добавить(Строка);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Возвращает загрузки сотрудника.
Функция ЗагрузкиПоСотруднику(Сотрудник) Экспорт
	Логин = "";
	Если ЗначениеЗаполнено(Сотрудник) Тогда
		Логин = Сотрудник.Наименование;
	КонецЕсли;
	Возврат ЗагрузкиПоФильтру("", Логин);
КонецФункции

// Сводка по сотрудникам: уникальные материалы и число фактов загрузки.
Функция СводкаПоСотрудникам() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Загрузки.Сотрудник.Наименование КАК Сотрудник,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Загрузки.Владелец) КАК Материалов,
	|	КОЛИЧЕСТВО(*) КАК Загрузок
	|ИЗ
	|	Справочник.АИС_ЗагрузкиМатериалов КАК Загрузки
	|ГДЕ
	|	Загрузки.Сотрудник <> НЕОПРЕДЕЛЕНО
	|СГРУППИРОВАТЬ ПО
	|	Загрузки.Сотрудник.Наименование
	|УПОРЯДОЧИТЬ ПО
	|	Сотрудник";
	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Строка = Новый Структура;
		Строка.Вставить("Сотрудник", Выборка.Сотрудник);
		Строка.Вставить("Материалов", Выборка.Материалов);
		Строка.Вставить("Загрузок", Выборка.Загрузок);
		Результат.Добавить(Строка);
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Меняет статус материала по SHA-256.
Функция УстановитьСтатусМатериала(Хеш, Статус, Комментарий = "") Экспорт
	Хеш = НормализоватьХеш(Хеш);
	Если Не ЭтоХешSHA256(Хеш) Тогда
		ВызватьИсключение("Хеш материала обязан содержать 64 hex-символа.");
	КонецЕсли;
	Блокировка = ЗаблокироватьЗапись("Справочник.АИС_МатериалыЗнаний", "Хеш", Хеш);
	Материал = НайтиМатериалПоХешу(Хеш);
	Если Материал = Неопределено Тогда
		ВызватьИсключение("Материал не найден: " + Хеш);
	КонецЕсли;
	Материал.Статус = СтатусМатериала(Статус);
	Если Не ПустаяСтрока(Комментарий) Тогда
		Материал.Комментарий = СокрЛП(Комментарий);
	КонецЕсли;
	Материал.Записать();
	Возврат Материал.Ссылка;
КонецФункции

// Меняет статус загрузки по КодЗагрузки.
Функция УстановитьСтатусЗагрузки(КодЗагрузки, Статус, Комментарий = "") Экспорт
	КодЗагрузки = СокрЛП(КодЗагрузки);
	Если ПустаяСтрока(КодЗагрузки) Тогда
		ВызватьИсключение("Не указан КодЗагрузки.");
	КонецЕсли;
	Блокировка = ЗаблокироватьЗапись(
		"Справочник.АИС_ЗагрузкиМатериалов", "КодЗагрузки", КодЗагрузки);
	Загрузка = НайтиЗагрузкуПоКоду(КодЗагрузки);
	Если Загрузка = Неопределено Тогда
		ВызватьИсключение("Загрузка не найдена: " + КодЗагрузки);
	КонецЕсли;
	Загрузка.Статус = СтатусЗагрузки(Статус);
	Если Не ПустаяСтрока(Комментарий) Тогда
		Загрузка.Комментарий = СокрЛП(Комментарий);
	КонецЕсли;
	Загрузка.Записать();
	Возврат Загрузка.Ссылка;
КонецФункции

// Проверяет относительный путь материала и возвращает его канонический вид.
// Запрещены абсолютные пути, "..", "." и выход за корень (включая symlink).
Функция ПроверитьПуть(Путь) Экспорт
	Исходный = СокрЛП(Путь);
	Если ПустаяСтрока(Исходный) Тогда
		ВызватьИсключение("Путь материала не задан.");
	КонецЕсли;
	Если СтрНачинаетсяС(Исходный, "/")
		Или СтрНачинаетсяС(Исходный, "\")
		Или СтрНайти(Исходный, ":") > 0 Тогда
		ВызватьИсключение("Абсолютные пути в корпусе запрещены: " + Исходный);
	КонецЕсли;

	Нормализованный = СтрЗаменить(Исходный, "\", "/");
	Части = СтрРазделить(Нормализованный, "/", Ложь);
	Очищенные = Новый Массив;
	Для Каждого Часть Из Части Цикл
		Если Часть = ".." Или Часть = "." Тогда
			ВызватьИсключение("Путь содержит недопустимые компоненты: " + Исходный);
		КонецЕсли;
		Если Не ПустаяСтрока(Часть) Тогда
			Очищенные.Добавить(Часть);
		КонецЕсли;
	КонецЦикла;
	Если Очищенные.Количество() = 0 Тогда
		ВызватьИсключение("Путь материала пуст.");
	КонецЕсли;
	Нормализованный = СтрСоединить(Очищенные, "/");

	Корень = КаталогКорпуса();
	Если ПустаяСтрока(Корень) Тогда
		ВызватьИсключение("Не задана константа АИС_КаталогКорпусаЗнаний.");
	КонецЕсли;
	ФайлКорня = Новый Файл(Корень);
	Если Не ФайлКорня.Существует() Или Не ФайлКорня.ЭтоКаталог() Тогда
		ВызватьИсключение("Каталог корпуса недоступен: " + Корень);
	КонецЕсли;

	КореньБезСлэша = Корень;
	Пока СтрДлина(КореньБезСлэша) > 1
		И (Прав(КореньБезСлэша, 1) = "/" Или Прав(КореньБезСлэша, 1) = "\") Цикл
		КореньБезСлэша = Лев(КореньБезСлэша, СтрДлина(КореньБезСлэша) - 1);
	КонецЦикла;

	ПолныйПуть = КореньБезСлэша + "/" + Нормализованный;
	Файл = Новый Файл(ПолныйПуть);
	Если Не Файл.Существует() Тогда
		ВызватьИсключение("Файл материала не найден: " + Нормализованный);
	КонецЕсли;

	Попытка
		КаноническийКорень = ПолучитьПолноеИмяФайла(КореньБезСлэша);
		КаноническийПуть = ПолучитьПолноеИмяФайла(ПолныйПуть);
	Исключение
		ВызватьИсключение("Не удалось канонизировать путь материала: " + ОписаниеОшибки());
	КонецПопытки;
	Если Не СтрНачинаетсяС(КаноническийПуть, КаноническийКорень + "/") Тогда
		ВызватьИсключение("Путь выходит за корень корпуса: " + Исходный);
	КонецЕсли;

	Возврат Нормализованный;
КонецФункции

// Возвращает разрешённый корень корпуса из константы.
Функция КаталогКорпуса() Экспорт
	Возврат СокрЛП(Константы.АИС_КаталогКорпусаЗнаний.Получить());
КонецФункции

// Возвращает сотрудника, от имени которого выполняется запрос.
Функция ТекущийСотрудник() Экспорт
	Возврат ПараметрыСеанса.АИС_ТекущееДЛ;
КонецФункции

// Ищет сотрудника по логину (наименованию справочника Пользователи).
Функция СотрудникПоЛогину(Логин) Экспорт
	Логин = СокрЛП(Логин);
	Если ПустаяСтрока(Логин) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Справочники.Пользователи.НайтиПоНаименованию(Логин, Истина);
КонецФункции

// Считает КодЗагрузки = SHA-256(sha256|source_url|employee|task).
Функция ХешКлючаЗагрузки(Хеш, ИсточникURL, ЛогинСотрудника, ЗадачаИд) Экспорт
	СтрокаКлюча = НРег(СокрЛП(Хеш)) + "|" + СокрЛП(ИсточникURL) + "|"
		+ СокрЛП(ЛогинСотрудника) + "|" + НРег(СокрЛП(ЗадачаИд));
	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA256);
	Хеширование.Добавить(СтрокаКлюча);
	Возврат НРег(Хеширование.ХешСумма);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СвойствоДанных(Данные, Имя, ЗначениеПоУмолчанию = "") Экспорт
	Значение = ЗначениеПоУмолчанию;
	Если ТипЗнч(Данные) = Тип("Структура") Тогда
		Данные.Свойство(Имя, Значение);
	КонецЕсли;
	Если Значение = Неопределено Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	Возврат Значение;
КонецФункции

Функция НормализоватьХеш(Значение)
	Возврат НРег(СокрЛП(Значение));
КонецФункции

Функция ЭтоХешSHA256(Значение)
	Строка = НормализоватьХеш(Значение);
	Если СтрДлина(Строка) <> 64 Тогда
		Возврат Ложь;
	КонецЕсли;
	Допустимые = "0123456789abcdef";
	Для Индекс = 1 По 64 Цикл
		Если СтрНайти(Допустимые, Сред(Строка, Индекс, 1)) = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;
КонецФункции

Функция ЧислоИлиНоль(Значение)
	Попытка
		Возврат Число(Значение);
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

Функция СтатусМатериала(Значение)
	Статус = НРег(СокрЛП(Значение));
	Если ПустаяСтрока(Статус) Или Статус = "downloaded" Или Статус = "загружен"
		Или Статус = "verified" Или Статус = "проверен" Тогда
		Возврат "Проверен";
	КонецЕсли;
	Если Статус = "rejected" Или Статус = "отклонен" Или Статус = "отклонён" Тогда
		Возврат "Отклонён";
	КонецЕсли;
	ВызватьИсключение("Неизвестный статус материала: " + Значение);
КонецФункции

Функция СтатусЗагрузки(Значение)
	Статус = НРег(СокрЛП(Значение));
	Если ПустаяСтрока(Статус) Или Статус = "downloaded" Или Статус = "загружен" Тогда
		Возврат "Загружен";
	КонецЕсли;
	Если Статус = "verified" Или Статус = "проверен" Тогда
		Возврат "Проверен";
	КонецЕсли;
	Если Статус = "rejected" Или Статус = "отклонен" Или Статус = "отклонён" Тогда
		Возврат "Отклонён";
	КонецЕсли;
	ВызватьИсключение("Неизвестный статус загрузки: " + Значение);
КонецФункции

Функция ДатаИзСтроки(Значение)
	Строка = СокрЛП(Значение);
	Если ПустаяСтрока(Строка) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	ПозицияT = СтрНайти(Строка, "T");
	Если ПозицияT > 0 Тогда
		Строка = Лев(Строка, ПозицияT - 1);
	КонецЕсли;
	Части = СтрРазделить(Строка, "-", Ложь);
	Если Части.Количество() < 3 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Попытка
		Год = Число(Части[0]);
		Месяц = Число(Части[1]);
		День = Число(Лев(Части[2], 2));
		Возврат Дата(Год, Месяц, День);
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;
КонецФункции

Функция ДолжностьПоНаименованию(Наименование)
	Наименование = СокрЛП(Наименование);
	Если ПустаяСтрока(Наименование) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Должность = Справочники.Должности.НайтиПоНаименованию(Наименование, Истина);
	Если Должность = Неопределено Тогда
		Должность = Справочники.Должности.СоздатьЭлемент();
		Должность.Наименование = Наименование;
		Должность.Записать();
	КонецЕсли;
	Возврат Должность;
КонецФункции

Функция ЗадачаПоИдентификатору(Ид)
	Ид = СокрЛП(Ид);
	Если ПустаяСтрока(Ид) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		УникальныйИдентификатор = Новый УникальныйИдентификатор(Ид);
		Возврат Задачи.ЗадачаИсполнителя.ПолучитьСсылку(УникальныйИдентификатор);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция ТаймаутБлокировкиКорпуса()
	Возврат 30;
КонецФункции

Функция ЗаблокироватьЗапись(ИмяТаблицы, Поле, Значение)
	ПоследняяОшибка = "";
	Для НомерПопытки = 1 По 3 Цикл
		Попытка
			Блокировка = Новый БлокировкаДанных;
			Блокировка.Таймаут = ТаймаутБлокировкиКорпуса();
			ЭлементБлокировки = Блокировка.Добавить(ИмяТаблицы);
			ЭлементБлокировки.УстановитьЗначение(Поле, Значение);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			Блокировка.Заблокировать();
			Возврат Блокировка;
		Исключение
			ПоследняяОшибка = ОписаниеОшибки();
			Если НомерПопытки < 3 Тогда
				Приостановить(1000 * НомерПопытки);
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;
	ВызватьИсключение("Не удалось заблокировать " + ИмяТаблицы + ": " + ПоследняяОшибка);
КонецФункции

#КонецОбласти
