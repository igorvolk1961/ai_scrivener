		Текст = "Ошибка чтения должностных обязанностей: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("АИС.Симулятор", УровеньЖурналаРегистрации.Ошибка,,, Текст);
		Ответ.УстановитьТелоИзСтроки(Текст);
		Ответ.КодСостояния = 400;
	КонецПопытки;

	Возврат Ответ;
КонецФункции

// GET /hs/ais-sim/duty-instructions
// Диагностический список документов «Должностная инструкция».
Функция ПолучитьДолжностныеИнструкции_GET(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Попытка
		УстановитьПривилегированныйРежим(Истина);
		ЗапросИнструкций = Новый Запрос;
		ЗапросИнструкций.Текст =
		"ВЫБРАТЬ
		|	Документы.Ссылка КАК Ссылка,
		|	Документы.АИС_Должность.Наименование КАК Должность,
		|	Документы.Заголовок КАК Заголовок,
		|	Документы.Подготовил.Наименование КАК Автор,
		|	Документы.Содержание КАК Текст
		|ИЗ
		|	Справочник.ВнутренниеДокументы КАК Документы
		|ГДЕ
		|	Документы.ВидДокумента.Наименование = ""Должностная инструкция""
		|	И НЕ Документы.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Документы.АИС_Должность.Наименование,
		|	Документы.Заголовок";
		Выборка = ЗапросИнструкций.Выполнить().Выбрать();

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоМассива();
		Пока Выборка.Следующий() Цикл
			ЗаписьJSON.ЗаписатьНачалоОбъекта();
			ЗаписьJSON.ЗаписатьИмяСвойства("УникальныйИдентификатор");
			ЗаписьJSON.ЗаписатьЗначение(Строка(Выборка.Ссылка.УникальныйИдентификатор()));
			ЗаписьJSON.ЗаписатьИмяСвойства("Должность");
			ЗаписьJSON.ЗаписатьЗначение(Выборка.Должность);
			ЗаписьJSON.ЗаписатьИмяСвойства("Заголовок");
			ЗаписьJSON.ЗаписатьЗначение(Выборка.Заголовок);
			ЗаписьJSON.ЗаписатьИмяСвойства("Автор");
			ЗаписьJSON.ЗаписатьЗначение(Выборка.Автор);
			ЗаписьJSON.ЗаписатьИмяСвойства("Текст");
			ЗаписьJSON.ЗаписатьЗначение(Выборка.Текст);
			ЗаписьJSON.ЗаписатьКонецОбъекта();
		КонецЦикла;
		ЗаписьJSON.ЗаписатьКонецМассива();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Текст = "Ошибка чтения должностных инструкций: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("АИС.Симулятор", УровеньЖурналаРегистрации.Ошибка,,, Текст);
		Ответ.УстановитьТелоИзСтроки(Текст);
		Ответ.КодСостояния = 400;
	КонецПопытки;

	Возврат Ответ;
КонецФункции

// GET /hs/ais-sim/orders/status?id=<УникальныйИдентификатор приказа>
// Возвращает статус обработки приказа: задачи с предметом = приказ
// (включая выполненные), признак выполнения и связанные документы-результаты.
// Это критерий завершения приказа для симулятора - без поиска по заголовку
// и без служебных маркеров в тексте.
Функция ПолучитьСтатусПриказа_GET(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Ид = Запрос.ПараметрыЗапроса.Получить("id");
		Если ПустаяСтрока(Ид) Тогда
			Ответ.КодСостояния = 400;
			Ответ.УстановитьТелоИзСтроки("Не указан id приказа");
			Возврат Ответ;
		КонецЕсли;

		Документ = ДокументПоУникальномуИдентификатору(Ид);
		Если Не ЗначениеЗаполнено(Документ) Тогда
			Ответ.КодСостояния = 404;
			Ответ.УстановитьТелоИзСтроки("Документ не найден: " + Ид);
			Возврат Ответ;
		КонецЕсли;

		Статус = АИС_ОбщегоНазначения.ПолучитьСтатусПриказа(Документ);
		Если Статус = Неопределено Тогда
			Ответ.КодСостояния = 404;
			Ответ.УстановитьТелоИзСтроки("Документ не найден: " + Ид);
			Возврат Ответ;
		КонецЕсли;

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписатьДокументВJSON(ЗаписьJSON, "Документ", Документ);
		ЗаписьJSON.ЗаписатьИмяСвойства("ЗадачаВыполнена");
		ЗаписьJSON.ЗаписатьЗначение(Статус.ЗадачаВыполнена);

		ЗаписьJSON.ЗаписатьИмяСвойства("Задачи");
		ЗаписьJSON.ЗаписатьНачалоМассива();
		Для Каждого Задача Из Статус.Задачи Цикл
			ЗаписьJSON.ЗаписатьНачалоОбъекта();
			ЗаписьJSON.ЗаписатьИмяСвойства("УникальныйИдентификатор");
			ЗаписьJSON.ЗаписатьЗначение(Задача.УникальныйИдентификатор);
			ЗаписьJSON.ЗаписатьИмяСвойства("Наименование");
			ЗаписьJSON.ЗаписатьЗначение(Задача.Наименование);
			ЗаписьJSON.ЗаписатьИмяСвойства("Выполнена");
			ЗаписьJSON.ЗаписатьЗначение(Задача.Выполнена);
			ЗаписьJSON.ЗаписатьИмяСвойства("ДатаНачала");
			ЗаписьJSON.ЗаписатьЗначение(Строка(Задача.ДатаНачала));
			ЗаписьJSON.ЗаписатьИмяСвойства("РезультатВыполнения");
			ЗаписьJSON.ЗаписатьЗначение(Задача.РезультатВыполнения);
			ЗаписьJSON.ЗаписатьИмяСвойства("Исполнитель");
			ЗаписьJSON.ЗаписатьЗначение(Задача.Исполнитель);
			ЗаписьJSON.ЗаписатьКонецОбъекта();
		КонецЦикла;
		ЗаписьJSON.ЗаписатьКонецМассива();

		ЗаписьJSON.ЗаписатьИмяСвойства("Связи");
		ЗаписьJSON.ЗаписатьНачалоМассива();
		Для Каждого Связь Из Статус.Связи Цикл
			ЗаписьJSON.ЗаписатьНачалоОбъекта();
			ЗаписьJSON.ЗаписатьИмяСвойства("УникальныйИдентификатор");
			ЗаписьJSON.ЗаписатьЗначение(Связь.УникальныйИдентификатор);
			ЗаписьJSON.ЗаписатьИмяСвойства("Заголовок");
			ЗаписьJSON.ЗаписатьЗначение(Связь.Заголовок);
			ЗаписьJSON.ЗаписатьИмяСвойства("Вид");
			ЗаписьJSON.ЗаписатьЗначение(Связь.Вид);
			ЗаписьJSON.ЗаписатьИмяСвойства("Автор");
			ЗаписьJSON.ЗаписатьЗначение(Связь.Автор);
			ЗаписьJSON.ЗаписатьИмяСвойства("Дата");
			ЗаписьJSON.ЗаписатьЗначение(Строка(Связь.Дата));
			ЗаписьJSON.ЗаписатьИмяСвойства("Комментарий");
			ЗаписьJSON.ЗаписатьЗначение(Связь.Комментарий);
			ЗаписьJSON.ЗаписатьИмяСвойства("Установил");
			ЗаписьJSON.ЗаписатьЗначение(Связь.Установил);
			ЗаписьJSON.ЗаписатьИмяСвойства("ДатаУстановки");
			ЗаписьJSON.ЗаписатьЗначение(Строка(Связь.ДатаУстановки));
			ЗаписьJSON.ЗаписатьКонецОбъекта();
		КонецЦикла;
		ЗаписьJSON.ЗаписатьКонецМассива();

		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Текст = "Ошибка получения статуса приказа через АИС_Симулятор: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("АИС.Симулятор", УровеньЖурналаРегистрации.Ошибка,,, Текст);
		Ответ.УстановитьТелоИзСтроки(Текст);
		Ответ.КодСостояния = 400;
	КонецПопытки;

	Возврат Ответ;
КонецФункции

// POST /hs/ais-sim/orders/link
// Создаёт штатную связь "приказ -> документ-результат" для уже существующих
// документов. Нужен для ручного восстановления/backfill, когда документ был
// создан до включения автоматической привязки.
// Тело: {"Основание": "<uuid приказа>", "Документ": "<uuid результата>"}
Функция СвязатьДокументы_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Попытка
		ТелоКакСтрока = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоКакСтрока);
		Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();

		УстановитьПривилегированныйРежим(Истина);
		Основание = ДокументПоУникальномуИдентификатору(Данные.Основание);
		Документ = ДокументПоУникальномуИдентификатору(Данные.Документ);
		Если Не ЗначениеЗаполнено(Основание) Или Не ЗначениеЗаполнено(Документ) Тогда
			Ответ.КодСостояния = 404;
			Ответ.УстановитьТелоИзСтроки("Документ или основание не найдены");
			Возврат Ответ;
		КонецЕсли;

		СвязьУстановлена = АИС_ОбщегоНазначения.СоздатьСвязьДокументаСОснованием(
			Документ, Основание);

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписьJSON.ЗаписатьИмяСвойства("Статус");
		ЗаписьJSON.ЗаписатьЗначение("ok");
		ЗаписьJSON.ЗаписатьИмяСвойства("СвязьУстановлена");
		ЗаписьJSON.ЗаписатьЗначение(СвязьУстановлена);
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Текст = "Ошибка связи документов через АИС_Симулятор: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("АИС.Симулятор", УровеньЖурналаРегистрации.Ошибка,,, Текст);
		Ответ.УстановитьТелоИзСтроки(Текст);
		Ответ.КодСостояния = 400;
	КонецПопытки;

	Возврат Ответ;
КонецФункции

// Определяет документ-основание для создаваемого документа: явное поле
// "Основание" или предмет текущей задачи ("Задача"), если задача принадлежит
// текущему сотруднику. Ошибки разбора не прерывают создание документа.
Функция ОпределитьОснованиеНовогоДокумента(Данные)
	ОснованиеИд = "";
	Данные.Свойство("Основание", ОснованиеИд);
	Если ОснованиеИд = Неопределено Тогда
		ОснованиеИд = "";
	КонецЕсли;
	Основание = ДокументПоУникальномуИдентификатору(ОснованиеИд);
	Если ЗначениеЗаполнено(Основание) Тогда
		Возврат Основание;
	КонецЕсли;

	ЗадачаИд = "";
	Данные.Свойство("Задача", ЗадачаИд);
	Если ЗадачаИд = Неопределено Тогда
		ЗадачаИд = "";
	КонецЕсли;
	Задача = ЗадачаПоУникальномуИдентификатору(ЗадачаИд);
	Если Не ЗначениеЗаполнено(Задача) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Если Задача.Исполнитель <> ПараметрыСеанса.ТекущийПользователь Тогда
		// Чужую задачу нельзя использовать как основание документа.
		Возврат Неопределено;
	КонецЕсли;
	Возврат АИС_ОбщегоНазначения.ПолучитьОснованиеЗадачи(Задача);
КонецФункции

Функция ДокументПоУникальномуИдентификатору(Ид)
	Если ПустаяСтрока(Ид) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Ссылка = Справочники.ВнутренниеДокументы.ПолучитьСсылку(Новый УникальныйИдентификатор(Ид));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если Ссылка.ПолучитьОбъект() = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Ссылка;
КонецФункции

Функция ЗадачаПоУникальномуИдентификатору(Ид)
	Если ПустаяСтрока(Ид) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Ссылка = Задачи.ЗадачаИсполнителя.ПолучитьСсылку(Новый УникальныйИдентификатор(Ид));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если Ссылка.ПолучитьОбъект() = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Ссылка;
КонецФункции

Процедура ЗаписатьДокументВJSON(ЗаписьJSON, ИмяСвойства, Документ)
	ЗаписьJSON.ЗаписатьИмяСвойства(ИмяСвойства);
	Если Не ЗначениеЗаполнено(Документ) Тогда
		ЗаписьJSON.ЗаписатьЗначение(Неопределено);
		Возврат;
	КонецЕсли;
	ЗаписьJSON.ЗаписатьНачалоОбъекта();
	ЗаписьJSON.ЗаписатьИмяСвойства("УникальныйИдентификатор");
	ЗаписьJSON.ЗаписатьЗначение(Строка(Документ.УникальныйИдентификатор()));
	ЗаписьJSON.ЗаписатьИмяСвойства("Заголовок");
	ЗаписьJSON.ЗаписатьЗначение(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "Заголовок"));
	ЗаписьJSON.ЗаписатьИмяСвойства("Вид");
	ЗаписьJSON.ЗаписатьЗначение(Строка(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "ВидДокумента")));
	ЗаписьJSON.ЗаписатьИмяСвойства("Автор");
	ЗаписьJSON.ЗаписатьЗначение(Строка(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Документ, "Подготовил")));
	ЗаписьJSON.ЗаписатьКонецОбъекта();
КонецПроцедуры


// GET /hs/ais-sim/folders?employee=<login>
// Плоский список папок сотрудника с путями и количеством документов.
Функция ПолучитьПапки_GET(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Сотрудник = СотрудникПоПараметру(Запрос.ПараметрыЗапроса.Получить("employee"));
		Если Не ЗначениеЗаполнено(Сотрудник) Тогда
			Ответ.КодСостояния = 404;
			Ответ.УстановитьТелоИзСтроки("Сотрудник не найден");
			Возврат Ответ;
		КонецЕсли;
		ПапкиСотрудника = АИС_ПапкиДокументов.ПолучитьПапкиСотрудника(Сотрудник);
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоМассива();
		Для Каждого Папка Из ПапкиСотрудника Цикл
			ЗаписатьПапкуВJSON(ЗаписьJSON, Папка);
		КонецЦикла;
		ЗаписьJSON.ЗаписатьКонецМассива();
