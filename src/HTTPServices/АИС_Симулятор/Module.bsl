			ЗаписьJSON.ЗаписатьНачалоОбъекта();
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "id", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "name", Выборка.Наименование);
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "full_name", Выборка.НаименованиеПолное);
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "inn", Выборка.ИНН);
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "kpp", Выборка.КПП);
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "role", СтрЗаменить(Строка(Выборка.Комментарий), "АИС: role=", ""));
			ЗаписьJSON.ЗаписатьКонецОбъекта();
		КонецЦикла;
		ЗаписьJSON.ЗаписатьКонецМассива();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Ответ.КодСостояния = 400;
		Ответ.УстановитьТелоИзСтроки("{""error"":""" + СтрЗаменить(ОписаниеОшибки(), """", "'") + """}");
	КонецПопытки;
	Возврат Ответ;
КонецФункции

