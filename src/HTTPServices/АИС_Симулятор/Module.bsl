// POST /hs/ais-sim/information-requests
// Тело: {"Адресат":"<login>", "ВидЗапроса":"provide|confirm|clarify",
//        "ПредметнаяОбласть":"...", "Вопрос":"...", "Обоснование":"...",
//        "Срок":"...", "Основание":"<uuid>", "ИсходныеДокументы":["<uuid>"]}
Функция СоздатьЗапросИнформации_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Автор = ТекущийПользовательСправочника();
		Если Не ЗначениеЗаполнено(Автор) Тогда
			Ответ.КодСостояния = 401;
			Ответ.УстановитьТелоИзСтроки("Текущий пользователь не найден");
			Возврат Ответ;
		КонецЕсли;
		Данные = ПрочитатьJSONИзЗапроса(Запрос);
		Логин = "";
		Данные.Свойство("Адресат", Логин);
		Адресат = Справочники.Пользователи.НайтиПоНаименованию(Строка(Логин), Истина);
		Если Не ЗначениеЗаполнено(Адресат) Тогда
			Ответ.КодСостояния = 404;
			Ответ.УстановитьТелоИзСтроки("Адресат не найден");
			Возврат Ответ;
		КонецЕсли;
		ВидЗапроса = "provide";
		Данные.Свойство("ВидЗапроса", ВидЗапроса);
		Область = "";
		Данные.Свойство("ПредметнаяОбласть", Область);
		Вопрос = "";
		Данные.Свойство("Вопрос", Вопрос);
		Обоснование = "";
		Данные.Свойство("Обоснование", Обоснование);
		Срок = "";
		Данные.Свойство("Срок", Срок);
		ИдОснования = "";
		Данные.Свойство("Основание", ИдОснования);
		Основание = Неопределено;
		Если Не ПустаяСтрока(ИдОснования) Тогда
			Основание = Справочники.ВнутренниеДокументы.ПолучитьСсылку(
				Новый УникальныйИдентификатор(ИдОснования));
		КонецЕсли;
		ИсходныеJSON = Неопределено;
		Данные.Свойство("ИсходныеДокументы", ИсходныеJSON);
		Исходные = МассивИдентификаторовИзJSON(ИсходныеJSON);
		Ограниченные = ПроверитьИсходныеДокументы(Исходные, Адресат);
		Если Ограниченные.Количество() > 0 Тогда
			ЗаписьJSON = Новый ЗаписьJSON;
			ЗаписьJSON.УстановитьСтроку();
			ЗаписьJSON.ЗаписатьНачалоОбъекта();
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "error", "access_denied");
			ЗаписьJSON.ЗаписатьИмяСвойства("restricted");
			ЗаписьОбъектJSON(ЗаписьJSON, Ограниченные);
			ЗаписьJSON.ЗаписатьКонецОбъекта();
			Ответ.КодСостояния = 403;
			Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
			Возврат Ответ;
		КонецЕсли;

		Отношение = "peer";
		ЗапросРуководителя = Новый Запрос;
		ЗапросРуководителя.УстановитьПараметр("Автор", Автор);
		ЗапросРуководителя.УстановитьПараметр("Адресат", Адресат);
		ЗапросРуководителя.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Подчиненность.Подчиненный КАК Подчиненный
		|ИЗ РегистрСведений.ПодчиненностьСотрудников КАК Подчиненность
		|ГДЕ Подчиненность.Подчиненный = &Автор И Подчиненность.Руководитель = &Адресат";
		Если Не ЗапросРуководителя.Выполнить().Пустой() Тогда
			Отношение = "manager";
		Иначе
			ЗапросПодчиненного = Новый Запрос;
			ЗапросПодчиненного.УстановитьПараметр("Автор", Автор);
			ЗапросПодчиненного.УстановитьПараметр("Адресат", Адресат);
			ЗапросПодчиненного.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Подчиненность.Подчиненный КАК Подчиненный
			|ИЗ РегистрСведений.ПодчиненностьСотрудников КАК Подчиненность
			|ГДЕ Подчиненность.Подчиненный = &Адресат И Подчиненность.Руководитель = &Автор";
			Если Не ЗапросПодчиненного.Выполнить().Пустой() Тогда
				Отношение = "subordinate";
			КонецЕсли;
		КонецЕсли;

		Если Отношение = "manager" Тогда
			Если ВидЗапроса = "confirm" Тогда
				Текст = "Прошу подтвердить актуальность информации по вопросу: " + Вопрос + ".";
			ИначеЕсли ВидЗапроса = "clarify" Тогда
				Текст = "Прошу уточнить информацию по вопросу: " + Вопрос + ".";
			Иначе
				Текст = "Прошу предоставить информацию по вопросу: " + Вопрос + ".";
			КонецЕсли;
			Если Не ПустаяСтрока(Обоснование) Тогда
				Текст = Текст + " Обоснование: " + Обоснование + ".";
			КонецЕсли;
		ИначеЕсли Отношение = "subordinate" Тогда
			Если ВидЗапроса = "confirm" Тогда
				Текст = "Подтвердите актуальность информации по вопросу: " + Вопрос + ".";
			ИначеЕсли ВидЗапроса = "clarify" Тогда
				Текст = "Уточните информацию по вопросу: " + Вопрос + ".";
			Иначе
				Текст = "Предоставьте информацию по вопросу: " + Вопрос + ".";
			КонецЕсли;
			Если Не ПустаяСтрока(Срок) Тогда
				Текст = Текст + " Срок: " + Срок + ".";
			КонецЕсли;
		Иначе
			Если ВидЗапроса = "confirm" Тогда
				Текст = "Прошу подтвердить актуальность информации по вопросу: " + Вопрос + ".";
			ИначеЕсли ВидЗапроса = "clarify" Тогда
				Текст = "Прошу уточнить информацию по вопросу: " + Вопрос + ".";
			Иначе
				Текст = "Прошу предоставить информацию по вопросу: " + Вопрос + ".";
			КонецЕсли;
			Если Не ПустаяСтрока(Обоснование) Тогда
				Текст = Текст + " В связи с: " + Обоснование + ".";
			КонецЕсли;
		КонецЕсли;
		Если Не ПустаяСтрока(Область) Тогда
			Текст = Текст + " Предметная область: " + Область + ".";
		КонецЕсли;

		Черновик = Справочники.АИС_ЧерновикиДокументов.СоздатьЭлемент();
		Черновик.Наименование = "Запрос информации: " + Область;
		Черновик.Автор = Автор;
		Черновик.ВидЧерновика = "information_request";
		Черновик.ВидЗапроса = Строка(ВидЗапроса);
		Черновик.Заголовок = "Запрос информации: " + Область;
		Черновик.Содержание = Текст;
		Черновик.Адресат = Адресат;
		Черновик.Основание = Основание;
		Черновик.Статус = "draft";
		Черновик.Версия = 1;
		Черновик.Замечания = "";
		ЗаписьИсходных = Новый ЗаписьJSON;
		ЗаписьИсходных.УстановитьСтроку();
		ЗаписьОбъектJSON(ЗаписьИсходных, Исходные);
		Черновик.ИсходныеДокументы = ЗаписьИсходных.Закрыть();
		Черновик.Записать();

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписатьСвойствоСтрокой(ЗаписьJSON, "status", "ok");
		ЗаписатьСвойствоСтрокой(
			ЗаписьJSON, "draft_id", Строка(Черновик.Ссылка.УникальныйИдентификатор()));
		ЗаписатьСвойствоСтрокой(ЗаписьJSON, "relation", Отношение);
		ЗаписатьСвойствоСтрокой(ЗаписьJSON, "text", Текст);
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Ответ.КодСостояния = 400;
		Ответ.УстановитьТелоИзСтроки("{""error"":""" + СтрЗаменить(ОписаниеОшибки(), """", "'") + """}");
	КонецПопытки;
	Возврат Ответ;
КонецФункции

// GET /hs/ais-sim/auto-approval
// Настройки автоодобрения текущего пользователя. Параметр user не принимается.
Функция ПолучитьАвтоодобрение_GET(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Пользователь = ТекущийПользовательСправочника();
		Если Не ЗначениеЗаполнено(Пользователь) Тогда
			Ответ.КодСостояния = 401;
			Ответ.УстановитьТелоИзСтроки("Текущий пользователь не найден в справочнике");
			Возврат Ответ;
		КонецЕсли;
		Настройки = НайтиНастройкиАвтоодобрения(Пользователь);
		Включено = Ложь;
		РежимПоУмолчанию = "off";
		Если Настройки <> Неопределено Тогда
			Включено = Настройки.Включено = Истина;
			РежимПоУмолчанию = Строка(Настройки.РежимПоУмолчанию);
			Если ПустаяСтрока(РежимПоУмолчанию) Тогда
				РежимПоУмолчанию = "off";
			КонецЕсли;
		КонецЕсли;

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписьJSON.ЗаписатьИмяСвойства("enabled");
		ЗаписьJSON.ЗаписатьЗначение(Включено);
		ЗаписатьСвойствоСтрокой(ЗаписьJSON, "default_mode", РежимПоУмолчанию);
		ЗаписьJSON.ЗаписатьИмяСвойства("document_types");
		ЗаписьJSON.ЗаписатьНачалоМассива();
		Если Настройки <> Неопределено Тогда
			ЗапросПравил = Новый Запрос;
			ЗапросПравил.УстановитьПараметр("Настройки", Настройки.Ссылка);
			ЗапросПравил.Текст =
			"ВЫБРАТЬ
			|	Правила.Ссылка КАК Ссылка,
			|	Правила.ВидДокумента.Наименование КАК Вид,
			|	Правила.Режим КАК Режим
			|ИЗ
			|	Справочник.АИС_ПравилаАвтоодобренияПоТипам КАК Правила
			|ГДЕ
			|	Правила.Владелец = &Настройки
			|	И Правила.Активность
			|	И НЕ Правила.ПометкаУдаления
			|УПОРЯДОЧИТЬ ПО
			|	Правила.ВидДокумента.Наименование";
			ВыборкаПравил = ЗапросПравил.Выполнить().Выбрать();
			Пока ВыборкаПравил.Следующий() Цикл
				ЗаписьJSON.ЗаписатьНачалоОбъекта();
				ЗаписатьСвойствоСтрокой(ЗаписьJSON, "document_type", ВыборкаПравил.Вид);
				ЗаписатьСвойствоСтрокой(ЗаписьJSON, "mode", ВыборкаПравил.Режим);
				ЗаписьJSON.ЗаписатьИмяСвойства("allowed_users");
				ЗаписьJSON.ЗаписатьНачалоМассива();
				ЗапросАвторов = Новый Запрос;
				ЗапросАвторов.УстановитьПараметр("Правило", ВыборкаПравил.Ссылка);
				ЗапросАвторов.Текст =
				"ВЫБРАТЬ
				|	Авторы.Пользователь.Наименование КАК Логин
				|ИЗ
				|	Справочник.АИС_РазрешенныеАвторыАвтоодобрения КАК Авторы
				|ГДЕ
				|	Авторы.Владелец = &Правило
				|	И Авторы.Активность
				|	И НЕ Авторы.ПометкаУдаления";
				ВыборкаАвторов = ЗапросАвторов.Выполнить().Выбрать();
				Пока ВыборкаАвторов.Следующий() Цикл
					ЗаписьJSON.ЗаписатьЗначение(ВыборкаАвторов.Логин);
				КонецЦикла;
				ЗаписьJSON.ЗаписатьКонецМассива();
				ЗаписьJSON.ЗаписатьИмяСвойства("allowed_counterparties");
				ЗаписьJSON.ЗаписатьНачалоМассива();
				ЗапросКонтрагентов = Новый Запрос;
				ЗапросКонтрагентов.УстановитьПараметр("Правило", ВыборкаПравил.Ссылка);
				ЗапросКонтрагентов.Текст =
				"ВЫБРАТЬ
				|	Контрагенты.Контрагент КАК Контрагент
				|ИЗ
				|	Справочник.АИС_РазрешенныеКонтрагентыАвтоодобрения КАК Контрагенты
				|ГДЕ
				|	Контрагенты.Владелец = &Правило
				|	И Контрагенты.Активность
				|	И НЕ Контрагенты.ПометкаУдаления";
				ВыборкаКонтрагентов = ЗапросКонтрагентов.Выполнить().Выбрать();
				Пока ВыборкаКонтрагентов.Следующий() Цикл
					ЗаписьJSON.ЗаписатьЗначение(
						Строка(ВыборкаКонтрагентов.Контрагент.УникальныйИдентификатор()));
				КонецЦикла;
				ЗаписьJSON.ЗаписатьКонецМассива();
				ЗаписьJSON.ЗаписатьКонецОбъекта();
			КонецЦикла;
		КонецЕсли;
		ЗаписьJSON.ЗаписатьКонецМассива();
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Ответ.КодСостояния = 400;
		Ответ.УстановитьТелоИзСтроки("{""error"":""" + СтрЗаменить(ОписаниеОшибки(), """", "'") + """}");
	КонецПопытки;
	Возврат Ответ;
КонецФункции

// POST /hs/ais-sim/auto-approval/set-all
// Тело: {"mode":"off|on|depends_on_author"}
Функция УстановитьАвтоодобрениеДляВсех_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Пользователь = ТекущийПользовательСправочника();
		Если Не ЗначениеЗаполнено(Пользователь) Тогда
			Ответ.КодСостояния = 401;
			Ответ.УстановитьТелоИзСтроки("Текущий пользователь не найден");
			Возврат Ответ;
		КонецЕсли;
		Данные = ПрочитатьJSONИзЗапроса(Запрос);
		Режим = "off";
		Данные.Свойство("mode", Режим);
		Режим = НРег(СокрЛП(Строка(Режим)));
		Если Режим <> "off" И Режим <> "on" И Режим <> "depends_on_author" Тогда
			ВызватьИсключение "Недопустимый режим: " + Режим;
		КонецЕсли;
		Настройки = ОбеспечитьНастройкиАвтоодобрения(Пользователь);
		Настройки.РежимПоУмолчанию = Режим;
		Включено = Неопределено;
		Данные.Свойство("enabled", Включено);
		Если ТипЗнч(Включено) = Тип("Булево") Тогда
			Настройки.Включено = Включено;
		КонецЕсли;
		Настройки.Записать();

		ЗапросТипов = Новый Запрос;
		ЗапросТипов.Текст =
		"ВЫБРАТЬ
		|	Виды.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ВидыВнутреннихДокументов КАК Виды
		|ГДЕ
		|	НЕ Виды.ПометкаУдаления";
		ВыборкаТипов = ЗапросТипов.Выполнить().Выбрать();
		Пока ВыборкаТипов.Следующий() Цикл
			Правило = ОбеспечитьПравилоАвтоодобрения(Настройки, ВыборкаТипов.Ссылка);
			Правило.Режим = Режим;
			Правило.Записать();
		КонецЦикла;

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписатьСвойствоСтрокой(ЗаписьJSON, "status", "ok");
		ЗаписатьСвойствоСтрокой(ЗаписьJSON, "mode", Режим);
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Ответ.КодСостояния = 400;
		Ответ.УстановитьТелоИзСтроки("{""error"":""" + СтрЗаменить(ОписаниеОшибки(), """", "'") + """}");
	КонецПопытки;
	Возврат Ответ;
КонецФункции

Функция НайтиНастройкиАвтоодобрения(Пользователь)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Настройки.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.АИС_НастройкиАвтоодобрения КАК Настройки
	|ГДЕ
	|	Настройки.Пользователь = &Пользователь
	|	И НЕ Настройки.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка.ПолучитьОбъект();
	КонецЕсли;
	Возврат Неопределено;
КонецФункции

Функция ОбеспечитьНастройкиАвтоодобрения(Пользователь)
	Настройки = НайтиНастройкиАвтоодобрения(Пользователь);
	Если Настройки <> Неопределено Тогда
		Возврат Настройки;
	КонецЕсли;
	Настройки = Справочники.АИС_НастройкиАвтоодобрения.СоздатьЭлемент();
	Настройки.Наименование = "Автоодобрение: " + Строка(Пользователь);
	Настройки.Пользователь = Пользователь;
	Настройки.Включено = Ложь;
	Настройки.РежимПоУмолчанию = "off";
	Настройки.Активность = Истина;
	Настройки.Записать();
	Возврат Настройки;
КонецФункции

Функция ОбеспечитьПравилоАвтоодобрения(Настройки, ВидДокумента)
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Настройки", Настройки.Ссылка);
	Запрос.УстановитьПараметр("Вид", ВидДокумента);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Правила.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.АИС_ПравилаАвтоодобренияПоТипам КАК Правила
	|ГДЕ
	|	Правила.Владелец = &Настройки
	|	И Правила.ВидДокумента = &Вид
	|	И НЕ Правила.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка.ПолучитьОбъект();
	КонецЕсли;
	Правило = Справочники.АИС_ПравилаАвтоодобренияПоТипам.СоздатьЭлемент();
	Правило.Владелец = Настройки.Ссылка;
	Правило.Наименование = "Правило: " + Строка(ВидДокумента);
	Правило.ВидДокумента = ВидДокумента;
	Правило.Режим = "off";
	Правило.Активность = Истина;
	Правило.Записать();
	Возврат Правило;
КонецФункции

