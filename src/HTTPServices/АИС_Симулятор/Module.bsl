			ЗаписьJSON.ЗаписатьЗначение(Задача.РезультатВыполнения);
			ЗаписьJSON.ЗаписатьИмяСвойства("Исполнитель");
			ЗаписьJSON.ЗаписатьЗначение(Задача.Исполнитель);
			ЗаписьJSON.ЗаписатьКонецОбъекта();
		КонецЦикла;
		ЗаписьJSON.ЗаписатьКонецМассива();

		ЗаписьJSON.ЗаписатьИмяСвойства("Связи");
		ЗаписьJSON.ЗаписатьНачалоМассива();
		Для Каждого Связь Из Статус.Связи Цикл
			ЗаписьJSON.ЗаписатьНачалоОбъекта();
			ЗаписьJSON.ЗаписатьИмяСвойства("УникальныйИдентификатор");
			ЗаписьJSON.ЗаписатьЗначение(Связь.УникальныйИдентификатор);
			ЗаписьJSON.ЗаписатьИмяСвойства("Заголовок");
			ЗаписьJSON.ЗаписатьЗначение(Связь.Заголовок);
			ЗаписьJSON.ЗаписатьИмяСвойства("Вид");
			ЗаписьJSON.ЗаписатьЗначение(Связь.Вид);
			ЗаписьJSON.ЗаписатьИмяСвойства("Автор");
			ЗаписьJSON.ЗаписатьЗначение(Связь.Автор);
			ЗаписьJSON.ЗаписатьИмяСвойства("Дата");
			ЗаписьJSON.ЗаписатьЗначение(Строка(Связь.Дата));
			ЗаписьJSON.ЗаписатьИмяСвойства("Комментарий");
