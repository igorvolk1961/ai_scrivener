// POST /hs/ais-sim/mailings/response
Функция ЗарегистрироватьОтвет_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Данные = ПрочитатьJSONИзЗапроса(Запрос);
		ИдРассылки = "";
		Данные.Свойство("Рассылка", ИдРассылки);
		ИдДокумента = "";
		Данные.Свойство("Документ", ИдДокумента);
		Если ПустаяСтрока(Строка(ИдРассылки)) ИЛИ ПустаяСтрока(Строка(ИдДокумента)) Тогда
			ВызватьИсключение "Нужны Рассылка и Документ";
		КонецЕсли;
		Рассылка = Справочники.АИС_Рассылки.ПолучитьСсылку(
			Новый УникальныйИдентификатор(Строка(ИдРассылки)));
		Документ = ДокументПоУникальномуИдентификатору(Строка(ИдДокумента));
		Если Не ЗначениеЗаполнено(Рассылка) ИЛИ Документ = Неопределено Тогда
			ВызватьИсключение "Рассылка или документ не найдены";
		КонецЕсли;
		Получатель = "";
		Данные.Свойство("Получатель", Получатель);
		Если ПустаяСтрока(Строка(Получатель)) Тогда
			Получатель = Строка(Документ.Отправитель);
		КонецЕсли;
		Результат = АИС_Рассылки.ЗарегистрироватьОтвет(
			Рассылка, Строка(Получатель), Документ, ТекущаяДатаСеанса(), Строка(Документ.Заголовок));
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписатьСвойствоСтрокой(ЗаписьJSON, "status", ?(Результат = Неопределено, "not_found", "ok"));
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Ответ.КодСостояния = 400;
		Ответ.УстановитьТелоИзСтроки("{""error"":""" + СтрЗаменить(ОписаниеОшибки(), """", "'") + """}");
	КонецПопытки;
	Возврат Ответ;
КонецФункции

// GET /hs/ais-sim/sessions
// Диагностика лицензионных сеансов (community/developer-лицензия 1С
// допускает не более 1 одновременного веб-сеанса — см.
// plans/2026-10-26-enterprise-simulator.md). Список активных сеансов
// информационной базы - помогает понять, какой сеанс держит лицензионный
// слот, когда веб-клиент был закрыт некорректно (например, Playwright
// browser.close() без штатного выхода) и не освободил его до истечения
// sessionMaxAge.
//
// Принудительного завершения чужого сеанса здесь нет: у объекта
// СеансИнформационнойБазы в файловом режиме нет метода типа "Завершить"
// (проверено эмпирически - "Object method not found") - судя по всему,
// это штатно только через Конфигуратор (Активные пользователи) или rac в
// клиент-серверном режиме, которого здесь нет. Поэтому корректный выход
// должен обеспечиваться со стороны симулятора (штатный Logout в веб-клиенте
// перед закрытием браузера), а не форсированным завершением с сервера.
//
// Имена свойств СеансИнформационнойБазы (НомерСеанса, НомерСоединения,
// ИмяКомпьютера, ИмяПриложения, НачалоСеанса) подтверждены эмпирически -
// подобраны перебором через диагностический вызов этого же эндпоинта,
// синтакс-помощник недоступен в этом окружении.
Функция ПолучитьСеансы_GET(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Попытка
		УстановитьПривилегированныйРежим(Истина);

		ТекущийНомер = ПолучитьТекущийСеансИнформационнойБазы().НомерСеанса;
		Сеансы = ПолучитьСеансыИнформационнойБазы();

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоМассива();
		Для Каждого Сеанс Из Сеансы Цикл
			ЗаписьJSON.ЗаписатьНачалоОбъекта();
			ЗаписьJSON.ЗаписатьИмяСвойства("НомерСеанса");
			ЗаписьJSON.ЗаписатьЗначение(Сеанс.НомерСеанса);
			ЗаписьJSON.ЗаписатьИмяСвойства("НомерСоединения");
			ЗаписьJSON.ЗаписатьЗначение(Сеанс.НомерСоединения);
			ЗаписьJSON.ЗаписатьИмяСвойства("Пользователь");
			ЗаписьJSON.ЗаписатьЗначение(Строка(Сеанс.Пользователь));
			ЗаписьJSON.ЗаписатьИмяСвойства("ИмяКомпьютера");
			ЗаписьJSON.ЗаписатьЗначение(Сеанс.ИмяКомпьютера);
			ЗаписьJSON.ЗаписатьИмяСвойства("ИмяПриложения");
			ЗаписьJSON.ЗаписатьЗначение(Сеанс.ИмяПриложения);
			ЗаписьJSON.ЗаписатьИмяСвойства("НачалоСеанса");
			ЗаписьJSON.ЗаписатьЗначение(Строка(Сеанс.НачалоСеанса));
			ЗаписьJSON.ЗаписатьИмяСвойства("Текущий");
			ЗаписьJSON.ЗаписатьЗначение(Сеанс.НомерСеанса = ТекущийНомер);
			ЗаписьJSON.ЗаписатьКонецОбъекта();
		КонецЦикла;
		ЗаписьJSON.ЗаписатьКонецМассива();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Текст = "Ошибка получения сеансов через АИС_Симулятор: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("АИС.Симулятор", УровеньЖурналаРегистрации.Ошибка,,, Текст);
		Ответ.УстановитьТелоИзСтроки(Текст);
		Ответ.КодСостояния = 400;
	КонецПопытки;

	Возврат Ответ;
КонецФункции

// GET /hs/ais-sim/employees
// Список сотрудников: логин, должность, руководитель. Нужен симулятору,
// чтобы запускать агента от имени каждого сотрудника, а не только CEO.
Функция ПолучитьСотрудников_GET(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Попытка
		УстановитьПривилегированныйРежим(Истина);

		Запрос2 = Новый Запрос;
		Запрос2.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Пользователи.Наименование КАК Логин,
		|	Пользователи.Недействителен КАК Недействителен,
		|	Сведения.Должность.Наименование КАК Должность,
		|	Сведения.Подразделение.Наименование КАК Подразделение,
		|	Пользователи.Подразделение.Наименование КАК ПодразделениеПользователя,
		|	Подчиненность.Руководитель.Наименование КАК Руководитель
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияОПользователяхДокументооборот КАК Сведения
		|		ПО Сведения.Пользователь = Пользователи.Ссылка
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПодчиненностьСотрудников КАК Подчиненность
		|		ПО Подчиненность.Подчиненный = Пользователи.Ссылка
		|ГДЕ
		|	Пользователи.ПометкаУдаления = ЛОЖЬ
		|	И Сведения.Должность <> НЕОПРЕДЕЛЕНО
		|УПОРЯДОЧИТЬ ПО
		|	Логин";
		Результат = Запрос2.Выполнить();
		Выборка = Результат.Выбрать();

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоМассива();
		Пока Выборка.Следующий() Цикл
			ЗаписьJSON.ЗаписатьНачалоОбъекта();
			ЗаписьJSON.ЗаписатьИмяСвойства("Логин");
			ЗаписьJSON.ЗаписатьЗначение(Выборка.Логин);
			ЗаписьJSON.ЗаписатьИмяСвойства("Недействителен");
			ЗаписьJSON.ЗаписатьЗначение(Выборка.Недействителен);
			ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(Выборка.Логин);
			ЗаписьJSON.ЗаписатьИмяСвойства("ПоказыватьВСпискеВыбора");
			ЗаписьJSON.ЗаписатьЗначение(
				?(ПользовательИБ = Неопределено, Ложь, ПользовательИБ.ПоказыватьВСпискеВыбора));
			ЗаписьJSON.ЗаписатьИмяСвойства("Должность");
			ЗаписьJSON.ЗаписатьЗначение(Выборка.Должность);
			ЗаписьJSON.ЗаписатьИмяСвойства("Подразделение");
			ЗаписьJSON.ЗаписатьЗначение(?(ЗначениеЗаполнено(Выборка.Подразделение), Выборка.Подразделение, ""));
			ЗаписьJSON.ЗаписатьИмяСвойства("ПодразделениеПользователя");
			ЗаписьJSON.ЗаписатьЗначение(?(ЗначениеЗаполнено(Выборка.ПодразделениеПользователя), Выборка.ПодразделениеПользователя, ""));
			ЗаписьJSON.ЗаписатьИмяСвойства("Руководитель");
			ЗаписьJSON.ЗаписатьЗначение(?(ЗначениеЗаполнено(Выборка.Руководитель), Выборка.Руководитель, ""));
			ЗаписьJSON.ЗаписатьКонецОбъекта();
		КонецЦикла;
		ЗаписьJSON.ЗаписатьКонецМассива();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Текст = "Ошибка получения сотрудников через АИС_Симулятор: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("АИС.Симулятор", УровеньЖурналаРегистрации.Ошибка,,, Текст);
		Ответ.УстановитьТелоИзСтроки(Текст);
		Ответ.КодСостояния = 400;
	КонецПопытки;

	Возврат Ответ;
КонецФункции

Функция УстановитьРуководителя_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Попытка
		ТелоКакСтрока = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоКакСтрока);
		Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();

		УстановитьПривилегированныйРежим(Истина);
		Подчиненный = Справочники.Пользователи.НайтиПоНаименованию(Данные.Подчиненный, Истина);
		Руководитель = Справочники.Пользователи.НайтиПоНаименованию(Данные.Руководитель, Истина);
		Если Не ЗначениеЗаполнено(Подчиненный) Или Не ЗначениеЗаполнено(Руководитель) Тогда
			ВызватьИсключение "Не найден подчиненный или руководитель.";
		КонецЕсли;

		АИС_ОбщегоНазначения.УстановитьРуководителя(Подчиненный, Руководитель);

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписьJSON.ЗаписатьИмяСвойства("Статус");
		ЗаписьJSON.ЗаписатьЗначение("сохранено");
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Текст = "Ошибка записи руководителя: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("АИС.Симулятор", УровеньЖурналаРегистрации.Ошибка,,, Текст);
		Ответ.УстановитьТелоИзСтроки(Текст);
		Ответ.КодСостояния = 400;
	КонецПопытки;

	Возврат Ответ;
КонецФункции

