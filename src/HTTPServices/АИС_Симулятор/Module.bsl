// POST /hs/ais-sim/sections/action
// Единая точка для агентского сценария разработки документа по разделам.
// Действие: СоздатьДокумент|Список|Назначить|Записать|Подраздел|Подтвердить|Собрать.
Функция РазделыДокументов_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Данные = ПрочитатьJSONИзЗапроса(Запрос);
		Действие = Строка(Данные.Действие);
		Текущий = ТекущийСотрудникСеанса();
		Результат = Новый Структура;

		Если Действие = "СоздатьДокумент" Тогда
			Шаблон = ШаблонПоУникальномуИдентификатору(Данные.Шаблон);
			Если Не ЗначениеЗаполнено(Шаблон) Тогда
				ВызватьИсключение "Шаблон не найден.";
			КонецЕсли;
			ЛогинАвтора = "";
			Данные.Свойство("Автор", ЛогинАвтора);
			Автор = АвторПоЛогину(Строка(ЛогинАвтора));
			Создано = АИС_РазделыДокументов.СоздатьДокументПоШаблону(
				Шаблон, Строка(Данные.Заголовок), Автор);
			Результат.Вставить("Документ", Строка(Создано.Документ.УникальныйИдентификатор()));
			Результат.Вставить("Разделы", РазделыВСтруктуры(АИС_РазделыДокументов.ПолучитьРазделы(Создано.Документ)));
		ИначеЕсли Действие = "СоздатьЧерновик" Тогда
			ЛогинАвтора = "";
			Данные.Свойство("Автор", ЛогинАвтора);
			Автор = АвторПоЛогину(Строка(ЛогинАвтора));
			Вид = "План";
			Данные.Свойство("Вид", Вид);
			Разделы = Новый Массив;
			Данные.Свойство("Разделы", Разделы);
			Создано = АИС_РазделыДокументов.СоздатьЧерновикСРазделами(
				Строка(Данные.Заголовок), Автор, Разделы, Строка(Вид));
			Результат.Вставить("Документ", Строка(Создано.Документ.УникальныйИдентификатор()));
			Результат.Вставить("Разделы", РазделыВСтруктуры(АИС_РазделыДокументов.ПолучитьРазделы(Создано.Документ)));
		ИначеЕсли Действие = "ИздатьРаспоряжение" Тогда
			Раздел = РазделПоУникальномуИдентификатору(Данные.Раздел);
			Если Не ЗначениеЗаполнено(Раздел) Тогда
				ВызватьИсключение "Раздел не найден.";
			КонецЕсли;
			Исполнитель = Справочники.Пользователи.НайтиПоНаименованию(Строка(Данные.Исполнитель), Истина);
			Если Не ЗначениеЗаполнено(Исполнитель) Тогда
				ВызватьИсключение "Исполнитель не найден.";
			КонецЕсли;
			ЛогинАвтора = "";
			Данные.Свойство("Автор", ЛогинАвтора);
			Автор = АвторПоЛогину(Строка(ЛогинАвтора));
			Заголовок = "";
			Данные.Свойство("Заголовок", Заголовок);
			Содержание = "";
			Данные.Свойство("Содержание", Содержание);
			Издано = АИС_РазделыДокументов.ИздатьРаспоряжениеПоРазделу(
				Раздел, Исполнитель, Автор, Строка(Заголовок), Строка(Содержание));
			Результат.Вставить("Раздел", Строка(Раздел.УникальныйИдентификатор()));
			Результат.Вставить("Распоряжение",
				Строка(Издано.Распоряжение.УникальныйИдентификатор()));
			Результат.Вставить("Задача",
				?(ЗначениеЗаполнено(Издано.Задача),
					Строка(Издано.Задача.УникальныйИдентификатор()), ""));
		ИначеЕсли Действие = "Список" Тогда
			Документ = ДокументПоУникальномуИдентификатору(Данные.Документ);
			Если Не ЗначениеЗаполнено(Документ) Тогда
				ВызватьИсключение "Документ не найден.";
			КонецЕсли;
			Результат.Вставить("Документ", Строка(Документ.УникальныйИдентификатор()));
			Результат.Вставить("Разделы", РазделыВСтруктуры(АИС_РазделыДокументов.ПолучитьРазделы(Документ)));
		ИначеЕсли Действие = "Назначить" Тогда
			Раздел = РазделПоУникальномуИдентификатору(Данные.Раздел);
			Исполнитель = Справочники.Пользователи.НайтиПоНаименованию(Строка(Данные.Исполнитель), Истина);
			Задача = АИС_РазделыДокументов.НазначитьРаздел(Раздел, Исполнитель, Текущий);
			Результат.Вставить("Раздел", Строка(Раздел.УникальныйИдентификатор()));
			Результат.Вставить("Задача", ?(ЗначениеЗаполнено(Задача), Строка(Задача.УникальныйИдентификатор()), ""));
		ИначеЕсли Действие = "Записать" Тогда
			Раздел = РазделПоУникальномуИдентификатору(Данные.Раздел);
			Отправить = Ложь;
			Данные.Свойство("Отправить", Отправить);
			АИС_РазделыДокументов.ЗаписатьСодержаниеРаздела(
				Раздел, Строка(Данные.Содержание), Отправить, Текущий);
			Результат.Вставить("Раздел", Строка(Раздел.УникальныйИдентификатор()));
		ИначеЕсли Действие = "Подраздел" Тогда
			Родитель = РазделПоУникальномуИдентификатору(Данные.Родитель);
			ИмяИсполнителя = "";
			Данные.Свойство("Исполнитель", ИмяИсполнителя);
			Исполнитель = Неопределено;
			Если Не ПустаяСтрока(Строка(ИмяИсполнителя)) Тогда
				Исполнитель = Справочники.Пользователи.НайтиПоНаименованию(
					Строка(ИмяИсполнителя), Истина);
			КонецЕсли;
			Подраздел = АИС_РазделыДокументов.СоздатьПодраздел(
				Родитель, Строка(Данные.Заголовок), Исполнитель, Текущий);
			Результат.Вставить("Раздел", Строка(Подраздел.УникальныйИдентификатор()));
		ИначеЕсли Действие = "Подтвердить" Тогда
			Раздел = РазделПоУникальномуИдентификатору(Данные.Раздел);
			АИС_РазделыДокументов.ПодтвердитьРаздел(Раздел, Текущий);
			Результат.Вставить("Раздел", Строка(Раздел.УникальныйИдентификатор()));
		ИначеЕсли Действие = "Собрать" Тогда
			Документ = ДокументПоУникальномуИдентификатору(Данные.Документ);
			Утверждающий = Справочники.Пользователи.НайтиПоНаименованию(Строка(Данные.Утверждающий), Истина);
			Текст = АИС_РазделыДокументов.СобратьДокумент(Документ, Утверждающий, Текущий);
			Результат.Вставить("Документ", Строка(Документ.УникальныйИдентификатор()));
			Результат.Вставить("Содержание", Текст);
		ИначеЕсли Действие = "ЗамечанияСоздать" Тогда
			ДокументИд = "";
			Данные.Свойство("Документ", ДокументИд);
			Документ = ДокументПоУникальномуИдентификатору(Строка(ДокументИд));
			Если Не ЗначениеЗаполнено(Документ) Тогда
				ВызватьИсключение "Документ не найден.";
			КонецЕсли;
			ЛогинВладельца = "";
			Данные.Свойство("Владелец", ЛогинВладельца);
			Владелец = Неопределено;
			Если Не ПустаяСтрока(Строка(ЛогинВладельца)) Тогда
				Владелец = Справочники.Пользователи.НайтиПоНаименованию(
					Строка(ЛогинВладельца), Истина);
			КонецЕсли;
			Раунд = 1;
			Данные.Свойство("Раунд", Раунд);
			Замечания = Неопределено;
			Данные.Свойство("Замечания", Замечания);
			Если ТипЗнч(Замечания) <> Тип("Массив") Тогда
				ВызватьИсключение "Не указан массив замечаний.";
			КонецЕсли;
			Созданные = АИС_ЗамечанияДокументов.СоздатьЗамечания(
				Документ, Замечания, Владелец, Текущий, Раунд);
			Результат.Вставить("Замечания", ЗамечанияВСтруктуры(Созданные));
		ИначеЕсли Действие = "ЗамечанияСписок" Тогда
			ДокументИд = "";
			Данные.Свойство("Документ", ДокументИд);
			Документ = Неопределено;
			Если Не ПустаяСтрока(Строка(ДокументИд)) Тогда
				Документ = ДокументПоУникальномуИдентификатору(Строка(ДокументИд));
			КонецЕсли;
			ЛогинВладельца = "";
			Данные.Свойство("Владелец", ЛогинВладельца);
			Владелец = Неопределено;
			Если Не ПустаяСтрока(Строка(ЛогинВладельца)) Тогда
				Владелец = Справочники.Пользователи.НайтиПоНаименованию(
					Строка(ЛогинВладельца), Истина);
			КонецЕсли;
			ИмяСтатуса = "";
			Данные.Свойство("Статус", ИмяСтатуса);
			Статус = Неопределено;
			Если Не ПустаяСтрока(Строка(ИмяСтатуса)) Тогда
				Статус = СтатусЗамечанияПоИмени(Строка(ИмяСтатуса));
				Если Статус = Неопределено Тогда
					ВызватьИсключение "Неизвестный статус замечания: " + Строка(ИмяСтатуса);
				КонецЕсли;
			КонецЕсли;
			Результат.Вставить("Замечания",
				АИС_ЗамечанияДокументов.СписокЗамечаний(Документ, Владелец, Статус));
		ИначеЕсли Действие = "ЗамечаниеОбновить" Тогда
			ИдЗамечания = "";
			Данные.Свойство("Замечание", ИдЗамечания);
			Замечание = ЗамечаниеПоУникальномуИдентификатору(Строка(ИдЗамечания));
			Если Не ЗначениеЗаполнено(Замечание) Тогда
				ВызватьИсключение "Замечание не найдено.";
			КонецЕсли;
			ИмяСтатуса = "";
			Данные.Свойство("Статус", ИмяСтатуса);
			Статус = Неопределено;
			Если Не ПустаяСтрока(Строка(ИмяСтатуса)) Тогда
				Статус = СтатусЗамечанияПоИмени(Строка(ИмяСтатуса));
				Если Статус = Неопределено Тогда
					ВызватьИсключение "Неизвестный статус замечания: " + Строка(ИмяСтатуса);
				КонецЕсли;
			КонецЕсли;
			ЛогинВладельца = "";
			Данные.Свойство("Владелец", ЛогинВладельца);
			Владелец = Неопределено;
			Если Не ПустаяСтрока(Строка(ЛогинВладельца)) Тогда
				Владелец = Справочники.Пользователи.НайтиПоНаименованию(
					Строка(ЛогинВладельца), Истина);
			КонецЕсли;
			Решение = Неопределено;
			Если Данные.Свойство("Решение") Тогда
				Решение = Строка(Данные.Решение);
			КонецЕсли;
			Результат.Вставить("Замечание",
				АИС_ЗамечанияДокументов.ОбновитьЗамечание(
					Замечание, Статус, Владелец, Решение));
		ИначеЕсли Действие = "ЗамечанияСводка" Тогда
			ДокументИд = "";
			Данные.Свойство("Документ", ДокументИд);
			Документ = ДокументПоУникальномуИдентификатору(Строка(ДокументИд));
			Если Не ЗначениеЗаполнено(Документ) Тогда
				ВызватьИсключение "Документ не найден.";
			КонецЕсли;
			Результат.Вставить("Сводка",
				АИС_ЗамечанияДокументов.СводкаПоДокументу(Документ));
		Иначе
			ВызватьИсключение "Неизвестное действие: " + Действие;
		КонецЕсли;

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьОбъектJSON(ЗаписьJSON, Результат);
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Ответ.КодСостояния = 400;
		Ответ.УстановитьТелоИзСтроки("Ошибка работы с разделами: " + ОписаниеОшибки());
	КонецПопытки;
	Возврат Ответ;
КонецФункции


Функция ШаблонПоУникальномуИдентификатору(Ид)
	Если ПустаяСтрока(Ид) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого ИмяСправочника Из СтрРазделить("ШаблоныВнутреннихДокументов,ШаблоныВходящихДокументов,ШаблоныИсходящихДокументов", ",") Цикл
		Попытка
			Ссылка = Справочники[ИмяСправочника].ПолучитьСсылку(Новый УникальныйИдентификатор(Ид));
		Исключение
			Продолжить;
		КонецПопытки;
		Если Ссылка.ПолучитьОбъект() <> Неопределено Тогда
			Возврат Ссылка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция РазделПоУникальномуИдентификатору(Ид)
	Если ПустаяСтрока(Ид) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Ссылка = Справочники.АИС_РазделыДокумента.ПолучитьСсылку(Новый УникальныйИдентификатор(Ид));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если Ссылка.ПолучитьОбъект() = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Ссылка;
КонецФункции

Функция СтатусЗамечанияПоИмени(Имя)
	Если Имя = "Открыто" Тогда
		Возврат Перечисления.АИС_СтатусыЗамечаний.Открыто;
	ИначеЕсли Имя = "ВРаботе" Тогда
		Возврат Перечисления.АИС_СтатусыЗамечаний.ВРаботе;
	ИначеЕсли Имя = "Исправлено" Тогда
		Возврат Перечисления.АИС_СтатусыЗамечаний.Исправлено;
	ИначеЕсли Имя = "Принято" Тогда
		Возврат Перечисления.АИС_СтатусыЗамечаний.Принято;
	ИначеЕсли Имя = "Отклонено" Тогда
		Возврат Перечисления.АИС_СтатусыЗамечаний.Отклонено;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
КонецФункции

Функция ЗамечаниеПоУникальномуИдентификатору(Ид)
	Если ПустаяСтрока(Ид) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Ссылка = Справочники.АИС_Замечания.ПолучитьСсылку(
			Новый УникальныйИдентификатор(Ид));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если Ссылка.ПолучитьОбъект() = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Ссылка;
КонецФункции

Функция ЗамечанияВСтруктуры(Замечания)
	Результат = Новый Массив;
	Для Каждого Замечание Из Замечания Цикл
		Структура = АИС_ЗамечанияДокументов.ЗамечаниеВСтруктуру(Замечание);
		Если Структура <> Неопределено Тогда
			Результат.Добавить(Структура);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция РазделыВСтруктуры(Разделы)
	Результат = Новый Массив;
	Для Каждого Раздел Из Разделы Цикл
		Строка = Новый Структура;
		Строка.Вставить("Раздел", Строка(Раздел.Ссылка.УникальныйИдентификатор()));
		Строка.Вставить("Родитель", ?(ЗначениеЗаполнено(Раздел.Родитель), Строка(Раздел.Родитель.УникальныйИдентификатор()), ""));
		Строка.Вставить("Заголовок", Раздел.Заголовок);
		Строка.Вставить("Маркер", Раздел.Раздел);
		Строка.Вставить("Порядок", Раздел.Порядок);
		Строка.Вставить("Обязательный", Раздел.Обязательный);
		Строка.Вставить("Содержание", Раздел.Содержание);
		Строка.Вставить("Ответственный", Строка(Раздел.Ответственный));
		Строка.Вставить("Задача", ?(ЗначениеЗаполнено(Раздел.Задача), Строка(Раздел.Задача.УникальныйИдентификатор()), ""));
		Строка.Вставить("Распоряжение", ?(ЗначениеЗаполнено(Раздел.Распоряжение), Строка(Раздел.Распоряжение.УникальныйИдентификатор()), ""));
		Строка.Вставить("Статус", Строка(Раздел.Статус));
		Результат.Добавить(Строка);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Процедура ЗаписатьСвойствоЗначениеJSON(ЗаписьJSON, ИмяСвойства, Значение)
	ЗаписьJSON.ЗаписатьИмяСвойства(ИмяСвойства);
	Если ТипЗнч(Значение) = Тип("Структура")
		Или ТипЗнч(Значение) = Тип("Массив") Тогда
		ЗаписьОбъектJSON(ЗаписьJSON, Значение);
	Иначе
		ЗаписьJSON.ЗаписатьЗначение(Значение);
	КонецЕсли;
КонецПроцедуры

Процедура ЗаписьОбъектJSON(ЗаписьJSON, Значение)
	Если ТипЗнч(Значение) = Тип("Структура") Тогда
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		Для Каждого Элемент Из Значение Цикл
			ЗаписатьСвойствоЗначениеJSON(ЗаписьJSON, Элемент.Ключ, Элемент.Значение);
		КонецЦикла;
		ЗаписьJSON.ЗаписатьКонецОбъекта();
	ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
		ЗаписьJSON.ЗаписатьНачалоМассива();
		Для Каждого Элемент Из Значение Цикл
			ЗаписьОбъектJSON(ЗаписьJSON, Элемент);
		КонецЦикла;
		ЗаписьJSON.ЗаписатьКонецМассива();
	Иначе
		ЗаписьJSON.ЗаписатьЗначение(Значение);
	КонецЕсли;
КонецПроцедуры

// GET /hs/ais-sim/checklists?purpose=РазработкаДолжностнойИнструкции
// Публичный справочник чек-листов с пунктами. ACL документов не применяется.
Функция ПолучитьЧекЛисты_GET(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Назначение = "РазработкаДолжностнойИнструкции";
		Параметр = Запрос.ПараметрыЗапроса.Получить("purpose");
		Если Не ПустаяСтрока(Параметр) Тогда
			Назначение = СокрЛП(Строка(Параметр));
		КонецЕсли;

		ЗапросЧекЛистов = Новый Запрос;
		ЗапросЧекЛистов.УстановитьПараметр("Назначение", Назначение);
		ЗапросЧекЛистов.Текст =
		"ВЫБРАТЬ
		|	ЧекЛисты.Ссылка КАК Ссылка,
		|	ЧекЛисты.Наименование КАК Наименование,
		|	ЧекЛисты.Назначение КАК Назначение,
		|	ЧекЛисты.Версия КАК Версия,
		|	ЧекЛисты.Содержание КАК Содержание
		|ИЗ
		|	Справочник.АИС_ЧекЛисты КАК ЧекЛисты
		|ГДЕ
		|	ЧекЛисты.Активность
		|	И ЧекЛисты.Назначение = &Назначение
		|УПОРЯДОЧИТЬ ПО
		|	ЧекЛисты.Наименование";
		Выборка = ЗапросЧекЛистов.Выполнить().Выбрать();

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоМассива();
		Пока Выборка.Следующий() Цикл
			ЗаписьJSON.ЗаписатьНачалоОбъекта();
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "id", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "name", Выборка.Наименование);
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "purpose", Выборка.Назначение);
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "version", Выборка.Версия);
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "content", Выборка.Содержание);

			ЗапросПунктов = Новый Запрос;
			ЗапросПунктов.УстановитьПараметр("Владелец", Выборка.Ссылка);
			ЗапросПунктов.Текст =
			"ВЫБРАТЬ
			|	Пункты.Порядок КАК Порядок,
			|	Пункты.Раздел КАК Раздел,
			|	Пункты.Текст КАК Текст,
			|	Пункты.Обязательный КАК Обязательный
			|ИЗ
			|	Справочник.АИС_ПунктыЧекЛиста КАК Пункты
			|ГДЕ
			|	Пункты.Владелец = &Владелец
			|	И Пункты.Активность
			|	И НЕ Пункты.ПометкаУдаления
			|УПОРЯДОЧИТЬ ПО
			|	Пункты.Порядок";
			ВыборкаПунктов = ЗапросПунктов.Выполнить().Выбрать();
			ЗаписьJSON.ЗаписатьИмяСвойства("items");
			ЗаписьJSON.ЗаписатьНачалоМассива();
			Пока ВыборкаПунктов.Следующий() Цикл
				ЗаписьJSON.ЗаписатьНачалоОбъекта();
				ЗаписьJSON.ЗаписатьИмяСвойства("order");
				ЗаписьJSON.ЗаписатьЗначение(ВыборкаПунктов.Порядок);
				ЗаписатьСвойствоСтрокой(ЗаписьJSON, "section", ВыборкаПунктов.Раздел);
				ЗаписатьСвойствоСтрокой(ЗаписьJSON, "text", ВыборкаПунктов.Текст);
				ЗаписьJSON.ЗаписатьИмяСвойства("required");
				ЗаписьJSON.ЗаписатьЗначение(ВыборкаПунктов.Обязательный);
				ЗаписьJSON.ЗаписатьКонецОбъекта();
			КонецЦикла;
			ЗаписьJSON.ЗаписатьКонецМассива();
			ЗаписьJSON.ЗаписатьКонецОбъекта();
		КонецЦикла;
		ЗаписьJSON.ЗаписатьКонецМассива();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Ответ.КодСостояния = 500;
		Ответ.УстановитьТелоИзСтроки("{""error"":""" + СтрЗаменить(ОписаниеОшибки(), """", "'") + """}");
	КонецПопытки;
	Возврат Ответ;
КонецФункции

// POST /hs/ais-sim/checklists
// Тело: {"Наименование","Назначение","Версия","Содержание",
//        "Пункты":[{"Порядок","Раздел","Текст","Обязательный"}]}
// Идемпотентный upsert чек-листа и его пунктов.
Функция СохранитьЧекЛист_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Если Не ЭтоПривилегированныйПользователь() Тогда
			Ответ.КодСостояния = 403;
			Ответ.УстановитьТелоИзСтроки("Недостаточно прав для изменения чек-листов");
			Возврат Ответ;
		КонецЕсли;
		Данные = ПрочитатьJSONИзЗапроса(Запрос);
		Наименование = СокрЛП(Строка(Данные.Наименование));
		Если ПустаяСтрока(Наименование) Тогда
			ВызватьИсключение "Не указано наименование чек-листа";
		КонецЕсли;
		Назначение = "РазработкаДолжностнойИнструкции";
		Данные.Свойство("Назначение", Назначение);
		Версия = "1";
		Данные.Свойство("Версия", Версия);
		Содержание = "";
		Данные.Свойство("Содержание", Содержание);

		Объект = АИС_ОбщегоНазначения.НайтиИлиСоздатьЭлемент(
			Справочники.АИС_ЧекЛисты, Наименование);
		Объект.Наименование = Наименование;
		Объект.Назначение = СокрЛП(Строка(Назначение));
		Объект.Версия = СокрЛП(Строка(Версия));
		Объект.Содержание = Строка(Содержание);
		Объект.Активность = Истина;
		Объект.Записать();

		ЗапросСтарых = Новый Запрос;
		ЗапросСтарых.УстановитьПараметр("Владелец", Объект.Ссылка);
		ЗапросСтарых.Текст =
		"ВЫБРАТЬ
		|	Пункты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.АИС_ПунктыЧекЛиста КАК Пункты
		|ГДЕ
		|	Пункты.Владелец = &Владелец";
		ВыборкаСтарых = ЗапросСтарых.Выполнить().Выбрать();
		Пока ВыборкаСтарых.Следующий() Цикл
			СтарыйОбъект = ВыборкаСтарых.Ссылка.ПолучитьОбъект();
			Если СтарыйОбъект <> Неопределено Тогда
				СтарыйОбъект.Удалить();
			КонецЕсли;
		КонецЦикла;

		Пункты = Новый Массив;
		Данные.Свойство("Пункты", Пункты);
		Если ТипЗнч(Пункты) <> Тип("Массив") Тогда
			Пункты = Новый Массив;
		КонецЕсли;
		Номер = 0;
		Для Каждого Пункт Из Пункты Цикл
			Номер = Номер + 1;
			НовыйПункт = Справочники.АИС_ПунктыЧекЛиста.СоздатьЭлемент();
			НовыйПункт.Владелец = Объект.Ссылка;
			Порядок = Номер;
			Пункт.Свойство("Порядок", Порядок);
			Если ТипЗнч(Порядок) <> Тип("Число") Тогда
				Порядок = Номер;
			КонецЕсли;
			Раздел = "";
			Пункт.Свойство("Раздел", Раздел);
			Текст = "";
			Пункт.Свойство("Текст", Текст);
			Обязательный = Истина;
			Пункт.Свойство("Обязательный", Обязательный);
			НовыйПункт.Наименование = "Пункт " + Формат(Порядок, "ЧГ=0");
			НовыйПункт.Порядок = Порядок;
			НовыйПункт.Раздел = СокрЛП(Строка(Раздел));
			НовыйПункт.Текст = Строка(Текст);
			НовыйПункт.Обязательный = (Обязательный = Истина);
			НовыйПункт.Активность = Истина;
			НовыйПункт.Записать();
		КонецЦикла;

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписатьСвойствоСтрокой(ЗаписьJSON, "status", "ok");
		ЗаписатьСвойствоСтрокой(
			ЗаписьJSON, "id", Строка(Объект.Ссылка.УникальныйИдентификатор()));
		ЗаписьJSON.ЗаписатьИмяСвойства("items");
		ЗаписьJSON.ЗаписатьЗначение(Пункты.Количество());
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Ответ.КодСостояния = 400;
		Ответ.УстановитьТелоИзСтроки("{""error"":""" + СтрЗаменить(ОписаниеОшибки(), """", "'") + """}");
	КонецПопытки;
	Возврат Ответ;
КонецФункции

// GET /hs/ais-sim/job-descriptions?position_id=<uuid>|position=<name>
// Действующая должностная инструкция по должности (одна на должность).
Функция ПолучитьДолжностнуюИнструкцию_GET(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Ид = Запрос.ПараметрыЗапроса.Получить("position_id");
		Имя = Запрос.ПараметрыЗапроса.Получить("position");
		Если Не ПустаяСтрока(Ид) Тогда
			Должность = Справочники.Должности.ПолучитьСсылку(
				Новый УникальныйИдентификатор(Строка(Ид)));
		ИначеЕсли Не ПустаяСтрока(Имя) Тогда
			Должность = Справочники.Должности.НайтиПоНаименованию(Строка(Имя), Истина);
		Иначе
			Ответ.КодСостояния = 400;
			Ответ.УстановитьТелоИзСтроки("Укажите position_id или position");
			Возврат Ответ;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Должность) Тогда
			Ответ.КодСостояния = 404;
			Ответ.УстановитьТелоИзСтроки("Должность не найдена");
			Возврат Ответ;
		КонецЕсли;

		ЗапросИнструкций = Новый Запрос;
		ЗапросИнструкций.УстановитьПараметр("Должность", Должность);
		ЗапросИнструкций.Текст =
		"ВЫБРАТЬ
		|	Документы.Ссылка КАК Ссылка,
		|	Документы.Заголовок КАК Заголовок,
		|	Документы.Содержание КАК Содержание,
		|	Документы.АИС_ЧекЛист КАК ЧекЛист,
		|	Документы.АИС_ВерсияЧекЛиста КАК ВерсияЧекЛиста
		|ИЗ
		|	Справочник.ВнутренниеДокументы КАК Документы
		|ГДЕ
		|	Документы.ВидДокумента.Наименование = ""Должностная инструкция""
		|	И Документы.АИС_Должность = &Должность
		|	И НЕ Документы.ПометкаУдаления
		|	И НЕ Документы.НеДействует
		|УПОРЯДОЧИТЬ ПО
		|	Документы.ДатаСоздания УБЫВ";
		Выборка = ЗапросИнструкций.Выполнить().Выбрать();
		Количество = 0;
		Идентификаторы = "";
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		Пока Выборка.Следующий() Цикл
			Количество = Количество + 1;
			Идентификаторы = Идентификаторы
				+ ?(ПустаяСтрока(Идентификаторы), "", ", ")
				+ Строка(Выборка.Ссылка.УникальныйИдентификатор());
			Если Количество = 1 Тогда
				ЗаписатьСвойствоСтрокой(
					ЗаписьJSON, "id", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
				ЗаписатьСвойствоСтрокой(ЗаписьJSON, "title", Выборка.Заголовок);
				ЗаписатьСвойствоСтрокой(ЗаписьJSON, "content", Выборка.Содержание);
				ЗаписатьСвойствоСтрокой(
					ЗаписьJSON, "checklist_id",
					?(ЗначениеЗаполнено(Выборка.ЧекЛист),
						Строка(Выборка.ЧекЛист.УникальныйИдентификатор()), ""));
				ЗаписатьСвойствоСтрокой(ЗаписьJSON, "checklist_version", Выборка.ВерсияЧекЛиста);
			КонецЕсли;
		КонецЦикла;
		Если Количество = 0 Тогда
			Ответ.КодСостояния = 404;
			Ответ.УстановитьТелоИзСтроки("Должностная инструкция не найдена");
			Возврат Ответ;
		ИначеЕсли Количество > 1 Тогда
			Ответ.КодСостояния = 409;
			ЗаписьJSON.ЗаписатьИмяСвойства("error");
			ЗаписьJSON.ЗаписатьЗначение("duplicate_job_description");
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "ids", Идентификаторы);
		Иначе
			ЗаписьJSON.ЗаписатьИмяСвойства("count");
			ЗаписьJSON.ЗаписатьЗначение(Количество);
		КонецЕсли;
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Ответ.КодСостояния = 500;
		Ответ.УстановитьТелоИзСтроки("{""error"":""" + СтрЗаменить(ОписаниеОшибки(), """", "'") + """}");
	КонецПопытки;
	Возврат Ответ;
КонецФункции

// GET /hs/ais-sim/job-duties
// Публичные обязанности всех ДЛ; ACL документов не применяется.
Функция ПолучитьДолжностныеОбязанностиПублично_GET(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Попытка
		УстановитьПривилегированныйРежим(Истина);

		ЗапросОбязанностей = Новый Запрос;
		ЗапросОбязанностей.Текст =
		"ВЫБРАТЬ
		|	Обязанности.Должность КАК Должность,
		|	Обязанности.Текст КАК Текст,
		|	Обязанности.Активность КАК Активность
		|ИЗ
		|	Справочник.АИС_ДолжностныеОбязанности КАК Обязанности
		|ГДЕ
		|	Обязанности.Активность
		|УПОРЯДОЧИТЬ ПО
		|	Должность, Обязанности.Наименование";
		Выборка = ЗапросОбязанностей.Выполнить().Выбрать();
		ПоДолжностям = Новый Соответствие;
		Пока Выборка.Следующий() Цикл
			Ключ = Строка(Выборка.Должность);
			Список = ПоДолжностям.Получить(Ключ);
			Если Список = Неопределено Тогда
				Список = Новый Массив;
				ПоДолжностям.Вставить(Ключ, Список);
			КонецЕсли;
			Список.Добавить(Выборка.Текст);
		КонецЦикла;

		ЗапросСотрудников = Новый Запрос;
		ЗапросСотрудников.Текст =
		"ВЫБРАТЬ
		|	Пользователи.Наименование КАК Логин,
		|	Сведения.Должность.Наименование КАК Должность,
		|	Сведения.Подразделение.Наименование КАК Подразделение,
		|	Подчиненность.Руководитель.Наименование КАК Руководитель
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СведенияОПользователяхДокументооборот КАК Сведения
		|		ПО Сведения.Пользователь = Пользователи.Ссылка
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПодчиненностьСотрудников КАК Подчиненность
		|		ПО Подчиненность.Подчиненный = Пользователи.Ссылка
		|ГДЕ
		|	НЕ Пользователи.ПометкаУдаления
		|	И Сведения.Должность <> НЕОПРЕДЕЛЕНО
		|УПОРЯДОЧИТЬ ПО
		|	Логин";
		ВыборкаСотрудников = ЗапросСотрудников.Выполнить().Выбрать();

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоМассива();
		Пока ВыборкаСотрудников.Следующий() Цикл
			ЗаписьJSON.ЗаписатьНачалоОбъекта();
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "login", ВыборкаСотрудников.Логин);
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "position", ВыборкаСотрудников.Должность);
			ЗаписатьСвойствоСтрокой(
				ЗаписьJSON, "department", ВыборкаСотрудников.Подразделение);
			ЗаписатьСвойствоСтрокой(
				ЗаписьJSON, "manager", ВыборкаСотрудников.Руководитель);
			ЗаписьJSON.ЗаписатьИмяСвойства("duties");
			ЗаписьJSON.ЗаписатьНачалоМассива();
			Список = ПоДолжностям.Получить(Строка(ВыборкаСотрудников.Должность));
			Если Список <> Неопределено Тогда
				Для Каждого Текст Из Список Цикл
					ЗаписьJSON.ЗаписатьЗначение(Текст);
				КонецЦикла;
			КонецЕсли;
			ЗаписьJSON.ЗаписатьКонецМассива();
			ЗаписьJSON.ЗаписатьКонецОбъекта();
		КонецЦикла;
		ЗаписьJSON.ЗаписатьКонецМассива();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Ответ.КодСостояния = 500;
		Ответ.УстановитьТелоИзСтроки("{""error"":""" + СтрЗаменить(ОписаниеОшибки(), """", "'") + """}");
	КонецПопытки;
	Возврат Ответ;
КонецФункции

// POST /hs/ais-sim/examples/search
// Тело: {"Запрос":"...", "ВидДокумента":"...", "Лимит":5}
// RAG-поиск образцов; при пустом результате агент вправе искать в интернете.
Функция ПоискОбразцов_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Данные = ПрочитатьJSONИзЗапроса(Запрос);
		ТекстЗапроса = "";
		Данные.Свойство("Запрос", ТекстЗапроса);
		ТекстЗапроса = СокрЛП(Строка(ТекстЗапроса));
		Если ПустаяСтрока(ТекстЗапроса) Тогда
			ВызватьИсключение "Пустой запрос поиска образцов";
		КонецЕсли;
		Лимит = 5;
		Данные.Свойство("Лимит", Лимит);
		Если ТипЗнч(Лимит) <> Тип("Число") ИЛИ Лимит <= 0 Тогда
			Лимит = 5;
		КонецЕсли;

		РезультатПоиска = АИС_ИнтеграцияСRAG.Поиск(
			ТекстЗапроса, Неопределено, Лимит, Неопределено, "examples");

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписьJSON.ЗаписатьИмяСвойства("status");
		ЗаписьJSON.ЗаписатьЗначение(?(РезультатПоиска.Найден, "ok", "empty"));
		ЗаписьJSON.ЗаписатьИмяСвойства("results");
		ЗаписьJSON.ЗаписатьНачалоМассива();
		Для Каждого СтрокаРезультата Из РезультатПоиска.Результаты Цикл
			ИД = Строка(СтрокаРезультата.ИсточникID);
			Текст = "";
			ВидДокумента = "";
			Заголовок = СтрокаРезультата.Заголовок;
			Ссылка = Неопределено;
			Попытка
				Ссылка = Справочники.АИС_ОбразцыДокументов.ПолучитьСсылку(
					Новый УникальныйИдентификатор(ИД));
			Исключение
				Ссылка = Неопределено;
			КонецПопытки;
			Если ЗначениеЗаполнено(Ссылка) Тогда
				Образец = Ссылка.ПолучитьОбъект();
				Если Образец <> Неопределено Тогда
					Текст = Образец.Содержание;
					Если ЗначениеЗаполнено(Образец.ВидДокумента) Тогда
						ВидДокумента = Строка(Образец.ВидДокумента);
					КонецЕсли;
					Если Не ПустаяСтрока(Образец.Наименование) Тогда
						Заголовок = Образец.Наименование;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			Если ПустаяСтрока(Текст) Тогда
				Части = Новый Массив;
				Для Каждого Фрагмент Из СтрокаРезультата.Фрагменты Цикл
					Если Не ПустаяСтрока(Фрагмент.Текст) Тогда
						Части.Добавить(Фрагмент.Текст);
					КонецЕсли;
				КонецЦикла;
				Текст = СтрСоединить(Части, Символы.ПС + Символы.ПС);
			КонецЕсли;

			ЗаписьJSON.ЗаписатьНачалоОбъекта();
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "example_id", ИД);
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "title", Заголовок);
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "document_kind", ВидДокумента);
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "text", Текст);
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "source_type", "rag");
			ЗаписьJSON.ЗаписатьИмяСвойства("score");
			ЗаписьJSON.ЗаписатьЗначение(СтрокаРезультата.Score);
			ЗаписьJSON.ЗаписатьИмяСвойства("questions");
			ЗаписатьВопросыОбразцаJSON(ЗаписьJSON, Ссылка);
			ЗаписьJSON.ЗаписатьКонецОбъекта();
		КонецЦикла;
		ЗаписьJSON.ЗаписатьКонецМассива();
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Ответ.КодСостояния = 400;
		Ответ.УстановитьТелоИзСтроки("{""error"":""" + СтрЗаменить(ОписаниеОшибки(), """", "'") + """}");
	КонецПопытки;
	Возврат Ответ;
КонецФункции

Процедура ЗаписатьВопросыОбразцаJSON(ЗаписьJSON, Ссылка)
	ЗаписьJSON.ЗаписатьНачалоМассива();
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		ЗаписьJSON.ЗаписатьКонецМассива();
		Возврат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Владелец", Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Вопросы.Ссылка КАК Ссылка,
	|	Вопросы.КодВопроса КАК КодВопроса,
	|	Вопросы.ТекстВопроса КАК Текст,
	|	Вопросы.ТипОтвета КАК ТипОтвета,
	|	Вопросы.Обязательный КАК Обязательный,
	|	Вопросы.Подсказка КАК Подсказка,
	|	Вопросы.ОтветПоУмолчанию КАК ОтветПоУмолчанию,
	|	Вопросы.РазрешитьСвободныйВвод КАК РазрешитьСвободныйВвод
	|ИЗ
	|	Справочник.АИС_ВопросыПриСозданииДокументаПоОбразцу КАК Вопросы
	|ГДЕ
	|	Вопросы.Владелец = &Владелец
	|	И Вопросы.Активность
	|	И НЕ Вопросы.ПометкаУдаления
	|УПОРЯДОЧИТЬ ПО
	|	Вопросы.Порядок";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписатьСвойствоСтрокой(
			ЗаписьJSON, "question_id", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
		ЗаписатьСвойствоСтрокой(ЗаписьJSON, "code", Выборка.КодВопроса);
		ЗаписатьСвойствоСтрокой(ЗаписьJSON, "text", Выборка.Текст);
		ЗаписатьСвойствоСтрокой(ЗаписьJSON, "type", Выборка.ТипОтвета);
		ЗаписатьСвойствоСтрокой(ЗаписьJSON, "hint", Выборка.Подсказка);
		ЗаписатьСвойствоСтрокой(ЗаписьJSON, "default", Выборка.ОтветПоУмолчанию);
		ЗаписьJSON.ЗаписатьИмяСвойства("required");
		ЗаписьJSON.ЗаписатьЗначение(Выборка.Обязательный);
		ЗаписьJSON.ЗаписатьИмяСвойства("allow_free_text");
		ЗаписьJSON.ЗаписатьЗначение(Выборка.РазрешитьСвободныйВвод);
		ЗаписьJSON.ЗаписатьКонецОбъекта();
	КонецЦикла;
	ЗаписьJSON.ЗаписатьКонецМассива();
КонецПроцедуры

// POST /hs/ais-sim/examples
// Сохраняет внешний образец и сгенерированные вопросы до вопросов пользователю.
Функция СохранитьВнешнийОбразец_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Данные = ПрочитатьJSONИзЗапроса(Запрос);
		URL = "";
		Данные.Свойство("URL", URL);
		Заголовок = "";
		Данные.Свойство("Заголовок", Заголовок);
		Текст = "";
		Данные.Свойство("Текст", Текст);
		Хеш = "";
		Данные.Свойство("Хеш", Хеш);
		Модель = "";
		Данные.Свойство("Модель", Модель);
		ВидДокумента = Неопределено;
		ИмяВида = "";
		Данные.Свойство("ВидДокумента", ИмяВида);
		Если Не ПустаяСтрока(ИмяВида) Тогда
			ВидДокумента = Справочники.ВидыВнутреннихДокументов.НайтиПоНаименованию(
				Строка(ИмяВида), Истина);
		КонецЕсли;

		Образец = Неопределено;
		Если Не ПустаяСтрока(URL) Тогда
			ЗапросСуществующего = Новый Запрос;
			ЗапросСуществующего.УстановитьПараметр("URL", URL);
			ЗапросСуществующего.УстановитьПараметр("Хеш", Хеш);
			ЗапросСуществующего.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Образцы.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.АИС_ОбразцыДокументов КАК Образцы
			|ГДЕ
			|	Образцы.ИсточникURL = &URL
			|	И (&Хеш = """" ИЛИ Образцы.ХешСодержимого = &Хеш)";
			Выборка = ЗапросСуществующего.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Образец = Выборка.Ссылка.ПолучитьОбъект();
			КонецЕсли;
		КонецЕсли;
		Если Образец = Неопределено Тогда
			Образец = Справочники.АИС_ОбразцыДокументов.СоздатьЭлемент();
		КонецЕсли;
		Образец.Наименование = ?(ПустаяСтрока(Заголовок), "Образец из интернета", Заголовок);
		Образец.ВидДокумента = ВидДокумента;
		Образец.Содержание = Строка(Текст);
		Образец.Комментарий = "Загружен из интернета";
		Образец.Версия = 1;
		Образец.Активность = Истина;
		Образец.ИсточникURL = Строка(URL);
		Образец.ДатаПолучения = ТекущаяДатаСеанса();
		Образец.ТипИсточника = "Интернет";
		Образец.ХешСодержимого = Строка(Хеш);
		Образец.СтатусПодтверждения = "unconfirmed";
		Образец.МодельГенерации = Строка(Модель);
		Образец.Записать();

		ЗапросСтарых = Новый Запрос;
		ЗапросСтарых.УстановитьПараметр("Владелец", Образец.Ссылка);
		ЗапросСтарых.Текст =
		"ВЫБРАТЬ
		|	Вопросы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.АИС_ВопросыПриСозданииДокументаПоОбразцу КАК Вопросы
		|ГДЕ
		|	Вопросы.Владелец = &Владелец";
		ВыборкаСтарых = ЗапросСтарых.Выполнить().Выбрать();
		Пока ВыборкаСтарых.Следующий() Цикл
			Старый = ВыборкаСтарых.Ссылка.ПолучитьОбъект();
			Если Старый <> Неопределено Тогда
				Старый.Удалить();
			КонецЕсли;
		КонецЦикла;

		Вопросы = Новый Массив;
		Данные.Свойство("Вопросы", Вопросы);
		Если ТипЗнч(Вопросы) <> Тип("Массив") Тогда
			Вопросы = Новый Массив;
		КонецЕсли;
		Номер = 0;
		Для Каждого Вопрос Из Вопросы Цикл
			Номер = Номер + 1;
			НовыйВопрос = Справочники.АИС_ВопросыПриСозданииДокументаПоОбразцу.СоздатьЭлемент();
			НовыйВопрос.Владелец = Образец.Ссылка;
			ТекстВопроса = "";
			Вопрос.Свойство("Текст", ТекстВопроса);
			НовыйВопрос.Наименование = "Вопрос " + Формат(Номер, "ЧГ=0");
			НовыйВопрос.ТекстВопроса = Строка(ТекстВопроса);
			НовыйВопрос.Порядок = Номер;
			Значение = "";
			Вопрос.Свойство("Код", Значение);
			НовыйВопрос.КодВопроса = Строка(Значение);
			ТипОтвета = "single";
			Вопрос.Свойство("ТипОтвета", ТипОтвета);
			НовыйВопрос.ТипОтвета = Строка(ТипОтвета);
			Обязательный = Истина;
			Вопрос.Свойство("Обязательный", Обязательный);
			НовыйВопрос.Обязательный = (Обязательный = Истина);
			Подсказка = "";
			Вопрос.Свойство("Подсказка", Подсказка);
			НовыйВопрос.Подсказка = Строка(Подсказка);
			ОтветПоУмолчанию = "";
			Вопрос.Свойство("ОтветПоУмолчанию", ОтветПоУмолчанию);
			НовыйВопрос.ОтветПоУмолчанию = Строка(ОтветПоУмолчанию);
			НовыйВопрос.РазрешитьСвободныйВвод = Истина;
			НовыйВопрос.Активность = Истина;
			НовыйВопрос.Записать();
		КонецЦикла;

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписатьСвойствоСтрокой(ЗаписьJSON, "status", "ok");
		ЗаписатьСвойствоСтрокой(
			ЗаписьJSON, "example_id", Строка(Образец.Ссылка.УникальныйИдентификатор()));
		ЗаписатьСвойствоСтрокой(ЗаписьJSON, "confirm_status", Образец.СтатусПодтверждения);
		ЗаписьJSON.ЗаписатьИмяСвойства("questions");
		ЗаписьJSON.ЗаписатьЗначение(Вопросы.Количество());
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Ответ.КодСостояния = 400;
		Ответ.УстановитьТелоИзСтроки("{""error"":""" + СтрЗаменить(ОписаниеОшибки(), """", "'") + """}");
	КонецПопытки;
	Возврат Ответ;
КонецФункции

// POST /hs/ais-sim/knowledge/search
// Тело: {"Запрос":"...", "Лимит":5}
Функция ПоискНСИ_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Данные = ПрочитатьJSONИзЗапроса(Запрос);
		ТекстЗапроса = "";
		Данные.Свойство("Запрос", ТекстЗапроса);
		ТекстЗапроса = СокрЛП(Строка(ТекстЗапроса));
		Если ПустаяСтрока(ТекстЗапроса) Тогда
			ВызватьИсключение "Пустой запрос поиска НСИ";
		КонецЕсли;
		Лимит = 5;
		Данные.Свойство("Лимит", Лимит);
		Если ТипЗнч(Лимит) <> Тип("Число") ИЛИ Лимит <= 0 Тогда
			Лимит = 5;
		КонецЕсли;

		РезультатПоиска = АИС_ИнтеграцияСRAG.Поиск(
			ТекстЗапроса, Неопределено, Лимит, Неопределено, "knowledge");
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписьJSON.ЗаписатьИмяСвойства("status");
		ЗаписьJSON.ЗаписатьЗначение(?(РезультатПоиска.Найден, "ok", "empty"));
		ЗаписьJSON.ЗаписатьИмяСвойства("results");
		ЗаписьJSON.ЗаписатьНачалоМассива();
		Для Каждого СтрокаРезультата Из РезультатПоиска.Результаты Цикл
			Текст = "";
			Части = Новый Массив;
			Для Каждого Фрагмент Из СтрокаРезультата.Фрагменты Цикл
				Если Не ПустаяСтрока(Фрагмент.Текст) Тогда
					Части.Добавить(Фрагмент.Текст);
				КонецЕсли;
			КонецЦикла;
			Текст = СтрСоединить(Части, Символы.ПС + Символы.ПС);
			Свежесть = "unknown";
			ДействуетДо = "";
			Проверено = "";
			МетаданныеРезультата = СтрокаРезультата.Метаданные;
			Если ТипЗнч(МетаданныеРезультата) = Тип("Структура")
				ИЛИ ТипЗнч(МетаданныеРезультата) = Тип("Соответствие") Тогда
				Актуален = Неопределено;
				МетаданныеРезультата.Свойство("is_current", Актуален);
				ТребуетПодтверждения = Ложь;
				МетаданныеРезультата.Свойство("requires_confirmation", ТребуетПодтверждения);
				МетаданныеРезультата.Свойство("valid_until", ДействуетДо);
				МетаданныеРезультата.Свойство("last_verified_at", Проверено);
				Если ТребуетПодтверждения = Истина Тогда
					Свежесть = "requires_confirmation";
				ИначеЕсли Актуален = Ложь Тогда
					Свежесть = "outdated";
				ИначеЕсли Актуален = Истина Тогда
					Свежесть = "actual";
				КонецЕсли;
			КонецЕсли;
			Если Не ПустаяСтрока(Строка(ДействуетДо)) Тогда
				Попытка
					Если Дата(Лев(Строка(ДействуетДо), 10)) < ТекущаяДатаСеанса() Тогда
						Свежесть = "outdated";
					КонецЕсли;
				Исключение
					// Некорректная дата не отменяет результат поиска.
				КонецПопытки;
			КонецЕсли;

			ЗаписьJSON.ЗаписатьНачалоОбъекта();
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "text", Текст);
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "title", СтрокаРезультата.Заголовок);
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "source", СтрокаРезультата.ИсточникТип);
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "document_id", СтрокаРезультата.ИсточникID);
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "valid_until", Строка(ДействуетДо));
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "last_verified_at", Строка(Проверено));
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "freshness_status", Свежесть);
			ЗаписьJSON.ЗаписатьИмяСвойства("score");
			ЗаписьJSON.ЗаписатьЗначение(СтрокаРезультата.Score);
			ЗаписьJSON.ЗаписатьКонецОбъекта();
		КонецЦикла;
		ЗаписьJSON.ЗаписатьКонецМассива();
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Ответ.КодСостояния = 400;
		Ответ.УстановитьТелоИзСтроки("{""error"":""" + СтрЗаменить(ОписаниеОшибки(), """", "'") + """}");
	КонецПопытки;
	Возврат Ответ;
КонецФункции

// POST /hs/ais-sim/documents/access
// Тело: {"Документ":"<uuid>", "Пользователь":"<login>", "Цель":"..."}
// Проверяет ACL документа и исключение по распоряжению общего начальника.
Функция ПроверитьДоступКДокументу_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Данные = ПрочитатьJSONИзЗапроса(Запрос);
		Ид = "";
		Данные.Свойство("Документ", Ид);
		Логин = "";
		Данные.Свойство("Пользователь", Логин);
		Цель = "";
		Данные.Свойство("Цель", Цель);
		Документ = Справочники.ВнутренниеДокументы.ПолучитьСсылку(
			Новый УникальныйИдентификатор(Строка(Ид)));
		Пользователь = Справочники.Пользователи.НайтиПоНаименованию(
			Строка(Логин), Истина);
		Если Не ЗначениеЗаполнено(Документ) ИЛИ Не ЗначениеЗаполнено(Пользователь) Тогда
			Ответ.КодСостояния = 404;
			Ответ.УстановитьТелоИзСтроки("Документ или пользователь не найден");
			Возврат Ответ;
		КонецЕсли;

		Разрешен = АИС_ПраваДоступа.ПроверитьДоступность(Документ, Пользователь);
		Основание = "";
		Если Не Разрешен Тогда
			КатегорияДокумента = "";
			Если ЗначениеЗаполнено(Документ.ВидДокумента) Тогда
				КатегорияДокумента = Документ.ВидДокумента.Наименование;
			КонецЕсли;
			ЗапросРазрешений = Новый Запрос;
			ЗапросРазрешений.УстановитьПараметр("Пользователь", Пользователь);
			ЗапросРазрешений.УстановитьПараметр("Документ", Документ);
			ЗапросРазрешений.УстановитьПараметр("Категория", КатегорияДокумента);
			ЗапросРазрешений.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Разрешения.Распоряжение КАК Распоряжение
			|ИЗ
			|	РегистрСведений.АИС_РазрешенияОбменаИнформацией КАК Разрешения
			|ГДЕ
			|	Разрешения.Активно
			|	И (Разрешения.Отправитель = &Пользователь
			|		ИЛИ Разрешения.Получатель = &Пользователь)
			|	И (Разрешения.ДействуетДо = ДАТАВРЕМЯ(1, 1, 1)
			|		ИЛИ Разрешения.ДействуетДо >= &Сейчас)
			|	И (Разрешения.Категория = &Категория
			|		ИЛИ Разрешения.Категория = """"
			|		ИЛИ Разрешения.Категория = &ИдДокумента)";
			ЗапросРазрешений.УстановитьПараметр("Сейчас", ТекущаяДатаСеанса());
			ЗапросРазрешений.УстановитьПараметр(
				"ИдДокумента", Строка(Документ.УникальныйИдентификатор()));
			Выборка = ЗапросРазрешений.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Разрешен = Истина;
				Основание = Строка(Выборка.Распоряжение.УникальныйИдентификатор());
			КонецЕсли;
		КонецЕсли;

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписьJSON.ЗаписатьИмяСвойства("allowed");
		ЗаписьJSON.ЗаписатьЗначение(Разрешен);
		ЗаписьJSON.ЗаписатьИмяСвойства("restricted");
		ЗаписьJSON.ЗаписатьЗначение(Не Разрешен);
		ЗаписатьСвойствоСтрокой(ЗаписьJSON, "basis", Основание);
		ЗаписатьСвойствоСтрокой(ЗаписьJSON, "document", Строка(Документ.УникальныйИдентификатор()));
		ЗаписатьСвойствоСтрокой(ЗаписьJSON, "target", Строка(Пользователь));
		ЗаписатьСвойствоСтрокой(ЗаписьJSON, "purpose", Строка(Цель));
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Ответ.КодСостояния = 400;
		Ответ.УстановитьТелоИзСтроки("{""error"":""" + СтрЗаменить(ОписаниеОшибки(), """", "'") + """}");
	КонецПопытки;
	Возврат Ответ;
КонецФункции

Функция ТекущийПользовательСправочника()
	Текущий = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если Текущий = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Справочники.Пользователи.НайтиПоНаименованию(Строка(Текущий.Имя), Истина);
КонецФункции

// Проверка ACL с исключением по распоряжению общего начальника.
Функция РазрешенДоступКДокументу(Документ, Пользователь)
	Результат = Новый Структура("Разрешен, Основание", Ложь, "");
	Если Не ЗначениеЗаполнено(Документ) ИЛИ Не ЗначениеЗаполнено(Пользователь) Тогда
		Возврат Результат;
	КонецЕсли;
	Если АИС_ПраваДоступа.ПроверитьДоступность(Документ, Пользователь) Тогда
		Результат.Разрешен = Истина;
		Возврат Результат;
	КонецЕсли;
	КатегорияДокумента = "";
	Если ЗначениеЗаполнено(Документ.ВидДокумента) Тогда
		КатегорияДокумента = Документ.ВидДокумента.Наименование;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Запрос.УстановитьПараметр("Категория", КатегорияДокумента);
	Запрос.УстановитьПараметр("ИдДокумента", Строка(Документ.УникальныйИдентификатор()));
	Запрос.УстановитьПараметр("Сейчас", ТекущаяДатаСеанса());
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Разрешения.Распоряжение КАК Распоряжение
	|ИЗ
	|	РегистрСведений.АИС_РазрешенияОбменаИнформацией КАК Разрешения
	|ГДЕ
	|	Разрешения.Активно
	|	И (Разрешения.Отправитель = &Пользователь
	|		ИЛИ Разрешения.Получатель = &Пользователь)
	|	И (Разрешения.ДействуетДо = ДАТАВРЕМЯ(1, 1, 1)
	|		ИЛИ Разрешения.ДействуетДо >= &Сейчас)
	|	И (Разрешения.Категория = &Категория
	|		ИЛИ Разрешения.Категория = """"
	|		ИЛИ Разрешения.Категория = &ИдДокумента)";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Разрешен = Истина;
		Результат.Основание = Строка(Выборка.Распоряжение.УникальныйИдентификатор());
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция МассивИдентификаторовИзJSON(Значение)
	Массив = Новый Массив;
	Если ТипЗнч(Значение) = Тип("Массив") Тогда
		Для Каждого Элемент Из Значение Цикл
			Массив.Добавить(Строка(Элемент));
		КонецЦикла;
	КонецЕсли;
	Возврат Массив;
КонецФункции

Функция ПроверитьИсходныеДокументы(Идентификаторы, Получатель)
	Ограниченные = Новый Массив;
	Для Каждого Ид Из Идентификаторы Цикл
		Попытка
			Документ = Справочники.ВнутренниеДокументы.ПолучитьСсылку(
				Новый УникальныйИдентификатор(Ид));
		Исключение
			Продолжить;
		КонецПопытки;
		Если Не ЗначениеЗаполнено(Документ) Тогда
			Продолжить;
		КонецЕсли;
		Доступ = РазрешенДоступКДокументу(Документ, Получатель);
		Если Не Доступ.Разрешен Тогда
			Ограниченные.Добавить(Ид);
		КонецЕсли;
	КонецЦикла;
	Возврат Ограниченные;
КонецФункции

// POST /hs/ais-sim/drafts
// Тело: {"Черновик": "<uuid>", "ВидЧерновика": "document|information_request|approval_response",
//        "ВидДокумента": "...", "Заголовок": "...", "Содержание": "...",
//        "Адресат": "<login>", "Основание": "<uuid>", "ВидЗапроса": "...",
//        "ИсходныеДокументы": ["<uuid>"]}
Функция СоздатьЧерновик_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Автор = ТекущийПользовательСправочника();
		Если Не ЗначениеЗаполнено(Автор) Тогда
			Ответ.КодСостояния = 401;
			Ответ.УстановитьТелоИзСтроки("Текущий пользователь не найден в справочнике");
			Возврат Ответ;
		КонецЕсли;
		Данные = ПрочитатьJSONИзЗапроса(Запрос);
		ИдЧерновика = "";
		Данные.Свойство("Черновик", ИдЧерновика);
		Если Не ПустаяСтрока(ИдЧерновика) Тогда
			СсылкаЧерновика = Справочники.АИС_ЧерновикиДокументов.ПолучитьСсылку(
				Новый УникальныйИдентификатор(ИдЧерновика));
			Черновик = СсылкаЧерновика.ПолучитьОбъект();
			Если Черновик = Неопределено Тогда
				Ответ.КодСостояния = 404;
				Ответ.УстановитьТелоИзСтроки("Черновик не найден");
				Возврат Ответ;
			КонецЕсли;
			Если Черновик.Автор <> Автор Тогда
				Ответ.КодСостояния = 403;
				Ответ.УстановитьТелоИзСтроки("Менять чужой черновик запрещено");
				Возврат Ответ;
			КонецЕсли;
			Черновик.Версия = Черновик.Версия + 1;
		Иначе
			Черновик = Справочники.АИС_ЧерновикиДокументов.СоздатьЭлемент();
			Черновик.Автор = Автор;
			Черновик.Версия = 1;
		КонецЕсли;
		Заголовок = "";
		Данные.Свойство("Заголовок", Заголовок);
		Если ПустаяСтрока(Заголовок) Тогда
			ВызватьИсключение "Не указан заголовок черновика";
		КонецЕсли;
		ВидЧерновика = "document";
		Данные.Свойство("ВидЧерновика", ВидЧерновика);
		ВидДокументаИмя = "";
		Данные.Свойство("ВидДокумента", ВидДокументаИмя);
		ВидДокумента = Неопределено;
		Если Не ПустаяСтрока(ВидДокументаИмя) Тогда
			ВидДокумента = АИС_ОбщегоНазначения.НайтиИлиСоздатьЭлемент(
				Справочники.ВидыВнутреннихДокументов, ВидДокументаИмя);
			ВидДокумента.Записать();
		КонецЕсли;
		Содержание = "";
		Данные.Свойство("Содержание", Содержание);
		АдресатЛогин = "";
		Данные.Свойство("Адресат", АдресатЛогин);
		Адресат = Неопределено;
		Если Не ПустаяСтрока(АдресатЛогин) Тогда
			Адресат = Справочники.Пользователи.НайтиПоНаименованию(АдресатЛогин, Истина);
		КонецЕсли;
		ИдОснования = "";
		Данные.Свойство("Основание", ИдОснования);
		Основание = Неопределено;
		Если Не ПустаяСтрока(ИдОснования) Тогда
			Основание = Справочники.ВнутренниеДокументы.ПолучитьСсылку(
				Новый УникальныйИдентификатор(ИдОснования));
		КонецЕсли;
		ВидЗапроса = "";
		Данные.Свойство("ВидЗапроса", ВидЗапроса);
		ИсходныеJSON = Неопределено;
		Данные.Свойство("ИсходныеДокументы", ИсходныеJSON);
		Исходные = МассивИдентификаторовИзJSON(ИсходныеJSON);

		Если ЗначениеЗаполнено(Адресат) Тогда
			Ограниченные = ПроверитьИсходныеДокументы(Исходные, Адресат);
			Если Ограниченные.Количество() > 0 Тогда
				ЗаписьJSON = Новый ЗаписьJSON;
				ЗаписьJSON.УстановитьСтроку();
				ЗаписьJSON.ЗаписатьНачалоОбъекта();
				ЗаписатьСвойствоСтрокой(ЗаписьJSON, "error", "access_denied");
				ЗаписьJSON.ЗаписатьИмяСвойства("restricted");
				ЗаписьОбъектJSON(ЗаписьJSON, Ограниченные);
				ЗаписьJSON.ЗаписатьКонецОбъекта();
				Ответ.КодСостояния = 403;
				Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
				Возврат Ответ;
			КонецЕсли;
		КонецЕсли;

		Черновик.Наименование = Заголовок;
		Черновик.ВидЧерновика = Строка(ВидЧерновика);
		Черновик.ВидДокумента = ВидДокумента;
		Черновик.Заголовок = Заголовок;
		Черновик.Содержание = Строка(Содержание);
		Черновик.Адресат = Адресат;
		Черновик.Основание = Основание;
		Черновик.ВидЗапроса = Строка(ВидЗапроса);
		Черновик.Статус = "draft";
		Черновик.Замечания = "";
		ЗаписьИсходных = Новый ЗаписьJSON;
		ЗаписьИсходных.УстановитьСтроку();
		ЗаписьОбъектJSON(ЗаписьИсходных, Исходные);
		Черновик.ИсходныеДокументы = ЗаписьИсходных.Закрыть();
		Черновик.Записать();

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписатьСвойствоСтрокой(ЗаписьJSON, "status", "ok");
		ЗаписатьСвойствоСтрокой(
			ЗаписьJSON, "draft_id", Строка(Черновик.Ссылка.УникальныйИдентификатор()));
		ЗаписьJSON.ЗаписатьИмяСвойства("version");
		ЗаписьJSON.ЗаписатьЗначение(Черновик.Версия);
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Ответ.КодСостояния = 400;
		Ответ.УстановитьТелоИзСтроки("{""error"":""" + СтрЗаменить(ОписаниеОшибки(), """", "'") + """}");
	КонецПопытки;
	Возврат Ответ;
КонецФункции

