// GET /hs/ais-sim/folders/documents?employee=<login>&purpose=<...>&folder=<uuid>&document=<uuid>
// Документы сотрудника с RAG-метаданными: папка, путь, назначение, источник.
Функция ПолучитьДокументыВПапках_GET(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Сотрудник = СотрудникПоПараметру(Запрос.ПараметрыЗапроса.Получить("employee"));
		Если Не ЗначениеЗаполнено(Сотрудник) Тогда
			Ответ.КодСостояния = 404;
			Ответ.УстановитьТелоИзСтроки("Сотрудник не найден");
			Возврат Ответ;
		КонецЕсли;
		СтрокаНазначения = Запрос.ПараметрыЗапроса.Получить("purpose");
		Назначение = ?(ПустаяСтрока(СтрокаНазначения), Неопределено,
			НазначениеПоСтроке(СтрокаНазначения));
		Папка = ПапкаПоУникальномуИдентификатору(Запрос.ПараметрыЗапроса.Получить("folder"));
		Документ = ЛюбойДокументПоУникальномуИдентификатору(Запрос.ПараметрыЗапроса.Получить("document"));
		ДокументыВПапках = АИС_ПапкиДокументов.ПолучитьДокументыПоСотруднику(
			Сотрудник, Назначение, Папка, Документ);
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоМассива();
		Для Каждого Строка Из ДокументыВПапках Цикл
			ЗаписьJSON.ЗаписатьНачалоОбъекта();
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "УникальныйИдентификатор", Строка.УникальныйИдентификатор);
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "Тип", Строка.Тип);
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "Заголовок", Строка.Заголовок);
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "Вид", Строка.Вид);
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "Дата", Строка(Строка.Дата));
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "Папка", Строка.Папка);
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "Путь", Строка.Путь);
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "Сотрудник", Строка.Сотрудник);
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "Назначение", Строка.Назначение);
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "Источник", Строка.Источник);
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "ДатаДобавления", Строка(Строка.ДатаДобавления));
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "Комментарий", Строка.Комментарий);
			ЗаписьJSON.ЗаписатьКонецОбъекта();
		КонецЦикла;
		ЗаписьJSON.ЗаписатьКонецМассива();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Ответ.КодСостояния = 400;
		Ответ.УстановитьТелоИзСтроки("Ошибка списка документов в папках: " + ОписаниеОшибки());
	КонецПопытки;
	Возврат Ответ;
КонецФункции

// GET /hs/ais-sim/folders/document?document=<uuid>
// Все папки, в которых состоит документ; не-администратор видит только свои.
Функция ПолучитьПапкиДокумента_GET(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Документ = ЛюбойДокументПоУникальномуИдентификатору(Запрос.ПараметрыЗапроса.Получить("document"));
		Если Не ЗначениеЗаполнено(Документ) Тогда
			Ответ.КодСостояния = 404;
			Ответ.УстановитьТелоИзСтроки("Документ не найден");
			Возврат Ответ;
		КонецЕсли;
		Сотрудник = ?(ЭтоПривилегированныйПользователь(), Неопределено, ПараметрыСеанса.ТекущийПользователь);
		ПапкиДокумента = АИС_ПапкиДокументов.ПолучитьПапкиДокумента(Документ, Сотрудник);
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоМассива();
		Для Каждого Папка Из ПапкиДокумента Цикл
			ЗаписьJSON.ЗаписатьНачалоОбъекта();
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "Папка", Папка.Папка);
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "Путь", Папка.Путь);
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "Сотрудник", Папка.Сотрудник);
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "Назначение", Папка.Назначение);
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "Источник", Папка.Источник);
			ЗаписьJSON.ЗаписатьКонецОбъекта();
		КонецЦикла;
		ЗаписьJSON.ЗаписатьКонецМассива();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Ответ.КодСостояния = 400;
		Ответ.УстановитьТелоИзСтроки("Ошибка папок документа: " + ОписаниеОшибки());
	КонецПопытки;
	Возврат Ответ;
КонецФункции

// POST /hs/ais-sim/folders/ensure
// Тело: {"Сотрудник":"ГенДиректор"}. Создаёт корень и две подпапки.
Функция ОбеспечитьПапки_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Данные = ПрочитатьJSONИзЗапроса(Запрос);
		Сотрудник = СотрудникПоПараметру(Данные.Сотрудник);
		Если Не ЗначениеЗаполнено(Сотрудник) Тогда
			Ответ.КодСостояния = 404;
			Ответ.УстановитьТелоИзСтроки("Сотрудник не найден");
			Возврат Ответ;
		КонецЕсли;
		ПапкиСотрудника = АИС_ПапкиДокументов.ОбеспечитьПапкиСотрудника(Сотрудник);
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписьJSON.ЗаписатьИмяСвойства("Статус");
		ЗаписьJSON.ЗаписатьЗначение("ok");
		ЗаписатьПапкуПоКлючуВJSON(ЗаписьJSON, "Корень", ПапкиСотрудника.Корень);
		ЗаписатьПапкуПоКлючуВJSON(ЗаписьJSON, "Полученные", ПапкиСотрудника.Полученные);
		ЗаписатьПапкуПоКлючуВJSON(ЗаписьJSON, "Сформированные", ПапкиСотрудника.Сформированные);
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Ответ.КодСостояния = 400;
		Ответ.УстановитьТелоИзСтроки("Ошибка создания папок: " + ОписаниеОшибки());
	КонецПопытки;
	Возврат Ответ;
КонецФункции

// POST /hs/ais-sim/folders/place
// Тело: {"Документ":"uuid","Сотрудник":"login","Назначение":"Полученные",
//        "Папка":"uuid" (опционально),"Комментарий":""}
Функция РазместитьДокумент_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Данные = ПрочитатьJSONИзЗапроса(Запрос);
		Документ = ЛюбойДокументПоУникальномуИдентификатору(Данные.Документ);
		Сотрудник = СотрудникПоПараметру(Данные.Сотрудник);
		Если Не ЗначениеЗаполнено(Документ) Или Не ЗначениеЗаполнено(Сотрудник) Тогда
			Ответ.КодСостояния = 404;
			Ответ.УстановитьТелоИзСтроки("Документ или сотрудник не найдены");
			Возврат Ответ;
		КонецЕсли;
		Назначение = НазначениеПоСтроке(Данные.Назначение);
		Папка = Неопределено;
		Если Данные.Свойство("Папка") И Не ПустаяСтрока(Данные.Папка) Тогда
			Папка = ПапкаПоУникальномуИдентификатору(Данные.Папка);
			Если Не ЗначениеЗаполнено(Папка) Тогда
				Ответ.КодСостояния = 404;
				Ответ.УстановитьТелоИзСтроки("Папка не найдена");
				Возврат Ответ;
			КонецЕсли;
			Ответственный = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Папка, "Ответственный");
			Если Не ЭтоПривилегированныйПользователь() И Ответственный <> Сотрудник Тогда
				Ответ.КодСостояния = 403;
				Ответ.УстановитьТелоИзСтроки("Нельзя размещать документ в чужой папке");
				Возврат Ответ;
			КонецЕсли;
		КонецЕсли;
		Комментарий = "";
		Если Данные.Свойство("Комментарий") Тогда
			Комментарий = Строка(Данные.Комментарий);
		КонецЕсли;
		Результат = АИС_ПапкиДокументов.ДобавитьДокументВПапку(
			Документ, Сотрудник, Назначение,
			Перечисления.АИС_ИсточникиПривязкиДокументов.API, Папка, Комментарий);
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписьJSON.ЗаписатьИмяСвойства("Статус");
		ЗаписьJSON.ЗаписатьЗначение("ok");
		ЗаписьJSON.ЗаписатьИмяСвойства("СвязьУстановлена");
		ЗаписьJSON.ЗаписатьЗначение(Результат);
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Ответ.КодСостояния = 400;
		Ответ.УстановитьТелоИзСтроки("Ошибка размещения документа: " + ОписаниеОшибки());
	КонецПопытки;
	Возврат Ответ;
КонецФункции

// POST /hs/ais-sim/folders/backfill
// Разовый backfill существующих документов и задач. Только администратор.
Функция ЗаполнитьПапки_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Если Не ЭтоПривилегированныйПользователь() Тогда
			Ответ.КодСостояния = 403;
			Ответ.УстановитьТелоИзСтроки("Требуются права администратора");
			Возврат Ответ;
		КонецЕсли;
		Результат = АИС_ПапкиДокументов.ЗаполнитьПапкиПоСуществующимДокументам();
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписьJSON.ЗаписатьИмяСвойства("Статус");
		ЗаписьJSON.ЗаписатьЗначение("ok");
		ЗаписьJSON.ЗаписатьИмяСвойства("Пользователей");
		ЗаписьJSON.ЗаписатьЗначение(Результат.Пользователей);
		ЗаписьJSON.ЗаписатьИмяСвойства("Документов");
		ЗаписьJSON.ЗаписатьЗначение(Результат.Документов);
		ЗаписьJSON.ЗаписатьИмяСвойства("Задач");
		ЗаписьJSON.ЗаписатьЗначение(Результат.Задач);
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Ответ.КодСостояния = 400;
		Ответ.УстановитьТелоИзСтроки("Ошибка backfill папок: " + ОписаниеОшибки());
	КонецПопытки;
	Возврат Ответ;
КонецФункции

Функция ЭтоПривилегированныйПользователь()
	ПользовательИБ = ПользователиИнформационнойБазы.ТекущийПользователь();
	Если ПользовательИБ = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Возврат Пользователи.ЭтоПолноправныйПользователь()
		Или ПользовательИБ.Роли.Содержит(Метаданные.Роли.АИС_АдминистраторСистемы)
		Или ПользовательИБ.Роли.Содержит(Метаданные.Роли.АИС_СервисныйПользователь);
КонецФункции

Функция СотрудникПоПараметру(Логин)
	Текущий = ПараметрыСеанса.ТекущийПользователь;
	Если ЭтоПривилегированныйПользователь() Тогда
		Если ПустаяСтрока(Логин) Тогда
			Возврат Текущий;
		КонецЕсли;
		Возврат Справочники.Пользователи.НайтиПоНаименованию(Строка(Логин), Истина);
	КонецЕсли;
	// Сотрудник видит и меняет только свои папки.
	Возврат Текущий;
КонецФункции

Функция ПользовательПоЛогину(Логин)
	Если ПустаяСтрока(Логин) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Справочники.Пользователи.НайтиПоНаименованию(Строка(Логин), Истина);
КонецФункции

Функция ЛюбойДокументПоУникальномуИдентификатору(Ид)
	Если ПустаяСтрока(Ид) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Для Каждого ИмяСправочника Из СтрРазделить("ВнутренниеДокументы,ВходящиеДокументы,ИсходящиеДокументы", ",") Цикл
		Попытка
			Ссылка = Справочники[ИмяСправочника].ПолучитьСсылку(Новый УникальныйИдентификатор(Ид));
		Исключение
			Продолжить;
		КонецПопытки;
		Если Ссылка.ПолучитьОбъект() <> Неопределено Тогда
			Возврат Ссылка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция ПапкаПоУникальномуИдентификатору(Ид)
	Если ПустаяСтрока(Ид) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Ссылка = Справочники.ПапкиВнутреннихДокументов.ПолучитьСсылку(Новый УникальныйИдентификатор(Ид));
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	Если Ссылка.ПолучитьОбъект() = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Ссылка;
КонецФункции

Функция НазначениеПоСтроке(Значение)
	Если Строка(Значение) = "Полученные" Тогда
		Возврат Перечисления.АИС_НазначенияПапокДокументов.Полученные;
	ИначеЕсли Строка(Значение) = "Сформированные" Тогда
		Возврат Перечисления.АИС_НазначенияПапокДокументов.Сформированные;
	КонецЕсли;
	Возврат Перечисления.АИС_НазначенияПапокДокументов.Дополнительные;
КонецФункции

Функция ПрочитатьJSONИзЗапроса(Запрос)
	ТелоКакСтрока = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТелоКакСтрока);
	Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
	ЧтениеJSON.Закрыть();
	Возврат Данные;
КонецФункции

Процедура ЗаписатьПапкуВJSON(ЗаписьJSON, Папка)
	ЗаписьJSON.ЗаписатьНачалоОбъекта();
	ЗаписатьСвойствоСтрокой(ЗаписьJSON, "УникальныйИдентификатор", Папка.УникальныйИдентификатор);
	ЗаписатьСвойствоСтрокой(ЗаписьJSON, "Наименование", Папка.Наименование);
	ЗаписатьСвойствоСтрокой(ЗаписьJSON, "Описание", Папка.Описание);
	ЗаписатьСвойствоСтрокой(ЗаписьJSON, "Родитель", Папка.Родитель);
	ЗаписатьСвойствоСтрокой(ЗаписьJSON, "Путь", Папка.Путь);
	ЗаписьJSON.ЗаписатьИмяСвойства("КоличествоДокументов");
	ЗаписьJSON.ЗаписатьЗначение(Папка.КоличествоДокументов);
	ЗаписьJSON.ЗаписатьКонецОбъекта();
КонецПроцедуры

Процедура ЗаписатьПапкуПоКлючуВJSON(ЗаписьJSON, ИмяСвойства, Папка)
	ЗаписьJSON.ЗаписатьИмяСвойства(ИмяСвойства);
	Если Не ЗначениеЗаполнено(Папка) Тогда
		ЗаписьJSON.ЗаписатьЗначение(Неопределено);
		Возврат;
	КонецЕсли;
	ЗаписьJSON.ЗаписатьНачалоОбъекта();
	ЗаписатьСвойствоСтрокой(ЗаписьJSON, "УникальныйИдентификатор", Строка(Папка.УникальныйИдентификатор()));
	ЗаписатьСвойствоСтрокой(ЗаписьJSON, "Путь", АИС_ПапкиДокументов.ПолучитьПутьПапки(Папка));
	ЗаписьJSON.ЗаписатьКонецОбъекта();
КонецПроцедуры

Процедура ЗаписатьСвойствоСтрокой(ЗаписьJSON, ИмяСвойства, Значение)
	ЗаписьJSON.ЗаписатьИмяСвойства(ИмяСвойства);
	ЗаписьJSON.ЗаписатьЗначение(?(Значение = Неопределено, "", Строка(Значение)));
КонецПроцедуры


// GET /hs/ais-sim/debug/roles?login=<login>
// Диагностика: роли пользователя ИБ (для проверки синхронизации прав).
Функция ПолучитьРолиПользователя_GET(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Логин = Запрос.ПараметрыЗапроса.Получить("login");
		ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(Логин);
		Если ПользовательИБ = Неопределено Тогда
			Ответ.КодСостояния = 404;
			Ответ.УстановитьТелоИзСтроки("Пользователь не найден");
			Возврат Ответ;
		КонецЕсли;
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоМассива();
		Для Каждого Роль Из ПользовательИБ.Роли Цикл
			ЗаписьJSON.ЗаписатьЗначение(Роль.Имя);
		КонецЦикла;
		ЗаписьJSON.ЗаписатьКонецМассива();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Ответ.КодСостояния = 400;
		Ответ.УстановитьТелоИзСтроки("Ошибка диагностики ролей: " + ОписаниеОшибки());
	КонецПопытки;
	Возврат Ответ;
КонецФункции


// POST /hs/ais-sim/org-structure/department
// Тело: {"Наименование":"...","Руководитель":"login","Родитель":"..."}
// Создаёт/обновляет подразделение и назначает руководителя.
Функция СоздатьПодразделение_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Данные = ПрочитатьJSONИзЗапроса(Запрос);
		Наименование = Строка(Данные.Наименование);
		Руководитель = Справочники.Пользователи.НайтиПоНаименованию(Строка(Данные.Руководитель), Истина);
		Если Не ЗначениеЗаполнено(Руководитель) Тогда
			ВызватьИсключение "Руководитель не найден: " + Строка(Данные.Руководитель);
		КонецЕсли;
		Объект = АИС_ОбщегоНазначения.НайтиИлиСоздатьЭлемент(Справочники.СтруктураПредприятия, Наименование);
		Объект.Наименование = Наименование;
		Объект.Руководитель = Руководитель;
		РодительИмя = "";
		Данные.Свойство("Родитель", РодительИмя);
		Если Не ПустаяСтрока(Строка(РодительИмя)) Тогда
			Родитель = Справочники.СтруктураПредприятия.НайтиПоНаименованию(Строка(РодительИмя), Истина);
			Если Не ЗначениеЗаполнено(Родитель) Тогда
				ВызватьИсключение "Родитель не найден: " + Строка(РодительИмя);
			КонецЕсли;
			Объект.Родитель = Родитель;
		КонецЕсли;
		Объект.Записать();

		ПользовательОбъект = Руководитель.ПолучитьОбъект();
		ПользовательОбъект.Подразделение = Объект.Ссылка;
		ПользовательОбъект.Записать();

		Запись = РегистрыСведений.СведенияОПользователяхДокументооборот.СоздатьМенеджерЗаписи();
		Запись.Период = Дата(1, 1, 1);
		Запись.Пользователь = Руководитель;
		Запись.Прочитать();
		Запись.Подразделение = Объект.Ссылка;
		Запись.Записать();

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписатьСвойствоСтрокой(ЗаписьJSON, "Статус", "ok");
		ЗаписатьСвойствоСтрокой(ЗаписьJSON, "Наименование", Наименование);
		ЗаписатьСвойствоСтрокой(ЗаписьJSON, "Руководитель", Строка(Руководитель));
		ЗаписатьСвойствоСтрокой(ЗаписьJSON, "УникальныйИдентификатор", Строка(Объект.Ссылка.УникальныйИдентификатор()));
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Ответ.КодСостояния = 400;
		Ответ.УстановитьТелоИзСтроки("Ошибка создания подразделения: " + ОписаниеОшибки());
	КонецПопытки;
	Возврат Ответ;
КонецФункции

// GET /hs/ais-sim/org-structure
Функция ПолучитьОргструктуру_GET(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Запрос2 = Новый Запрос;
		Запрос2.Текст =
		"ВЫБРАТЬ
		|	Подразделения.Наименование КАК Наименование,
		|	Подразделения.Родитель.Наименование КАК Родитель,
		|	Подразделения.Руководитель.Наименование КАК Руководитель
		|ИЗ
		|	Справочник.СтруктураПредприятия КАК Подразделения
		|ГДЕ
		|	НЕ Подразделения.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Подразделения.Наименование";
		Выборка = Запрос2.Выполнить().Выбрать();
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоМассива();
		Пока Выборка.Следующий() Цикл
			ЗаписьJSON.ЗаписатьНачалоОбъекта();
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "Наименование", Выборка.Наименование);
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "Родитель", Выборка.Родитель);
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "Руководитель", Выборка.Руководитель);
			ЗаписьJSON.ЗаписатьКонецОбъекта();
		КонецЦикла;
		ЗаписьJSON.ЗаписатьКонецМассива();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Ответ.КодСостояния = 400;
		Ответ.УстановитьТелоИзСтроки("Ошибка чтения оргструктуры: " + ОписаниеОшибки());
	КонецПопытки;
	Возврат Ответ;
КонецФункции



// POST /hs/ais-sim/documents/cancel
// Тело: {"Документ":"uuid","Основание":"uuid","Комментарий":""}
// Отменяет документ штатной связью 1С:ДО «Не действует в соответствии».
Функция ОтменитьДокумент_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Данные = ПрочитатьJSONИзЗапроса(Запрос);
		Документ = ДокументПоУникальномуИдентификатору(Данные.Документ);
		Основание = ДокументПоУникальномуИдентификатору(Данные.Основание);
		Если Не ЗначениеЗаполнено(Документ) Или Не ЗначениеЗаполнено(Основание) Тогда
			ВызватьИсключение "Документ или основание не найдены.";
		КонецЕсли;
		Комментарий = "";
		Данные.Свойство("Комментарий", Комментарий);
		АИС_ОбщегоНазначения.ОтменитьДокумент(Документ, Основание, Строка(Комментарий));
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписатьСвойствоСтрокой(ЗаписьJSON, "Статус", "ok");
		ЗаписатьСвойствоСтрокой(ЗаписьJSON, "НеДействует", "true");
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Ответ.КодСостояния = 400;
		Ответ.УстановитьТелоИзСтроки("Ошибка отмены документа: " + ОписаниеОшибки());
	КонецПопытки;
	Возврат Ответ;
КонецФункции


