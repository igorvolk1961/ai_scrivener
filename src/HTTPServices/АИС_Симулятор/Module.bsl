#Область СлужебныеПроцедурыКорпуса

Функция КодСостоянияКорпуса(Описание)
	Текст = НРег(Описание);
	Если СтрНайти(Текст, "заблокировать") > 0
		Или СтрНайти(Текст, "взаимоблок") > 0
		Или СтрНайти(Текст, "таймаут") > 0
		Или СтрНайти(Текст, "timeout") > 0 Тогда
		Возврат 503;
	КонецЕсли;
	Если СтрНайти(Текст, "не найден") > 0
		Или СтрНайти(Текст, "не задан") > 0
		Или СтрНайти(Текст, "неизвестный статус") > 0
		Или СтрНайти(Текст, "обязан") > 0
		Или СтрНайти(Текст, "запрещен") > 0
		Или СтрНайти(Текст, "запрещён") > 0 Тогда
		Возврат 400;
	КонецЕсли;
	Возврат 500;
КонецФункции

Функция ОтветОшибкиКорпуса(КодСостояния, КодОшибки, Описание)
	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписьJSON.ЗаписатьНачалоОбъекта();
	ЗаписатьСтрокойКорпуса(ЗаписьJSON, "Статус", "ошибка");
	ЗаписатьСтрокойКорпуса(ЗаписьJSON, "КодОшибки", КодОшибки);
	ЗаписатьСтрокойКорпуса(ЗаписьJSON, "Описание", Описание);
	ЗаписьJSON.ЗаписатьКонецОбъекта();
	Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Возврат Ответ;
КонецФункции

Функция ПараметрЗапросаКорпуса(Запрос, Имя)
	Значение = Запрос.ПараметрыЗапроса.Получить(Имя);
	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	Возврат СокрЛП(Строка(Значение));
КонецФункции

Функция СвойствоКорпуса(Данные, Имя, ЗначениеПоУмолчанию = "")
	Возврат АИС_КорпусЗнаний.СвойствоДанных(Данные, Имя, ЗначениеПоУмолчанию);
КонецФункции

Процедура ЗаписатьСтрокойКорпуса(ЗаписьJSON, ИмяСвойства, Значение)
	ЗаписьJSON.ЗаписатьИмяСвойства(ИмяСвойства);
	ЗаписьJSON.ЗаписатьЗначение(?(Значение = Неопределено ИЛИ Значение = NULL, "", Строка(Значение)));
КонецПроцедуры

Процедура ЗаписатьСсылкуКорпуса(ЗаписьJSON, ИмяСвойства, Ссылка)
	ЗаписьJSON.ЗаписатьИмяСвойства(ИмяСвойства);
	Если ЗначениеЗаполнено(Ссылка) Тогда
		ЗаписьJSON.ЗаписатьЗначение(Строка(Ссылка.УникальныйИдентификатор()));
	Иначе
		ЗаписьJSON.ЗаписатьЗначение("");
	КонецЕсли;
КонецПроцедуры

Процедура ЗаписатьМатериалВJSON(ЗаписьJSON, Материал)
	ЗаписьJSON.ЗаписатьНачалоОбъекта();
	ЗаписатьСсылкуКорпуса(ЗаписьJSON, "УникальныйИдентификатор", Материал);
	ЗаписатьСтрокойКорпуса(ЗаписьJSON, "Наименование", Материал.Наименование);
	ЗаписатьСтрокойКорпуса(ЗаписьJSON, "Хеш", Материал.Хеш);
	ЗаписьJSON.ЗаписатьИмяСвойства("Размер");
	ЗаписьJSON.ЗаписатьЗначение(Материал.Размер);
	ЗаписатьСтрокойКорпуса(ЗаписьJSON, "MIME", Материал.MIME);
	ЗаписатьСтрокойКорпуса(ЗаписьJSON, "ПутьВХранилище", Материал.ПутьВХранилище);
	ЗаписатьСтрокойКорпуса(ЗаписьJSON, "ВидДокумента", Материал.ВидДокумента);
