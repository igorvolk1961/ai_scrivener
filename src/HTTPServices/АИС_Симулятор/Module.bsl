// POST /hs/ais-sim/manager/position
// Тело: {"Должность": "...", "РуководительДолжности": "..."}.
Функция УстановитьРуководителяДолжности_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Попытка
		ТелоКакСтрока = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоКакСтрока);
		Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();

		ИмяДолжности = СокрЛП(Строка(Данные.Должность));
		ИмяРуководителя = СокрЛП(Строка(Данные.РуководительДолжности));
		Если ПустаяСтрока(ИмяДолжности) ИЛИ ПустаяСтрока(ИмяРуководителя) Тогда
			ВызватьИсключение "Нужны Должность и РуководительДолжности.";
		КонецЕсли;

		УстановитьПривилегированныйРежим(Истина);
		Должность = АИС_ОбщегоНазначения.НайтиИлиСоздатьЭлемент(
			Справочники.Должности, ИмяДолжности);
		Должность.Записать();
		РуководительДолжности = АИС_ОбщегоНазначения.НайтиИлиСоздатьЭлемент(
			Справочники.Должности, ИмяРуководителя);
		РуководительДолжности.Записать();
		АИС_ОбщегоНазначения.УстановитьРуководителяДолжности(
			Должность.Ссылка, РуководительДолжности.Ссылка);

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписьJSON.ЗаписатьИмяСвойства("Статус");
		ЗаписьJSON.ЗаписатьЗначение("сохранено");
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Текст = "Ошибка сохранения руководителя должности: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("АИС.Симулятор", УровеньЖурналаРегистрации.Ошибка,,, Текст);
		Ответ.УстановитьТелоИзСтроки(Текст);
		Ответ.КодСостояния = 400;
	КонецПопытки;

	Возврат Ответ;
КонецФункции

