// POST /hs/ais-sim/documents/restore
// Снимает пометку удаления и признак "Не действует" с документа.
// Восстановление исторических документов/переписки из архивной базы.
Функция ВосстановитьДокумент_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Попытка
		ТелоКакСтрока = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоКакСтрока);
		Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();
		УстановитьПривилегированныйРежим(Истина);
		Если Не ЭтоПривилегированныйПользователь() Тогда
			Ответ.КодСостояния = 403;
			Ответ.УстановитьТелоИзСтроки("Восстановление документов доступно администратору");
			Возврат Ответ;
		КонецЕсли;
		Ид = "";
		Данные.Свойство("Документ", Ид);
		Ссылка = Справочники.ВнутренниеДокументы.ПолучитьСсылку(
			Новый УникальныйИдентификатор(Ид));
		Объект = Ссылка.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			Ответ.КодСостояния = 404;
			Ответ.УстановитьТелоИзСтроки("Документ не найден");
			Возврат Ответ;
		КонецЕсли;
		Объект.ПометкаУдаления = Ложь;
		Объект.НеДействует = Ложь;
		Объект.Записать();
		Попытка
			АИС_ИндексацияДокументов.ПоставитьВОчередь(Ссылка, "Восстановление документа");
		Исключение
		КонецПопытки;
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписатьСвойствоСтрокой(ЗаписьJSON, "Документ", Ид);
		ЗаписьJSON.ЗаписатьИмяСвойства("Восстановлен");
		ЗаписьJSON.ЗаписатьЗначение(Истина);
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Ответ.КодСостояния = 400;
		Ответ.УстановитьТелоИзСтроки("Ошибка восстановления: " + ОписаниеОшибки());
	КонецПопытки;
	Возврат Ответ;
КонецФункции

