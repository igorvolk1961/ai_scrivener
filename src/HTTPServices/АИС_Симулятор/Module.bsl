// GET /hs/ais-sim/indexing?action=configure|enable|disable|status|errors|probe|types|index_one|reconcile|process&max=20
// Административный запуск индексации RAG: полная сверка ставит документы
// в очередь, process разбирает очередь. Доступен только с правами
// администратора/сервисного пользователя.
Функция Индексация_GET(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Попытка
		УстановитьПривилегированныйРежим(Истина);
		// Управление индексацией RAG (включая исключение/публикацию)
		// доступно только администраторам и сервисному пользователю.
		Если Не ЭтоПривилегированныйПользователь() Тогда
			Ответ.КодСостояния = 403;
			Ответ.УстановитьТелоИзСтроки("{""error"":""Недостаточно прав для управления индексацией RAG""}");
			Возврат Ответ;
		КонецЕсли;
		ЗначениеДействие = Запрос.ПараметрыЗапроса.Получить("action");
		Действие = "";
		Если ЗначениеДействие <> Неопределено Тогда
			Действие = НРег(СокрЛП(Строка(ЗначениеДействие)));
		КонецЕсли;
		Если ПустаяСтрока(Действие) Тогда
			Действие = "process";
		КонецЕсли;

		Если Действие = "configure" Тогда
			URL = Запрос.ПараметрыЗапроса.Получить("url");
			TIMEOUT = Запрос.ПараметрыЗапроса.Получить("timeout");
			RETRIES = Запрос.ПараметрыЗапроса.Получить("retries");
			Если URL <> Неопределено Тогда
				Константы.АИС_АдресRAGСервиса.Установить(Строка(URL));
			КонецЕсли;
			Если TIMEOUT <> Неопределено Тогда
				Константы.АИС_ТаймаутRAGСервиса.Установить(Число(TIMEOUT));
			КонецЕсли;
			Если RETRIES <> Неопределено Тогда
				Константы.АИС_ПовторыRAGСервиса.Установить(Число(RETRIES));
			КонецЕсли;
			Ответ.УстановитьТелоИзСтроки("{""action"":""configure"",""ok"":true}");
			Возврат Ответ;
		КонецЕсли;

		Если Действие = "enable" ИЛИ Действие = "disable" Тогда
			Включено = Действие = "enable";
			Константы.АИС_ИндексацияRAGВключена.Установить(Включено);
			Ответ.УстановитьТелоИзСтроки(
				"{""action"":""" + Действие + """,""enabled"":" + ?(Включено, "true", "false") + "}");
			Возврат Ответ;
		КонецЕсли;

		Если Не Константы.АИС_ИндексацияRAGВключена.Получить() Тогда
			Ответ.КодСостояния = 409;
			Ответ.УстановитьТелоИзСтроки("{""error"":""Индексация RAG выключена""}");
			Возврат Ответ;
		КонецЕсли;

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписьJSON.ЗаписатьИмяСвойства("action");
		ЗаписьJSON.ЗаписатьЗначение(Действие);

		Если Действие = "probe" Тогда
			Ид = Запрос.ПараметрыЗапроса.Получить("id");
			Ссылка = Справочники.ВнутренниеДокументы.ПолучитьСсылку(
				Новый УникальныйИдентификатор(Ид));
			Тип = АИС_ИндексацияДокументов.ТипИсточникаПоДокументу(Ссылка);
			Мета = Метаданные.НайтиПоТипу(ТипЗнч(Ссылка));
			ЗаписьJSON.ЗаписатьИмяСвойства("id");
			ЗаписьJSON.ЗаписатьЗначение(Ид);
			ЗаписьJSON.ЗаписатьИмяСвойства("type");
			ЗаписьJSON.ЗаписатьЗначение(Тип);
			ЗаписьJSON.ЗаписатьИмяСвойства("valueType");
			ЗаписьJSON.ЗаписатьЗначение(Строка(ТипЗнч(Ссылка)));
			ЗаписьJSON.ЗаписатьИмяСвойства("metadataFound");
			ЗаписьJSON.ЗаписатьЗначение(Мета <> Неопределено);
			ЗаписьJSON.ЗаписатьИмяСвойства("metadataName");
			ЗаписьJSON.ЗаписатьЗначение(?(Мета = Неопределено, "", Мета.Имя));
			Попытка
				АИС_ИндексацияДокументов.ПоставитьВОчередь(Ссылка, "probe");
				ЗаписьJSON.ЗаписатьИмяСвойства("queued");
				ЗаписьJSON.ЗаписатьЗначение(Истина);
			Исключение
				ЗаписьJSON.ЗаписатьИмяСвойства("queued");
				ЗаписьJSON.ЗаписатьЗначение(Ложь);
				ЗаписьJSON.ЗаписатьИмяСвойства("error");
				ЗаписьJSON.ЗаписатьЗначение(ОписаниеОшибки());
			КонецПопытки;
		ИначеЕсли Действие = "types" Тогда
			Ид = Запрос.ПараметрыЗапроса.Получить("id");
			Ссылка = Справочники.ВнутренниеДокументы.ПолучитьСсылку(
				Новый УникальныйИдентификатор(Ид));
			Снимок = АИС_ИндексацияДокументов.СобратьСнимок(Ссылка);
			ЗаписьJSON.ЗаписатьИмяСвойства("sourceType");
			ЗаписьJSON.ЗаписатьЗначение(Снимок.ТипИсточника);
			ЗаписьJSON.ЗаписатьИмяСвойства("sourceIdType");
			ЗаписьJSON.ЗаписатьЗначение(Строка(ТипЗнч(Снимок.ИсточникID)));
			ЗаписьJSON.ЗаписатьИмяСвойства("aclType");
			ЗаписьJSON.ЗаписатьЗначение(Строка(ТипЗнч(Снимок.ACLПринципалы)));
			ЗаписьJSON.ЗаписатьИмяСвойства("aclCount");
			ЗаписьJSON.ЗаписатьЗначение(?(ТипЗнч(Снимок.ACLПринципалы) = Тип("Массив"), Снимок.ACLПринципалы.Количество(), -1));
			ЗаписьJSON.ЗаписатьИмяСвойства("denyType");
			ЗаписьJSON.ЗаписатьЗначение(Строка(ТипЗнч(Снимок.ACLЗапреты)));
			ЗаписьJSON.ЗаписатьИмяСвойства("metadataType");
			ЗаписьJSON.ЗаписатьЗначение(Строка(ТипЗнч(Снимок.Метаданные)));
			ЗаписьJSON.ЗаписатьИмяСвойства("textType");
			ЗаписьJSON.ЗаписатьЗначение(Строка(ТипЗнч(Снимок.Текст)));
			ЗаписьJSON.ЗаписатьИмяСвойства("textLength");
			ЗаписьJSON.ЗаписатьЗначение(?(ТипЗнч(Снимок.Текст) = Тип("Строка"), СтрДлина(Снимок.Текст), -1));
			ЗаписьJSON.ЗаписатьИмяСвойства("fileType");
			ЗаписьJSON.ЗаписатьЗначение(Строка(ТипЗнч(Снимок.Файл)));
		ИначеЕсли Действие = "index_one" Тогда
			Ид = Запрос.ПараметрыЗапроса.Получить("id");
			Ссылка = Справочники.ВнутренниеДокументы.ПолучитьСсылку(
				Новый УникальныйИдентификатор(Ид));
			Снимок = АИС_ИндексацияДокументов.СобратьСнимок(Ссылка);
			РезультатИндексации = АИС_ИнтеграцияСRAG.ЗагрузитьДокумент(
				Снимок,
				Снимок.Текст,
				Снимок.Файл);
			ЗаписьJSON.ЗаписатьИмяСвойства("sourceId");
			ЗаписьJSON.ЗаписатьЗначение(Снимок.ИсточникID);
			ЗаписьJSON.ЗаписатьИмяСвойства("chunks");
			ЗаписьJSON.ЗаписатьЗначение(РезультатИндексации.КоличествоЧанков);
			ЗаписьJSON.ЗаписатьИмяСвойства("requiresOcr");
			ЗаписьJSON.ЗаписатьЗначение(РезультатИндексации.ТребуетсяOCR);
		ИначеЕсли Действие = "status" Тогда
			ЗапросСостояний = Новый Запрос;
			ЗапросСостояний.Текст =
			"ВЫБРАТЬ
			|	Состояния.ТипИсточника КАК Тип,
			|	Состояния.Состояние КАК Состояние,
			|	КОЛИЧЕСТВО(*) КАК Количество
			|ИЗ
			|	РегистрСведений.АИС_СостоянияИндексации КАК Состояния
			|СГРУППИРОВАТЬ ПО
			|	Состояния.ТипИсточника,
			|	Состояния.Состояние";
			ВыборкаСостояний = ЗапросСостояний.Выполнить().Выбрать();
			ЗаписьJSON.ЗаписатьИмяСвойства("states");
			ЗаписьJSON.ЗаписатьНачалоМассива();
			Пока ВыборкаСостояний.Следующий() Цикл
				ЗаписьJSON.ЗаписатьНачалоОбъекта();
				ЗаписьJSON.ЗаписатьИмяСвойства("type");
				ЗаписьJSON.ЗаписатьЗначение(ВыборкаСостояний.Тип);
				ЗаписьJSON.ЗаписатьИмяСвойства("state");
				ЗаписьJSON.ЗаписатьЗначение(ВыборкаСостояний.Состояние);
				ЗаписьJSON.ЗаписатьИмяСвойства("count");
				ЗаписьJSON.ЗаписатьЗначение(ВыборкаСостояний.Количество);
				ЗаписьJSON.ЗаписатьКонецОбъекта();
			КонецЦикла;
			ЗаписьJSON.ЗаписатьКонецМассива();
		ИначеЕсли Действие = "errors" Тогда
			ЗапросОшибок = Новый Запрос;
			ЗапросОшибок.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 20
			|	Состояния.ТипИсточника КАК Тип,
			|	Состояния.Идентификатор КАК Идентификатор,
			|	Состояния.Ошибка КАК Ошибка
			|ИЗ
			|	РегистрСведений.АИС_СостоянияИндексации КАК Состояния
			|ГДЕ
			|	Состояния.Состояние = &Ошибка
			|УПОРЯДОЧИТЬ ПО
			|	Состояния.ДатаПостановки ВОЗР";
			ЗапросОшибок.УстановитьПараметр("Ошибка", "Ошибка");
			ВыборкаОшибок = ЗапросОшибок.Выполнить().Выбрать();
			ЗаписьJSON.ЗаписатьИмяСвойства("errors");
			ЗаписьJSON.ЗаписатьНачалоМассива();
			Пока ВыборкаОшибок.Следующий() Цикл
				ЗаписьJSON.ЗаписатьНачалоОбъекта();
				ЗаписьJSON.ЗаписатьИмяСвойства("type");
				ЗаписьJSON.ЗаписатьЗначение(ВыборкаОшибок.Тип);
				ЗаписьJSON.ЗаписатьИмяСвойства("id");
				ЗаписьJSON.ЗаписатьЗначение(ВыборкаОшибок.Идентификатор);
				ЗаписьJSON.ЗаписатьИмяСвойства("error");
				ЗаписьJSON.ЗаписатьЗначение(ВыборкаОшибок.Ошибка);
				ЗаписьJSON.ЗаписатьКонецОбъекта();
			КонецЦикла;
			ЗаписьJSON.ЗаписатьКонецМассива();
		ИначеЕсли Действие = "reconcile" Тогда
			Количество = АИС_ИндексацияДокументов.ПолнаяСверка();
			ЗаписьJSON.ЗаписатьИмяСвойства("queued");
			ЗаписьJSON.ЗаписатьЗначение(Количество);
		ИначеЕсли Действие = "process" Тогда
			Максимум = 20;
			ЗначениеМаксимум = Запрос.ПараметрыЗапроса.Получить("max");
			Если ЗначениеМаксимум <> Неопределено Тогда
				Попытка
					Максимум = Число(ЗначениеМаксимум);
				Исключение
					Максимум = 20;
				КонецПопытки;
			КонецЕсли;
			Если Максимум <= 0 Тогда
				Максимум = 20;
			КонецЕсли;
			Итоги = АИС_ИндексацияДокументов.РазобратьОчередь(Максимум);
			ЗаписьJSON.ЗаписатьИмяСвойства("processed");
			ЗаписьJSON.ЗаписатьЗначение(Итоги.Обработано);
			ЗаписьJSON.ЗаписатьИмяСвойства("actualized");
			ЗаписьJSON.ЗаписатьЗначение(Итоги.Актуализировано);
			ЗаписьJSON.ЗаписатьИмяСвойства("excluded");
			ЗаписьJSON.ЗаписатьЗначение(Итоги.Исключено);
			ЗаписьJSON.ЗаписатьИмяСвойства("errors");
			ЗаписьJSON.ЗаписатьЗначение(Итоги.Ошибок);
		ИначеЕсли Действие = "report" Тогда
			// Миграционный отчёт: сколько документов по видам/состояниям
			// являются финальными, сколько нет и у кого включён флаг публикации.
			ЗапросОтчета = Новый Запрос;
			ЗапросОтчета.Текст =
			"ВЫБРАТЬ
			|	Документы.Ссылка КАК Ссылка,
			|	Документы.ВидДокумента КАК Вид,
			|	Документы.АИС_ПубликоватьВRAG КАК Публиковать
			|ИЗ
			|	Справочник.ВнутренниеДокументы КАК Документы
			|ГДЕ
			|	НЕ Документы.ПометкаУдаления";
			ВыборкаОтчета = ЗапросОтчета.Выполнить().Выбрать();
			Группы = Новый Соответствие;
			Всего = 0;
			Пока ВыборкаОтчета.Следующий() Цикл
				Всего = Всего + 1;
				Финальность = АИС_ИндексацияДокументов.ФинальноеСостояние(ВыборкаОтчета.Ссылка);
				Вид = СокрЛП(Строка(ВыборкаОтчета.Вид));
				Если ПустаяСтрока(Вид) Тогда
					Вид = "(без вида)";
				КонецЕсли;
				Состояние = Финальность.Состояние;
				Если ПустаяСтрока(Состояние) Тогда
					Состояние = "(пусто)";
				КонецЕсли;
				Ключ = Вид + "|" + Состояние + "|" + ?(Финальность.Финальный, "1", "0")
					+ "|" + ?(Финальность.ПубликацияПоФлагу, "1", "0");
				Текущее = Группы.Получить(Ключ);
				Если Текущее = Неопределено Тогда
					Текущее = Новый Структура("Вид,Состояние,Финальный,Публикация,Количество",
						Вид, Состояние, Финальность.Финальный, Финальность.ПубликацияПоФлагу, 0);
					Группы.Вставить(Ключ, Текущее);
				КонецЕсли;
				Текущее.Количество = Текущее.Количество + 1;
			КонецЦикла;
			ЗаписьJSON.ЗаписатьИмяСвойства("total");
			ЗаписьJSON.ЗаписатьЗначение(Всего);
			ЗаписьJSON.ЗаписатьИмяСвойства("rows");
			ЗаписьJSON.ЗаписатьНачалоМассива();
			Для Каждого Группа Из Группы Цикл
				ЗаписьJSON.ЗаписатьНачалоОбъекта();
				ЗаписьJSON.ЗаписатьИмяСвойства("docType");
				ЗаписьJSON.ЗаписатьЗначение(Группа.Значение.Вид);
				ЗаписьJSON.ЗаписатьИмяСвойства("state");
				ЗаписьJSON.ЗаписатьЗначение(Группа.Значение.Состояние);
				ЗаписьJSON.ЗаписатьИмяСвойства("final");
				ЗаписьJSON.ЗаписатьЗначение(Группа.Значение.Финальный);
				ЗаписьJSON.ЗаписатьИмяСвойства("publishFlag");
				ЗаписьJSON.ЗаписатьЗначение(Группа.Значение.Публикация);
				ЗаписьJSON.ЗаписатьИмяСвойства("count");
				ЗаписьJSON.ЗаписатьЗначение(Группа.Значение.Количество);
				ЗаписьJSON.ЗаписатьКонецОбъекта();
			КонецЦикла;
			ЗаписьJSON.ЗаписатьКонецМассива();
		ИначеЕсли Действие = "publish" Тогда
			Ид = Запрос.ПараметрыЗапроса.Получить("id");
			Значение = Запрос.ПараметрыЗапроса.Получить("value");
			Публиковать = Истина;
			Если Значение <> Неопределено Тогда
				Публиковать = Не (НРег(СокрЛП(Строка(Значение))) = "0"
					ИЛИ НРег(СокрЛП(Строка(Значение))) = "false"
					ИЛИ НРег(СокрЛП(Строка(Значение))) = "нет"
					ИЛИ НРег(СокрЛП(Строка(Значение))) = "ложь");
			КонецЕсли;
			Ссылка = Справочники.ВнутренниеДокументы.ПолучитьСсылку(
				Новый УникальныйИдентификатор(Ид));
			Объект = Ссылка.ПолучитьОбъект();
			Если Объект = Неопределено Тогда
				ВызватьИсключение "Документ не найден: " + Ид;
			КонецЕсли;
			Объект.АИС_ПубликоватьВRAG = Публиковать;
			Объект.Записать();
			ЗаписьJSON.ЗаписатьИмяСвойства("id");
			ЗаписьJSON.ЗаписатьЗначение(Ид);
			ЗаписьJSON.ЗаписатьИмяСвойства("publishFlag");
			ЗаписьJSON.ЗаписатьЗначение(Публиковать);
		Иначе
			Ответ.КодСостояния = 400;
			Ответ.УстановитьТелоИзСтроки("{""error"":""Неизвестное действие. Ожидается reconcile, process, report или publish""}");
			Возврат Ответ;
		КонецЕсли;

		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Ответ.КодСостояния = 500;
		Ответ.УстановитьТелоИзСтроки("{""error"":""" + СтрЗаменить(ОписаниеОшибки(), """", "'") + """}");
	КонецПопытки;

	Возврат Ответ;
КонецФункции

#КонецОбласти
