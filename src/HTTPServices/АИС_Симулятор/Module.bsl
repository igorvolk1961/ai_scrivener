// POST /hs/ais-sim/drafts/send
// Тело: {"Черновик":"<uuid>", "Текст":"..."}
Функция ОтправитьЧерновик_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Автор = ТекущийПользовательСправочника();
		Данные = ПрочитатьJSONИзЗапроса(Запрос);
		Ид = "";
		Данные.Свойство("Черновик", Ид);
		СсылкаЧерновика = Справочники.АИС_ЧерновикиДокументов.ПолучитьСсылку(
			Новый УникальныйИдентификатор(Строка(Ид)));
			Черновик = СсылкаЧерновика.ПолучитьОбъект();
		Если Черновик = Неопределено Тогда
			Ответ.КодСостояния = 404;
			Ответ.УстановитьТелоИзСтроки("Черновик не найден");
			Возврат Ответ;
		КонецЕсли;
		Если Черновик.Автор <> Автор Тогда
			Ответ.КодСостояния = 403;
			Ответ.УстановитьТелоИзСтроки("Отправлять чужой черновик запрещено");
			Возврат Ответ;
		КонецЕсли;
		Если Черновик.Статус = "sent" ИЛИ Черновик.Статус = "rejected" Тогда
			Ответ.КодСостояния = 409;
			Ответ.УстановитьТелоИзСтроки("Черновик уже отправлен или отклонён");
			Возврат Ответ;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Черновик.Адресат) Тогда
			Ответ.КодСостояния = 400;
			Ответ.УстановитьТелоИзСтроки("У черновика не указан адресат");
			Возврат Ответ;
		КонецЕсли;
		Текст = "";
		Данные.Свойство("Текст", Текст);
		Если ПустаяСтрока(Текст) Тогда
			Текст = Черновик.Содержание;
		КонецЕсли;

		Объект = Справочники.ВнутренниеДокументы.СоздатьЭлемент();
		Объект.ОбработкаЗаполнения(Неопределено, Ложь);
		Объект.Подготовил = Черновик.Автор;
		Объект.ВидДокумента = Черновик.ВидДокумента;
		Объект.Заголовок = Черновик.Заголовок;
		Объект.Содержание = Текст;
		Объект.Адресат = Черновик.Адресат;
		Объект.Записать();

		СвязьУстановлена = Ложь;
		Если ЗначениеЗаполнено(Черновик.Основание) Тогда
			СвязьУстановлена = АИС_ОбщегоНазначения.СоздатьСвязьДокументаСОснованием(
				Объект.Ссылка, Черновик.Основание);
		КонецЕсли;

		Черновик.Содержание = Текст;
		Черновик.Статус = "sent";
		Черновик.Записать();

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписатьСвойствоСтрокой(ЗаписьJSON, "status", "sent");
		ЗаписатьСвойствоСтрокой(
			ЗаписьJSON, "document_id", Строка(Объект.Ссылка.УникальныйИдентификатор()));
		ЗаписьJSON.ЗаписатьИмяСвойства("link_created");
		ЗаписьJSON.ЗаписатьЗначение(СвязьУстановлена);
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Ответ.КодСостояния = 400;
		Ответ.УстановитьТелоИзСтроки("{""error"":""" + СтрЗаменить(ОписаниеОшибки(), """", "'") + """}");
	КонецПопытки;
	Возврат Ответ;
КонецФункции

// POST /hs/ais-sim/drafts/rework
// Тело: {"Черновик":"<uuid>", "Замечания":"..."}
Функция ВернутьЧерновикНаДоработку_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Данные = ПрочитатьJSONИзЗапроса(Запрос);
		Ид = "";
		Данные.Свойство("Черновик", Ид);
		СсылкаЧерновика = Справочники.АИС_ЧерновикиДокументов.ПолучитьСсылку(
			Новый УникальныйИдентификатор(Строка(Ид)));
			Черновик = СсылкаЧерновика.ПолучитьОбъект();
		Если Черновик = Неопределено Тогда
			Ответ.КодСостояния = 404;
