// GET /hs/ais-sim/mailings
Функция ПолучитьРассылки_GET(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Запрос1 = Новый Запрос;
		Запрос1.Текст =
		"ВЫБРАТЬ
		|	Рассылки.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.АИС_Рассылки КАК Рассылки
		|ГДЕ
		|	НЕ Рассылки.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Рассылки.ДатаОтправки УБЫВ";
		Выборка = Запрос1.Выполнить().Выбрать();
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоМассива();
		Пока Выборка.Следующий() Цикл
			Объект = Выборка.Ссылка.ПолучитьОбъект();
			Получатели = АИС_Рассылки.ПолучателиРассылки(Выборка.Ссылка);
			Получено = 0;
			Отказов = 0;
			Ожидает = 0;
			НетОтвета = 0;
			Поздно = 0;
			Для Каждого Стр Из Получатели Цикл
				Статус = НРег(Строка(Стр.status));
				Если Статус = "получено" ИЛИ Статус = "неполно" Тогда
					Получено = Получено + 1;
				ИначеЕсли Статус = "отказ" Тогда
					Отказов = Отказов + 1;
				ИначеЕсли Статус = "нетответа" Тогда
					НетОтвета = НетОтвета + 1;
				ИначеЕсли Статус = "поздно" Тогда
					Поздно = Поздно + 1;
				Иначе
					Ожидает = Ожидает + 1;
				КонецЕсли;
			КонецЦикла;
			ЗаписьJSON.ЗаписатьНачалоОбъекта();
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "id", Строка(Выборка.Ссылка.УникальныйИдентификатор()));
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "title", Объект.Наименование);
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "type", Строка(Объект.ТипРассылки));
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "status", Объект.Статус);
			ЗаписатьСвойствоСтрокой(ЗаписьJSON, "deadline", Строка(Объект.СрокОтвета));
			ЗаписьJSON.ЗаписатьИмяСвойства("total");
			ЗаписьJSON.ЗаписатьЗначение(Получатели.Количество());
			ЗаписьJSON.ЗаписатьИмяСвойства("received");
			ЗаписьJSON.ЗаписатьЗначение(Получено);
			ЗаписьJSON.ЗаписатьИмяСвойства("declined");
			ЗаписьJSON.ЗаписатьЗначение(Отказов);
			ЗаписьJSON.ЗаписатьИмяСвойства("pending");
			ЗаписьJSON.ЗаписатьЗначение(Ожидает);
			ЗаписьJSON.ЗаписатьИмяСвойства("noanswer");
			ЗаписьJSON.ЗаписатьЗначение(НетОтвета);
			ЗаписьJSON.ЗаписатьИмяСвойства("late");
			ЗаписьJSON.ЗаписатьЗначение(Поздно);
			ЗаписьJSON.ЗаписатьКонецОбъекта();
		КонецЦикла;
		ЗаписьJSON.ЗаписатьКонецМассива();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Ответ.КодСостояния = 400;
		Ответ.УстановитьТелоИзСтроки("{""error"":""" + СтрЗаменить(ОписаниеОшибки(), """", "'") + """}");
	КонецПопытки;
	Возврат Ответ;
КонецФункции

