// POST /hs/ais-sim/incoming-documents
Функция СоздатьВходящийДокумент_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(201);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		Данные = ПрочитатьJSONИзЗапроса(Запрос);
		Заголовок = СокрЛП(Строка(Данные.Заголовок));
		Если ПустаяСтрока(Заголовок) Тогда
			ВызватьИсключение "Не указан заголовок входящего документа";
		КонецЕсли;
		ВидИмя = "Письмо";
		Данные.Свойство("Вид", ВидИмя);
		Если ВидИмя = Неопределено ИЛИ ПустаяСтрока(Строка(ВидИмя)) Тогда
			ВидИмя = "Письмо";
		КонецЕсли;
		Вид = АИС_ОбщегоНазначения.НайтиИлиСоздатьЭлемент(
			Справочники.ВидыВходящихДокументов, ВидИмя);
		Если Не ЗначениеЗаполнено(Вид.СпособНумерации) Тогда
			Вид.СпособНумерации = Перечисления.СпособыНумерации.Автоматически;
		КонецЕсли;
		Вид.Записать();

		Организация = Справочники.Организации.НайтиПоНаименованию("ООО «Дело в шляпе»", Истина);
		Если Не ЗначениеЗаполнено(Организация) Тогда
			ВыборкаОрганизаций = Справочники.Организации.Выбрать();
			Если ВыборкаОрганизаций.Следующий() Тогда
				Организация = ВыборкаОрганизаций.Ссылка;
			КонецЕсли;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Организация) Тогда
			ВызватьИсключение "Не найдена организация для входящего документа";
		КонецЕсли;

		ОтправительИд = "";
		Данные.Свойство("Отправитель", ОтправительИд);
		Отправитель = Неопределено;
		Если ОтправительИд <> Неопределено И Не ПустаяСтрока(Строка(ОтправительИд)) Тогда
			Попытка
				Отправитель = Справочники.Контрагенты.ПолучитьСсылку(
					Новый УникальныйИдентификатор(Строка(ОтправительИд)));
				Если Отправитель.ПолучитьОбъект() = Неопределено Тогда
					Отправитель = Неопределено;
				КонецЕсли;
			Исключение
				Отправитель = Неопределено;
			КонецПопытки;
			Если Не ЗначениеЗаполнено(Отправитель) Тогда
				Отправитель = Справочники.Контрагенты.НайтиПоНаименованию(
					Строка(ОтправительИд), Истина);
			КонецЕсли;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Отправитель) Тогда
			ВызватьИсключение "Не найден отправитель входящего документа";
		КонецЕсли;

		Ответственный = ТекущийПользовательСправочника();
		ОтветственныйЛогин = "";
		Данные.Свойство("Ответственный", ОтветственныйЛогин);
		Если ОтветственныйЛогин <> Неопределено И Не ПустаяСтрока(Строка(ОтветственныйЛогин)) Тогда
			Ответственный = Справочники.Пользователи.НайтиПоНаименованию(
				Строка(ОтветственныйЛогин), Истина);
		КонецЕсли;

		Объект = Справочники.ВходящиеДокументы.СоздатьЭлемент();
		Объект.ВидДокумента = Вид.Ссылка;
		Объект.Заголовок = Заголовок;
		Объект.Содержание = Строка(Данные.Содержание);
		Объект.Организация = Организация;
		Объект.Ответственный = Ответственный;
		Объект.Отправитель = Отправитель;
		Объект.ДатаСоздания = ТекущаяДатаСеанса();
		Объект.ИсходящаяДата = ТекущаяДатаСеанса();
		ИсходящийНомер = "";
		Данные.Свойство("ИсходящийНомер", ИсходящийНомер);
		Если ИсходящийНомер <> Неопределено Тогда
			Объект.ИсходящийНомер = Строка(ИсходящийНомер);
		КонецЕсли;
		Объект.Записать();

		Основание = ОпределитьОснованиеНовогоДокумента(Данные);
		СвязьУстановлена = Ложь;
		Если ЗначениеЗаполнено(Основание) Тогда
			СвязьУстановлена = АИС_ОбщегоНазначения.СоздатьСвязьДокументаСОснованием(
				Объект.Ссылка, Основание);
		КонецЕсли;

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписатьСвойствоСтрокой(ЗаписьJSON, "status", "создан");
		ЗаписатьСвойствоСтрокой(ЗаписьJSON, "id", Строка(Объект.Ссылка.УникальныйИдентификатор()));
		ЗаписатьСвойствоСтрокой(ЗаписьJSON, "title", Объект.Заголовок);
		ЗаписатьСвойствоСтрокой(ЗаписьJSON, "sender", Объект.Отправитель.Наименование);
		ЗаписьJSON.ЗаписатьИмяСвойства("link_created");
		ЗаписьJSON.ЗаписатьЗначение(СвязьУстановлена);
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Ответ.КодСостояния = 400;
		Ответ.УстановитьТелоИзСтроки("{""error"":""" + СтрЗаменить(ОписаниеОшибки(), """", "'") + """}");
	КонецПопытки;
	Возврат Ответ;
КонецФункции

