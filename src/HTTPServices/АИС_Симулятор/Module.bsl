		КонецЕсли;
		Если ТипЗнч(Лимит) <> Тип("Число") ИЛИ Лимит <= 0 Тогда
			Лимит = 1;
		КонецЕсли;
		УстановитьПривилегированныйРежим(Истина);
		АИС_АгентИИ.ОбработатьОчередь(Лимит);
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписатьСвойствоСтрокой(ЗаписьJSON, "status", "ok");
		ЗаписьJSON.ЗаписатьИмяСвойства("limit");
		ЗаписьJSON.ЗаписатьЗначение(Лимит);
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Ответ.КодСостояния = 500;
		Ответ.УстановитьТелоИзСтроки("{""error"":""" + СтрЗаменить(ОписаниеОшибки(), """", "'") + """}");
	КонецПопытки;
	Возврат Ответ;
КонецФункции

Функция ПовторитьЗапускиАгента_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		ЗапросЗапусков = Новый Запрос;
		ЗапросЗапусков.Текст =
			"ВЫБРАТЬ
			|	Запуски.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.АИС_ЗапускиАгентов КАК Запуски
			|ГДЕ
			|	Запуски.Состояние В (&Ошибка, &Внимание, &Истек)
			|	ИЛИ Запуски.Заблокирован";
		ЗапросЗапусков.УстановитьПараметр("Ошибка", Перечисления.АИС_СостоянияЗапусковАгента.Ошибка);
		ЗапросЗапусков.УстановитьПараметр("Внимание", Перечисления.АИС_СостоянияЗапусковАгента.ТребуетВнимания);
		ЗапросЗапусков.УстановитьПараметр("Истек", Перечисления.АИС_СостоянияЗапусковАгента.Истек);
		Выборка = ЗапросЗапусков.Выполнить().Выбрать();
		Количество = 0;
		Пока Выборка.Следующий() Цикл
			Объект = Выборка.Ссылка.ПолучитьОбъект();
			Если Объект = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Объект.Состояние = Перечисления.АИС_СостоянияЗапусковАгента.Ожидает;
			Объект.Шаг = 0;
			Объект.СообщенияJSON = "[]";
			Объект.ОдобрениеJSON = "";
			Объект.ФлагиПоискаJSON = "";
			Объект.МаксШагов = 40;
			Объект.Попытки = 0;
			Объект.Ошибка = "";
			Объект.Заблокирован = Ложь;
			Объект.СледующаяПопытка = ТекущаяДатаСеанса();
			Объект.ДатаОбновления = ТекущаяДатаСеанса();
			Объект.Записать();
			Количество = Количество + 1;
		КонецЦикла;
		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписатьСвойствоСтрокой(ЗаписьJSON, "status", "ok");
		ЗаписьJSON.ЗаписатьИмяСвойства("count");
		ЗаписьJSON.ЗаписатьЗначение(Количество);
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Ответ.КодСостояния = 500;
		Ответ.УстановитьТелоИзСтроки("{""error"":""" + СтрЗаменить(ОписаниеОшибки(), """", "'") + """}");
	КонецПопытки;
	Возврат Ответ;
КонецФункции

Функция ПересоздатьЗапускиАгента_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Попытка
		УстановитьПривилегированныйРежим(Истина);
		ЗапросЗапусков = Новый Запрос;
		ЗапросЗапусков.Текст =
			"ВЫБРАТЬ
			|	Запуски.Ссылка КАК Ссылка,
			|	Запуски.Задача КАК Задача
			|ИЗ
			|	Справочник.АИС_ЗапускиАгентов КАК Запуски";
		ВыборкаЗапусков = ЗапросЗапусков.Выполнить().Выбрать();
		Запуски = Новый Массив;
		ЗадачиЗапусков = Новый Массив;
		Пока ВыборкаЗапусков.Следующий() Цикл
			Запуски.Добавить(ВыборкаЗапусков.Ссылка);
			Если ЗначениеЗаполнено(ВыборкаЗапусков.Задача)
				И ЗадачиЗапусков.Найти(ВыборкаЗапусков.Задача) = Неопределено Тогда
				ЗадачиЗапусков.Добавить(ВыборкаЗапусков.Задача);
			КонецЕсли;
		КонецЦикла;

		УдаленоВзаимодействий = 0;
		Для Каждого Запуск Из Запуски Цикл
			ЗапросВзаимодействий = Новый Запрос;
			ЗапросВзаимодействий.Текст =
				"ВЫБРАТЬ
				|	Взаимодействия.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.АИС_ВзаимодействияИИ КАК Взаимодействия
				|ГДЕ
				|	Взаимодействия.Запуск = &Запуск";
			ЗапросВзаимодействий.УстановитьПараметр("Запуск", Запуск);
			ВыборкаВзаимодействий = ЗапросВзаимодействий.Выполнить().Выбрать();
			Пока ВыборкаВзаимодействий.Следующий() Цикл
				Взаимодействие = ВыборкаВзаимодействий.Ссылка.ПолучитьОбъект();
				Если Взаимодействие = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				Если ЗначениеЗаполнено(Взаимодействие.ЗадачаУведомление) Тогда
					ЗадачаУведомление = Взаимодействие.ЗадачаУведомление.ПолучитьОбъект();
					Если ЗадачаУведомление <> Неопределено Тогда
						ЗадачаУведомление.Выполнена = Истина;
						ЗадачаУведомление.РезультатВыполнения = "Удалено при отладке";
						ЗадачаУведомление.Записать();
					КонецЕсли;
				КонецЕсли;
				Взаимодействие.Удалить();
				УдаленоВзаимодействий = УдаленоВзаимодействий + 1;
			КонецЦикла;
		КонецЦикла;

		Для Каждого Запуск Из Запуски Цикл
			Объект = Запуск.ПолучитьОбъект();
			Если Объект <> Неопределено Тогда
				Объект.Удалить();
			КонецЕсли;
		КонецЦикла;

		НовыеЗапуски = Новый Массив;
		Для Каждого Задача Из ЗадачиЗапусков Цикл
			НовыйЗапуск = АИС_АгентИИ.ПередатьЗадачуВОчередь(Задача, "ПересозданиеПослеОтладки");
			Если Не ЗначениеЗаполнено(НовыйЗапуск) Тогда
				Продолжить;
			КонецЕсли;
			ОбъектЗапуска = НовыйЗапуск.ПолучитьОбъект();
			Если ОбъектЗапуска <> Неопределено Тогда
				ОбъектЗапуска.МаксШагов = 40;
				ОбъектЗапуска.Записать();
			КонецЕсли;
			НовыеЗапуски.Добавить(НовыйЗапуск);
		КонецЦикла;

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписатьСвойствоСтрокой(ЗаписьJSON, "status", "ok");
		ЗаписьJSON.ЗаписатьИмяСвойства("deleted_runs");
		ЗаписьJSON.ЗаписатьЗначение(Запуски.Количество());
		ЗаписьJSON.ЗаписатьИмяСвойства("deleted_interactions");
		ЗаписьJSON.ЗаписатьЗначение(УдаленоВзаимодействий);
		ЗаписьJSON.ЗаписатьИмяСвойства("new_runs");
		ЗаписьJSON.ЗаписатьНачалоМассива();
		Для Каждого НовыйЗапуск Из НовыеЗапуски Цикл
			ЗаписьJSON.ЗаписатьНачалоОбъекта();
			ЗаписатьСвойствоСтрокой(
				ЗаписьJSON, "run", Строка(НовыйЗапуск.УникальныйИдентификатор()));
			ЗаписьJSON.ЗаписатьКонецОбъекта();
		КонецЦикла;
		ЗаписьJSON.ЗаписатьКонецМассива();
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Ответ.КодСостояния = 500;
		Ответ.УстановитьТелоИзСтроки("{""error"":""" + СтрЗаменить(ОписаниеОшибки(), """", "'") + """}");
	КонецПопытки;
	Возврат Ответ;
КонецФункции

Функция ВозобновитьЗапуск_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Попытка
