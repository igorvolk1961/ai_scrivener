#Область СлужебныеПроцедурыИФункции

// POST /hs/ais-sim/employees
// Тело запроса (JSON):
//  {"Имя": "...", "ФИО": "...", "Должность": "...", "Роли": ["..."],
//   "Пароль": "...", "Руководитель": "..."}
// Роли - массив строк, значения из АИС_Сотрудники.РолиПоИменам, или
// отсутствует/пустой массив - без ролей расширения. Руководитель обычно
// получает сразу две роли ("ДолжностноеЛицо" и "ВышестоящееДолжностноеЛицо") -
// см. plans/2026-10-26-enterprise-simulator.md. Пароль - опционален.
// "Руководитель" - опционален, логин непосредственного начальника (для
// эскалации, когда у должности сотрудника нет должностной инструкции -
// см. АИС_Уведомления); отсутствует/пусто - без начальника в системе.
//
// Аутентификация — стандартная Basic Auth платформы (учётная запись ИБ того,
// кто выполняет найм); отдельной проверки прав на саму операцию найма в v1
// нет — ограничивает её только то, что нет общедоступной роли расширения
// (tests/1c/test_access.md, A5). Это известное упрощение первой версии,
// см. plans/2026-10-26-enterprise-simulator.md.
Функция СоздатьСотрудника_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(201);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Попытка
		ТелоКакСтрока = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоКакСтрока);
		Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();

		ИменаРолей = Новый Массив;
		Данные.Свойство("Роли", ИменаРолей);
		Пароль = Неопределено;
		Данные.Свойство("Пароль", Пароль);
		РуководительЛогин = "";
		Данные.Свойство("Руководитель", РуководительЛогин);

		// Явный сброс УстановитьПривилегированныйРежим(Ложь) здесь не нужен (и
		// сам бросает исключение в этом публикуемом по HTTP расширении) —
		// вызов HTTPService одноразовый, привилегированный режим не переживает
		// завершение запроса.
		УстановитьПривилегированныйРежим(Истина);
		Должность = АИС_ОбщегоНазначения.НайтиИлиСоздатьЭлемент(Справочники.Должности, Данные.Должность);
		Должность.Записать();
		Роли = АИС_Сотрудники.РолиПоИменам(ИменаРолей);
		Руководитель = Неопределено;
		Если Не ПустаяСтрока(РуководительЛогин) Тогда
			Руководитель = Справочники.Пользователи.НайтиПоНаименованию(РуководительЛогин, Истина);
		КонецЕсли;
		Сотрудник = АИС_Сотрудники.СоздатьСотрудника(Данные.Имя, Данные.ФИО, Должность, Роли, Пароль, Руководитель);

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписьJSON.ЗаписатьИмяСвойства("Статус");
		ЗаписьJSON.ЗаписатьЗначение("создан");
		ЗаписьJSON.ЗаписатьИмяСвойства("Сотрудник");
		ЗаписьJSON.ЗаписатьЗначение(Данные.Имя);
		ЗаписьJSON.ЗаписатьИмяСвойства("УникальныйИдентификатор");
		ЗаписьJSON.ЗаписатьЗначение(Строка(Сотрудник.УникальныйИдентификатор()));
		ЗаписьJSON.ЗаписатьИмяСвойства("РуководительНайден");
		ЗаписьJSON.ЗаписатьЗначение(ЗначениеЗаполнено(Руководитель));
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Текст = "Ошибка создания сотрудника через АИС_Симулятор: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("АИС.Симулятор", УровеньЖурналаРегистрации.Ошибка,,, Текст);

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписьJSON.ЗаписатьИмяСвойства("Статус");
		ЗаписьJSON.ЗаписатьЗначение("ошибка");
		ЗаписьJSON.ЗаписатьИмяСвойства("Описание");
		ЗаписьJSON.ЗаписатьЗначение(ОписаниеОшибки());
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
		Ответ.КодСостояния = 400;
	КонецПопытки;

	Возврат Ответ;
КонецФункции

// POST /hs/ais-sim/internal-documents
// Тело запроса (JSON):
//  {"Вид": "Приказ", "Заголовок": "...", "Содержание": "...", "Адресат": "ЛогинСотрудника"}
// "Вид" - категория документа (Справочник.ВидыВнутреннихДокументов,
// создаётся при первом использовании), "Заголовок" - тема конкретного
// документа (обязателен, до 150 символов), "Содержание" - текст,
// "Адресат" - опционален, логин сотрудника (Справочник.Пользователи.Наименование,
// тот же, что логин ИБ). Если задан, срабатывает подписка
// АИС_ВнутреннийДокументПриЗаписи: адресату создаётся задача-уведомление
// (с автопоиском шаблонов - см. АИС_Уведомления). "Должность" - опционален,
// наименование должности (Справочник.Должности); используется для
// документов вида "Должностная инструкция" - к какой должности относится
// (АИС_ОбщегоНазначения.НайтиДолжностнуюИнструкцию ищет по этому полю).
// "ИспользованШаблон" - опционален, УникальныйИдентификатор одного из
// кандидатов шаблонов (GET /tasks, КандидатыШаблонов), если исполнитель
// составил документ на его основе. "ДополненоРазделами" - опционален,
// Булево - Истина, если исполнитель дополнил документ сверх шаблона. Оба
// влияют на то, поставится ли Делопроизводителю задача обобщить документ
// в (новый/обновлённый) шаблон - см. АИС_Уведомления.
// "ЗапрашиваемыеДолжности" - опционален, массив наименований должностей
// (Справочник.Должности); для документов вида "Заявка на найм" - какие
// позиции запрашивает заявка (ТЧ АИС_ЗапрашиваемыеДолжности). HR проверит
// по каждой наличие должностной инструкции - см.
// АИС_Уведомления.ОбработатьЗаявкуНаНайм.
// "Подготовил" заполняется автоматически текущим пользователем (тем, кто
// аутентифицировался Basic Auth) через штатную ОбработкаЗаполнения
// справочника ВнутренниеДокументы - тот же приём, что и в
// АИС_ОбщегоНазначения.НайтиИлиСоздатьЗадачу: обработка заполнения не
// вызывается автоматически при СоздатьЭлемент(), её нужно вызвать явно.
// "Задача" - опционален, УникальныйИдентификатор текущей задачи: расширение
// возьмёт её предмет (документ-основание) и создаст штатную связь
// РегистрСведений.СвязиДокументов. "Основание" - опционален, явный
// УникальныйИдентификатор документа-основания для вызовов вне задачи.
Функция СоздатьВнутреннийДокумент_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(201);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Попытка
		ТелоКакСтрока = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоКакСтрока);
		Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();

		УстановитьПривилегированныйРежим(Истина);
		ВидДокумента = АИС_ОбщегоНазначения.НайтиИлиСоздатьЭлемент(Справочники.ВидыВнутреннихДокументов, Данные.Вид);
		Если Не ЗначениеЗаполнено(ВидДокумента.СпособНумерации) Тогда
			ВидДокумента.СпособНумерации = Перечисления.СпособыНумерации.Автоматически;
		КонецЕсли;
		ВидДокумента.Записать();

		АдресатЛогин = "";
		Данные.Свойство("Адресат", АдресатЛогин);
		ДолжностьСтрокой = "";
		Данные.Свойство("Должность", ДолжностьСтрокой);
		ИспользованШаблонСтрокой = "";
		Данные.Свойство("ИспользованШаблон", ИспользованШаблонСтрокой);
		ДополненоРазделами = Ложь;
		Данные.Свойство("ДополненоРазделами", ДополненоРазделами);
		ЗапрашиваемыеДолжности = Неопределено;
		Данные.Свойство("ЗапрашиваемыеДолжности", ЗапрашиваемыеДолжности);
		// Структура.Свойство() выставляет Значение в Неопределено, если
		// свойства нет в JSON (не сохраняет значение по умолчанию,
		// заданное до вызова - эмпирически найдено: "Для Каждого" по
		// Неопределено валит ошибкой "Iterator is not defined", в отличие
		// от ПустаяСтрока(), которая Неопределено спокойно проглатывает).
		Если ЗапрашиваемыеДолжности = Неопределено Тогда
			ЗапрашиваемыеДолжности = Новый Массив;
		КонецЕсли;

		Объект = Справочники.ВнутренниеДокументы.СоздатьЭлемент();
		Объект.ОбработкаЗаполнения(Неопределено, Ложь);
		Объект.ВидДокумента = ВидДокумента.Ссылка;
		Объект.Заголовок = Данные.Заголовок;
		Объект.Содержание = Данные.Содержание;
		Если Не ПустаяСтрока(АдресатЛогин) Тогда
			Объект.Адресат = Справочники.Пользователи.НайтиПоНаименованию(АдресатЛогин, Истина);
		КонецЕсли;
		Если Не ПустаяСтрока(ДолжностьСтрокой) Тогда
			// НайтиИлиСоздатьЭлемент, не НайтиПоНаименованию - должность
			// документа ("Должностная инструкция") может оказаться новой,
			// ещё не заведённой в Справочник.Должности (эмпирически найдено:
			// простой поиск силент но возвращает пустую ссылку).
			ДолжностьОбъект = АИС_ОбщегоНазначения.НайтиИлиСоздатьЭлемент(Справочники.Должности, ДолжностьСтрокой);
			ДолжностьОбъект.Записать();
			Объект.АИС_Должность = ДолжностьОбъект.Ссылка;
		КонецЕсли;
		Если Не ПустаяСтрока(ИспользованШаблонСтрокой) Тогда
			Объект.АИС_ИспользованШаблон = Справочники.ШаблоныВнутреннихДокументов.ПолучитьСсылку(
				Новый УникальныйИдентификатор(ИспользованШаблонСтрокой));
		КонецЕсли;
		Объект.АИС_ДополненоРазделами = ДополненоРазделами;
		Для Каждого ДолжностьСтрокой Из ЗапрашиваемыеДолжности Цикл
			// Та же причина - для заявки на найм запрошенная должность, как
			// правило, ЕЩЁ не существует в справочнике.
			ДолжностьОбъект = АИС_ОбщегоНазначения.НайтиИлиСоздатьЭлемент(Справочники.Должности, ДолжностьСтрокой);
			ДолжностьОбъект.Записать();
			СтрокаТЧ = Объект.АИС_ЗапрашиваемыеДолжности.Добавить();
			СтрокаТЧ.Должность = ДолжностьОбъект.Ссылка;
		КонецЦикла;
		Объект.Записать();

		// Документ-результат связывается с приказом штатной связью
		// РегистрСведений.СвязиДокументов. Основание берётся из предмета
		// текущей задачи (если передан её id) или из явного поля "Основание".
		Основание = ОпределитьОснованиеНовогоДокумента(Данные);
		СвязьУстановлена = Ложь;
		Если ЗначениеЗаполнено(Основание) Тогда
			СвязьУстановлена = АИС_ОбщегоНазначения.СоздатьСвязьДокументаСОснованием(
				Объект.Ссылка, Основание);
		КонецЕсли;

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписьJSON.ЗаписатьИмяСвойства("Статус");
		ЗаписьJSON.ЗаписатьЗначение("создан");
		ЗаписьJSON.ЗаписатьИмяСвойства("Заголовок");
		ЗаписьJSON.ЗаписатьЗначение(Объект.Заголовок);
		ЗаписьJSON.ЗаписатьИмяСвойства("УникальныйИдентификатор");
		ЗаписьJSON.ЗаписатьЗначение(Строка(Объект.Ссылка.УникальныйИдентификатор()));
		ЗаписьJSON.ЗаписатьИмяСвойства("СвязьУстановлена");
		ЗаписьJSON.ЗаписатьЗначение(СвязьУстановлена);
		Если ЗначениеЗаполнено(Основание) Тогда
			ЗаписьJSON.ЗаписатьИмяСвойства("Основание");
			ЗаписьJSON.ЗаписатьЗначение(Строка(Основание.УникальныйИдентификатор()));
		КонецЕсли;
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Текст = "Ошибка создания документа через АИС_Симулятор: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("АИС.Симулятор", УровеньЖурналаРегистрации.Ошибка,,, Текст);

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписьJSON.ЗаписатьИмяСвойства("Статус");
		ЗаписьJSON.ЗаписатьЗначение("ошибка");
		ЗаписьJSON.ЗаписатьИмяСвойства("Описание");
		ЗаписьJSON.ЗаписатьЗначение(ОписаниеОшибки());
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
		Ответ.КодСостояния = 400;
	КонецПопытки;

	Возврат Ответ;
КонецФункции

// GET /hs/ais-sim/sessions
// Диагностика лицензионных сеансов (community/developer-лицензия 1С
// допускает не более 1 одновременного веб-сеанса — см.
// plans/2026-10-26-enterprise-simulator.md). Список активных сеансов
// информационной базы - помогает понять, какой сеанс держит лицензионный
// слот, когда веб-клиент был закрыт некорректно (например, Playwright
// browser.close() без штатного выхода) и не освободил его до истечения
// sessionMaxAge.
//
// Принудительного завершения чужого сеанса здесь нет: у объекта
// СеансИнформационнойБазы в файловом режиме нет метода типа "Завершить"
// (проверено эмпирически - "Object method not found") - судя по всему,
// это штатно только через Конфигуратор (Активные пользователи) или rac в
// клиент-серверном режиме, которого здесь нет. Поэтому корректный выход
// должен обеспечиваться со стороны симулятора (штатный Logout в веб-клиенте
// перед закрытием браузера), а не форсированным завершением с сервера.
//
// Имена свойств СеансИнформационнойБазы (НомерСеанса, НомерСоединения,
// ИмяКомпьютера, ИмяПриложения, НачалоСеанса) подтверждены эмпирически -
// подобраны перебором через диагностический вызов этого же эндпоинта,
// синтакс-помощник недоступен в этом окружении.
Функция ПолучитьСеансы_GET(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Попытка
		УстановитьПривилегированныйРежим(Истина);

		ТекущийНомер = ПолучитьТекущийСеансИнформационнойБазы().НомерСеанса;
		Сеансы = ПолучитьСеансыИнформационнойБазы();

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоМассива();
		Для Каждого Сеанс Из Сеансы Цикл
			ЗаписьJSON.ЗаписатьНачалоОбъекта();
			ЗаписьJSON.ЗаписатьИмяСвойства("НомерСеанса");
			ЗаписьJSON.ЗаписатьЗначение(Сеанс.НомерСеанса);
			ЗаписьJSON.ЗаписатьИмяСвойства("НомерСоединения");
			ЗаписьJSON.ЗаписатьЗначение(Сеанс.НомерСоединения);
			ЗаписьJSON.ЗаписатьИмяСвойства("Пользователь");
			ЗаписьJSON.ЗаписатьЗначение(Строка(Сеанс.Пользователь));
			ЗаписьJSON.ЗаписатьИмяСвойства("ИмяКомпьютера");
			ЗаписьJSON.ЗаписатьЗначение(Сеанс.ИмяКомпьютера);
			ЗаписьJSON.ЗаписатьИмяСвойства("ИмяПриложения");
			ЗаписьJSON.ЗаписатьЗначение(Сеанс.ИмяПриложения);
			ЗаписьJSON.ЗаписатьИмяСвойства("НачалоСеанса");
			ЗаписьJSON.ЗаписатьЗначение(Строка(Сеанс.НачалоСеанса));
			ЗаписьJSON.ЗаписатьИмяСвойства("Текущий");
			ЗаписьJSON.ЗаписатьЗначение(Сеанс.НомерСеанса = ТекущийНомер);
			ЗаписьJSON.ЗаписатьКонецОбъекта();
		КонецЦикла;
		ЗаписьJSON.ЗаписатьКонецМассива();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Текст = "Ошибка получения сеансов через АИС_Симулятор: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("АИС.Симулятор", УровеньЖурналаРегистрации.Ошибка,,, Текст);
		Ответ.УстановитьТелоИзСтроки(Текст);
		Ответ.КодСостояния = 400;
	КонецПопытки;

	Возврат Ответ;
КонецФункции

// GET /hs/ais-sim/employees
// Список сотрудников: логин, должность, руководитель. Нужен симулятору,
// чтобы запускать агента от имени каждого сотрудника, а не только CEO.
Функция ПолучитьСотрудников_GET(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Попытка
		УстановитьПривилегированныйРежим(Истина);

		Запрос2 = Новый Запрос;
		Запрос2.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Пользователи.Наименование КАК Логин,
		|	Сведения.Должность.Наименование КАК Должность,
		|	Подчиненность.Руководитель.Наименование КАК Руководитель
		|ИЗ
		|	Справочник.Пользователи КАК Пользователи
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияОПользователяхДокументооборот КАК Сведения
		|		ПО Сведения.Пользователь = Пользователи.Ссылка
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПодчиненностьСотрудников КАК Подчиненность
		|		ПО Подчиненность.Подчиненный = Пользователи.Ссылка
		|ГДЕ
		|	Пользователи.ПометкаУдаления = ЛОЖЬ
		|	И Сведения.Должность <> НЕОПРЕДЕЛЕНО
		|УПОРЯДОЧИТЬ ПО
		|	Логин";
		Результат = Запрос2.Выполнить();
		Выборка = Результат.Выбрать();

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоМассива();
		Пока Выборка.Следующий() Цикл
			ЗаписьJSON.ЗаписатьНачалоОбъекта();
			ЗаписьJSON.ЗаписатьИмяСвойства("Логин");
			ЗаписьJSON.ЗаписатьЗначение(Выборка.Логин);
			ЗаписьJSON.ЗаписатьИмяСвойства("Должность");
			ЗаписьJSON.ЗаписатьЗначение(Выборка.Должность);
			ЗаписьJSON.ЗаписатьИмяСвойства("Руководитель");
			ЗаписьJSON.ЗаписатьЗначение(?(ЗначениеЗаполнено(Выборка.Руководитель), Выборка.Руководитель, ""));
			ЗаписьJSON.ЗаписатьКонецОбъекта();
		КонецЦикла;
		ЗаписьJSON.ЗаписатьКонецМассива();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Текст = "Ошибка получения сотрудников через АИС_Симулятор: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("АИС.Симулятор", УровеньЖурналаРегистрации.Ошибка,,, Текст);
		Ответ.УстановитьТелоИзСтроки(Текст);
		Ответ.КодСостояния = 400;
	КонецПопытки;

	Возврат Ответ;
КонецФункции

Функция УстановитьРуководителя_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Попытка
		ТелоКакСтрока = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоКакСтрока);
		Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();

		УстановитьПривилегированныйРежим(Истина);
		Подчиненный = Справочники.Пользователи.НайтиПоНаименованию(Данные.Подчиненный, Истина);
		Руководитель = Справочники.Пользователи.НайтиПоНаименованию(Данные.Руководитель, Истина);
		Если Не ЗначениеЗаполнено(Подчиненный) Или Не ЗначениеЗаполнено(Руководитель) Тогда
			ВызватьИсключение "Не найден подчиненный или руководитель.";
		КонецЕсли;

		Запись = РегистрыСведений.ПодчиненностьСотрудников.СоздатьМенеджерЗаписи();
		Запись.Подчиненный = Подчиненный;
		Запись.Руководитель = Руководитель;
		Запись.Записать();

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписьJSON.ЗаписатьИмяСвойства("Статус");
		ЗаписьJSON.ЗаписатьЗначение("сохранено");
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Текст = "Ошибка записи руководителя: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("АИС.Симулятор", УровеньЖурналаРегистрации.Ошибка,,, Текст);
		Ответ.УстановитьТелоИзСтроки(Текст);
		Ответ.КодСостояния = 400;
	КонецПопытки;

	Возврат Ответ;
КонецФункции

// GET /hs/ais-sim/tasks
// Невыполненные задачи текущего аутентифицированного сотрудника (того, кто
// вызвал через Basic Auth) - то, что агент-исполнитель должен прочитать и
// обработать. "Текущий сотрудник" берётся из параметра сеанса
// ТекущийПользователь (ссылка Справочник.Пользователи), который платформа
// заполняет сама по аутентифицированному пользователю ИБ - см.
// CommonModule.УстановкаПараметровСеанса.
// "КандидатыШаблонов" - результат автоматического поиска шаблонов,
// выполненного расширением при создании задачи
// (АИС_Уведомления.ВнутреннийДокументПриЗаписи); пустой массив - либо
// поиск не выполнялся (задача не связана с документом), либо ничего не
// нашлось - в обоих случаях решение, что делать дальше, за исполнителем.
// Тело ответа (JSON, массив):
//  [{"УникальныйИдентификатор": "...", "Наименование": "Ознакомиться: ...",
//    "Описание": "<полный текст задачи/приказа>", "ДатаНачала": "...",
//    "Основание": {"УникальныйИдентификатор": "...", "Заголовок": "...",
//      "Вид": "...", "Автор": "..."} | null,
//    "КандидатыШаблонов": [{"УникальныйИдентификатор": "...",
//      "Наименование": "...", "Заголовок": "...", "КомментарийКШаблону": "..."}]}]
// "Основание" - документ-основание из штатной мультипредметности задачи;
// передайте его id (или id задачи) при создании результата, чтобы документ
// связался с приказом через РегистрСведений.СвязиДокументов.
Функция ПолучитьЗадачи_GET(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Попытка
		УстановитьПривилегированныйРежим(Истина);

		ТекущийСотрудник = ПараметрыСеанса.ТекущийПользователь;

		Запрос2 = Новый Запрос;
		Запрос2.УстановитьПараметр("Исполнитель", ТекущийСотрудник);
		Запрос2.Текст =
		"ВЫБРАТЬ
		|	ЗадачаИсполнителя.Ссылка КАК Ссылка,
		|	ЗадачаИсполнителя.Наименование КАК Наименование,
		|	ЗадачаИсполнителя.Описание КАК Описание,
		|	ЗадачаИсполнителя.ДатаНачала КАК ДатаНачала
		|ИЗ
		|	Задача.ЗадачаИсполнителя КАК ЗадачаИсполнителя
		|ГДЕ
		|	ЗадачаИсполнителя.Исполнитель = &Исполнитель
		|	И ЗадачаИсполнителя.Выполнена = ЛОЖЬ
		|УПОРЯДОЧИТЬ ПО
		|	ЗадачаИсполнителя.ДатаНачала";
		Результат = Запрос2.Выполнить();
		Выборка = Результат.Выбрать();

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоМассива();
		Пока Выборка.Следующий() Цикл
			ЗаписьJSON.ЗаписатьНачалоОбъекта();
			ЗаписьJSON.ЗаписатьИмяСвойства("УникальныйИдентификатор");
			ЗаписьJSON.ЗаписатьЗначение(Строка(Выборка.Ссылка.УникальныйИдентификатор()));
			ЗаписьJSON.ЗаписатьИмяСвойства("Наименование");
			ЗаписьJSON.ЗаписатьЗначение(Выборка.Наименование);
			ЗаписьJSON.ЗаписатьИмяСвойства("Описание");
			ЗаписьJSON.ЗаписатьЗначение(Выборка.Описание);
			ЗаписьJSON.ЗаписатьИмяСвойства("ДатаНачала");
			ЗаписьJSON.ЗаписатьЗначение(Строка(Выборка.ДатаНачала));

			Основание = АИС_ОбщегоНазначения.ПолучитьОснованиеЗадачи(Выборка.Ссылка);
			ЗаписатьДокументВJSON(ЗаписьJSON, "Основание", Основание);

			ЗаписьJSON.ЗаписатьИмяСвойства("КандидатыШаблонов");
			ЗаписьJSON.ЗаписатьНачалоМассива();
			Кандидаты = АИС_ОбщегоНазначения.ПолучитьКандидатовШаблонов(Выборка.Ссылка);
			Для Каждого Кандидат Из Кандидаты Цикл
				ЗаписьJSON.ЗаписатьНачалоОбъекта();
				ЗаписьJSON.ЗаписатьИмяСвойства("УникальныйИдентификатор");
				ЗаписьJSON.ЗаписатьЗначение(Кандидат.УникальныйИдентификатор);
				ЗаписьJSON.ЗаписатьИмяСвойства("Наименование");
				ЗаписьJSON.ЗаписатьЗначение(Кандидат.Наименование);
				ЗаписьJSON.ЗаписатьИмяСвойства("Заголовок");
				ЗаписьJSON.ЗаписатьЗначение(Кандидат.Заголовок);
				ЗаписьJSON.ЗаписатьИмяСвойства("КомментарийКШаблону");
				ЗаписьJSON.ЗаписатьЗначение(Кандидат.КомментарийКШаблону);
				ЗаписьJSON.ЗаписатьКонецОбъекта();
			КонецЦикла;
			ЗаписьJSON.ЗаписатьКонецМассива();

			ЗаписьJSON.ЗаписатьКонецОбъекта();
		КонецЦикла;
		ЗаписьJSON.ЗаписатьКонецМассива();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Текст = "Ошибка получения задач через АИС_Симулятор: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("АИС.Симулятор", УровеньЖурналаРегистрации.Ошибка,,, Текст);
		Ответ.УстановитьТелоИзСтроки(Текст);
		Ответ.КодСостояния = 400;
	КонецПопытки;

	Возврат Ответ;
КонецФункции

// POST /hs/ais-sim/tasks/complete
// Тело запроса (JSON): {"Задача": "<УникальныйИдентификатор>", "Результат": "..."}
// "Результат" - опционален, текст решения/комментарий исполнителя
// (РезультатВыполнения). Завершает задачу текущего аутентифицированного
// сотрудника - задача, принадлежащая другому исполнителю, отклоняется
// (403), чтобы один агент не мог закрывать чужие задачи через общий API.
Функция ЗавершитьЗадачу_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Попытка
		ТелоКакСтрока = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоКакСтрока);
		Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();

		Результат = "";
		Данные.Свойство("Результат", Результат);

		УстановитьПривилегированныйРежим(Истина);
		ТекущийСотрудник = ПараметрыСеанса.ТекущийПользователь;

		Ссылка = Задачи.ЗадачаИсполнителя.ПолучитьСсылку(Новый УникальныйИдентификатор(Данные.Задача));
		Объект = Ссылка.ПолучитьОбъект();

		Если Объект = Неопределено Тогда
			ВызватьИсключение "Задача не найдена: " + Данные.Задача;
		КонецЕсли;
		Если Объект.Исполнитель <> ТекущийСотрудник Тогда
			Ответ.КодСостояния = 403;
			Ответ.УстановитьТелоИзСтроки("Задача принадлежит другому исполнителю");
			Возврат Ответ;
		КонецЕсли;

		Объект.Выполнена = Истина;
		Если Не ПустаяСтрока(Результат) Тогда
			Объект.РезультатВыполнения = Результат;
		КонецЕсли;
		Объект.Записать();

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписьJSON.ЗаписатьИмяСвойства("Статус");
		ЗаписьJSON.ЗаписатьЗначение("завершена");
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Текст = "Ошибка завершения задачи через АИС_Симулятор: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("АИС.Симулятор", УровеньЖурналаРегистрации.Ошибка,,, Текст);
		Ответ.УстановитьТелоИзСтроки(Текст);
		Ответ.КодСостояния = 400;
	КонецПопытки;

	Возврат Ответ;
КонецФункции

// GET /hs/ais-sim/templates?kind=<ВидДокумента>&query=<ключевое слово>
// Ручной/ad-hoc поиск шаблона внутреннего документа - та же логика
// (АИС_ОбщегоНазначения.НайтиШаблоныВнутреннихДокументов), что и
// автоматический поиск при создании адресной задачи
// (АИС_Уведомления.ВнутреннийДокументПриЗаписи), но по явному запросу, а
// не привязано к задаче. Основной путь для исполнителя - читать
// кандидатов вместе с задачей (GET /tasks, поле КандидатыШаблонов);
// этот endpoint - для исследования каталога шаблонов отдельно. Оба
// параметра опциональны; без параметров возвращает все шаблоны (на случай
// малого объёма справочника). "query" ищет подстроку без учёта регистра в
// Наименовании или Заголовке шаблона.
// Тело ответа (JSON, массив):
//  [{"УникальныйИдентификатор": "...", "Наименование": "...",
//    "Заголовок": "...", "КомментарийКШаблону": "..."}]
Функция ПолучитьШаблоны_GET(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Попытка
		УстановитьПривилегированныйРежим(Истина);

		ВидСтрокой = Запрос.ПараметрыЗапроса.Получить("kind");
		ЗапросСтрокой = Запрос.ПараметрыЗапроса.Получить("query");

		ВидДокумента = Неопределено;
		Если Не ПустаяСтрока(ВидСтрокой) Тогда
			ВидДокумента = Справочники.ВидыВнутреннихДокументов.НайтиПоНаименованию(ВидСтрокой, Истина);
		КонецЕсли;
		Кандидаты = АИС_ОбщегоНазначения.НайтиШаблоныВнутреннихДокументов(ВидДокумента, ЗапросСтрокой);

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоМассива();
		Для Каждого Кандидат Из Кандидаты Цикл
			ЗаписьJSON.ЗаписатьНачалоОбъекта();
			ЗаписьJSON.ЗаписатьИмяСвойства("УникальныйИдентификатор");
			ЗаписьJSON.ЗаписатьЗначение(Кандидат.УникальныйИдентификатор);
			ЗаписьJSON.ЗаписатьИмяСвойства("Наименование");
			ЗаписьJSON.ЗаписатьЗначение(Кандидат.Наименование);
			ЗаписьJSON.ЗаписатьИмяСвойства("Заголовок");
			ЗаписьJSON.ЗаписатьЗначение(Кандидат.Заголовок);
			ЗаписьJSON.ЗаписатьИмяСвойства("КомментарийКШаблону");
			ЗаписьJSON.ЗаписатьЗначение(Кандидат.КомментарийКШаблону);
			ЗаписьJSON.ЗаписатьКонецОбъекта();
		КонецЦикла;
		ЗаписьJSON.ЗаписатьКонецМассива();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Текст = "Ошибка поиска шаблонов через АИС_Симулятор: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("АИС.Симулятор", УровеньЖурналаРегистрации.Ошибка,,, Текст);
		Ответ.УстановитьТелоИзСтроки(Текст);
		Ответ.КодСостояния = 400;
	КонецПопытки;

	Возврат Ответ;
КонецФункции

// POST /hs/ais-sim/hiring-requests/accounting-decision
// Тело запроса (JSON): {"Заявка": "<УникальныйИдентификатор>",
//   "Решение": "Согласовать"|"Отклонить", "ОбновлённыйТекст": "...",
//   "Комментарий": "..."}
// Решение Главного Бухгалтера по заявке на найм (см.
// АИС_Уведомления.ОбработатьЗаявкуНаНайм): "Согласовать" - вилка в
// документе корректна как есть, или бухгалтер сам вписал цифры
// (ОбновлённыйТекст, опционален, заменяет Содержание целиком) - статус
// становится "Согласовано", что при последующем Записать() автоматически
// продолжает цепочку (проверка должностных обязанностей/задача HR).
// "Отклонить" (с опциональным "Комментарий") - статус "Отклонено", найм
// по этой заявке не продолжается. В обоих случаях автору заявки
// (Подготовил) ставится задача с результатом решения.
Функция ПринятьРешениеБухгалтера_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Попытка
		ТелоКакСтрока = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоКакСтрока);
		Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();

		Если Данные.Решение <> "Согласовать" И Данные.Решение <> "Отклонить" Тогда
			ВызватьИсключение "Неизвестное решение: " + Данные.Решение;
		КонецЕсли;

		УстановитьПривилегированныйРежим(Истина);
		Ссылка = Справочники.ВнутренниеДокументы.ПолучитьСсылку(
			Новый УникальныйИдентификатор(Данные.Заявка));
		Объект = Ссылка.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			ВызватьИсключение "Заявка не найдена: " + Данные.Заявка;
		КонецЕсли;

		ОбновлённыйТекст = "";
		Данные.Свойство("ОбновлённыйТекст", ОбновлённыйТекст);
		Если Не ПустаяСтрока(ОбновлённыйТекст) Тогда
			Объект.Содержание = ОбновлённыйТекст;
		КонецЕсли;

		Комментарий = "";
		Данные.Свойство("Комментарий", Комментарий);

		Если Данные.Решение = "Согласовать" Тогда
			Объект.АИС_СтатусСогласованияБухгалтера = "Согласовано";
		Иначе
			Объект.АИС_СтатусСогласованияБухгалтера = "Отклонено";
		КонецЕсли;
		Объект.Записать();

		Если ЗначениеЗаполнено(Объект.Подготовил) Тогда
			Если Данные.Решение = "Согласовать" Тогда
				Наименование = "Зарплатная вилка согласована: " + Объект.Заголовок;
				Описание = "Главный бухгалтер согласовал заявку на найм """ + Объект.Заголовок + """.";
			Иначе
				Наименование = "Заявка на найм отклонена: " + Объект.Заголовок;
				Описание = "Главный бухгалтер отклонил заявку на найм """ + Объект.Заголовок + """."
					+ ?(ПустаяСтрока(Комментарий), "", Символы.ПС + "Комментарий: " + Комментарий);
			КонецЕсли;
			АИС_ОбщегоНазначения.НайтиИлиСоздатьЗадачу(Объект.Подготовил, Наименование, Описание);
		КонецЕсли;

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписьJSON.ЗаписатьИмяСвойства("Статус");
		ЗаписьJSON.ЗаписатьЗначение(Объект.АИС_СтатусСогласованияБухгалтера);
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Текст = "Ошибка решения бухгалтера через АИС_Симулятор: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("АИС.Симулятор", УровеньЖурналаРегистрации.Ошибка,,, Текст);
		Ответ.УстановитьТелоИзСтроки(Текст);
		Ответ.КодСостояния = 400;
	КонецПопытки;

	Возврат Ответ;
КонецФункции

// GET /hs/ais-sim/ai-check
// Диагностика: проверяет доступность ИИ-провайдера (ключ/модель из
// Константа.АИС_КлючИИ/АИС_МодельИИ, см. АИС_ОбщегоНазначения.ВызватьИИ).
Функция ПроверитьИИ_GET(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписьJSON.ЗаписатьНачалоОбъекта();
	Попытка
		Текст = АИС_ОбщегоНазначения.ВызватьИИ(
			"Отвечай одним словом.", "Скажи ""ОК"", если получил это сообщение.");
		ЗаписьJSON.ЗаписатьИмяСвойства("Успех");
		ЗаписьJSON.ЗаписатьЗначение(Истина);
		ЗаписьJSON.ЗаписатьИмяСвойства("Ответ");
		ЗаписьJSON.ЗаписатьЗначение(Текст);
	Исключение
		ЗаписьJSON.ЗаписатьИмяСвойства("Успех");
		ЗаписьJSON.ЗаписатьЗначение(Ложь);
		ЗаписьJSON.ЗаписатьИмяСвойства("Ошибка");
		ЗаписьJSON.ЗаписатьЗначение(ОписаниеОшибки());
		Ответ.КодСостояния = 502;
	КонецПопытки;
	ЗаписьJSON.ЗаписатьКонецОбъекта();
	Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Возврат Ответ;
КонецФункции

Функция УстановитьНастройкиИИ_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Попытка
		ТелоКакСтрока = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоКакСтрока);
		Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();

		УстановитьПривилегированныйРежим(Истина);

		Ключ = "";
		Данные.Свойство("Ключ", Ключ);
		Если Не ПустаяСтрока(Ключ) Тогда
			Константы.АИС_КлючИИ.Установить(Ключ);
		КонецЕсли;

		Модель = "";
		Данные.Свойство("Модель", Модель);
		Если Не ПустаяСтрока(Модель) Тогда
			Константы.АИС_МодельИИ.Установить(Модель);
		КонецЕсли;

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписьJSON.ЗаписатьИмяСвойства("Статус");
		ЗаписьJSON.ЗаписатьЗначение("сохранено");
		ЗаписьJSON.ЗаписатьИмяСвойства("Модель");
		ЗаписьJSON.ЗаписатьЗначение(Константы.АИС_МодельИИ.Получить());
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Текст = "Ошибка сохранения настроек ИИ через АИС_Симулятор: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("АИС.Симулятор", УровеньЖурналаРегистрации.Ошибка,,, Текст);
		Ответ.УстановитьТелоИзСтроки(Текст);
		Ответ.КодСостояния = 400;
	КонецПопытки;

	Возврат Ответ;
КонецФункции

// POST /hs/ais-sim/templates
// Тело запроса (JSON):
//  {"Вид": "Приказ", "Наименование": "...", "Заголовок": "...",
//   "КомментарийКШаблону": "...", "АвторНаУтверждение": "ЛогинСотрудника"}
// Ручное/внешнее создание шаблона (Статус="Черновик" - не попадает в
// автопоиск/ручной поиск, пока не утверждён, см.
// АИС_ОбщегоНазначения.НайтиШаблоныВнутреннихДокументов). Автоматический
// путь (по готовому документу без шаблона или с дополнениями) теперь
// формирует шаблон сам расширение через ИИ (см.
// АИС_Уведомления.ПроверитьНеобходимостьШаблона,
// АИС_ОбщегоНазначения.СоздатьЧерновикШаблона) - этот endpoint остаётся
// для ручного/стороннего создания шаблона в обход автоматики.
// "КомментарийКШаблону" - по соглашению сюда пишется текст шаблона с
// описанием плейсхолдеров (кто их заполняет) - отдельного поля "тело
// шаблона" в справочнике нет. "АвторНаУтверждение" - опционален, логин
// автора документа: он утвердит шаблон после технического согласования
// Программистом 1С. Сразу ставится задача на техническое согласование;
// без автора шаблон создаётся, но финальную задачу на утверждение
// оформить некому.
Функция СоздатьШаблон_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(201);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Попытка
		ТелоКакСтрока = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоКакСтрока);
		Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();

		УстановитьПривилегированныйРежим(Истина);
		ВидДокумента = АИС_ОбщегоНазначения.НайтиИлиСоздатьЭлемент(Справочники.ВидыВнутреннихДокументов, Данные.Вид);
		ВидДокумента.Записать();

		АвторНаУтверждениеЛогин = "";
		Данные.Свойство("АвторНаУтверждение", АвторНаУтверждениеЛогин);
		Автор = Неопределено;
		Если Не ПустаяСтрока(АвторНаУтверждениеЛогин) Тогда
			Автор = Справочники.Пользователи.НайтиПоНаименованию(АвторНаУтверждениеЛогин, Истина);
		КонецЕсли;

		Объект = Справочники.ШаблоныВнутреннихДокументов.СоздатьЭлемент();
		Объект.Наименование = Данные.Наименование;
		Объект.ВидДокумента = ВидДокумента.Ссылка;
		Объект.Заголовок = Данные.Заголовок;
		Объект.КомментарийКШаблону = Данные.КомментарийКШаблону;
		Если ЗначениеЗаполнено(Автор) Тогда
			Объект.Автор = Автор;
		КонецЕсли;
		Объект.Статус = "Черновик";
		Объект.Записать();

		Программист = Справочники.Пользователи.НайтиПоНаименованию("Программист1С", Истина);
		Если ЗначениеЗаполнено(Программист) Тогда
			Наименование = "Согласовать шаблон: " + Объект.Заголовок;
			Описание =
				"Создан черновик шаблона документа. Проведите техническую проверку "
				+ "структуры, плейсхолдеров и отсутствия конкретных значений; при "
				+ "успехе согласуйте (POST /templates/technical-approve с "
				+ "УникальныйИдентификатор=" + Строка(Объект.Ссылка.УникальныйИдентификатор())
				+ "). После этого автор получит задачу на утверждение." + Символы.ПС
				+ "Если есть замечания — опишите их в результате задачи, не согласуя шаблон."
				+ Символы.ПС + Символы.ПС + "Заголовок шаблона: " + Объект.Заголовок
				+ Символы.ПС + Символы.ПС + "Текст шаблона и плейсхолдеры:"
				+ Символы.ПС + Объект.КомментарийКШаблону;
			АИС_ОбщегоНазначения.НайтиИлиСоздатьЗадачу(Программист, Наименование, Описание);
		ИначеЕсли ЗначениеЗаполнено(Автор) Тогда
			Наименование = "Утвердить шаблон: " + Объект.Заголовок;
			Описание =
				"Создан черновик шаблона документа. Технический этап недоступен: "
				+ "Программист 1С не найден. Проверьте и утвердите (POST "
				+ "/templates/approve с УникальныйИдентификатор="
				+ Строка(Объект.Ссылка.УникальныйИдентификатор()) + ")."
				+ Символы.ПС + Символы.ПС + "Текст шаблона и плейсхолдеры:"
				+ Символы.ПС + Объект.КомментарийКШаблону;
			АИС_ОбщегоНазначения.НайтиИлиСоздатьЗадачу(Автор, Наименование, Описание);
		КонецЕсли;

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписьJSON.ЗаписатьИмяСвойства("Статус");
		ЗаписьJSON.ЗаписатьЗначение("создан");
		ЗаписьJSON.ЗаписатьИмяСвойства("УникальныйИдентификатор");
		ЗаписьJSON.ЗаписатьЗначение(Строка(Объект.Ссылка.УникальныйИдентификатор()));
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Текст = "Ошибка создания шаблона через АИС_Симулятор: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("АИС.Симулятор", УровеньЖурналаРегистрации.Ошибка,,, Текст);
		Ответ.УстановитьТелоИзСтроки(Текст);
		Ответ.КодСостояния = 400;
	КонецПопытки;

	Возврат Ответ;
КонецФункции

// POST /hs/ais-sim/templates/approve
// Тело запроса (JSON): {"Шаблон": "<УникальныйИдентификатор>"}
// Окончательное утверждение шаблона автором исходного документа. Шаблон
// переводится в "Утверждён" и попадает в автопоиск/ручной поиск для всех.
// Техническое согласование до этого выполняет Программист 1С через
// /templates/technical-approve. Отдельной проверки прав в v1 нет, как и для
// найма/создания документов.
Функция УтвердитьШаблон_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Попытка
		ТелоКакСтрока = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоКакСтрока);
		Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();

		УстановитьПривилегированныйРежим(Истина);
		Ссылка = Справочники.ШаблоныВнутреннихДокументов.ПолучитьСсылку(
			Новый УникальныйИдентификатор(Данные.Шаблон));
		Объект = Ссылка.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			ВызватьИсключение "Шаблон не найден: " + Данные.Шаблон;
		КонецЕсли;
		Объект.Статус = "Утверждён";
		Объект.Записать();

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписьJSON.ЗаписатьИмяСвойства("Статус");
		ЗаписьJSON.ЗаписатьЗначение("утверждён");
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Текст = "Ошибка утверждения шаблона через АИС_Симулятор: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("АИС.Симулятор", УровеньЖурналаРегистрации.Ошибка,,, Текст);
		Ответ.УстановитьТелоИзСтроки(Текст);
		Ответ.КодСостояния = 400;
	КонецПопытки;

	Возврат Ответ;
КонецФункции

// POST /hs/ais-sim/templates/technical-approve
// Тело запроса (JSON): {"Шаблон": "<УникальныйИдентификатор>"}
// Техническое согласование черновика шаблона Программистом 1С. Переводит
// шаблон в "Согласован" (в поиск ещё не попадает) и ставит автору исходного
// документа задачу на окончательное утверждение.
Функция СогласоватьШаблонТехнически_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Попытка
		ТелоКакСтрока = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоКакСтрока);
		Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();

		УстановитьПривилегированныйРежим(Истина);
		Ссылка = Справочники.ШаблоныВнутреннихДокументов.ПолучитьСсылку(
			Новый УникальныйИдентификатор(Данные.Шаблон));
		Объект = Ссылка.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			ВызватьИсключение "Шаблон не найден: " + Данные.Шаблон;
		КонецЕсли;

		Если Объект.Статус = "Утверждён" Тогда
			ЗаписьJSON = Новый ЗаписьJSON;
			ЗаписьJSON.УстановитьСтроку();
			ЗаписьJSON.ЗаписатьНачалоОбъекта();
			ЗаписьJSON.ЗаписатьИмяСвойства("Статус");
			ЗаписьJSON.ЗаписатьЗначение("уже утверждён");
			ЗаписьJSON.ЗаписатьКонецОбъекта();
			Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
			Возврат Ответ;
		КонецЕсли;

		Объект.Статус = "Согласован";
		Объект.Записать();

		Автор = Объект.Автор;
		Если ЗначениеЗаполнено(Автор) Тогда
			Наименование = "Утвердить шаблон: " + Объект.Заголовок;
			Описание =
				"Программист 1С технически согласовал шаблон на основе документа "
				+ """" + Объект.Заголовок + """. Утвердите его "
				+ "(POST /templates/approve, УникальныйИдентификатор="
				+ Строка(Объект.Ссылка.УникальныйИдентификатор())
				+ ") либо верните на доработку." + Символы.ПС + Символы.ПС
				+ "Текст шаблона:" + Символы.ПС + Объект.КомментарийКШаблону;
			АИС_ОбщегоНазначения.НайтиИлиСоздатьЗадачу(Автор, Наименование, Описание);
		КонецЕсли;

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписьJSON.ЗаписатьИмяСвойства("Статус");
		ЗаписьJSON.ЗаписатьЗначение("согласован");
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Текст = "Ошибка технического согласования шаблона через АИС_Симулятор: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("АИС.Симулятор", УровеньЖурналаРегистрации.Ошибка,,, Текст);
		Ответ.УстановитьТелоИзСтроки(Текст);
		Ответ.КодСостояния = 400;
	КонецПопытки;

	Возврат Ответ;
КонецФункции

// POST /hs/ais-sim/prompts/seed
// Заполняет справочники АИС_Промпты и АИС_ПромптПараметры начальными
// записями. Не создаёт пользователей, должности и оргструктуру.
Функция ЗаполнитьПромпты_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Попытка
		УстановитьПривилегированныйРежим(Истина);
		АвтоШаблоны = Ложь;
		ТелоКакСтрока = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		Если Не ПустаяСтрока(ТелоКакСтрока) Тогда
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(ТелоКакСтрока);
			Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
			ЧтениеJSON.Закрыть();
			Данные.Свойство("АвтоШаблоны", АвтоШаблоны);
		КонецЕсли;
		Результат = АИС_Промпты.Заполнить(АвтоШаблоны);

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписьJSON.ЗаписатьИмяСвойства("Статус");
		ЗаписьJSON.ЗаписатьЗначение("ok");
		ЗаписьJSON.ЗаписатьИмяСвойства("Сообщение");
		ЗаписьJSON.ЗаписатьЗначение(Результат);
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Текст = "Ошибка заполнения промптов через АИС_Симулятор: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("АИС.Симулятор", УровеньЖурналаРегистрации.Ошибка,,, Текст);
		Ответ.УстановитьТелоИзСтроки(Текст);
		Ответ.КодСостояния = 400;
	КонецПопытки;

	Возврат Ответ;
КонецФункции


// GET /hs/ais-sim/internal-documents
// Диагностический список последних внутренних документов для симулятора.
Функция ПолучитьВнутренниеДокументы_GET(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Попытка
		УстановитьПривилегированныйРежим(Истина);

		Ид = Запрос.ПараметрыЗапроса.Получить("id");
		Если Не ПустаяСтрока(Ид) Тогда
			СсылкаДокумента = Справочники.ВнутренниеДокументы.ПолучитьСсылку(
				Новый УникальныйИдентификатор(Ид));
			ЗапросДокумента = Новый Запрос;
			ЗапросДокумента.УстановитьПараметр("Ссылка", СсылкаДокумента);
			ЗапросДокумента.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Документы.Ссылка КАК Ссылка,
			|	Документы.Заголовок КАК Заголовок,
			|	Документы.ВидДокумента.Наименование КАК Вид,
			|	Документы.Адресат.Наименование КАК Адресат,
			|	Документы.Подготовил.Наименование КАК Автор,
			|	Документы.ДатаСоздания КАК Дата,
			|	Документы.НеДействует КАК НеДействует,
			|	Документы.Содержание КАК Содержание
			|ИЗ
			|	Справочник.ВнутренниеДокументы КАК Документы
			|ГДЕ
			|	Документы.Ссылка = &Ссылка";
			ВыборкаДокумента = ЗапросДокумента.Выполнить().Выбрать();
			Если Не ВыборкаДокумента.Следующий() Тогда
				Ответ.КодСостояния = 404;
				Ответ.УстановитьТелоИзСтроки("Документ не найден: " + Ид);
				Возврат Ответ;
			КонецЕсли;

			ЗаписьJSON = Новый ЗаписьJSON;
			ЗаписьJSON.УстановитьСтроку();
			ЗаписьJSON.ЗаписатьНачалоОбъекта();
			ЗаписьJSON.ЗаписатьИмяСвойства("УникальныйИдентификатор");
			ЗаписьJSON.ЗаписатьЗначение(Ид);
			ЗаписьJSON.ЗаписатьИмяСвойства("Заголовок");
			ЗаписьJSON.ЗаписатьЗначение(ВыборкаДокумента.Заголовок);
			ЗаписьJSON.ЗаписатьИмяСвойства("Вид");
			ЗаписьJSON.ЗаписатьЗначение(ВыборкаДокумента.Вид);
			ЗаписьJSON.ЗаписатьИмяСвойства("Адресат");
			ЗаписьJSON.ЗаписатьЗначение(Строка(ВыборкаДокумента.Адресат));
			ЗаписьJSON.ЗаписатьИмяСвойства("Автор");
			ЗаписьJSON.ЗаписатьЗначение(Строка(ВыборкаДокумента.Автор));
			ЗаписьJSON.ЗаписатьИмяСвойства("Дата");
			ЗаписьJSON.ЗаписатьЗначение(Строка(ВыборкаДокумента.Дата));
			ЗаписьJSON.ЗаписатьИмяСвойства("НеДействует");
			ЗаписьJSON.ЗаписатьЗначение(ВыборкаДокумента.НеДействует);
			ЗаписьJSON.ЗаписатьИмяСвойства("Состояние");
			ЗаписьJSON.ЗаписатьЗначение(Строка(
				Делопроизводство.ПолучитьСостояниеДокумента(ВыборкаДокумента.Ссылка)));
			ЗаписьJSON.ЗаписатьИмяСвойства("Содержание");
			ЗаписьJSON.ЗаписатьЗначение(ВыборкаДокумента.Содержание);
			ЗаписьJSON.ЗаписатьКонецОбъекта();
			Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
			Возврат Ответ;
		КонецЕсли;

		ЗапросДокументов = Новый Запрос;
		ЗапросДокументов.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 100
		|	Документы.Ссылка КАК Ссылка,
		|	Документы.Заголовок КАК Заголовок,
		|	Документы.ВидДокумента.Наименование КАК Вид,
		|	Документы.Адресат.Наименование КАК Адресат,
		|	Документы.Подготовил.Наименование КАК Автор,
		|	Документы.НеДействует КАК НеДействует
		|ИЗ
		|	Справочник.ВнутренниеДокументы КАК Документы
		|УПОРЯДОЧИТЬ ПО
		|	Документы.Ссылка УБЫВ";
		Выборка = ЗапросДокументов.Выполнить().Выбрать();

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоМассива();
		Пока Выборка.Следующий() Цикл
			ЗаписьJSON.ЗаписатьНачалоОбъекта();
			ЗаписьJSON.ЗаписатьИмяСвойства("УникальныйИдентификатор");
			ЗаписьJSON.ЗаписатьЗначение(Строка(Выборка.Ссылка.УникальныйИдентификатор()));
			ЗаписьJSON.ЗаписатьИмяСвойства("Заголовок");
			ЗаписьJSON.ЗаписатьЗначение(Выборка.Заголовок);
			ЗаписьJSON.ЗаписатьИмяСвойства("Вид");
			ЗаписьJSON.ЗаписатьЗначение(Выборка.Вид);
			ЗаписьJSON.ЗаписатьИмяСвойства("Адресат");
			ЗаписьJSON.ЗаписатьЗначение(Строка(Выборка.Адресат));
			ЗаписьJSON.ЗаписатьИмяСвойства("Автор");
			ЗаписьJSON.ЗаписатьЗначение(Строка(Выборка.Автор));
			ЗаписьJSON.ЗаписатьИмяСвойства("НеДействует");
			ЗаписьJSON.ЗаписатьЗначение(Выборка.НеДействует);
			ЗаписьJSON.ЗаписатьИмяСвойства("Состояние");
			ЗаписьJSON.ЗаписатьЗначение(Строка(
				Делопроизводство.ПолучитьСостояниеДокумента(Выборка.Ссылка)));
			ЗаписьJSON.ЗаписатьКонецОбъекта();
		КонецЦикла;
		ЗаписьJSON.ЗаписатьКонецМассива();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Текст = "Ошибка чтения внутренних документов: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("АИС.Симулятор", УровеньЖурналаРегистрации.Ошибка,,, Текст);
		Ответ.УстановитьТелоИзСтроки(Текст);
		Ответ.КодСостояния = 400;
	КонецПопытки;

	Возврат Ответ;
КонецФункции

// POST /hs/ais-sim/tasks
// Тестовый адаптер: создаёт задачу исполнителю (идемпотентно по паре
// Исполнитель+Наименование). Нужен для сценариев, где задача создаётся
// не подпиской, а симулятором (например, приказ собственника).
// Тело запроса (JSON): {"Исполнитель": "...", "Наименование": "...",
//  "Содержание": "...", "Основание": "<УникальныйИдентификатор документа>"}
// "Основание" опционально: записывается в штатную мультипредметность задачи,
// чтобы её можно было отличить от чужих задач с тем же названием.
Функция СоздатьЗадачу_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Попытка
		ТелоКакСтрока = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоКакСтрока);
		Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();

		УстановитьПривилегированныйРежим(Истина);
		// В базе могут остаться legacy-элементы Справочник.Пользователи с тем
		// же пользователем ИБ, что и актуальный логин. Для задач важна именно
		// учётная запись, которую сессия видит как ТекущийПользователь,
		// поэтому ищем элемент по ИдентификаторПользователяИБ, а по имени —
		// только как резерв.
		ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(Данные.Исполнитель);
		Исполнитель = Неопределено;
		Если ПользовательИБ <> Неопределено Тогда
			ЗапросСотрудника = Новый Запрос;
			ЗапросСотрудника.УстановитьПараметр("Идентификатор", ПользовательИБ.УникальныйИдентификатор);
			ЗапросСотрудника.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Пользователи.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.Пользователи КАК Пользователи
			|ГДЕ
			|	Пользователи.ИдентификаторПользователяИБ = &Идентификатор";
			ВыборкаСотрудника = ЗапросСотрудника.Выполнить().Выбрать();
			Если ВыборкаСотрудника.Следующий() Тогда
				Исполнитель = ВыборкаСотрудника.Ссылка;
			КонецЕсли;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Исполнитель) Тогда
			Исполнитель = Справочники.Пользователи.НайтиПоНаименованию(Данные.Исполнитель, Истина);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Исполнитель) Тогда
			ВызватьИсключение "Исполнитель не найден: " + Данные.Исполнитель;
		КонецЕсли;
		ОснованиеИд = "";
		Данные.Свойство("Основание", ОснованиеИд);
		Основание = ДокументПоУникальномуИдентификатору(ОснованиеИд);
		Задача = АИС_ОбщегоНазначения.НайтиИлиСоздатьЗадачу(
			Исполнитель, Данные.Наименование, Данные.Содержание, Неопределено, Основание);

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписьJSON.ЗаписатьИмяСвойства("Статус");
		ЗаписьJSON.ЗаписатьЗначение("ok");
		ЗаписьJSON.ЗаписатьИмяСвойства("УникальныйИдентификатор");
		ЗаписьJSON.ЗаписатьЗначение(Строка(Задача.УникальныйИдентификатор()));
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Текст = "Ошибка создания задачи через АИС_Симулятор: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("АИС.Симулятор", УровеньЖурналаРегистрации.Ошибка,,, Текст);
		Ответ.УстановитьТелоИзСтроки(Текст);
		Ответ.КодСостояния = 400;
	КонецПопытки;

	Возврат Ответ;
КонецФункции

// POST /hs/ais-sim/obligations
// Тестовый адаптер: создаёт/обновляет должностную обязанность.
Функция СоздатьОбязанность_POST(Запрос) Экспорт
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");

	Попытка
		ТелоКакСтрока = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТелоКакСтрока);
		Данные = ПрочитатьJSON(ЧтениеJSON, Ложь);
		ЧтениеJSON.Закрыть();

		УстановитьПривилегированныйРежим(Истина);
		Должность = АИС_ОбщегоНазначения.НайтиИлиСоздатьЭлемент(Справочники.Должности, Данные.Должность);
		Должность.Записать();
		ТипТриггера = АИС_ОбщегоНазначения.НайтиИлиСоздатьТипТриггера(Данные.ТипТриггера);
		ТипДействия = АИС_ОбщегоНазначения.НайтиИлиСоздатьТипДействия(
			Данные.ТипДействия, Перечисления.ТипыОбъектов.ВнутренниеДокументы);

		Наименование = Данные.Должность + ": " + Данные.ТипТриггера;
		Обязанность = АИС_ОбщегоНазначения.НайтиИлиСоздатьЭлемент(
			Справочники.АИС_ДолжностныеОбязанности, Наименование);
		Обязанность.Должность = Должность.Ссылка;
		Обязанность.Текст = Данные.Текст;
		Обязанность.ДатаУтверждения = ТекущаяДатаСеанса();
		Обязанность.ТипТриггера = ТипТриггера;
		Обязанность.ТипДействия = ТипДействия;
		Обязанность.Приоритет = Данные.Приоритет;
		Обязанность.Версия = Данные.Версия;
		Обязанность.Активность = Данные.Активность;
		Обязанность.Записать();

		ЗаписьJSON = Новый ЗаписьJSON;
		ЗаписьJSON.УстановитьСтроку();
		ЗаписьJSON.ЗаписатьНачалоОбъекта();
		ЗаписьJSON.ЗаписатьИмяСвойства("Статус");
		ЗаписьJSON.ЗаписатьЗначение("ok");
		ЗаписьJSON.ЗаписатьИмяСвойства("УникальныйИдентификатор");
		ЗаписьJSON.ЗаписатьЗначение(Строка(Обязанность.Ссылка.УникальныйИдентификатор()));
		ЗаписьJSON.ЗаписатьКонецОбъекта();
		Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть());
	Исключение
		Текст = "Ошибка создания должностной обязанности: " + ОписаниеОшибки();
		ЗаписьЖурналаРегистрации("АИС.Симулятор", УровеньЖурналаРегистрации.Ошибка,,, Текст);
		Ответ.УстановитьТелоИзСтроки(Текст);
		Ответ.КодСостояния = 400;
	КонецПопытки;

	Возврат Ответ;
КонецФункции

