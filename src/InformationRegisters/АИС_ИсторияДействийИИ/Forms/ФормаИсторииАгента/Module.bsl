&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнитьИсторию();
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	ЗаполнитьИсторию();
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаИсторииПриАктивизацииСтроки(Элемент, СтандартнаяОбработка)
	Если Элементы.ТаблицаИстории.ТекущиеДанные = Неопределено Тогда
		ТекущаяЗапись = "";
	Иначе
		ТекущаяЗапись = Элементы.ТаблицаИстории.ТекущиеДанные.ИдентификаторЗаписи;
		ТекущаяДата = Элементы.ТаблицаИстории.ТекущиеДанные.ДатаВремя;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьЗапись(Команда)
	ИдентификаторЗаписи = ТекущаяЗапись;
	ДатаЗаписи = ТекущаяДата;
	Если ПустаяСтрока(ИдентификаторЗаписи) И Элементы.ТаблицаИстории.ТекущиеДанные <> Неопределено Тогда
		ИдентификаторЗаписи = Элементы.ТаблицаИстории.ТекущиеДанные.ИдентификаторЗаписи;
		ДатаЗаписи = Элементы.ТаблицаИстории.ТекущиеДанные.ДатаВремя;
	КонецЕсли;
	Если ПустаяСтрока(ИдентификаторЗаписи) Тогда
		ПоказатьПредупреждение(, "Выберите запись в таблице.");
		Возврат;
	КонецЕсли;
	ОткрытьФорму(
		"РегистрСведений.АИС_ИсторияДействийИИ.Форма.ФормаРезультата",
		Новый Структура("ИдентификаторЗаписи", ИдентификаторЗаписи));
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИсторию()
	Данные.Очистить();
	ТекущаяЗапись = "";
	ТекущаяДата = Неопределено;
	Сотрудник = Неопределено;
	Если Параметры.Свойство("СотрудникФильтра") И ЗначениеЗаполнено(Параметры.СотрудникФильтра) Тогда
		Сотрудник = Параметры.СотрудникФильтра;
	ИначеЕсли Не РольДоступна("ПолныеПрава") И Не РольДоступна("АИС_АдминистраторСистемы") Тогда
		Сотрудник = ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли;
	Условие = "";
	Если ЗначениеЗаполнено(Сотрудник) Тогда
		Условие = "ГДЕ Запуски.Сотрудник = &Сотрудник";
	КонецЕсли;
	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	История.ИдентификаторЗаписи КАК ИдентификаторЗаписи,
			|	История.ДатаВремя КАК ДатаВремя,
			|	История.Задача КАК Задача,
			|	История.Инструмент КАК Инструмент,
			|	История.Шаг КАК Шаг,
			|	ВЫБОР
			|		КОГДА История.Длительность >= 86400
			|			ТОГДА История.Длительность / 86400
			|		ИНАЧЕ История.Длительность
			|	КОНЕЦ КАК Длительность,
			|	История.Статус КАК Статус,
			|	История.Ошибка КАК Ошибка,
			|	История.Результат КАК Результат
			|ИЗ
			|	РегистрСведений.АИС_ИсторияДействийИИ КАК История
			|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.АИС_ЗапускиАгентов КАК Запуски
			|		ПО История.Запуск = Запуски.Ссылка
			|" + Условие + "
			|УПОРЯДОЧИТЬ ПО
			|	История.ДатаВремя УБЫВ";
		Если ЗначениеЗаполнено(Сотрудник) Тогда
			Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
		КонецЕсли;
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Строка = Данные.Добавить();
			Строка.ИдентификаторЗаписи = Выборка.ИдентификаторЗаписи;
			Строка.ДатаВремя = Выборка.ДатаВремя;
			Строка.Задача = Строка(Выборка.Задача);
			Строка.Инструмент = Выборка.Инструмент;
			Строка.Шаг = Выборка.Шаг;
			Строка.Длительность = ФорматДлительности(Выборка.Длительность);
			Строка.Статус = Выборка.Статус;
			Строка.Ошибка = БезопасныйТекст(Выборка.Ошибка, 1000);
			Строка.Результат = БезопасныйТекст(Выборка.Результат, 1000);
		КонецЦикла;
	Исключение
		ЗаписьЖурналаРегистрации(
			"АИС.ИсторияДействийИИ",
			УровеньЖурналаРегистрации.Ошибка,
			,
			,
			"Не удалось загрузить историю агента: " + ОписаниеОшибки());
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);
КонецПроцедуры

Функция БезопасныйТекст(Значение, Максимум = 1000)
	Текст = Строка(Значение);
	Для Код = 0 По 31 Цикл
		Если Код <> 9 И Код <> 10 И Код <> 13 Тогда
			Текст = СтрЗаменить(Текст, Символ(Код), "");
		КонецЕсли;
	КонецЦикла;
	Если Максимум > 0 Тогда
		Текст = Лев(Текст, Максимум);
	КонецЕсли;
	Возврат Текст;
КонецФункции

Функция ФорматДлительности(Значение)
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	Текст = Формат(Значение, "ЧДЦ=2");
	Если Найти(Текст, ",") > 0 Тогда
		Пока Прав(Текст, 1) = "0" Цикл
			Текст = Лев(Текст, СтрДлина(Текст) - 1);
		КонецЦикла;
		Если Прав(Текст, 1) = "," Тогда
			Текст = Лев(Текст, СтрДлина(Текст) - 1);
		КонецЕсли;
	КонецЕсли;
	Возврат Текст;
КонецФункции
