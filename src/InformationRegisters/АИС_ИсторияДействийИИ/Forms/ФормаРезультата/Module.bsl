&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ТекстРезультата = "";
	Если Параметры.Свойство("ИдентификаторЗаписи") Тогда
		ТекстРезультата = ПрочитатьРезультат(Параметры.ИдентификаторЗаписи);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ПрочитатьРезультат(ИдентификаторЗаписи)
	ПрежнийРежим = ПривилегированныйРежим();
	УстановитьПривилегированныйРежим(Истина);
	Текст = "";
	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	История.Результат КАК Результат,
			|	Запуски.Сотрудник КАК Сотрудник
			|ИЗ
			|	РегистрСведений.АИС_ИсторияДействийИИ КАК История
			|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.АИС_ЗапускиАгентов КАК Запуски
			|		ПО История.Запуск = Запуски.Ссылка
			|ГДЕ
			|	История.ИдентификаторЗаписи = &ИдентификаторЗаписи
			|УПОРЯДОЧИТЬ ПО
			|	История.ДатаВремя УБЫВ";
		Запрос.УстановитьПараметр("ИдентификаторЗаписи", ИдентификаторЗаписи);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если ПустаяСтрока(Выборка.Результат) Тогда
				Продолжить;
			КонецЕсли;
			Если Не РольДоступна("ПолныеПрава")
				И Не РольДоступна("АИС_АдминистраторСистемы")
				И Выборка.Сотрудник <> ПараметрыСеанса.ТекущийПользователь Тогда
				Текст = "Нет доступа к результату другой записи.";
			Иначе
				Текст = БезопасныйТекст(Выборка.Результат);
			КонецЕсли;
			Прервать;
		КонецЦикла;
		Если ПустаяСтрока(Текст) Тогда
			Текст = "Поле «Результат» пусто.";
		КонецЕсли;
	Исключение
		Текст = "Не удалось прочитать результат: " + ОписаниеОшибки();
	КонецПопытки;
	УстановитьПривилегированныйРежим(ПрежнийРежим);
	Возврат Текст;
КонецФункции

Функция БезопасныйТекст(Значение)
	Исходный = Строка(Значение);
	Текст = "";
	Для Позиция = 1 По СтрДлина(Исходный) Цикл
		Код = КодСимвола(Исходный, Позиция);
		Допустим = Код = 9 ИЛИ Код = 10 ИЛИ Код = 13
			ИЛИ (Код >= 32 И Код <= 65533)
			ИЛИ (Код >= 65536 И Код <= 1114111);
		Если Допустим
			И Не (Код >= 55296 И Код <= 57343) Тогда
			Текст = Текст + Символ(Код);
		КонецЕсли;
	КонецЦикла;
	Возврат Текст;
КонецФункции
