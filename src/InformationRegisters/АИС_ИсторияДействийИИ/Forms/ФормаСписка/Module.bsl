&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Порядок = Список.КомпоновщикНастроек.Настройки.Порядок;
	Порядок.Элементы.Очистить();
	ЭлементПорядка = Порядок.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
	ЭлементПорядка.Поле = Новый ПолеКомпоновкиДанных("ДатаВремя");
	ЭлементПорядка.ТипУпорядочивания = НаправлениеСортировкиКомпоновкиДанных.Убыв;
	ЭлементПорядка.Использование = Истина;
	Если Параметры.Свойство("СотрудникФильтра") И ЗначениеЗаполнено(Параметры.СотрудникФильтра) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ
			|	Запуски.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.АИС_ЗапускиАгентов КАК Запуски
			|ГДЕ
			|	Запуски.Сотрудник = &Сотрудник
			|	И НЕ Запуски.ПометкаУдаления";
		Запрос.УстановитьПараметр("Сотрудник", Параметры.СотрудникФильтра);
		Выборка = Запрос.Выполнить().Выбрать();
		Запуски = Новый СписокЗначений;
		Пока Выборка.Следующий() Цикл
			Запуски.Добавить(Выборка.Ссылка);
		КонецЦикла;
		Отбор = Список.КомпоновщикНастроек.Настройки.Отбор;
		Отбор.Элементы.Очистить();
		ЭлементОтбора = Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Список.Запуск");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
		ЭлементОтбора.ПравоеЗначение = Запуски;
		ЭлементОтбора.Использование = Истина;
	КонецЕсли;
КонецПроцедуры
