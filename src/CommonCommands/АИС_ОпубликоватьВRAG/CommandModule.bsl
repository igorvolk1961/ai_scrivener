&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды) Экспорт
	Если Не ЗначениеЗаполнено(ПараметрКоманды) Тогда
		ПоказатьПредупреждение(, "Выберите документ для публикации в RAG.");
		Возврат;
	КонецЕсли;
	Сообщение = ОпубликоватьВRAGНаСервере(ПараметрКоманды);
	ПоказатьПредупреждение(, Сообщение);
КонецПроцедуры

&НаСервере
Функция ОпубликоватьВRAGНаСервере(Ссылка)
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат "Документ не выбран.";
	КонецЕсли;
	Если АИС_ИндексацияДокументов.ДокументОпубликован(Ссылка) Тогда
		Возврат "Документ уже опубликован в RAG. Снятие — через администратора.";
	КонецЕсли;
	Финальность = АИС_ИндексацияДокументов.ФинальноеСостояние(Ссылка);
	Если Финальность.Финальный Тогда
		Возврат "Документ финальный и будет опубликован автоматически.";
	КонецЕсли;
	Объект = Ссылка.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Возврат "Документ не найден.";
	КонецЕсли;
	Объект.АИС_ПубликоватьВRAG = Истина;
	Попытка
		Объект.Записать();
	Исключение
		Возврат "Не удалось сохранить публикацию: " + ОписаниеОшибки();
	КонецПопытки;
	АИС_ИндексацияДокументов.ПоставитьВОчередь(Ссылка, "Публикация в RAG");
	Возврат "Документ поставлен в очередь публикации в RAG.";
КонецФункции
