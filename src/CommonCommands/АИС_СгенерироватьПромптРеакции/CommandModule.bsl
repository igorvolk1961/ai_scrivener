Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды) Экспорт
	Если Не ЗначениеЗаполнено(ПараметрКоманды) Тогда
		Сообщить("Сначала сохраните элемент расписания.");
		Возврат;
	КонецЕсли;

	Объект = ПараметрКоманды.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Сообщить("Не удалось открыть элемент расписания.");
		Возврат;
	КонецЕсли;

	Попытка
		Результат = АИС_РасписанияТриггеров.СгенерироватьНаименованиеИПромпт(Объект);
		Объект.Наименование = Результат.Наименование;
		Объект.ПромптРеакции = Результат.Промпт;
		Объект.Записать();
		Сообщить("Наименование и промпт реакции сгенерированы. Проверьте и при необходимости отредактируйте.");
	Исключение
		Сообщить("Не удалось сгенерировать промпт: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры
