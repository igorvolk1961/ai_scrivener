Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды) Экспорт
	Если Не ЗначениеЗаполнено(ПараметрКоманды) Тогда
		Сообщить("Сначала сохраните элемент расписания.");
		Возврат;
	КонецЕсли;

	Объект = ПараметрКоманды.ПолучитьОбъект();
	Если Объект = Неопределено Тогда
		Сообщить("Не удалось открыть элемент расписания.");
		Возврат;
	КонецЕсли;

	Попытка
		Текст = АИС_РасписанияТриггеров.СгенерироватьПромптРеакции(Объект);
		Объект.ПромптРеакции = Текст;
		Объект.Записать();
		Сообщить("Промпт реакции сгенерирован. Проверьте и при необходимости отредактируйте его.");
	Исключение
		Сообщить("Не удалось сгенерировать промпт реакции: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры
